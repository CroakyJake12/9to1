<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CakeOS.Cui.Runtime</AssemblyName>
    <RootNamespace>CakeOS.Cui.Runtime</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../vendor/Avalonia/src/Avalonia.Desktop/Avalonia.Desktop.csproj" />
    <ProjectReference Include="../vendor/Avalonia/src/Avalonia.Themes.Fluent/Avalonia.Themes.Fluent.csproj" />
    <ProjectReference Include="../Core/CakeOS.Cui.Core.csproj" />
    <ProjectReference Include="../Themes/CakeOS.Cui.Themes.csproj" />
    <ProjectReference Include="../../CUI/vendor/Avalonia/src/Avalonia.Base/Avalonia.Base.csproj" />
    <ProjectReference Include="../../CUI/vendor/Avalonia/src/Avalonia.Controls/Avalonia.Controls.csproj" />
    <ProjectReference Include="../../CUI/vendor/Avalonia/src/Skia/Avalonia.Skia/Avalonia.Skia.csproj" />
    <ProjectReference Include="../../CUI/vendor/Avalonia/src/Headless/Avalonia.Headless/Avalonia.Headless.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Use the maintained bundled family without depending on the Desktop UI process. -->
    <AvaloniaResource Include="../../../9to1 Workspace/shared/src/Haven.Desktop/Assets/Fonts/MontserratStatic/*.ttf"
                      Link="Assets/Fonts/MontserratStatic/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../../9to1 Workspace/shared/src/Haven.Desktop/Assets/Fonts/OFL-Montserrat.txt"
                      Link="Assets/Fonts/OFL-Montserrat.txt" />
  </ItemGroup>
  <Import Project="../vendor/Avalonia/build/BuildTargets.targets" />
</Project>
