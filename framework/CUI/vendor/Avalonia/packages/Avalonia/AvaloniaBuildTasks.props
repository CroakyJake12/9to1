<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)../../../../Compiler/buildTransitive/CakeOS.Cui.props" />
  <!-- CUI fork: replaces AXAML item names with CUI -->
  <ItemGroup>
    <AvailableItemName Include="CuiMarkup" />
    <AvailableItemName Include="AvaloniaResource" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableDefaultItems)'=='True'">
    <CuiMarkup Include="**\*.cui" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" SubType="Designer" />
  </ItemGroup>
</Project>
