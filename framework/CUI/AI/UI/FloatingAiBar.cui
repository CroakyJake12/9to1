<Cui id="shared-floating-ai-bar" version="1">
  <Page>
    <Container id="floating-ai-surface" accessible-name="AI assistant" Type="Overlay">
      <Container Type="Vertical Stack" CellGap="8">
        <Container accessible-name="AI access mode" Type="Horizontal Stack" CellGap="8">
          <Text text="{Binding AccessModeLabel}" />
          <Button id="ReadOnlyMode" content="Read-only" action="SetReadOnly" accessible-name="Set AI access to read-only" />
          <Button id="WriteMode" content="Write" action="SetWriteMode" accessible-name="Set AI access to write mode" />
          <Button id="AiModel" content="{Binding ModelPickerLabel}" action="SelectNextModel" accessible-name="Choose AI model" Active="{Binding ModelPickerAvailable}" />
          <Button id="ExpandAi" content="✦" action="Expand" accessible-name="Open AI assistant" Active="{Binding IsCollapsed}" />
        </Container>
        <Container Type="Vertical Stack" Active="{Binding IsExpanded}" CellGap="8">
          <Text id="AiContext" text="{Binding ContextLabel}" />
          <Input id="AiPrompt" accessible-name="Ask about this app" Type="Text" Value="{Binding Prompt, Mode=TwoWay}" />
          <Text id="AiRequestStatus" text="{Binding RequestStateLabel}" accessible-name="AI request status" />
          <Container Type="Horizontal Stack" CellGap="8">
            <Button id="SendAi" content="Send" action="Submit" />
            <Button id="StopAi" content="Stop" action="Cancel" Active="{Binding IsStreaming}" />
            <Button id="FinishActionAudit" content="Finish audit" action="FinishActionAudit" accessible-name="Retry only the retained Home completion audit" Active="{Binding HasPendingActionAudit}" />
            <Button id="CloseAi" content="Close" action="Collapse" />
          </Container>
          <Text id="AiResponse" text="{Binding Response}" text-wrapping="Wrap" />
          <Text id="AiError" text="{Binding Error}" accessible-name="AI error" Active="{Binding HasError}" />
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
