<Project>
  <ItemGroup Condition="'@(CuiSourceRoot)' == ''">
    <CuiSourceRoot Include="$(MSBuildProjectDirectory)" />
  </ItemGroup>
  <PropertyGroup>
    <!-- SDK default None items otherwise include copies from nested test/project
         outputs. Exclude them at implicit discovery, not after explicit authoring
         items have been combined: explicitly declared bin/obj resources must still
         pass the language gate. MSBuild evaluates properties before default items. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- Only default to the packaged toolchain when it is actually present (installed
       package layout). In a source checkout the task project is built from source. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../tools/compiler/CakeOS.Cui.Build.Compiler.dll')">
    <CuiCompilerTaskAssembly Condition="'$(CuiCompilerTaskAssembly)' == ''">$(MSBuildThisFileDirectory)../tools/compiler/CakeOS.Cui.Build.Compiler.dll</CuiCompilerTaskAssembly>
    <CuiBuildTasksLocation Condition="'$(CuiBuildTasksLocation)' == ''">$(MSBuildThisFileDirectory)../tools/legacy/CakeOS.Cui.Build.Tasks.dll</CuiBuildTasksLocation>
    <CuiUsePrebuiltCompiler Condition="'$(CuiUsePrebuiltCompiler)' == ''">true</CuiUsePrebuiltCompiler>
  </PropertyGroup>
</Project>
