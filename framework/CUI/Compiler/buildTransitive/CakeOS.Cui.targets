<Project>
  <Target Name="ValidateCuiProjectItems" BeforeTargets="PrepareForBuild" Condition="'@(Cui)' != ''">
    <Error
      Condition="'%(Cui.Extension)' != '.cui' and '%(Cui.Extension)' != '.CUI' and '%(Cui.Extension)' != '.cui-theme' and '%(Cui.Extension)' != '.cui-prefab'"
      Code="CUI0001"
      File="%(Cui.Identity)"
      Text="CUI project items must use .cui, .cui-theme or .cui-prefab. Legacy .axaml and .hui inputs are not accepted." />
  </Target>
</Project>
