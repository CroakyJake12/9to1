<Project>
  <PropertyGroup>
    <_CuiSourceTaskProject>$(MSBuildThisFileDirectory)../../Build.Tasks/CakeOS.Cui.Build.Compiler.csproj</_CuiSourceTaskProject>
    <CuiCompilerTaskAssembly Condition="'$(CuiCompilerTaskAssembly)' == ''">$(MSBuildThisFileDirectory)../../Build.Tasks/bin/$(Configuration)/net10.0/CakeOS.Cui.Build.Compiler.dll</CuiCompilerTaskAssembly>
    <_CuiBuildCompilerDependsOn Condition="'$(CuiUsePrebuiltCompiler)' != 'true'">ResolveProjectReferences</_CuiBuildCompilerDependsOn>
    <!-- Mirror the SDK's effective DefaultCopyToPublishDirectoryMetadata default (true). The CompileCuiSourcesTask
         consumes this to decide whether a missing CopyToPublishDirectory inherits publish from a real output-copy mode. -->
    <DefaultCopyToPublishDirectoryMetadata Condition="'$(DefaultCopyToPublishDirectoryMetadata)' == ''">true</DefaultCopyToPublishDirectoryMetadata>
  </PropertyGroup>
  <!-- Build infrastructure is a build-only dependency, never application code-behind.
       The task project itself does not import these targets, avoiding recursion. -->
  <ItemGroup Condition="Exists('$(_CuiSourceTaskProject)') and '$(CuiUsePrebuiltCompiler)' != 'true'">
    <!-- Compile the task for the SDK host, independently of the application's RID,
         architecture and deployment mode. The loader path above is host-neutral. -->
    <ProjectReference Include="$(_CuiSourceTaskProject)" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSelfContained;PublishSingleFile;PublishReadyToRun;PublishTrimmed;PublishAot;UseAppHost;Platform;PlatformTarget"
                      AdditionalProperties="Platform=AnyCPU;PlatformTarget=AnyCPU" />
  </ItemGroup>
  <UsingTask TaskName="CakeOS.Cui.Build.CompileCuiSourcesTask" AssemblyFile="$(CuiCompilerTaskAssembly)" />

  <Target Name="DiscoverCuiSources" Condition="'$(EnableDefaultCuiItems)' != 'false'">
    <ItemGroup>
      <Cui Include="%(CuiSourceRoot.Identity)/**/*.cui;%(CuiSourceRoot.Identity)/**/*.cui-theme;%(CuiSourceRoot.Identity)/**/*.cui-prefab"
           Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);**/bin/**;**/obj/**" />
      <!-- Keep authored resource/copy metadata: existing runtime hosts may still
           consume the original .cui alongside the compiled representation. -->
    </ItemGroup>
  </Target>

  <Target Name="ValidateCuiProjectItems" BeforeTargets="PrepareForBuild" DependsOnTargets="DiscoverCuiSources">
    <ItemGroup>
      <!-- Explicit imports define the application boundary. Referenced donor projects
           retain their private XAML machinery and are not recursively scanned. -->
      <_CuiRootFiles Include="%(CuiSourceRoot.Identity)/**/*"
                     Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);**/bin/**;**/obj/**" />
      <_CuiDeclaredSource Include="@(_CuiRootFiles);@(Cui);@(CuiMarkup);@(AvaloniaXaml);@(AvaloniaResource);@(EmbeddedResource);@(Content);@(None);@(Compile)" />
      <!-- Explicit project inputs are always validated, including paths named bin
           or obj. Only implicit discovery excludes generated output directories. -->
      <_CuiLegacySource Include="@(_CuiDeclaredSource)"
                        Condition="'%(Extension)' == '.axaml' or '%(Extension)' == '.xaml' or '%(Extension)' == '.hui'" />
    </ItemGroup>
    <Error Condition="'@(_CuiLegacySource)' != ''" Code="CUIB001" File="%(_CuiLegacySource.Identity)"
           Text="CUI application projects reject .axaml, .xaml and .hui source. Use canonical CUI." />
    <Error Condition="'%(Cui.Extension)' != '.cui' and '%(Cui.Extension)' != '.cui-theme' and '%(Cui.Extension)' != '.cui-prefab' and '@(Cui)' != ''"
           Code="CUIB001" File="%(Cui.Identity)" Text="CUI project items must use .cui, .cui-theme or .cui-prefab." />
    <Error Condition="'$(MSBuildRuntimeType)' != 'Core' or $([System.Environment]::Version.Major) &lt; 10" Code="CUIB010"
           Text="Canonical CUI compilation requires .NET SDK 10 or newer MSBuild; full-framework MSBuild is not supported." />
  </Target>

  <!-- Deliberately run on every compilation: removed inputs, changed imports, compiler
       binaries and property changes must not reuse a previously valid artifact. -->
  <Target Name="CompileCuiSources" BeforeTargets="AssignTargetPaths;CoreCompile"
          DependsOnTargets="ValidateCuiProjectItems;$(_CuiBuildCompilerDependsOn)">
    <Error Condition="!Exists('$(CuiCompilerTaskAssembly)')" Code="CUIB011"
           Text="Canonical CUI compiler task is missing at $(CuiCompilerTaskAssembly). Build the CUI toolchain or supply CuiCompilerTaskAssembly." />
    <PropertyGroup>
      <CuiCompilationArtifact Condition="'$(CuiCompilationArtifact)' == ''">$(IntermediateOutputPath)Cui/compilation.cuic.json</CuiCompilationArtifact>
    </PropertyGroup>
    <ItemGroup>
      <_CuiPackagedSource Include="@(EmbeddedResource)" CuiItemType="EmbeddedResource" />
      <_CuiPackagedSource Include="@(Content)" CuiItemType="Content" />
      <_CuiPackagedSource Include="@(None)" CuiItemType="None" />
      <_CuiPackagedSource Include="@(AvaloniaResource)" CuiItemType="AvaloniaResource" />
      <_CuiPackagedSource Include="@(CuiMarkup)" CuiItemType="CuiMarkup" />
      <_CuiPackagedSource Remove="@(_CuiPackagedSource)" Condition="'%(Extension)' != '.cui' and '%(Extension)' != '.cui-theme' and '%(Extension)' != '.cui-prefab'" />
    </ItemGroup>
    <CakeOS.Cui.Build.CompileCuiSourcesTask Sources="@(Cui);@(CuiMarkup);@(_CuiPackagedSource)" ProjectDirectory="$(MSBuildProjectDirectory)"
                                         OutputFile="$(CuiCompilationArtifact)" RequiredCapabilities="@(CuiRequiredCapability)" ResourcesToSnapshot="@(_CuiPackagedSource)"
                                         IntermediateOutputPath="$(IntermediateOutputPath)" OutputDirectory="$(OutputPath)" PublishDirectory="$(PublishDir)"
                                         DefaultCopyToPublishDirectoryMetadata="$(DefaultCopyToPublishDirectoryMetadata)">
      <Output TaskParameter="CompiledArtifacts" ItemName="_CuiCompiledArtifact" />
      <Output TaskParameter="SnapshotResources" ItemName="_CuiSnapshotResource" />
      <Output TaskParameter="SourceSnapshots" ItemName="_CuiSourceSnapshot" />
      <Output TaskParameter="StatefulPackagedSources" ItemName="_CuiStatefulPackagedSource" />
      <Output TaskParameter="StaleOwnedOutputs" ItemName="_CuiStaleOwnedOutput" />
      <Output TaskParameter="PreservedForeignOutputs" ItemName="_CuiPreservedForeignOutput" />
    </CakeOS.Cui.Build.CompileCuiSourcesTask>
    <ItemGroup>
      <FileWrites Include="@(_CuiCompiledArtifact);@(_CuiSourceSnapshot);@(_CuiStaleOwnedOutput)" />
      <!-- Package only ADMITTED stateless raw snapshots (SnapshotResources). Stateful sources were
           compiled and provenance-snapshotted but are excluded from every shipped raw identity. -->
      <EmbeddedResource Remove="@(_CuiPackagedSource)" Condition="'%(_CuiPackagedSource.CuiItemType)' == 'EmbeddedResource'" />
      <Content Remove="@(_CuiPackagedSource)" Condition="'%(_CuiPackagedSource.CuiItemType)' == 'Content'" />
      <None Remove="@(_CuiPackagedSource)" Condition="'%(_CuiPackagedSource.CuiItemType)' == 'None'" />
      <AvaloniaResource Remove="@(_CuiPackagedSource)" Condition="'%(_CuiPackagedSource.CuiItemType)' == 'AvaloniaResource'" />
      <CuiMarkup Remove="@(_CuiPackagedSource)" Condition="'%(_CuiPackagedSource.CuiItemType)' == 'CuiMarkup'" />
      <EmbeddedResource Include="@(_CuiSnapshotResource)" Condition="'%(_CuiSnapshotResource.CuiItemType)' == 'EmbeddedResource'" />
      <Content Include="@(_CuiSnapshotResource)" Condition="'%(_CuiSnapshotResource.CuiItemType)' == 'Content'" />
      <None Include="@(_CuiSnapshotResource)" Condition="'%(_CuiSnapshotResource.CuiItemType)' == 'None'" />
      <AvaloniaResource Include="@(_CuiSnapshotResource)" Condition="'%(_CuiSnapshotResource.CuiItemType)' == 'AvaloniaResource'" />
      <CuiMarkup Include="@(_CuiSnapshotResource)" Condition="'%(_CuiSnapshotResource.CuiItemType)' == 'CuiMarkup'" />
      <!-- Embed the compiled artifact under the resource identity returned by the task (V2 for
           stateful, genuine V1 otherwise), never a hardcoded identity. -->
      <EmbeddedResource Include="@(_CuiCompiledArtifact)" LogicalName="%(_CuiCompiledArtifact.CuiResourceLogicalName)" />
    </ItemGroup>
  </Target>

  <!-- Foreign user data at a formerly-owned raw destination must never enter the SDK's persisted
       clean/deletion bookkeeping. The SDK records every file the build writes in $(CleanFile); once
       a source transitions stateful its raw output is no longer produced, and IncrementalClean /
       CoreClean (explicit dotnet clean) would otherwise delete it. Scrub those exact foreign
       identities from the recorded prior file-writes BEFORE the SDK's incremental/explicit clean
       evaluates them, so foreign files survive both incremental builds and explicit clean/rebuild
       without ever being claimed as produced (they are never added to FileWrites). The preserved
       set itself is derived by the CompileCuiSourcesTask from a strict ownership hash-guard and is
       persisted separately from the owned list. -->
  <Target Name="CuiScrubPreservedForeignFromCleanList"
          BeforeTargets="_CleanGetCurrentAndPriorFileWrites"
          Condition="'@(_CuiPreservedForeignOutput)' != '' and Exists('$(IntermediateOutputPath)$(CleanFile)')">
    <ReadLinesFromFile File="$(IntermediateOutputPath)$(CleanFile)">
      <Output TaskParameter="Lines" ItemName="_CuiPriorCleanLines"/>
    </ReadLinesFromFile>
    <ItemGroup>
      <_CuiPriorCleanLinesKeep Include="@(_CuiPriorCleanLines)" Exclude="@(_CuiPreservedForeignOutput)"/>
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)$(CleanFile)"
                      Lines="@(_CuiPriorCleanLinesKeep)" Overwrite="true"/>
  </Target>

  <!-- Publish-equivalent hygiene: scrub preserved foreign identities from the recorded prior
       publish file-writes so a later publish's incremental clean never deletes them. (The publish
       clean file is only rewritten by a publish, so this runs after the publish clean list is
       materialized.) -->
  <Target Name="CuiScrubPreservedForeignFromPublishCleanList"
          AfterTargets="_IncrementalCleanPublishDirectory"
          Condition="'@(_CuiPreservedForeignOutput)' != '' and '$(PublishDir)' != '' and Exists('$(IntermediateOutputPath)$(_PublishCleanFile)')">
    <ReadLinesFromFile File="$(IntermediateOutputPath)$(_PublishCleanFile)">
      <Output TaskParameter="Lines" ItemName="_CuiPriorPublishCleanLines"/>
    </ReadLinesFromFile>
    <ItemGroup>
      <_CuiPriorPublishCleanLinesKeep Include="@(_CuiPriorPublishCleanLines)" Exclude="@(_CuiPreservedForeignOutput)"/>
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)$(_PublishCleanFile)"
                      Lines="@(_CuiPriorPublishCleanLinesKeep)" Overwrite="true"/>
  </Target>
</Project>
