<Cui id="home.settings.theme-creator" version="1">
  <Prefab (Definition) id="ThemeMaterialEditor" Type="dynamic">
    <Container Type="Vertical Stack" CellGap="12" Padding="0 4 0 12">
      <Container Type="Grid" ColumnSizes="1fr 1fr" CellGap="12">
        <Text Text="Style" VerticalAlignment="Center" FontWeight="600" />
        <Input Column="1" Type="Select" ItemsSource="{Binding ThemeCreatorFillKinds}" SelectedIndex="{Binding ThemeCreatorFillKindIndex, mode=TwoWay, type=int}" AccessibleName="Accent type" Interactive="{Binding ThemeCreatorCanEdit}" />
      </Container>
      <Container Type="Grid" ColumnSizes="1fr 1fr" CellGap="12" Padding="0 8" BorderColor="{Resource CuiLineBrush}" BorderWidth="0 0 0 1">
        <Text Text="Colour" FontWeight="600" VerticalAlignment="Center" />
        <Container Column="1" Type="Vertical Stack" CellGap="4">
          <Theme Name="9to1 Draft Theme Preview">
            <If condition="{Binding ThemeCreatorEditingPrimary, fallback=false}"><Button id="material-details-primary" Content="{Binding ThemeCreatorMaterialAction}" Action="ThemeCreatorToggleMaterialDetails" AccentRole="Primary" AccessibleName="Edit material details" Height="38" HorizontalAlignment="Stretch" /></If>
            <If condition="{Binding ThemeCreatorEditingSecondary, fallback=false}"><Button id="material-details-secondary" Content="{Binding ThemeCreatorMaterialAction}" Action="ThemeCreatorToggleMaterialDetails" AccentRole="Secondary" AccessibleName="Edit material details" Height="38" HorizontalAlignment="Stretch" /></If>
            <If condition="{Binding ThemeCreatorEditingTertiary, fallback=false}"><Button id="material-details-tertiary" Content="{Binding ThemeCreatorMaterialAction}" Action="ThemeCreatorToggleMaterialDetails" AccentRole="Tertiary" AccessibleName="Edit material details" Height="38" HorizontalAlignment="Stretch" /></If>
          </Theme>
          <Text Text="{Binding ThemeCreatorMaterialSummary}" Foreground="{Resource CuiTextSoftBrush}" FontSize="12" />
        </Container>
      </Container>
      <If condition="{Binding ThemeCreatorMaterialDetails, fallback=false}">
        <Container Type="Vertical Stack" CellGap="8" Padding="0 4 0 12">
          <Container Active="{Binding ThemeCreatorIsGradient}" Type="Vertical Stack" CellGap="8">
            <Text Text="Gradient Creator" FontWeight="SemiBold" />
            <Input Type="Select" ItemsSource="{Binding ThemeCreatorGradientKinds}" SelectedIndex="{Binding ThemeCreatorGradientKindIndex, mode=TwoWay, type=int}" AccessibleName="Gradient type" Interactive="{Binding ThemeCreatorCanEdit}" />
            <Container Type="Wrap" CellGap="12">
              <Container Active="{Binding ThemeCreatorGradientHasAngle}" Type="Vertical Stack" CellGap="4" Width="130"><Text id="gradient-angle-label" Text="Angle (degrees)" /><Input Type="Text" Value="{Binding ThemeCreatorGradientAngle, mode=TwoWay, type=string}" AccessibleName="Gradient angle in degrees" Interactive="{Binding ThemeCreatorCanEdit}" /></Container>
              <Container Active="{Binding ThemeCreatorGradientHasCentre}" Type="Vertical Stack" CellGap="4" Width="130"><Text Text="Centre X (%)" /><Input Type="Text" Value="{Binding ThemeCreatorGradientCenterX, mode=TwoWay, type=string}" AccessibleName="Gradient centre X percent" Interactive="{Binding ThemeCreatorCanEdit}" /></Container>
              <Container Active="{Binding ThemeCreatorGradientHasCentre}" Type="Vertical Stack" CellGap="4" Width="130"><Text Text="Centre Y (%)" /><Input Type="Text" Value="{Binding ThemeCreatorGradientCenterY, mode=TwoWay, type=string}" AccessibleName="Gradient centre Y percent" Interactive="{Binding ThemeCreatorCanEdit}" /></Container>
              <Container Active="{Binding ThemeCreatorGradientHasRadius}" Type="Vertical Stack" CellGap="4" Width="130"><Text Text="Radius (%)" /><Input Type="Text" Value="{Binding ThemeCreatorGradientRadius, mode=TwoWay, type=string}" AccessibleName="Gradient radius percent" Interactive="{Binding ThemeCreatorCanEdit}" /></Container>
            </Container>
            <Container Type="Wrap" CellGap="8">
              <Input Type="Select" Width="180" ItemsSource="{Binding ThemeCreatorStopNames}" SelectedIndex="{Binding ThemeCreatorStopIndex, mode=TwoWay, type=int}" AccessibleName="Gradient colour stop" Interactive="{Binding ThemeCreatorCanEdit}" />
              <Button Action="ThemeCreatorAddStop" Content="Add stop" Interactive="{Binding ThemeCreatorCanAddStop}" />
              <Button Action="ThemeCreatorRemoveStop" Content="Remove stop" Interactive="{Binding ThemeCreatorCanRemoveStop}" />
            </Container>
            <Container Type="Vertical Stack" CellGap="4" Width="180" HorizontalAlignment="Left"><Text Text="Stop position (%)" /><Input Type="Text" Value="{Binding ThemeCreatorStopPosition, mode=TwoWay, type=string}" AccessibleName="Gradient stop position percent" Interactive="{Binding ThemeCreatorCanEditStopPosition}" /></Container>
            <Text Text="Endpoint stops stay at 0% and 100%. Add a stop to place another colour between them." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
          </Container>
          <Container Active="{Binding ThemeCreatorIsPattern}" Type="Vertical Stack" CellGap="8">
            <Text Text="Pattern builder" FontWeight="SemiBold" />
            <Input Type="Select" ItemsSource="{Binding ThemeCreatorPatternKinds}" SelectedIndex="{Binding ThemeCreatorPatternKindIndex, mode=TwoWay, type=int}" AccessibleName="Pattern geometry" Interactive="{Binding ThemeCreatorCanEdit}" />
            <Container Type="Wrap" CellGap="12">
              <Container Type="Vertical Stack" CellGap="4" Width="140"><Text id="pattern-size-label" Text="Size (px)" /><Input Type="Text" Value="{Binding ThemeCreatorPatternSize, mode=TwoWay, type=string}" AccessibleName="Pattern size in pixels" Interactive="{Binding ThemeCreatorCanEdit}" /></Container>
              <Container Type="Vertical Stack" CellGap="4" Width="140"><Text Text="Spacing (px)" /><Input Type="Text" Value="{Binding ThemeCreatorPatternSpacing, mode=TwoWay, type=string}" AccessibleName="Pattern spacing in pixels" Interactive="{Binding ThemeCreatorCanEdit}" /></Container>
              <Container Type="Vertical Stack" CellGap="4" Width="140"><Text id="pattern-angle-label" Text="Angle (degrees)" /><Input Type="Text" Value="{Binding ThemeCreatorPatternAngle, mode=TwoWay, type=string}" AccessibleName="Pattern angle in degrees" Interactive="{Binding ThemeCreatorCanEdit}" /></Container>
            </Container>
            <Input Type="Select" ItemsSource="{Binding ThemeCreatorPatternColourNames}" SelectedIndex="{Binding ThemeCreatorPatternColourIndex, mode=TwoWay, type=int}" AccessibleName="Pattern colour to edit" Interactive="{Binding ThemeCreatorCanEdit}" />
          </Container>

          <Text Text="{Binding ThemeCreatorColourLabel}" FontWeight="SemiBold" />
          <Container Type="Grid" ColumnSizes="Auto 1fr" CellGap="12">
            <Container Type="Overlay" Width="48" Height="40" CornerRadius="8" Background="{Binding ThemeCreatorColourSwatch}" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" AccessibleName="Selected colour preview" />
            <Input Column="1" Type="Text" Value="{Binding ThemeCreatorColourHex, mode=TwoWay, type=string}" AccessibleName="Colour hexadecimal RGB" Interactive="{Binding ThemeCreatorCanEdit}" />
          </Container>
          <Container Type="Grid" ColumnSizes="Auto 1fr Auto" RowSizes="Auto Auto Auto" CellGap="8">
            <Text Text="Red" /><Input Column="1" Type="Slider" Minimum="0" Maximum="255" Value="{Binding ThemeCreatorColourRed, mode=TwoWay, type=double}" AccessibleName="Colour red channel" Interactive="{Binding ThemeCreatorCanEdit}" /><Text Column="2" Text="{Binding ThemeCreatorColourRed}" />
            <Text Row="1" Text="Green" /><Input Row="1" Column="1" Type="Slider" Minimum="0" Maximum="255" Value="{Binding ThemeCreatorColourGreen, mode=TwoWay, type=double}" AccessibleName="Colour green channel" Interactive="{Binding ThemeCreatorCanEdit}" /><Text Row="1" Column="2" Text="{Binding ThemeCreatorColourGreen}" />
            <Text Row="2" Text="Blue" /><Input Row="2" Column="1" Type="Slider" Minimum="0" Maximum="255" Value="{Binding ThemeCreatorColourBlue, mode=TwoWay, type=double}" AccessibleName="Colour blue channel" Interactive="{Binding ThemeCreatorCanEdit}" /><Text Row="2" Column="2" Text="{Binding ThemeCreatorColourBlue}" />
          </Container>
        </Container>
      </If>
      <Container Type="Grid" ColumnSizes="1fr 1fr" CellGap="12" Padding="0 8" BorderColor="{Resource CuiLineBrush}" BorderWidth="0 0 0 1">
        <Text Text="Transparency (%)" FontWeight="600" VerticalAlignment="Center" />
        <Input Column="1" Type="Text" Value="{Binding ThemeCreatorTransparency, mode=TwoWay, type=string}" AccessibleName="Colour transparency percent" Interactive="{Binding ThemeCreatorCanEdit}" />
      </Container>
      <Container Type="Grid" ColumnSizes="1fr 1fr" CellGap="12" Padding="0 8" BorderColor="{Resource CuiLineBrush}" BorderWidth="0 0 0 1">
        <Text Text="Background blur (0–32)" FontWeight="600" VerticalAlignment="Center" />
        <Input Column="1" Type="Text" Value="{Binding ThemeCreatorBackgroundBlur, mode=TwoWay, type=string}" AccessibleName="Colour Gaussian background blur" Interactive="{Binding ThemeCreatorCanEdit}" />
      </Container>
    </Container>
  </Prefab>
  <Prefab (Definition) id="ThemeCreatorPanel" Type="dynamic">
    <If condition="{Binding ThemeCreatorOpen, fallback=false}">
    <Container id="theme-creator" Active="{Binding ThemeCreatorOpen, fallback=false}" Type="Vertical Stack" CellGap="12" Margin="0 0 0 24">
      <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="8" Margin="0 0 0 12">
        <Text Text="Create theme" FontSize="32" FontWeight="800" TextWrapping="Wrap" />
        <Button Column="1" Action="ThemeCreatorSave" Content="Save theme" AccentRole="Primary" Interactive="{Binding ThemeCreatorCanSave}" AccessibleName="Save custom theme" CornerRadius="18" Padding="14 8" VerticalAlignment="Center" />
      </Container>
      <Container Type="Grid" ColumnSizes="1fr 1fr" CellGap="12" BorderColor="{Resource CuiLineBrush}" BorderWidth="0 0 0 1" Padding="0 12">
        <Text Text="Theme Name" FontWeight="600" VerticalAlignment="Center" />
        <Input id="theme-name" Column="1" Type="Text" Value="{Binding ThemeCreatorName, mode=TwoWay, type=string}" AccessibleName="Theme name" FocusRequested="{Binding ThemeCreatorFocusName}" SelectOnFocusRequest="True" Interactive="{Binding ThemeCreatorCanEdit}" />
      </Container>
      <Container Type="Grid" ColumnSizes="1fr 1fr" CellGap="12" BorderColor="{Resource CuiLineBrush}" BorderWidth="0 0 0 1" Padding="0 12">
        <Text Text="Inherits" FontWeight="600" VerticalAlignment="Center" />
        <Input Column="1" Type="Select" ItemsSource="{Binding ThemeCreatorBaseThemes}" SelectedIndex="{Binding ThemeCreatorBaseThemeIndex, mode=TwoWay, type=int}" AccessibleName="Base theme" Interactive="{Binding ThemeCreatorCanEdit}" />
      </Container>
      <Container Type="Vertical Stack" CellGap="8" BorderColor="{Resource CuiLineBrush}" BorderWidth="0 0 0 1" Padding="0 12">
        <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="8">
          <Text Text="Primary Accent" FontSize="18" FontWeight="750" VerticalAlignment="Center" />
          <Container Column="1" Type="Overlay"><Theme Name="9to1 Draft Theme Preview">
            <Button Content="{Binding ThemeCreatorPrimaryStyle}" Action="ThemeCreatorSelectPrimary" AccentRole="Primary" AccessibleName="Edit primary accent material" Padding="14 6" CornerRadius="10" />
          </Theme></Container>
        </Container>
        <If condition="{Binding ThemeCreatorEditingPrimary, fallback=false}"><ThemeMaterialEditor id="material-primary" /></If>
      </Container>
      <Container Type="Vertical Stack" CellGap="8" BorderColor="{Resource CuiLineBrush}" BorderWidth="0 0 0 1" Padding="0 12">
        <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="8">
          <Text Text="Secondary Accent" FontSize="18" FontWeight="750" VerticalAlignment="Center" />
          <Container Column="1" Type="Overlay"><Theme Name="9to1 Draft Theme Preview">
            <Button Content="{Binding ThemeCreatorSecondaryStyle}" Action="ThemeCreatorSelectSecondary" AccentRole="Secondary" AccessibleName="Edit secondary accent material" Padding="14 6" CornerRadius="10" />
          </Theme></Container>
        </Container>
        <If condition="{Binding ThemeCreatorEditingSecondary, fallback=false}"><ThemeMaterialEditor id="material-secondary" /></If>
      </Container>
      <Container Type="Vertical Stack" CellGap="8" BorderColor="{Resource CuiLineBrush}" BorderWidth="0 0 0 1" Padding="0 12">
        <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="8">
          <Text Text="Tertiary Accent" FontSize="18" FontWeight="750" VerticalAlignment="Center" />
          <Container Column="1" Type="Overlay"><Theme Name="9to1 Draft Theme Preview">
            <Button Content="{Binding ThemeCreatorTertiaryStyle}" Action="ThemeCreatorSelectTertiary" AccentRole="Tertiary" AccessibleName="Edit tertiary accent material" Padding="14 6" CornerRadius="10" />
          </Theme></Container>
        </Container>
        <If condition="{Binding ThemeCreatorEditingTertiary, fallback=false}"><ThemeMaterialEditor id="material-tertiary" /></If>
      </Container>
      <Text Text="Fonts" FontSize="18" FontWeight="SemiBold" />
      <Input Type="Select" ItemsSource="{Binding ThemeCreatorFontRoles}" SelectedIndex="{Binding ThemeCreatorFontRoleIndex, mode=TwoWay, type=int}" AccessibleName="Font role to edit" Interactive="{Binding ThemeCreatorCanEdit}" />
      <Container Type="Wrap" CellGap="12">
        <Container Type="Vertical Stack" CellGap="4" Width="220"><Text Text="Family" /><Input Type="Select" ItemsSource="{Binding ThemeCreatorFontFamilies}" SelectedIndex="{Binding ThemeCreatorFontFamilyIndex, mode=TwoWay, type=int}" AccessibleName="Font family" Interactive="{Binding ThemeCreatorCanEdit}" /></Container>
        <Container Type="Vertical Stack" CellGap="4" Width="130"><Text Text="Weight" /><Input Type="Select" ItemsSource="{Binding ThemeCreatorFontWeights}" SelectedIndex="{Binding ThemeCreatorFontWeightIndex, mode=TwoWay, type=int}" AccessibleName="Font weight" Interactive="{Binding ThemeCreatorCanEdit}" /></Container>
        <Container Type="Vertical Stack" CellGap="4" Width="130"><Text id="font-size-label" Text="Size (px)" /><Input Type="Text" Value="{Binding ThemeCreatorFontSize, mode=TwoWay, type=string}" AccessibleName="Font size in pixels" Interactive="{Binding ThemeCreatorCanEdit}" /></Container>
      </Container>
      <Text Text="Button Roundness" FontWeight="SemiBold" />
      <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="12">
        <Input Type="Slider" Minimum="0" Maximum="100" Value="{Binding ThemeCreatorRoundness, mode=TwoWay, type=double}" AccessibleName="Button roundness percent" Interactive="{Binding ThemeCreatorCanEdit}" />
        <Text Column="1" Text="{Binding ThemeCreatorRoundnessLabel}" />
      </Container>
      <Text Text="Live preview" FontWeight="SemiBold" />
      <Theme Name="9to1 Draft Theme Preview">
      <Container Type="Vertical Stack" CellGap="10" Padding="16" Background="{Resource CuiWorkspaceBrush}" CornerRadius="14">
        <Text Text="Your workspace" FontRole="Main" TextWrapping="Wrap" />
        <Text Text="A theme of your own" FontRole="Heading" TextWrapping="Wrap" />
        <Text Text="Colour, texture and typography work together." FontRole="Body" TextWrapping="Wrap" />
        <Container Type="Wrap" CellGap="8">
          <Button Content="Primary" Action="ThemeCreatorSelectPrimary" AccentRole="Primary" FontRole="PrimaryButton" AccessibleName="Preview primary accent and edit it" />
          <Button Content="Secondary" Action="ThemeCreatorSelectSecondary" AccentRole="Secondary" FontRole="SecondaryButton" AccessibleName="Preview secondary accent and edit it" />
          <Button Content="Tertiary" Action="ThemeCreatorSelectTertiary" AccentRole="Tertiary" FontRole="TertiaryButton" AccessibleName="Preview tertiary accent and edit it" />
        </Container>
        <Text Text="theme.preview = true" FontRole="Code" TextWrapping="Wrap" />
      </Container>
      </Theme>

      <Text Text="{Binding ThemeCreatorStatus}" AccessibleName="Theme creator status" TextWrapping="Wrap" />
      <Button Active="{Binding ThemeCreatorCanUseCurrentRevision}" Action="ThemeCreatorUseCurrentRevision" Content="Use current revision" AccessibleName="Keep draft and use reviewed current preference revision" Interactive="{Binding ThemeCreatorCanUseCurrentRevision}" HorizontalAlignment="Left" />
      <Container Type="Wrap" CellGap="8">
        <Button Action="ThemeCreatorCancel" Content="Cancel" Interactive="{Binding ThemeCreatorCanEdit}" AccessibleName="Cancel custom theme changes" />
      </Container>
    </Container>
    </If>
  </Prefab>
</Cui>
