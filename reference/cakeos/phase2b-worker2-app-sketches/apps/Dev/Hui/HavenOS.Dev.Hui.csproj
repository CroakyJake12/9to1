<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../App/HavenOS.Dev.App.csproj" />
    <ProjectReference Include="$(HavenUiProject)" Condition="'$(HavenUiProject)' != ''" />
  </ItemGroup>
  <Target Name="RequireHavenUiProject" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(HavenUiProject)' == ''" Text="HavenUiProject must point to the exact staged Haven.UI.csproj selected by the CakeOS HUI platform reference." />
    <Error Condition="'$(HavenUiProject)' != '' and !Exists('$(HavenUiProject)')" Text="HavenUiProject does not exist: $(HavenUiProject)" />
  </Target>
</Project>