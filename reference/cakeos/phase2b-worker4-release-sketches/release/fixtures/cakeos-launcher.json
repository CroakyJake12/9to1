    {
      "route": "/launcher/apps",
      "handler": "ListAppsHandler",
      "methods": ["GET"]
    }
  ],
  "capabilities": [
    {
      "capabilityId": "cakeos.launcher.launch",
      "displayName": "Application Launch",
      "description": "Launch applications via Haven Shell integration",
      "isRequired": true
    },
    {
      "capabilityId": "cakeos.launcher.discover",
      "displayName": "Application Discovery",
      "description": "Discover and list available applications",
      "isRequired": true
    }
  ],
  "dependencies": [
    {
      "dependencyId": "haven.shell",
      "kind": "RequiredProduct",
      "versionConstraint": ">=0.1.0"
    },
    {
      "dependencyId": "libglib2.0-0",
      "kind": "RequiredPackage",
      "versionConstraint": ">=2.78"
    }
  ],
  "persistence": {
    "requiresSettings": true,
    "requiresCache": false,
    "requiresState": true,
    "requiresData": false,
    "customPaths": ["/etc/cakeos/launcher", "/var/lib/cakeos/launcher"]
  },
  "permissions": {
    "requiredGrants": ["launcher.launch", "launcher.discover", "process.exec"],
