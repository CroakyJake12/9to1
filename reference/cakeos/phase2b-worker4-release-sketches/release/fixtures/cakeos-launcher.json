    "packageFormat": "deb"
  },
  "entrypoint": {
    "binaryPath": "/usr/lib/cakeos/launcher/cakeos-launcher-daemon",
    "arguments": "--daemon",
    "workingDirectory": "/var/lib/cakeos/launcher",
    "environment": {}
  },
  "service": {
    "serviceName": "cakeos-launcher",
