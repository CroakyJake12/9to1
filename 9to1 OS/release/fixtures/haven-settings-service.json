    "dbusName": "org.haven.Settings",
    "socketActivation": true,
    "requiredServices": ["dbus", "systemd-journald"]
  },
  "routes": [
    {
      "route": "/settings",
      "handler": "SettingsGetHandler",
      "methods": ["GET"]
    },
    {
      "route": "/settings/{key}",
      "handler": "SettingsSetHandler",
      "methods": ["PUT", "PATCH"]
    }
  ],
  "capabilities": [
    {
      "capabilityId": "haven.settings.read",
      "displayName": "Read Settings",
      "description": "Read system and user settings",
      "isRequired": true
    },
    {
      "capabilityId": "haven.settings.write",
      "displayName": "Write Settings",
      "description": "Write system and user settings",
      "isRequired": true
    }
  ],
  "dependencies": [
    {
      "dependencyId": "libglib2.0-0",
      "kind": "RequiredPackage",
      "versionConstraint": ">=2.78"
    }
  ],
  "persistence": {
    "requiresSettings": true,
    "requiresCache": false,
    "requiresState": false,
    "requiresData": false,
    "customPaths": ["/etc/haven/settings.v1.json", "/home/haven/.config/haven/settings.v1.json"]
  },
  "permissions": {
    "requiredGrants": ["settings.read", "settings.write"],
    "optionalGrants": []
