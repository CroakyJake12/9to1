{
  "productId": "llamacpp.provider",
  "productType": "Provider",
  "registryIdentity": {
    "registryId": "cakeos.shared-app-registry",
    "registrySchemaVersion": 1
  },
  "sourceRepository": {
    "url": "https://github.com/CroakyJake12/HavenOS-Platform",
    "revision": "cb15dcd1b57c39bc1ac9aaf73891ca4369cd9684",
    "branch": "main",
    "tag": "llamacpp-runtime-0.1.0"
  },
  "donor": {
    "name": "llama.cpp",
    "repositoryUrl": "https://github.com/ggml-org/llama.cpp",
    "revision": "5266f24da75dc449bd56cbed7addb9c8e4a6a73e",
    "licence": "MIT",
    "licenceUrl": "https://github.com/ggml-org/llama.cpp/blob/master/LICENSE"
  },
  "package": {
    "name": "haven-llamacpp-runtime",
    "version": "0.1.0",
    "hashSha256": "a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456",
    "architecture": "amd64",
    "packageFormat": "deb"
  },
  "entrypoint": {
    "binaryPath": "/usr/lib/haven-llamacpp/llama-server",
    "arguments": "--host 127.0.0.1 --port 8080 --model /var/lib/haven/models/default.gguf",
    "workingDirectory": "/var/lib/haven/llamacpp",
    "environment": {
      "LLAMA_SERVER_HOST": "127.0.0.1",
      "LLAMA_SERVER_PORT": "8080"
    }
  },
  "service": {
    "serviceName": "haven-llamacpp-broker",
    "socketName": "haven-llamacpp.socket",
    "dbusName": "org.haven.LlamaCpp",
    "socketActivation": true,
    "requiredServices": ["systemd-journald"]
  },
  "routes": [
    {
      "route": "/v1/models",
      "handler": "ListModelsHandler",
      "methods": ["GET"]
    },
    {
      "route": "/v1/chat/completions",
      "handler": "ChatCompletionHandler",
      "methods": ["POST"]
    },
    {
      "route": "/v1/completions",
      "handler": "CompletionHandler",
      "methods": ["POST"]
    }
  ],
  "capabilities": [
    {
      "capabilityId": "llamacpp.inference",
      "displayName": "Local LLM Inference",
      "description": "CPU/GPU-accelerated local LLM inference via llama.cpp",
      "isRequired": true
    },
    {
      "capabilityId": "llamacpp.model-management",
      "displayName": "Model Management",
      "description": "Download, verify, and manage GGUF models",
      "isRequired": false
    }
  ],
  "dependencies": [
    {
      "dependencyId": "libc6",
      "kind": "RequiredPackage",
      "versionConstraint": ">=2.38"
    },
    {
      "dependencyId": "libstdc++6",
      "kind": "RequiredPackage",
      "versionConstraint": ">=13"
    }
  ],
  "persistence": {
    "requiresSettings": true,
    "requiresCache": true,
    "requiresState": true,
    "requiresData": true,
    "customPaths": ["/var/lib/haven/models", "/var/lib/haven/llamacpp", "/etc/haven/llamacpp"]
  },
  "permissions": {
    "requiredGrants": ["model.inference", "files.read", "files.write"],
    "optionalGrants": ["network.access", "hardware.gpu"]
  },
  "providers": [
    {
      "providerId": "llamacpp",
      "transportType": "http-over-unix",
      "legacyUnqualifiedProvider": "ollama",
      "models": ["llama-3.2-3b", "llama-3.1-8b", "mistral-7b", "phi-3-mini"]
    }
  ],
  "offlineRequirement": "Required",
  "smokeTest": {
    "command": "haven-modelctl --provider llamacpp list",
    "expectedOutputPattern": "llamacpp",
    "timeoutSeconds": 60,
    "requiredArtifacts": []
  },
  "smokeEvidence": {
    "executed": true,
    "exitCode": 0,
    "stdout": "llamacpp: llama-3.2-3b, llama-3.1-8b, mistral-7b, phi-3-mini\n",
    "stderr": "",
    "executedAt": "2026-09-12T12:15:00Z",
    "evidenceArtifactPath": "artifacts/smoke/llamacpp-provider-smoke.log"
  },
  "provenanceState": "Ready",
  "imageInclusionState": "Pending",
  "approvedVmState": "Partial"
}