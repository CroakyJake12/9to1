{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://havenos.platform/schemas/release-manifest-v1.json",
  "title": "HavenOS Release Manifest",
  "description": "Complete release manifest containing all components for a release. References Worker 3's cakeos.shared-app-registry v1.",
  "type": "object",
  "required": ["releaseId", "version", "createdAt", "registryIdentity", "components"],
  "properties": {
    "releaseId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "registryIdentity": {
      "type": "object",
      "required": ["registryId", "registrySchemaVersion"],
      "properties": {
        "registryId": { "const": "cakeos.shared-app-registry" },
        "registrySchemaVersion": { "const": 1 }
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "release-metadata-schema.json" }
    }
  },
  "additionalProperties": false
}