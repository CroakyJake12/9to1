{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://havenos.platform/schemas/release-metadata-v1.json",
  "title": "HavenOS Release Component Metadata",
  "description": "Release metadata schema referencing Worker 3's cakeos.shared-app-registry v1. Does NOT create a second app registry.",
  "type": "object",
  "required": [
    "productId",
    "productType",
    "registryIdentity",
    "sourceRepository",
    "donor",
    "package",
    "entrypoint",
    "service",
    "routes",
    "capabilities",
    "dependencies",
    "persistence",
    "permissions",
    "providers",
    "offlineRequirement",
    "smokeTest",
    "provenanceState",
    "imageInclusionState",
    "approvedVmState"
  ],
  "properties": {
    "productId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:-]{1,128}$",
      "description": "Product ID matching Worker 3 AppRegistry identifier format"
    },
    "productType": {
      "type": "string",
      "enum": ["App", "SystemSurface", "BackgroundComponent", "Provider", "Service"],
      "description": "Product type matching Worker 3 ProductType enum"
    },
    "registryIdentity": {
      "type": "object",
      "required": ["registryId", "registrySchemaVersion"],
      "properties": {
        "registryId": { "const": "cakeos.shared-app-registry" },
        "registrySchemaVersion": { "const": 1 }
      },
      "description": "MUST reference Worker 3's stable registry identity"
    },
    "sourceRepository": {
      "type": "object",
      "required": ["url", "revision"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" },
        "tag": { "type": "string" }
      }
    },
    "donor": {
      "type": "object",
      "required": ["name", "repositoryUrl", "revision", "licence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repositoryUrl": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 1 },
        "licence": { "type": "string", "minLength": 1 },
        "licenceUrl": { "type": "string", "format": "uri" }
      }
    },
    "package": {
      "type": "object",
      "required": ["name", "version", "hashSha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "version": { "type": "string", "minLength": 1 },
        "hashSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "architecture": { "type": "string", "enum": ["amd64", "arm64"], "default": "amd64" },
        "packageFormat": { "type": "string", "enum": ["deb", "rpm", "apk"], "default": "deb" }
      }
    },
    "entrypoint": {
      "type": "object",
      "required": ["binaryPath"],
      "properties": {
        "binaryPath": { "type": "string", "minLength": 1 },
        "arguments": { "type": "string" },
        "workingDirectory": { "type": "string" },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "serviceName": { "type": "string" },
        "socketName": { "type": "string" },
        "dbusName": { "type": "string" },
        "socketActivation": { "type": "boolean", "default": false },
        "requiredServices": { "type": "array", "items": { "type": "string" } }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route", "handler"],
        "properties": {
          "route": { "type": "string", "pattern": "^/.*" },
          "handler": { "type": "string", "minLength": 1 },
          "methods": { "type": "array", "items": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "WS"] } }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capabilityId", "displayName", "description"],
        "properties": {
          "capabilityId": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "isRequired": { "type": "boolean", "default": true }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dependencyId", "kind"],
        "properties": {
          "dependencyId": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["RequiredProduct", "OptionalProduct", "RequiredProvider", "OptionalProvider", "RequiredPackage", "OptionalPackage"] },
          "versionConstraint": { "type": "string" }
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["requiresSettings", "requiresCache", "requiresState", "requiresData"],
      "properties": {
        "requiresSettings": { "type": "boolean" },
        "requiresCache": { "type": "boolean" },
        "requiresState": { "type": "boolean" },
        "requiresData": { "type": "boolean" },
        "customPaths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["requiredGrants", "optionalGrants"],
      "properties": {
        "requiredGrants": { "type": "array", "items": { "type": "string" } },
        "optionalGrants": { "type": "array", "items": { "type": "string" } }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["providerId", "transportType"],
        "properties": {
          "providerId": { "type": "string", "minLength": 1 },
          "transportType": { "type": "string", "minLength": 1 },
          "legacyUnqualifiedProvider": { "type": "string" },
          "models": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "offlineRequirement": {
      "type": "string",
      "enum": ["NotRequired", "Preferred", "Required"],
      "default": "NotRequired"
    },
    "smokeTest": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "expectedOutputPattern": { "type": "string" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 60 },
        "requiredArtifacts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "smokeEvidence": {
      "type": "object",
      "properties": {
        "executed": { "type": "boolean" },
        "exitCode": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "executedAt": { "type": "string", "format": "date-time" },
        "evidenceArtifactPath": { "type": "string" }
      }
    },
    "provenanceState": {
      "type": "string",
      "enum": ["Unknown", "Partial", "Blocked", "Ready"],
      "description": "Explicit provenance state - no implicit assumptions"
    },
    "imageInclusionState": {
      "type": "string",
      "enum": ["NotApplicable", "Excluded", "Pending", "Included"],
      "description": "Image inclusion state - distinct from provenance readiness"
    },
    "approvedVmState": {
      "type": "string",
      "enum": ["NotTested", "Failed", "Partial", "Verified"],
      "description": "Approved VM test state - separate from image inclusion"
    }
  },
  "additionalProperties": false
}