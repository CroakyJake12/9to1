<Cui>
  <Resources>
    <item key="PrimaryColor" value="#2196F3" />
    <item key="BackgroundColor" value="#FAFAFA" />
    <item key="TextPrimary" value="#212121" />
    <item key="TextSecondary" value="#757575" />
    <item key="CardBackground" value="#FFFFFF" />
    <item key="AccentColor" value="#FF5722" />
  </Resources>

  <Styles>
    <Style selector="Card">
      <Setter property="Background" value="{Resource CardBackground}" />
      <Setter property="CornerRadius" value="8" />
      <Setter property="Margin" value="8" />
      <Setter property="Padding" value="16" />
    </Style>
  </Styles>

  <StackPanel class="RootStack" orientation="Vertical" width="1200" height="800">

    <!-- Header with live binding: title updates via binding -->
    <Border background="{Resource PrimaryColor}" padding="24 16">
      <StackPanel orientation="Horizontal">
        <TextBlock text="&#x1F3E0; " font-size="24" foreground="White" />
        <TextBlock text="{Binding AppName, fallback=Home}" font-size="24" font-weight="Bold" foreground="White" />
      </StackPanel>
    </Border>

    <!-- Welcome Section -->
    <StackPanel orientation="Vertical" margin="24 16">
      <TextBlock text="{Binding WelcomeMessage, fallback=Welcome to 9to1}" font-size="24" font-weight="Bold" foreground="{Resource TextPrimary}" />
      <TextBlock text="Powered by CUI runtime + Avalonia 12.0.1 (forked)" font-size="14" foreground="{Resource TextSecondary}" margin="0 4 0 0" />
    </StackPanel>

    <!-- Interactive demo row -->
    <Border background="#E3F2FD" padding="16" margin="24 8">
      <StackPanel orientation="Vertical">
        <TextBlock text="Live Bindings &amp; Actions Demo" font-size="16" font-weight="SemiBold" margin="0 0 0 8" />
        <StackPanel orientation="Horizontal" margin="0 8 0 0">
          <Button content="Open Terminal" action="OpenTerminal" margin="0 0 8 0" />
          <Button content="Refresh Time" action="OpenTerminal" margin="0 0 8 0" />
          <TextBlock text="{Binding StatusText, fallback=Ready}" font-size="14" vertical-alignment="Center" margin="16 0 0 0" />
        </StackPanel>
        <StackPanel orientation="Horizontal" margin="0 8 0 0">
          <TextBlock text="Click count: " font-size="13" vertical-alignment="Center" />
          <TextBlock text="{Binding ClickCount, fallback=0}" font-size="13" font-weight="Bold" vertical-alignment="Center" />
          <TextBlock text="  |  Current time: " font-size="13" vertical-alignment="Center" />
          <TextBlock text="{Binding CurrentTime, fallback=--:--}" font-size="13" font-weight="Bold" vertical-alignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- App Cards Grid -->
    <Grid margin="24 8" column="3" row="2">

      <!-- Chat Card -->
      <Border class="Card" grid-column="0" grid-row="0" background="{Resource CardBackground}">
        <StackPanel orientation="Vertical" action="OpenChat">
          <TextBlock text="&#x1F4AC;" font-size="32" />
          <TextBlock text="Chat" font-size="18" font-weight="SemiBold" margin="0 8 0 4" />
          <TextBlock text="Messages &amp; conversations" font-size="13" foreground="{Resource TextSecondary}" />
        </StackPanel>
      </Border>

      <!-- Tasks Card -->
      <Border class="Card" grid-column="1" grid-row="0" background="{Resource CardBackground}">
        <StackPanel orientation="Vertical" action="OpenTasks">
          <TextBlock text="&#x2705;" font-size="32" />
          <TextBlock text="Tasks" font-size="18" font-weight="SemiBold" margin="0 8 0 4" />
          <TextBlock text="To-dos &amp; projects" font-size="13" foreground="{Resource TextSecondary}" />
        </StackPanel>
      </Border>

      <!-- Browse Card -->
      <Border class="Card" grid-column="2" grid-row="0" background="{Resource CardBackground}">
        <StackPanel orientation="Vertical" action="OpenBrowse">
          <TextBlock text="&#x1F310;" font-size="32" />
          <TextBlock text="Browse" font-size="18" font-weight="SemiBold" margin="0 8 0 4" />
          <TextBlock text="Web &amp; bookmarks" font-size="13" foreground="{Resource TextSecondary}" />
        </StackPanel>
      </Border>

      <!-- Files Card -->
      <Border class="Card" grid-column="0" grid-row="1" background="{Resource CardBackground}">
        <StackPanel orientation="Vertical" action="OpenFiles">
          <TextBlock text="&#x1F4C1;" font-size="32" />
          <TextBlock text="Files" font-size="18" font-weight="SemiBold" margin="0 8 0 4" />
          <TextBlock text="Documents &amp; media" font-size="13" foreground="{Resource TextSecondary}" />
        </StackPanel>
      </Border>

      <!-- Data Card -->
      <Border class="Card" grid-column="1" grid-row="1" background="{Resource CardBackground}">
        <StackPanel orientation="Vertical" action="OpenData">
          <TextBlock text="&#x1F4CA;" font-size="32" />
          <TextBlock text="Data" font-size="18" font-weight="SemiBold" margin="0 8 0 4" />
          <TextBlock text="Analytics &amp; insights" font-size="13" foreground="{Resource TextSecondary}" />
        </StackPanel>
      </Border>

      <!-- Terminal Card -->
      <Border class="Card" grid-column="2" grid-row="1" background="{Resource CardBackground}">
        <StackPanel orientation="Vertical" action="OpenTerminal">
          <TextBlock text="&#x1F5A5;&#xFE0F;" font-size="32" />
          <TextBlock text="Terminal" font-size="18" font-weight="SemiBold" margin="0 8 0 4" />
          <TextBlock text="Command line" font-size="13" foreground="{Resource TextSecondary}" />
        </StackPanel>
      </Border>

    </Grid>

    <!-- Bottom Status Bar with live binding -->
    <Border background="{Resource PrimaryColor}" padding="16 8">
      <StackPanel orientation="Horizontal">
        <TextBlock text="CUI Runtime: Active  |  Avalonia 12.0.1 (forked)  |  No AXAML  |  " font-size="12" foreground="White" />
        <TextBlock text="{Binding StatusText, fallback=Ready}" font-size="12" foreground="White" />
      </StackPanel>
    </Border>

  </StackPanel>
</Cui>
