<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The fixture's anonymous JSON report uses the same reflection contract
         as the executed native fixture and the current browser host. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <BrowserApplicationSource Condition="'$(BrowserApplicationSource)' == ''">$(MSBuildThisFileDirectory)../BrowserApplication.cs</BrowserApplicationSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BrowserNavigationCancellationRegression.cs;BrowserRenderPlatformShims.cs" />
    <Compile Include="$(BrowserApplicationSource)" Link="Production/BrowserApplication.cs" />
    <Compile Include="../BrowserRouteCodec.cs;../BrowserRouteDispatcher.cs;../BrowserSurfaceRegistry.cs;../BrowserHomeContext.cs;../BrowserActionAvailability.cs;../BrowserAccessibilityBridge.cs;../BrowserAccessibilityJsonContext.cs" Link="Production/%(Filename)%(Extension)" />
    <ProjectReference Include="../Write/Scene/Haven.WriteBrowser.Scene.csproj" />
    <ProjectReference Include="../../../9to1 Workspace/Home/HavenOS.Home.csproj" />
  </ItemGroup>
</Project>
