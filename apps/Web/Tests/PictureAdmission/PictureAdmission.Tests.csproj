<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NineToOne.Picture.Admission.Tests</AssemblyName><JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$(MSBuildProjectDirectory)/../../../..</RepositoryRoot>
    <PictureControlVariant Condition="'$(PictureControlVariant)' == ''">current</PictureControlVariant>
    <PictureSourceRoot Condition="'$(PictureControlVariant)' == 'current'">$(RepositoryRoot)/apps/Web/Picture</PictureSourceRoot>
    <PictureSourceRoot Condition="'$(PictureControlVariant)' == 'production-original'">$(MSBuildProjectDirectory)/Fixtures/ProductionOriginal</PictureSourceRoot>
    <PictureSourceRoot Condition="'$(PictureControlVariant)' == 'admission01'">$(MSBuildProjectDirectory)/Fixtures/Admission01</PictureSourceRoot>
    <PictureMarkupSource Condition="'$(PictureControlVariant)' == 'current'">$(RepositoryRoot)/apps/Web/Picture/Picture.cui</PictureMarkupSource>
    <PictureMarkupSource Condition="'$(PictureControlVariant)' != 'current'">$(PictureSourceRoot)/Picture.cui</PictureMarkupSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PictureRawPngMetadata.cs" />
    <Compile Include="PictureProductionOriginalRegression.cs" Condition="'$(PictureControlVariant)' == 'production-original'" />
    <Compile Include="PictureAdmissionRegression.cs" Condition="'$(PictureControlVariant)' != 'production-original'" />
    <Compile Include="$(PictureSourceRoot)/PictureBrowserFeature.cs;$(PictureSourceRoot)/PictureBrowserSession.cs" Link="SelectedActualSource/%(Filename)%(Extension)" />
    <Compile Include="$(RepositoryRoot)/apps/Web/BrowserSurfaceRegistry.cs;$(RepositoryRoot)/apps/Web/Media/IPictureBrowserMedia.cs;$(RepositoryRoot)/apps/Web/Media/BrowserPictureMedia.cs" Link="Production/%(Filename)%(Extension)" />
    <ProjectReference Include="$(RepositoryRoot)/apps/Web/Picture/Engine/NineToOne.Picture.BrowserEngine.csproj" />
    <ProjectReference Include="$(RepositoryRoot)/framework/CUI/Runtime/CakeOS.Cui.Runtime.csproj" />
    <ProjectReference Include="$(RepositoryRoot)/framework/CUI/vendor/Avalonia/src/Headless/Avalonia.Headless/Avalonia.Headless.csproj" />
    <ProjectReference Include="$(RepositoryRoot)/9to1 Workspace/Home/HavenOS.Home.csproj" />
    <EmbeddedResource Include="$(PictureMarkupSource)" LogicalName="NineToOne.Picture.Admission.Tests.Picture.cui" />
    <None Include="Fixtures/Picture8x6.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireExplicitPictureVariant" BeforeTargets="CoreCompile">
    <Error Condition="'$(PictureControlVariant)' != 'current' and '$(PictureControlVariant)' != 'production-original' and '$(PictureControlVariant)' != 'admission01'" Text="Unknown Picture control variant; source selection is explicit and closed." />
  </Target>
</Project>
