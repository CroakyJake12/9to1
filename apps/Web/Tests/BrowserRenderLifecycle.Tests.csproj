<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType>
    <Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <BrowserApplicationSource Condition="'$(BrowserApplicationSource)' == ''">$(MSBuildThisFileDirectory)../BrowserApplication.cs</BrowserApplicationSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BrowserRenderLifecycleRegression.cs;BrowserRenderPlatformShims.cs" />
    <Compile Include="$(BrowserApplicationSource)" Link="Production/BrowserApplication.cs" />
    <Compile Include="../BrowserCanonicalIcons.cs" Link="Production/BrowserCanonicalIcons.cs" />
    <Compile Include="../BrowserRouteCodec.cs;../BrowserRouteDispatcher.cs;../BrowserSurfaceRegistry.cs;../BrowserHomeContext.cs;../BrowserActionAvailability.cs;../BrowserAccessibilityBridge.cs;../BrowserAccessibilityJsonContext.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../BrowserHomeContext.Dashboard.cs;../BrowserHomePresentation.cs;../BrowserShellActions.cs;../BrowserHomeDashboardLayoutStore.cs;../Home/HomeLocalPreferences.cs;../Home/BrowserHomeBriefingSources.cs;../Home/BrowserAppearanceSettings.cs;../Accounts/AccountSettingsFeature.cs;../Accounts/AccountBrowserBindings.cs;../Services/IAccountBrowserTransport.cs;../Services/BrowserAccountTransport.cs;../Services/BrowserTaskActorSource.cs;../Services/BrowserTaskIdentityReadOperation.cs" Link="Production/%(Filename)%(Extension)" />
    <ProjectReference Include="../Write/Scene/Haven.WriteBrowser.Scene.csproj" />
    <ProjectReference Include="../../../9to1 Workspace/Home/HavenOS.Home.csproj" />
  </ItemGroup>
</Project>
