<Cui id="home" product="9-1" version="1">
  <Theme Name="user_preference">
    <Page>
      <Container id="home-root" background="{Resource CuiShellBrush}" Type="Grid" RowSizes="Auto 1fr">
        <Container id="header-frame" padding="20,14" background="Transparent" Type="Overlay">
          <Container id="top-bar" Type="Grid" ColumnSizes="Auto Auto 1fr Auto">
            <Button id="open-navigation" action="ToggleDrawer" content="Menu" margin="0,0,12,0" accessible-name="Open navigation" />
            <Text id="brand" text="9to1" font-size="22" font-weight="Bold" foreground="{Resource CuiTextBrush}" margin="0,0,28,0" vertical-alignment="Center" Column="1" />
            <Container id="header-search" max-width="470" horizontal-alignment="Left" Type="Grid" Column="2" ColumnSizes="1fr Auto">
              <Input id="global-search" placeholder-text="Find an app on this device" accessible-name="Find an app on this device" min-width="160" Type="Text" Value="{Binding AppSearch, mode=TwoWay}" />
              <Button id="search-apps" action="SearchApps" content="Find" margin="8,0,0,0" Column="1" />
            </Container>
            <Container id="header-utilities" horizontal-alignment="Right" Type="Wrap" Column="3">
              <If Condition="{Binding StudioAvailable}">
                <Button id="open-studio" action="OpenStudio" content="Open Studio" margin="0,0,10,8" />
              </If>
              <Button id="header-account" action="NavigateSettings" content="{Binding AccountLabel}" margin="0" />
            </Container>
          </Container>
        </Container>
        <Container id="home-body" Type="Grid" Row="1" ColumnSizes="220 1fr">
          <Button id="drawer-dismiss" action="ToggleDrawer" content="" accessible-name="Close navigation" Background="{Resource CuiBackgroundBrush}" Opacity="0.75" CornerRadius="0" BorderWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          <Container id="navigation-rail" padding="12" background="{Resource CuiBackgroundBrush}" Type="Overlay" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="0">
            <Container horizontal-scrolling="false" vertical-scrolling="true" Type="Overlay">
              <Container id="navigation-content" Type="Vertical Stack">
                <Text text="WORKSPACE" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" font-size="11" font-weight="SemiBold" margin="10,8,0,16" />
                <Container id="primary-navigation" orientation="Vertical" Type="Wrap">
                  <Container id="nav-row-home" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                    <Container id="nav-marker-home" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                    <Button id="nav-home" action="NavigateDashboard" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Home" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                      <Container Type="Horizontal Stack" CellGap="12" id="nav-home-content">
                        <Image Source="icon:home" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-home-icon" />
                        <Text Text="Home" VerticalAlignment="Center" id="nav-home-label" />
                      </Container>
                    </Button>
                  </Container>
                  <Container id="nav-row-spaces" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                    <Container id="nav-marker-spaces" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                    <Button id="nav-spaces" action="NavigateSpaces" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Spaces" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                      <Container Type="Horizontal Stack" CellGap="12" id="nav-spaces-content">
                        <Image Source="icon:window" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-spaces-icon" />
                        <Text Text="Spaces" VerticalAlignment="Center" id="nav-spaces-label" />
                      </Container>
                    </Button>
                  </Container>
                  <Container id="nav-row-library" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                    <Container id="nav-marker-library" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                    <Button id="nav-library" action="NavigateLibrary" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Library" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                      <Container Type="Horizontal Stack" CellGap="12" id="nav-library-content">
                        <Image Source="icon:folder" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-library-icon" />
                        <Text Text="Library" VerticalAlignment="Center" id="nav-library-label" />
                      </Container>
                    </Button>
                  </Container>
                  <Container id="nav-row-events" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                    <Container id="nav-marker-events" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                    <Button id="nav-events" action="NavigateEvents" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Events" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                      <Container Type="Horizontal Stack" CellGap="12" id="nav-events-content">
                        <Image Source="icon:calendar" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-events-icon" />
                        <Text Text="Events" VerticalAlignment="Center" id="nav-events-label" />
                      </Container>
                    </Button>
                  </Container>
                  <Container id="nav-row-settings" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                    <Container id="nav-marker-settings" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                    <Button id="nav-settings" action="NavigateSettings" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Settings" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                      <Container Type="Horizontal Stack" CellGap="12" id="nav-settings-content">
                        <Image Source="icon:settings" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-settings-icon" />
                        <Text Text="Settings" VerticalAlignment="Center" id="nav-settings-label" />
                      </Container>
                    </Button>
                  </Container>
                </Container>
                <Button id="more-navigation" action="ToggleMoreNavigation" content="{Binding MoreNavigationLabel}" margin="0,18,0,0" font-size="12" />
                <If Condition="{Binding ShowMoreNavigation}">
                  <Container Type="Vertical Stack">
                    <Text text="Some services are not connected" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" font-size="12" margin="10,16,0,10" />
                    <Container id="secondary-navigation" orientation="Vertical" Type="Wrap">
                      <Container id="nav-row-apps" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                        <Container id="nav-marker-apps" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                        <Button id="nav-apps" action="NavigateApps" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Apps" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                          <Container Type="Horizontal Stack" CellGap="12" id="nav-apps-content">
                            <Image Source="icon:dashboard" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-apps-icon" />
                            <Text Text="Apps" VerticalAlignment="Center" id="nav-apps-label" />
                          </Container>
                        </Button>
                      </Container>
                      <Container id="nav-row-discover" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                        <Container id="nav-marker-discover" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                        <Button id="nav-discover" action="NavigateDiscover" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Discover" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                          <Container Type="Horizontal Stack" CellGap="12" id="nav-discover-content">
                            <Image Source="icon:search" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-discover-icon" />
                            <Text Text="Discover" VerticalAlignment="Center" id="nav-discover-label" />
                          </Container>
                        </Button>
                      </Container>
                      <Container id="nav-row-mesh" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                        <Container id="nav-marker-mesh" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                        <Button id="nav-mesh" action="NavigateMesh" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Mesh" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                          <Container Type="Horizontal Stack" CellGap="12" id="nav-mesh-content">
                            <Image Source="icon:cpu" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-mesh-icon" />
                            <Text Text="Mesh" VerticalAlignment="Center" id="nav-mesh-label" />
                          </Container>
                        </Button>
                      </Container>
                      <Container id="nav-row-permissions" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                        <Container id="nav-marker-permissions" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                        <Button id="nav-permissions" action="NavigatePermissions" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Permissions" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                          <Container Type="Horizontal Stack" CellGap="12" id="nav-permissions-content">
                            <Image Source="icon:shield" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-permissions-icon" />
                            <Text Text="Permissions" VerticalAlignment="Center" id="nav-permissions-label" />
                          </Container>
                        </Button>
                      </Container>
                      <Container id="nav-row-notifications" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                        <Container id="nav-marker-notifications" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                        <Button id="nav-notifications" action="NavigateNotifications" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Notifications" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                          <Container Type="Horizontal Stack" CellGap="12" id="nav-notifications-content">
                            <Image Source="icon:bell" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-notifications-icon" />
                            <Text Text="Notifications" VerticalAlignment="Center" id="nav-notifications-label" />
                          </Container>
                        </Button>
                      </Container>
                      <Container id="nav-row-automations" margin="0,0,0,6" Type="Grid" ColumnSizes="10 1fr">
                        <Container id="nav-marker-automations" width="3" height="22" corner-radius="2" vertical-alignment="Center" horizontal-alignment="Left" background="{Resource CuiAccentBrush}" Type="Overlay" />
                        <Button id="nav-automations" action="NavigateAutomations" margin="0" horizontal-alignment="Stretch" Column="1" accessible-name="Automations" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                          <Container Type="Horizontal Stack" CellGap="12" id="nav-automations-content">
                            <Image Source="icon:refresh" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="nav-automations-icon" />
                            <Text Text="Automations" VerticalAlignment="Center" id="nav-automations-label" />
                          </Container>
                        </Button>
                      </Container>
                    </Container>
                    <Text text="Some destinations need a connected service or the desktop app." text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" font-size="12" margin="10,16,10,8" />
                  </Container>
                </If>
              </Container>
            </Container>
          </Container>
          <Container id="home-content-frame" background="{Resource CuiPanelBrush}" corner-radius="8" margin="0,0,12,12" Type="Overlay" Column="1">
            <Container id="home-content-scroll" horizontal-scrolling="false" vertical-scrolling="true" Type="Overlay">
              <Container id="home-content" margin="28" Type="Vertical Stack">
                <If Condition="{Binding IsDashboard}">
                  <Container id="dashboard-page" Type="Vertical Stack">
                    <Text text="{Binding DayLabel}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" id="day-label" font-size="13" margin="0,0,0,8" />
                    <Container id="dashboard-heading-row" Type="Wrap">
                      <Text id="welcome-heading" text="Your day, in focus" font-size="32" font-weight="Bold" text-wrapping="Wrap" foreground="{Resource CuiTextBrush}" margin="0,0,24,10" />
                      <Button id="customise-dashboard" action="ToggleCustomise" content="{Binding CustomiseLabel}" margin="0,0,10,8" Background="{Resource CuiAccentBrush}" Foreground="{Resource CuiAccentForegroundBrush}" />
                    </Container>
                    <Container id="dashboard-brief" margin="0,4,0,24" Type="Vertical Stack">
                      <Text text="{Binding BriefSummary}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" id="dashboard-brief-status" font-size="15" />
                      <Text text="{Binding BriefSource}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" font-size="12" margin="0,8,0,0" />
                    </Container>
                    <If Condition="{Binding IsCustomising}">
                      <Container id="dashboard-layout-controls" padding="22" corner-radius="14" background="{Resource CuiPanel2Brush}" margin="0,0,0,24" Type="Overlay">
                        <Container Type="Vertical Stack">
                          <Text text="Customise your dashboard" text-wrapping="Wrap" font-size="20" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" margin="0,0,0,10" />
                          <Text text="{Binding LocalPreferenceSummary}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" margin="0,0,0,16" />
                          <Container Type="Wrap">
                            <Button id="choose-start" action="ChooseTile_continue" content="Start here" margin="0,0,10,8" />
                            <Button id="choose-apps" action="ChooseTile_apps" content="Quick access" margin="0,0,10,8" />
                            <Button id="choose-activity" action="ChooseTile_activity" content="Events activity" margin="0,0,10,8" />
                            <Button id="choose-services" action="ChooseTile_services" content="Connections" margin="0,0,10,8" />
                          </Container>
                          <Text text="{Binding SelectedLocalTileName}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" font-weight="SemiBold" margin="0,12,0,0" />
                          <Text text="{Binding TileEditReason}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" margin="0,12,0,12" />
                          <Container Type="Wrap">
                            <Button id="move-local-up" action="MoveLocalUp" content="Move up" margin="0,0,10,8" />
                            <Button id="move-local-down" action="MoveLocalDown" content="Move down" margin="0,0,10,8" />
                            <Button id="pin-local-tile" action="ToggleLocalPin" content="{Binding PinTileLabel}" margin="0,0,10,8" />
                            <Button id="lock-local-tile" action="ToggleLocalLock" content="{Binding LockTileLabel}" margin="0,0,10,8" />
                            <Button id="hide-local-tile" action="ToggleLocalHidden" content="{Binding HideTileLabel}" margin="0,0,10,8" />
                            <Button id="reset-local-layout" action="ResetLocalLayout" content="Reset tile layout" margin="0,0,10,8" />
                          </Container>
                          <Text text="AI preferences" text-wrapping="Wrap" font-size="16" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" margin="0,20,0,10" />
                          <Input id="ai-tiles-switch" action="ToggleAiTiles" content="Allow AI-generated tiles" margin="0,0,0,10" Type="Checkbox" Checked="{Binding AiTilesSwitch}" />
                          <Input id="ai-reorder-switch" action="ToggleAiReorder" content="Allow AI to rearrange unpinned, unlocked tiles" Type="Checkbox" Checked="{Binding AiReorderSwitch}" />
                          <Text text="{Binding AiSummary}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" margin="0,10,0,0" />
                          <If Condition="{Binding DashboardHasLayout}">
                            <Container margin="0,20,0,0" Type="Vertical Stack">
                              <Text text="Account dashboard tiles" text-wrapping="Wrap" font-size="16" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" margin="0,0,0,10" />
                              <Text text="{Binding DashboardTilesSummary}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                              <Input id="dashboard-tile-list" items-source="{Binding DashboardTilesItems}" selected-index="{Binding SelectedDashboardTileIndex, mode=TwoWay}" accessible-name="Saved account dashboard tiles" height="110" margin="0,10,0,10" Type="List" />
                              <Container Type="Wrap">
                                <Button id="add-dashboard-tile" action="AddDashboardTile" content="Add account tile" margin="0,0,10,8" />
                                <Button id="remove-dashboard-tile" action="RemoveSelectedDashboardTile" content="Remove selected" margin="0,0,10,8" />
                                <Button id="refresh-dashboard-tile" action="RefreshSelectedDashboardTile" content="Reload account layout" margin="0,0,10,8" />
                              </Container>
                            </Container>
                          </If>
                        </Container>
                      </Container>
                    </If>
                    <Container id="dashboard-tile-host" Type="Vertical Stack">
                      <Container id="tile-continue" padding="26" corner-radius="18" background="{Resource CuiPanel2Brush}" margin="0,0,0,24" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1">
                        <Container id="home-hero" Type="Grid" ColumnSizes="1fr 240">
                          <Container id="hero-copy" margin="0,0,28,0" Type="Vertical Stack">
                            <Text text="START HERE" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" font-size="11" font-weight="SemiBold" margin="0,0,0,14" />
                            <Text text="{Binding PriorityTitle}" text-wrapping="Wrap" font-size="25" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" margin="0,0,0,10" />
                            <Text text="{Binding PrioritySummary}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" id="hero-description" font-size="15" margin="0,0,0,18" />
                            <If Condition="{Binding HasRecentDocuments}">
                              <Button id="continue-recent" action="OpenRecent0" content="Continue in Write" margin="0,0,10,8" Background="{Resource CuiAccentBrush}" Foreground="{Resource CuiAccentForegroundBrush}" />
                            </If>
                            <Container Type="Wrap">
                              <Button id="hero-write" action="OpenWrite" content="Open Write" margin="0,0,10,8" Background="{Resource CuiAccentBrush}" Foreground="{Resource CuiAccentForegroundBrush}" />
                              <Button id="hero-boards" action="OpenBoards" content="Open Boards" margin="0,0,10,8" />
                            </Container>
                          </Container>
                          <Container id="hero-context" padding="20" corner-radius="12" background="{Resource CuiPanelBrush}" Type="Overlay" Column="1">
                            <Container Type="Vertical Stack">
                              <Text text="On this device" text-wrapping="Wrap" font-size="16" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" margin="0,0,0,10" />
                              <Text text="{Binding RecentSummary}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" margin="0,0,0,12" />
                              <Text text="{Binding LocalAppsSummary}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" font-size="13" />
                              <If Condition="{Binding HasRecent1}">
                                <Button id="recent-1" action="OpenRecent1" content="{Binding Recent1}" margin="0,12,0,0" />
                              </If>
                              <If Condition="{Binding HasRecent2}">
                                <Button id="recent-2" action="OpenRecent2" content="{Binding Recent2}" margin="0,8,0,0" />
                              </If>
                            </Container>
                          </Container>
                        </Container>
                      </Container>
                      <Container id="tile-apps" margin="0,0,0,24" Type="Vertical Stack">
                        <Text text="Quick access" text-wrapping="Wrap" font-size="20" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" margin="0,0,0,10" />
                        <Text text="Open your tools and continue in their local workspace." text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" margin="0,0,0,16" />
                        <Text text="{Binding AppSearchSummary}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" id="app-search-summary" margin="0,0,0,8" />
                        <Container id="app-cards" Type="Wrap">
                          <If Condition="{Binding ShowWrite}">
                            <Container id="app-card-write" padding="18" background="{Resource CuiPanel2Brush}" width="230" margin="0,0,12,12" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="{Resource CuiCardRadius}">
                              <Container Type="Vertical Stack">
                                <Button id="shortcut-write" action="OpenWrite" margin="0,0,10,8" horizontal-alignment="Stretch" accessible-name="Write" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                                  <Container Type="Horizontal Stack" CellGap="12" id="shortcut-write-content">
                                    <Image Source="icon:file" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="shortcut-write-icon" />
                                    <Text Text="Write" VerticalAlignment="Center" id="shortcut-write-label" />
                                  </Container>
                                </Button>
                                <Text text="{Binding WriteAvailability}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                              </Container>
                            </Container>
                          </If>
                          <If Condition="{Binding ShowPresent}">
                            <Container id="app-card-present" padding="18" background="{Resource CuiPanel2Brush}" width="230" margin="0,0,12,12" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="{Resource CuiCardRadius}">
                              <Container Type="Vertical Stack">
                                <Button id="shortcut-present" action="OpenPresent" margin="0,0,10,8" horizontal-alignment="Stretch" accessible-name="Present" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                                  <Container Type="Horizontal Stack" CellGap="12" id="shortcut-present-content">
                                    <Image Source="icon:present" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="shortcut-present-icon" />
                                    <Text Text="Present" VerticalAlignment="Center" id="shortcut-present-label" />
                                  </Container>
                                </Button>
                                <Text text="{Binding PresentAvailability}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                              </Container>
                            </Container>
                          </If>
                          <If Condition="{Binding ShowPicture}">
                            <Container id="app-card-picture" padding="18" background="{Resource CuiPanel2Brush}" width="230" margin="0,0,12,12" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="{Resource CuiCardRadius}">
                              <Container Type="Vertical Stack">
                                <Button id="shortcut-picture" action="OpenPicture" margin="0,0,10,8" horizontal-alignment="Stretch" accessible-name="Picture" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                                  <Container Type="Horizontal Stack" CellGap="12" id="shortcut-picture-content">
                                    <Image Source="icon:palette" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="shortcut-picture-icon" />
                                    <Text Text="Picture" VerticalAlignment="Center" id="shortcut-picture-label" />
                                  </Container>
                                </Button>
                                <Text text="{Binding PictureAvailability}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                              </Container>
                            </Container>
                          </If>
                          <If Condition="{Binding ShowWave}">
                            <Container id="app-card-wave" padding="18" background="{Resource CuiPanel2Brush}" width="230" margin="0,0,12,12" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="{Resource CuiCardRadius}">
                              <Container Type="Vertical Stack">
                                <Button id="shortcut-wave" action="OpenWave" margin="0,0,10,8" horizontal-alignment="Stretch" accessible-name="Wave" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                                  <Container Type="Horizontal Stack" CellGap="12" id="shortcut-wave-content">
                                    <Image Source="icon:wave" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="shortcut-wave-icon" />
                                    <Text Text="Wave" VerticalAlignment="Center" id="shortcut-wave-label" />
                                  </Container>
                                </Button>
                                <Text text="{Binding WaveAvailability}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                              </Container>
                            </Container>
                          </If>
                          <If Condition="{Binding ShowBoards}">
                            <Container id="app-card-boards" padding="18" background="{Resource CuiPanel2Brush}" width="230" margin="0,0,12,12" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="{Resource CuiCardRadius}">
                              <Container Type="Vertical Stack">
                                <Button id="shortcut-boards" action="OpenBoards" margin="0,0,10,8" horizontal-alignment="Stretch" accessible-name="Boards" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                                  <Container Type="Horizontal Stack" CellGap="12" id="shortcut-boards-content">
                                    <Image Source="icon:boards" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="shortcut-boards-icon" />
                                    <Text Text="Boards" VerticalAlignment="Center" id="shortcut-boards-label" />
                                  </Container>
                                </Button>
                                <Text text="{Binding BoardsAvailability}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                              </Container>
                            </Container>
                          </If>
                          <If Condition="{Binding ShowBrowse}">
                            <Container id="app-card-browse" padding="18" background="{Resource CuiPanel2Brush}" width="230" margin="0,0,12,12" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="{Resource CuiCardRadius}">
                              <Container Type="Vertical Stack">
                                <Button id="shortcut-browse" action="OpenBrowse" margin="0,0,10,8" horizontal-alignment="Stretch" accessible-name="Browse" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                                  <Container Type="Horizontal Stack" CellGap="12" id="shortcut-browse-content">
                                    <Image Source="icon:browse" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="shortcut-browse-icon" />
                                    <Text Text="Browse" VerticalAlignment="Center" id="shortcut-browse-label" />
                                  </Container>
                                </Button>
                                <Text text="{Binding BrowseAvailability}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                              </Container>
                            </Container>
                          </If>
                          <If Condition="{Binding ShowData}">
                            <Container id="app-card-data" padding="18" background="{Resource CuiPanel2Brush}" width="230" margin="0,0,12,12" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="{Resource CuiCardRadius}">
                              <Container Type="Vertical Stack">
                                <Button id="shortcut-data" action="OpenData" margin="0,0,10,8" horizontal-alignment="Stretch" accessible-name="Data" Background="Transparent" BorderWidth="0" HorizontalContentAlignment="Left">
                                  <Container Type="Horizontal Stack" CellGap="12" id="shortcut-data-content">
                                    <Image Source="icon:data" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" id="shortcut-data-icon" />
                                    <Text Text="Data" VerticalAlignment="Center" id="shortcut-data-label" />
                                  </Container>
                                </Button>
                                <Text text="{Binding DataAvailability}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                              </Container>
                            </Container>
                          </If>
                        </Container>
                      </Container>
                      <Container id="tile-activity" padding="24" corner-radius="14" background="{Resource CuiPanelBrush}" margin="0,0,0,24" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1">
                        <Container Type="Vertical Stack">
                          <Text text="Events · activity" text-wrapping="Wrap" font-size="20" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" margin="0,0,0,10" />
                          <Text text="{Binding ActivitySummary}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" margin="0,0,0,16" />
                          <Container Type="Wrap">
                            <Button id="refresh-local-briefing" action="RefreshLocalBriefing" content="Refresh local activity" margin="0,0,10,8" />
                            <Button id="view-activity" action="NavigateEvents" content="Open activity timeline" margin="0,0,10,8" />
                            <Button id="view-library" action="NavigateLibrary" content="Open Library" margin="0,0,10,8" />
                          </Container>
                          <Container padding="0,16,0,0" Type="Overlay">
                            <Text text="{Binding PlannerSummary}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" font-size="12" />
                          </Container>
                        </Container>
                      </Container>
                      <Container id="tile-services" padding="24" corner-radius="14" background="{Resource CuiPanelBrush}" margin="0,0,0,24" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1">
                        <Container Type="Vertical Stack">
                          <Text text="Connections" text-wrapping="Wrap" font-size="20" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" margin="0,0,0,10" />
                          <Text text="{Binding AccountMessage}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" id="home-account-status" margin="0,0,0,8" />
                          <Text text="{Binding AccountRecovery}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" font-size="12" margin="0,0,0,14" />
                          <Container Type="Wrap">
                            <If Condition="{Binding CanSignInHere}">
                              <Button id="home-account-signin" action="AccountSignIn" content="Sign in" margin="0,0,10,8" />
                            </If>
                            <Button id="home-account-refresh" action="AccountRefresh" content="Retry account connection" margin="0,0,10,8" />
                            <Button id="home-account-settings" action="NavigateSettings" content="Account settings" margin="0,0,10,8" />
                            <If Condition="{Binding CanSignOutHere}">
                              <Button id="home-account-signout" action="AccountRequestSignOut" content="Sign out" margin="0,0,10,8" />
                            </If>
                          </Container>
                          <If Condition="{Binding HasAccountConfirmation}">
                            <Container Type="Vertical Stack">
                              <Text text="{Binding AccountConfirmation}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                              <Container Type="Wrap">
                                <Button id="home-account-confirm-signout" action="AccountConfirmSignOut" content="Confirm sign out" margin="0,0,10,8" />
                                <Button id="home-account-cancel-signout" action="AccountCancelSignOut" content="Cancel" margin="0,0,10,8" />
                              </Container>
                            </Container>
                          </If>
                          <Text text="Files and activity · Not connected" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" margin="0,16,0,8" />
                          <Text text="AI models · Not connected" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" margin="0,0,0,8" />
                          <Text text="App installation · Available in the desktop app" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" margin="0,0,0,16" />
                          <Button id="service-details" action="ToggleServiceDetails" content="{Binding ServiceDetailsLabel}" margin="0,0,10,8" />
                          <If Condition="{Binding ShowServiceDetails}">
                            <Text text="{Binding ServiceDiagnostic}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" id="service-diagnostic" font-size="12" margin="0,12,0,0" />
                          </If>
                        </Container>
                      </Container>
                    </Container>
                  </Container>
                </If>
                <If Condition="{Binding IsLibrary}">
                  <Container id="library-page" Type="Vertical Stack">
                    <Text text="Library" font-size="28" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
                    <Text text="Find authorised artifacts across your apps. Items stay in their owning app." foreground="{Resource CuiTextSoftBrush}" margin="0,6,0,14" />
                    <Container Type="Horizontal Stack">
                      <Input id="library-search" placeholder-text="Search artifacts" accessible-name="Search Library" width="360" Type="Text" />
                      <Button id="library-search-submit" action="SearchLibrary" content="Search" margin="12,0,0,0" />
                    </Container>
                    <Text id="library-status" text="{Binding LibrarySummary}" foreground="{Resource CuiTextSoftBrush}" margin="0,10,0,12" />
                    <Text id="library-results" text="{Binding LibraryItemsSummary}" foreground="{Resource CuiTextBrush}" />
                    <Container margin="0,12,0,0" Type="Horizontal Stack">
                      <Button id="library-open-selected" action="OpenLibraryItem" content="Open selected" margin="0,0,8,0" />
                      <Button id="library-pin-selected" action="PinSelectedLibraryItem" content="Pin selected" margin="0,0,8,0" />
                      <Button id="library-unpin-selected" action="UnpinSelectedLibraryItem" content="Unpin selected" />
                    </Container>
                  </Container>
                </If>
                <If Condition="{Binding IsEvents}">
                  <Container id="events-page" Type="Vertical Stack">
                    <Text text="Events" font-size="28" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
                    <Text text="Activity from your authorised apps and services." foreground="{Resource CuiTextSoftBrush}" margin="0,6,0,14" />
                    <Button id="events-refresh" action="RefreshEvents" content="Refresh activity" />
                    <Text id="events-page-status" text="{Binding EventsSummary}" foreground="{Resource CuiTextSoftBrush}" margin="0,10,0,12" />
                    <Text id="events-page-items" text="{Binding EventItemsSummary}" foreground="{Resource CuiTextBrush}" />
                    <Button id="events-open-selected" action="OpenEventObject" content="Open selected activity item" margin="0,12,0,0" />
                  </Container>
                </If>
              </Container>
            </Container>
          </Container>
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>