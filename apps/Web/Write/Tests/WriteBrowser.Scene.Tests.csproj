<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The browser bridge's JSImport interop compiles here as the verification surface. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WriteFeatureSource Condition="'$(WriteFeatureSource)' == ''">$(MSBuildThisFileDirectory)../WriteBrowserFeature.cs</WriteFeatureSource>
<WriteSessionSource Condition="'$(WriteSessionSource)' == ''">$(MSBuildThisFileDirectory)../WriteBrowserSession.cs</WriteSessionSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SceneProgram.cs" />
    <Compile Include="$(WriteSessionSource);../WriteBrowserSurface.cs;$(WriteFeatureSource)" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../IWriteBrowserPackageBroker.cs" Link="Production/IWriteBrowserPackageBroker.cs" />
    <Compile Include="../IWriteBrowserImageSource.cs" Link="Production/IWriteBrowserImageSource.cs" />
    <Compile Include="../Packages/BrowserWriteImageSource.cs" Link="Production/BrowserWriteImageSource.cs" />
    <Compile Include="../../BrowserSurfaceRegistry.cs" Link="Production/BrowserSurfaceRegistry.cs" />
    <Compile Include="../../BrowserActionAvailability.cs" Link="Production/BrowserActionAvailability.cs" />
    <Compile Include="../../BrowserShellActions.cs" Link="Production/BrowserShellActions.cs" />
    <ProjectReference Include="../Scene/Haven.WriteBrowser.Scene.csproj" />
    <!-- Use the complete current owner, including Notes admission/custody partials and its real Home dependencies. -->
    <ProjectReference Include="../../../../9to1 Workspace/shared/src/Haven.Infrastructure/Haven.Infrastructure.csproj" />
    <None Include="../Write.cui" Link="Write.cui" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
