    <WriteFeatureSource Condition="'$(WriteFeatureSource)' == ''">$(MSBuildThisFileDirectory)../WriteBrowserFeature.cs</WriteFeatureSource>
<WriteSessionSource Condition="'$(WriteSessionSource)' == ''">$(MSBuildThisFileDirectory)../WriteBrowserSession.cs</WriteSessionSource>
