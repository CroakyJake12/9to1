<!--
  FILE DOCUMENTATION
  Where: apps/Web/Write/Tests/Directory.Build.props beside the five Write browser
  acceptance projects, which all share this single directory.
  What: This MSBuild/XML file gives every Write test project its own intermediate
  and output roots.
  Why: MSBuild derives bin/obj from the project directory, so the five projects
  previously shared one obj (project.assets.json, generated AssemblyInfo, nuget
  props and targets) and one bin. Whichever project restored or built last won,
  and running a single Write suite project could execute a different Write
  suite's entry point. Isolating the roots makes each Write suite build and run
  only its own sources.
  Maintenance: Keep the properties conditional on the SDK artifacts output mode
  so the artifacts path invocations used by the Write CI drivers keep working.
-->
<Project>
  <PropertyGroup Condition="'$(ArtifactsPath)' == '' and '$(UseArtifactsOutput)' != 'true'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
