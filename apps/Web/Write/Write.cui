<Cui id="write.browser" version="1">
  <Actions>
    <Action name="OpenSavedDocument" command="OpenDocument" parameter="{Binding savedDocument}" />
    <Action name="OpenStartDocument" command="OpenDocument" parameter="{Binding startDocument}" />
    <Action name="ChooseOutline" command="SelectOutline" parameter="{Binding heading}" />
    <Action name="ChooseSection" command="SelectSection" parameter="{Binding section}" />
    <Action name="ApplyStyle" command="ApplyStyle" parameter="{Binding style}" />
  </Actions>
  <Theme Name="user_preference">
    <Page>
      <Container ID="write-views" Type="Overlay" Background="{Resource CuiBackgroundBrush}">
        <Container ID="write-start" Type="Overlay" Active="{Binding ShowStart}" VerticalScrolling="True">
          <Container Type="Vertical Stack" CellGap="24" Padding="32" MaxWidth="1000" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Button Content="Home" Action="ShellHome" HorizontalAlignment="Left" />
            <Container Type="Vertical Stack" CellGap="8">
              <Text Text="Write" FontSize="32" FontWeight="SemiBold" />
              <Text Text="Make room for your next idea." FontSize="18" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            </Container>
            <Container Type="Wrap" CellGap="12">
              <Button Content="New document" Action="CreateDocument" Interactive="{Binding CanCreate}" Padding="22,16" />
              <Button Content="Import document package" Action="ImportPackage" Interactive="{Binding CanImportPackage}" Padding="22,16" />
            </Container>
            <Container Type="Overlay" Active="{Binding HasDocument}" Background="{Resource CuiPanelBrush}" Padding="20" CornerRadius="8">
              <Container Type="Vertical Stack" CellGap="10">
                <Text Text="Continue working" FontWeight="SemiBold" FontSize="18" />
                <Text Text="{Binding StartStatus}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                <Button ID="write-resume" Content="{Binding ResumeLabel}" Action="ResumeDocument" Interactive="{Binding CanResume}" HorizontalAlignment="Left" />
              </Container>
            </Container>
            <Container Type="Vertical Stack" CellGap="12">
              <Container Type="Grid" ColumnSizes="1fr Auto">
                <Text Text="Recent documents" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Column="1" Content="Refresh" Action="RefreshDocuments" Interactive="{Binding CanRefreshDocuments}" />
              </Container>
              <Text Text="Saved in this browser" Foreground="{Resource CuiTextSoftBrush}" />
              <Container Type="Overlay" Active="{Binding NoSavedDocuments}" Background="{Resource CuiPanelBrush}" Padding="20" CornerRadius="8">
                <Text Text="Create your first document, or import a saved .9to1w package." TextWrapping="Wrap" />
              </Container>
              <Repeat ID="write-start-documents" Source="{Binding Documents}" As="startDocument" Key="{Binding startDocument.Id}">
                <Button Content="{Binding startDocument.Title}" Action="OpenStartDocument" Interactive="{Binding CanBrowseDocuments}" HorizontalAlignment="Stretch" Padding="16,12" Margin="0,0,0,6" />
              </Repeat>
              <Text Text="{Binding SaveStatus}" TextWrapping="Wrap" />
              <Container Type="Overlay" Active="{Binding HasUnknownCommitOutcome}">
                <Button Content="Check saved document" Action="InspectSavedState" Interactive="{Binding CanInspectSavedState}" />
              </Container>
            </Container>
          </Container>
        </Container>
        <Container id="write-workspace" Active="{Binding ShowWorkspace}" background="{Resource CuiBackgroundBrush}" Type="Grid" RowSizes="Auto Auto Auto 1fr Auto">
          <Container padding="16,10" background="{Resource CuiPanelBrush}" Type="Overlay">
            <Container Type="Grid" ColumnSizes="Auto Auto 1fr Auto">
              <Button Content="Home" Action="ShellHome" Margin="0,0,8,0" />
              <Container Column="1" margin="0,0,12,0" vertical-alignment="Center" Type="Menu">
                <Button accessible-name="Document file menu" Type="Menu Item" Content="Write">
                  <Button action="ReturnToStart" Type="Menu Item" Content="Back to Write start" />
                  <Button action="CreateDocument" Type="Menu Item" Content="New document" Interactive="{Binding CanCreate}" />
                  <Button action="ToggleFiles" Type="Menu Item" Content="Open documents" />
                  <Button action="SaveDocument" Type="Menu Item" Content="Save" Interactive="{Binding CanSave}" />
                  <Button action="ImportPackage" Type="Menu Item" Content="Import .9to1w" Interactive="{Binding CanImportPackage}" />
                  <Button action="ExportPackage" Type="Menu Item" Content="Download .9to1w" Interactive="{Binding CanExportPackage}" />
                  <Button action="CloseDocument" Type="Menu Item" Content="Close document" Interactive="{Binding CanClose}" />
                </Button>
              </Container>
              <Input accessible-name="Document title" max-width="500" horizontal-alignment="Left" Type="Text" Column="2" Value="{Binding DocumentTitle, mode=TwoWay}" Interactive="{Binding CanSave}" />
              <Button action="SaveDocument" content="Save" margin="12,0,0,0" Column="3" Interactive="{Binding CanSave}" />
            </Container>
          </Container>
          <Container background="{Resource CuiPanel2Brush}" padding="10,6" margin="12,8" corner-radius="8" Type="Overlay" Row="1">
            <Container Type="Grid" ColumnSizes="1fr Auto">
              <Container Type="Overlay">
                <Container Type="Wrap" CellGap="5">
                  <Container Type="Overlay" Active="{Binding IsTextContext}">
                    <Container Type="Wrap" CellGap="5">
                      <Container Type="Menu">
                        <Button accessible-name="Paragraph style" Type="Menu Item" Content="{Binding CurrentStyle}">
                          <Button action="StyleNormal" Type="Menu Item" Content="Normal" Interactive="{Binding CanFormatText}" />
                          <Button action="StyleHeading1" Type="Menu Item" Content="Heading 1" Interactive="{Binding CanFormatText}" />
                          <Button action="StyleHeading2" Type="Menu Item" Content="Heading 2" Interactive="{Binding CanFormatText}" />
                          <Button action="StyleQuote" Type="Menu Item" Content="Quote" Interactive="{Binding CanFormatText}" />
                        </Button>
                      </Container>
                      <Button content="A−" accessible-name="Decrease font size" action="SmallerText" Interactive="{Binding CanFormatText}" />
                      <Text text="{Binding FontSizeLabel}" min-width="28" vertical-alignment="Center" horizontal-alignment="Center" />
                      <Button content="A+" accessible-name="Increase font size" action="LargerText" Interactive="{Binding CanFormatText}" />
                      <Button content="B" accessible-name="{Binding BoldState}" font-weight="Bold" action="BoldSelection" Interactive="{Binding CanFormatText}" />
                      <Button content="I" accessible-name="{Binding ItalicState}" font-style="Italic" action="ItalicSelection" Interactive="{Binding CanFormatText}" />
                      <Button content="U" accessible-name="{Binding UnderlineState}" action="UnderlineSelection" Interactive="{Binding CanFormatText}" />
                    </Container>
                  </Container>
                  <Container Type="Overlay" Active="{Binding IsTableContext}">
                    <Container Type="Horizontal Stack" CellGap="5">
                      <Text text="Table" vertical-alignment="Center" font-weight="SemiBold" margin="4,0,8,0" />
                      <Button content="Add row" action="AddTableRow" Interactive="{Binding CanEditTable}" />
                      <Button content="Add column" action="AddTableColumn" Interactive="{Binding CanEditTable}" />
                    </Container>
                  </Container>
                  <Container Type="Overlay" Active="{Binding IsImageContext}">
                    <Button content="Rotate image" action="RotateImage" Interactive="{Binding CanSave}" />
                  </Container>
                  <Button Content="Properties" Action="ToggleInspector" AccessibleName="Document properties" />
                </Container>
              </Container>
              <Container margin="8,0,0,0" Type="Menu" Column="1">
                <Button accessible-name="Insert content" Type="Menu Item" Content="+">
                  <Button action="InsertHeading" Type="Menu Item" Content="Heading" Interactive="{Binding CanSave}" />
                  <Button action="InsertList" Type="Menu Item" Content="Bulleted list" Interactive="{Binding CanSave}" />
                  <Button action="InsertTable" Type="Menu Item" Content="Table (3 × 3)" Interactive="{Binding CanSave}" />
                  <Button action="InsertPageBreak" Type="Menu Item" Content="Page break" Interactive="{Binding CanSave}" />
                </Button>
                <Button accessible-name="View and visibility" Type="Menu Item" Content="View">
                  <Button action="ToggleSidebar" Type="Menu Item" Content="Show / hide Sections" />
                  <Button action="ToggleFind" Type="Menu Item" Content="Find and replace" />
                </Button>
                <Button accessible-name="More contextual actions" Type="Menu Item" Content="…">
                  <Button action="Undo" Type="Menu Item" Content="Undo" Interactive="{Binding CanUndo}" />
                  <Button action="Redo" Type="Menu Item" Content="Redo" Interactive="{Binding CanRedo}" />
                  <Button action="BoldSelection" Type="Menu Item" Content="Bold" Active="{Binding IsTextContext}" Interactive="{Binding CanFormatText}" />
                  <Button action="ItalicSelection" Type="Menu Item" Content="Italic" Active="{Binding IsTextContext}" Interactive="{Binding CanFormatText}" />
                  <Button action="UnderlineSelection" Type="Menu Item" Content="Underline" Active="{Binding IsTextContext}" Interactive="{Binding CanFormatText}" />
                  <Button action="AlignLeft" Type="Menu Item" Content="Align left" Active="{Binding IsTextContext}" Interactive="{Binding CanFormatText}" />
                  <Button action="AlignCenter" Type="Menu Item" Content="Align centre" Active="{Binding IsTextContext}" Interactive="{Binding CanFormatText}" />
                  <Button action="AlignRight" Type="Menu Item" Content="Align right" Active="{Binding IsTextContext}" Interactive="{Binding CanFormatText}" />
                  <Button action="AlignJustify" Type="Menu Item" Content="Justify" Active="{Binding IsTextContext}" Interactive="{Binding CanFormatText}" />
                  <Button action="StrikeSelection" Type="Menu Item" Content="Strikethrough" Active="{Binding IsTextContext}" Interactive="{Binding CanFormatText}" />
                  <Button action="RemoveTableRow" Type="Menu Item" Content="Remove row" Active="{Binding IsTableContext}" Interactive="{Binding CanRemoveTableRow}" />
                  <Button action="RemoveTableColumn" Type="Menu Item" Content="Remove column" Active="{Binding IsTableContext}" Interactive="{Binding CanRemoveTableColumn}" />
                  <Button action="MergeCell" Type="Menu Item" Content="Merge cell right" Active="{Binding IsTableContext}" Interactive="{Binding CanMergeCell}" />
                  <Button action="SplitCell" Type="Menu Item" Content="Split cell" Active="{Binding IsTableContext}" Interactive="{Binding CanSplitCell}" />
                </Button>
              </Container>
            </Container>
          </Container>
          <Container Type="Overlay" Row="2" Active="{Binding ShowFind}">
            <Container background="{Resource CuiPanelBrush}" padding="16,8" Type="Overlay">
              <Container Type="Wrap">
                <Input accessible-name="Find text" width="180" margin="0,0,8,0" Type="Text" Value="{Binding FindText, mode=TwoWay}" />
                <Button Content="Find previous" Action="FindPrevious" Interactive="{Binding CanFind}" />
                <Button content="Find next" action="FindNext" margin="0,0,8,0" Interactive="{Binding CanFind}" />
                <Input accessible-name="Replace with" width="180" margin="0,0,8,0" Type="Text" Value="{Binding ReplacementText, mode=TwoWay}" />
                <Button content="Replace all" action="ReplaceAll" margin="0,0,8,0" Interactive="{Binding CanReplace}" />
                <Text text="{Binding FindStatus}" vertical-alignment="Center" margin="8,0" />
                <Button content="Close find" action="ToggleFind" />
                <Text Text="{Binding ReplaceStatus}" TextWrapping="Wrap" />
              </Container>
            </Container>
          </Container>
          <Container background="{Resource CuiPanelBrush}" padding="18,8" Type="Overlay" Row="4">
            <Container Type="Vertical Stack">
              <Text text="{Binding EditorStatus}" accessible-name="Document save status" text-wrapping="Wrap" />
              <Text text="{Binding PackageCleanupWarning}" text-wrapping="Wrap" />
              <Container Type="Overlay" Active="{Binding HasUnknownCommitOutcome}">
                <Button content="Inspect saved state" action="InspectSavedState" Interactive="{Binding CanInspectSavedState}" />
              </Container>
            </Container>
          </Container>
          <Container Type="Grid" Row="3" ColumnSizes="{Binding InspectorColumns}">
            <Container Type="Grid" ColumnSizes="{Binding WorkspaceColumns}" Row="0" Active="{Binding ShowEditingArea}">
              <Container Type="Grid" Column="1">
                <Container id="editor-work-scroll" Type="Overlay" HorizontalScrolling="True" VerticalScrolling="True">
                  <Container padding="20,16" Type="Overlay">
                    <Object Type="WriteDocumentSurface" />
                  </Container>
                </Container>
              </Container>
              <Container Type="Overlay" Active="{Binding ShowSidebar}" ColumnSpan="{Binding SidebarColumnSpan}">
                <Container width="220" horizontal-alignment="Left" background="{Resource CuiPanelBrush}" padding="16" Type="Overlay">
                  <Container Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
                    <Container Type="Vertical Stack" CellGap="8">
                      <Container Type="Grid" ColumnSizes="1fr Auto">
                        <Text text="Sections" font-weight="SemiBold" vertical-alignment="Center" />
                        <Button content="×" accessible-name="Close Sections" action="ToggleSidebar" Column="1" />
                      </Container>
                      <Button content="Documents / Sections" action="ToggleFiles" margin="0,0,0,10" />
                      <Container Type="Overlay" Active="{Binding ShowOutline}">
                        <Container Type="Vertical Stack" CellGap="6">
                          <Repeat Source="{Binding Sections}" As="section" Key="{Binding section.Id}">
                            <Button content="{Binding section.Title}" action="ChooseSection" font-weight="SemiBold" />
                          </Repeat>
                          <Text text="Headings" foreground="{Resource CuiTextSoftBrush}" margin="0,12,0,4" />
                          <Repeat Source="{Binding Outline}" As="heading" Key="{Binding heading.Id}">
                            <Button content="{Binding heading.Title}" action="ChooseOutline" margin="8,0,0,4" />
                          </Repeat>
                        </Container>
                      </Container>
                      <Container Type="Overlay" Active="{Binding ShowFiles}">
                        <Container Type="Vertical Stack" CellGap="8">
                          <Text text="Saved in this browser" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                          <Button content="Refresh documents" action="RefreshDocuments" Interactive="{Binding CanRefreshDocuments}" />
                          <Repeat Source="{Binding Documents}" As="savedDocument" Key="{Binding savedDocument.Id}">
                            <Button content="{Binding savedDocument.Title}" action="OpenSavedDocument" Interactive="{Binding CanBrowseDocuments}" />
                          </Repeat>
                        </Container>
                      </Container>
                    </Container>
                  </Container>
                </Container>
              </Container>
            </Container>
            <Container ID="write-inspector" Type="Grid" Column="1" RowSizes="Auto 1fr" Active="{Binding ShowInspector}" Background="{Resource CuiPanelBrush}" Padding="16" MaxWidth="340">
              <Container Type="Grid" ColumnSizes="1fr Auto" Margin="0,0,0,12">
                <Text Text="Properties" FontSize="18" FontWeight="SemiBold" />
                <Button Content="Close" AccessibleName="Close properties" Action="ToggleInspector" Column="1" />
              </Container>
              <Container Type="Overlay" Row="1" VerticalScrolling="True" HorizontalScrolling="False">
                <Container Type="Vertical Stack" CellGap="18">
                  <Container Type="Vertical Stack" CellGap="8" Active="{Binding IsTextContext}">
                    <Text Text="Text and paragraph" FontWeight="SemiBold" />
                    <Container Type="Wrap">
      </Container>
                    <Container Type="Vertical Stack" Margin="0,2">
                      <Text text="Font" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Text" accessible-name="Font family for the selected text" Value="{Binding FontFamily, Mode=TwoWay}" Interactive="{Binding CanFormat}" HorizontalAlignment="Stretch" />
                      <Text ID="write-font-size-label" text="Size" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding FontSize, Mode=TwoWay}" accessible-name="Font size in points, from 4 to 300" Interactive="{Binding CanFormat}" HorizontalAlignment="Stretch" />
                      <Text text="Text colour" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Text" accessible-name="Text colour as a hex colour value" Value="{Binding TextColor, Mode=TwoWay}" Interactive="{Binding CanFormat}" HorizontalAlignment="Stretch" />
                      <Text text="Highlight" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Text" accessible-name="Text highlight colour as a hex colour value" Value="{Binding TextHighlight, Mode=TwoWay}" Interactive="{Binding CanFormat}" HorizontalAlignment="Stretch" />
                      <Text text="Link" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Text" accessible-name="Hyperlink for the selected text" Value="{Binding Link, Mode=TwoWay}" Interactive="{Binding CanFormat}" HorizontalAlignment="Stretch" />
                    </Container>
                    <Container Type="Wrap" Margin="0,2">
                      <Text text="Run" vertical-alignment="Center" Margin="0,2" />
                      <Button content="Split run" action="SplitRun" Interactive="{Binding CanSplitRun}" />
                      <Button content="Merge run" action="MergeRun" Interactive="{Binding CanMergeRun}" />
                    </Container>
                    <Container Type="Vertical Stack" Margin="0,2">
                      <Text text="Line spacing" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding LineSpacing, Mode=TwoWay}" accessible-name="Paragraph line spacing, from 0.5 to 10" Interactive="{Binding CanAlign}" HorizontalAlignment="Stretch" />
                      <Text text="Left indent" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding LeftIndent, Mode=TwoWay}" accessible-name="Paragraph left indent in points, 0 to 1000" Interactive="{Binding CanAlign}" HorizontalAlignment="Stretch" />
                      <Text text="First line" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding FirstLineIndent, Mode=TwoWay}" accessible-name="Paragraph first-line indent in points, negative to -1000 and positive to 1000" Interactive="{Binding CanAlign}" HorizontalAlignment="Stretch" />
                      <Text text="Space after" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding SpaceAfter, Mode=TwoWay}" accessible-name="Paragraph spacing after in points, 0 to 1000" Interactive="{Binding CanAlign}" HorizontalAlignment="Stretch" />
                    </Container>
                    <Container Type="Wrap" Margin="0,2">
                      <Text text="Style" vertical-alignment="Center" Margin="0,2" />
                      <Repeat Source="{Binding Styles}" As="style" Key="{Binding style.Id}" Panel="Horizontal Stack">
                        <Button content="{Binding style.Label}" action="ApplyStyle" Interactive="{Binding CanApplyStyle}" />
                      </Repeat>
                      <Text text="{Binding SelectedStyle}" vertical-alignment="Center" accessible-name="Current paragraph style" Margin="0,2" />
                    </Container>
                  </Container>
                  <Container Type="Vertical Stack" CellGap="8">
                    <Text Text="Insert" FontWeight="SemiBold" />
                    <Container Type="Vertical Stack" Margin="0,2">
                      <Text text="Insert" vertical-alignment="Center" Margin="0,2" />
                      <Button content="Paragraph" action="InsertParagraph" Interactive="{Binding CanInsert}" />
                      <Button content="Heading" action="InsertHeading" Interactive="{Binding CanInsert}" />
                      <Button content="Quote" action="InsertQuote" Interactive="{Binding CanInsert}" />
                      <Button content="Code" action="InsertCode" Interactive="{Binding CanInsert}" />
                      <Button content="Bullets" action="InsertBullets" Interactive="{Binding CanInsert}" />
                      <Button content="Numbering" action="InsertNumbering" Interactive="{Binding CanInsert}" />
                      <Button content="Checklist" action="InsertChecklist" Interactive="{Binding CanInsert}" />
                      <Button content="Page break" action="InsertPageBreak" Interactive="{Binding CanInsert}" />
                      <Button content="Divider" action="InsertDivider" Interactive="{Binding CanInsert}" />
                      <Text text="Rows" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding TableRows, Mode=TwoWay}" accessible-name="Table rows to insert, whole number from 1 to 100" Interactive="{Binding CanInsert}" HorizontalAlignment="Stretch" />
                      <Text text="Columns" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding TableColumns, Mode=TwoWay}" accessible-name="Table columns to insert, whole number from 1 to 50" Interactive="{Binding CanInsert}" HorizontalAlignment="Stretch" />
                      <Button content="Insert table" action="InsertTable" Interactive="{Binding CanInsert}" />
                      <Button content="Insert equation" action="InsertEquation" Interactive="{Binding CanInsertEquation}" />
                    </Container>
                  </Container>
                  <Container Type="Vertical Stack" CellGap="8">
                    <Text Text="Block" FontWeight="SemiBold" />
                    <Container Type="Wrap" Margin="0,2">
                      <Text text="Block" vertical-alignment="Center" Margin="0,2" />
                      <Button content="Move block up" action="MoveBlockUp" Interactive="{Binding CanMoveBlocks}" />
                      <Button content="Move block down" action="MoveBlockDown" Interactive="{Binding CanMoveBlocks}" />
                      <Button content="Delete block" action="DeleteBlock" Interactive="{Binding CanDeleteBlock}" />
                    </Container>
                  </Container>
                  <Container Type="Vertical Stack" CellGap="8">
                    <Text Text="Page" FontWeight="SemiBold" />
                    <Container Type="Vertical Stack" Margin="0,2">
                      <Text text="Page" vertical-alignment="Center" Margin="0,2" />
                      <Button content="A4" action="SetPageA4" Interactive="{Binding CanEditPage}" />
                      <Button content="Letter" action="SetPageLetter" Interactive="{Binding CanEditPage}" />
                      <Button content="Portrait" action="SetPagePortrait" Interactive="{Binding CanEditPage}" />
                      <Button content="Landscape" action="SetPageLandscape" Interactive="{Binding CanEditPage}" />
                      <Text text="Margins" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding PageMargins, Mode=TwoWay}" accessible-name="Page margin in points, 0 to 1000" Interactive="{Binding CanEditPage}" HorizontalAlignment="Stretch" />
                      <Input type="Checkbox" content="Page numbers" accessible-name="Show page numbers" Checked="{Binding ShowPageNumbers, Mode=TwoWay}" Interactive="{Binding CanEditPage}" HorizontalAlignment="Stretch" />
                      <Button content="Paginated" action="SetLayoutPaginated" Interactive="{Binding CanEditPage}" />
                      <Button content="Continuous" action="SetLayoutContinuous" Interactive="{Binding CanEditPage}" />
                      <Text text="{Binding PageSizeLabel}" vertical-alignment="Center" accessible-name="Current page size in points" Margin="0,2" />
                    </Container>
                  </Container>
                  <Container Type="Vertical Stack" CellGap="8" Active="{Binding CanEditList}">
                    <Text Text="List" FontWeight="SemiBold" />
                    <Text text="List items" font-size="16" Margin="0,2" />
                    <Container max-height="140" VerticalScrolling="True" HorizontalScrolling="False" Type="Wrap">
                      <Container Type="Vertical Stack">
                        <Repeat Source="{Binding SelectedListItems}" As="listItem" Key="{Binding listItem.Id}">
                          <Container Type="Horizontal Stack" Margin="0,2">
                            <Input type="Text" accessible-name="List item text" Value="{Binding listItem.Text, Mode=TwoWay}" Interactive="{Binding CanEditList}" HorizontalAlignment="Stretch" />
                            <Input type="Checkbox" content="Done" accessible-name="List item complete" Checked="{Binding listItem.Checked, Mode=TwoWay}" Interactive="{Binding CanEditList}" HorizontalAlignment="Stretch" Margin="0,2" />
                            <Input type="Number" value="{Binding listItem.Level, Mode=TwoWay}" accessible-name="List item nesting level, from 0 to 8" Interactive="{Binding CanEditList}" HorizontalAlignment="Stretch" Margin="0,2" />
                          </Container>
                        </Repeat>
                      </Container>
                    </Container>
                    <Container Type="Wrap" Margin="0,2">
                      <Button content="Add list item" action="AddListItem" Interactive="{Binding CanEditList}" />
                      <Button content="Set bullets" action="SetListBulleted" Interactive="{Binding CanEditList}" />
                      <Button content="Set numbering" action="SetListNumbered" Interactive="{Binding CanEditList}" />
                      <Button content="Set checklist" action="SetListChecklist" Interactive="{Binding CanEditList}" />
                    </Container>
                  </Container>
                  <Container Type="Vertical Stack" CellGap="8" Active="{Binding IsTableContext}">
                    <Text Text="Table" FontWeight="SemiBold" />
                    <Text text="Selected table" font-size="16" Margin="0,2" />
                    <Container max-height="160" VerticalScrolling="True" HorizontalScrolling="False" Type="Wrap">
                      <Container Type="Vertical Stack">
                        <Repeat Source="{Binding SelectedTableRows}" As="tableRow" Key="{Binding tableRow.Id}">
                          <Container Type="Horizontal Stack" Margin="0,2">
                            <Repeat Source="{Binding tableRow.Cells}" As="tableCell" Key="{Binding tableCell.Id}">
                              <Input type="Text" accessible-name="Table cell text" Value="{Binding tableCell.Text, Mode=TwoWay}" Interactive="{Binding CanEditTable}" HorizontalAlignment="Stretch" Margin="0,2" />
                            </Repeat>
                          </Container>
                        </Repeat>
                      </Container>
                    </Container>
                    <Container Type="Vertical Stack" Margin="0,2">
                      <Button content="Add table row" action="AddTableRow" Interactive="{Binding CanEditTable}" />
                      <Button content="Add table column" action="AddTableColumn" Interactive="{Binding CanEditTable}" />
                      <Button content="Remove table row" action="RemoveTableRow" Interactive="{Binding CanEditTable}" />
                      <Button content="Remove table column" action="RemoveTableColumn" Interactive="{Binding CanEditTable}" />
                      <Button content="Merge cell right" action="MergeCellRight" Interactive="{Binding CanMergeCell}" />
                      <Button content="Split cell" action="SplitCell" Interactive="{Binding CanSplitCell}" />
                      <Text text="Cell fill" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Text" accessible-name="Table cell background colour" Value="{Binding CellBackground, Mode=TwoWay}" Interactive="{Binding CanEditCellBackground}" HorizontalAlignment="Stretch" />
                    </Container>
                    <Text text="Selected image" font-size="16" Margin="0,2" />
                  </Container>
                  <Container Type="Vertical Stack" CellGap="8">
                    <Text Text="Image" FontWeight="SemiBold" />
                    <Container Type="Wrap" Margin="0,2">
                      <Button content="Insert image" action="InsertImage" accessible-name="Insert an image chosen from the platform file picker" Interactive="{Binding CanInsertImage}" />
                    </Container>
                  </Container>
                  <Container Type="Vertical Stack" CellGap="8" Active="{Binding IsImageContext}">
                    <Text Text="Selected image" FontWeight="SemiBold" />
                    <Container Type="Vertical Stack" Margin="0,2">
                      <Text text="Alt text" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Text" accessible-name="Alternative text for the selected image" Value="{Binding MediaAlt, Mode=TwoWay}" Interactive="{Binding CanEditMedia}" HorizontalAlignment="Stretch" />
                      <Text text="Caption" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Text" accessible-name="Caption for the selected image" Value="{Binding MediaCaption, Mode=TwoWay}" Interactive="{Binding CanEditMedia}" HorizontalAlignment="Stretch" />
                      <Text text="Wrapping" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Text" accessible-name="Wrapping mode for the selected image" Value="{Binding MediaWrapping, Mode=TwoWay}" Interactive="{Binding CanEditMedia}" HorizontalAlignment="Stretch" />
                    </Container>
                    <Container Type="Vertical Stack" Margin="0,2">
                      <Text ID="write-image-size-label" text="Size" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding MediaWidth, Mode=TwoWay}" accessible-name="Image width in points, from 24 to 10000" Interactive="{Binding CanEditMedia}" HorizontalAlignment="Stretch" />
                      <Input type="Number" value="{Binding MediaHeight, Mode=TwoWay}" accessible-name="Image height in points, from 24 to 10000" Interactive="{Binding CanEditMedia}" HorizontalAlignment="Stretch" Margin="0,2" />
                      <Text text="Rotation" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding MediaRotation, Mode=TwoWay}" accessible-name="Image rotation in degrees" Interactive="{Binding CanEditMedia}" HorizontalAlignment="Stretch" />
                    </Container>
                    <Container Type="Vertical Stack" Margin="0,2">
                      <Text text="Crop" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Number" value="{Binding MediaCropLeft, Mode=TwoWay}" accessible-name="Crop fraction from the left edge, 0 to 0.95" Interactive="{Binding CanEditMedia}" HorizontalAlignment="Stretch" />
                      <Input type="Number" value="{Binding MediaCropTop, Mode=TwoWay}" accessible-name="Crop fraction from the top edge, 0 to 0.95" Interactive="{Binding CanEditMedia}" HorizontalAlignment="Stretch" Margin="0,2" />
                      <Input type="Number" value="{Binding MediaCropRight, Mode=TwoWay}" accessible-name="Crop fraction from the right edge, 0 to 0.95" Interactive="{Binding CanEditMedia}" HorizontalAlignment="Stretch" Margin="0,2" />
                      <Input type="Number" value="{Binding MediaCropBottom, Mode=TwoWay}" accessible-name="Crop fraction from the bottom edge, 0 to 0.95" Interactive="{Binding CanEditMedia}" HorizontalAlignment="Stretch" Margin="0,2" />
                    </Container>
                  </Container>
                  <Container Type="Vertical Stack" CellGap="8" Active="{Binding CanEditEquation}">
                    <Text Text="Equation" FontWeight="SemiBold" />
                    <Container Type="Vertical Stack" Margin="0,2">
                      <Text text="Equation" vertical-alignment="Center" Margin="0,2" />
                      <Input type="Text" accessible-name="Equation source" Value="{Binding EquationSource, Mode=TwoWay}" Interactive="{Binding CanEditEquation}" HorizontalAlignment="Stretch" />
                      <Input type="Text" accessible-name="Equation accessible alternative" Value="{Binding EquationAlternative, Mode=TwoWay}" Interactive="{Binding CanEditEquation}" HorizontalAlignment="Stretch" />
                    </Container>
                  </Container>
                </Container>
              </Container>
            </Container>
          </Container>
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
