<Cui id="sites.browser" version="1">
  <Import Source="framework/CUI/Components/App.cui" />
  <Actions>
    <Action name="ChooseProject" command="OpenProject" parameter="{Binding website}" />
    <Action name="ChoosePage" command="SelectPage" parameter="{Binding page}" />
    <Action name="ChooseComponent" command="SelectComponent" parameter="{Binding component}" />
  </Actions>
  <Page>
    <Container margin="16" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False">
      <Container Type="Grid" ColumnSizes="1fr Auto">
        <Text text="Sites" font-size="28" />
        <AppAccentMenu ID="sites-app-accent" Column="1" />
      </Container>
      <Text text="{Binding Status}" text-wrapping="Wrap" accessible-name="Sites status" margin="0,8" />
      <Container Type="Wrap">
        <Button content="Reload saved state" action="Reload" Interactive="{Binding CanReload}" />
        <Button content="New website" action="NewProject" Interactive="{Binding CanCreate}" />
      </Container>
      <Repeat Source="{Binding Projects}" As="website" Key="{Binding website.Id}">
        <Button content="{Binding website.Name}" action="ChooseProject" margin="0,4" Interactive="{Binding CanBrowse}" />
      </Repeat>
      <Text text="{Binding ProjectName}" font-size="22" margin="0,12" />
      <Text text="{Binding ProjectDetails}" text-wrapping="Wrap" />
      <Button content="New page" action="NewPage" Interactive="{Binding CanCreatePage}" />
      <Repeat Source="{Binding Pages}" As="page" Key="{Binding page.Id}">
        <Button content="{Binding page.Name}" action="ChoosePage" margin="0,4" Interactive="{Binding CanBrowse}" />
      </Repeat>
      <Text text="{Binding PageName}" font-size="20" margin="0,12" />
      <Container Type="Wrap">
        <Button content="Add paragraph" action="AddParagraph" Interactive="{Binding CanAddText}" />
        <Button content="Edit selected text" action="EditText" Interactive="{Binding CanEditText}" />
      </Container>
      <If Condition="{Binding Editing}">
        <Container margin="0,12" Type="Vertical Stack">
          <Text text="{Binding EditTitle}" font-size="18" />
          <If Condition="{Binding Naming}">
            <Input id="sites-name" accessible-name="Website or page name" Type="Text" Value="{Binding Name, Mode=TwoWay}" Interactive="{Binding CanEditDraft}" />
          </If>
          <If Condition="{Binding PageEditing}">
            <Input id="sites-path" accessible-name="Page URL path" Type="Text" Value="{Binding Path, Mode=TwoWay}" Interactive="{Binding CanEditDraft}" />
          </If>
          <If Condition="{Binding TextEditing}">
            <Input id="sites-text" text-wrapping="Wrap" accessible-name="Page text" Type="Text" Value="{Binding Text, Mode=TwoWay}" Interactive="{Binding CanEditDraft}" Multiline="true" />
          </If>
          <Container Type="Wrap">
            <Button content="Save" action="Save" Interactive="{Binding CanSave}" />
            <Button content="Cancel" action="Cancel" Interactive="{Binding CanCancel}" />
          </Container>
        </Container>
      </If>
      <Repeat Source="{Binding Components}" As="component" Key="{Binding component.Id}">
        <Container margin="0,8" Type="Vertical Stack">
          <Button content="{Binding component.Type}" action="ChooseComponent" Interactive="{Binding CanBrowse}" />
          <Text text="{Binding component.Text}" text-wrapping="Wrap" />
        </Container>
      </Repeat>
      <Text text="{Binding SelectedText}" text-wrapping="Wrap" margin="0,12" />
    </Container>
  </Page>
</Cui>