<Cui id="sites.browser" version="1">
  <Actions>
    <Action name="ChooseProject" command="OpenProject" parameter="{Binding website}" />
    <Action name="ChoosePage" command="SelectPage" parameter="{Binding page}" />
    <Action name="ChooseComponent" command="SelectComponent" parameter="{Binding component}" />
  </Actions>
  <StackPanel margin="16">
    <TextBlock text="Sites" font-size="28" />
    <TextBlock text="{Binding Status}" text-wrapping="Wrap" accessible-name="Sites status" margin="0,8" />
    <WrapPanel><Button content="Reload saved state" action="Reload" is-enabled="{Binding CanReload}" /><Button content="New website" action="NewProject" is-enabled="{Binding CanCreate}" /></WrapPanel>
    <Repeat Source="{Binding Projects}" As="website" Key="{Binding website.Id}"><Button content="{Binding website.Name}" action="ChooseProject" is-enabled="{Binding CanBrowse}" margin="0,4" /></Repeat>
    <TextBlock text="{Binding ProjectName}" font-size="22" margin="0,12" />
    <TextBlock text="{Binding ProjectDetails}" text-wrapping="Wrap" />
    <Button content="New page" action="NewPage" is-enabled="{Binding CanCreatePage}" />
    <Repeat Source="{Binding Pages}" As="page" Key="{Binding page.Id}"><Button content="{Binding page.Name}" action="ChoosePage" is-enabled="{Binding CanBrowse}" margin="0,4" /></Repeat>
    <TextBlock text="{Binding PageName}" font-size="20" margin="0,12" />
    <WrapPanel><Button content="Add paragraph" action="AddParagraph" is-enabled="{Binding CanAddText}" /><Button content="Edit selected text" action="EditText" is-enabled="{Binding CanEditText}" /></WrapPanel>
    <If Condition="{Binding Editing}"><StackPanel margin="0,12">
      <TextBlock text="{Binding EditTitle}" font-size="18" />
      <If Condition="{Binding Naming}"><TextBox id="sites-name" text="{Binding Name, Mode=TwoWay}" is-enabled="{Binding CanEditDraft}" accessible-name="Website or page name" /></If>
      <If Condition="{Binding PageEditing}"><TextBox id="sites-path" text="{Binding Path, Mode=TwoWay}" is-enabled="{Binding CanEditDraft}" accessible-name="Page URL path" /></If>
      <If Condition="{Binding TextEditing}"><TextBox id="sites-text" text="{Binding Text, Mode=TwoWay}" is-enabled="{Binding CanEditDraft}" accepts-return="true" text-wrapping="Wrap" accessible-name="Page text" /></If>
      <WrapPanel><Button content="Save" action="Save" is-enabled="{Binding CanSave}" /><Button content="Cancel" action="Cancel" is-enabled="{Binding CanCancel}" /></WrapPanel>
    </StackPanel></If>
    <Repeat Source="{Binding Components}" As="component" Key="{Binding component.Id}"><StackPanel margin="0,8">
      <Button content="{Binding component.Type}" action="ChooseComponent" is-enabled="{Binding CanBrowse}" />
      <TextBlock text="{Binding component.Text}" text-wrapping="Wrap" />
    </StackPanel></Repeat>
    <TextBlock text="{Binding SelectedText}" text-wrapping="Wrap" margin="0,12" />
  </StackPanel>
</Cui>
