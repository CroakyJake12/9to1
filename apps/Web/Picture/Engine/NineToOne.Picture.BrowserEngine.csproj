<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>NineToOne.Picture.BrowserEngine</AssemblyName>
    <PictureOwnerRoot>$(MSBuildProjectDirectory)/../../../../9to1 Workspace/Picture</PictureOwnerRoot>
  </PropertyGroup>
  <ItemGroup>
    <PictureOwnerSource Include="$(PictureOwnerRoot)/PictureDocument.cs" ExpectedHash="c8a88d5ba9767ea3623b50a5de0511b8a150324aa2ca6618b5cefd3aaa477960" />
    <PictureOwnerSource Include="$(PictureOwnerRoot)/PictureCropService.cs" ExpectedHash="d3fa6094d3b3088e235111ca74adebb05ae1f7175979c5001e69a77f6976e368" />
    <PictureOwnerSource Include="$(PictureOwnerRoot)/ImageViewportState.cs" ExpectedHash="CC57FFA8F1D6280CB7CE5EB0679F4DD9E7E79F7E800CB73C00B95D085D13F6A9" />
    <Compile Include="$(PictureOwnerRoot)/PictureDocument.cs" Link="Owner/PictureDocument.cs" />
    <Compile Include="$(PictureOwnerRoot)/PictureCropService.cs" Link="Owner/PictureCropService.cs" />
    <Compile Include="$(PictureOwnerRoot)/ImageViewportState.cs" Link="Owner/ImageViewportState.cs" />
    <!-- Owner revision 7 requires these retained owner files; the reviewed three-file closure was incomplete. -->
    <Compile Include="$(PictureOwnerRoot)/PictureCompositionAdapter.cs" Link="Owner/PictureCompositionAdapter.cs" />
    <Compile Include="$(PictureOwnerRoot)/PictureHistoryAdapter.cs" Link="Owner/PictureHistoryAdapter.cs" />
    <Compile Include="$(PictureOwnerRoot)/PictureOperationEditor.cs" Link="Owner/PictureOperationEditor.cs" />
    <Compile Include="$(PictureOwnerRoot)/PictureCropService.PixelCrop.cs" Link="Owner/PictureCropService.PixelCrop.cs" />
    <ProjectReference Include="../../../../9to1 Workspace/shared/src/Haven.Application/Haven.Application.csproj" />
    <ProjectReference Include="../../../../9to1 Workspace/shared/src/Haven.Productivity.NativeUI/Haven.Productivity.NativeUI.csproj" />
    <ProjectReference Include="../../../../framework/CUI/vendor/Avalonia/src/Avalonia.Base/Avalonia.Base.csproj" />
    <ProjectReference Include="../../../../framework/CUI/vendor/Avalonia/src/Skia/Avalonia.Skia/Avalonia.Skia.csproj" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>
    <UsingTask TaskName="CheckReviewedPictureOwnerSources" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" /><Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Pins record the canonical LF source blob. A CRLF checkout must not be
        // judged as a content change, so the guard hashes canonical content.
        using (var sha = SHA256.Create())
        {
          foreach (var item in Files)
          {
            var bytes = File.ReadAllBytes(item.ItemSpec);
            using (var canonical = new MemoryStream())
            {
              for (int i = 0; i < bytes.Length; i++)
              {
                if (bytes[i] == 13 && i + 1 < bytes.Length && bytes[i + 1] == 10) continue;
                canonical.WriteByte(bytes[i]);
              }
              var hash = BitConverter.ToString(sha.ComputeHash(canonical.ToArray())).Replace("-", "").ToLowerInvariant();
              var expected = item.GetMetadata("ExpectedHash");
              if (!string.Equals(hash, expected, StringComparison.OrdinalIgnoreCase))
              {
                Log.LogError("The owning Picture source {0} changed. Canonical LF hash {1} does not match the reviewed pin {2}. Review that owner revision and its browser dependency closure before updating the source pin.",
                  item.ItemSpec, hash, expected);
                return false;
              }
            }
          }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="CheckReviewedPictureOwnerSources" BeforeTargets="CoreCompile">
    <CheckReviewedPictureOwnerSources Files="@(PictureOwnerSource)" />
  </Target>
</Project>
