<Cui id="picture-browser" product="9to1" version="1">
  <Actions>
    <Action name="OpenDocumentRow" command="OpenDocument" parameter="{Binding item.ID}" />
  </Actions>
  <Theme Name="user_preference">
    <Page>
      <Container id="picture-workspace" background="{Resource CuiBackgroundBrush}" Type="Grid" RowSizes="Auto Auto 1fr Auto">
        <Container background="{Resource CuiPanelBrush}" padding="16,10" Type="Overlay">
          <Container Type="Grid" ColumnSizes="Auto 1fr Auto">
            <Button action="ShellHome" content="Home" margin="0,0,16,0" />
            <Container Type="Vertical Stack" Column="1">
              <Text text="{Binding DocumentTitle}" font-size="18" font-weight="SemiBold" />
              <Container Type="Menu">
                <Button Type="Menu Item" Content="File">
                  <Button action="Create" Type="Menu Item" Content="New picture" />
                  <Button action="Import" Type="Menu Item" Content="Open PNG…" />
                  <Button action="ToggleLibrary" Type="Menu Item" Content="Local pictures" />
                  <Button action="Save" Type="Menu Item" Content="Save" Interactive="{Binding CanEdit}" />
                  <Button Type="Menu Item" Content="Export PNG">
                    <Button action="ExportPreserve" Type="Menu Item" Content="Keep metadata" Interactive="{Binding CanEdit}" />
                    <Button action="ExportLocation" Type="Menu Item" Content="Remove location" Interactive="{Binding CanEdit}" />
                    <Button action="ExportAll" Type="Menu Item" Content="Remove all metadata" Interactive="{Binding CanEdit}" />
                  </Button>
                  <Button action="Close" Type="Menu Item" Content="Save and close" Interactive="{Binding CanEdit}" />
                </Button>
                <Button Type="Menu Item" Content="Edit">
                  <Button action="Undo" Type="Menu Item" Content="Undo" Interactive="{Binding CanUndo}" />
                  <Button action="Redo" Type="Menu Item" Content="Redo" Interactive="{Binding CanRedo}" />
                  <Button action="ResetInputs" Type="Menu Item" Content="Restore unapplied values" />
                </Button>
                <Button Type="Menu Item" Content="View">
                  <Button action="ToggleInspector" Type="Menu Item" Content="Tools panel" />
                  <Button action="Compare" Type="Menu Item" Content="Compare original" Interactive="{Binding CanEdit}" />
                  <Button action="ToggleDetails" Type="Menu Item" Content="Storage and capabilities" />
                </Button>
              </Container>
            </Container>
            <Button action="Save" content="Save" Column="2" Interactive="{Binding CanEdit}" />
          </Container>
        </Container>
        <Container padding="12,8" background="{Resource CuiPanel2Brush}" Type="Overlay" Row="1">
          <Container Type="Wrap">
            <Button action="Create" content="New" margin="0,0,6,0" />
            <Button action="Import" content="Open PNG" margin="0,0,16,0" />
            <Button action="Undo" content="↶" accessible-name="Undo" margin="0,0,4,0" Interactive="{Binding CanUndo}" />
            <Button action="Redo" content="↷" accessible-name="Redo" margin="0,0,16,0" Interactive="{Binding CanRedo}" />
            <Button action="Rotate" content="Rotate 90°" margin="0,0,6,0" Interactive="{Binding CanEdit}" />
            <Button action="FlipHorizontal" content="Flip horizontal" margin="0,0,6,0" Interactive="{Binding CanEdit}" />
            <Button action="FlipVertical" content="Flip vertical" margin="0,0,16,0" Interactive="{Binding CanEdit}" />
            <Button action="Compare" content="{Binding ComparisonLabel}" margin="0,0,6,0" Interactive="{Binding CanEdit}" />
            <Button action="ToggleInspector" content="{Binding InspectorLabel}" />
          </Container>
        </Container>
        <Container id="picture-body" Type="Grid" Row="2" ColumnSizes="1fr 284">
          <Container id="picture-canvas-area" margin="24,16" Type="Grid" RowSizes="Auto 1fr Auto">
            <Text text="{Binding DocumentSummary}" foreground="{Resource CuiTextSoftBrush}" margin="0,0,0,12" />
            <Container Type="Grid" Row="1">
              <Object Type="PictureRasterPreview" accessible-name="Picture canvas. Drag to select a crop; exact values are available in Tools." />
              <Container horizontal-alignment="Center" vertical-alignment="Center" max-width="380" Type="Vertical Stack" Active="{Binding IsEmpty}">
                <Text text="Create your next picture" font-size="26" font-weight="SemiBold" text-wrapping="Wrap" margin="0,0,0,10" />
                <Text text="Start with a blank canvas or open a PNG. Your original stays intact while you edit." text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" margin="0,0,0,20" />
                <Container Type="Wrap">
                  <Button action="Create" content="New picture" margin="0,0,8,0" />
                  <Button action="Import" content="Open PNG…" />
                </Container>
              </Container>
            </Container>
            <Text text="{Binding SelectionHint}" font-size="12" foreground="{Resource CuiTextSoftBrush}" text-wrapping="Wrap" margin="0,12,0,0" Row="2" />
          </Container>
          <Container id="picture-inspector" Active="{Binding ShowInspector}" padding="18,16" background="{Resource CuiPanelBrush}" Type="Overlay" Column="1">
            <Container Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
              <Container Type="Vertical Stack" CellGap="12">
                <Container Type="Grid" ColumnSizes="1fr Auto">
                  <Text text="Picture tools" font-size="18" font-weight="SemiBold" />
                  <Button content="×" accessible-name="Close tools panel" action="ToggleInspector" Column="1" />
                </Container>
                <Text text="Selection · pixels" font-weight="SemiBold" />
                <Container Type="Grid" ColumnSizes="1fr 1fr" RowSizes="Auto Auto Auto Auto">
                  <Text text="Left" />
                  <Text text="Top" Column="1" />
                  <Input accessible-name="Crop left pixel" margin="0,0,8,8" Type="Text" Row="1" Value="{Binding CropX, mode=TwoWay, type=string}" />
                  <Input accessible-name="Crop top pixel" margin="0,0,0,8" Type="Text" Row="1" Column="1" Value="{Binding CropY, mode=TwoWay, type=string}" />
                  <Text id="picture-crop-width-label" text="Width" Row="2" />
                  <Text id="picture-crop-height-label" text="Height" Row="2" Column="1" />
                  <Input accessible-name="Crop width pixels" margin="0,0,8,0" Type="Text" Row="3" Value="{Binding CropWidth, mode=TwoWay, type=string}" />
                  <Input accessible-name="Crop height pixels" Type="Text" Row="3" Column="1" Value="{Binding CropHeight, mode=TwoWay, type=string}" />
                </Container>
                <Button content="Crop to selection" action="Crop" Interactive="{Binding CanEdit}" />
                <Text text="Image size · pixels" font-weight="SemiBold" />
                <Container Type="Grid" ColumnSizes="1fr 1fr" RowSizes="Auto Auto">
                  <Text id="picture-resize-width-label" text="Width" />
                  <Text id="picture-resize-height-label" text="Height" Column="1" />
                  <Input accessible-name="Resize width pixels" margin="0,0,8,0" Type="Text" Row="1" Value="{Binding ResizeWidth, mode=TwoWay, type=string}" />
                  <Input accessible-name="Resize height pixels" Type="Text" Row="1" Column="1" Value="{Binding ResizeHeight, mode=TwoWay, type=string}" />
                </Container>
                <Container Type="Wrap">
                  <Button action="Resize" content="Resize image" margin="0,0,6,6" Interactive="{Binding CanEdit}" />
                  <Button action="ResizeCanvas" content="Resize canvas" Interactive="{Binding CanEdit}" />
                </Container>
                <Text text="Straighten · clockwise degrees" />
                <Input accessible-name="Straighten angle in degrees" Type="Text" Value="{Binding Angle, mode=TwoWay, type=string}" />
                <Button action="Straighten" content="Apply straighten" Interactive="{Binding CanEdit}" />
                <Text text="Light and colour" font-weight="SemiBold" />
                <Text text="Exposure (−10 to 10 EV)" />
                <Input accessible-name="Exposure EV" Type="Text" Value="{Binding Exposure, mode=TwoWay, type=string}" />
                <Text text="Brightness (−1 to 1)" />
                <Input accessible-name="Brightness" Type="Text" Value="{Binding Brightness, mode=TwoWay, type=string}" />
                <Text text="Contrast (−1 to 1)" />
                <Input accessible-name="Contrast" Type="Text" Value="{Binding Contrast, mode=TwoWay, type=string}" />
                <Text text="Saturation (−1 to 1)" />
                <Input accessible-name="Saturation" Type="Text" Value="{Binding Saturation, mode=TwoWay, type=string}" />
                <Text text="Gamma (0.1 to 10)" />
                <Input accessible-name="Gamma" Type="Text" Value="{Binding Gamma, mode=TwoWay, type=string}" />
                <Button action="Color" content="Apply colour adjustments" Interactive="{Binding CanEdit}" />
                <Text text="Selection effects" font-weight="SemiBold" />
                <Text text="Blur radius (1–32 px)" />
                <Input accessible-name="Blur radius pixels" Type="Text" Value="{Binding BlurRadius, mode=TwoWay, type=string}" />
                <Button action="Blur" content="Blur selection" Interactive="{Binding CanEdit}" />
                <Text text="Pixel block size (2–512 px)" />
                <Input accessible-name="Pixelation block size" Type="Text" Value="{Binding PixelSize, mode=TwoWay, type=string}" />
                <Button action="Pixelate" content="Pixelate selection" Interactive="{Binding CanEdit}" />
                <Container Type="Vertical Stack" Active="{Binding HasPendingInput}">
                  <Text text="You have unapplied values. Apply the tool or restore them before closing." text-wrapping="Wrap" />
                  <Button action="ResetInputs" content="Restore unapplied values" />
                </Container>
              </Container>
            </Container>
          </Container>
          <Container id="picture-library" width="340" horizontal-alignment="Left" padding="20" background="{Resource CuiPanel2Brush}" Type="Overlay" ColumnSpan="2" Active="{Binding ShowLibrary}">
            <Container Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
              <Container Type="Vertical Stack" CellGap="12">
                <Text text="Your local pictures" font-size="20" font-weight="SemiBold" />
                <Button content="Close library" action="ToggleLibrary" />
                <Button content="Refresh" action="Refresh" />
                <Repeat Source="{Binding Documents}" As="item" Key="{Binding item.ID}" CellGap="6">
                  <Button action="OpenDocumentRow" content="{Binding item.Label}" accessible-name="{Binding item.Label}" />
                </Repeat>
              </Container>
            </Container>
          </Container>
          <Container max-width="540" horizontal-alignment="Center" vertical-alignment="Center" padding="24" background="{Resource CuiPanel2Brush}" Type="Overlay" ColumnSpan="2" Active="{Binding ShowDetails}">
            <Container Type="Vertical Stack" CellGap="16">
              <Text text="Storage and capabilities" font-size="20" font-weight="SemiBold" />
              <Text text="Original PNG bytes and editable history are saved only in this browser. Clearing browser data removes these copies. Cloud sync is not connected." text-wrapping="Wrap" />
              <Text text="This browser build supports static 8-bit sRGB PNG, up to 8 MiB and 4 million pixels. It preserves originals, metadata policy and undo history. Drawing, vector composition, AI generation, other codecs and the full donor baseline remain unavailable." text-wrapping="Wrap" />
              <Text text="{Binding Status}" text-wrapping="Wrap" />
              <Text text="{Binding Identity}" text-wrapping="Wrap" />
              <Button action="ToggleDetails" content="Close" />
            </Container>
          </Container>
        </Container>
        <Container background="{Resource CuiPanelBrush}" padding="16,8" Type="Overlay" Row="3">
          <Text text="{Binding DisplayStatus}" accessible-name="Picture operation status" text-wrapping="Wrap" font-size="12" />
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
