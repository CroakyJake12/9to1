<Cui id="wave-browser" product="9-1" version="1">
  <Actions>
    <Action name="OpenProjectRow" command="OpenProject" parameter="{Binding item.ID}" />
    <Action name="SelectTrackRow" command="SelectTrack" parameter="{Binding item.ID}" />
    <Action name="SelectClipRow" command="SelectClip" parameter="{Binding item.ID}" />
  </Actions>
  <DefaultTheme value="Default">
    <StackPanel id="wave-editor" orientation="Vertical" margin="16" spacing="12" background="{Resource CuiBackgroundBrush}">
      <TextBlock text="Wave" font-size="30" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
      <TextBlock text="Local audio editor · projects and original WAV sources are stored in this browser. They are not synced to Files or another device. Browser data clearing removes these copies." text-wrapping="Wrap" max-width="760" foreground="{Resource CuiTextSoftBrush}" />
      <TextBlock id="wave-status" text="{Binding Status}" text-wrapping="Wrap" max-width="760" accessible-name="Wave operation status" foreground="{Resource CuiTextBrush}" />
      <Border padding="12" background="{Resource CuiPanelBrush}" corner-radius="8">
        <StackPanel orientation="Vertical" spacing="8">
          <TextBlock text="Create or reopen" font-size="18" font-weight="SemiBold" />
          <WrapPanel>
            <StackPanel margin="0 0 12 8"><TextBlock text="Project / new track name" /><TextBox id="wave-title" text="{Binding Title, mode=TwoWay, type=string}" accessible-name="Project or new track name" width="220" /></StackPanel>
            <StackPanel margin="0 0 12 8"><TextBlock text="Sample rate (Hz)" /><TextBox id="wave-sample-rate" text="{Binding SampleRate, mode=TwoWay, type=string}" accessible-name="Project sample rate in Hertz" width="120" /></StackPanel>
            <StackPanel margin="0 0 12 8"><TextBlock text="Channels" /><TextBox id="wave-channels" text="{Binding Channels, mode=TwoWay, type=string}" accessible-name="Project channel count" width="90" /></StackPanel>
            <Button id="wave-create" action="Create" content="Create project" IsEnabled="{Binding NotBusy}" margin="0 20 8 8" />
          </WrapPanel>
          <Repeat Source="{Binding Projects}" As="item" Key="{Binding item.ID}" orientation="Vertical" spacing="4"><Button action="OpenProjectRow" content="{Binding item.Label}" accessible-name="{Binding item.Label}" max-width="720" /></Repeat>
          <WrapPanel>
            <Button action="Refresh" content="Refresh local list" margin="0 0 8 4" />
            <Button id="wave-reopen" action="Reopen" content="Reopen last project" margin="0 0 8 4" />
            <Button id="wave-save" action="Save" content="Save locally" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
            <Button id="wave-close" action="Close" content="Save and close" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock id="wave-project-identity" text="{Binding ProjectIdentity}" text-wrapping="Wrap" max-width="760" accessible-name="Canonical Wave project identity and revision" />
      <WrapPanel>
        <Button id="wave-import" action="Import" content="Import WAV" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
        <Button action="AddTrack" content="Add named track" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
        <Button id="wave-undo" action="Undo" content="Undo" IsEnabled="{Binding CanUndo}" margin="0 0 8 4" />
        <Button id="wave-redo" action="Redo" content="Redo" IsEnabled="{Binding CanRedo}" margin="0 0 8 4" />
        <Button id="wave-export" action="Export" content="Export PCM16 WAV" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
      </WrapPanel>
      <Border padding="12" background="{Resource CuiPanelBrush}" corner-radius="8">
        <StackPanel orientation="Vertical" spacing="8">
          <TextBlock text="Transport" font-size="18" font-weight="SemiBold" />
          <TextBlock id="wave-transport" text="{Binding Transport}" accessible-name="Playback position and state" />
          <WrapPanel>
            <Button id="wave-play" action="Play" content="Play mix" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
            <Button action="Pause" content="Pause" margin="0 0 8 4" /><Button action="Resume" content="Resume" margin="0 0 8 4" /><Button action="Stop" content="Stop" margin="0 0 8 4" />
            <Button action="ToggleLoop" content="{Binding LoopLabel}" margin="0 0 8 4" />
          </WrapPanel>
          <WrapPanel><TextBox text="{Binding Seek, mode=TwoWay, type=string}" width="100" accessible-name="Seek position in seconds" margin="0 0 8 4" /><Button action="Seek" content="Seek to seconds" /></WrapPanel>
          <TextBlock text="Mixed waveform preview (computed from the Wave engine's PCM export when opened, played or exported)." text-wrapping="Wrap" max-width="700" />
          <TextBlock text="{Binding PreviewStatus}" text-wrapping="Wrap" max-width="700" accessible-name="Mixed waveform summary" />
          <StackPanel HorizontalScrolling="true" max-width="700" height="110">
            <Repeat Source="{Binding Waveform}" As="peak" Key="{Binding peak.ID}" orientation="Horizontal" spacing="1">
              <Border width="2" height="{Binding peak.Height}" background="{Resource CuiTextBrush}" accessible-name="{Binding peak.Description}" />
            </Repeat>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border padding="12" background="{Resource CuiPanelBrush}" corner-radius="8">
        <StackPanel orientation="Vertical" spacing="8">
          <TextBlock text="Multitrack timeline" font-size="18" font-weight="SemiBold" />
          <Repeat Source="{Binding Timeline}" As="clip" Key="{Binding clip.ID}" orientation="Vertical" spacing="4"><TextBlock text="{Binding clip.Text}" text-wrapping="Wrap" max-width="720" /></Repeat>
          <TextBlock text="Select a track" /><Repeat Source="{Binding Tracks}" As="item" Key="{Binding item.ID}" orientation="Vertical" spacing="4"><Button action="SelectTrackRow" content="{Binding item.Label}" accessible-name="{Binding item.Label}" max-width="720" /></Repeat>
          <TextBlock text="Select a clip" /><Repeat Source="{Binding Clips}" As="item" Key="{Binding item.ID}" orientation="Vertical" spacing="4"><Button action="SelectClipRow" content="{Binding item.Label}" accessible-name="{Binding item.Label}" max-width="720" /></Repeat>
          <TextBlock text="{Binding Selection}" text-wrapping="Wrap" max-width="720" accessible-name="Selected clip source range, timeline, identity and processing" />
          <WrapPanel>
            <StackPanel margin="0 0 12 8"><TextBlock text="Timeline seconds" /><TextBox id="wave-start" text="{Binding Start, mode=TwoWay, type=string}" width="120" accessible-name="Timeline position in seconds for import split move duplicate marker" /></StackPanel>
            <StackPanel margin="0 0 12 8"><TextBlock text="Trim from start (s)" /><TextBox id="wave-trim-start" text="{Binding TrimStart, mode=TwoWay, type=string}" width="120" accessible-name="Seconds removed from clip start" /></StackPanel>
            <StackPanel margin="0 0 12 8"><TextBlock text="Trim from end (s)" /><TextBox id="wave-trim-end" text="{Binding TrimEnd, mode=TwoWay, type=string}" width="120" accessible-name="Seconds removed from clip end" /></StackPanel>
          </WrapPanel>
          <WrapPanel><TextBox text="{Binding JoinClipId, mode=TwoWay, type=string}" width="250" accessible-name="Adjacent clip identity to join" margin="0 0 8 4" /><Button action="Join" content="Join selected and adjacent clip" IsEnabled="{Binding HasClip}" /></WrapPanel>
          <WrapPanel>
            <Button id="wave-split" action="Split" content="Split at timeline time" IsEnabled="{Binding HasClip}" margin="0 0 8 4" />
            <Button id="wave-trim" action="Trim" content="Trim selected clip" IsEnabled="{Binding HasClip}" margin="0 0 8 4" />
            <Button id="wave-move" action="Move" content="Move to timeline time" IsEnabled="{Binding HasClip}" margin="0 0 8 4" />
            <Button id="wave-duplicate" action="Duplicate" content="Duplicate at time" IsEnabled="{Binding HasClip}" margin="0 0 8 4" />
            <Button action="Delete" content="Delete clip" IsEnabled="{Binding HasClip}" margin="0 0 8 4" /><Button action="RippleDelete" content="Ripple delete" IsEnabled="{Binding HasClip}" margin="0 0 8 4" />
          </WrapPanel>
          <WrapPanel>
            <StackPanel margin="0 0 12 8"><TextBlock text="Gain (linear)" /><TextBox id="wave-gain" text="{Binding Gain, mode=TwoWay, type=string}" width="100" accessible-name="Clip or track gain linear multiplier" /></StackPanel>
            <StackPanel margin="0 0 12 8"><TextBlock text="Fade in (s)" /><TextBox text="{Binding FadeIn, mode=TwoWay, type=string}" width="100" accessible-name="Clip fade in seconds" /></StackPanel>
            <StackPanel margin="0 0 12 8"><TextBlock text="Fade out (s)" /><TextBox text="{Binding FadeOut, mode=TwoWay, type=string}" width="100" accessible-name="Clip fade out seconds" /></StackPanel>
            <StackPanel margin="0 0 12 8"><TextBlock text="Pan (-1 to 1)" /><TextBox text="{Binding Pan, mode=TwoWay, type=string}" width="100" accessible-name="Track pan minus one left to one right" /></StackPanel>
          </WrapPanel>
          <Button action="Processing" content="Apply clip gain and fades" IsEnabled="{Binding HasClip}" />
          <TextBlock text="{Binding Mixer}" text-wrapping="Wrap" max-width="720" />
          <WrapPanel><Button action="Mixer" content="Apply track gain / pan" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" /><Button action="Mute" content="Toggle track mute" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" /><Button action="Solo" content="Toggle track solo" IsEnabled="{Binding CanEdit}" /></WrapPanel>
          <WrapPanel><TextBox text="{Binding MarkerName, mode=TwoWay, type=string}" width="160" accessible-name="New marker name" margin="0 0 8 4" /><Button action="Marker" content="Add marker at time" IsEnabled="{Binding CanEdit}" /></WrapPanel>
          <TextBlock text="{Binding Annotations}" text-wrapping="Wrap" max-width="720" />
        </StackPanel>
      </Border>
      <TextBlock text="Adapter limits: matching project sample rate and channel count; PCM / IEEE-float WAV import, PCM16 WAV export; 16 MiB per imported source or rendered output and 32 MiB per local package; 32 undo steps. Rendering runs in the foreground. Recording, sequencer, SFX, speech, spectral repair, effects plugins, AI tools and hosted Files continuity are not connected on this surface." text-wrapping="Wrap" max-width="760" foreground="{Resource CuiTextSoftBrush}" />
    </StackPanel>
  </DefaultTheme>
</Cui>
