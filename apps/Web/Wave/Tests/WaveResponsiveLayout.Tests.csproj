    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BrowserApplicationSource Condition="'$(BrowserApplicationSource)' == ''">$(MSBuildThisFileDirectory)../../BrowserApplication.cs</BrowserApplicationSource>
    <BrowserSurfaceRegistrySource Condition="'$(BrowserSurfaceRegistrySource)' == ''">$(MSBuildThisFileDirectory)../../BrowserSurfaceRegistry.cs</BrowserSurfaceRegistrySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WaveResponsiveLayoutControls.cs;../../Tests/BrowserRenderPlatformShims.cs" />
    <Compile Include="$(BrowserApplicationSource)" Link="Production/BrowserApplication.cs" />
    <Compile Include="$(BrowserSurfaceRegistrySource)" Link="Production/BrowserSurfaceRegistry.cs" />
    <Compile Include="../../BrowserRouteCodec.cs;../../BrowserRouteDispatcher.cs;../../BrowserHomeContext.cs;../../BrowserActionAvailability.cs;../../BrowserAccessibilityBridge.cs;../../BrowserAccessibilityJsonContext.cs" Link="Production/%(Filename)%(Extension)" />
    <ProjectReference Include="../../Write/Scene/Haven.WriteBrowser.Scene.csproj" />
    <ProjectReference Include="../../../../9to1 Workspace/Home/HavenOS.Home.csproj" />
  </ItemGroup>
</Project>
