<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>NineToOne.Wave.BrowserEngine</AssemblyName>
    <WaveOwnerRoot>$(MSBuildProjectDirectory)/../../../../9to1 Workspace/Wave</WaveOwnerRoot>
    <WavePythonExecutable Condition="'$(WavePythonExecutable)' == ''">python3</WavePythonExecutable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../9to1 Workspace/shared/src/Haven.Core/Haven.Core.csproj" />
    <Compile Include="$(WaveOwnerRoot)/WaveProject.cs" Link="Owner/WaveProject.cs" />
    <Compile Include="$(WaveOwnerRoot)/WaveProjectEdits.cs" Link="Owner/WaveProjectEdits.cs" />
    <Compile Include="$(WaveOwnerRoot)/WaveTimelineAnnotations.cs" Link="Owner/WaveTimelineAnnotations.cs" />
    <Compile Include="$(WaveOwnerRoot)/WaveMediaAssetReferences.cs" Link="Owner/WaveMediaAssetReferences.cs" />
  </ItemGroup>
  <Target Name="GenerateReviewedOwnerWaveDecoder" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="&quot;$(WavePythonExecutable)&quot; &quot;$(MSBuildProjectDirectory)/generate-owner-decoder.py&quot; --source &quot;$(WaveOwnerRoot)/Program.cs&quot; --output &quot;$(IntermediateOutputPath)OwnerWaveDecoder.g.cs&quot; --manifest &quot;$(IntermediateOutputPath)owner-decoder-manifest.json&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)OwnerWaveDecoder.g.cs" /></ItemGroup>
  </Target>
</Project>
