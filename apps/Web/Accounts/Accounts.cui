<Cui id="home.settings.account" product="9-1" version="1">
  <Actions>
    <Action name="SelectSession" command="SelectSession" parameter="{Binding session}" />
  </Actions>
  <DefaultTheme value="Default">
    <StackPanel id="account-root" orientation="Vertical" padding="20" background="{Resource CuiBackgroundBrush}">
      <TextBlock text="Account settings" font-size="26" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
      <TextBlock id="account-status" text="{Binding Status}" text-wrapping="Wrap" accessible-name="Account operation status" margin="0 8 0 12" />
      <WrapPanel>
        <Button id="account-signin" action="RequestSignIn" content="Sign in" is-enabled="{Binding CanSignIn}" accessible-name="Open trusted CAKE ID sign-in" margin="0 0 8 8" />
        <Button id="account-refresh" action="Refresh" content="Check account" is-enabled="{Binding CanRefresh}" accessible-name="Check current account, profile and sessions" margin="0 0 8 8" />
        <Button id="account-discard" action="DiscardAndReload" content="Discard draft and reload" is-enabled="{Binding CanRefresh}" accessible-name="Discard unsaved profile edits and reload from the account service" margin="0 0 8 8" />
      </WrapPanel>
      <If condition="{Binding HasAccount}">
        <StackPanel margin="0 8 0 16">
          <TextBlock text="{Binding DisplayName}" font-size="20" text-wrapping="Wrap" />
          <TextBlock text="{Binding AccountId}" accessible-name="Canonical account ID" text-wrapping="Wrap" />
        </StackPanel>
      </If>
      <If condition="{Binding HasProfile}">
        <StackPanel id="account-profile" orientation="Vertical">
          <TextBlock text="Profile" font-size="20" font-weight="SemiBold" />
          <TextBlock text="* denotes a required field. Icon, Pronouns and Job are optional." text-wrapping="Wrap" />
          <TextBlock text="{Binding ProfileRevision}" accessible-name="Current profile revision" />
          <If condition="{Binding Conflict}"><TextBlock text="{Binding ConflictRevision}" accessible-name="Conflicting server profile revision" /></If>
          <TextBlock text="Name*" margin="0 8 0 4" />
          <TextBox id="profile-name" text="{Binding Draft.name, mode=TwoWay, type=string}" is-enabled="{Binding CanEdit}" accessible-name="Profile name" />
          <TextBlock text="Username*" margin="0 8 0 4" />
          <TextBox id="profile-username" text="{Binding Draft.username, mode=TwoWay, type=string}" is-enabled="{Binding CanEdit}" accessible-name="Profile username" />
          <TextBlock text="Profile icon link" margin="0 8 0 4" />
          <TextBox id="profile-icon" text="{Binding Draft.icon, mode=TwoWay, type=string}" is-enabled="{Binding CanEdit}" accessible-name="HTTPS profile icon link" />
          <Button action="ClearIcon" content="Clear profile icon" is-enabled="{Binding CanEdit}" accessible-name="Remove the profile icon" margin="0 4 0 8" />
          <TextBlock text="Pronouns" margin="0 8 0 4" />
          <TextBox id="profile-pronouns" text="{Binding Draft.pronouns, mode=TwoWay, type=string}" is-enabled="{Binding CanEdit}" accessible-name="Profile pronouns" />
          <Button action="ClearPronouns" content="Clear pronouns" is-enabled="{Binding CanEdit}" accessible-name="Remove profile pronouns" margin="0 4 0 8" />
          <TextBlock text="Job" margin="0 8 0 4" />
          <TextBox id="profile-job" text="{Binding Draft.job, mode=TwoWay, type=string}" is-enabled="{Binding CanEdit}" accessible-name="Profile job" />
          <Button action="ClearJob" content="Clear job" is-enabled="{Binding CanEdit}" accessible-name="Remove profile job" margin="0 4 0 8" />
          <Button id="profile-save" action="SaveProfile" content="Save profile" is-enabled="{Binding CanSave}" accessible-name="Save changed profile fields using the original revision" margin="0 8 0 16" />
        </StackPanel>
      </If>
      <TextBlock text="Sessions" font-size="20" font-weight="SemiBold" margin="0 8 0 8" />
      <TextBlock text="{Binding SessionSummary}" accessible-name="Session inspection status" text-wrapping="Wrap" margin="0 0 0 8" />
      <Repeat Source="{Binding Sessions}" As="session" Key="{Binding session.sessionId}">
        <Border border-thickness="1" border-brush="{Resource CuiLineBrush}" padding="12" margin="0 0 0 8">
          <StackPanel>
            <TextBlock text="{Binding session.deviceName}" text-wrapping="Wrap" />
            <TextBlock text="{Binding session.sessionId}" accessible-name="Canonical session ID" text-wrapping="Wrap" />
            <TextBlock text="{Binding session.createdAt}" accessible-name="Session created at" />
            <TextBlock text="{Binding session.expiresAt}" accessible-name="Session expires at" />
            <Button action="SelectSession" content="Revoke this session…" is-enabled="{Binding CanSessionActions}" accessible-name="Review revocation of this exact session" margin="0 8 0 0" />
          </StackPanel>
        </Border>
      </Repeat>
      <WrapPanel>
        <Button id="sessions-revoke-others" action="RequestRevokeOthers" content="Revoke other sessions…" is-enabled="{Binding CanSessionActions}" accessible-name="Review revocation of all other sessions" margin="0 8 8 8" />
        <Button id="account-signout" action="RequestSignOut" content="Sign out…" is-enabled="{Binding CanSessionActions}" accessible-name="Review sign out of the current session" margin="0 8 8 8" />
      </WrapPanel>
      <If condition="{Binding HasConfirmation}">
        <StackPanel id="session-confirmation" orientation="Vertical" margin="0 8 0 16">
          <TextBlock text="{Binding Confirmation}" text-wrapping="Wrap" accessible-name="Session change confirmation" />
          <WrapPanel>
            <Button id="session-confirm" action="ConfirmSessionMutation" content="Confirm session change" is-enabled="{Binding CanConfirm}" accessible-name="Confirm the reviewed session change" margin="0 8 8 0" />
            <Button action="CancelSessionMutation" content="Cancel" is-enabled="{Binding CanConfirm}" accessible-name="Cancel the session change" margin="0 8 0 0" />
          </WrapPanel>
        </StackPanel>
      </If>
      <TextBlock text="{Binding UnsupportedServices}" text-wrapping="Wrap" margin="0 12 0 0" accessible-name="Unavailable account services" />
    </StackPanel>
  </DefaultTheme>
</Cui>
