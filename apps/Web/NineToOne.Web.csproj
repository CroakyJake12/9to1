<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>NineToOne.Web</AssemblyName>
    <RootNamespace>NineToOne.Web</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmMainHTMLPath>wwwroot/index.html</WasmMainHTMLPath>
    <WasmEnableThreads>false</WasmEnableThreads>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <ProjectReference Include="../../framework/CUI/Runtime/CakeOS.Cui.Runtime.csproj" />
    <ProjectReference Include="../../framework/CUI/vendor/Avalonia/src/Browser/Avalonia.Browser/Avalonia.Browser.csproj" />
    <ProjectReference Include="../../9to1 Workspace/Home/HavenOS.Home.csproj" />
    <EmbeddedResource Include="../../9to1 Workspace/Home/UI/Home.cui" LogicalName="NineToOne.Web.Home.cui" />
    <WasmExtraFilesToDeploy Include="wwwroot/browser-platform.js" />
  </ItemGroup>
  <Target Name="CollectPinnedBrowserAssets" BeforeTargets="_WasmGenerateAppBundle">
    <PropertyGroup>
      <PinnedBrowserAssets>$(MSBuildProjectDirectory)/../../framework/CUI/vendor/Avalonia/src/Browser/Avalonia.Browser/staticwebassets</PinnedBrowserAssets>
    </PropertyGroup>
    <Error Condition="!Exists('$(PinnedBrowserAssets)/avalonia.js')" Text="The pinned Avalonia browser runtime assets have not been built. Restore the source build prerequisites before bundling this host." />
    <ItemGroup>
      <WasmExtraFilesToDeploy Include="$(PinnedBrowserAssets)/*.js;$(PinnedBrowserAssets)/*.js.map" />
    </ItemGroup>
  </Target>
</Project>
