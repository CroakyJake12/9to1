<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>NineToOne.Web</AssemblyName>
    <RootNamespace>NineToOne.Web</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableThreads>false</WasmEnableThreads>
    <!-- Existing canonical serializers own private reflection-based options.
         Preserve their exact model metadata in this browser composition. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <PinnedBrowserProject>$(MSBuildProjectDirectory)/../../framework/CUI/vendor/Avalonia/src/Browser/Avalonia.Browser</PinnedBrowserProject>
  </PropertyGroup>
  <!-- Source project references do not import the adapter's packaged build contract. -->
  <Import Project="$(PinnedBrowserProject)/build/Avalonia.Browser.props" />
  <Import Project="$(PinnedBrowserProject)/build/Avalonia.Browser.targets" />
  <ItemGroup>
    <!-- Replace only the adapter's fixed native variants with the later SDK-selected package inputs. -->
    <NativeFileReference Remove="@(NativeFileReference->WithMetadataValue('DefiningProjectName', 'Avalonia.Browser'))" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="**/Tests/**/*.cs;**/obj/**/*.cs;**/bin/**/*.cs;Wave/Engine/**/*.cs;Write/Scene/**/*.cs;Files/**/*.cs;Sites/**/*.cs;Picture/**/*.cs;Cards/**/*.cs;Forms/**/*.cs;Productivity/**/*.cs;AI/**/*.cs;Media/BrowserPictureMedia.cs;Media/IPictureBrowserMedia.cs" />
    <ProjectReference Include="../../framework/CUI/Runtime/CakeOS.Cui.Runtime.csproj" />
    <ProjectReference Include="../../framework/CUI/vendor/Avalonia/src/Browser/Avalonia.Browser/Avalonia.Browser.csproj" />
    <ProjectReference Include="../../9to1 Workspace/Home/HavenOS.Home.csproj" />
    <ProjectReference Include="Wave/Engine/NineToOne.Wave.BrowserEngine.csproj" />
    <ProjectReference Include="Write/Scene/Haven.WriteBrowser.Scene.csproj" />
    <ProjectReference Include="Write/Packages/NineToOne.Write.Packages.csproj" />
    <TrimmerRootAssembly Include="NineToOne.Web" />
    <TrimmerRootAssembly Include="NineToOne.Wave.BrowserEngine" />
    <TrimmerRootAssembly Include="Haven.Core" />
    <TrimmerRootAssembly Include="Haven" />
    <TrimmerRootAssembly Include="Haven.Application" />
    <TrimmerRootAssembly Include="NineToOne.Write.Packages" />
    <EmbeddedResource Include="../../9to1 Workspace/Home/UI/Home.cui" LogicalName="NineToOne.Web.Home.cui" />
    <EmbeddedResource Include="Wave/Wave.cui" LogicalName="NineToOne.Web.Wave.cui" />
    <EmbeddedResource Include="Accounts/Accounts.cui" LogicalName="NineToOne.Web.Accounts.cui" />
    <EmbeddedResource Include="Write/Write.cui" LogicalName="NineToOne.Web.Write.cui" />
    <Content Include="Media/wave-browser.js" Link="wwwroot/wave-browser.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Services/account-service.js" Link="wwwroot/account-service.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Auth/configured-accounts.bundle.js" Link="wwwroot/configured-accounts.bundle.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Services/notes-indexeddb.js" Link="wwwroot/notes-indexeddb.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Write/Packages/write-packages.js" Link="wwwroot/write-packages.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequirePinnedBrowserAssets" BeforeTargets="ResolveStaticWebAssetsInputs">
    <Error Condition="!Exists('$(PinnedBrowserProject)/staticwebassets/avalonia.js') or !Exists('$(PinnedBrowserProject)/staticwebassets/storage.js')" Text="The pinned Avalonia browser runtime assets have not been built. Build the adapter's locked webapp sources before publishing this host." />
    <ItemGroup>
      <BrowserSkiaNativeInput Include="@(NativeFileReference)" Condition="'%(NativeFileReference.Filename)' == 'libSkiaSharp'" />
      <BrowserHarfBuzzNativeInput Include="@(NativeFileReference)" Condition="'%(NativeFileReference.Filename)' == 'libHarfBuzzSharp'" />
    </ItemGroup>
    <Error Condition="'@(BrowserSkiaNativeInput)' == ''" Text="The browser host requires the pinned SkiaSharp native WebAssembly library input." />
    <Error Condition="'@(BrowserHarfBuzzNativeInput)' == ''" Text="The browser host requires the pinned HarfBuzzSharp native WebAssembly library input." />
  </Target>
</Project>
