<Cui id="boards.browser" version="1">
  <Import Source="framework/CUI/Components/App.cui" />
  <Variable Type="bool" ID="BoardsWorkspaceVisible">False</Variable>
  <Variable Type="commandstate" ID="BoardsHostResult" />
  <Variable Type="commandstate" ID="BoardsStoreResult" />
  <Variable Type="commandstate" ID="BoardsOpenResult" />
  <Variable Type="string" ID="BoardsFindQuery"></Variable>
  <Actions>
    <Action name="ObserveBoardsHost" command="boards.host.observe" result="BoardsHostResult">
      <Set Target="BoardsWorkspaceVisible" Value="True" When="{Binding BoardsHostResult.Value.UsesProvidedWorkspace}" />
    </Action>
    <Action name="InspectBoardsLibrary" command="boards.storage.inspect" result="BoardsStoreResult" />
    <Action name="InitialiseBoardsLibrary" command="boards.storage.initialise" parameter="{Binding BoardsStoreResult.Value}" result="BoardsStoreResult" />
    <Action name="BindEmptyBoardsLibrary" command="boards.storage.bind-empty" parameter="{Binding BoardsStoreResult.Value}" result="BoardsStoreResult" />
    <Action name="RequestBoardsLibraryImport" command="boards.storage.request-import" parameter="{Binding BoardsStoreResult.Value}" result="BoardsStoreResult" />
    <Action name="ReviewBoardsLibraryImport" command="boards.storage.review" parameter="{Binding BoardsStoreResult.Value}" result="BoardsStoreResult" />
    <Action name="CompleteBoardsLibraryImport" command="boards.storage.complete-import" parameter="{Binding BoardsStoreResult.Value}" result="BoardsStoreResult" />
    <Action name="RetryBoardsLibraryAudit" command="boards.storage.retry-audit" parameter="{Binding BoardsStoreResult.Value}" result="BoardsStoreResult" />
    <Action name="OpenOriginalBoardsLibrary" command="boards.storage.open" result="BoardsOpenResult">
      <Set Target="BoardsWorkspaceVisible" Value="True" When="{Binding BoardsOpenResult.Succeeded}" />
    </Action>
    <Action name="OpenSavedNotebook" command="Open" parameter="{Binding savedNotebook}" />
    <Action name="ChoosePage" command="SelectPage" parameter="{Binding page}" />
    <Action name="RecoverPage" command="RestorePage" parameter="{Binding deletedPage}" />
    <Action name="FindInBoard" command="FindBoard" parameter="{Binding BoardsFindQuery}" />
    <Action name="OpenBoardFindMatch" command="OpenFindMatch" parameter="{Binding findMatch}" />
    <Action name="PreviewSavedBoardVersion" command="PreviewHistory" parameter="{Binding savedVersion}" />
    <Action name="ChooseHistoryPage" command="SelectHistoryPage" parameter="{Binding historyPage}" />
  </Actions>
  <Effects>
    <Effect name="observe-owning-host" Condition="True" Action="ObserveBoardsHost" />
    <Effect name="inspect-original-device-library" Condition="{Binding BoardsHostResult.Value.RequiresOriginalStoreSetup}" Action="InspectBoardsLibrary" />
    <Effect name="open-verified-owned-library" Condition="{Binding BoardsStoreResult.Value.IsOwned}" Action="OpenOriginalBoardsLibrary" />
  </Effects>
  <Theme Name="user_preference">
    <Page>
      <If condition="!{Binding BoardsWorkspaceVisible}">
        <Container id="boards-storage-setup" Type="Vertical Stack" Padding="32" CellGap="16" max-width="680" horizontal-alignment="Center" background="{Resource CuiBackgroundBrush}" AccessibleName="Set up or open your Boards library">
          <Text text="Your Boards library" font-size="28" font-weight="SemiBold" />
          <Text text="Keep your boards on this device. Signing in to an account does not sync this local library." text-wrapping="Wrap" />
          <If condition="{Binding StorageSourceBusy}">
            <Text id="boards-storage-busy" text="Checking your library or waiting for its Home review…" text-wrapping="Wrap" AccessibleName="Library operation in progress" />
          </If>
          <Container id="boards-storage-actions" Type="Vertical Stack" Active="{Binding StorageSourceIdle}" Interactive="{Binding StorageSourceIdle}">
            <If condition="{Binding BoardsStoreResult.Succeeded}">
              <Text id="boards-storage-status" text="{Binding BoardsStoreResult.Value.Message}" text-wrapping="Wrap" />
            </If>
            <Else>
              <Text id="boards-storage-error" text="{Binding BoardsStoreResult.Message}" text-wrapping="Wrap" />
            </Else>
            <If condition="{Binding BoardsStoreResult.Value.CanInitialise}">
              <Button id="boards-storage-create" content="Create local library" action="InitialiseBoardsLibrary" horizontal-alignment="Left" />
            </If>
            <If condition="{Binding BoardsStoreResult.Value.CanBindEmpty}">
              <Text text="Your new library is empty. Connect it to your current device profile before opening it." text-wrapping="Wrap" />
              <Button id="boards-storage-bind-empty" content="Use this empty library" action="BindEmptyBoardsLibrary" horizontal-alignment="Left" />
            </If>
            <If condition="{Binding BoardsStoreResult.Value.CanRequestImport}">
              <Button id="boards-storage-request-import" content="Review existing library in Home" action="RequestBoardsLibraryImport" horizontal-alignment="Left" />
            </If>
            <If condition="{Binding BoardsStoreResult.Value.CanOpenReview}">
              <Button id="boards-storage-review" content="Open Home review" action="ReviewBoardsLibraryImport" horizontal-alignment="Left" />
            </If>
            <If condition="{Binding BoardsStoreResult.Value.CanCompleteImport}">
              <Button id="boards-storage-complete-import" content="Use this approved library" action="CompleteBoardsLibraryImport" horizontal-alignment="Left" />
            </If>
            <If condition="{Binding BoardsStoreResult.Value.CanRetryAudit}">
              <Button id="boards-storage-retry-audit" content="Finish library confirmation" action="RetryBoardsLibraryAudit" horizontal-alignment="Left" />
            </If>
            <If condition="{Binding BoardsStoreResult.Value.IsOwned}">
              <Text text="Your library is connected. Home will check permission to read its boards separately." text-wrapping="Wrap" />
              <Button id="boards-storage-open" content="Open library" action="OpenOriginalBoardsLibrary" horizontal-alignment="Left" />
            </If>
            <Text text="{Binding BoardsOpenResult.Message}" text-wrapping="Wrap" />
            <Button id="boards-storage-inspect" content="Check library again" action="InspectBoardsLibrary" horizontal-alignment="Left" />
          </Container>
        </Container>
      </If>
      <If condition="{Binding BoardsWorkspaceVisible}">
      <Container id="boards-workspace" background="{Resource CuiBackgroundBrush}" Type="Grid" RowSizes="Auto 1fr Auto">
        <Container padding="16,10" background="{Resource CuiPanelBrush}" Type="Overlay">
          <Container Type="Grid" ColumnSizes="Auto 1fr Auto">
            <Container Type="Horizontal Stack" CellGap="8">
              <Button content="Home" action="ShellHome" />
              <If condition="{Binding IsCompact}">
                <Button content="☰" accessible-name="Open or close Boards navigation" action="ToggleSidebar" />
              </If>
            </Container>
            <Container margin="16,0" vertical-alignment="Center" Type="Horizontal Stack" Column="1" CellGap="10">
              <Text text="Boards" font-weight="SemiBold" />
              <Text text="{Binding Breadcrumb}" foreground="{Resource CuiTextSoftBrush}" />
            </Container>
            <Container Type="Horizontal Stack" Column="2" CellGap="12">
              <AppAccentMenu ID="boards-app-accent" />
              <If condition="{Binding HasBoard}">
                <Input content="Edit" accessible-name="Edit page; off means View mode" Type="Checkbox" Checked="{Binding IsEditMode, mode=TwoWay}" Interactive="{Binding CanChangeBoard}" />
              </If>
              <If condition="{Binding HasBoard}">
                <Button content="Find" action="ToggleFind" accessible-name="Find text in this board" />
                <Button content="History" action="ToggleHistory" accessible-name="Browse this board’s saved versions" />
              </If>
              <Button content="Save" action="Save" Interactive="{Binding CanSave}" />
            </Container>
          </Container>
        </Container>
        <Container Type="Grid" Row="1" ColumnSizes="{Binding WorkspaceColumns}">
          <Container Type="Grid" Column="{Binding EditorColumn}" RowSizes="Auto 1fr Auto">
            <If condition="{Binding HasBoard}">
              <Container margin="24,18,24,8" Type="Vertical Stack" CellGap="12">
                <If condition="{Binding ShowBoardHistory}">
                  <Container id="boards-history" Type="Vertical Stack" CellGap="8" accessible-name="Saved board versions">
                    <Container Type="Wrap" CellGap="8">
                      <Text text="Saved versions" font-weight="SemiBold" />
                      <Button content="Reload versions" action="LoadHistory" />
                      <Button content="Close history" action="ToggleHistory" />
                    </Container>
                    <Text id="boards-history-status" text="{Binding BoardHistoryStatus}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                    <Container Type="Vertical Stack" VerticalScrolling="True" max-height="180">
                      <Repeat Source="{Binding BoardHistoryRows}" As="savedVersion" Key="{Binding savedVersion.Key}">
                        <Button id="boards-history-version" action="PreviewSavedBoardVersion" accessible-name="{Binding savedVersion.AccessibleName}" Interactive="{Binding savedVersion.CanPreview}" horizontal-content-alignment="Left">
                          <Text text="{Binding savedVersion.Label}" text-wrapping="Wrap" />
                        </Button>
                      </Repeat>
                    </Container>
                    <If condition="{Binding IsHistoryPreview}">
                      <Text text="{Binding HistoryPreviewTitle}" font-size="22" font-weight="SemiBold" />
                      <Text text="Read-only saved copy. The current board and its unsaved draft are preserved. Drawing or embedded content unsupported by the existing renderer remains in the original payload." text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                      <Container Type="Wrap" CellGap="6">
                        <Repeat Source="{Binding BoardHistoryPages}" As="historyPage" Key="{Binding historyPage.Key}">
                          <Button content="{Binding historyPage.Label}" action="ChooseHistoryPage" Interactive="{Binding historyPage.CanSelect}" />
                        </Repeat>
                      </Container>
                      <Text text="{Binding HistoryPreviewPageTitle}" font-size="20" font-weight="SemiBold" />
                      <Container Type="Wrap" CellGap="8">
                        <Button id="boards-history-return" content="Return to current board" action="CloseHistoryPreview" />
                        <Button id="boards-history-restore" content="Restore as unsaved draft" action="RestoreHistory" Interactive="{Binding CanRestoreHistory}" />
                      </Container>
                      <Text text="Restore requires a clean current board in Edit mode. Save your current draft first. After restoring, use Save to create a new version." text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                    </If>
                  </Container>
                </If>
                <If condition="{Binding ShowCurrentBoard}">
                <Input accessible-name="Page title" font-size="28" font-weight="Bold" Type="Text" Value="{Binding PageTitle, mode=TwoWay}" Interactive="{Binding CanEditPage}" />
                <If condition="{Binding ShowBoardFind}">
                  <Container id="boards-find" Type="Vertical Stack" CellGap="6" accessible-name="Find in the current board">
                    <Container Type="Wrap" CellGap="6">
                      <Input id="boards-find-query" Type="Text" Value="{Binding BoardsFindQuery, mode=TwoWay}" PlaceholderText="Find text in this board" accessible-name="Text to find in the current board" min-width="180" />
                      <Button id="boards-find-run" content="Find in board" action="FindInBoard" />
                      <Button content="Close find" action="ToggleFind" />
                    </Container>
                    <Text id="boards-find-status" text="{Binding BoardFindStatus}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                    <Container Type="Vertical Stack" VerticalScrolling="True" max-height="220">
                      <Repeat Source="{Binding BoardFindMatches}" As="findMatch" Key="{Binding findMatch.Key}">
                        <Button id="boards-find-match" action="OpenBoardFindMatch" accessible-name="{Binding findMatch.AccessibleName}" Interactive="{Binding findMatch.CanOpen}" horizontal-content-alignment="Left">
                          <Text text="{Binding findMatch.Label}" text-wrapping="Wrap" />
                        </Button>
                      </Repeat>
                    </Container>
                  </Container>
                </If>
                <If condition="{Binding IsEditMode}">
                  <Container background="{Resource CuiPanelBrush}" padding="8" corner-radius="8" horizontal-alignment="Left" Type="Overlay">
                    <Container Type="Wrap">
                      <Container Type="Menu">
                        <Button Type="Menu Item" Content="Insert">
                          <Button action="InsertParagraph" Type="Menu Item" Content="Text" />
                          <Button action="InsertHeading" Type="Menu Item" Content="Heading" />
                          <Button action="InsertChecklist" Type="Menu Item" Content="Checklist" />
                          <Button action="InsertTable" Type="Menu Item" Content="Table" />
                        </Button>
                      </Container>
                      <Button content="B" accessible-name="Bold selection" font-weight="Bold" action="Bold" margin="6,0,0,0" />
                      <Button content="I" accessible-name="Italic selection" font-style="Italic" action="Italic" />
                      <Button content="U" accessible-name="Underline selection" action="Underline" />
                      <Button content="Undo" action="Undo" margin="12,0,0,0" />
                      <Button content="Redo" action="Redo" />
                      <Input content="Unlock layout" margin="14,0,6,0" Type="Checkbox" Checked="{Binding LayoutUnlocked, mode=TwoWay}" Interactive="{Binding CanEditPage}" />
                    </Container>
                  </Container>
                </If>
                <If condition="{Binding IsChecklistSelected}">
                  <Container max-width="720" horizontal-alignment="Left" Type="Vertical Stack" CellGap="6">
                    <Text text="Checklist" font-weight="SemiBold" />
                    <Repeat Source="{Binding ChecklistItems}" As="item" Key="{Binding item.Id}">
                      <Container margin="0,2" Type="Grid" ColumnSizes="Auto 1fr">
                        <Input accessible-name="Task complete" Type="Checkbox" Checked="{Binding item.Checked, mode=TwoWay}" Interactive="{Binding CanEditPage}" />
                        <Input accessible-name="Task text" min-width="200" Type="Text" Column="1" Value="{Binding item.Text, mode=TwoWay}" Interactive="{Binding CanEditPage}" />
                      </Container>
                    </Repeat>
                    <Button content="Add item" action="AddChecklistItem" horizontal-alignment="Left" />
                  </Container>
                </If>
                <If condition="{Binding IsViewMode}">
                  <Text text="Viewing · content is protected. Turn Edit on to make changes." text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                </If>
                <If condition="{Binding HasUnsupportedPageContent}">
                  <Text text="This page contains drawing or embedded objects that this browser preview cannot display. They are preserved when you save." text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                </If>
                </If>
              </Container>
            </If>
            <Container Type="Overlay" Row="1" HorizontalScrolling="False" VerticalScrolling="True">
              <Container Type="Vertical Stack">
                <If condition="{Binding HasNoBoard}">
                  <Container margin="32" max-width="960" horizontal-alignment="Stretch" Type="Vertical Stack" CellGap="16">
                    <Text text="Your boards" font-size="30" font-weight="Bold" />
                    <Text text="A place for your notes, plans and ideas." text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                    <Button accessible-name="＋ Create a board" action="Create" horizontal-alignment="Left" padding="20,12">
                      <Container Type="Horizontal Stack" CellGap="8" VerticalAlignment="Center">
                        <Image id="boards-create-icon" Source="icon:add" Width="16" Height="16" />
                        <Text Text="Create a board" />
                      </Container>
                    </Button>
                    <Text text="Recent boards" font-size="18" font-weight="SemiBold" margin="0,20,0,0" />
                    <If condition="{Binding NoBoards}">
                      <Text text="Your boards will appear here as you create them." text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                    </If>
                    <Repeat Source="{Binding Notebooks}" As="savedNotebook" Key="{Binding savedNotebook.Id}">
                      <Container padding="20" corner-radius="10" background="{Resource CuiPanelBrush}" margin="0,0,0,10" Type="Overlay">
                        <Container Type="Vertical Stack" CellGap="10">
                          <Button content="{Binding savedNotebook.Title}" action="OpenSavedNotebook" horizontal-alignment="Left" font-size="18" />
                          <Text text="{Binding savedNotebook.Detail}" foreground="{Resource CuiTextSoftBrush}" />
                        </Container>
                      </Container>
                    </Repeat>
                  </Container>
                </If>
                <If condition="{Binding ShowCurrentBoard}">
                  <Object Type="BoardsNotebookSurface" />
                </If>
                <If condition="{Binding IsHistoryPreview}">
                  <Object Type="BoardsHistorySurface" />
                </If>
              </Container>
            </Container>
            <If condition="{Binding HasUnknownCommitOutcome}" Row="2">
              <Container padding="20" background="{Resource CuiPanelBrush}" Type="Overlay">
                <Container Type="Vertical Stack" CellGap="8">
                  <Text text="We could not confirm the last save. Your draft is kept open; check the saved copy before continuing." text-wrapping="Wrap" />
                  <Button content="Check saved copy" action="Inspect" horizontal-alignment="Left" />
                </Container>
              </Container>
            </If>
          </Container>
          <If condition="{Binding ShowSidebar}">
            <Container width="{Binding DrawerWidth}" horizontal-alignment="Left" background="{Resource CuiPanelBrush}" padding="14,18" Type="Overlay">
              <Container Type="Overlay" HorizontalScrolling="False" VerticalScrolling="True">
                <Container Type="Vertical Stack" CellGap="10">
                  <If condition="{Binding IsCompact}">
                    <Button content="Close navigation" action="ToggleSidebar" />
                  </If>
                  <Button content="{Binding BoardTitle}" accessible-name="Choose board" action="ToggleBoardPicker" font-weight="SemiBold" />
                  <If condition="{Binding ShowBoardPicker}">
                    <Container Type="Vertical Stack" CellGap="8">
                      <Input accessible-name="Search boards" Type="Text" Value="{Binding BoardSearch, mode=TwoWay}" PlaceholderText="Find a board" />
                      <Button accessible-name="＋ New board" action="Create">
                        <Container Type="Horizontal Stack" CellGap="8" VerticalAlignment="Center">
                          <Image id="boards-new-icon" Source="icon:add" Width="16" Height="16" />
                          <Text Text="New board" />
                        </Container>
                      </Button>
                      <Button content="Refresh" action="Refresh" />
                      <Repeat Source="{Binding Notebooks}" As="savedNotebook" Key="{Binding savedNotebook.Id}">
                        <Button content="{Binding savedNotebook.Title}" action="OpenSavedNotebook" horizontal-content-alignment="Left" />
                      </Repeat>
                    </Container>
                  </If>
                  <If condition="{Binding ShowPageTree}">
                    <Container Type="Vertical Stack" CellGap="6">
                      <Input accessible-name="Board name" margin="0,2,0,12" Type="Text" Value="{Binding BoardTitle, mode=TwoWay}" Interactive="{Binding CanEditPage}" />
                      <Text text="Pages" foreground="{Resource CuiTextSoftBrush}" margin="4,0,0,8" />
                      <Repeat Source="{Binding PageRows}" As="page" Key="{Binding page.Id}">
                        <Button content="{Binding page.Label}" action="ChoosePage" horizontal-content-alignment="Left" margin="0,0,0,4" />
                      </Repeat>
                      <Button content="＋ Add page" action="AddPage" horizontal-content-alignment="Left" margin="0,10,0,0" />
                      <Container Type="Menu">
                        <Button Type="Menu Item" Content="Page options">
                          <Button action="MovePageUp" Type="Menu Item" Content="Move page up" Interactive="{Binding CanMovePageUp}" />
                          <Button action="MovePageDown" Type="Menu Item" Content="Move page down" Interactive="{Binding CanMovePageDown}" />
                          <Button action="DeletePage" Type="Menu Item" Content="Move page to Trash" Interactive="{Binding CanDeletePage}" />
                          <Button action="AddSection" Type="Menu Item" Content="New section" />
                        </Button>
                      </Container>
                      <Button content="Trash" action="ToggleTrash" horizontal-content-alignment="Left" margin="0,16,0,0" />
                      <If condition="{Binding ShowTrash}">
                        <Container Type="Vertical Stack" CellGap="6">
                          <Text text="Deleted pages can be recovered here." text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                          <Repeat Source="{Binding DeletedPages}" As="deletedPage" Key="{Binding deletedPage.Id}">
                            <Container Type="Vertical Stack" CellGap="4">
                              <Text text="{Binding deletedPage.Title}" />
                              <Button content="Restore page" action="RecoverPage" Interactive="{Binding CanRestorePage}" />
                            </Container>
                          </Repeat>
                        </Container>
                      </If>
                      <Button content="Close board" action="Close" horizontal-content-alignment="Left" margin="0,14,0,0" />
                    </Container>
                  </If>
                </Container>
              </Container>
            </Container>
          </If>
        </Container>
        <Container padding="18,8" background="{Resource CuiPanelBrush}" Type="Overlay" Row="2">
          <Container Type="Vertical Stack" CellGap="8">
            <Container Type="Grid" ColumnSizes="1fr Auto">
              <Text text="{Binding Status}" accessible-name="Board save status" text-wrapping="Wrap" vertical-alignment="Center" />
              <Button content="{Binding DetailsLabel}" action="ToggleDetails" Column="1" />
            </Container>
            <If condition="{Binding ShowDetails}">
              <Container Type="Vertical Stack" CellGap="6">
                <Text text="{Binding StorageDetail}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
                <Text text="{Binding CapabilitiesDetail}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
              </Container>
            </If>
          </Container>
        </Container>
      </Container>
      </If>
    </Page>
  </Theme>
</Cui>
