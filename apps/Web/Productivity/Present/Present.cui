<Cui id="present.browser" version="1">
  <Import Source="framework/CUI/Components/Editor.cui" />
  <Button (Definition) ID="PresentShapeGallery" Type="Menu Item" Content="Shapes" Padding="7,6" Background="Transparent" BorderWidth="0">
    <EditorMenu Content="Basic shapes" MenuColumns="4">
      <EditorMenu Content="Rectangle" AccessibleName="Rectangle" Tooltip="Rectangle" IconSource="shape:rect" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_rect" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Rounded rectangle" AccessibleName="Rounded rectangle" Tooltip="Rounded rectangle" IconSource="shape:roundRect" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_roundRect" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Ellipse" AccessibleName="Ellipse" Tooltip="Ellipse" IconSource="shape:ellipse" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_ellipse" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Triangle" AccessibleName="Triangle" Tooltip="Triangle" IconSource="shape:triangle" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_triangle" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Diamond" AccessibleName="Diamond" Tooltip="Diamond" IconSource="shape:diamond" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_diamond" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Hexagon" AccessibleName="Hexagon" Tooltip="Hexagon" IconSource="shape:hexagon" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_hexagon" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Star" AccessibleName="Star" Tooltip="Star" IconSource="shape:star" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_star" Interactive="{Binding CanEdit}" />
    </EditorMenu>
    <EditorMenu Content="Lines and arrows" MenuColumns="4">
      <EditorMenu Content="Line" AccessibleName="Line" Tooltip="Line" IconSource="shape:line" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_line" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Right arrow" AccessibleName="Right arrow" Tooltip="Right arrow" IconSource="shape:rightArrow" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_rightArrow" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Left arrow" AccessibleName="Left arrow" Tooltip="Left arrow" IconSource="shape:leftArrow" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_leftArrow" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Two-way arrow" AccessibleName="Two-way arrow" Tooltip="Two-way arrow" IconSource="shape:leftRightArrow" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_leftRightArrow" Interactive="{Binding CanEdit}" />
    </EditorMenu>
    <EditorMenu Content="Flowchart" MenuColumns="4">
      <EditorMenu Content="Decision" AccessibleName="Decision" Tooltip="Decision" IconSource="shape:flowDecision" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_flowDecision" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Process" AccessibleName="Process" Tooltip="Process" IconSource="shape:flowProcess" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_flowProcess" Interactive="{Binding CanEdit}" />
      <EditorMenu Content="Terminator" AccessibleName="Terminator" Tooltip="Terminator" IconSource="shape:flowTerminator" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_flowTerminator" Interactive="{Binding CanEdit}" />
    </EditorMenu>
    <EditorMenu Content="Callouts" MenuColumns="4">
      <EditorMenu Content="Speech bubble" AccessibleName="Speech bubble" Tooltip="Speech bubble" IconSource="shape:callout" IconOnly="True" Width="56" Height="56" CornerRadius="8" Action="InsertShape_callout" Interactive="{Binding CanEdit}" />
    </EditorMenu>
  </Button>
  <Button (Definition) ID="PresentTextPalette" Type="Menu Item" MenuColumns="5" Content="Text colour" AccessibleName="Text colour" Tooltip="Text colour" IconSource="icon:text-color" Width="36" Height="36" Padding="8" BorderWidth="0" Background="Transparent" CornerRadius="8" Interactive="{Binding CanFontSize}">
      <EditorMenu Content="Black" AccessibleName="Black" Tooltip="Black" IconSource="color:#202020" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="TextColourBlack" />
      <EditorMenu Content="White" AccessibleName="White" Tooltip="White" IconSource="color:#ffffff" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="TextColourWhite" />
      <EditorMenu Content="Blue" AccessibleName="Blue" Tooltip="Blue" IconSource="color:#4472c4" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="TextColourBlue" />
      <EditorMenu Content="Teal" AccessibleName="Teal" Tooltip="Teal" IconSource="color:#008080" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="TextColourTeal" />
      <EditorMenu Content="Green" AccessibleName="Green" Tooltip="Green" IconSource="color:#228b22" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="TextColourGreen" />
      <EditorMenu Content="Yellow" AccessibleName="Yellow" Tooltip="Yellow" IconSource="color:#ffd966" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="TextColourYellow" />
      <EditorMenu Content="Orange" AccessibleName="Orange" Tooltip="Orange" IconSource="color:#ed7d31" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="TextColourOrange" />
      <EditorMenu Content="Red" AccessibleName="Red" Tooltip="Red" IconSource="color:#c00000" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="TextColourRed" />
      <EditorMenu Content="Purple" AccessibleName="Purple" Tooltip="Purple" IconSource="color:#7030a0" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="TextColourPurple" />
    <EditorMenu IconOnly="True" IconSource="icon:properties" Tooltip="Custom colour" Width="44" Height="44" Padding="4" Content="Custom colour…" Action="ShowObjectProperties" />
  </Button>
  <Button (Definition) ID="PresentFillPalette" Type="Menu Item" MenuColumns="5" Content="Shape fill" AccessibleName="Shape fill" Tooltip="Shape fill" IconSource="icon:palette" Width="36" Height="36" Padding="8" BorderWidth="0" Background="Transparent" CornerRadius="8" Interactive="{Binding CanApplyFill}">
      <EditorMenu Content="Black" AccessibleName="Black" Tooltip="Black" IconSource="color:#202020" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="FillColourBlack" />
      <EditorMenu Content="White" AccessibleName="White" Tooltip="White" IconSource="color:#ffffff" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="FillColourWhite" />
      <EditorMenu Content="Blue" AccessibleName="Blue" Tooltip="Blue" IconSource="color:#4472c4" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="FillColourBlue" />
      <EditorMenu Content="Teal" AccessibleName="Teal" Tooltip="Teal" IconSource="color:#008080" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="FillColourTeal" />
      <EditorMenu Content="Green" AccessibleName="Green" Tooltip="Green" IconSource="color:#228b22" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="FillColourGreen" />
      <EditorMenu Content="Yellow" AccessibleName="Yellow" Tooltip="Yellow" IconSource="color:#ffd966" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="FillColourYellow" />
      <EditorMenu Content="Orange" AccessibleName="Orange" Tooltip="Orange" IconSource="color:#ed7d31" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="FillColourOrange" />
      <EditorMenu Content="Red" AccessibleName="Red" Tooltip="Red" IconSource="color:#c00000" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="FillColourRed" />
      <EditorMenu Content="Purple" AccessibleName="Purple" Tooltip="Purple" IconSource="color:#7030a0" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="FillColourPurple" />
    <EditorMenu IconOnly="True" IconSource="icon:close" Tooltip="No fill" Width="44" Height="44" Padding="4" Content="No fill" Action="FillColourNone" />
    <EditorMenu IconOnly="True" IconSource="icon:properties" Tooltip="Custom colour" Width="44" Height="44" Padding="4" Content="Custom colour…" Action="ShowObjectProperties" />
  </Button>
  <Button (Definition) ID="PresentStrokePalette" Type="Menu Item" MenuColumns="5" Content="Shape outline" AccessibleName="Shape outline" Tooltip="Shape outline" IconSource="icon:stroke" Width="36" Height="36" Padding="8" BorderWidth="0" Background="Transparent" CornerRadius="8" Interactive="{Binding CanApplyStroke}">
      <EditorMenu Content="Black" AccessibleName="Black" Tooltip="Black" IconSource="color:#202020" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="StrokeColourBlack" />
      <EditorMenu Content="White" AccessibleName="White" Tooltip="White" IconSource="color:#ffffff" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="StrokeColourWhite" />
      <EditorMenu Content="Blue" AccessibleName="Blue" Tooltip="Blue" IconSource="color:#4472c4" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="StrokeColourBlue" />
      <EditorMenu Content="Teal" AccessibleName="Teal" Tooltip="Teal" IconSource="color:#008080" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="StrokeColourTeal" />
      <EditorMenu Content="Green" AccessibleName="Green" Tooltip="Green" IconSource="color:#228b22" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="StrokeColourGreen" />
      <EditorMenu Content="Yellow" AccessibleName="Yellow" Tooltip="Yellow" IconSource="color:#ffd966" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="StrokeColourYellow" />
      <EditorMenu Content="Orange" AccessibleName="Orange" Tooltip="Orange" IconSource="color:#ed7d31" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="StrokeColourOrange" />
      <EditorMenu Content="Red" AccessibleName="Red" Tooltip="Red" IconSource="color:#c00000" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="StrokeColourRed" />
      <EditorMenu Content="Purple" AccessibleName="Purple" Tooltip="Purple" IconSource="color:#7030a0" IconOnly="True" Width="44" Height="44" Padding="4" CornerRadius="8" Action="StrokeColourPurple" />
    <EditorMenu IconOnly="True" IconSource="icon:close" Tooltip="No stroke" Width="44" Height="44" Padding="4" Content="No stroke" Action="StrokeColourNone" />
    <EditorMenu IconOnly="True" IconSource="icon:properties" Tooltip="Custom colour" Width="44" Height="44" Padding="4" Content="Custom colour…" Action="ShowObjectProperties" />
  </Button>
  <Button (Definition) ID="PresentChartMenu" Type="Menu Item" Content="Chart" Padding="7,6" Background="Transparent" BorderWidth="0">
    <EditorMenu Content="Column chart" Action="InsertColumnChart" Interactive="{Binding CanEdit}" />
    <EditorMenu Content="Bar chart" Action="InsertBarChart" Interactive="{Binding CanEdit}" />
    <EditorMenu Content="Line chart" Action="InsertLineChart" Interactive="{Binding CanEdit}" />
    <EditorMenu Content="Area chart" Action="InsertAreaChart" Interactive="{Binding CanEdit}" />
    <EditorMenu Content="Pie chart" Action="InsertPieChart" Interactive="{Binding CanEdit}" />
    <EditorMenu Content="Doughnut chart" Action="InsertDoughnutChart" Interactive="{Binding CanEdit}" />
    <EditorMenu Content="Scatter chart" Action="InsertScatterChart" Interactive="{Binding CanEdit}" />
  </Button>
  <Actions>
    <Action name="InsertColumnChart" command="AddChart" parameter="Column" />
    <Action name="InsertBarChart" command="AddChart" parameter="Bar" />
    <Action name="InsertLineChart" command="AddChart" parameter="Line" />
    <Action name="InsertAreaChart" command="AddChart" parameter="Area" />
    <Action name="InsertPieChart" command="AddChart" parameter="Pie" />
    <Action name="InsertDoughnutChart" command="AddChart" parameter="Doughnut" />
    <Action name="InsertScatterChart" command="AddChart" parameter="Scatter" />

    <Action name="RestoreSavedVersion" command="RestoreVersion" parameter="{Binding version}" />
    <Action name="OpenSavedPresentation" command="Open" parameter="{Binding saved}" />
    <Action name="OpenStartPresentation" command="Open" parameter="{Binding recent}" />
    <Action name="SelectPresentationSlide" command="SelectSlide" parameter="{Binding slide}" />
    <Action name="InsertShape_rect" command="BeginShape" parameter="rect" />
    <Action name="InsertShape_roundRect" command="BeginShape" parameter="roundRect" />
    <Action name="InsertShape_ellipse" command="BeginShape" parameter="ellipse" />
    <Action name="InsertShape_triangle" command="BeginShape" parameter="triangle" />
    <Action name="InsertShape_diamond" command="BeginShape" parameter="diamond" />
    <Action name="InsertShape_hexagon" command="BeginShape" parameter="hexagon" />
    <Action name="InsertShape_star" command="BeginShape" parameter="star" />
    <Action name="InsertShape_line" command="BeginShape" parameter="line" />
    <Action name="InsertShape_rightArrow" command="BeginShape" parameter="rightArrow" />
    <Action name="InsertShape_leftArrow" command="BeginShape" parameter="leftArrow" />
    <Action name="InsertShape_leftRightArrow" command="BeginShape" parameter="leftRightArrow" />
    <Action name="InsertShape_flowDecision" command="BeginShape" parameter="flowDecision" />
    <Action name="InsertShape_flowProcess" command="BeginShape" parameter="flowProcess" />
    <Action name="InsertShape_flowTerminator" command="BeginShape" parameter="flowTerminator" />
    <Action name="InsertShape_callout" command="BeginShape" parameter="callout" />
    <Action name="Zoom25" command="SetZoom" parameter="0.25" />
    <Action name="Zoom50" command="SetZoom" parameter="0.5" />
    <Action name="Zoom75" command="SetZoom" parameter="0.75" />
    <Action name="Zoom100" command="SetZoom" parameter="1" />
    <Action name="Zoom150" command="SetZoom" parameter="1.5" />
    <Action name="Zoom200" command="SetZoom" parameter="2" />
    <Action name="Zoom400" command="SetZoom" parameter="4" />
    <Action name="TextColourBlack" command="SetTextColor" parameter="#202020" />
    <Action name="TextColourWhite" command="SetTextColor" parameter="#ffffff" />
    <Action name="TextColourBlue" command="SetTextColor" parameter="#4472c4" />
    <Action name="TextColourTeal" command="SetTextColor" parameter="#008080" />
    <Action name="TextColourGreen" command="SetTextColor" parameter="#228b22" />
    <Action name="TextColourYellow" command="SetTextColor" parameter="#ffd966" />
    <Action name="TextColourOrange" command="SetTextColor" parameter="#ed7d31" />
    <Action name="TextColourRed" command="SetTextColor" parameter="#c00000" />
    <Action name="TextColourPurple" command="SetTextColor" parameter="#7030a0" />
    <Action name="FillColourBlack" command="SetFillColor" parameter="#202020" />
    <Action name="FillColourWhite" command="SetFillColor" parameter="#ffffff" />
    <Action name="FillColourBlue" command="SetFillColor" parameter="#4472c4" />
    <Action name="FillColourTeal" command="SetFillColor" parameter="#008080" />
    <Action name="FillColourGreen" command="SetFillColor" parameter="#228b22" />
    <Action name="FillColourYellow" command="SetFillColor" parameter="#ffd966" />
    <Action name="FillColourOrange" command="SetFillColor" parameter="#ed7d31" />
    <Action name="FillColourRed" command="SetFillColor" parameter="#c00000" />
    <Action name="FillColourPurple" command="SetFillColor" parameter="#7030a0" />
    <Action name="FillColourNone" command="SetFillColor" parameter="none" />
    <Action name="StrokeColourBlack" command="SetStrokeColor" parameter="#202020" />
    <Action name="StrokeColourWhite" command="SetStrokeColor" parameter="#ffffff" />
    <Action name="StrokeColourBlue" command="SetStrokeColor" parameter="#4472c4" />
    <Action name="StrokeColourTeal" command="SetStrokeColor" parameter="#008080" />
    <Action name="StrokeColourGreen" command="SetStrokeColor" parameter="#228b22" />
    <Action name="StrokeColourYellow" command="SetStrokeColor" parameter="#ffd966" />
    <Action name="StrokeColourOrange" command="SetStrokeColor" parameter="#ed7d31" />
    <Action name="StrokeColourRed" command="SetStrokeColor" parameter="#c00000" />
    <Action name="StrokeColourPurple" command="SetStrokeColor" parameter="#7030a0" />
    <Action name="StrokeColourNone" command="SetStrokeColor" parameter="none" />
    <Action name="OutlineWidth0" command="SetStrokeWidth" parameter="0" />
    <Action name="OutlineWidth1" command="SetStrokeWidth" parameter="1" />
    <Action name="OutlineWidth2" command="SetStrokeWidth" parameter="2" />
    <Action name="OutlineWidth4" command="SetStrokeWidth" parameter="4" />
    <Action name="OutlineWidth6" command="SetStrokeWidth" parameter="6" />
    <Action name="OutlineWidth8" command="SetStrokeWidth" parameter="8" />
  </Actions>
  <Theme Name="user_preference">
    <Page>
      <Container ID="present-views" Type="Overlay" Background="{Resource CuiBackgroundBrush}">
        <Container ID="present-start" Type="Overlay" Active="{Binding ShowStart}" VerticalScrolling="True">
          <Container ID="present-ui-1" Type="Vertical Stack" CellGap="24" Padding="32" MaxWidth="1000" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Button ID="present-ui-2" Content="Home" Action="ShellHome" HorizontalAlignment="Left" />
            <Container ID="present-ui-3" Type="Vertical Stack" CellGap="8">
              <Text ID="present-ui-4" Text="Present" FontSize="32" FontWeight="SemiBold" />
              <Text ID="present-ui-5" Text="Give your next story a place to start." FontSize="18" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            </Container>
            <Container ID="present-ui-6" Type="Wrap" CellGap="12">
              <Button ID="present-ui-7" Content="New presentation" Action="Create" Interactive="{Binding CanCreate}" Padding="22,16" />
              <Button ID="present-ui-8" Content="Import .pptx" Action="ImportPowerPoint" Interactive="{Binding CanImportPowerPoint}" Padding="22,16" />
            </Container>
            <Container ID="present-ui-9" Type="Vertical Stack" CellGap="10" Active="{Binding HasDocument}" Background="{Resource CuiPanelBrush}" Padding="20" CornerRadius="8">
              <Text ID="present-ui-10" Text="Continue working" FontSize="18" FontWeight="SemiBold" />
              <Text ID="present-ui-11" Text="{Binding StartStatus}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              <Button ID="present-ui-12" Content="Resume presentation" Action="ResumePresentation" Interactive="{Binding CanResume}" HorizontalAlignment="Left" />
            </Container>
            <Container ID="present-ui-13" Type="Vertical Stack" CellGap="12">
              <Container ID="present-ui-14" Type="Grid" ColumnSizes="1fr Auto">
                <Text ID="present-ui-15" Text="Recent presentations" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button ID="present-ui-16" Content="Refresh" Action="Refresh" Interactive="{Binding CanBrowse}" Column="1" />
              </Container>
              <Text ID="present-ui-17" Text="Saved in this browser" Foreground="{Resource CuiTextSoftBrush}" />
              <Container ID="present-ui-18" Type="Overlay" Active="{Binding NoSavedDocuments}" Background="{Resource CuiPanelBrush}" Padding="20" CornerRadius="8">
                <Text ID="present-ui-19" Text="Create a presentation, or import an existing PowerPoint file." TextWrapping="Wrap" />
              </Container>
              <Repeat Source="{Binding Documents}" As="recent" Key="{Binding recent.Id}">
                <Container ID="present-ui-20" Type="Vertical Stack" CellGap="6" Margin="0,0,0,12">
                  <Button ID="present-ui-21" Content="{Binding recent.Title}" Action="OpenStartPresentation" Interactive="{Binding CanBrowse}" HorizontalAlignment="Stretch" Padding="16,12" />
                  <Text ID="present-ui-22" Text="{Binding recent.LocationAndModified}" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                </Container>
              </Repeat>
              <Text ID="present-ui-23" Text="{Binding Status}" TextWrapping="Wrap" />
              <Container ID="present-ui-24" Type="Overlay" Active="{Binding HasUnknownCommitOutcome}">
                <Button ID="present-ui-25" Content="Inspect saved state" Action="Inspect" Interactive="{Binding CanInspect}" />
              </Container>
            </Container>
          </Container>
        </Container>
        <EditorShell ID="present-workspace" Active="{Binding ShowWorkspace}">
          <EditorHeader ID="present-document-header" Active="{Binding ShowEditorChrome}">
            <EditorToolGroup ID="present-ui-26" VerticalAlignment="Top">
              <EditorIcon ID="present-ui-27" AccessibleName="9to1 Home" Tooltip="9to1 Home" Action="ShellHome">
                <Image ID="present-ui-28" Source="icon:home" Width="20" Height="20" />
              </EditorIcon>
              <Text ID="present-ui-29" Text="Present" FontWeight="SemiBold" FontSize="16" Active="{Binding WideHeader}" Margin="2,0,8,0" VerticalAlignment="Center" />
            </EditorToolGroup>
            <Container ID="present-ui-30" Type="Vertical Stack" Column="1" CellGap="3" VerticalAlignment="Center">
              <Input ID="present-ui-31" Type="Text" AccessibleName="Presentation title" Value="{Binding Title, Mode=TwoWay}" Interactive="{Binding CanEdit}" Height="36" Padding="6,3" BorderWidth="0" Background="Transparent" FontSize="16" FontWeight="SemiBold" />
              <Text ID="present-ui-32" Text="{Binding HeaderStatus}" AccessibleName="Presentation save status" Foreground="{Resource CuiTextSoftBrush}" FontSize="11" Margin="6,0" />
            </Container>
            <EditorToolGroup ID="present-ui-33" Column="2" CellGap="6">
              <EditorIcon ID="present-ui-34" AccessibleName="Save (Ctrl+S)" Tooltip="Save (Ctrl+S)" Action="Save" Interactive="{Binding CanSave}">
                <Image ID="present-ui-35" Source="icon:save" Width="20" Height="20" />
              </EditorIcon>
              <EditorIcon ID="present-ui-36" AccessibleName="Version history" Tooltip="Version history" Action="ShowHistory" Interactive="{Binding CanHistory}">
                <Image ID="present-ui-37" Source="icon:history" Width="20" Height="20" />
              </EditorIcon>
              <Button ID="present-ui-38" Content="Present" Action="Present" Interactive="{Binding CanPresent}" Height="36" Padding="14,6" Background="{Resource CuiAccentBrush}" Foreground="{Resource CuiAccentForegroundBrush}" BorderWidth="0" CornerRadius="10" />
            </EditorToolGroup>
          </EditorHeader>
          <EditorMenus ID="present-menu-bar" Row="1" Active="{Binding ShowEditorChrome}">
            <EditorMenu ID="present-ui-39" Content="File">
              <EditorMenu ID="present-ui-40" Content="Back to Present start" Action="ReturnToStart" />
              <EditorMenu ID="present-ui-41" Content="New presentation" Action="Create" Interactive="{Binding CanCreate}" />
              <EditorMenu ID="present-ui-42" Content="Open presentations" Action="ToggleFiles" />
              <EditorMenu ID="present-ui-43" Content="Refresh presentations" Action="Refresh" Interactive="{Binding CanBrowse}" />
              <EditorMenu ID="present-ui-44" Content="Save" Action="Save" Interactive="{Binding CanSave}" Shortcut="Ctrl+S" />
              <EditorMenu ID="present-ui-45" Content="Version history" Action="ShowHistory" Interactive="{Binding CanHistory}" />
              <EditorMenu ID="present-ui-46" Content="Import .pptx" Action="ImportPowerPoint" Interactive="{Binding CanImportPowerPoint}" />
              <EditorMenu ID="present-ui-47" Content="Export .pptx" Action="ExportPowerPoint" Interactive="{Binding CanExportPowerPoint}" />
              <EditorMenu ID="present-ui-48" Content="Inspect saved state" Action="Inspect" Interactive="{Binding CanInspect}" />
              <EditorMenu ID="present-ui-49" Content="Close" Action="Close" Interactive="{Binding CanClose}" />
            </EditorMenu>
            <EditorMenu ID="present-ui-50" Content="Edit">
              <EditorMenu ID="present-ui-51" Content="Undo" Action="Undo" Interactive="{Binding CanUndo}" Shortcut="Ctrl+Z" />
              <EditorMenu ID="present-ui-52" Content="Redo" Action="Redo" Interactive="{Binding CanRedo}" Shortcut="Ctrl+Shift+Z" />
              <EditorMenu ID="present-ui-53" Content="Copy" Action="Copy" Interactive="{Binding CanCopy}" Shortcut="Ctrl+C" />
              <EditorMenu ID="present-ui-54" Content="Paste" Action="Paste" Interactive="{Binding CanPaste}" Shortcut="Ctrl+V" />
              <EditorMenu ID="present-ui-55" Content="Delete object" Action="DeleteObject" Interactive="{Binding CanEditSelection}" Shortcut="Delete" />
              <EditorMenu ID="present-ui-56" Content="Text formatting">
                <EditorMenu ID="present-ui-57" Content="Bold" Action="Bold" Interactive="{Binding CanBold}" Shortcut="Ctrl+B" />
                <EditorMenu ID="present-ui-58" Content="Italic" Action="Italic" Interactive="{Binding CanItalic}" Shortcut="Ctrl+I" />
                <EditorMenu ID="present-edit-underline" Content="Underline" Action="Underline" Interactive="{Binding CanFontSize}" Shortcut="Ctrl+U" />
                <EditorMenu ID="present-ui-59" Content="Font larger" Action="FontLarger" Interactive="{Binding CanFontSize}" />
                <EditorMenu ID="present-ui-60" Content="Font smaller" Action="FontSmaller" Interactive="{Binding CanFontSize}" />
              </EditorMenu>
            </EditorMenu>
            <EditorMenu ID="present-ui-61" Content="Insert">
              <EditorMenu ID="present-ui-62" Content="Text box" Action="AddText" Interactive="{Binding CanEdit}" />
              <PresentShapeGallery ID="present-ui-63" Interactive="{Binding CanEdit}" />
              <EditorMenu ID="present-content-editormenu-1" Content="Table" Action="AddTable" Interactive="{Binding CanEdit}" />
              <PresentChartMenu ID="present-content-presentchartmenu-1" Interactive="{Binding CanEdit}" />
              <EditorMenu ID="present-content-editormenu-2" Content="New slide" Action="AddSlide" Interactive="{Binding CanEdit}" />
            </EditorMenu>
            <EditorMenu ID="present-ui-64" Content="Slide">
              <EditorMenu ID="present-ui-65" Content="Add slide" Action="AddSlide" Interactive="{Binding CanEdit}" Shortcut="Ctrl+M" />
              <EditorMenu ID="present-ui-66" Content="Duplicate slide" Action="DuplicateSlide" Interactive="{Binding CanEdit}" />
              <EditorMenu ID="present-ui-67" Content="Delete slide" Action="DeleteSlide" Interactive="{Binding CanDeleteSlide}" />
              <EditorMenu ID="present-ui-68" Content="Move slide up" Action="SlideUp" Interactive="{Binding CanSlideUp}" />
              <EditorMenu ID="present-ui-69" Content="Move slide down" Action="SlideDown" Interactive="{Binding CanSlideDown}" />
              <EditorMenu ID="present-ui-70" Content="{Binding HideSlideLabel}" Action="ToggleHidden" Interactive="{Binding CanEdit}" />
              <EditorMenu ID="present-ui-71" Content="Previous slide" Action="PreviousSlide" Interactive="{Binding CanPreviousSlide}" />
