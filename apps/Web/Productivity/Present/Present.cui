<Cui id="present.browser" version="1">
  <Actions>
    <Action name="OpenSavedPresentation" command="Open" parameter="{Binding saved}" />
    <Action name="OpenStartPresentation" command="Open" parameter="{Binding recent}" />
    <Action name="SelectPresentationSlide" command="SelectSlide" parameter="{Binding slide}" />
  </Actions>
  <Theme Name="user_preference">
    <Page>
      <Container ID="present-views" Type="Overlay" Background="{Resource CuiBackgroundBrush}">
        <Container ID="present-start" Type="Overlay" Active="{Binding ShowStart}" VerticalScrolling="True">
          <Container Type="Vertical Stack" CellGap="24" Padding="32" MaxWidth="1000" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Button Content="Home" Action="ShellHome" HorizontalAlignment="Left" />
            <Container Type="Vertical Stack" CellGap="8">
              <Text Text="Present" FontSize="32" FontWeight="SemiBold" />
              <Text Text="Give your next story a place to start." FontSize="18" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            </Container>
            <Container Type="Wrap" CellGap="12">
              <Button Content="New presentation" Action="Create" Interactive="{Binding CanCreate}" Padding="22,16" />
              <Button Content="Import .pptx" Action="ImportPowerPoint" Interactive="{Binding CanImportPowerPoint}" Padding="22,16" />
            </Container>
            <Container Type="Vertical Stack" CellGap="10" Active="{Binding HasDocument}" Background="{Resource CuiPanelBrush}" Padding="20" CornerRadius="8">
              <Text Text="Continue working" FontSize="18" FontWeight="SemiBold" />
              <Text Text="{Binding StartStatus}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              <Button Content="Resume presentation" Action="ResumePresentation" Interactive="{Binding CanResume}" HorizontalAlignment="Left" />
            </Container>
            <Container Type="Vertical Stack" CellGap="12">
              <Container Type="Grid" ColumnSizes="1fr Auto">
                <Text Text="Recent presentations" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="Refresh" Action="Refresh" Interactive="{Binding CanBrowse}" Column="1" />
              </Container>
              <Text Text="Saved in this browser" Foreground="{Resource CuiTextSoftBrush}" />
              <Container Type="Overlay" Active="{Binding NoSavedDocuments}" Background="{Resource CuiPanelBrush}" Padding="20" CornerRadius="8">
                <Text Text="Create a presentation, or import an existing PowerPoint file." TextWrapping="Wrap" />
              </Container>
              <Repeat Source="{Binding Documents}" As="recent" Key="{Binding recent.Id}">
                <Container Type="Vertical Stack" CellGap="6" Margin="0,0,0,12">
                  <Button Content="{Binding recent.Title}" Action="OpenStartPresentation" Interactive="{Binding CanBrowse}" HorizontalAlignment="Stretch" Padding="16,12" />
                  <Text Text="{Binding recent.LocationAndModified}" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                </Container>
              </Repeat>
              <Text Text="{Binding Status}" TextWrapping="Wrap" />
              <Container Type="Overlay" Active="{Binding HasUnknownCommitOutcome}">
                <Button Content="Inspect saved state" Action="Inspect" Interactive="{Binding CanInspect}" />
              </Container>
            </Container>
          </Container>
        </Container>
      <Container ID="present-workspace" Active="{Binding ShowWorkspace}" background="{Resource CuiBackgroundBrush}" Type="Grid" RowSizes="Auto Auto 1fr Auto">
        <Container background="{Resource CuiPanelBrush}" padding="16,10" Type="Overlay">
          <Container Type="Grid" ColumnSizes="Auto Auto 1fr Auto" RowSizes="Auto Auto">
            <Button Content="Home" Action="ShellHome" Margin="0,0,8,0" />
            <Container Column="1" margin="0,0,14,0" vertical-alignment="Center" Type="Menu">
              <Button accessible-name="Presentation file menu" Type="Menu Item" Content="Present">
                <Button action="ReturnToStart" Type="Menu Item" Content="Back to Present start" />
                <Button action="Create" Type="Menu Item" Content="New presentation" Interactive="{Binding CanCreate}" />
                <Button action="ToggleFiles" Type="Menu Item" Content="Open presentations" />
                <Button action="Save" Type="Menu Item" Content="Save" Interactive="{Binding CanSave}" />
                <Button action="Close" Type="Menu Item" Content="Close" Interactive="{Binding CanClose}" />
                <Button Type="Menu Item" Content="Export .pptx" Action="ExportPowerPoint" Interactive="{Binding CanExportPowerPoint}" />
                <Button Type="Menu Item" Content="Import .pptx" Action="ImportPowerPoint" Interactive="{Binding CanImportPowerPoint}" />
              </Button>
            </Container>
            <Input accessible-name="Presentation title" max-width="480" horizontal-alignment="Left" Type="Text" Column="2" Value="{Binding Title, mode=TwoWay}" Interactive="{Binding CanEdit}" />
            <Button content="Save" action="Save" margin="12,0,0,0" Column="3" Interactive="{Binding CanSave}" />
            <Container margin="0,5,0,0" Type="Overlay" Row="1" ColumnSpan="4" HorizontalScrolling="True" VerticalScrolling="False">
              <Container Type="Menu">
                <Button Type="Menu Item" Content="Edit">
                  <Button action="Undo" Type="Menu Item" Content="Undo" Interactive="{Binding CanUndo}" />
                  <Button action="Redo" Type="Menu Item" Content="Redo" Interactive="{Binding CanRedo}" />
                </Button>
                <Button Type="Menu Item" Content="Insert">
                  <Button action="AddText" Type="Menu Item" Content="Text box" Interactive="{Binding CanEdit}" />
                  <Button action="AddShape" Type="Menu Item" Content="Shape" Interactive="{Binding CanEdit}" />
                </Button>
                <Button Type="Menu Item" Content="Slide">
                  <Button action="AddSlide" Type="Menu Item" Content="Add slide" Interactive="{Binding CanEdit}" />
                  <Button action="DuplicateSlide" Type="Menu Item" Content="Duplicate slide" Interactive="{Binding CanEdit}" />
                  <Button action="SlideUp" Type="Menu Item" Content="Move slide up" Interactive="{Binding CanSlideUp}" />
                  <Button action="SlideDown" Type="Menu Item" Content="Move slide down" Interactive="{Binding CanSlideDown}" />
                  <Button action="ToggleHidden" Type="Menu Item" Content="{Binding HideSlideLabel}" Interactive="{Binding CanEdit}" />
                  <Button action="DeleteSlide" Type="Menu Item" Content="Delete slide" Interactive="{Binding CanDeleteSlide}" />
                </Button>
                <Button Type="Menu Item" Content="Arrange">
                  <Button action="BringForward" Type="Menu Item" Content="Bring forward" Interactive="{Binding CanEditSelection}" />
                  <Button action="SendBackward" Type="Menu Item" Content="Send backward" Interactive="{Binding CanEditSelection}" />
                  <Button action="RotateObject" Type="Menu Item" Content="Rotate 90°" Interactive="{Binding CanEditSelection}" />
                  <Button action="DeleteObject" Type="Menu Item" Content="Delete object" Interactive="{Binding CanEditSelection}" />
                </Button>
                <Button Type="Menu Item" Content="View">
                  <Button action="ToggleSidebar" Type="Menu Item" Content="Show / hide slides" />
                </Button>
              </Container>
            </Container>
          </Container>
        </Container>
        <Container background="{Resource CuiPanel2Brush}" padding="10,6" margin="12,8" corner-radius="8" Type="Overlay" Row="1">
          <Container Type="Overlay">
            <Container Type="Wrap" CellGap="6">
              <Button content="Slides" action="ToggleSidebar" />
              <Button content="Add slide" action="AddSlide" Interactive="{Binding CanEdit}" />
              <Button content="Duplicate slide" action="DuplicateSlide" margin="0,0,12,0" Interactive="{Binding CanEdit}" />
              <Button content="Undo" action="Undo" Interactive="{Binding CanUndo}" />
              <Button content="Redo" action="Redo" margin="0,0,12,0" Interactive="{Binding CanRedo}" />
              <Button content="Text" action="AddText" Interactive="{Binding CanEdit}" />
              <Button content="Shape" action="AddShape" Interactive="{Binding CanEdit}" />
              <Button Content="Properties" Action="ToggleInspector" AccessibleName="Presentation properties" />
              <Button Content="Present" Action="Present" Interactive="{Binding CanPresent}" />
            </Container>
          </Container>
        </Container>
        <Container background="{Resource CuiPanelBrush}" padding="16,8" Type="Overlay" Row="3">
          <Container Type="Vertical Stack" CellGap="4">
            <If Condition="{Binding IsPlaying}">
              <Container Type="Vertical Stack">
                <Text text="{Binding PlayStatus}" accessible-name="Playback status" text-wrapping="Wrap" />
                <Container Type="Wrap">
                  <Button content="Previous slide" action="PlayPrevious" Interactive="{Binding CanPlayPrevious}" />
                  <Button content="Next slide" action="Advance" Interactive="{Binding CanAdvance}" />
                  <Button content="End presentation" action="ExitPresentation" Interactive="{Binding CanExitPresentation}" />
                </Container>
              </Container>
            </If>
            <Container Type="Grid" ColumnSizes="Auto 1fr Auto">
              <Text text="{Binding SlideStatus}" accessible-name="Current slide" vertical-alignment="Center" />
              <Text text="{Binding SelectionStatus}" foreground="{Resource CuiTextSoftBrush}" margin="18,0" vertical-alignment="Center" text-wrapping="Wrap" Column="1" />
              <Container Type="Horizontal Stack" Column="2" CellGap="6">
                <Button content="‹" accessible-name="Previous slide" action="PreviousSlide" Interactive="{Binding CanPreviousSlide}" />
                <Button content="›" accessible-name="Next slide" action="NextSlide" Interactive="{Binding CanNextSlide}" />
              </Container>
            </Container>
            <Text text="{Binding Status}" accessible-name="Presentation save status" text-wrapping="Wrap" />
            <Container Type="Overlay" Active="{Binding HasUnknownCommitOutcome}">
              <Button content="Inspect saved state" action="Inspect" Interactive="{Binding CanInspect}" />
            </Container>
          </Container>
        </Container>
        <Container Type="Grid" Row="2" ColumnSizes="{Binding InspectorColumns}">
          <Container Type="Grid" ColumnSizes="{Binding WorkspaceColumns}" Row="0" Active="{Binding ShowEditingArea}">
            <Container margin="16,4,16,12" Type="Grid" Column="1" RowSizes="1fr Auto">
              <Container Type="Grid">
                <Object Type="PresentSlideCanvas" />
              </Container>
              <Container background="{Resource CuiPanelBrush}" padding="12" corner-radius="8" margin="0,12,0,0" Type="Overlay" Row="1">
                <Container Type="Grid" RowSizes="Auto Auto">
                  <Text text="Speaker notes" foreground="{Resource CuiTextSoftBrush}" font-weight="SemiBold" margin="0,0,0,6" />
                  <Input min-height="58" max-height="150" accessible-name="Speaker notes" Type="Text" Row="1" Value="{Binding SpeakerNotes, mode=TwoWay}" Interactive="{Binding CanEdit}" Multiline="True" />
                </Container>
              </Container>
            </Container>
            <Container Type="Overlay" Active="{Binding ShowSidebar}" ColumnSpan="{Binding SidebarColumnSpan}">
              <Container width="224" background="{Resource CuiPanelBrush}" padding="12" horizontal-alignment="Left" Type="Overlay">
                <Container Type="Grid" RowSizes="Auto 1fr">
                  <Container margin="0,0,0,12" Type="Vertical Stack" CellGap="8">
                    <Container Type="Grid" ColumnSizes="1fr Auto">
                      <Text text="Slides" font-weight="SemiBold" vertical-alignment="Center" />
                      <Button content="×" accessible-name="Close slides" action="ToggleSidebar" Column="1" />
                    </Container>
                    <Button content="Presentations / Slides" action="ToggleFiles" />
                  </Container>
                  <Container Type="Grid" Row="1">
                    <Container Type="Overlay" Active="{Binding ShowSlides}">
                      <Container Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
                        <Object Type="PresentThumbnails" />
                      </Container>
                    </Container>
                    <Container Type="Overlay" Active="{Binding ShowFiles}">
                      <Container Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
                        <Container Type="Vertical Stack" CellGap="8">
                          <Text text="Saved in this browser" foreground="{Resource CuiTextSoftBrush}" text-wrapping="Wrap" />
                          <Button id="present-create-library" content="New presentation" action="Create" Interactive="{Binding CanCreate}" />
                          <Button content="Refresh presentations" action="Refresh" Interactive="{Binding CanBrowse}" />
                          <Repeat Source="{Binding Documents}" As="saved" Key="{Binding saved.Id}">
                            <Button content="{Binding saved.Title}" action="OpenSavedPresentation" Interactive="{Binding CanBrowse}" />
                          </Repeat>
                        </Container>
                      </Container>
                    </Container>
                  </Container>
                </Container>
              </Container>
            </Container>
          </Container>
          <Container ID="present-inspector" Type="Grid" Column="1" RowSizes="Auto 1fr" Active="{Binding ShowInspector}" Background="{Resource CuiPanelBrush}" Padding="16" MaxWidth="340">
            <Container Type="Grid" ColumnSizes="1fr Auto" Margin="0,0,0,12">
              <Text Text="Properties" FontSize="18" FontWeight="SemiBold" />
              <Button Content="Close" AccessibleName="Close properties" Action="ToggleInspector" Column="1" />
            </Container>
            <Container Type="Overlay" Row="1" VerticalScrolling="True" HorizontalScrolling="False">
              <Container Type="Vertical Stack" CellGap="18">
                <Container Type="Vertical Stack" CellGap="8" Active="{Binding HasTextSelection}">
                  <Text text="Selected text" />
                  <Input accessible-name="Selected object text" Type="Text" Value="{Binding SelectedText, mode=TwoWay}" Interactive="{Binding CanEditSelection}" />
                </Container>
                <Container Type="Vertical Stack" CellGap="8">
                  <Text Text="Slide and objects" FontWeight="SemiBold" />
                  <Container Type="Wrap">
                    <Button content="Export .pptx" action="ExportPowerPoint" Interactive="{Binding CanExportPowerPoint}" />
                    <Button content="Import .pptx" action="ImportPowerPoint" Interactive="{Binding CanImportPowerPoint}" />
                    <Button content="Move slide earlier" action="MoveSlideEarlier" Interactive="{Binding CanMoveSlideEarlier}" />
                    <Button content="Move slide later" action="MoveSlideLater" Interactive="{Binding CanMoveSlideLater}" />
                    <Button content="Delete element" action="DeleteElement" Interactive="{Binding CanDeleteElement}" />
                    <Button content="Bring to front" action="BringToFront" Interactive="{Binding CanBringToFront}" />
                    <Button content="Send to back" action="SendToBack" Interactive="{Binding CanSendToBack}" />
                    <Button content="Present" action="Present" Interactive="{Binding CanPresent}" />
                  </Container>
                </Container>
                <Container Type="Vertical Stack" CellGap="8">
                  <Text Text="Transform" FontWeight="SemiBold" />
                  <Container Type="Wrap">
                    <Button content="Bold" action="Bold" Interactive="{Binding CanBold}" />
                    <Button content="Italic" action="Italic" Interactive="{Binding CanItalic}" />
                    <Button content="Grow" action="Grow" Interactive="{Binding CanTransformObject}" />
                    <Button content="Shrink" action="Shrink" Interactive="{Binding CanTransformObject}" />
                    <Button content="Rotate left" action="RotateLeft" Interactive="{Binding CanTransformObject}" />
                    <Button content="Rotate right" action="RotateRight" Interactive="{Binding CanTransformObject}" />
                    <Button content="Copy" action="Copy" Interactive="{Binding CanCopy}" />
                    <Button content="Paste" action="Paste" Interactive="{Binding CanPaste}" />
                    <Button content="Move object left" action="MoveObjectLeft" Interactive="{Binding CanMoveObject}" />
                    <Button content="Move object right" action="MoveObjectRight" Interactive="{Binding CanMoveObject}" />
                    <Button content="Move object up" action="MoveObjectUp" Interactive="{Binding CanMoveObject}" />
                    <Button content="Move object down" action="MoveObjectDown" Interactive="{Binding CanMoveObject}" />
                  </Container>
                </Container>
                <Container Type="Vertical Stack" CellGap="8">
                  <Text Text="Arrange" FontWeight="SemiBold" />
                  <Container Type="Wrap">
                    <Button content="Align left" action="AlignLeft" Interactive="{Binding CanAlign}" />
                    <Button content="Align center" action="AlignCenter" Interactive="{Binding CanAlign}" />
                    <Button content="Align top" action="AlignTop" Interactive="{Binding CanAlign}" />
                    <Button content="Align middle" action="AlignMiddle" Interactive="{Binding CanAlign}" />
                    <Button content="Distribute horizontally" action="DistributeHorizontal" Interactive="{Binding CanDistribute}" />
                    <Button content="Distribute vertically" action="DistributeVertical" Interactive="{Binding CanDistribute}" />
                    <Button content="Group" action="Group" Interactive="{Binding CanGroup}" />
                    <Button content="Ungroup" action="Ungroup" Interactive="{Binding CanUngroup}" />
                  </Container>
                </Container>
                <Container Type="Vertical Stack" CellGap="8">
                  <Text Text="Appearance" FontWeight="SemiBold" />
                  <Container Type="Vertical Stack">
                    <Input accessible-name="Fill color" Type="Text" Value="{Binding FillColor, Mode=TwoWay}" Interactive="{Binding CanApplyFill}" HorizontalAlignment="Stretch" />
                    <Button content="Apply fill" action="ApplyFill" Interactive="{Binding CanApplyFill}" />
                    <Input accessible-name="Stroke color" Type="Text" Value="{Binding StrokeColor, Mode=TwoWay}" Interactive="{Binding CanApplyStroke}" HorizontalAlignment="Stretch" />
                    <Button content="Apply stroke" action="ApplyStroke" Interactive="{Binding CanApplyStroke}" />
                    <Input accessible-name="Stroke width" Type="Text" Value="{Binding StrokeWidth, Mode=TwoWay}" Interactive="{Binding CanApplyStrokeWidth}" HorizontalAlignment="Stretch" />
                    <Button content="Apply stroke width" action="ApplyStrokeWidth" Interactive="{Binding CanApplyStrokeWidth}" />
                    <Button content="Font larger" action="FontLarger" Interactive="{Binding CanFontSize}" />
                    <Button content="Font smaller" action="FontSmaller" Interactive="{Binding CanFontSize}" />
                  </Container>
                </Container>
                <Container Type="Vertical Stack" CellGap="8">
                  <Text Text="Transition and animation" FontWeight="SemiBold" />
                  <Container Type="Vertical Stack">
                    <Input accessible-name="Transition kind for the current slide" Type="Text" Value="{Binding TransitionKind, Mode=TwoWay}" Interactive="{Binding CanApplyTransition}" HorizontalAlignment="Stretch" />
                    <Input accessible-name="Transition duration in seconds" Type="Text" Value="{Binding TransitionDuration, Mode=TwoWay}" Interactive="{Binding CanApplyTransition}" HorizontalAlignment="Stretch" />
                    <Button content="Apply transition" action="ApplyTransition" Interactive="{Binding CanApplyTransition}" />
                    <Input accessible-name="Animation effect for the selected object" Type="Text" Value="{Binding AnimationEffect, Mode=TwoWay}" Interactive="{Binding CanAddAnimation}" HorizontalAlignment="Stretch" />
                    <Input accessible-name="Animation trigger for the selected object" Type="Text" Value="{Binding AnimationTrigger, Mode=TwoWay}" Interactive="{Binding CanAddAnimation}" HorizontalAlignment="Stretch" />
                    <Button content="Add animation" action="AddAnimation" Interactive="{Binding CanAddAnimation}" />
                    <Button content="Remove animation" action="RemoveAnimation" Interactive="{Binding CanRemoveAnimation}" />
                  </Container>
                  <Repeat Source="{Binding AnimationSteps}" As="cue" Key="{Binding cue.Id}">
                    <Text text="{Binding cue.Effect}" accessible-name="Animation cue effect" text-wrapping="Wrap" />
                    <Text text="{Binding cue.Trigger}" accessible-name="Animation cue trigger" text-wrapping="Wrap" />
                  </Repeat>
                </Container>
                <Container Type="Vertical Stack" CellGap="8">
                  <Text Text="Visibility" FontWeight="SemiBold" />
                  <Container Type="Wrap">
                    <Button content="Hide slide" action="HideSlide" Interactive="{Binding CanHideSlide}" />
                    <Button content="Show slide" action="ShowSlide" Interactive="{Binding CanShowSlide}" />
                  </Container>
                </Container>
                <Container Type="Vertical Stack" CellGap="6">
                  <Text Text="Go to slide" FontWeight="SemiBold" />
                  <Repeat Source="{Binding Slides}" As="slide" Key="{Binding slide.Id}">
                    <Button Content="{Binding slide.Title}" Action="SelectPresentationSlide" Interactive="{Binding CanBrowse}" />
                  </Repeat>
                </Container>
              </Container>
            </Container>
          </Container>
        </Container>
      </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
