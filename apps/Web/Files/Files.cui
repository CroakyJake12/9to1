<Cui id="files.browser" version="1">
  <Import Source="framework/CUI/Components/App.cui" />
  <Actions>
    <Action name="SelectItem" command="Select" parameter="{Binding item}" />
  </Actions>
  <Page>
    <Container margin="16" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False">
      <Container Type="Grid" ColumnSizes="1fr Auto">
        <Text text="Files" font-size="28" />
        <AppAccentMenu ID="files-app-accent" Column="1" />
      </Container>
      <Text text="{Binding FolderName}" font-size="20" margin="0,8" />
      <Text text="{Binding Status}" text-wrapping="Wrap" accessible-name="Files status" margin="0,8" />
      <Container Type="Wrap">
        <Button content="Files root" action="Home" Interactive="{Binding CanBrowse}" />
        <Button content="Back" action="Back" Interactive="{Binding CanBack}" />
        <Button content="Forward" action="Forward" Interactive="{Binding CanForward}" />
        <Button content="Up" action="Up" Interactive="{Binding CanUp}" />
        <Button content="Refresh" action="Refresh" Interactive="{Binding CanBrowse}" />
        <Button content="New folder" action="NewFolder" Interactive="{Binding CanCreate}" />
        <Button content="Open selected folder" action="Open" Interactive="{Binding CanOpen}" />
        <Button content="Rename" action="Rename" Interactive="{Binding CanRename}" />
      </Container>
      <Container Type="Wrap" margin="0,8">
        <Input id="files-search" accessible-name="Search names in this folder" Type="Text" Value="{Binding SearchText, Mode=TwoWay}" Interactive="{Binding CanSearch}" />
        <Button content="Search folder" action="Search" Interactive="{Binding CanSearch}" />
        <Button content="Clear search" action="ClearSearch" Interactive="{Binding CanClearSearch}" />
      </Container>
      <Text text="{Binding SearchSummary}" text-wrapping="Wrap" />
      <Container Type="Wrap" margin="0,8">
        <Text text="{Binding SortDescription}" />
        <Button content="Name A–Z" action="SortNameAscending" Interactive="{Binding CanBrowse}" />
        <Button content="Name Z–A" action="SortNameDescending" Interactive="{Binding CanBrowse}" />
        <Button content="Newest" action="SortNewest" Interactive="{Binding CanBrowse}" />
      </Container>
      <If Condition="{Binding Editing}">
        <Container margin="0,12" Type="Vertical Stack">
          <Text text="{Binding EditTitle}" font-size="18" />
          <Input id="files-name" accessible-name="Folder or item name" Type="Text" Value="{Binding Name, Mode=TwoWay}" Interactive="{Binding CanEditName}" />
          <Container Type="Wrap">
            <Button content="Save" action="Save" Interactive="{Binding CanSave}" />
            <Button content="Cancel" action="Cancel" Interactive="{Binding CanCancel}" />
          </Container>
        </Container>
      </If>
      <If Condition="{Binding Empty}">
        <Text text="{Binding EmptyMessage}" margin="0,12" />
      </If>
      <Repeat Source="{Binding Items}" As="item" Key="{Binding item.Id}">
        <Container margin="0,8" Type="Vertical Stack">
          <Button content="{Binding item.Name}" action="SelectItem" horizontal-alignment="Stretch" Interactive="{Binding CanBrowse}" />
          <Text text="{Binding item.Details}" text-wrapping="Wrap" />
        </Container>
      </Repeat>
      <Button content="Load more items" action="More" Interactive="{Binding CanMore}" />
      <Text text="Selection" font-size="18" margin="0,16,0,4" />
      <Text text="{Binding SelectedName}" text-wrapping="Wrap" />
      <Text text="{Binding SelectedDetails}" text-wrapping="Wrap" />
    </Container>
  </Page>
</Cui>
