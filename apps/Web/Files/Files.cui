<Cui id="files.browser" version="1">
  <Import Source="framework/CUI/Components/App.cui" />
  <Actions>
    <Action name="SelectItem" command="Select" parameter="{Binding item}" />
  </Actions>
  <Page>
    <Container id="files-root" padding="16" background="{Resource CuiBackgroundBrush}" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False">
      <Container Type="Grid" ColumnSizes="1fr Auto">
        <Text text="Files" font-size="28" />
        <AppAccentMenu ID="files-app-accent" Column="1" />
      </Container>
      <Text text="{Binding Status}" text-wrapping="Wrap" accessible-name="Files status" margin="0,8" />
      <If Condition="{Binding ShowDriveConnection}">
        <Container Type="Vertical Stack" margin="0,0,0,12">
          <Text text="{Binding DriveConnection}" text-wrapping="Wrap" />
          <If Condition="{Binding DriveDisconnected}">
            <Text text="Files needs full Google Drive permission to show your existing files. It reads file names and details and streams selected uploads and downloads through Cloudflare. 9to1 keeps the connection encrypted and retains a private file index and records to recover interrupted actions. Files data is never used for AI or ads."
              text-wrapping="Wrap" margin="0,8" />
          </If>
          <Container Type="Wrap">
            <If Condition="{Binding DriveDisconnected}">
              <Button content="Connect Google Drive" action="ConnectDrive" Interactive="{Binding CanConnect}" />
            </If>
            <If Condition="{Binding DriveConnected}">
              <Button content="Disconnect Google Drive" action="DisconnectDrive" Interactive="{Binding CanDisconnect}" />
            </If>
            <Button content="Refresh connection" action="RefreshDriveConnection" Interactive="{Binding CanRefreshConnection}" />
            <Button content="Files privacy" action="OpenFilesPrivacy" Interactive="{Binding CanOpenFilesPrivacy}" />
          </Container>
          <Text text="Drive allowance" font-size="18" margin="0,8,0,0" />
          <Text text="{Binding UsageSummary}" text-wrapping="Wrap" />
          <Button content="Refresh allowance" action="RefreshDriveUsage" Interactive="{Binding CanRefreshUsage}"
            HorizontalAlignment="Left" margin="0,8,0,0" />
        </Container>
      </If>
      <If Condition="{Binding ShowBrowser}">
        <Container Type="Vertical Stack">
          <Text text="{Binding Breadcrumb}" font-size="20" margin="0,8" accessible-name="Current location" text-wrapping="Wrap" />
          <Container Type="Wrap">
            <Button content="Files root" action="Home" Interactive="{Binding CanBrowse}" />
            <Button content="Back" action="Back" Interactive="{Binding CanBack}" />
            <Button content="Forward" action="Forward" Interactive="{Binding CanForward}" />
            <Button content="Up" action="Up" Interactive="{Binding CanUp}" />
            <Button content="Refresh" action="Refresh" Interactive="{Binding CanBrowse}" />
            <Button content="New folder" action="NewFolder" Interactive="{Binding CanCreate}" />
            <Button content="Open selected folder" action="Open" Interactive="{Binding CanOpen}" />
            <Button content="Rename" action="Rename" Interactive="{Binding CanRename}" />
            <If Condition="{Binding ShowUpload}">
              <Button content="Upload file…" action="Upload" Interactive="{Binding CanUpload}" />
            </If>
            <If Condition="{Binding ShowMove}">
              <Button content="Move…" action="Move" Interactive="{Binding CanMove}" />
            </If>
            <If Condition="{Binding ShowTrashEntry}">
              <Container Type="Wrap">
                <Button content="Move to Trash…" action="Trash" Interactive="{Binding CanTrash}" />
                <Button content="Trash" action="ShowTrash" Interactive="{Binding CanEnterTrash}" />
              </Container>
            </If>
            <If Condition="{Binding InTrash}">
              <Container Type="Wrap">
                <Button content="Restore…" action="Restore" Interactive="{Binding CanRestore}" />
                <Button content="Back to files" action="ExitTrash" Interactive="{Binding CanExitTrash}" />
              </Container>
            </If>
          </Container>
          <If Condition="{Binding UploadPending}">
            <Container Type="Vertical Stack" margin="0,8">
              <Text text="{Binding UploadSummary}" text-wrapping="Wrap" />
              <Container Type="Wrap">
                <If Condition="{Binding ShowUploadRunning}">
                  <Button content="Pause upload" action="PauseUpload" Interactive="{Binding CanPauseUpload}" />
                </If>
                <If Condition="{Binding ShowUploadRecovery}">
                  <Container Type="Wrap">
                    <Button content="Resume upload" action="ResumeUpload" Interactive="{Binding CanResumeUpload}" />
                    <Button content="Cancel upload" action="CancelUpload" Interactive="{Binding CanCancelUpload}" />
                  </Container>
                </If>
              </Container>
            </Container>
          </If>
          <If Condition="{Binding ShowFolderSearch}">
            <Container Type="Vertical Stack">
              <Container Type="Wrap" margin="0,8">
                <Input id="files-search" accessible-name="Search names in this folder" Type="Text" Value="{Binding SearchText, Mode=TwoWay}" Interactive="{Binding CanSearch}" />
                <Button content="Search folder" action="Search" Interactive="{Binding CanSearch}" />
                <Button content="Clear search" action="ClearSearch" Interactive="{Binding CanClearSearch}" />
              </Container>
              <Text text="{Binding SearchSummary}" text-wrapping="Wrap" />
            </Container>
          </If>
          <If Condition="{Binding ChoosingMoveDestination}">
            <Container margin="0,12" Type="Vertical Stack">
              <Text text="{Binding MovePrompt}" text-wrapping="Wrap" />
              <Container Type="Wrap">
                <Button content="Move here…" action="MoveHere" Interactive="{Binding CanMoveHere}" />
                <Button content="Cancel move" action="CancelMove" Interactive="{Binding CanCancelMove}" />
              </Container>
            </Container>
          </If>
          <Container Type="Wrap" margin="0,8">
            <Text text="{Binding SortDescription}" />
            <Button content="Name A–Z" action="SortNameAscending" Interactive="{Binding CanBrowse}" />
            <Button content="Name Z–A" action="SortNameDescending" Interactive="{Binding CanBrowse}" />
            <Button content="Newest" action="SortNewest" Interactive="{Binding CanBrowse}" />
          </Container>
          <If Condition="{Binding Editing}">
            <Container margin="0,12" Type="Vertical Stack">
              <Text text="{Binding EditTitle}" font-size="18" />
              <If Condition="{Binding EditingName}">
                <Input id="files-name" accessible-name="Folder or item name" Type="Text" Value="{Binding Name, Mode=TwoWay}" Interactive="{Binding CanEditName}" />
              </If>
              <If Condition="{Binding ShowEditNotice}">
                <Text text="{Binding EditNotice}" text-wrapping="Wrap" />
              </If>
              <Container Type="Wrap">
                <Button content="{Binding SaveLabel}" action="Save" Interactive="{Binding CanSave}" />
                <Button content="Cancel" action="Cancel" Interactive="{Binding CanCancel}" />
              </Container>
            </Container>
          </If>
          <If Condition="{Binding Empty}">
            <Text text="{Binding EmptyMessage}" margin="0,12" />
          </If>
          <Repeat Source="{Binding Items}" As="item" Key="{Binding item.Id}">
            <Container margin="0,8" Type="Vertical Stack">
              <Button content="{Binding item.Name}" action="SelectItem" horizontal-alignment="Stretch" Interactive="{Binding CanBrowse}" />
              <Text text="{Binding item.Details}" text-wrapping="Wrap" />
            </Container>
          </Repeat>
          <Button content="Load more items" action="More" Interactive="{Binding CanMore}" />
          <Text text="Selection" font-size="18" margin="0,16,0,4" />
          <Text text="{Binding SelectedName}" text-wrapping="Wrap" />
          <Text text="{Binding SelectedDetails}" text-wrapping="Wrap" />
          <If Condition="{Binding ShowDownload}">
            <Container Type="Wrap" margin="0,8">
              <Button content="{Binding DownloadLabel}" action="PrepareDownload" Interactive="{Binding CanPrepareDownload}" />
              <If Condition="{Binding DownloadPrepared}">
                <Button content="Save download" action="SaveDownload" Interactive="{Binding CanSaveDownload}" />
              </If>
            </Container>
          </If>
        </Container>
      </If>
    </Container>
  </Page>
</Cui>
