<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTestProject>true</IsTestProject>
    <NineToOneRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</NineToOneRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(NineToOneRoot)/9to1 Workspace/Sites/Domain/*.cs" />
    <Compile Include="$(NineToOneRoot)/9to1 Workspace/Sites/Infrastructure/*.cs" />
    <Compile Include="$(NineToOneRoot)/9to1 Workspace/Sites/Application/*.cs" />
    <Compile Include="$(NineToOneRoot)/9to1 Workspace/Sites/Hosting/*.cs" />
    <Compile Include="$(NineToOneRoot)/9to1 Workspace/Sites/Tests/*.cs" />
    <Compile Include="$(NineToOneRoot)/9to1 Workspace/shared/src/Haven.Application/Abstractions.cs" />
    <Compile Include="$(NineToOneRoot)/9to1 Workspace/shared/src/Haven.Application/ModelProviderAbstractions.cs" />
    <Compile Include="$(NineToOneRoot)/9to1 Workspace/shared/src/Haven.Application/Modes/ExecutionTypes.cs" />
    <ProjectReference Include="$(NineToOneRoot)/9to1 Workspace/shared/src/Haven.Core/Haven.Core.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
