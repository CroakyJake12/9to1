{
  "schema": 1,
  "checks": {
    "workflow": {
      "layer": 1,
      "paths": ["eng/development/**", "AGENTS.md", "docs/development/**", ".github/workflows/development-infrastructure.yml"],
      "command": ["python3", "-B", "-m", "unittest", "discover", "-s", "eng/development", "-p", "test_workflow.py", "-v"],
      "depends_on": []
    },
    "installer-delivery": {
      "layer": 1,
      "paths": ["eng/release-delivery/**", "docs/development/installer-delivery.md", "eng/development/checks.json", ".github/workflows/development-infrastructure.yml", ".github/workflows/havenos-linux-package.yml"],
      "command": ["python3", "-B", "-m", "unittest", "discover", "-s", "eng/release-delivery", "-p", "test_installer_delivery.py", "-v"],
      "depends_on": ["workflow"]
    },
    "cui": {
      "layer": 1,
      "paths": ["framework/**", "eng/cui/**"],
      "command": ["pwsh", "-File", "eng/9to1.ps1", "test", "-Component", "cui"],
      "depends_on": ["workflow"]
    },
    "home": {
      "layer": 2,
      "paths": ["9to1 Workspace/Home/**", "9to1 Workspace/Browse/**", "framework/**"],
      "command": ["pwsh", "-File", "eng/9to1.ps1", "test", "-Component", "home"],
      "depends_on": ["cui"]
    },
    "spaces": {
      "layer": 2,
      "paths": ["9to1 Workspace/Spaces/**", "9to1 Workspace/Home/**", "9to1 Workspace/Browse/**", "framework/**"],
      "command": ["pwsh", "-File", "eng/9to1.ps1", "test", "-Component", "spaces"],
      "depends_on": ["home"]
    }
  },
  "limits": [
    "Selectors cover the existing root build entrypoint, not the full product manifest.",
    "Unmapped source/config/dependency changes select all registered checks and require owning checks from the acceptance manifest.",
    "Shared CUI/Home inputs intentionally select dependent checks. Release mode always retains all mandatory specification gates.",
    "Commands are plans. Honour the actual guarded dotnet entrypoint and coordinator's one-heavy-build allocation before execution."
  ]
}
