{
  "$schema": "https://opencode.ai/config.json",
  "model": "homepc/strata-dynamic#high",
  "default_agent": "build",
  "agents": {
    "build": {
      "model": "homepc/strata-dynamic#high",
      "permissions": [
        {
          "action": "task",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "agent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "title": {
      "disabled": true
    },
    "summary": {
      "model": "homepc/strata-dynamic#high"
    },
    "compaction": {
      "model": "homepc/strata-dynamic#high"
    }
  }
}
