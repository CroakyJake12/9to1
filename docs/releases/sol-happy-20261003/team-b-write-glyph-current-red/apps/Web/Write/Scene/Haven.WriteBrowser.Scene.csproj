<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Browser-only retained-source assembly preserves the original font asset URI.
         It must never coexist with the Desktop/Android executable assembly Haven. -->
    <AssemblyName>Haven</AssemblyName>
    <RootNamespace>NineToOne.Web.Write</RootNamespace>
    <WriteOwnerRoot>$(MSBuildThisFileDirectory)../../../../9to1 Workspace/shared/src</WriteOwnerRoot>
    <WriteOwnerThemeSha256>54e479254465e596f864215cb1a80b0d35d770bf92b406230cb81efdf251a12b</WriteOwnerThemeSha256>
  </PropertyGroup>
  <ItemGroup>
    <!-- Original scene consumes this existing pinned ClipboardExtensions API. -->
    <Using Include="Avalonia.Input.Platform" />
    <Compile Include="WriteRetainedSceneControl.cs" />
    <Compile Include="WriteRetainedSceneResources.cs" />
    <Compile Include="$(WriteOwnerRoot)/Haven.Desktop/Controls/AcrylicSurface.cs" Link="Owner/AcrylicSurface.cs" />
    <Compile Include="$(WriteOwnerRoot)/Haven.Desktop/Views/Pages/Write/WriteDocumentSurface*.cs" Link="Owner/Write/%(Filename)%(Extension)" />
    <Compile Include="$(WriteOwnerRoot)/Haven.Desktop/HavenUI/Backend/HavenSceneControl.cs;$(WriteOwnerRoot)/Haven.Desktop/HavenUI/Backend/HavenSceneAutomationPeer.cs;$(WriteOwnerRoot)/Haven.Desktop/HavenUI/Backend/HavenInteractiveAutomationPeers.cs;$(WriteOwnerRoot)/Haven.Desktop/HavenUI/Backend/HavenSelectItemAutomationPeer.cs;$(WriteOwnerRoot)/Haven.Desktop/HavenUI/Backend/HavenTabAutomationPeers.cs;$(WriteOwnerRoot)/Haven.Desktop/HavenUI/Backend/HavenAvaloniaThemeResolver.cs;$(WriteOwnerRoot)/Haven.Desktop/HavenUI/Backend/HavenAvaloniaImageResolver.cs;$(WriteOwnerRoot)/Haven.Desktop/HavenUI/Backend/HavenDesktopImageResolver.cs;$(WriteOwnerRoot)/Haven.Desktop/HavenUI/Backend/HavenAvaloniaNativeControlResolver.cs" Link="Owner/Backend/%(Filename)%(Extension)" />
    <Compile Include="$(WriteOwnerRoot)/Haven.Desktop/HavenUI/Tokens/HavenUiFont.cs" Link="Owner/HavenUiFont.cs" />
    <Compile Include="$(WriteOwnerRoot)/Haven.Desktop/Services/MotionPreferencesService.cs;$(WriteOwnerRoot)/Haven.Desktop/Services/AvatarStore.cs;$(WriteOwnerRoot)/Haven.Desktop/Prefabs/ChatComposerController.cs;$(WriteOwnerRoot)/Haven.Desktop/Prefabs/ComposerEmojiCatalogue.cs;$(WriteOwnerRoot)/Haven.Infrastructure/Preferences/LocalMotionPreferencesService.cs" Link="Owner/Dependencies/%(Filename)%(Extension)" />
    <ProjectReference Include="$(WriteOwnerRoot)/Haven.Application/Haven.Application.csproj" />
    <ProjectReference Include="$(WriteOwnerRoot)/Haven.UI/Haven.UI.csproj" />
    <ProjectReference Include="../../../../framework/CUI/Runtime/CakeOS.Cui.Runtime.csproj" />
    <AvaloniaResource Include="$(WriteOwnerRoot)/Haven.Desktop/Assets/Fonts/MontserratStatic/*.ttf" Link="Assets/Fonts/MontserratStatic/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Existing pinned upstream asset/compiler targets preserve the AssetLoader
       resource format. The product shell itself remains Write.cui. -->
  <Import Project="../../../../framework/CUI/vendor/Avalonia/build/BuildTargets.targets" />
  <UsingTask TaskName="ExtractWriteOwnerThemeResources" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
      <ExpectedSha256 ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" /><Using Namespace="System.Linq" />
      <Using Namespace="System.Xml.Linq" /><Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var bytes = File.ReadAllBytes(SourceFile);
        string hash;
        using (var sha = SHA256.Create())
          hash = System.BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-", "").ToLowerInvariant();
        if (!string.Equals(hash, ExpectedSha256, System.StringComparison.OrdinalIgnoreCase))
        {
          Log.LogError("The owning DefaultTheme source changed ({0}); review the owner revision and extraction before updating the pinned hash.", hash);
          return false;
        }
        var original = XDocument.Load(SourceFile, LoadOptions.PreserveWhitespace);
        var root = original.Root;
        var resources = root.Element(root.Name.Namespace + "Styles.Resources");
        if (resources == null) { Log.LogError("Owning DefaultTheme Styles.Resources is missing."); return false; }
        var dictionary = new XElement(root.Name.Namespace + "ResourceDictionary",
          root.Attributes().Where(attribute => attribute.IsNamespaceDeclaration).Select(attribute => new XAttribute(attribute)),
          resources.Nodes());
        var generated = new XDocument(new XComment("Exact owning DefaultTheme Styles.Resources; full source SHA256=" + hash), dictionary);
        // Preserve the entire resources subtree, including original ControlThemes.
        // The original AcrylicSurface source is linked; no palette values are authored here.
        if (!dictionary.Elements().Select(element => element.ToString(SaveOptions.DisableFormatting))
            .SequenceEqual(resources.Elements().Select(element => element.ToString(SaveOptions.DisableFormatting))))
        { Log.LogError("Owning resources extraction is not structurally exact."); return false; }
        Directory.CreateDirectory(Path.GetDirectoryName(DestinationFile));
        var text = generated.ToString(SaveOptions.DisableFormatting);
        if (!File.Exists(DestinationFile) || File.ReadAllText(DestinationFile) != text) File.WriteAllText(DestinationFile, text);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="ExtractWriteOwnerTheme" BeforeTargets="ResolveReferences">
    <PropertyGroup><WriteGeneratedTheme>$(IntermediateOutputPath)WriteOwnerResources/DefaultTheme.Resources.axaml</WriteGeneratedTheme></PropertyGroup>
    <ExtractWriteOwnerThemeResources SourceFile="$(WriteOwnerRoot)/Haven.Desktop/Styles/DefaultTheme.axaml"
      DestinationFile="$(WriteGeneratedTheme)" ExpectedSha256="$(WriteOwnerThemeSha256)" />
    <ItemGroup>
      <AvaloniaResource Include="$(WriteGeneratedTheme)" Link="WriteOwnerResources/DefaultTheme.Resources.axaml" />
      <FileWrites Include="$(WriteGeneratedTheme)" />
    </ItemGroup>
  </Target>
</Project>
