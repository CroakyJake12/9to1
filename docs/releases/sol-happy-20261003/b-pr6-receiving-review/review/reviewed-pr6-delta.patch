+        status = "PRESERVED_ADMISSION01_CONTROL_RED_OBSERVED" if variant == "admission01" else "ADMISSION01_SESSION_REPAIRED_MARKUP_CONTROL_RED_OBSERVED"
+    else:
+        first = states[FIRST_ORIGINAL_FAILURE]
