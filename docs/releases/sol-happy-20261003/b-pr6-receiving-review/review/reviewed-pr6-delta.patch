+      <TextBlock text="{Binding Status}" accessible-name="Picture operation status" text-wrapping="Wrap" max-width="760" />
+      <WrapPanel>
+        <Button action="Import" content="Import static PNG" IsEnabled="{Binding NotBusy}" margin="0 0 8 4" />
+        <Button action="Refresh" content="Refresh local documents" margin="0 0 8 4" />
+        <Button action="Reopen" content="Reopen last Picture document" margin="0 0 8 4" />
+        <Button action="Save" content="Save locally" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
+        <Button action="Close" content="Save and close" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
+      </WrapPanel>
+      <Repeat Source="{Binding Documents}" As="item" Key="{Binding item.ID}" orientation="Vertical" spacing="4"><Button action="OpenDocumentRow" content="{Binding item.Label}" accessible-name="{Binding item.Label}" max-width="720" /></Repeat>
+      <TextBlock text="{Binding Identity}" accessible-name="Picture canonical document identity revision geometry and source" text-wrapping="Wrap" max-width="760" />
+      <Border padding="12" background="{Resource CuiPanelBrush}" corner-radius="8"><Object Type="PictureRasterPreview" accessible-name="Canonical Picture raster preview" max-width="760" /></Border>
+      <WrapPanel>
+        <Button action="Compare" content="{Binding ComparisonLabel}" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
+        <Button action="Undo" content="Undo" IsEnabled="{Binding CanUndo}" margin="0 0 8 4" />
+        <Button action="Redo" content="Redo" IsEnabled="{Binding CanRedo}" margin="0 0 8 4" />
+        <Button action="Rotate" content="Rotate clockwise" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
+        <Button action="FlipHorizontal" content="Flip horizontally" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
+        <Button action="FlipVertical" content="Flip vertically" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
+      </WrapPanel>
+      <TextBlock text="Crop in current canvas pixels" font-size="18" />
+      <WrapPanel>
+        <StackPanel margin="0 0 12 8"><TextBlock text="X" /><TextBox text="{Binding CropX, mode=TwoWay, type=string}" accessible-name="Crop left pixel" width="100" /></StackPanel>
+        <StackPanel margin="0 0 12 8"><TextBlock text="Y" /><TextBox text="{Binding CropY, mode=TwoWay, type=string}" accessible-name="Crop top pixel" width="100" /></StackPanel>
