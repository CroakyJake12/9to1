+name: Existing Write authoring and durable regressions
+on:
+  workflow_dispatch:
+  push:
+    branches: [team-b/astra-browser-validation-20261003]
+    paths:
+      - .github/workflows/team-b-existing-write.yml
+      - apps/Web/Tests/BrowserWriteSpace.Tests.csproj
+      - apps/Web/Tests/BrowserWriteSpaceRegression.cs
+      - apps/Web/Write/Tests/**
+permissions:
+  contents: read
+jobs:
+  original-write:
+    if: github.ref == 'refs/heads/team-b/astra-browser-validation-20261003'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    strategy:
+      fail-fast: false
+      matrix:
+        suite: [space15, durable65]
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+      - name: Verify the exact maintained native gitlinks
+        run: |
+          set -euo pipefail
+          test "$(git ls-tree HEAD -- framework/CUI/vendor/Avalonia/external/XamlX)" = "$(printf '160000 commit 009d4815470cf4bf71d1adbb633a5d81dcb2bb52\tframework/CUI/vendor/Avalonia/external/XamlX')"
+          test "$(git ls-tree HEAD -- framework/CUI/vendor/Avalonia/external/Avalonia.DBus)" = "$(printf '160000 commit 864a05282841bf04006890f04d11d60d1a046aa9\tframework/CUI/vendor/Avalonia/external/Avalonia.DBus')"
+      - name: Initialize only the pinned native build submodules
+        run: |
+          git submodule update --init --recursive --depth 1 -- \
+            framework/CUI/vendor/Avalonia/external/XamlX \
+            framework/CUI/vendor/Avalonia/external/Avalonia.DBus
+
+      - name: Verify initialized native source commits
+        run: |
+          set -euo pipefail
+          test "$(git -C framework/CUI/vendor/Avalonia/external/XamlX rev-parse HEAD)" = "009d4815470cf4bf71d1adbb633a5d81dcb2bb52"
+          test "$(git -C framework/CUI/vendor/Avalonia/external/Avalonia.DBus rev-parse HEAD)" = "864a05282841bf04006890f04d11d60d1a046aa9"
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '10.0.401'
+      - name: Source-build and execute unchanged Write fixtures
+        env:
+          WRITE_COMMIT: ${{ github.sha }}
+          WRITE_SUITE: ${{ matrix.suite }}
+        run: >-
+          python3 apps/Web/Write/Tests/ci/run-existing-write.py
+          --suite "$WRITE_SUITE" --expected-commit "$WRITE_COMMIT"
+          --output "$RUNNER_TEMP/existing-write-$WRITE_SUITE"
+      - name: Preserve actual bounded original diagnostics and first failures
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: existing-write-${{ matrix.suite }}-${{ github.sha }}
+          if-no-files-found: error
+          path: ${{ runner.temp }}/existing-write-${{ matrix.suite }}/diagnostics/
+          retention-days: 14
