+        <Button action="ExportLocation" content="Export PNG removing location" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
+        <Button action="ExportAll" content="Export PNG removing all metadata" IsEnabled="{Binding CanEdit}" margin="0 0 8 4" />
