+        try { await ValidateAsync(intent, cancellationToken).ConfigureAwait(false); return intent; }
+        catch { intent.Dispose(); throw; }
+    }
+
+    public async Task<PictureFilesOpenResult> ExecuteAsync(PictureImportIntent intent,
