<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NineToOne.Picture.Admission.Tests</AssemblyName><JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <RepositoryRoot>/workspace/team-c-c5-b-picture-eec-closure-provisional</RepositoryRoot>
    <PictureControlVariant Condition="'$(PictureControlVariant)' == ''">current</PictureControlVariant>
    <PictureSourceRoot Condition="'$(PictureControlVariant)' == 'current'">$(RepositoryRoot)/apps/Web/Picture</PictureSourceRoot>
    <PictureSourceRoot Condition="('$(PictureControlVariant)' == 'production-original' or '$(PictureControlVariant)' == 'production-original-repaired-markup')">$(MSBuildProjectDirectory)/Fixtures/ProductionOriginal</PictureSourceRoot>
    <PictureSourceRoot Condition="('$(PictureControlVariant)' == 'admission01' or '$(PictureControlVariant)' == 'admission01-repaired-markup')">$(MSBuildProjectDirectory)/Fixtures/Admission01</PictureSourceRoot>
    <PictureMarkupSource Condition="'$(PictureControlVariant)' == 'current' or '$(PictureControlVariant)' == 'production-original-repaired-markup' or '$(PictureControlVariant)' == 'admission01-repaired-markup'">$(RepositoryRoot)/apps/Web/Picture/Picture.cui</PictureMarkupSource>
    <PictureMarkupSource Condition="'$(PictureControlVariant)' == 'production-original' or '$(PictureControlVariant)' == 'admission01'">$(PictureSourceRoot)/Picture.cui</PictureMarkupSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="/workspace/team-c-c5-b-picture-eec-closure-provisional/apps/Web/Tests/PictureAdmission/PictureRawPngMetadata.cs" />
    <Compile Include="/workspace/team-c-c5-b-picture-eec-closure-provisional/apps/Web/Tests/PictureAdmission/PictureProductionOriginalRegression.cs" Condition="('$(PictureControlVariant)' == 'production-original' or '$(PictureControlVariant)' == 'production-original-repaired-markup')" />
    <Compile Include="/workspace/team-c-resume-evidence/c5-b-pr6-receiving/picture-crop-diagnostic/DiagnosticAdmission.cs" Condition="'$(PictureControlVariant)' != 'production-original' and '$(PictureControlVariant)' != 'production-original-repaired-markup'" />
    <Compile Include="$(PictureSourceRoot)/PictureBrowserFeature.cs;$(PictureSourceRoot)/PictureBrowserSession.cs" Link="SelectedActualSource/%(Filename)%(Extension)" />
    <Compile Include="$(RepositoryRoot)/apps/Web/BrowserSurfaceRegistry.cs;$(RepositoryRoot)/apps/Web/Media/IPictureBrowserMedia.cs;$(RepositoryRoot)/apps/Web/Media/BrowserPictureMedia.cs" Link="Production/%(Filename)%(Extension)" />
    <ProjectReference Include="$(RepositoryRoot)/apps/Web/Picture/Engine/NineToOne.Picture.BrowserEngine.csproj" />
    <ProjectReference Include="$(RepositoryRoot)/framework/CUI/Runtime/CakeOS.Cui.Runtime.csproj" />
    <ProjectReference Include="$(RepositoryRoot)/framework/CUI/vendor/Avalonia/src/Headless/Avalonia.Headless/Avalonia.Headless.csproj" />
    <ProjectReference Include="$(RepositoryRoot)/9to1 Workspace/Home/HavenOS.Home.csproj" />
    <EmbeddedResource Include="$(PictureMarkupSource)" LogicalName="NineToOne.Picture.Admission.Tests.Picture.cui" />
    <None Include="/workspace/team-c-c5-b-picture-eec-closure-provisional/apps/Web/Tests/PictureAdmission/Fixtures/Picture8x6.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireExplicitPictureVariant" BeforeTargets="CoreCompile">
    <Error Condition="'$(PictureControlVariant)' != 'current' and '$(PictureControlVariant)' != 'production-original' and '$(PictureControlVariant)' != 'admission01' and '$(PictureControlVariant)' != 'production-original-repaired-markup' and '$(PictureControlVariant)' != 'admission01-repaired-markup'" Text="Unknown Picture control variant; source selection is explicit and closed." />
  </Target>
</Project>