{
  "name": "billing-local-control",
  "account_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "limits": {
    "cpu_ms": 1000
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "STRIPE_MODE": "test",
    "SIGNATURE_TOLERANCE_SECONDS": 300,
    "MAX_WEBHOOK_BYTES": 65536
  },
  "secrets": {
    "required": [
      "STRIPE_WEBHOOK_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "BILLING_DB",
      "database_id": "11111111-2222-3333-4444-555555555555",
      "database_name": "billing-local-control",
      "migrations_dir": "schema"
    }
  ]
}
