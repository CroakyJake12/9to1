<!--
  Android head for Haven. The existing Haven.Desktop AXAML, styles, controls,
  pages, and view models are linked into this target so Android renders the
  same product UI rather than a separate mobile clone.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.cakemods.haven</ApplicationId>
    <ApplicationVersion>20001</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.1-mobile-preview</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AssemblyName>Haven</AssemblyName>
    <RootNamespace>Haven.Android</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- DI-constructed Avalonia controls intentionally have no public parameterless
         constructor; they are reached statically from Haven's control graph. -->
    <NoWarn>$(NoWarn);CA2255;AVLN3001</NoWarn>
    <Platforms>AnyCPU;x64</Platforms>
    <HavenGoogleCalendarClientId Condition="'$(HavenGoogleCalendarClientId)' == ''">$(HAVEN_GOOGLE_CALENDAR_CLIENT_ID)</HavenGoogleCalendarClientId>
    <HavenMicrosoftCalendarClientId Condition="'$(HavenMicrosoftCalendarClientId)' == ''">$(HAVEN_MICROSOFT_CALENDAR_CLIENT_ID)</HavenMicrosoftCalendarClientId>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="HavenGoogleCalendarClientId" Value="$(HavenGoogleCalendarClientId)" Condition="'$(HavenGoogleCalendarClientId)' != ''" />
    <AssemblyMetadata Include="HavenMicrosoftCalendarClientId" Value="$(HavenMicrosoftCalendarClientId)" Condition="'$(HavenMicrosoftCalendarClientId)' != ''" />
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../9to1 Workspace/shared/src/Haven.Core/Haven.Core.csproj" />
    <ProjectReference Include="../../../9to1 Workspace/shared/src/Haven.Application/Haven.Application.csproj" />
    <ProjectReference Include="../../../9to1 Workspace/shared/src/Haven.Infrastructure/Haven.Infrastructure.csproj" />
    <ProjectReference Include="../../../9to1 Workspace/shared/src/Haven.Browser/Haven.Browser.csproj" />
    <!-- The linked desktop source includes the Avalonia backend/host for platform-neutral Haven.UI. -->
    <ProjectReference Include="../../../9to1 Workspace/shared/src/Haven.UI/Haven.UI.csproj" />
    <ProjectReference Include="../Haven.Android.Hui/Haven.Android.Hui.csproj" />
    <!-- Legacy Haven.Automations project retired; scheduled Tasks live in Haven.Application. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="KokoroSharp.CPU" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../9to1 Workspace/shared/src/Haven.Desktop/**/*.cs" Exclude="../../../9to1 Workspace/shared/src/Haven.Desktop/bin/**;../../../9to1 Workspace/shared/src/Haven.Desktop/bin-*/**;../../../9to1 Workspace/shared/src/Haven.Desktop/obj/**;../../../9to1 Workspace/shared/src/Haven.Desktop/obj-*/**;../../../9to1 Workspace/shared/src/Haven.Desktop/Program.cs;../../../9to1 Workspace/shared/src/Haven.Desktop/MainWindow.axaml.cs;../../../9to1 Workspace/shared/src/Haven.Desktop/MainWindow.DeveloperTools.cs;../../../9to1 Workspace/shared/src/Haven.Desktop/Services/WindowsNaturalSpeechOutputService.cs;../../../9to1 Workspace/shared/src/Haven.Desktop/Services/WindowsGraphicsCaptureService.cs;../../../9to1 Workspace/shared/src/Haven.Desktop/Services/ComputerUseOverlayCoordinator.cs;../../../9to1 Workspace/shared/src/Haven.Desktop/Services/DesktopFloatingActivityHost.cs" LinkBase="SharedDesktop" />
    <AvaloniaXaml Include="../../../9to1 Workspace/shared/src/Haven.Desktop/App.axaml" Link="App.axaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </AvaloniaXaml>

    <AvaloniaResource Include="../../../9to1 Workspace/shared/src/Haven.Desktop/Assets/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../../../9to1 Workspace/shared/src/Haven.Desktop/Assets/Fonts/MontserratStatic/Montserrat-Medium.ttf" Link="fonts/Montserrat-Medium.ttf" />
    <AndroidAsset Include="../../../9to1 Workspace/shared/src/Haven.Desktop/Assets/Fonts/MontserratStatic/Montserrat-SemiBold.ttf" Link="fonts/Montserrat-SemiBold.ttf" />
    <AndroidAsset Include="../../../9to1 Workspace/shared/src/Haven.Desktop/Assets/Fonts/MontserratStatic/Montserrat-ExtraBold.ttf" Link="fonts/Montserrat-ExtraBold.ttf" />
    <AvaloniaXaml Include="../../../9to1 Workspace/shared/src/Haven.Desktop/Styles/**/*.axaml" Link="Styles/%(RecursiveDir)%(Filename)%(Extension)">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </AvaloniaXaml>

    <AvaloniaXaml Include="../../../9to1 Workspace/shared/src/Haven.Desktop/Controls/**/*.axaml" Link="Controls/%(RecursiveDir)%(Filename)%(Extension)">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </AvaloniaXaml>
    <AvaloniaXaml Include="../../../9to1 Workspace/shared/src/Haven.Desktop/Views/**/*.axaml" Exclude="../../../9to1 Workspace/shared/src/Haven.Desktop/MainWindow.axaml" Link="Views/%(RecursiveDir)%(Filename)%(Extension)">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </AvaloniaXaml>
    <AvaloniaXaml Include="../../../9to1 Workspace/shared/src/Haven.Desktop/Interface/**/*.axaml" Link="Interface/%(RecursiveDir)%(Filename)%(Extension)">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </AvaloniaXaml>
  </ItemGroup>
</Project>
