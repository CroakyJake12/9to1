<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>HtmlSanitizer</id>
    <version>9.2.1039</version>
    <authors>Michael Ganss</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/mganss/HtmlSanitizer</projectUrl>
    <description>Cleans HTML from constructs that can be used for cross-site scripting (XSS)</description>
    <copyright>Copyright 2013-2026 Michael Ganss</copyright>
    <tags>xss anti antixss html security</tags>
    <repository type="git" url="git://github.com/mganss/HtmlSanitizer" commit="0417018d81765e3e15126a65f5a49d71e55f0920" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="AngleSharp" version="1.7.2" exclude="Build,Analyzers" />
        <dependency id="AngleSharp.Css" version="1.0.2" exclude="Build,Analyzers" />
        <dependency id="System.Collections.Immutable" version="10.0.11" exclude="Build,Analyzers" />
        <dependency id="System.ValueTuple" version="4.6.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.7">
        <dependency id="AngleSharp" version="1.7.2" exclude="Build,Analyzers" />
        <dependency id="AngleSharp.Css" version="1.0.2" exclude="Build,Analyzers" />
        <dependency id="System.Collections.Immutable" version="10.0.11" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="AngleSharp" version="1.7.2" exclude="Build,Analyzers" />
        <dependency id="AngleSharp.Css" version="1.0.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="AngleSharp" version="1.7.2" exclude="Build,Analyzers" />
        <dependency id="AngleSharp.Css" version="1.0.2" exclude="Build,Analyzers" />
        <dependency id="System.Collections.Immutable" version="10.0.11" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>