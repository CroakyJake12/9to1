+using Haven.Application;
+using Xunit;
+
+namespace HavenOS.Apps.Canvas.NativeUI.Tests;
+
+public sealed class CanvasSharedInkInversePlacementTests
+{
+    private static readonly Guid ObjectId = Guid.Parse("11111111-2222-3333-4444-555555555555");
+    private static readonly Guid LayerId = Guid.Parse("aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee");
+
+    private static CanvasTransform Transform(double translateX = 0, double translateY = 0, double scale = 1, double rotationDegrees = 0) =>
+        new() { TranslateX = translateX, TranslateY = translateY, ScaleX = scale, ScaleY = scale, RotationDegrees = rotationDegrees };
+
+    private static RnotePointerSample Forward(RnotePointerSample local, CanvasTransform transform)
+    {
+        var radians = (transform.RotationDegrees % 360) * Math.PI / 180.0;
+        var cosine = Math.Cos(radians);
+        var sine = Math.Sin(radians);
+        var scaledX = local.X * transform.ScaleX;
+        var scaledY = local.Y * transform.ScaleY;
+        return new RnotePointerSample(
+            scaledX * cosine - scaledY * sine + transform.TranslateX,
+            scaledX * sine + scaledY * cosine + transform.TranslateY,
+            local.Pressure, local.TiltX, local.TiltY);
+    }
+
+    [Fact]
+    public void Identity_maps_points_unchanged()
+    {
+        var placement = CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, Transform());
+        var sample = new RnotePointerSample(12.5, -7.25, .35, .2, -.1);
+        var inverse = placement.ToStrokeCoordinates(sample);
+        Assert.Equal(sample.X, inverse.X, 12);
+        Assert.Equal(sample.Y, inverse.Y, 12);
+        Assert.Equal(sample.Pressure, inverse.Pressure);
+        Assert.Equal(sample.TiltX, inverse.TiltX);
+        Assert.Equal(sample.TiltY, inverse.TiltY);
+    }
+
+    [Fact]
+    public void Translation_maps_page_coordinates_back_to_local_coordinates()
+    {
+        var placement = CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, Transform(100, 40));
+        var inverse = placement.ToStrokeCoordinates(new RnotePointerSample(110, 50, .5));
+        Assert.Equal(10, inverse.X, 12);
+        Assert.Equal(10, inverse.Y, 12);
+    }
+
+    [Fact]
+    public void Quarter_turn_round_trips_a_local_point()
+    {
+        var transform = Transform(rotationDegrees: 90);
+        var placement = CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, transform);
+        var local = new RnotePointerSample(10, 0, .4, .1, -.2);
+        var page = Forward(local, transform);
+        var inverse = placement.ToStrokeCoordinates(page);
+        Assert.Equal(local.X, inverse.X, 10);
+        Assert.Equal(local.Y, inverse.Y, 10);
+        Assert.Equal(local.Pressure, inverse.Pressure);
+        Assert.Equal(local.TiltX, inverse.TiltX);
+        Assert.Equal(local.TiltY, inverse.TiltY);
+    }
+
+    [Fact]
+    public void Arbitrary_rotation_and_uniform_scale_round_trip()
+    {
+        var transform = Transform(12.5, -7.25, 2, 37);
+        var placement = CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, transform);
+        var local = new RnotePointerSample(3, -4, .35, .2, -.1);
+        var page = Forward(local, transform);
+        var inverse = placement.ToStrokeCoordinates(page);
+        Assert.Equal(local.X, inverse.X, 10);
+        Assert.Equal(local.Y, inverse.Y, 10);
+    }
+
+    [Theory]
+    [InlineData(1e20)]
+    [InlineData(double.MaxValue)]
+    public void Large_finite_rotation_uses_the_canonical_normalized_angle(double degrees)
+    {
+        var transform = Transform(12.5, -7.25, 2, degrees);
+        var placement = CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, transform);
+        var local = new RnotePointerSample(3, -4, .35, .2, -.1);
+        var inverse = placement.ToStrokeCoordinates(Forward(local, transform));
+        Assert.Equal(local.X, inverse.X, 10);
+        Assert.Equal(local.Y, inverse.Y, 10);
+        Assert.Equal(local.Pressure, inverse.Pressure);
+        Assert.Equal(local.TiltX, inverse.TiltX);
+        Assert.Equal(local.TiltY, inverse.TiltY);
+    }
+
+    [Fact]
+    public void Uniform_scale_scales_inverse_eraser_width_consistently()
+    {
+        var placement = CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, Transform(scale: 2));
+        Assert.Equal(6, placement.ToStrokeWidth(12), 12);
+        var placement2 = CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, Transform(scale: .5));
+        Assert.Equal(24, placement2.ToStrokeWidth(12), 12);
+    }
+
+    [Fact]
+    public void Stable_ids_revision_and_transform_round_trip()
+    {
+        var transform = Transform(1, 2, 2, 30);
+        var placement = CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, transform, "source-revision-1");
+        Assert.Equal(ObjectId, placement.ObjectId);
+        Assert.Equal(ObjectId, placement.StrokeId);
+        Assert.Equal(LayerId, placement.LayerId);
+        Assert.Equal("source-revision-1", placement.OwnerRevision);
+        Assert.Equal(transform, placement.Transform);
+    }
+
+    [Fact]
+    public void Invalid_transforms_are_refused()
+    {
+        Assert.False(new CanvasSharedInkInversePlacement(ObjectId, ObjectId, LayerId, Transform(scale: 0)).IsValid);
+        Assert.False(new CanvasSharedInkInversePlacement(ObjectId, ObjectId, LayerId, Transform(scale: 1e-12)).IsValid);
+        Assert.False(new CanvasSharedInkInversePlacement(ObjectId, ObjectId, LayerId, new CanvasTransform { ScaleX = -1, ScaleY = -1 }).IsValid);
+        Assert.False(new CanvasSharedInkInversePlacement(ObjectId, ObjectId, LayerId, new CanvasTransform { ScaleX = 2, ScaleY = 1 }).IsValid);
+        Assert.False(new CanvasSharedInkInversePlacement(ObjectId, ObjectId, LayerId, new CanvasTransform { TranslateX = double.NaN, ScaleX = 1, ScaleY = 1 }).IsValid);
+        Assert.Throws<NotSupportedException>(() => CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, Transform(scale: 0)));
+        Assert.Throws<NotSupportedException>(() => CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, new CanvasTransform { ScaleX = 2, ScaleY = 1 }));
+    }
+
+    [Fact]
+    public void Sample_validation_bounds_and_caller_arrays_are_preserved()
+    {
+        var placement = CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, Transform(1, 2, 2, 30));
+        Assert.Throws<InvalidDataException>(() => placement.ToStrokeCoordinates(new RnotePointerSample(double.NaN, 1, .5)));
+        Assert.Throws<InvalidDataException>(() => placement.ToStrokeCoordinates(new RnotePointerSample(200_000, 1, .5)));
+        var samples = Enumerable.Repeat(new RnotePointerSample(1, 1, .5), 100_001).ToArray();
+        Assert.Throws<InvalidDataException>(() => placement.ToStrokeCoordinates(samples));
+        var input = new[] { new RnotePointerSample(1, 2, .5), new RnotePointerSample(3, 4, .5) };
+        var before = input.ToArray();
+        var output = placement.ToStrokeCoordinates(input);
+        Assert.Equal(before, input);
+        Assert.Equal(2, output.Count);
+    }
+
+    [Fact]
+    public void Transform_content_is_not_mutated()
+    {
+        var transform = Transform(1, 2, 2, 30);
+        var before = transform with { };
+        var placement = CanvasSharedInkInversePlacement.Create(ObjectId, ObjectId, LayerId, transform);
+        Assert.Equal(before, transform);
+        Assert.Equal(transform, placement.Transform);
+    }
+}
