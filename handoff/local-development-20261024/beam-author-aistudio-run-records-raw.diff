+    private sealed class PathMutexLease : IDisposable
+    {
+        private Mutex? _mutex;
+        private bool _disposed;
+
+        private PathMutexLease(Mutex mutex) => _mutex = mutex;
+
+        public static PathMutexLease Acquire(string path, CancellationToken cancellationToken)
+        {
+            var canonical = Path.GetFullPath(path);
+            if (OperatingSystem.IsWindows()) canonical = canonical.ToUpperInvariant();
+            var name = "9to1-state-" + Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(canonical)));
+            var mutex = new Mutex(false, name);
+            try
+            {
+                var deadline = Environment.TickCount64 + 30000;
+                while (true)
+                {
+                    cancellationToken.ThrowIfCancellationRequested();
+                    var remaining = (int)(deadline - Environment.TickCount64);
+                    if (remaining <= 0) throw new TimeoutException("AI Studio resource store is busy.");
+                    var wait = Math.Min(100, remaining);
+                    try
+                    {
+                        if (mutex.WaitOne(wait)) break;
+                    }
+                    catch (AbandonedMutexException)
+                    {
+                        break;
+                    }
+                }
+                return new PathMutexLease(mutex);
+            }
+            catch
+            {
+                mutex.Dispose();
+                throw;
+            }
+        }
+
+        public void Dispose()
+        {
+            if (_disposed) return;
+            _disposed = true;
+            var mutex = _mutex;
+            _mutex = null;
+            if (mutex is null) return;
+            try { mutex.ReleaseMutex(); } catch { }
+            mutex.Dispose();
+        }
+    }
 }

