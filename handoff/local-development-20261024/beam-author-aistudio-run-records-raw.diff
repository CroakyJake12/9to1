+using HavenOS.AIStudio;
+using Xunit;
+
+namespace HavenOS.AIStudio.Tests;
+
+public sealed class StudioRunStoreRegressionTests : IAsyncLifetime
+{
+    private readonly string _root = Path.Combine(Path.GetTempPath(), "ai-studio-run-store-regression", Guid.NewGuid().ToString("N"));
+    private string StorePath => Path.Combine(_root, "resources.v1.json");
+
+    public Task InitializeAsync() => Task.CompletedTask;
+
+    public Task DisposeAsync()
+    {
+        if (Directory.Exists(_root)) Directory.Delete(_root, recursive: true);
+        return Task.CompletedTask;
+    }
+
+    private static DateTimeOffset Start => new(2026, 1, 2, 3, 4, 5, TimeSpan.Zero);
+    private static DateTimeOffset End => new(2026, 1, 2, 3, 5, 5, TimeSpan.Zero);
+
+    private static EvaluationRun CreateEvaluationRun(Guid runId, Guid suiteId) => new(
+        runId, suiteId, 7, "profile-1", Start, End,
+        [new EvaluationCaseResult(Guid.NewGuid(), 1, "Passed",
+            ["PASS exact output matches", "PASS latency limit"],
+            "model judgement", 1.0, null, runId)],
+        new Dictionary<string, string>(StringComparer.Ordinal) { ["model"] = "revision-7" },
+        "{\"baseline\":\"comparison\"}");
+
+    private static TestRun CreateTestRun(Guid runId, Guid suiteId) => new(
+        runId, suiteId, 9, "profile-2", Start, End,
+        [new StudioTestCaseResult(Guid.NewGuid(), "Passed",
+            [new TestAssertionResult("assertion-1", true, "Assertion passed.", "{\"actual\":true}")],
+            runId, null, "{\"source\":\"test-contract\"}")]);
+
+    [Fact]
+    public async Task IdenticalEvaluationRunWrittenTwiceYieldsOneRecordAfterReopen()
+    {
+        var store = new JsonStudioResourceStore(_root);
+        var suiteId = Guid.NewGuid();
+        var runId = Guid.NewGuid();
+        var run = CreateEvaluationRun(runId, suiteId);
+        await store.WriteEvaluationRunAsync(run, CancellationToken.None);
+        var bytesAfterFirst = await File.ReadAllBytesAsync(StorePath);
+        await store.WriteEvaluationRunAsync(run, CancellationToken.None);
+        var bytesAfterSecond = await File.ReadAllBytesAsync(StorePath);
+        Assert.Equal(bytesAfterFirst, bytesAfterSecond);
+
+        var reopened = new JsonStudioResourceStore(_root);
+        var runs = await reopened.ListEvaluationRunsAsync(suiteId, CancellationToken.None);
+        Assert.Single(runs);
+        var persisted = runs[0];
+        Assert.Equal(runId, persisted.RunId);
+        Assert.Equal(7, persisted.TargetRevision);
+        Assert.Equal("profile-1", persisted.RunProfileId);
+        Assert.Equal("revision-7", persisted.DependencyRevisions["model"]);
+        Assert.Equal("model judgement", persisted.Results.Single().ModelJudgement);
+    }
+
+    [Fact]
+    public async Task ConflictingEvaluationRunPreservesBytes()
+    {
+        var store = new JsonStudioResourceStore(_root);
+        var suiteId = Guid.NewGuid();
+        var runId = Guid.NewGuid();
+        var run = CreateEvaluationRun(runId, suiteId);
+        await store.WriteEvaluationRunAsync(run, CancellationToken.None);
+        var originalBytes = await File.ReadAllBytesAsync(StorePath);
+        var conflict = run with { RunProfileId = "changed-profile" };
+        await Assert.ThrowsAsync<IOException>(() => store.WriteEvaluationRunAsync(conflict, CancellationToken.None));
+        Assert.Equal(originalBytes, await File.ReadAllBytesAsync(StorePath));
+    }
+
+    [Fact]
+    public async Task IdenticalTestRunWrittenTwiceYieldsOneRecordAfterReopen()
+    {
+        var store = new JsonStudioResourceStore(_root);
+        var suiteId = Guid.NewGuid();
+        var runId = Guid.NewGuid();
+        var run = CreateTestRun(runId, suiteId);
+        await store.WriteTestRunAsync(run, CancellationToken.None);
+        var bytesAfterFirst = await File.ReadAllBytesAsync(StorePath);
+        await store.WriteTestRunAsync(run, CancellationToken.None);
+        var bytesAfterSecond = await File.ReadAllBytesAsync(StorePath);
+        Assert.Equal(bytesAfterFirst, bytesAfterSecond);
+
+        var reopened = new JsonStudioResourceStore(_root);
+        var runs = await reopened.ListTestRunsAsync(suiteId, CancellationToken.None);
+        Assert.Single(runs);
+        var persisted = runs[0];
+        Assert.Equal(runId, persisted.RunId);
+        Assert.Equal(9, persisted.TargetRevision);
+        Assert.Equal("profile-2", persisted.RunProfileId);
+        Assert.Equal("{\"source\":\"test-contract\"}", persisted.Results.Single().ReproductionJson);
+    }
+
+    [Fact]
+    public async Task ConflictingTestRunPreservesBytes()
+    {
+        var store = new JsonStudioResourceStore(_root);
+        var suiteId = Guid.NewGuid();
+        var runId = Guid.NewGuid();
+        var run = CreateTestRun(runId, suiteId);
+        await store.WriteTestRunAsync(run, CancellationToken.None);
+        var originalBytes = await File.ReadAllBytesAsync(StorePath);
