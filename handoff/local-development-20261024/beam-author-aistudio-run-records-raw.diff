+        Assert.Equal(originalBytes, await File.ReadAllBytesAsync(StorePath));
+    }
+
+    [Fact]
+    public async Task TwoStoreInstancesRetainDistinctEvaluationRuns()
+    {
+        var suiteId = Guid.NewGuid();
+        var firstId = Guid.NewGuid();
+        var secondId = Guid.NewGuid();
+        await new JsonStudioResourceStore(_root).WriteEvaluationRunAsync(CreateEvaluationRun(firstId, suiteId), CancellationToken.None);
+        await new JsonStudioResourceStore(_root).WriteEvaluationRunAsync(CreateEvaluationRun(secondId, suiteId), CancellationToken.None);
+        var runs = await new JsonStudioResourceStore(_root).ListEvaluationRunsAsync(suiteId, CancellationToken.None);
+        Assert.Equal(2, runs.Count);
+        Assert.Contains(runs, run => run.RunId == firstId);
+        Assert.Contains(runs, run => run.RunId == secondId);
+    }
+
+    [Fact]
+    public async Task TwoStoreInstancesRetainDistinctTestRuns()
+    {
+        var suiteId = Guid.NewGuid();
+        var firstId = Guid.NewGuid();
+        var secondId = Guid.NewGuid();
+        await new JsonStudioResourceStore(_root).WriteTestRunAsync(CreateTestRun(firstId, suiteId), CancellationToken.None);
+        await new JsonStudioResourceStore(_root).WriteTestRunAsync(CreateTestRun(secondId, suiteId), CancellationToken.None);
