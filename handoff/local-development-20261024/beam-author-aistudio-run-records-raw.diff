+        var now = DateTimeOffset.UtcNow;
+        var evalSuiteId = Guid.NewGuid();
+        var testSuiteId = Guid.NewGuid();
+        var resourceId = Guid.NewGuid();
+        await Task.WhenAll(
+            new JsonStudioResourceStore(_root).WriteEvaluationRunAsync(CreateEvaluationRun(Guid.NewGuid(), evalSuiteId), CancellationToken.None),
+            new JsonStudioResourceStore(_root).WriteTestRunAsync(CreateTestRun(Guid.NewGuid(), testSuiteId), CancellationToken.None),
+            new JsonStudioResourceStore(_root).WriteResourceAsync(new StudioResource(resourceId, StudioResourceKind.Schema, "Schema", 1, now, now, "user", "{\"schemaId\":\"mixed.v1\"}", []), CancellationToken.None));
+        var reopened = new JsonStudioResourceStore(_root);
+        Assert.Single(await reopened.ListEvaluationRunsAsync(evalSuiteId, CancellationToken.None));
+        Assert.Single(await reopened.ListTestRunsAsync(testSuiteId, CancellationToken.None));
+        Assert.Single(await reopened.ListAsync(StudioResourceKind.Schema, CancellationToken.None));
+    }
+
+    [Fact]
+    public async Task CanceledEvaluationRunWritePreservesBytes()
+    {
+        var store = new JsonStudioResourceStore(_root);
+        var suiteId = Guid.NewGuid();
+        var run = CreateEvaluationRun(Guid.NewGuid(), suiteId);
+        await store.WriteEvaluationRunAsync(run, CancellationToken.None);
+        var originalBytes = await File.ReadAllBytesAsync(StorePath);
+        using var cts = new CancellationTokenSource();
+        cts.Cancel();
+        var canceledRun = CreateEvaluationRun(Guid.NewGuid(), suiteId);
+        await Assert.ThrowsAsync<OperationCanceledException>(() => store.WriteEvaluationRunAsync(canceledRun, cts.Token));
+        Assert.Equal(originalBytes, await File.ReadAllBytesAsync(StorePath));
+    }
+
+    [Fact]
+    public async Task MalformedStorePreservesBytes()
+    {
+        Directory.CreateDirectory(_root);
+        const string corrupt = "{not-json";
+        await File.WriteAllTextAsync(StorePath, corrupt);
+        await Assert.ThrowsAsync<InvalidDataException>(() => new JsonStudioResourceStore(_root).ListEvaluationRunsAsync(Guid.NewGuid(), CancellationToken.None));
+        Assert.Equal(corrupt, await File.ReadAllTextAsync(StorePath));
+    }
+}
