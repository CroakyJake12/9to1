+    private async Task<StudioResult<Unit>> SafeWriteExpectedAsync(StudioProject project, int expectedVersion, CancellationToken cancellationToken)
+    {
+        try
+        {
+            var result = await store.WriteAsync(project, expectedVersion, cancellationToken).ConfigureAwait(false);
+            if (result) return StudioResult<Unit>.Success(new Unit());
+            return result.Status switch
+            {
+                StudioProjectStoreStatus.Cancelled => StudioResult<Unit>.Failure("Cancelled", result.Message ?? "The request was cancelled.", project.ProjectId.ToString(), retryable: true),
+                StudioProjectStoreStatus.StoreSchemaUnsupported => StudioResult<Unit>.Failure("StoreSchemaUnsupported", result.Message ?? "The project store is unsupported.", project.ProjectId.ToString(), recoverable: true),
+                StudioProjectStoreStatus.PersistenceUnavailable => StudioResult<Unit>.Failure("PersistenceUnavailable", result.Message ?? "Persistence is unavailable.", project.ProjectId.ToString(), retryable: true),
+                StudioProjectStoreStatus.NotFound => StudioResult<Unit>.Failure("ProjectNotFound", result.Message ?? "The project does not exist.", project.ProjectId.ToString()),
+                _ => StudioResult<Unit>.Failure("RevisionConflict", result.Message ?? "Project version changed.", project.ProjectId.ToString(), recoverable: true)
+            };
+        }
+        catch (OperationCanceledException)
+        {
+            return StudioResult<Unit>.Failure("Cancelled", "The request was cancelled.", project.ProjectId.ToString(), retryable: true);
+        }
+        catch (InvalidDataException ex)
+        {
+            return StudioResult<Unit>.Failure("StoreSchemaUnsupported", ex.Message, project.ProjectId.ToString(), recoverable: true);
+        }
+        catch (IOException ex)
+        {
+            return StudioResult<Unit>.Failure("PersistenceUnavailable", ex.Message, project.ProjectId.ToString(), retryable: true);
+        }
+    }
+
