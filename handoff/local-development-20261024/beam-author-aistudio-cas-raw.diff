+    private async Task<StudioProjectStoreResult> WriteExpectedVersionCoreAsync(StudioProject project, int expectedVersion, CancellationToken cancellationToken)
+    {
+        ArgumentNullException.ThrowIfNull(project);
+        try
+        {
+            await using var lease = await AcquireLockAsync(cancellationToken).ConfigureAwait(false);
+            var document = await ReadDocumentAsync(cancellationToken).ConfigureAwait(false);
+            var items = document.Projects.ToList();
+            var index = items.FindIndex(item => item.ProjectId == project.ProjectId);
+            if (index < 0)
+                return new StudioProjectStoreResult(false, StudioProjectStoreStatus.NotFound, null, "The project does not exist.");
+            if (items[index].Version != expectedVersion)
+                return new StudioProjectStoreResult(false, StudioProjectStoreStatus.VersionConflict, null, $"The project is version {items[index].Version}; version {expectedVersion} was submitted.");
+            items[index] = project;
+            await WriteDocumentAsync(new StudioStoreDocument(CurrentSchemaVersion, items), cancellationToken).ConfigureAwait(false);
+            return new StudioProjectStoreResult(true, StudioProjectStoreStatus.Success, project);
+        }
+        catch (OperationCanceledException)
+        {
+            return new StudioProjectStoreResult(false, StudioProjectStoreStatus.Cancelled, null, "The request was cancelled.");
+        }
+        catch (InvalidDataException ex)
+        {
+            return new StudioProjectStoreResult(false, StudioProjectStoreStatus.StoreSchemaUnsupported, null, ex.Message);
+        }
+        catch (IOException ex)
+        {
+            return new StudioProjectStoreResult(false, StudioProjectStoreStatus.PersistenceUnavailable, null, ex.Message);
+        }
+    }
+
+    private async Task<StudioProjectStoreResult> CreateIfAbsentCoreAsync(StudioProject project, CancellationToken cancellationToken)
+    {
+        ArgumentNullException.ThrowIfNull(project);
+        try
+        {
+            await using var lease = await AcquireLockAsync(cancellationToken).ConfigureAwait(false);
+            var document = await ReadDocumentAsync(cancellationToken).ConfigureAwait(false);
+            var items = document.Projects.ToList();
+            if (items.Any(item => item.ProjectId == project.ProjectId))
+                return new StudioProjectStoreResult(false, StudioProjectStoreStatus.AlreadyExists, null, "The project already exists.");
+            items.Add(project);
+            await WriteDocumentAsync(new StudioStoreDocument(CurrentSchemaVersion, items), cancellationToken).ConfigureAwait(false);
+            return new StudioProjectStoreResult(true, StudioProjectStoreStatus.Success, project);
+        }
+        catch (OperationCanceledException)
+        {
+            return new StudioProjectStoreResult(false, StudioProjectStoreStatus.Cancelled, null, "The request was cancelled.");
+        }
+        catch (InvalidDataException ex)
+        {
+            return new StudioProjectStoreResult(false, StudioProjectStoreStatus.StoreSchemaUnsupported, null, ex.Message);
+        }
+        catch (IOException ex)
+        {
+            return new StudioProjectStoreResult(false, StudioProjectStoreStatus.PersistenceUnavailable, null, ex.Message);
+        }
+    }
