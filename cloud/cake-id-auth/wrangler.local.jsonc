{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cake-id-local-test-only",
  "main": "src/local.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cake-id-local-test-only",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_MODE": "local-test-only",
    "AUTH_BASE_URL": "http://127.0.0.1:8798",
    "API_RESOURCE": "http://127.0.0.1:5095",
    "ALLOWED_WEB_ORIGINS": "http://127.0.0.1:8798",
    "EMAIL_CAPTURE": "true",
    "LOGIN_MAX_ATTEMPTS": "8",
    "LOGIN_WINDOW_SECONDS": "900",
    "LOGIN_LOCK_SECONDS": "1800"
  }
}
