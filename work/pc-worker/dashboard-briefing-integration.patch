Add the following private method (next to OnConversation/OnDashboardApp) and the refusal hook:

    /// <summary>
    /// Maps a page-validated briefing target to a real navigation address. Returns true only when a
    /// genuine destination was issued. Unverified/owning-app-only kinds are NOT forged into entity
    /// deep links; when only an owning app is safely known we open that app and state the limitation,
    /// otherwise we return false so the page reports an honest refusal.
    /// </summary>
    private bool TryRouteBriefingTarget(DashboardBriefingTarget target)
    {
        // Conversation entities have a verified exact deep link.
        if (target.Kind.Equals("chat", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(target.Id, out var conversationId))
        {
            StartNavigation(AppContentAddress.Parse($"9to1://spaces/chat/{conversationId:D}"));
            return true;
        }
        // Planner tasks/events: open the owning Planner app (no verified exact entity deep link).
        // We do NOT forge a task/event entity link here.
        if (target.Kind.Equals("task", StringComparison.OrdinalIgnoreCase)
            || target.Kind.Equals("event", StringComparison.OrdinalIgnoreCase))
        {
            StartNavigation(AppContentAddress.Parse("9to1://planner"));
            return true;
        }
        // Calls: open the owning call/Spaces surface only; an exact call-session link is unverified.
        if (target.Kind.Equals("call", StringComparison.OrdinalIgnoreCase))
        {
            StartNavigation(AppContentAddress.Parse("9to1://call"));
            return true;
        }
        // Container rows (group / subject / project) have no verified exact entity deep link; the
        // owning app surface is a safe, honest destination.
        if (target.Kind.Equals("group", StringComparison.OrdinalIgnoreCase))
        {
            StartNavigation(AppContentAddress.Parse("9to1://spaces"));
            return true;
        }
        if (target.Kind.Equals("subject", StringComparison.OrdinalIgnoreCase))
        {
            StartNavigation(AppContentAddress.Parse("9to1://study"));
            return true;
        }
        if (target.Kind.Equals("project", StringComparison.OrdinalIgnoreCase))
        {
            StartNavigation(AppContentAddress.Parse("9to1://studio"));
            return true;
        }
        // Anything else (unknown kind, malformed id) is refused honestly by the page.
        return false;
    }

