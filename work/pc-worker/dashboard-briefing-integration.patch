From: Mercury worker lane 14 (pass2) — Home Dashboard briefing
Subject: [PATCH] Integrate source-backed briefing navigation into UnifiedHomePage

Base: ddb2a8b813c8189b31556ef2ee491ac4f6f2b4eb (root read-only file unchanged by this lane)
Target: 9to1 Workspace/shared/src/Haven.Desktop/Views/Pages/Home/UnifiedHomePage.cs

This patch binds the dashboard's BriefingNavigator when the dashboard is mounted and unbinds it on
cleanup, and implements the host route for a page-validated briefing target. Only the conversation
entity has a verified exact deep link in this host (the same route OnConversation already uses).
Every other kind (Planner task/event, call, container group/subject/project) lacks a verified exact
entity route here; we refuse honestly (return false) so the dashboard surfaces a truthful
owning-app/opening limitation instead of forging a URI or restoring retired identities.

diff --git a/9to1 Workspace/shared/src/Haven.Desktop/Views/Pages/Home/UnifiedHomePage.cs b/9to1 Workspace/shared/src/Haven.Desktop/Views/Pages/Home/UnifiedHomePage.cs
index 7b6f161ab3a382d65df07bcf88522e691b5780dc..77b77503eb6d4becd3fadff8e953b52a4ff2dea7 100644
--- a/9to1 Workspace/shared/src/Haven.Desktop/Views/Pages/Home/UnifiedHomePage.cs
+++ b/9to1 Workspace/shared/src/Haven.Desktop/Views/Pages/Home/UnifiedHomePage.cs
@@ -203,6 +203,7 @@
                     _dashboard.ManageAppsRequested += OnManageApps;
                     _dashboard.DiscoverRequested += OnDiscover;
                     _dashboard.ConversationRequested += OnConversation;
+                    _dashboard.BriefingNavigator = TryRouteBriefingTarget;
                 });
             }
             if (!original.IsAcceptedPublicationCurrent) return;
@@ -268,6 +269,25 @@
     }
     private void OnConversation(object? sender, Conversation conversation) =>
         StartNavigation(AppContentAddress.Parse($"9to1://spaces/chat/{conversation.Id:D}"));
+
+    /// <summary>
+    /// Routes a page-validated briefing target. Only the conversation entity has a verified exact
+    /// deep link in this host (the same route OnConversation already uses). Every other kind lacks a
+    /// verified exact entity route here, so we refuse honestly rather than forge a URI; the dashboard
+    /// then surfaces that truthful owning-app/opening limitation.
+    /// </summary>
+    private bool TryRouteBriefingTarget(DashboardBriefingTarget target)
+    {
+        if (target.Kind.Equals("chat", StringComparison.OrdinalIgnoreCase)
+            && Guid.TryParse(target.Id, out var conversationId))
+        {
+            StartNavigation(AppContentAddress.Parse($"9to1://spaces/chat/{conversationId:D}"));
+            return true;
+        }
+        // Planner tasks/events, calls and container rows (group/subject/project) have no verified
+        // exact entity deep link here. We do NOT invent owning-app aliases; honest refusal is shown.
+        return false;
+    }
     private void OnManageProviders(object? sender, EventArgs args) => StartNavigation(AppContentAddress.Parse("9to1://home/settings"));
     private void OnManageApps(object? sender, EventArgs args) => StartSelection("apps");
     private void OnDiscover(object? sender, EventArgs args) => StartSelection("models");
@@ -380,6 +400,7 @@
         {
             _dashboard.ModeRequested -= OnDashboardApp; _dashboard.ManageAppsRequested -= OnManageApps;
             _dashboard.DiscoverRequested -= OnDiscover; _dashboard.ConversationRequested -= OnConversation;
+            _dashboard.BriefingNavigator = null;
         }
         if (_discover is not null) _discover.ManageProvidersRequested -= OnManageProviders;
         _viewport.Child = null; Content = null;
