diff --git a/tools/dual_gpu/training/train.py b/tools/dual_gpu/training/train.py
new file mode 100644
index 0000000..9b8bf13
--- /dev/null
+++ b/tools/dual_gpu/training/train.py
@@ -0,0 +1,177 @@
+"""Run one synchronous SGD epoch on a local RTX and the existing V100 RPC worker."""
+import argparse
+import contextlib
+import fcntl
+import json
+import math
+import os
+from pathlib import Path
+import signal
+import subprocess
+import time
+
+from build import PIN, digest
+
+
+def rpc_endpoint(value):
+    # The operator's existing SSH forward terminates on loopback. Never expose RPC.
+    host, sep, port = value.rpartition(":")
+    if not sep or host != "127.0.0.1" or not port.isdecimal() or not 0 < int(port) < 65536:
+        raise argparse.ArgumentTypeError("Expected an existing 127.0.0.1:PORT RPC forward.")
+    return value
+
+
+def command(args, run):
+    ctx = str(args.context)
+    return [str(args.build / "bin/thunder-finetune"), "-m", str(args.model), "-f", str(args.text),
+            "-o", str(run / "native-weights.gguf"), "--rpc", args.rpc, "-dev", "CUDA0,RPC0",
+            "-sm", "layer", "-ts", "1,1", "-ngl", "99", "--fit", "off", "-fa", "off",
+            "-ot", "token_embd.weight=CPU", "-c", ctx, "-b", ctx, "-ub", ctx,
+            "-epochs", "1", "-opt", "sgd", "-lr", "0.0001", "-s", "4703",
+            "-val-split", "0.25", "-t", "2", "-lv", "5"]
+
+
+def guard_sample(path):
+    now = time.time()
+    status = json.loads(path.read_text())
+    if not -1 <= now - status["ts"] < 6 or status["halted"] or path.with_name("v100-standby").exists():
+        raise RuntimeError("Thermal guard is stale, halted, or the V100 is in standby.")
+    sample = {"time": now}
+    for device in ("rtx5080", "v100"):
+        node = status["devices"][device]
+        reading = node["reading_full"]
+        if (not node["telemetry_ok"] or node["stopped"] or not -1 <= now - node["last_telemetry_ts"] < 6
+                or not reading or reading["driver_ok"] is not True or not math.isfinite(reading["temp"])
+                or reading["temp"] >= 68):
+            raise RuntimeError(f"Missing, stale or unsafe {device} reading.")
+        if device == "v100" and (reading["power_limit_active"] != 165 or
+                                 not math.isfinite(reading["temp_mem"]) or reading["temp_mem"] >= 67):
+            raise RuntimeError("V100 power cap or HBM temperature failed the measured workstation guard.")
+        if not (isinstance(reading["mem_total"], (int, float)) and
+                isinstance(reading["mem_used"], (int, float)) and 0 <= reading["mem_used"] <= reading["mem_total"]):
+            raise RuntimeError(f"Missing device memory headroom for {device}.")
+        sample[device] = {k: reading[k] for k in ("name", "mem_used", "mem_total", "temp", "util", "temp_mem")}
+    mem = next(line for line in Path("/proc/meminfo").read_text().splitlines() if line.startswith("MemAvailable:"))
+    sample["host_available_mib"] = int(mem.split()[1]) // 1024
+    if sample["host_available_mib"] < 1536:
+        raise RuntimeError("Available host memory fell below 1536 MiB.")
+    return sample
+
+
+def run_training(args):
+    from checkpoint import export, inspect_model, parse_placement
+    args.build = args.build.resolve(strict=True)
+    args.model = args.model.resolve(strict=True)
+    args.text = args.text.resolve(strict=True)
+    run = args.run_dir.absolute()
+    if os.path.lexists(run):
+        raise FileExistsError(f"Training run directory already exists: {run}")
+    if not args.text.is_file() or not args.text.stat().st_size or not args.model.is_file():
+        raise ValueError("Supply an original FP32 GGUF model and a nonempty local training text file.")
+    inspect_model(args.model, args.context)
+    cmd = command(args, run)
+    result = args.build / "build.json"
+    if args.dry_run and not result.exists():
+        plan = json.loads((args.build / "plan.json").read_text())
+        if plan["source_commit"] != PIN:
+            raise ValueError("Prepared sources have an unexpected revision.")
+        print(json.dumps({"build": "prepared, uncompiled", "argv": cmd}, indent=2))
+        return
+    build = json.loads(result.read_text())
+    if build["source_commit"] != PIN or "thunder-finetune" not in build["runtime_sha256"]:
+        raise ValueError("Use a completed build from the pinned training helper.")
+    linked = Path(build["cmake_build"]) / "bin"
+    for directory, hashes in [(args.build / "bin", build["runtime_sha256"]), (linked, build["dependency_sha256"])]:
+        for name, expected in hashes.items():
+            if Path(name).name != name or digest(directory / name) != expected:
+                raise ValueError("Built library or trainer changed: " + name)
+    if args.dry_run:
+        print(json.dumps(cmd, indent=2))
+        return
+    if not args.window_owned:
+        raise ValueError("Run inside the workstation coordinator's drained GPU window (--window-owned).")
+    admission_sample = guard_sample(args.guard_status)
+    if args.min_free_mib is None:
+        raise ValueError("Supply measured per-device free-memory requirements for this model and context.")
+    for device, minimum in zip(("rtx5080", "v100"), args.min_free_mib, strict=True):
+        reading = admission_sample[device]
+        free_mib = (reading["mem_total"] - reading["mem_used"]) / (1024 ** 2)
+        if free_mib < minimum:
+            raise RuntimeError(f"{device} has {free_mib:.0f} MiB free; this run requires {minimum} MiB.")
+    env = dict(os.environ, CUDA_VISIBLE_DEVICES="0",
+               LD_LIBRARY_PATH=os.pathsep.join(map(str, [args.build / "bin", linked, build["cuda_runtime"]])))
+    run.mkdir(mode=0o700)
+    receipt = {"source_commit": PIN, "command": cmd, "base_sha256": digest(args.model),
+               "text_sha256": digest(args.text), "build_sha256": digest(args.build / "build.json"),
+               "required_free_mib": args.min_free_mib, "admission": admission_sample, "status": "failed"}
+    try:
+        with (run / "native.log").open("xb") as log, (run / "telemetry.jsonl").open("x") as telemetry:
+            start = time.monotonic()
+            proc = subprocess.Popen(cmd, cwd=run, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+            try:
+                while True:
+                    sample = guard_sample(args.guard_status)
+                    telemetry.write(json.dumps(sample) + "\n")
+                    telemetry.flush()
+                    if proc.poll() is not None:
+                        break
+                    if time.monotonic() - start >= args.timeout:
+                        raise TimeoutError("Owned training window expired.")
+                    time.sleep(0.2)
+            finally:
+                if proc.poll() is None:
+                    with contextlib.suppress(ProcessLookupError):
+                        os.killpg(proc.pid, signal.SIGTERM)
+                    try:
+                        proc.wait(timeout=3)
+                    except subprocess.TimeoutExpired:
+                        with contextlib.suppress(ProcessLookupError):
+                            os.killpg(proc.pid, signal.SIGKILL)
+                        proc.wait()
+                receipt["exit_code"] = proc.returncode
+            if proc.returncode:
+                raise RuntimeError(f"Native training exited {proc.returncode}; see native.log.")
+        layers = parse_placement((run / "native.log").read_text(errors="replace"))
+        if digest(args.model) != receipt["base_sha256"] or digest(args.text) != receipt["text_sha256"]:
+            raise ValueError("An input changed during training.")
+        checkpoint = run / "checkpoint.gguf"
+        receipt["changed_weight_elements"] = export(args.model, run / "native-weights.gguf", checkpoint, layers)
+        receipt.update(status="verified", checkpoint_sha256=digest(checkpoint))
+    except BaseException as error:
+        receipt["error"] = str(error) or type(error).__name__
+        raise
+    finally:
+        with (run / "receipt.json").open("x") as output:
+            json.dump(receipt, output, indent=2)
+            output.write("\n")
+    print(checkpoint)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--build", type=Path, required=True)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--text", type=Path, required=True)
+    parser.add_argument("--run-dir", type=Path, required=True)
+    parser.add_argument("--rpc", type=rpc_endpoint, default="127.0.0.1:19110")
+    parser.add_argument("--context", type=int, default=128)
+    parser.add_argument("--timeout", type=int, default=90)
+    parser.add_argument("--guard-status", type=Path, default=Path.home() / "strata-run/thermal_guard_status.json")
+    parser.add_argument("--min-free-mib", type=int, nargs=2, metavar=("RTX", "V100"),
+                        help="operator's fit budget for this model and context on each device")
+    parser.add_argument("--window-owned", action="store_true", help="the operator has already drained both devices")
+    parser.add_argument("--dry-run", action="store_true", help="check local inputs and print argv without device access")
+    options = parser.parse_args()
+    if options.min_free_mib is not None and min(options.min_free_mib) <= 0:
+        parser.error("Both free-memory requirements must be positive.")
+    if options.timeout <= 0:
+        parser.error("Timeout must be positive.")
+    def terminate(signum, _frame):
+        raise SystemExit(128 + signum)
+
+    signal.signal(signal.SIGTERM, terminate)
+    # This shared checkout only runs one opt-in trainer at a time.
+    with Path(__file__).open("rb") as lock:
+        if not options.dry_run:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        run_training(options)
