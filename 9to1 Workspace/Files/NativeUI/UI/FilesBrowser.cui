<Cui id="9to1.Files.NativeBrowser" version="1">
  <Actions>
    <Action name="SelectFolderTab" command="9to1.Files.Tab.Select" parameter="{Binding tab}" />
    <Action name="CloseFolderTab" command="9to1.Files.Tab.Close" parameter="{Binding tab}" />
    <Action name="RevokeDisplayedGrant" command="9to1.Files.Share.Revoke" parameter="{Binding share}" />
    <Action name="EditDisplayedGrantScope" command="9to1.Files.Share.EditScope" parameter="{Binding share}" />
    <Action name="ReviewDisplayedGrantScope" command="9to1.Files.Share.ReviewScope" />
    <Action name="CancelDisplayedGrantScope" command="9to1.Files.Share.CancelScope" />
    <Action name="ChangeDisplayedGrantRole" command="9to1.Files.Share.ChangeRole" parameter="{Binding share}" />
    <Action name="PreviewSelectedText" command="9to1.Files.Preview" />
    <Action name="CloseSelectedTextPreview" command="9to1.Files.Preview.Close" />
    <Action name="OpenSidebarFolder" command="9to1.Files.OpenSidebarFolder" parameter="{Binding folder}" />
  </Actions>
  <Page>
    <Container id="files-browser-shell" Type="Grid" RowSizes="Auto Auto 1fr Auto" Background="{Resource CuiBackgroundBrush}" AccessibleName="Files browser">
      <Container id="files-folder-tabs" Row="0" Type="Grid" ColumnSizes="1fr Auto" MinHeight="40" Padding="12 4" Background="{Resource CuiPanelBrush}">
        <Container Type="Overlay" HorizontalScrolling="True" VerticalScrolling="False">
          <Repeat Source="{Binding FolderTabs}" As="tab" Key="{Binding tab.id}" Panel="Horizontal Stack">
            <Container Type="Horizontal Stack" CellGap="4" Padding="8 2" Margin="0 0 4 0" CornerRadius="8" Background="{Resource CuiPanel2Brush}">
              <Button Content="{Binding tab.label}" Action="SelectFolderTab" Interactive="{Binding tab.canSelect}" AccessibleName="{Binding tab.label}" MinHeight="30" Chromeless="True" />
              <Button Content="×" Action="CloseFolderTab" Interactive="{Binding tab.canClose}" AccessibleName="{Binding tab.closeName}" Width="28" Height="28" Chromeless="True" />
            </Container>
          </Repeat>
        </Container>
        <Button id="files-new-tab" Column="1" Content="+" Action="9to1.Files.Tab.New" Interactive="{Binding CanNewFolderTab}" AccessibleName="Open Files root in a new tab" Width="34" Height="32" Chromeless="True" />
      </Container>
      <Container id="files-navigation" Row="1" Type="Grid" RowSizes="Auto Auto" ColumnSizes="{Binding NavigationColumns}" MinHeight="48" Padding="12 6" CellGap="8" Background="{Resource CuiPanelBrush}">
        <Container Type="Horizontal Stack" CellGap="2">
          <Button id="files-back" Content="←" Action="9to1.Files.Back" Interactive="{Binding CanBack}" AccessibleName="Previous folder" Width="36" Height="32" Chromeless="True" />
          <Button id="files-forward" Content="→" Action="9to1.Files.Forward" Interactive="{Binding CanForward}" AccessibleName="Next folder in history" Width="36" Height="32" Chromeless="True" />
          <Button id="files-up" Content="↑" Action="9to1.Files.Up" Interactive="{Binding CanUp}" AccessibleName="Go to canonical parent folder" Width="36" Height="32" Chromeless="True" />
          <Button id="files-refresh" Content="↻" Action="9to1.Files.Refresh" Interactive="{Binding CanNavigate}" AccessibleName="Refresh folder" Width="36" Height="32" Chromeless="True" />
        </Container>
        <Container id="files-address" Column="1" Type="Horizontal Stack" Padding="12 6" CornerRadius="6" Background="{Resource CuiPanel2Brush}" ClipToBounds="True" AccessibleName="Current Files location">
          <Text Text="{Binding FolderTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Container>
        <Container id="files-search-bar" Row="{Binding SearchRow}" Column="{Binding SearchColumn}" ColumnSpan="{Binding SearchColumnSpan}" Type="Grid" ColumnSizes="1fr Auto" CellGap="4">
          <Input id="files-search-input" Type="Text" AccessibleName="Search this folder" />
          <Button id="files-search" Column="1" Content="Search" Action="9to1.Files.Search" Interactive="{Binding CanNavigate}" AccessibleName="Search canonical names in this folder" />
        </Container>
      </Container>
      <Container id="files-content-layout" Row="2" Type="Grid" ColumnSizes="{Binding BodyColumns}" RowSizes="{Binding BodyRows}" CellGap="8" Padding="8">
        <Container id="files-sidebar" Type="Vertical Stack" IsVisible="{Binding SidebarVisible}" Width="240" Padding="8 12" CellGap="6" VerticalScrolling="True" Background="{Resource CuiPanelBrush}" AccessibleName="Files navigation">
          <Text Text="Locations" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" Margin="8 4" />
          <Button id="files-home" Content="Files" Action="9to1.Files.Home" Interactive="{Binding CanNavigate}" AccessibleName="Go to Files root" HorizontalContentAlignment="Left" MinHeight="36" Chromeless="True" />
          <Button id="files-trash" Content="Trash" Action="9to1.Files.Trash" Interactive="{Binding CanNavigate}" AccessibleName="Browse recoverable deleted items" HorizontalContentAlignment="Left" MinHeight="36" Chromeless="True" />
          <Text Text="{Binding SidebarHeading}" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" Margin="8 16 8 4" TextWrapping="Wrap" />
          <Repeat Source="{Binding SidebarFolders}" As="folder" Key="{Binding folder.id}" Panel="Vertical Stack">
            <Button Action="OpenSidebarFolder" Interactive="{Binding CanNavigate}" AccessibleName="{Binding folder.openName}" HorizontalContentAlignment="Left" MinHeight="34" Chromeless="True">
              <Container Type="Grid" ColumnSizes="Auto 1fr" CellGap="10"><Image Source="files:folder" Width="18" Height="18" /><Text Column="1" Text="{Binding folder.name}" TextWrapping="Wrap" /></Container>
            </Button>
          </Repeat>
        </Container>
        <Container id="files-main" Column="{Binding MainColumn}" Type="Grid" RowSizes="Auto Auto 1fr Auto" MinWidth="208" Background="{Resource CuiPanelBrush}" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="8" ClipToBounds="True">
          <Container id="files-command-bar" Type="Wrap" Padding="10 6" CellGap="6">
            <Button Content="Locations" Type="Menu Item" IsVisible="{Binding CompactLayout}" AccessibleName="Files locations">
              <Button Content="Files" Action="9to1.Files.Home" Interactive="{Binding CanNavigate}" />
              <Button Content="Trash" Action="9to1.Files.Trash" Interactive="{Binding CanNavigate}" />
            </Button>
            <Button id="files-open" Content="Open" Action="9to1.Files.Open" Interactive="{Binding CanOpen}" />
            <Button id="files-preview" Content="Preview" Action="PreviewSelectedText" Interactive="{Binding CanPreviewText}" AccessibleName="Read-only preview of selected text file" />
            <Button id="files-open-folder-tab" Content="Open in new tab" Action="9to1.Files.Tab.OpenFolder" Interactive="{Binding CanOpenFolderTab}" />
            <Button Content="New / edit" Type="Menu Item" AccessibleName="Folder and item changes">
        <Input id="files-name-input" accessible-name="Folder or item name" Type="Text" />
        <Button id="files-create-folder" content="New folder" action="9to1.Files.CreateFolder" accessible-name="Review creating a folder in Home" Interactive="{Binding CanCreateFolder}" />
        <Button id="files-rename" content="Rename" action="9to1.Files.Rename" accessible-name="Review renaming the selected item in Home" Interactive="{Binding CanRename}" />
        <Button id="files-delete" content="Move to Trash" action="9to1.Files.Delete" accessible-name="Review moving the selected item to recoverable Trash in Home" Interactive="{Binding CanDelete}" />
        <Button id="files-restore" content="Restore" action="9to1.Files.Restore" accessible-name="Review restoring the selected deleted item to its original folder in Home" Interactive="{Binding CanRestore}" />
        <Button id="files-choose-move" content="Move…" action="9to1.Files.ChooseMove" accessible-name="Choose a destination folder for the selected item" Interactive="{Binding CanChooseMove}" />
        <Button id="files-move" content="Move here" action="9to1.Files.Move" accessible-name="Review moving the original selected item into this folder in Home" Interactive="{Binding CanMove}" />
        <Button id="files-cancel-move" content="Cancel move" action="9to1.Files.CancelMove" accessible-name="Cancel choosing a move destination" Interactive="{Binding CanCancelMove}" />
        <Text text="{Binding MoveSelection}" accessible-name="Item being moved" />
        <Text text="{Binding PendingChange}" accessible-name="Pending Files change" />
        <Button id="files-apply" content="Apply" action="9to1.Files.Apply" accessible-name="Apply the original Home-reviewed Files change" Interactive="{Binding CanApply}" />
        <Button id="files-cancel-review" content="Cancel change" action="9to1.Files.CancelReview" accessible-name="Cancel the pending change before execution" Interactive="{Binding CanCancelReview}" />
        <Button id="files-retry-audit" content="Retry audit" action="9to1.Files.RetryAudit" accessible-name="Retry Home audit without repeating the Files change" Interactive="{Binding CanRetryAudit}" />
            </Button>
            <Input id="files-displayed-sort" Type="Select" AccessibleName="Sort names on this displayed page" />
          </Container>
          <Container id="files-list-header" Row="1" Type="Grid" ColumnSizes="{Binding ItemColumns}" Height="40" Padding="12 0" Background="{Resource CuiPanel2Brush}">
            <Text Text="Name" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Text Column="1" Text="Date modified" IsVisible="{Binding WideColumns}" VerticalAlignment="Center" />
            <Text Column="2" Text="Type" IsVisible="{Binding WideColumns}" VerticalAlignment="Center" />
            <Text Column="3" Text="Size" IsVisible="{Binding WideColumns}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Container>
          <Input id="files-canonical-list" Type="List" Row="2" AccessibleName="Canonical Files items" BorderWidth="0" />
          <Button id="files-next" Row="3" Content="Load more items" Action="9to1.Files.More" Interactive="{Binding CanMore}" IsVisible="{Binding CanMore}" HorizontalAlignment="Center" />
        </Container>
        <Container id="files-details-pane" MaxHeight="{Binding DetailsMaxHeight}" Column="{Binding DetailsColumn}" Row="{Binding DetailsRow}" Width="{Binding DetailsWidth}" IsVisible="{Binding HasSelection}" Type="Vertical Stack" CellGap="12" Padding="16" VerticalScrolling="True" Background="{Resource CuiPanelBrush}" AccessibleName="Selected item details">
          <Text Text="Details" FontSize="18" FontWeight="SemiBold" />
          <Button id="files-technical-details" Content="{Binding TechnicalDetailsLabel}" Action="9to1.Files.TechnicalDetails" Interactive="{Binding CanShowDetails}" HorizontalAlignment="Left" />
        <If Condition="{Binding TextPreviewVisible}">
          <Container id="files-text-preview" Type="Vertical Stack" CellGap="6" MaxHeight="280" VerticalScrolling="True" HorizontalScrolling="False" accessible-name="Read-only plain text preview">
            <Container Type="Wrap" CellGap="8">
              <Text id="files-preview-title" text="{Binding TextPreviewTitle}" FontWeight="SemiBold" />
              <Button id="files-preview-close" content="Close preview" action="CloseSelectedTextPreview" Interactive="{Binding CanCloseTextPreview}" accessible-name="Close and clear the text preview" />
            </Container>
            <Text id="files-preview-message" text="{Binding TextPreviewMessage}" TextWrapping="Wrap" />
            <Text id="files-preview-content" text="{Binding TextPreviewContent}" TextWrapping="Wrap" accessible-name="Selected file plain text; read only" />
          </Container>
        </If>
        <Text id="files-selected-details" TextWrapping="Wrap" text="{Binding SelectedDetails}" accessible-name="Selected item displayed details" />
        <Button id="files-review-access" content="Manage access" action="9to1.Files.Share.Get" accessible-name="Review direct access grants on the selected owned item" Interactive="{Binding CanReviewAccess}" />
        <If Condition="{Binding SharingVisible}">
          <Container id="files-sharing" Type="Vertical Stack" CellGap="6" MaxHeight="260" VerticalScrolling="True" HorizontalScrolling="False" accessible-name="Direct access grants">
            <Text text="{Binding SharingTitle}" />
            <Text text="These are direct grants. Parent folder access may also apply. Revocation stops future access through this grant; copies already made cannot be recalled." />
            <If Condition="{Binding SharingEmpty}"><Text text="No direct grants on this item." /></If>
            <Repeat Source="{Binding SharingGrants}" As="share" Key="{Binding share.id}" Type="Vertical Stack">
              <Container Type="Wrap" CellGap="8">
                <Text text="{Binding share.email}" accessible-name="Recipient email recorded with the grant" />
                <Text text="{Binding share.role}" accessible-name="Granted role" />
                <Text text="{Binding share.expiry}" accessible-name="Grant expiry" />
                <Text text="{Binding share.state}" accessible-name="Grant status" />
                <Button id="files-edit-share-scope" content="Edit permissions…" action="EditDisplayedGrantScope" Interactive="{Binding share.CanEditScope}" accessible-name="Edit this existing recipient’s direct role and expiry" />
                <Button content="{Binding share.changeRoleLabel}" action="ChangeDisplayedGrantRole" Interactive="{Binding share.CanChangeRole}" accessible-name="Review changing this existing recipient’s access role in Home" />
                <Button content="Revoke access…" action="RevokeDisplayedGrant" Interactive="{Binding share.CanRevoke}" accessible-name="Review revoking this direct access grant in Home" />
              </Container>
            </Repeat>
            <If Condition="{Binding ShareScopeVisible}">
              <Container id="files-share-scope-editor" Type="Vertical Stack" CellGap="6" accessible-name="Existing recipient permission editor">
                <Text text="{Binding ShareScopeRecipient}" FontWeight="SemiBold" />
                <Text text="Direct scope only. Viewer permits metadata browsing; Editor also permits scoped renaming. Content edits use the owning app’s permissions." TextWrapping="Wrap" />
                <Input id="files-share-scope-role" Type="Select" accessible-name="Existing recipient role" Interactive="{Binding CanEditShareScopeDraft}" />
                <Container Type="Horizontal Stack" CellGap="8">
                  <Input id="files-share-scope-expiry-switch" Type="Switch" Checked="{Binding ShareScopeExpiryEnabled, Mode=TwoWay}" Interactive="{Binding CanEditShareScopeDraft}" accessible-name="Expire this direct access grant" />
                  <Text text="Expire this access" />
                </Container>
                <If Condition="{Binding ShareScopeExpiryEnabled}">
                  <Input id="files-share-scope-expiry" Type="Text" placeholder-text="YYYY-MM-DDTHH:mm:ssZ" accessible-name="Future access expiry in UTC" Interactive="{Binding CanEditShareScopeDraft}" />
                </If>
                <Text text="{Binding ShareScopeHint}" TextWrapping="Wrap" />
                <Container Type="Wrap" CellGap="8">
                  <Button id="files-review-share-scope" content="Review change in Home" action="ReviewDisplayedGrantScope" Interactive="{Binding CanReviewShareScope}" />
                  <Button id="files-cancel-share-scope" content="Cancel edit" action="CancelDisplayedGrantScope" Interactive="{Binding CanCancelShareScope}" />
                </Container>
              </Container>
            </If>
            <Container Type="Wrap" CellGap="8">
              <Button id="files-more-access" content="More grants" action="9to1.Files.Share.More" Interactive="{Binding CanReadMoreGrants}" />
              <Button id="files-close-access" content="Close access" action="9to1.Files.Share.Close" Interactive="{Binding CanCloseAccess}" />
              <Button id="files-add-recipient" content="Add recipient" Interactive="False" accessible-name="Adding recipients is not available with this profile yet" />
            </Container>
            <Text text="Adding recipients is not available with this profile yet. Existing recipients’ direct access can be reviewed, changed or revoked here. Permission edits replace that recipient’s previous direct grants on this item. Quick role changes keep the current expiry; Edit permissions can change or remove it. Inherited access may still apply. Viewer permits metadata browsing; Editor also permits scoped renaming. Document and content edits require their separate app permissions. No invitation will be sent." />
          </Container>
        </If>
        </Container>
      </Container>
      <Container Row="3" Type="Horizontal Stack" Height="32" Padding="16 4" Background="{Resource CuiPanelBrush}" CellGap="12">
        <Text id="files-status" Text="{Binding Status}" AccessibleName="Files operation status" VerticalAlignment="Center" />
      </Container>
    </Container>
  </Page>
</Cui>
