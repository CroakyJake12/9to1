<Cui id="9to1.Files.NativeBrowser" version="1">
  <Page>
    <Container id="files-browser-shell" accessible-name="Files browser" Type="Grid" RowSizes="Auto Auto Auto 1fr Auto Auto">
      <Container orientation="Horizontal" Type="Wrap">
        <Button id="files-home" content="Files" action="9to1.Files.Home" accessible-name="Go to Files root" Interactive="{Binding CanNavigate}" />
        <Button id="files-up" content="Up" action="9to1.Files.Up" accessible-name="Go to canonical parent folder" Interactive="{Binding CanUp}" />
        <Button id="files-back" content="Back" action="9to1.Files.Back" accessible-name="Previous folder" Interactive="{Binding CanBack}" />
        <Button id="files-forward" content="Forward" action="9to1.Files.Forward" accessible-name="Next folder in history" Interactive="{Binding CanForward}" />
        <Button id="files-refresh" content="Refresh" action="9to1.Files.Refresh" accessible-name="Refresh canonical Files metadata" Interactive="{Binding CanNavigate}" />
        <Button id="files-open" content="Open" action="9to1.Files.Open" accessible-name="Open selected canonical item" Interactive="{Binding CanOpen}" />
        <Button id="files-next" content="More" action="9to1.Files.More" accessible-name="Load next Files page" Interactive="{Binding CanMore}" />
        <Text text="{Binding FolderTitle}" accessible-name="Current folder" />
      </Container>
      <Container Type="Horizontal Stack" Row="1">
        <Input id="files-search-input" accessible-name="Search this folder" Type="Text" />
        <Input id="files-displayed-sort" accessible-name="Sort names on this displayed page" Type="Select" />
        <Button id="files-search" content="Search" action="9to1.Files.Search" accessible-name="Search canonical names in this folder" Interactive="{Binding CanNavigate}" />
      </Container>
      <Container orientation="Horizontal" accessible-name="Folder and item changes" Type="Wrap" Row="2">
        <Input id="files-name-input" accessible-name="Folder or item name" Type="Text" />
        <Button id="files-create-folder" content="New folder" action="9to1.Files.CreateFolder" accessible-name="Review creating a folder in Home" Interactive="{Binding CanCreateFolder}" />
        <Button id="files-rename" content="Rename" action="9to1.Files.Rename" accessible-name="Review renaming the selected item in Home" Interactive="{Binding CanRename}" />
        <Text text="{Binding PendingChange}" accessible-name="Pending Files change" />
        <Button id="files-apply" content="Apply" action="9to1.Files.Apply" accessible-name="Apply the original Home-reviewed Files change" Interactive="{Binding CanApply}" />
        <Button id="files-cancel-review" content="Cancel change" action="9to1.Files.CancelReview" accessible-name="Cancel the pending change before execution" Interactive="{Binding CanCancelReview}" />
        <Button id="files-retry-audit" content="Retry audit" action="9to1.Files.RetryAudit" accessible-name="Retry Home audit without repeating the Files change" Interactive="{Binding CanRetryAudit}" />
      </Container>
      <Input id="files-canonical-list" accessible-name="Canonical Files items" Type="List" Row="3" />
      <Text id="files-selected-details" text="{Binding SelectedDetails}" accessible-name="Selected item displayed details" Row="4" />
      <Text id="files-status" text="{Binding Status}" accessible-name="Files operation status" Row="5" />
    </Container>
  </Page>
</Cui>
