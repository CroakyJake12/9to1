<Cui id="9to1.Files.DetailsRow" version="1">
  <Page>
    <Container id="files-details-row" Type="Grid" ColumnSizes="{Binding Columns}" RowSizes="{Binding Rows}" MinHeight="{Binding RowMinimumHeight}" Padding="{Binding RowPadding}" CellGap="10" AccessibleName="{Binding Name}">
      <Container id="files-row-name-cell" Type="Grid" ColumnSizes="{Binding NameColumns}" RowSizes="{Binding NameRows}" CellGap="10">
        <Image id="files-row-folder-artwork" Source="files:folder-outline" IsVisible="{Binding IsFolder}" Width="{Binding ArtworkSize}" Height="{Binding ArtworkSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Container id="files-row-file-artwork" IsVisible="{Binding IsFile}" Type="Grid" Width="{Binding ArtworkSize}" Height="{Binding ArtworkSize}" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{Resource CuiPanel2Brush}" CornerRadius="4">
          <Text id="files-row-file-badge" Text="{Binding FileBadge}" FontSize="{Binding BadgeSize}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Container>
        <Text id="files-row-name" Row="{Binding NameRow}" Column="{Binding NameColumn}" Text="{Binding Name}" FontSize="14" FontWeight="Medium" HorizontalAlignment="{Binding NameAlignment}" TextAlignment="{Binding NameTextAlignment}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Container>
      <Text id="files-row-modified" IsVisible="{Binding ShowMetadata}" Column="1" Text="{Binding Modified}" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Text id="files-row-size" IsVisible="{Binding ShowMetadata}" Column="2" Text="{Binding Size}" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Text id="files-row-availability" Row="{Binding AvailabilityRow}" Column="{Binding AvailabilityColumn}" Text="{Binding Availability}" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" HorizontalAlignment="{Binding AvailabilityAlignment}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Container>
  </Page>
</Cui>
