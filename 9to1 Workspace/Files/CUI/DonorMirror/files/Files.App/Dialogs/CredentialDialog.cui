<Cui id="dialogs-credential-dialog" product="9-1" version="1">
  <Page id="dialogs-credential-dialog-root">
    <Container id="contentdialog" Type="Vertical Stack">
      <Container id="grid" Type="Grid">
        <Container id="grid.rowdefinitions" Type="Vertical Stack">
          <Text id="rowdefinition" />
          <Text id="rowdefinition-2" />
        </Container>
        <Text id="textblock" text="{helpers:ResourceString Name=CredentialDialogDescription/Text}" />
        <Container id="stackpanel" Type="Vertical Stack" row="1" horizontal-alignment="Stretch">
          <Input id="textbox" Type="Text" margin="4" is-enabled="{Binding ViewModel.IsAnonymous}" placeholder-text="{helpers:ResourceString Name=CredentialDialogUserName/PlaceholderText}" text="{Binding ViewModel.UserName}" />
          <Input id="passwordbox" Type="Text" margin="4" is-enabled="{Binding ViewModel.IsAnonymous}" placeholder-text="{helpers:ResourceString Name=Password}" />
          <Text id="textblock-2" margin="4" foreground="{ThemeResource SystemFillColorCriticalBrush}" text="{helpers:ResourceString Name=CredentialDialogIncorrectPassword}" />
          <Input id="checkbox" Type="Checkbox" margin="4" content="{helpers:ResourceString Name=CredentialDialogAnonymous/Content}" />
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
