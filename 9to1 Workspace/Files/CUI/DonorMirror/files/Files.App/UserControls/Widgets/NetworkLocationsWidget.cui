<Cui id="widgets-network-locations-widget" product="9-1" version="1">
  <Actions>
    <Action name="no-network-locations-info-bar-button-click" command="NoNetworkLocationsInfoBarButton_Click" />
  </Actions>
  <Page id="widgets-network-locations-widget-root">
    <Container id="usercontrol" Type="Vertical Stack">
      <Container id="grid" Type="Grid">
        <Container id="infobar" Type="Horizontal Stack">
          <Container id="grid-2" Type="Grid">
