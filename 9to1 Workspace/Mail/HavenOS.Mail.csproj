<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>HavenOS.Mail</AssemblyName>
    <RootNamespace>HavenOS.Mail</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <PackageReference Include="MailKit" VersionOverride="4.18.0" />
    <PackageReference Include="HtmlSanitizer" VersionOverride="9.2.1039" />
    <!-- Lifts MimeKit's vulnerable transitive 10.0.0 pin; see Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <ProjectReference Include="..\..\framework\CUI\Core\CakeOS.Cui.Core.csproj" />
    <ProjectReference Include="..\..\framework\CUI\AI\NineToOne.Cui.AI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="UI\MailWorkspace.cui">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
