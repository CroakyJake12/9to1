<Cui id="9to1.Canvas.NativeHost" version="1">
  <Page>
    <Container id="canvas-native-host" accessible-name="Canvas" Type="Grid" RowSizes="Auto Auto 1fr Auto" ColumnSizes="2fr 1fr">
      <Container orientation="Horizontal" Type="Wrap" ColumnSpan="2">
        <Button content="Refresh Canvases" action="canvas.host.refresh" Interactive="{Binding CanNavigate}" />
        <Button content="Set up Canvases" action="canvas.host.setup" Interactive="{Binding CanSetup}" />
        <Button content="Review Files ownership" action="canvas.host.reviewOwnership" Interactive="{Binding CanReviewWorkspace}" />
        <Button content="Create canvas" action="canvas.host.create" Interactive="{Binding CanWrite}" />
        <Button content="Finish approved request" action="canvas.host.finish" Interactive="{Binding CanFinish}" />
      </Container>
      <Container Type="Vertical Stack" Row="1" ColumnSpan="2" CellGap="6">
        <Container Type="Horizontal Stack" CellGap="8">
          <Button content="Previous document" action="canvas.host.previous" Interactive="{Binding CanPrevious}" />
          <Text text="{Binding SelectedName}" />
          <Button content="Next document" action="canvas.host.next" Interactive="{Binding CanNext}" />
          <Button content="Open selected" action="canvas.host.open" Interactive="{Binding CanOpen}" />
          <Button content="Next page" action="canvas.host.page" Interactive="{Binding CanPage}" />
        </Container>
        <Container Type="Horizontal Stack" CellGap="8">
          <Text text="New canvas name" />
          <Input id="canvas-host-new-name" accessible-name="New canvas name" Type="Text" Value="{Binding NewName, Mode=TwoWay}" Interactive="{Binding CanWrite}" />
        </Container>
      </Container>
      <Container id="canvas-native-content" accessible-name="Canvas document and requests" Type="Overlay" Row="2" />
      <Container id="canvas-home-approvals" accessible-name="Home approvals" Type="Overlay" Row="2" Column="1" />
      <Text text="{Binding Status}" text-wrapping="Wrap" Row="3" ColumnSpan="2" />
    </Container>
  </Page>
</Cui>
