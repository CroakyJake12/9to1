<Cui id="9to1.Canvas.Workspace" version="1">
  <Page>
    <Container id="canvas-shell" accessible-name="Canvas workspace" Type="Grid" RowSizes="Auto 1fr Auto">
      <Container id="canvas-document-controls" orientation="Horizontal" Type="Wrap">
        <Button id="canvas-open" action="9to1.Canvas.Artifact.Open" content="Open" accessible-name="Open Canvas artifact through Files" Interactive="{Binding CanOpen}" />
        <Button id="canvas-import" action="9to1.Canvas.Import" content="Import" accessible-name="Import Rnote or Xournal++ document" Interactive="{Binding CanImport}" />
        <Text id="canvas-title" text="{Binding DisplayName}" accessible-name="Canvas document name" />
        <Button id="canvas-save" action="9to1.Canvas.Artifact.Save" content="Flush" accessible-name="Flush Canvas revision to Files" Interactive="{Binding CanFlush}" />
        <Button id="canvas-undo" action="9to1.Canvas.History.Undo" content="Undo" accessible-name="Undo Canvas document operation" Interactive="{Binding CanUndo}" />
        <Button id="canvas-redo" action="9to1.Canvas.History.Redo" content="Redo" accessible-name="Redo Canvas document operation" Interactive="{Binding CanRedo}" />
        <Button id="canvas-fit" action="9to1.Canvas.View.Fit" content="Fit" accessible-name="Fit the canvas in this view" Interactive="{Binding CanFitView}" />
        <Button id="canvas-zoom-out" action="9to1.Canvas.View.ZoomOut" content="−" accessible-name="Zoom out the canvas view" Interactive="{Binding CanZoomOut}" />
        <Button id="canvas-zoom-in" action="9to1.Canvas.View.ZoomIn" content="+" accessible-name="Zoom in the canvas view" Interactive="{Binding CanZoomIn}" />
      </Container>
      <Object id="canvas-surface" accessible-name="Editable Canvas drawing surface" Type="CanvasSpatialSurface" Row="1" />
      <Button id="canvas-ai-indicator" horizontal-alignment="Right" vertical-alignment="Top" margin="12" action="9to1.Canvas.Tool.ai" content="{Binding AiIndicatorLabel}" accessible-name="Restore existing Canvas AI session" Row="1" Interactive="{Binding CanAITool}" Active="{Binding AiIndicatorVisible}" />
      <Container id="canvas-floating-tools" horizontal-alignment="Center" vertical-alignment="Bottom" margin="12" Type="Vertical Stack" Row="1" CellGap="8">
        <Container id="canvas-tool-options" background="{Resource CuiPanelBrush}" padding="12" corner-radius="12" accessible-name="Canvas contextual tool options" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" Active="{Binding ToolOptionsVisible}">
          <Container Type="Vertical Stack" CellGap="4">
            <Text text="{Binding SelectedToolName}" accessible-name="Selected Canvas tool" />
            <Text text="{Binding ToolOptionsSummary}" text-wrapping="Wrap" accessible-name="Current tool options" />
            <Container Type="Vertical Stack" CellGap="6" Active="{Binding SelectionOptionsVisible}">
              <Container Type="Wrap" CellGap="6">
                <Button action="9to1.Canvas.Selection.Previous" content="Previous selection" accessible-name="Select previous visible stroke" Interactive="{Binding CanChooseSelection}" />
                <Button action="9to1.Canvas.Selection.Next" content="Next selection" accessible-name="Select next visible stroke" Interactive="{Binding CanChooseSelection}" />
                <Button action="9to1.Canvas.Selection.Clear" content="Clear selection" accessible-name="Clear Canvas selection without changing ink" Interactive="{Binding CanClearSelection}" />
              </Container>
              <Text text="{Binding SelectedStrokeSummary}" text-wrapping="Wrap" accessible-name="Selected stroke information" />
              <Container Type="Wrap" CellGap="6">
                <Button action="9to1.Canvas.Selection.Left" content="←" accessible-name="Preview selected stroke ten units left" Interactive="{Binding CanNudgeSelection}" />
                <Button action="9to1.Canvas.Selection.Right" content="→" accessible-name="Preview selected stroke ten units right" Interactive="{Binding CanNudgeSelection}" />
                <Button action="9to1.Canvas.Selection.Up" content="↑" accessible-name="Preview selected stroke ten units up" Interactive="{Binding CanNudgeSelection}" />
                <Button action="9to1.Canvas.Selection.Down" content="↓" accessible-name="Preview selected stroke ten units down" Interactive="{Binding CanNudgeSelection}" />
                <Button action="9to1.Canvas.Selection.Move" content="Review move" accessible-name="Review the exact selected stroke move in Home" Interactive="{Binding CanReviewSelectionMove}" />
                <Button action="9to1.Canvas.Selection.Delete" content="Review delete" accessible-name="Review deletion of the exact selected stroke in Home" Interactive="{Binding CanDeleteSelection}" />
              </Container>
              <Text text="{Binding SelectionMoveSummary}" text-wrapping="Wrap" accessible-name="Selected stroke move preview" />
              <Text text="{Binding SelectionFeedbackStatus}" text-wrapping="Wrap" accessible-name="Canvas selection contour and move-preview status" />
              <Text text="{Binding SelectionInputStatus}" text-wrapping="Wrap" accessible-name="Selection input status" />
            </Container>
            <Container orientation="Horizontal" Type="Wrap" Active="{Binding EraserOptionsVisible}">
              <Button action="9to1.Canvas.Erase.Natural" content="Natural" accessible-name="Natural eraser mode" Interactive="{Binding CanNaturalErase}" />
              <Button action="9to1.Canvas.Erase.Quick" content="Quick" accessible-name="Quick eraser mode" Interactive="{Binding CanQuickErase}" />
              <Button action="9to1.Canvas.Erase.Whole" content="Whole stroke" accessible-name="Erase whole colliding strokes" Interactive="{Binding CanWholeErase}" />
              <Button action="9to1.Canvas.Erase.Partial" content="Partial stroke" accessible-name="Erase colliding stroke segments" Interactive="{Binding CanPartialErase}" />
              <Button action="9to1.Canvas.Erase.Narrower" content="Narrower" accessible-name="Decrease eraser width" Interactive="{Binding CanEditEraser}" />
              <Button action="9to1.Canvas.Erase.Wider" content="Wider" accessible-name="Increase eraser width" Interactive="{Binding CanEditEraser}" />
            </Container>
            <Container orientation="Horizontal" Type="Wrap" Active="{Binding EraserOptionsVisible}">
              <Button action="9to1.Canvas.Erase.Previous" content="Previous stroke" accessible-name="Choose previous stroke for Quick erasing" Interactive="{Binding CanChooseEraseTarget}" />
              <Button action="9to1.Canvas.Erase.Next" content="Next stroke" accessible-name="Choose next stroke for Quick erasing" Interactive="{Binding CanChooseEraseTarget}" />
              <Text text="{Binding EraseTargetSummary}" text-wrapping="Wrap" accessible-name="Chosen Quick eraser stroke" />
              <Button action="9to1.Canvas.Erase.Chosen" content="Erase chosen stroke" accessible-name="Review deletion of chosen stroke in Home" Interactive="{Binding CanEraseChosenTarget}" />
            </Container>
            <Text text="{Binding EraseInputStatus}" text-wrapping="Wrap" accessible-name="Eraser input status" Active="{Binding EraserOptionsVisible}" />
            <Container Type="Horizontal Stack" CellGap="4" Active="{Binding PenOptionsVisible}">
              <Button action="9to1.Canvas.Ink.Solid" content="Solid" accessible-name="Use solid ink" Interactive="{Binding CanEditInk}" />
              <Button action="9to1.Canvas.Ink.Marker" content="Marker" accessible-name="Use marker ink" Interactive="{Binding CanEditInk}" />
              <Button action="9to1.Canvas.Ink.Black" content="Black" accessible-name="Use black ink" Interactive="{Binding CanEditInk}" />
              <Button action="9to1.Canvas.Ink.Red" content="Red" accessible-name="Use red ink" Interactive="{Binding CanEditInk}" />
              <Button action="9to1.Canvas.Ink.Blue" content="Blue" accessible-name="Use blue ink" Interactive="{Binding CanEditInk}" />
            </Container>
            <Container Type="Horizontal Stack" CellGap="4" Active="{Binding PenOptionsVisible}">
              <Button action="9to1.Canvas.Ink.Narrower" content="Narrower" accessible-name="Decrease pen width" Interactive="{Binding CanEditInk}" />
              <Button action="9to1.Canvas.Ink.Wider" content="Wider" accessible-name="Increase pen width" Interactive="{Binding CanEditInk}" />
              <Button action="9to1.Canvas.Ink.LessOpaque" content="Less opaque" accessible-name="Decrease ink opacity" Interactive="{Binding CanEditInk}" />
              <Button action="9to1.Canvas.Ink.MoreOpaque" content="More opaque" accessible-name="Increase ink opacity" Interactive="{Binding CanEditInk}" />
            </Container>
          </Container>
        </Container>
        <Container id="canvas-primary-toolbar" background="{Resource CuiPanelBrush}" padding="12" corner-radius="12" accessible-name="Canvas primary tools" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1">
          <Container Type="Horizontal Stack" CellGap="8">
            <Button id="canvas-tool-select" action="9to1.Canvas.Tool.select" content="{Binding SelectToolLabel}" accessible-name="Select tool" Interactive="{Binding CanSelectTool}" />
            <Button id="canvas-tool-pan" action="9to1.Canvas.Tool.pan" content="{Binding PanToolLabel}" accessible-name="Pan tool" Interactive="{Binding CanPanTool}" />
            <Button id="canvas-tool-pen" action="9to1.Canvas.Tool.pen" content="{Binding PenToolLabel}" accessible-name="Pen tool" Interactive="{Binding CanPenTool}" />
            <Button id="canvas-tool-eraser" action="9to1.Canvas.Tool.eraser" content="{Binding EraserToolLabel}" accessible-name="Eraser tool" Interactive="{Binding CanEraserTool}" />
            <Button id="canvas-tool-insert" action="9to1.Canvas.Tool.insert" content="{Binding InsertToolLabel}" accessible-name="Insert tool" Interactive="{Binding CanInsertTool}" />
            <Button id="canvas-tool-tools" action="9to1.Canvas.Tool.tools" content="{Binding ToolsToolLabel}" accessible-name="Specialised tools" Interactive="{Binding CanToolsTool}" />
            <Button id="canvas-tool-ai" action="9to1.Canvas.Tool.ai" content="{Binding AIToolLabel}" accessible-name="Canvas contextual AI" Interactive="{Binding CanAITool}" />
          </Container>
        </Container>
        <Text text="{Binding ToolCapabilityStatus}" text-wrapping="Wrap" accessible-name="Tool capability status" />
      </Container>
      <Container id="canvas-status" Type="Vertical Stack" Row="2" CellGap="4">
        <Text id="canvas-storage-status" text="{Binding PersistenceStatus}" accessible-name="Canvas persistence state" />
        <Text id="canvas-compatibility" text="{Binding CompatibilityStatus}" accessible-name="Canvas compatibility report" />
        <Text id="canvas-selection" text="{Binding SelectionSummary}" accessible-name="Canvas selected object information" />
      </Container>
    </Container>
  </Page>
</Cui>
