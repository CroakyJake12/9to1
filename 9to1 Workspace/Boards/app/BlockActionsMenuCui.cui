<Cui>
  <!-- The owner's 29 October block menu, in the mockup's order: Delete, Duplicate, Move Block (opens
       underneath), a divider, then Design (opens underneath). It is authored here rather than built in
       code so the rows, icons, spacing and submenu expansion stay in CUI. The hosting surface itself is
       the C#-owned Popup in BlockGripCui.cs - the same reviewed boundary used by BoardProperties
       (Program.cs:694) and the insert menu (ToolbarBuilder.cs:409), because a 232-unit list cannot live
       inside the 32-unit block gutter column. -->
  <Actions>
    <Action name="ToggleMoveMenu" command="ToggleMoveMenu" />
    <Action name="ToggleDesignMenu" command="ToggleDesignMenu" />
    <Action name="MoveUp" command="ApplyBlockAction" parameter="{Binding MoveUpRequest}" />
    <Action name="MoveDown" command="ApplyBlockAction" parameter="{Binding MoveDownRequest}" />
    <Action name="Duplicate" command="ApplyBlockAction" parameter="{Binding DuplicateRequest}" />
    <Action name="Delete" command="ApplyBlockAction" parameter="{Binding DeleteRequest}" />
    <Action name="TurnIntoText" command="TurnInto:paragraph" />
    <Action name="TurnIntoHeading" command="TurnInto:heading" />
    <Action name="TurnIntoChecklist" command="TurnInto:checklist" />
    <Action name="TurnIntoBulleted" command="TurnInto:bulleted" />
    <Action name="TurnIntoNumbered" command="TurnInto:numbered" />
    <Action name="TurnIntoTable" command="TurnInto:table" />
    <Action name="TurnIntoImage" command="TurnInto:image" />
    <Action name="TurnIntoDivider" command="TurnInto:divider" />
  </Actions>
  <Page>
    <Container Type="Vertical Stack" ID="BlockActionMenu" CellGap="2" Width="232" Padding="8"
               CornerRadius="10" BorderWidth="1" BorderColor="{Resource CuiLineBrush}"
               Background="{Resource CuiFloatingSurfaceMaterial}" AccessibleName="Block actions">
      <Button Type="Menu Item" ID="BlockDelete" Content="Delete" IconSource="icon:delete" Action="Delete"
              IsEnabled="{Binding CanManage}" AccessibleName="Delete block" Height="34" MinHeight="34" />
      <Button Type="Menu Item" ID="BlockDuplicate" Content="Duplicate" IconSource="icon:duplicate" Action="Duplicate"
              IsEnabled="{Binding CanManage}" AccessibleName="Duplicate block" Height="34" MinHeight="34" />
      <Button Type="Menu Item" ID="BlockMoveMenuToggle" Content="Move Block" IconSource="icon:move"
              Action="ToggleMoveMenu" IsEnabled="{Binding CanManage}" AccessibleName="Move block menu"
              Height="34" MinHeight="34" AccessibleDescription="{Binding MoveMenuDescription}" />
      <Container Type="Vertical Stack" ID="BlockMoveMenu" CellGap="2" Active="{Binding IsMoveExpanded}"
                 AccessibleName="Move block submenu" Padding="26 0 0 0">
        <Button Type="Menu Item" ID="BlockMoveUp" Content="Move up" IconSource="icon:chevron-down" Action="MoveUp"
                IsEnabled="{Binding CanMoveUp}" AccessibleName="Move block up" Height="30" MinHeight="30" />
        <Button Type="Menu Item" ID="BlockMoveDown" Content="Move down" IconSource="icon:chevron-down" Action="MoveDown"
                IsEnabled="{Binding CanMoveDown}" AccessibleName="Move block down" Height="30" MinHeight="30" />
      </Container>
      <Container Type="Vertical Stack" ID="BlockActionDivider" Height="1" BorderWidth="0"
                 Background="{Resource CuiLineBrush}" Margin="4 6" />
      <Button Type="Menu Item" ID="BlockDesignMenuToggle" Content="Design" IconSource="icon:palette"
              Action="ToggleDesignMenu" IsEnabled="{Binding CanManage}" AccessibleName="Design block menu"
              Height="34" MinHeight="34" AccessibleDescription="{Binding DesignMenuDescription}" />
      <Container Type="Vertical Stack" ID="BlockDesignMenu" CellGap="2" Active="{Binding IsDesignExpanded}"
                 AccessibleName="Design block submenu" Padding="26 0 0 0">
        <Text Text="TURN INTO" FontSize="11" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}"
              Margin="0 2" />
        <Button Type="Menu Item" ID="BlockTurnIntoText" Content="Text" IconSource="icon:bold" Action="TurnIntoText"
                IsEnabled="{Binding CanConvertText}" AccessibleDescription="{Binding ConvertTextDescription}"
                AccessibleName="Turn block into text" Height="30" MinHeight="30" />
        <Button Type="Menu Item" ID="BlockTurnIntoHeading" Content="Heading" IconSource="icon:edit" Action="TurnIntoHeading"
                IsEnabled="{Binding CanConvertHeading}" AccessibleDescription="{Binding ConvertHeadingDescription}"
                AccessibleName="Turn block into heading" Height="30" MinHeight="30" />
        <Button Type="Menu Item" ID="BlockTurnIntoChecklist" Content="Checklist" IconSource="icon:check" Action="TurnIntoChecklist"
                IsEnabled="{Binding CanConvertChecklist}" AccessibleDescription="{Binding ConvertChecklistDescription}"
                AccessibleName="Turn block into checklist" Height="30" MinHeight="30" />
        <Button Type="Menu Item" ID="BlockTurnIntoBulleted" Content="Bulleted list" IconSource="icon:bulleted-list" Action="TurnIntoBulleted"
                IsEnabled="{Binding CanConvertBulleted}" AccessibleDescription="{Binding ConvertBulletedDescription}"
                AccessibleName="Turn block into bulleted list" Height="30" MinHeight="30" />
        <Button Type="Menu Item" ID="BlockTurnIntoNumbered" Content="Numbered list" IconSource="icon:numbered-list" Action="TurnIntoNumbered"
                IsEnabled="{Binding CanConvertNumbered}" AccessibleDescription="{Binding ConvertNumberedDescription}"
                AccessibleName="Turn block into numbered list" Height="30" MinHeight="30" />
        <Button Type="Menu Item" ID="BlockTurnIntoTable" Content="Table" IconSource="icon:table" Action="TurnIntoTable"
                IsEnabled="{Binding CanConvertTable}" AccessibleDescription="{Binding ConvertTableDescription}"
                AccessibleName="Turn block into table" Height="30" MinHeight="30" />
        <Button Type="Menu Item" ID="BlockTurnIntoImage" Content="Image" IconSource="icon:image" Action="TurnIntoImage"
                IsEnabled="{Binding CanConvertImage}" AccessibleDescription="{Binding ConvertImageDescription}"
                AccessibleName="Turn block into image" Height="30" MinHeight="30" />
        <Button Type="Menu Item" ID="BlockTurnIntoDivider" Content="Divider" IconSource="icon:align-left" Action="TurnIntoDivider"
                IsEnabled="{Binding CanConvertDivider}" AccessibleDescription="{Binding ConvertDividerDescription}"
                AccessibleName="Turn block into divider" Height="30" MinHeight="30" />
      </Container>
    </Container>
  </Page>
</Cui>
