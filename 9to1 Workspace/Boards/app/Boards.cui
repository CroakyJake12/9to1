<Cui>
  <Grid columndefinitions="280,*" rowdefinitions="Auto,*,Auto">

    <!-- Top document bar: file actions, title, save state, global actions -->
    <Border automationid="TopBar" grid-row="0" grid-column="0" grid-columnspan="2" padding="12 8">
      <Grid columndefinitions="Auto,*,Auto">
        <StackPanel automationid="TopBarLeft" grid-column="0" orientation="Horizontal" />
        <TextBox id="BoardTitleBox" automationid="BoardTitleBox" accessible-name="Board title" grid-column="1" text="{Binding BoardTitle, fallback=Untitled board}" font-size="20" font-weight="SemiBold" borderthickness="0" vertical-alignment="Center" margin="12 0" />
        <StackPanel automationid="TopBarRight" grid-column="2" orientation="Horizontal" />
      </Grid>
    </Border>

    <!-- Left navigation: search, sections/pages (built in code), add actions -->
    <Border automationid="NavPane" grid-row="1" grid-column="0" padding="8">
      <StackPanel orientation="Vertical">
        <TextBox id="NavSearchBox" automationid="NavSearchBox" accessible-name="Search sections and pages" placeholdertext="Search" margin="0 0 0 8" />
        <ScrollViewer verticalalignment="Stretch">
          <StackPanel automationid="NavHost" orientation="Vertical" />
        </ScrollViewer>
        <Button content="+ New" action="NewMenu" automationid="AddNewButton" accessible-name="New content" margin="0 8 0 0" />
      </StackPanel>
    </Border>

    <!-- Editor column: contextual toolbar, context panel, document canvas -->
    <Grid grid-row="1" grid-column="1" rowdefinitions="Auto,Auto,*">
      <StackPanel automationid="ToolbarHost" grid-row="0" orientation="Vertical" />
      <StackPanel automationid="ContextHost" grid-row="1" orientation="Vertical" />
      <ScrollViewer automationid="EditorScroll" grid-row="2" verticalalignment="Stretch" horizontalalignment="Stretch">
        <Border automationid="PageCard" horizontalalignment="Stretch" cornerradius="0" borderthickness="0" padding="0" margin="0">
          <Grid automationid="PageSurface">
            <StackPanel automationid="DocumentContentLayer" orientation="Vertical" margin="40 32">
              <TextBlock text="{Binding PageTitle, fallback=Welcome}" font-size="28" font-weight="Bold" margin="0 0 0 4" />
              <StackPanel automationid="BlocksHost" orientation="Vertical" />
            </StackPanel>
            <Canvas automationid="InkOverlayLayer" />
          </Grid>
        </Border>
      </ScrollViewer>
    </Grid>

    <!-- Minimal status footer -->
    <Border automationid="FooterBar" grid-row="2" grid-column="0" grid-columnspan="2" padding="12 6">
      <StackPanel orientation="Horizontal">
        <TextBlock text="{Binding SaveStateText, fallback=Saved}" font-size="12" font-weight="SemiBold" vertical-alignment="Center" />
      </StackPanel>
    </Border>

  </Grid>
</Cui>
