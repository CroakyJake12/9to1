<Cui>
  <Actions>
    <Action name="FinishBoardRename" command="FinishBoardRename" parameter="{Binding Event}" />
    <Action name="OpenRecentBoard" command="OpenRecentBoard" parameter="{Binding board.Target}" />
    <Action name="OpenRecentPage" command="OpenRecentPage" parameter="{Binding page.Target}" />
    <Action name="ApplySectionIconChoice" command="ApplySectionIconChoice" parameter="{Binding icon.Key}" />
    <Action name="ApplySectionIconColor" command="ApplySectionIconColor" parameter="{Binding color.Hex}" />
    <Action name="ApplyGeneratedSectionIcon" command="ApplyGeneratedSectionIcon" parameter="{Binding generated.Index}" />
    <Action name="UseThemeSectionIconColor" command="UseThemeSectionIconColor" />
    <Action name="CloseSectionIconPicker" command="CloseSectionIconPicker" />
  </Actions>
  <Page>
    <Container Type="Grid" ColumnSizes="268 1fr" RowSizes="Auto 1fr" Background="{Resource CuiWorkspaceMaterial}">
      <!-- One document identity menu on both standalone and embedded Boards. -->
      <Container Type="Overlay" ID="TopBar" Row="0" Column="0" ColumnSpan="2" Padding="12 6" Background="Transparent" BorderWidth="0">
        <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="8">
          <Container Type="Grid" ID="TopBarLeft" Column="0" ColumnSizes="Auto 1fr Auto Auto" CellGap="6" MaxWidth="580" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Image ID="BoardsAppIcon" Column="0" Source="ownerbrand:boards" Width="24" Height="24" VerticalAlignment="Center" AccessibleName="Boards" />
            <Container Type="Vertical Stack" Column="1" CellGap="1">
              <Container Type="Menu" ID="BoardSwitcherMenu" HorizontalAlignment="Left">
                <Button Type="Menu Item" ID="BoardSwitcher" Content="{Binding BoardMenuTitle, fallback=Boards ▾}" Padding="8 4" MaxWidth="340" FontWeight="SemiBold" IsEnabled="{Binding CanOpenBoardMenu}" Interactive="{Binding CanOpenBoardMenu}" AccessibleName="Current Board actions" Tooltip="{Binding BoardTitle}">
            <Button Type="Menu Item" ID="BoardSwitcherSave" Content="Save" Action="SaveBoard" Shortcut="Ctrl+S" IsEnabled="{Binding CanSaveBoard}" Interactive="{Binding CanSaveBoard}" AccessibleName="Save this board" ToolTip="Save this board (Ctrl+S)" />
            <Button Type="Menu Item" ID="BoardSwitcherSaveAs" Content="Save As…" Action="SaveAsBoard" Shortcut="Ctrl+Shift+S" IsEnabled="{Binding CanSaveAs}" Interactive="{Binding CanSaveAs}" AccessibleName="Save this board to a file you choose" ToolTip="Save this board to a file you choose (Ctrl+Shift+S)" />
            <Button Type="Menu Item" ID="BoardSwitcherCreate" Content="New Board…" Action="NewBoard" IsEnabled="{Binding CanCreateBoard}" Interactive="{Binding CanCreateBoard}" AccessibleName="Create a separate Board" />
              <Button Type="Menu Item" ID="BoardSwitcherOpen" Content="Open Board…" Action="OpenBoard" IsEnabled="{Binding CanSwitchBoard}" Interactive="{Binding CanSwitchBoard}" AccessibleName="Open an existing Board" />
              <Button Type="Menu Item" ID="BoardSwitcherAll" Content="All Boards…" Action="ShowLanding" IsEnabled="{Binding CanSwitchBoard}" Interactive="{Binding CanSwitchBoard}" AccessibleName="Browse and switch Boards" />
              <Button Type="Menu Item" ID="BoardSwitcherRetryOpen" Active="{Binding CanRetryHomeBoardOpen}" Content="Retry opening created Board" Action="RetryOpenCreatedBoard" IsEnabled="{Binding CanRetryHomeBoardOpen}" Interactive="{Binding CanRetryHomeBoardOpen}" AccessibleName="Retry opening the same created Board" />
              <Button Type="Menu Item" ID="BoardSwitcherRetrySave" Active="{Binding CanRetryBoardCreationSettlement}" Content="Retry finishing Board save" Action="RetryBoardCreationSettlement" IsEnabled="{Binding CanRetryBoardCreationSettlement}" Interactive="{Binding CanRetryBoardCreationSettlement}" AccessibleName="Retry finishing the Board save" />
              <Button Type="Menu Item" ID="BoardSwitcherCheck" Active="{Binding CanCheckSavedBoard}" Content="Check saved Board" Action="CheckSavedBoard" IsEnabled="{Binding CanCheckSavedBoard}" Interactive="{Binding CanCheckSavedBoard}" AccessibleName="Check the exact Board save result" />
              <Button Type="Menu Item" ID="BoardSwitcherRecorded" Active="{Binding CanOpenRecordedBoard}" Content="Open saved Board" Action="OpenRecordedBoard" IsEnabled="{Binding CanOpenRecordedBoard}" Interactive="{Binding CanOpenRecordedBoard}" AccessibleName="Open the exact saved Board" />

                  <Button Type="Menu Item" ID="RenameBoardMenuItem" Content="Rename…" Action="RenameBoard" Interactive="{Binding CanRenameBoard}" AccessibleName="Rename board" />
                  <Button Type="Menu Item" ID="FileBoardProperties" Content="Board properties…" Action="BoardProperties" />
                  <!-- The AppFlowy stage-one comparison surface stays available to the developer through
                       the opt-in BOARDS_STAGE_ONE_PREVIEW=1 process seam. It is deliberately not offered
                       in the owner-facing file menu: the current direction is to finish the 9to1 CUI
                       Boards presentation, and a labelled donor-shaped alternate inside the production
                       menu invites the two surfaces to be mistaken for each other. -->
                  <Button Type="Menu Item" Content="Exit" Action="CloseWindow" Active="{Binding IsStandalonePresentation}" />
                </Button>
              </Container>
              <Text ID="SaveState" Text="{Binding SaveStateText}" FontSize="11" Margin="8 0 0 0" TextTrimming="CharacterEllipsis" MaxWidth="340" Foreground="{Resource CuiTextSoftBrush}" AccessibleName="Save state" Active="{Binding ShowEditor}" />
            </Container>
            <Button ID="UndoButton" Column="2" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" Action="Undo" Interactive="{Binding CanUndo}" AccessibleName="Undo" Tooltip="Undo (Ctrl+Z)" ><Image Source="icon:undo" Width="18" Height="18" AccessibleName="Undo" /></Button>
            <Button ID="RedoButton" Column="3" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" Action="Redo" Interactive="{Binding CanRedo}" AccessibleName="Redo" Tooltip="Redo (Ctrl+Y)" ><Image Source="icon:redo" Width="18" Height="18" AccessibleName="Redo" /></Button>
          </Container>
          <Container Type="Horizontal Stack" ID="TopBarRight" Column="1" CellGap="8" VerticalAlignment="Center">
            <!-- Persistent Edit/View switch in the page chrome (V3-BOARDS-LAY-01, V3-BOARDS-ACC-02 and
                 the retained MUST requirement that every Board page surface expose it in the top-right
                 chrome). It was reachable only inside the "…" overflow, which the on-screen review on
                 1 November 2026 showed the owner could not see at all. Edit/View, Locked and the layout
                 mode stay three independent controls; none of them is a read-only master switch. -->
            <Container Type="Horizontal Stack" ID="EditViewToggle" CellGap="2" Padding="4 3"
                       CornerRadius="14" Background="{Resource CuiPanel2Brush}"
                       AccessibleName="Page edit or view mode" Active="{Binding ShowEditor}">
              <Button ID="EditModeButton" Content="Edit" Action="SetEditModeOn" Selected="{Binding IsEditingMode}"
                      Interactive="{Binding CanToggleEditMode}" Height="28" Padding="10 0" CornerRadius="11"
                      AccessibleName="Editing mode" ToolTip="Edit this page" />
              <Button ID="ViewModeButton" Content="View" Action="SetEditModeOff" Selected="{Binding IsViewingMode}"
                      Interactive="{Binding CanToggleEditMode}" Height="28" Padding="10 0" CornerRadius="11"
                      AccessibleName="Viewing mode" ToolTip="View this page without changing it" />
            </Container>
            <Button ID="LayoutModeButton" Content="{Binding LayoutModeLabel}" Action="ToggleLayoutMode"
                    Interactive="{Binding CanChangeLayoutMode}" Height="28" Padding="10 0" CornerRadius="11"
                    Background="{Resource CuiPanel2Brush}" AccessibleName="{Binding LayoutModeAccessibleName}"
                    Active="{Binding ShowEditor}"
                    ToolTip="Constrains block placement only. Page ink and text editing stay available." />
            <!-- Snap is the third independent control in the reference identity/mode row: it decides
                 where a spatial edit commits, not whether editing or placement is allowed. -->
            <Button ID="SnapButton" Content="{Binding SnapLabel}" Action="ToggleSnap"
                    Interactive="{Binding CanChangeSnap}" Selected="{Binding IsSnapEnabled}" Height="28"
                    Padding="10 0" CornerRadius="11" Background="{Resource CuiPanel2Brush}"
                    AccessibleName="{Binding SnapAccessibleName}" Active="{Binding ShowEditor}"
                    ToolTip="Snap: spatial edits commit on the placement grid. Independent of Edit/View and of the layout lock." />
            <Container Type="Menu" ID="MoreMenu" VerticalAlignment="Center">
            <Button Type="Menu Item" ID="OverflowButton" IconSource="icon:more" IconOnly="True" IconSize="18" Width="32" Height="32" Padding="0" AccessibleName="More board actions" Tooltip="Board options">
              <!-- The page-mode and layout-mode commands are no longer listed inside the overflow: they
                   are persistent controls in the top-right chrome, where the specification requires them
                   to be visible instead of hidden behind the overflow button. -->
              <Button Type="Menu Item" Content="{Binding TabViewMenuLabel}" Action="ToggleTabView" />
              <Button Type="Menu Item" Content="Styles…" Action="ManageStyles" />
              <Button Type="Menu Item" Content="Toggle light or dark appearance" Action="ToggleTheme" />
              <Button Type="Menu Item" ID="CanvasLockToggle" Content="{Binding CanvasLockLabel}" Action="ToggleCanvasLock" Interactive="{Binding IsEditMode}" AccessibleName="{Binding CanvasLockAccessibleName}" />
              <Button Type="Menu Item" ID="MoreBoardProperties" Content="Board properties…" Action="BoardProperties" />
            </Button>
            </Container>
          </Container>
        </Container>
      </Container>
      <!-- Left navigation: search, sections/pages (built in code), add actions.
           Gated with the board surface: while the Boards splash is showing there is no current
           board, so its title, save state and page list must not remain on screen (owner report
           28 October: the sidebar kept showing the last board's name and pages on the splash). -->
      <Container padding="8 8" Type="Overlay" ID="NavPane" Row="1" Column="0"
                   Background="{Resource CuiPanel2Brush}" BorderThickness="0 0 1 0" BorderBrush="{Resource CuiLineBrush}" Active="{Binding ShowEditor}">
        <Container Type="Grid" RowSizes="Auto Auto Auto 1fr Auto" CellGap="6">
          <Container Type="Vertical Stack" ID="BoardSwitcherHeader" Row="0" CellGap="6" Active="{Binding BoardRenameVisible}">
            <Text Text="Rename board" FontWeight="SemiBold" />
            <Input Type="Text" ID="BoardTitleBox" Value="{Binding BoardTitle, mode=TwoWay}" SubmitAction="FinishBoardRename" AccessibleName="Board title" />
            <Button Content="Done" Action="FinishBoardRename" AccessibleName="Finish renaming board" />
          </Container>
          <Input id="NavSearchBox" Row="1" Height="38" MinHeight="38" accessible-name="Search this Board" placeholdertext="Search this Board" margin="0 0 4 0" padding="12 9" cornerradius="18" background="{Resource CuiPanel2Brush}" foreground="{Resource CuiTextBrush}" borderwidth="0" Type="Text" ID="NavSearchBox" />
          <Button ID="NavNewPageButton" Row="2" Content="+ New page" Action="AddPage" Height="30" Padding="6 0"
                  HorizontalAlignment="Stretch" AccessibleName="New page" ToolTip="Add a page to the current section"
                  IsEnabled="{Binding CanEdit}" />
          <Container verticalalignment="Stretch" Type="Overlay" Row="3" VerticalScrolling="True" HorizontalScrolling="False" ScrollBarThickness="6">
            <Container Type="Vertical Stack" ID="NavHost" />
          </Container>
          <Container Type="Menu" Row="4" Margin="0 8 0 0">
            <Button Type="Menu Item" Content="+ Add" Width="168" HorizontalAlignment="Center" Interactive="{Binding CanEdit}" FontWeight="Bold" FontSize="14" AccessibleName="Add page or section" ID="AddNewButton" Padding="14 9" Background="{Resource CuiAccentBrush}" Foreground="{Resource CuiAccentInkBrush}" BorderWidth="0" CornerRadius="18">
              <Button Type="Menu Item" Content="New page in this section" Action="AddPage" AccessibleName="Create a page in the current section" />
              <Button Type="Menu Item" Content="New section" Action="AddSection" AccessibleName="Create a new section in this Board" />
              <Button Type="Menu Item" Content="Attach existing Write document…" Action="AddWritePage" Interactive="{Binding CanAddWritePage}" AccessibleName="Attach an existing Write document as a page" />
              <Button Type="Menu Item" Content="New Write document…" Action="CreateWritePage" Interactive="{Binding CanAddWritePage}" AccessibleName="Create a Write document as a page" />
              <Button Type="Menu Item" Content="Attach existing Canvas…" Action="AddCanvasPage" Interactive="{Binding CanAddCanvasPage}" AccessibleName="Attach an existing Canvas as a page" />
              <Button Type="Menu Item" Content="New Canvas…" Action="CreateCanvasPage" Interactive="{Binding CanAddCanvasPage}" AccessibleName="Create a Canvas as a page" />
              <Button Type="Menu Item" Content="{Binding LinkCreatedEmbeddedPageLabel}" Action="LinkCreatedEmbeddedPage" Interactive="{Binding CanLinkCreatedEmbeddedPage}" AccessibleName="Link the created owner page to its original Board section" />
            </Button>
          </Container>
        </Container>
      </Container>
      <!-- Editor column: contextual toolbar, context panel, document canvas -->
        <Container Type="Grid" ID="EditorHost" Row="1" Column="1" RowSizes="Auto Auto Auto 1fr" Active="{Binding ShowEditor}">
        <!-- Donor: the content pane's tab row (home_sizes.dart tabBarHeight 40, tabBarWidth 200;
             tab_bar_item.dart = icon + title + close). Rendered from state that exists here - the board title and
             the open page title - because 9to1 Boards has no open-pages tab stack in the host yet, so nothing
             unwired is drawn. The "+" calls the surface's existing AddPage handler. Next host wiring item: a real
             multi-tab stack with switch and close. -->
        <Container Type="Grid" ColumnSizes="Auto Auto 1fr Auto" CellGap="6" Row="0" Height="40" ID="BoardsTabBar"
                     Active="{Binding ShowTabBar}" Background="{Resource CuiPanelBrush}">
          <Container Type="Grid" ColumnSizes="Auto 1fr" CellGap="6" Width="200" Height="40" Padding="10 0"
                     Column="0" ID="BoardNameTab" VerticalAlignment="Center" Background="{Resource CuiPanelBrush}"
                     CornerRadius="6" BorderThickness="1" BorderBrush="{Resource CuiLineBrush}">
            <Image Column="0" Source="ownerbrand:boards" Width="16" Height="16" VerticalAlignment="Center"
                   AccessibleName="Board" />
            <Text Column="1" Text="{Binding BoardTitle, fallback=Board}" FontSize="13" VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis" AccessibleName="Board name" />
          </Container>
          <!-- Selected state comes from real state, not decoration: IsPageTabSelected is the view model's own
               current-page identity, so the highlighted tab is the page that is actually open. -->
          <Container Type="Grid" ColumnSizes="Auto 1fr" CellGap="6" Width="200" Height="40" Padding="10 0"
                     Column="1" ID="CurrentPageTab" VerticalAlignment="Center"
                     Background="{Resource CuiPanel2Brush}"
                     BorderThickness="1" BorderBrush="{Resource CuiLineBrush}" CornerRadius="6">
            <Text Column="0" Text="{Binding PageTypeLabel, fallback=Page}" FontSize="11" VerticalAlignment="Center"
                  AccessibleName="Page type" />
            <Text Column="1" Text="{Binding PageTitle, fallback=Page}" FontSize="13" VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis" AccessibleName="Open page name" />
          </Container>
          <Button Column="3" ID="TabNewPageButton" Content="+" Action="AddPage" Width="34" Height="34" FontSize="16"
                  AccessibleName="New page" ToolTip="Add a page" IsEnabled="{Binding CanEdit}" />
        </Container>
        <Container Type="Grid" Row="1" Active="{Binding ShowNativeAuthoring}" ID="FormattingToolbar" Margin="16 4 14 4" Background="Transparent">
          <Container Type="Overlay" ID="ToolbarHost" HorizontalAlignment="Stretch" />
        </Container>
        <Container Type="Vertical Stack" ID="ContextHost" Row="2" Active="{Binding AdaptivePropertiesVisible}" MaxHeight="220" VerticalScrolling="True" Padding="12 6" Background="Transparent">
          <Container Type="Grid" ColumnSizes="1fr Auto" Margin="0 0 0 6">
            <Text Text="Properties" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Column="1" Content="Close" Action="CloseAdaptiveProperties" AccessibleName="Close properties" />
          </Container>
          <If Condition="{Binding ContextIsText}">
            <Container Type="Wrap" CellGap="6">
              <Text Text="{Binding ContextTextStyle}" VerticalAlignment="Center" />
              <Button Content="Subscript" Action="ToggleSub" AccessibleName="Toggle subscript" />
              <Button Content="Superscript" Action="ToggleSup" AccessibleName="Toggle superscript" />
              <Button Content="Clear formatting" Action="ClearFormat" />
              <Button Content="Manage styles…" Action="ManageStyles" />
            </Container>
          </If>
          <If Condition="{Binding ContextIsTable}">
            <Container Type="Wrap" CellGap="4">
              <Text Text="Table" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 4 0" />
              <Button Content="+ Row" Action="ContextAddRow" Interactive="{Binding ContextCanAddTableRow}" AccessibleName="Add table row" Tooltip="Append a row without changing existing merged cells" />
              <Button Content="− Row" Action="ContextDeleteRow" Interactive="{Binding ContextCanDeleteTableRow}" AccessibleName="Delete last table row" Tooltip="Split the merged cells in the last row before deleting that row" />
              <Button Content="↑ Row" Action="ContextMoveRowUp" Interactive="{Binding ContextCanMoveRowUp}" AccessibleName="Move selected table row up" />
              <Button Content="↓ Row" Action="ContextMoveRowDown" Interactive="{Binding ContextCanMoveRowDown}" AccessibleName="Move selected table row down" />
              <Button Content="Shorter row" Action="ContextRowShorter" AccessibleName="Shorten selected table row" Interactive="{Binding ContextHasCell}" />
              <Button Content="Taller row" Action="ContextRowTaller" AccessibleName="Heighten selected table row" Interactive="{Binding ContextHasCell}" />
              <Button Content="Auto height" Action="ContextRowAutoHeight" AccessibleName="Reset selected table row height to automatic" Interactive="{Binding ContextHasCell}" />
              <Button Content="+ Column" Action="ContextAddColumn" Interactive="{Binding ContextCanAddTableColumn}" AccessibleName="Add table column" Tooltip="Append a column without changing existing merged cells" />
              <Button Content="− Column" Action="ContextDeleteColumn" Interactive="{Binding ContextCanDeleteTableColumn}" AccessibleName="Delete last table column" Tooltip="Split the merged cells in the last column before deleting that column" />
              <Button Content="← Column" Action="ContextMoveColumnLeft" Interactive="{Binding ContextCanMoveColumnLeft}" AccessibleName="Move selected table column left" />
              <Button Content="→ Column" Action="ContextMoveColumnRight" Interactive="{Binding ContextCanMoveColumnRight}" AccessibleName="Move selected table column right" />
              <Button Content="Merge →" Action="ContextMergeCellRight" Interactive="{Binding ContextCanMergeCellRight}" AccessibleName="Merge selected table cell with adjacent cell to the right; split restores covered content" Tooltip="Covered cell content stays recoverable when you split the merge" />
              <Button Content="Merge ↓" Action="ContextMergeCellDown" Interactive="{Binding ContextCanMergeCellDown}" AccessibleName="Merge selected table cell with adjacent cell below; split restores covered content" Tooltip="Covered cell content stays recoverable when you split the merge" />
              <Button Content="Split cell" Action="ContextSplitCell" Interactive="{Binding ContextCanSplitCell}" AccessibleName="Split selected merged table cell" />
              <Button Content="Narrow column" Action="ContextColumnNarrower" AccessibleName="Narrow selected table column" Interactive="{Binding ContextHasCell}" />
              <Button Content="Widen column" Action="ContextColumnWider" AccessibleName="Widen selected table column" Interactive="{Binding ContextHasCell}" />
              <Button Content="Auto width" Action="ContextColumnAutoWidth" AccessibleName="Reset selected table column width to automatic" Interactive="{Binding ContextHasCell}" />
              <Input Type="Number" Width="90" AccessibleName="Exact selected table column width in pixels; zero uses automatic width" Value="{Binding ContextColumnWidthDraft, mode=TwoWay, type=double}" Interactive="{Binding ContextHasCell}" />
              <Text Text="{Binding ContextColumnWidthLabel}" VerticalAlignment="Center" Foreground="{Resource CuiTextSoftBrush}" AccessibleName="Selected table column width" />
              <Text Text="{Binding ContextRowHeightLabel}" VerticalAlignment="Center" Foreground="{Resource CuiTextSoftBrush}" AccessibleName="Selected table row height" />
              <Text Text="Table width" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8 0 4 0" />
              <Button Content="Narrower" Action="ContextTableNarrower" AccessibleName="Narrow table" />
              <Button Content="Wider" Action="ContextTableWider" AccessibleName="Widen table" />
              <Button Content="Auto" Action="ContextTableAutoWidth" AccessibleName="Reset table width to automatic" />
              <Text Text="{Binding ContextTableWidthLabel}" VerticalAlignment="Center" Foreground="{Resource CuiTextSoftBrush}" AccessibleName="Table width" />
              <Input Type="Select" Width="100" AccessibleName="Table alignment" ItemsSource="{Binding ContextHorizontalOptions}" SelectedIndex="{Binding ContextTableAlignmentIndex}" />
              <Input Type="Checkbox" Content="Header row" Checked="{Binding ContextHasHeaderRow}" />
              <Input Type="Checkbox" Content="Header column" Checked="{Binding ContextHasHeaderColumn}" />
              <Input Type="Number" Width="90" AccessibleName="Exact selected table row height in pixels; zero uses automatic height" Value="{Binding ContextRowHeightDraft, mode=TwoWay, type=double}" Interactive="{Binding ContextHasCell}" />
              <Button Content="Apply dimensions" Action="ContextApplyCellDimensions" AccessibleName="Apply exact selected row height and column width" Interactive="{Binding ContextHasCell}" />
              <Text Text="Cell" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8 0 4 0" />
              <Input Type="Select" Width="96" AccessibleName="Cell horizontal alignment" ItemsSource="{Binding ContextHorizontalOptions}" SelectedIndex="{Binding ContextCellHorizontalIndex}" Interactive="{Binding ContextHasCell}" />
              <Input Type="Select" Width="96" AccessibleName="Cell vertical alignment" ItemsSource="{Binding ContextVerticalOptions}" SelectedIndex="{Binding ContextCellVerticalIndex}" Interactive="{Binding ContextHasCell}" />
              <Button Content="Bold" Action="ContextCellBold" AccessibleName="Toggle selected cell bold" Interactive="{Binding ContextHasCell}" />
              <Button Content="Italic" Action="ContextCellItalic" AccessibleName="Toggle selected cell italic" Interactive="{Binding ContextHasCell}" />
              <Input Type="Select" Width="110" AccessibleName="Selected cell fill" ItemsSource="{Binding ContextSurfaceNames}" SelectedIndex="{Binding ContextCellSurfaceIndex}" Interactive="{Binding ContextHasCell}" />
              <Text Text="Style" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8 0 4 0" />
              <Input Type="Select" Width="110" AccessibleName="Table background" ItemsSource="{Binding ContextSurfaceNames}" SelectedIndex="{Binding ContextTableSurfaceIndex}" />
              <Input Type="Select" Width="96" AccessibleName="Table border style" ItemsSource="{Binding ContextBorderOptions}" SelectedIndex="{Binding ContextTableBorderIndex}" />
              <Input Type="Checkbox" Content="Alternating rows" Checked="{Binding ContextAlternatingRows}" />
              <Button Content="Rounder corners" Action="ContextRoundTable" />
              <Text Text="{Binding ContextCellHint}" VerticalAlignment="Center" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" Margin="8 0 0 0" />
            </Container>
          </If>
          <If Condition="{Binding ContextIsImage}">
            <Container Type="Wrap" CellGap="4">
              <Text Text="Image" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 4 0" />
              <Button Content="Narrower" Action="ContextImageNarrower" AccessibleName="Narrower image" />
              <Button Content="Wider" Action="ContextImageWider" AccessibleName="Wider image" />
              <Button Content="Natural size" Action="ContextImageNatural" />
              <Input Type="Select" Width="100" AccessibleName="Image alignment" ItemsSource="{Binding ContextHorizontalOptions}" SelectedIndex="{Binding ContextImageAlignmentIndex}" />
              <Input Type="Checkbox" Content="Keep aspect ratio" Checked="{Binding ContextImageKeepAspectRatio}" />
              <Button Content="Shorter" Action="ContextImageShorter" AccessibleName="Shorter image" />
              <Button Content="Taller" Action="ContextImageTaller" AccessibleName="Taller image" />
              <Button Content="Rotate left" Action="ContextImageRotateLeft" AccessibleName="Rotate image left" />
              <Button Content="Rotate right" Action="ContextImageRotateRight" AccessibleName="Rotate image right" />
              <Button Content="Crop left" Action="ContextImageCropLeft" AccessibleName="Crop image from the left" />
              <Button Content="Crop right" Action="ContextImageCropRight" AccessibleName="Crop image from the right" />
              <Button Content="Crop top" Action="ContextImageCropTop" AccessibleName="Crop image from the top" />
              <Button Content="Crop bottom" Action="ContextImageCropBottom" AccessibleName="Crop image from the bottom" />
              <Button Content="Reset crop" Action="ContextImageResetCrop" AccessibleName="Reset image crop" />
              <Button Content="Fit mode" Action="ContextImageCycleFit" AccessibleName="Change image fit mode" />
              <Text Text="{Binding ContextImageFitMode}" VerticalAlignment="Center" AccessibleName="Image fit mode" />
              <Input Type="Text" Width="160" AccessibleName="Image caption" PlaceholderText="Caption" Value="{Binding ContextImageCaption}" WriteBack="True" />
              <Input Type="Text" Width="160" AccessibleName="Image alt text" PlaceholderText="Alt text" Value="{Binding ContextImageAltText}" WriteBack="True" />
              <Input Type="Text" Width="200" AccessibleName="Image link metadata" PlaceholderText="Link metadata" Value="{Binding ContextImageLinkUri}" WriteBack="True" />
              <Button Content="Replace…" Action="ContextReplaceImage" AccessibleName="Replace image from a file" />
              <Button Content="Remove" Action="ContextRemoveImage" AccessibleName="Remove this image" />
            </Container>
          </If>
          <If Condition="{Binding ContextIsDivider}">
            <Container Type="Wrap" CellGap="4">
              <Text Text="Divider" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 4 0" />
              <Button Content="Thinner" Action="ContextDividerThinner" />
              <Button Content="Thicker" Action="ContextDividerThicker" />
              <Input Type="Select" Width="100" AccessibleName="Divider line style" ItemsSource="{Binding ContextDividerOptions}" SelectedIndex="{Binding ContextDividerStyleIndex}" />
              <Button Width="26" Height="26" Padding="0" Background="#FFFFFFFF" Action="ContextDividerColorWhite" AccessibleName="Divider color White" />
              <Button Width="26" Height="26" Padding="0" Background="#FFF1F3F4" Action="ContextDividerColorMist" AccessibleName="Divider color Mist" />
              <Button Width="26" Height="26" Padding="0" Background="#FFFFF3C4" Action="ContextDividerColorPeach" AccessibleName="Divider color Peach" />
              <Button Width="26" Height="26" Padding="0" Background="#FFE6F4EA" Action="ContextDividerColorMint" AccessibleName="Divider color Mint" />
              <Button Width="26" Height="26" Padding="0" Background="#FFE8F0FE" Action="ContextDividerColorSky" AccessibleName="Divider color Sky" />
              <Button Width="26" Height="26" Padding="0" Background="#FFF3E8FD" Action="ContextDividerColorLavender" AccessibleName="Divider color Lavender" />
            </Container>
          </If>
        </Container>
        <Container horizontalalignment="Stretch" cornerradius="22" padding="20 12" margin="16 6 14 12" Type="Overlay" ID="PageCard" Row="3" Background="{Resource CuiSurfaceMaterial}" BorderWidth="0">
          <Container verticalalignment="Stretch" horizontalalignment="Stretch" Type="Overlay" ID="EditorScroll" VerticalScrolling="True" HorizontalScrolling="False" ScrollBarThickness="6" Background="Transparent">
            <Container Type="Grid" ID="PageSurface">
              <Container margin="76 10" Type="Vertical Stack" ID="DocumentContentLayer">
                <Text ID="EmbeddedPageBreadcrumb" Text="{Binding PageBreadcrumb}" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" Margin="0 0 0 4" Active="{Binding IsEmbeddedPresentation}" AccessibleName="Current Board, section and page" />
                <Input ID="PageTitleBox" Type="Text" AccessibleName="Page title" Value="{Binding PageTitle, fallback=Welcome}" WriteBack="False" FontSize="28" FontWeight="Bold" Margin="0 0 0 4" Padding="0" Background="Transparent" CornerRadius="0" BorderWidth="0" />
                <Text ID="EmbeddedPageStatus" Text="{Binding EmbeddedPageMessage}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" Active="{Binding EmbeddedPageUnavailable}" AccessibleName="Embedded artifact page status" />
                <Container Type="Vertical Stack" ID="EmbeddedArtifactHost" />
                <Container Type="Grid" ID="PageBlocksSurface" RowSizes="Auto">
                  <Container Type="Vertical Stack" ID="BlocksHost" Row="0" Active="{Binding IsNativePage}" />
                  <Container Type="Absolute" ID="AbsoluteBlocksHost" Row="0" XInherited="True" YInherited="True" Active="{Binding IsNativePage}" />
                </Container>
              </Container>
              <!-- Centre-origin scope for the drawing layer is the page surface itself, so a pen
                   point and the stroke it renders share one coordinate space (same inheritance the
                   authored AbsoluteBlocksHost uses). -->
              <Container Type="Absolute" ID="InkOverlayLayer" XInherited="True" YInherited="True" Active="{Binding IsNativePage}" />
            </Container>
          </Container>
        </Container>
      </Container>
      <Container Type="Vertical Stack" ID="LandingHost" Row="1" Column="1" Active="{Binding IsLanding}" VerticalScrolling="True" HorizontalScrolling="False" ScrollBarThickness="6" Padding="32 28" Background="Transparent" CellGap="12">
        <Text Text="Your boards" FontSize="30" FontWeight="Bold" />
        <Text Text="Open a saved workspace or create a new board." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
        <!-- Where the boards actually live. The status used to say only "Saved locally", which left
             the owner searching an empty-looking Boards folder; the real path is named here and in
             the board status, and Save As remains the explicit way to write elsewhere. -->
        <Text ID="BoardStorageNotice" Text="{Binding BoardStorageNotice}" TextWrapping="Wrap"
              FontSize="12" Foreground="{Resource CuiMutedBrush}" AccessibleName="Where boards are kept" />
        <Container Type="Wrap" CellGap="8">
          <Button ID="LandingCreateBoard" Content="Create a board" Action="NewBoard" Interactive="{Binding CanEdit}" AccessibleName="Create a new board" />
          <Button ID="LandingOpenBoard" Content="Open a board…" Action="OpenBoard" Interactive="{Binding CanEdit}" AccessibleName="Open an existing board" />
          <Input ID="LandingSearchBox" Type="Text" PlaceholderText="Search boards and recent pages" AccessibleName="Search boards and recent pages" Width="300" Value="{Binding LandingSearchQuery}" WriteBack="True" />
        </Container>
        <Text Text="{Binding RecentBoardStatus}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" AccessibleName="Recent boards status" />
        <Text Text="Recent boards" FontSize="20" FontWeight="SemiBold" Margin="0 14 0 0" />
        <If Condition="{Binding RecentBoardsLoaded, fallback=false}">
        <If Condition="{Binding HasRecentBoards}">
          <Container Type="Wrap" CellGap="12" Role="list" AccessibleName="Recent boards">
            <Repeat Source="{Binding RecentBoardCards}" As="board" Key="{Binding board.Id}" Panel="Wrap">
              <Container Type="Vertical Stack" Width="280" Padding="16" Margin="0 0 0 8" Background="{Resource CuiPanelBrush}" CornerRadius="10" CellGap="8" Role="listitem">
                <Image Source="icon:folder" Width="24" Height="24" AccessibleName="Board" />
                <Button Action="OpenRecentBoard" Content="{Binding board.Title}" Interactive="{Binding board.IsAvailable}" AccessibleName="Open recent board" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" />
                <Text Text="{Binding board.Preview}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                <Text Text="{Binding board.ModifiedLabel}" Foreground="{Resource CuiTextSoftBrush}" AccessibleName="Last modified" />
                <Text Text="{Binding board.AvailabilityLabel}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              </Container>
            </Repeat>
          </Container>
        </If>
        <If Condition="{Binding HasNoRecentBoards}"><Text Text="No recent boards yet. Create a board or open an existing .9to1board file." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" /></If>
        </If>
        <Else><Text Text="Loading saved boards…" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" /></Else>
        <Text Text="Recent pages and components" FontSize="20" FontWeight="SemiBold" Margin="0 14 0 0" />
        <If Condition="{Binding HasRecentPages}">
          <Container Type="Vertical Stack" CellGap="6" Role="list" AccessibleName="Recent pages">
            <Repeat Source="{Binding RecentPageCards}" As="page" Key="{Binding page.Id}">
              <Button Action="OpenRecentPage" HorizontalAlignment="Stretch" Padding="12" AccessibleName="Open recent page">
                <Container Type="Vertical Stack" CellGap="4">
                  <Text Text="{Binding page.PageTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <Text Text="{Binding page.BoardTitle}" Foreground="{Resource CuiTextSoftBrush}" />
                  <Container Type="Horizontal Stack" CellGap="4">
                    <Text Text="Opened" Foreground="{Resource CuiTextSoftBrush}" />
                    <Text Text="{Binding page.OpenedLabel}" Foreground="{Resource CuiTextSoftBrush}" />
                  </Container>
                  <Text Text="{Binding page.Preview}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
              </Button>
            </Repeat>
          </Container>
        </If>
        <If Condition="{Binding HasNoRecentPages}"><Text Text="Pages you open will appear here." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" /></If>
      </Container>
      <Container Type="Overlay" ID="SectionIconPickerBackdrop" Row="1" Column="0" ColumnSpan="2" Active="{Binding IsSectionIconPickerOpen}" Background="#88000000" BorderWidth="0">
        <Container Type="Overlay" ID="SectionIconPickerPanel" Width="520" Height="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{Resource CuiFloatingSurfaceMaterial}" Padding="18" CornerRadius="18" BorderWidth="0">
          <Container Type="Grid" RowSizes="Auto Auto Auto Auto 1fr Auto" CellGap="10">
            <Container Type="Horizontal Stack" Row="0" CellGap="8" VerticalAlignment="Center">
              <Container Type="Vertical Stack" CellGap="2" HorizontalAlignment="Stretch">
                <Text Text="Section icon and color" FontSize="19" FontWeight="SemiBold" />
                <Text Text="{Binding SectionIconPickerTitle}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" AccessibleName="Section being customized" />
              </Container>
              <Button Row="0" Content="Close" Action="CloseSectionIconPicker" AccessibleName="Close section appearance picker" Tooltip="Close" />
            </Container>
            <Input ID="SectionIconPickerSearch" Row="1" Type="Text" Value="{Binding SectionIconPickerSearch}" WriteBack="True" PlaceholderText="Search icons" AccessibleName="Search section icons by name" Padding="10 8" Background="{Resource CuiPanel2Brush}" BorderWidth="0" CornerRadius="10" />
            <Container Type="Vertical Stack" Row="2" CellGap="4">
              <Text Text="Icon color" FontWeight="SemiBold" />
              <Container Type="Wrap" CellGap="5" Role="group" AccessibleName="Section icon colors">
                <Button Content="Theme" Action="UseThemeSectionIconColor" Selected="{Binding SectionIconPickerHasThemeColor}" AccessibleName="Use the current theme color" Tooltip="Follow the active theme" />
                <Repeat ID="SectionIconColors" Source="{Binding SectionIconPickerColors}" As="color" Key="{Binding color.Hex}" Panel="Wrap">
                  <Button Action="ApplySectionIconColor" Selected="{Binding color.IsSelected}" AccessibleName="{Binding color.AccessibleName}" Tooltip="{Binding color.Name}" Padding="6 4">
                    <Container Type="Horizontal Stack" CellGap="5" VerticalAlignment="Center">
                      <Container Type="Overlay" Width="14" Height="14" CornerRadius="7" Background="{Binding color.Preview}" />
                      <Text Text="{Binding color.Name}" FontSize="11" VerticalAlignment="Center" />
                    </Container>
                  </Button>
                </Repeat>
              </Container>
            </Container>
            <Container Type="Horizontal Stack" Row="3" CellGap="10" VerticalAlignment="Center">
              <Button ID="SuggestSectionIconButton" Content="Suggest from section name" Action="SuggestSectionIcon" IsEnabled="{Binding CanSuggestSectionIcon}" AccessibleName="Create an icon preview from this section name" Tooltip="Sends the section name only to the currently selected Home model" />
              <If Condition="{Binding IsSectionIconSuggestionInProgress}"><Text Text="Creating preview…" Foreground="{Resource CuiTextSoftBrush}" VerticalAlignment="Center" /></If>
              <Text Text="{Binding SectionIconSuggestionCaption}" Foreground="{Resource CuiTextSoftBrush}" VerticalAlignment="Center" />
            </Container>
            <Container Type="Overlay" Row="4" VerticalScrolling="True" HorizontalScrolling="False" ScrollBarThickness="6" Background="Transparent">
              <Container Type="Vertical Stack" CellGap="6">
                <Text Text="Choose an icon" FontWeight="SemiBold" />
                <If Condition="{Binding HasGeneratedSectionIconPreview}">
                  <Repeat ID="GeneratedSectionIconOptions" Source="{Binding GeneratedSectionIconPreviews}" As="generated" Key="{Binding generated.Index}" Panel="Wrap">
                    <Button ID="ApplyGeneratedSectionIconButton" Action="ApplyGeneratedSectionIcon" AccessibleName="Apply generated section icon option" Tooltip="{Binding generated.ModelLabel}" Width="76" Height="66" Padding="5">
                      <Container Type="Vertical Stack" CellGap="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image ID="GeneratedSectionIconPreviewImage" Source="{Binding generated.Preview}" Width="28" Height="28" HorizontalAlignment="Center" AccessibleName="Generated section icon preview" />
                        <Text Text="{Binding generated.ModelLabel}" FontSize="11" HorizontalAlignment="Center" />
                      </Container>
                    </Button>
                  </Repeat>
                </If>
                <If Condition="{Binding HasSectionIconPickerChoices}">
                  <Repeat ID="SectionIconChoices" Source="{Binding SectionIconPickerChoices}" As="icon" Key="{Binding icon.Key}" Panel="Wrap">
                    <Button Action="ApplySectionIconChoice" Selected="{Binding icon.IsSelected}" AccessibleName="{Binding icon.AccessibleName}" Tooltip="{Binding icon.Label}" Width="88" Height="68" Padding="5">
                      <Container Type="Vertical Stack" CellGap="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="{Binding icon.Preview}" Width="22" Height="22" HorizontalAlignment="Center" AccessibleName="{Binding icon.AccessibleName}" />
                        <Text Text="{Binding icon.Label}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" />
                      </Container>
                    </Button>
                  </Repeat>
                </If>
                <Else><Text Text="No icons match that search." Foreground="{Resource CuiTextSoftBrush}" /></Else>
              </Container>
            </Container>
            <Text Row="5" Text="Built-in icons are available offline. Suggestions send only the section name to your selected Home model; Board content is not sent. A suggestion is saved only when you apply its preview." FontSize="11" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
          </Container>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
