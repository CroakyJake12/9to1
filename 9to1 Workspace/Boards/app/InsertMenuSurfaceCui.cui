<Cui>
  <Page>
    <Container Type="Overlay" ID="InsertMenuSurface" Padding="12" CornerRadius="8" BorderWidth="1"
               BorderColor="{Resource CuiLineBrush}" Background="{Resource CuiFloatingSurfaceMaterial}"
               MinWidth="324" MaxWidth="444" AccessibleName="Insert a block">
