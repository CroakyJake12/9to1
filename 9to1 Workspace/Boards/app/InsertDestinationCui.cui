<Cui>
  <!-- No Selected attribute is authored on these rows: an attempt on 2 November 2026 bound
       Selected="{Binding <Placement>Chosen}" and it was removed again, because reading the running
       projection back showed the binding never reached the element at all (Selected stayed
       "False@BuiltIn/CUI built-in default" while the rows are CuiMenuItem, not Button). What does exist is
       CUI's own interaction state, which on keyboard focus writes BorderColor="CuiFocusBrush" - the accent
       purple - but the menu-row theme declares BorderWidth 0, so that colour has nothing to paint. The
       visible chosen cue is therefore owned by the destination stage's C# host (InsertMenuContext), which
       reconciles hover and keyboard focus into a border width, the same precedence pattern the toolbar rows
       already use.


       Why: measured on the running build on 2 November 2026 (run59, `home34`/`profile34`, receipts
       BD02-BD04, frames 311 and 308-309 from the previous run), pressing Down in this stage did move the
       keyboard - the page-side insertion preview changed (the accent bar by the plus and at the top of the
       card) - but no row in the menu showed any state at all. The row background sampled identical values
       before and after the key press, and in the same build the C#-built type rows DO show a chosen state,
       because ToolbarBuilder reconciles hover and keyboard focus into CuiPropertyPresentation.SetSelected
       for those rows. A keyboard user in this stage therefore cannot see which destination Enter will
       apply, while the destination stage is the one choice that changes where a block lands. The named
       invariant, now guarded by a headless case: exactly the row that answers the keyboard (or the pointer)
       is the row that looks chosen. -->
  <Actions>
    <Action Name="ChooseAbove" Command="ChooseDestination" Parameter="{Binding AboveChoose}" />
    <Action Name="ChooseBelow" Command="ChooseDestination" Parameter="{Binding BelowChoose}" />
    <Action Name="ChooseReplace" Command="ChooseDestination" Parameter="{Binding ReplaceChoose}" />
    <Action Name="AbovePointerEnter" Command="Preview" Parameter="{Binding AbovePointerEnter}" />
    <Action Name="AbovePointerExit" Command="Preview" Parameter="{Binding AbovePointerExit}" />
    <Action Name="AboveFocusEnter" Command="Preview" Parameter="{Binding AboveFocusEnter}" />
    <Action Name="AboveFocusExit" Command="Preview" Parameter="{Binding AboveFocusExit}" />
    <Action Name="BelowPointerEnter" Command="Preview" Parameter="{Binding BelowPointerEnter}" />
    <Action Name="BelowPointerExit" Command="Preview" Parameter="{Binding BelowPointerExit}" />
    <Action Name="BelowFocusEnter" Command="Preview" Parameter="{Binding BelowFocusEnter}" />
    <Action Name="BelowFocusExit" Command="Preview" Parameter="{Binding BelowFocusExit}" />
    <Action Name="ReplacePointerEnter" Command="Preview" Parameter="{Binding ReplacePointerEnter}" />
    <Action Name="ReplacePointerExit" Command="Preview" Parameter="{Binding ReplacePointerExit}" />
    <Action Name="ReplaceFocusEnter" Command="Preview" Parameter="{Binding ReplaceFocusEnter}" />
    <Action Name="ReplaceFocusExit" Command="Preview" Parameter="{Binding ReplaceFocusExit}" />
  </Actions>
  <Page>
    <Container Type="Vertical Stack" ID="InsertDestinations" CellGap="2" Background="Transparent">
      <Text Text="ADD WHERE" FontSize="11" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" />
      <Button Type="Menu Item" ID="InsertAbove" Content="Add Block Above" AccessibleName="Add Block Above"
              AccessibleDescription="{Binding AboveDescription}" IsEnabled="{Binding CanAbove}"
              Action="ChooseAbove" Height="34" MinHeight="34">
        <ActionEvent Type="PointerEnter" Action="AbovePointerEnter" />
        <ActionEvent Type="PointerExit" Action="AbovePointerExit" />
        <ActionEvent Type="Focused" Action="AboveFocusEnter" />
        <ActionEvent Type="Blurred" Action="AboveFocusExit" />
      </Button>
      <Button Type="Menu Item" ID="InsertBelow" Content="Add Block Below" AccessibleName="Add Block Below"
              AccessibleDescription="{Binding BelowDescription}" IsEnabled="{Binding CanBelow}"
              Action="ChooseBelow" Height="34" MinHeight="34">
        <ActionEvent Type="PointerEnter" Action="BelowPointerEnter" />
        <ActionEvent Type="PointerExit" Action="BelowPointerExit" />
        <ActionEvent Type="Focused" Action="BelowFocusEnter" />
        <ActionEvent Type="Blurred" Action="BelowFocusExit" />
      </Button>
      <Button Type="Menu Item" ID="InsertReplace" Content="Replace Current Block" AccessibleName="Replace Current Block"
              AccessibleDescription="{Binding ReplaceDescription}" IsEnabled="{Binding CanReplace}"
              Action="ChooseReplace" Height="34" MinHeight="34">
        <ActionEvent Type="PointerEnter" Action="ReplacePointerEnter" />
        <ActionEvent Type="PointerExit" Action="ReplacePointerExit" />
        <ActionEvent Type="Focused" Action="ReplaceFocusEnter" />
        <ActionEvent Type="Blurred" Action="ReplaceFocusExit" />
      </Button>
    </Container>
  </Page>
</Cui>
