<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Owner comparison pair (31 Oct 2026): the new CUI Boards must run on the same Linux x64 PC that runs
         the legacy surface, so the two can be tested side by side. Windows packaging is unchanged: the Windows
         TFM and the Win32 platform are still selected there, exactly as 9to1 Workspace/Boards/Host already does
         for the legacy entry. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableRuntimeMarshalling>true</EnableRuntimeMarshalling>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CakeOS.Apps.Boards.App</RootNamespace>
    <AssemblyName>CakeOS.Apps.Boards.App</AssemblyName>
  </PropertyGroup>

  <!-- Avalonia fork: reference source projects directly (no meta-package, no AXAML).
       Mirrors apps/Home/src/AvaloniaHome packaging. -->
  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <Compile Include="Program.cs" />
    <ProjectReference Include="..\..\Data\RecordsUI\HavenOS.Data.RecordsUI.csproj" />
    <ProjectReference Include="CakeOS.Apps.Boards.Embedding.csproj" />
    <ProjectReference Include="..\..\shared\src\Haven.Infrastructure\Haven.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Home\HavenOS.Home.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\framework\CUI\vendor\Avalonia\src\Avalonia.Base\Avalonia.Base.csproj" />
    <ProjectReference Include="..\..\..\framework\CUI\vendor\Avalonia\src\Avalonia.Controls\Avalonia.Controls.csproj" />
    <ProjectReference Include="..\..\..\framework\CUI\vendor\Avalonia\src\Avalonia.Remote.Protocol\Avalonia.Remote.Protocol.csproj" />
    <ProjectReference Include="..\..\..\framework\CUI\vendor\Avalonia\src\Skia\Avalonia.Skia\Avalonia.Skia.csproj" />
    <ProjectReference Include="..\..\..\framework\CUI\vendor\Avalonia\src\HarfBuzz\Avalonia.HarfBuzz\Avalonia.HarfBuzz.csproj" />
    <ProjectReference Include="..\..\..\framework\CUI\vendor\Avalonia\src\Headless\Avalonia.Headless\Avalonia.Headless.csproj" />
    <ProjectReference Include="..\..\..\framework\CUI\vendor\Avalonia\src\Windows\Avalonia.Win32\Avalonia.Win32.csproj" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <ProjectReference Include="..\..\..\framework\CUI\vendor\Avalonia\src\Avalonia.X11\Avalonia.X11.csproj" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <!-- CUI Framework + Boards contract references -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\framework\CUI\Core\CakeOS.Cui.Core.csproj" />
    <ProjectReference Include="..\..\..\framework\CUI\Runtime\CakeOS.Cui.Runtime.csproj" />
    <ProjectReference Include="..\contract\CakeOS.Apps.Boards.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="PackageReadme.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\framework\CUI\vendor\Avalonia\licence.md" Link="licenses\Avalonia-LICENSE.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\framework\CUI\vendor\Avalonia\NOTICE.md" Link="licenses\Avalonia-NOTICE.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\framework\CUI\vendor\Avalonia\src\Avalonia.Fonts.Inter\Assets\OFL.txt" Link="licenses\Inter-OFL.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
