<Cui>
  <!-- In the gutter only this toggle button lives: the authored menu it opens is BlockActionsMenuCui.cui,
       hosted by the C#-owned Popup in BlockGripCui.cs. Keeping the root a Grid preserves the gutter row
       shape the geometry checks measure (toggle plus insert inside the row Grid's 32-unit columns). -->
  <Actions>
    <Action name="ToggleActions" command="ToggleActions" />
  </Actions>
  <Page>
    <Container Type="Grid" CellGap="0" VerticalAlignment="Top">
      <Button ID="BlockGripToggle" Content="⋮" Action="ToggleActions" Padding="4 2"
              VerticalAlignment="Top" Width="32" Height="32" MinWidth="32" MinHeight="32"
              AccessibleName="{Binding GripAccessibleName}" AccessibleDescription="Open block actions" />
    </Container>
  </Page>
</Cui>
