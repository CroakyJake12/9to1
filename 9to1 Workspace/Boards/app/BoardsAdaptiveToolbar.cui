                <Button Type="Menu Item" Content="Ink colour ▾" Height="32" Padding="7 0" AccessibleName="Ink colour" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour">
                  <Button Content="Black" Action="InkColor#FF111111" Type="Menu Item" AccessibleName="Black ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF111111" />
                  <Button Content="Dark grey" Action="InkColor#FF5F6368" Type="Menu Item" AccessibleName="Dark grey ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF5F6368" />
                  <Button Content="Grey" Action="InkColor#FF9AA0A6" Type="Menu Item" AccessibleName="Grey ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF9AA0A6" />
                  <Button Content="Red" Action="InkColor#FFD32F2F" Type="Menu Item" AccessibleName="Red ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FFD32F2F" />
                  <Button Content="Orange" Action="InkColor#FFE8710A" Type="Menu Item" AccessibleName="Orange ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FFE8710A" />
                  <Button Content="Green" Action="InkColor#FF1E8E3E" Type="Menu Item" AccessibleName="Green ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF1E8E3E" />
                  <Button Content="Blue" Action="InkColor#FF1A73E8" Type="Menu Item" AccessibleName="Blue ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF1A73E8" />
                  <Button Content="Purple" Action="InkColor#FF9334E6" Type="Menu Item" AccessibleName="Purple ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF9334E6" />
                  <Button Content="White" Action="InkColor#FFFFFFFF" Type="Menu Item" AccessibleName="White ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FFFFFFFF" />
                  <Button Content="Yellow" Action="InkColor#FFF9AB00" Type="Menu Item" AccessibleName="Yellow ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FFF9AB00" />
                  <Button Content="Navy" Action="InkColor#FF1B4F72" Type="Menu Item" AccessibleName="Navy ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF1B4F72" />
                  <Button Content="Brown" Action="InkColor#FF795548" Type="Menu Item" AccessibleName="Brown ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF795548" />
                </Button>
              </Container>
              <Container Type="Menu" ID="OverflowAdaptiveOverflow_Drawing_Menu_4">
                <Button Type="Menu Item" Content="View ▾" Height="32" Padding="7 0" AccessibleName="Drawing view" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view">
                  <Button Content="Zoom in" Action="InkZoomIn" Type="Menu Item" AccessibleName="Zoom drawing in" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view_InkZoomIn" />
                  <Button Content="Zoom out" Action="InkZoomOut" Type="Menu Item" AccessibleName="Zoom drawing out" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view_InkZoomOut" />
                  <Button Content="Reset view" Action="InkResetView" Type="Menu Item" AccessibleName="Reset drawing view" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view_InkResetView" />
                  <Button Content="Undo drawing" Action="Undo" Type="Menu Item" AccessibleName="Undo drawing" Interactive="{Binding CanUndo}" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view_Undo" />
                  <Button Content="Redo drawing" Action="Redo" Type="Menu Item" AccessibleName="Redo drawing" Interactive="{Binding CanRedo}" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view_Redo" />
                </Button>
              </Container>
              <Container Type="Overlay" Width="16" Height="4" Background="{Binding InkColor}" VerticalAlignment="Center" ID="OverflowAdaptiveOverflow_Drawing_Overlay" />
            </Button>
          </Button>
        </Container>
      </Container>
      <!-- Measured on the running app (1 Nov frame 201): the formatting controls inside AdaptivePill are
           Height 32 with CellGap 2, while these three actions were Height 36 with CornerRadius 12 and
           CellGap 4, so one toolbar row carried two different control scales and uneven gaps (8 logical
           then 6). Same row, same optical size and rhythm; "+ Add" and "Drawing" stay distinct by their
           label and icon, not by being taller. -->
      <Container ID="AdaptiveFixedActions" Type="Horizontal Stack" Column="1" CellGap="2" VerticalAlignment="Center" Background="{Resource CuiFloatingSurfaceMaterial}" Padding="4" CornerRadius="15">
        <Button ID="AdaptiveAdd" Content="+ Add" AccessibleName="Insert" Tooltip="Insert a block" Height="32" Padding="10 0" CornerRadius="8" Interactive="{Binding CanEditToolbar}" />
        <Button ID="AdaptiveDrawing" Action="ToggleDrawing" Selected="{Binding DrawingMode}" AccessibleName="Drawing" Height="32" Padding="10 0" CornerRadius="8" Interactive="{Binding CanEditToolbar}">
          <Container Type="Horizontal Stack" CellGap="5" VerticalAlignment="Center" ID="AdaptiveDrawing_Horizontal_Stack">
            <Image Source="icon:pen" Width="18" Height="18" ID="AdaptiveDrawing_Horizontal_Stack_Image" />
            <Text Text="Drawing" VerticalAlignment="Center" ID="AdaptiveDrawing_Horizontal_Stack_Drawing" />
          </Container>
        </Button>
        <Button ID="AdaptiveAI" AccessibleName="AI unavailable" Tooltip="AI is not connected to this Boards editor" Interactive="False" Height="32" Padding="10 0" CornerRadius="8">
          <Container ID="AdaptiveAIContent" Type="Horizontal Stack" CellGap="4" VerticalAlignment="Center">
            <Image ID="AdaptiveAIIcon" Source="icon:sparkles" Width="16" Height="16" />
            <Text ID="AdaptiveAILabel" Text="AI" VerticalAlignment="Center" />
          </Container>
        </Button>
      </Container>
    </Container>
  </Page>
</Cui>
