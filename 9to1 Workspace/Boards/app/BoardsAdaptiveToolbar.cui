<Cui>
  <Actions>
    <Action name="ApplyFont" command="ApplyFont" parameter="{Binding Event}" />
    <Action name="ApplySize" command="ApplySize" parameter="{Binding Event}" />
  </Actions>
  <Page>
    <Container ID="AdaptiveToolbar" Type="Grid" ColumnSizes="1fr Auto" CellGap="8" HorizontalAlignment="Stretch">
      <Container ID="AdaptivePill" Type="Toolbar" Column="0" CellGap="2" Padding="7 4" CornerRadius="15" Background="{Resource CuiFloatingSurfaceMaterial}" BorderWidth="0" Interactive="{Binding CanEditToolbar}">
        <Container ID="AdaptiveFontSection" Type="Horizontal Stack" CellGap="2" VerticalAlignment="Center" Active="{Binding TextMode}" Tooltip="{Binding TypographyGroupHint}">
          <Input ID="AdaptiveStyle" Type="Select" Width="124" Height="32" ItemsSource="{Binding StyleNames}" SelectedIndex="{Binding StyleIndex, mode=TwoWay}" AccessibleName="Paragraph style" MinHeight="32" VerticalAlignment="Center" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding StyleControlHint}" />
          <Input ID="AdaptiveFont" Type="Text" Width="98" Height="32" Value="{Binding FontDraft, mode=TwoWay}" SubmitAction="ApplyFont" AccessibleName="Font family" Tooltip="{Binding FontControlHint}" Padding="6 0" MinHeight="32" MaxHeight="32" VerticalContentAlignment="Center" VerticalAlignment="Center" FontSize="13" IsEnabled="{Binding CanUseTypography}" />
          <Container Type="Menu" ID="AdaptiveFontSection_Menu" Tooltip="{Binding FontControlHint}">
            <Button Type="Menu Item" Content="⌄" Height="32" Padding="0" AccessibleName="Choose font family" Width="24" ID="AdaptiveFontSection_Menu_Choose_font_family" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}">
              <Button Content="Default" Action="FontDefault" Type="Menu Item" AccessibleName="Default" ID="AdaptiveFontSection_Menu_Choose_font_family_FontDefault" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
              <Button Content="Inter" Action="FontInter" Type="Menu Item" AccessibleName="Inter" ID="AdaptiveFontSection_Menu_Choose_font_family_FontInter" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
              <Button Content="Georgia" Action="FontGeorgia" Type="Menu Item" AccessibleName="Georgia" ID="AdaptiveFontSection_Menu_Choose_font_family_FontGeorgia" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
              <Button Content="Cascadia Mono" Action="FontMono" Type="Menu Item" AccessibleName="Cascadia Mono" ID="AdaptiveFontSection_Menu_Choose_font_family_FontMono" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
              <Button Content="Segoe UI" Action="FontSegoe" Type="Menu Item" AccessibleName="Segoe UI" ID="AdaptiveFontSection_Menu_Choose_font_family_FontSegoe" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
              <Button Content="Times New Roman" Action="FontTimes" Type="Menu Item" AccessibleName="Times New Roman" ID="AdaptiveFontSection_Menu_Choose_font_family_FontTimes" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
            </Button>
          </Container>
          <Button Content="−" Action="FontSmaller" AccessibleName="Decrease font size" Width="26" Height="32" Padding="0" ID="AdaptiveFontSection_FontSmaller" MinWidth="26" MinHeight="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderWidth="0" FontSize="17" Tooltip="{Binding FontControlHint}" IsEnabled="{Binding CanUseTypography}" />
          <Input ID="AdaptiveSize" Type="Text" Width="43" Height="32" Value="{Binding SizeDraft, mode=TwoWay}" SubmitAction="ApplySize" AccessibleName="Font size" Tooltip="{Binding SizeControlHint}" Padding="6 0" MinHeight="32" MaxHeight="32" VerticalContentAlignment="Center" VerticalAlignment="Center" FontSize="13" IsEnabled="{Binding CanUseTypography}" />
          <Text Text="px" VerticalAlignment="Center" FontSize="11" ID="AdaptiveFontSection_px" />
          <Button Content="+" Action="FontBigger" AccessibleName="Increase font size" Width="26" Height="32" Padding="0" ID="AdaptiveFontSection_FontBigger" MinWidth="26" MinHeight="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderWidth="0" FontSize="17" Tooltip="{Binding FontControlHint}" IsEnabled="{Binding CanUseTypography}" />
          <Container Type="Menu" ID="AdaptiveFontSection_Menu_2">
            <Button Type="Menu Item" Content="Aa ▾" Height="32" Padding="7 0" AccessibleName="Text case" ID="AdaptiveFontSection_Menu_2_Text_case" Tooltip="Change text case">
              <Button Content="UPPERCASE" Action="CaseUpper" Type="Menu Item" AccessibleName="UPPERCASE" ID="AdaptiveFontSection_Menu_2_Text_case_CaseUpper" Tooltip="Change text case" />
              <Button Content="lowercase" Action="CaseLower" Type="Menu Item" AccessibleName="lowercase" ID="AdaptiveFontSection_Menu_2_Text_case_CaseLower" Tooltip="Change text case" />
            </Button>
          </Container>
          <Container Type="Separator" Width="1" Height="22" Margin="5 0" Background="{Resource CuiLineBrush}" ID="AdaptiveFontSection_Separator" />
        </Container>
        <Container ID="AdaptiveFormatSection" Type="Horizontal Stack" CellGap="2" VerticalAlignment="Center" Active="{Binding TextMode}">
          <Button ID="RangeBold" Width="32" Height="32" Padding="0" Action="ToggleBold" Selected="{Binding RangeBoldSelected}" Interactive="{Binding CanFormatTextRange}" AccessibleName="{Binding RangeBoldState}" Tooltip="Bold" MinWidth="32">
            <Image Source="icon:bold" Width="18" Height="18" ID="RangeBold_Image" />
          </Button>
          <Button ID="RangeItalic" Width="32" Height="32" Padding="0" Action="ToggleItalic" Selected="{Binding RangeItalicSelected}" Interactive="{Binding CanFormatTextRange}" AccessibleName="{Binding RangeItalicState}" Tooltip="Italic" MinWidth="32">
            <Image Source="icon:italic" Width="18" Height="18" ID="RangeItalic_Image" />
          </Button>
          <Button ID="RangeUnderline" Width="32" Height="32" Padding="0" Action="ToggleUnderline" Selected="{Binding RangeUnderlineSelected}" Interactive="{Binding CanFormatTextRange}" AccessibleName="{Binding RangeUnderlineState}" Tooltip="Underline" MinWidth="32">
            <Image Source="icon:underline" Width="18" Height="18" ID="RangeUnderline_Image" />
          </Button>
          <Button ID="RangeStrike" Width="32" Height="32" Padding="0" Action="ToggleStrike" Selected="{Binding RangeStrikeSelected}" Interactive="{Binding CanFormatTextRange}" AccessibleName="{Binding RangeStrikeState}" Tooltip="Strike" MinWidth="32">
            <Image Source="icon:strikethrough" Width="18" Height="18" ID="RangeStrike_Image" />
          </Button>
          <Container Type="Menu" ID="AdaptiveFormatSection_Menu">
            <Button Type="Menu Item" Content="" Height="32" Padding="7 0" AccessibleName="Text colour" ID="AdaptiveTextColor" IconSource="icon:text-color" IconSize="18" IconOnly="True" Width="32" Tooltip="{Binding TextColorLabel}">
              <Button Content="Black" Action="TextColor#FF111111" Type="Menu Item" AccessibleName="Black" ID="AdaptiveTextColor_TextColor_FF111111" />
              <Button Content="Dark grey" Action="TextColor#FF5F6368" Type="Menu Item" AccessibleName="Dark grey" ID="AdaptiveTextColor_TextColor_FF5F6368" />
              <Button Content="Grey" Action="TextColor#FF9AA0A6" Type="Menu Item" AccessibleName="Grey" ID="AdaptiveTextColor_TextColor_FF9AA0A6" />
              <Button Content="Red" Action="TextColor#FFD32F2F" Type="Menu Item" AccessibleName="Red" ID="AdaptiveTextColor_TextColor_FFD32F2F" />
              <Button Content="Orange" Action="TextColor#FFE8710A" Type="Menu Item" AccessibleName="Orange" ID="AdaptiveTextColor_TextColor_FFE8710A" />
              <Button Content="Green" Action="TextColor#FF1E8E3E" Type="Menu Item" AccessibleName="Green" ID="AdaptiveTextColor_TextColor_FF1E8E3E" />
              <Button Content="Blue" Action="TextColor#FF1A73E8" Type="Menu Item" AccessibleName="Blue" ID="AdaptiveTextColor_TextColor_FF1A73E8" />
              <Button Content="Purple" Action="TextColor#FF9334E6" Type="Menu Item" AccessibleName="Purple" ID="AdaptiveTextColor_TextColor_FF9334E6" />
              <Button Content="White" Action="TextColor#FFFFFFFF" Type="Menu Item" AccessibleName="White" ID="AdaptiveTextColor_TextColor_FFFFFFFF" />
              <Button Content="Yellow" Action="TextColor#FFF9AB00" Type="Menu Item" AccessibleName="Yellow" ID="AdaptiveTextColor_TextColor_FFF9AB00" />
              <Button Content="Navy" Action="TextColor#FF1B4F72" Type="Menu Item" AccessibleName="Navy" ID="AdaptiveTextColor_TextColor_FF1B4F72" />
              <Button Content="Brown" Action="TextColor#FF795548" Type="Menu Item" AccessibleName="Brown" ID="AdaptiveTextColor_TextColor_FF795548" />
            </Button>
          </Container>
          <Container Type="Overlay" Width="12" Height="4" Background="{Binding TextColor}" VerticalAlignment="Center" Active="{Binding TextColorUniform}" ID="AdaptiveFormatSection_Overlay" />
          <Text Text="—" Width="12" VerticalAlignment="Center" Active="{Binding TextColorMixed}" Tooltip="Mixed text colours" ID="AdaptiveFormatSection_Text" />
          <Container Type="Menu" ID="AdaptiveFormatSection_Menu_2" Tooltip="{Binding HighlightControlHint}">
            <Button Type="Menu Item" Content="" Height="32" Padding="7 0" AccessibleName="Highlight colour" ID="AdaptiveHighlight" IconSource="icon:highlighter" IconSize="18" IconOnly="True" Width="32" Tooltip="{Binding HighlightControlHint}" IsEnabled="{Binding CanUseTypography}">
              <Button Content="None" Action="HighlightNone" Type="Menu Item" AccessibleName="None" ID="AdaptiveHighlight_HighlightNone" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Yellow" Action="Highlight#FFFFFF00" Type="Menu Item" AccessibleName="Yellow" ID="AdaptiveHighlight_Highlight_FFFFFF00" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Green" Action="Highlight#FFCCFF90" Type="Menu Item" AccessibleName="Green" ID="AdaptiveHighlight_Highlight_FFCCFF90" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Blue" Action="Highlight#FFB3E5FC" Type="Menu Item" AccessibleName="Blue" ID="AdaptiveHighlight_Highlight_FFB3E5FC" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Pink" Action="Highlight#FFF8BBD0" Type="Menu Item" AccessibleName="Pink" ID="AdaptiveHighlight_Highlight_FFF8BBD0" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Orange" Action="Highlight#FFFFE0B2" Type="Menu Item" AccessibleName="Orange" ID="AdaptiveHighlight_Highlight_FFFFE0B2" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Grey" Action="Highlight#FFE0E0E0" Type="Menu Item" AccessibleName="Grey" ID="AdaptiveHighlight_Highlight_FFE0E0E0" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Peach" Action="Highlight#FFFFF3C4" Type="Menu Item" AccessibleName="Peach" ID="AdaptiveHighlight_Highlight_FFFFF3C4" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
            </Button>
          </Container>
          <Container Type="Overlay" Width="12" Height="4" Background="{Binding HighlightColor}" VerticalAlignment="Center" Active="{Binding HighlightColorUniform}" ID="AdaptiveFormatSection_Overlay_2" />
          <Text Text="—" Width="12" VerticalAlignment="Center" Active="{Binding HighlightColorMixed}" Tooltip="Mixed highlight colours" ID="AdaptiveFormatSection_Text_2" />
          <Container Type="Separator" Width="1" Height="22" Margin="5 0" Background="{Resource CuiLineBrush}" ID="AdaptiveFormatSection_Separator" />
        </Container>
        <Container ID="AdaptiveParagraphSection" Type="Horizontal Stack" CellGap="2" VerticalAlignment="Center" Active="{Binding TextMode}">
          <Container Type="Menu" ID="AdaptiveParagraphSection_Menu" Tooltip="{Binding AlignmentControlHint}">
            <Button Type="Menu Item" Content="" Height="32" Padding="0" AccessibleName="Alignment" IconSource="{Binding AlignIcon}" IconOnly="True" IconSize="18" Width="32" Tooltip="{Binding AlignmentControlHint}" ID="AdaptiveParagraphSection_Menu_Alignment" IsEnabled="{Binding CanUseParagraphAlignment}">
              <Button Content="Left" Action="AlignLeft" Type="Menu Item" AccessibleName="Left" ID="AdaptiveParagraphSection_Menu_Alignment_AlignLeft" IsEnabled="{Binding CanUseParagraphAlignment}" Tooltip="{Binding AlignmentControlHint}" />
              <Button Content="Center" Action="AlignCenter" Type="Menu Item" AccessibleName="Center" ID="AdaptiveParagraphSection_Menu_Alignment_AlignCenter" IsEnabled="{Binding CanUseParagraphAlignment}" Tooltip="{Binding AlignmentControlHint}" />
              <Button Content="Right" Action="AlignRight" Type="Menu Item" AccessibleName="Right" ID="AdaptiveParagraphSection_Menu_Alignment_AlignRight" IsEnabled="{Binding CanUseParagraphAlignment}" Tooltip="{Binding AlignmentControlHint}" />
              <Button Content="Justify" Action="AlignJustify" Type="Menu Item" AccessibleName="Justify" ID="AdaptiveParagraphSection_Menu_Alignment_AlignJustify" IsEnabled="{Binding CanUseParagraphAlignment}" Tooltip="{Binding AlignmentControlHint}" />
            </Button>
          </Container>
          <Container Type="Menu" ID="AdaptiveParagraphSection_Menu_2" Tooltip="{Binding ListControlHint}">
            <Button Type="Menu Item" Content="" Height="32" Padding="0" AccessibleName="List" IconSource="{Binding ListIcon}" IconOnly="True" IconSize="18" Width="32" Tooltip="{Binding ListControlHint}" ID="AdaptiveParagraphSection_Menu_2_List" IsEnabled="{Binding CanChangeListKind}">
              <Button Content="None" Action="ListNone" Type="Menu Item" AccessibleName="None" ID="AdaptiveParagraphSection_Menu_2_List_ListNone" IsEnabled="{Binding CanChangeListKind}" Tooltip="{Binding ListControlHint}" />
              <Button Content="Bulleted list" Action="ListBullets" Type="Menu Item" AccessibleName="Bulleted list" ID="AdaptiveParagraphSection_Menu_2_List_ListBullets" IsEnabled="{Binding CanChangeListKind}" Tooltip="{Binding ListControlHint}" />
              <Button Content="Numbered list" Action="ListNumbered" Type="Menu Item" AccessibleName="Numbered list" ID="AdaptiveParagraphSection_Menu_2_List_ListNumbered" IsEnabled="{Binding CanChangeListKind}" Tooltip="{Binding ListControlHint}" />
              <Button Content="Checklist" Action="ListChecklist" Type="Menu Item" AccessibleName="Checklist" ID="AdaptiveParagraphSection_Menu_2_List_ListChecklist" IsEnabled="{Binding CanChangeListKind}" Tooltip="{Binding ListControlHint}" />
            </Button>
          </Container>
          <Container Type="Menu" ID="AdaptiveParagraphSection_Menu_3" Tooltip="{Binding SpacingControlHint}">
            <Button Type="Menu Item" Content="{Binding CompactSpacing}" Height="32" Padding="2 0" AccessibleName="Line spacing" Width="48" Tooltip="{Binding SpacingControlHint}" ID="AdaptiveParagraphSection_Menu_3_Line_spacing" IsEnabled="{Binding CanUseTypography}">
              <Button Content="1" Action="Spacing1" Type="Menu Item" AccessibleName="1" ID="AdaptiveParagraphSection_Menu_3_Line_spacing_Spacing1" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding SpacingControlHint}" />
              <Button Content="1.25" Action="Spacing1.25" Type="Menu Item" AccessibleName="1.25" ID="AdaptiveParagraphSection_Menu_3_Line_spacing_Spacing1_25" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding SpacingControlHint}" />
              <Button Content="1.5" Action="Spacing1.5" Type="Menu Item" AccessibleName="1.5" ID="AdaptiveParagraphSection_Menu_3_Line_spacing_Spacing1_5" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding SpacingControlHint}" />
              <Button Content="2" Action="Spacing2" Type="Menu Item" AccessibleName="2" ID="AdaptiveParagraphSection_Menu_3_Line_spacing_Spacing2" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding SpacingControlHint}" />
            </Button>
          </Container>
          <Container Type="Menu" ID="AdaptiveParagraphSection_Menu_4">
            <Button Type="Menu Item" Content="" Height="32" Padding="0" AccessibleName="Indent" IconSource="icon:indent-increase" IconOnly="True" IconSize="18" Width="32" Tooltip="{Binding IndentLabel}" ID="AdaptiveParagraphSection_Menu_4_Indent">
              <Button Content="Decrease indent" Action="IndentDec" Type="Menu Item" AccessibleName="Decrease indent" ID="AdaptiveParagraphSection_Menu_4_Indent_IndentDec" />
              <Button Content="Increase indent" Action="IndentInc" Type="Menu Item" AccessibleName="Increase indent" ID="AdaptiveParagraphSection_Menu_4_Indent_IndentInc" />
            </Button>
          </Container>
        </Container>
        <Container ID="AdaptiveTableSection" Type="Horizontal Stack" CellGap="2" VerticalAlignment="Center" Active="{Binding TableMode}">
          <Container Type="Menu" ID="AdaptiveTableSection_Menu">
            <Button Type="Menu Item" Content="Table ▾" Height="32" Padding="7 0" AccessibleName="Table structure" ID="AdaptiveTableSection_Menu_Table_structure">
              <Button Content="+ Row" Action="ContextAddRow" Type="Menu Item" AccessibleName="+ Row" Interactive="{Binding ContextCanAddTableRow}" ID="AdaptiveTableSection_Menu_Table_structure_ContextAddRow" />
              <Button Content="− Row" Action="ContextDeleteRow" Type="Menu Item" AccessibleName="− Row" Interactive="{Binding ContextCanDeleteTableRow}" ID="AdaptiveTableSection_Menu_Table_structure_ContextDeleteRow" />
              <Button Content="+ Column" Action="ContextAddColumn" Type="Menu Item" AccessibleName="+ Column" Interactive="{Binding ContextCanAddTableColumn}" ID="AdaptiveTableSection_Menu_Table_structure_ContextAddColumn" />
              <Button Content="− Column" Action="ContextDeleteColumn" Type="Menu Item" AccessibleName="− Column" Interactive="{Binding ContextCanDeleteTableColumn}" ID="AdaptiveTableSection_Menu_Table_structure_ContextDeleteColumn" />
            </Button>
          </Container>
          <Container Type="Menu" ID="AdaptiveTableSection_Menu_2">
            <Button Type="Menu Item" Content="Cell ▾" Height="32" Padding="7 0" AccessibleName="Selected cell" ID="AdaptiveTableSection_Menu_2_Selected_cell">
              <Button Content="Merge right" Action="ContextMergeCellRight" Type="Menu Item" AccessibleName="Merge right" Interactive="{Binding ContextCanMergeCellRight}" ID="AdaptiveTableSection_Menu_2_Selected_cell_ContextMergeCellRight" />
              <Button Content="Merge down" Action="ContextMergeCellDown" Type="Menu Item" AccessibleName="Merge down" Interactive="{Binding ContextCanMergeCellDown}" ID="AdaptiveTableSection_Menu_2_Selected_cell_ContextMergeCellDown" />
              <Button Content="Split" Action="ContextSplitCell" Type="Menu Item" AccessibleName="Split" Interactive="{Binding ContextCanSplitCell}" ID="AdaptiveTableSection_Menu_2_Selected_cell_ContextSplitCell" />
            </Button>
          </Container>
          <Text Text="{Binding ContextColumnWidthLabel}" VerticalAlignment="Center" Margin="5 0" ID="AdaptiveTableSection_Binding_ContextColumnWidthLabel" />
          <Text Text="{Binding ContextRowHeightLabel}" VerticalAlignment="Center" Margin="5 0" ID="AdaptiveTableSection_Binding_ContextRowHeightLabel" />
        </Container>
        <Container ID="AdaptiveImageSection" Type="Horizontal Stack" CellGap="2" VerticalAlignment="Center" Active="{Binding ImageMode}">
          <Container Type="Menu" ID="AdaptiveImageSection_Menu">
            <Button Type="Menu Item" Content="Image ▾" Height="32" Padding="7 0" AccessibleName="Image tools" ID="AdaptiveImageSection_Menu_Image_tools">
              <Button Content="Replace image…" Action="ContextReplaceImage" Type="Menu Item" AccessibleName="Replace image…" ID="AdaptiveImageSection_Menu_Image_tools_ContextReplaceImage" />
              <Button Content="Natural size" Action="ContextImageNatural" Type="Menu Item" AccessibleName="Natural size" ID="AdaptiveImageSection_Menu_Image_tools_ContextImageNatural" />
              <Button Content="Rotate left" Action="ContextImageRotateLeft" Type="Menu Item" AccessibleName="Rotate left" ID="AdaptiveImageSection_Menu_Image_tools_ContextImageRotateLeft" />
              <Button Content="Rotate right" Action="ContextImageRotateRight" Type="Menu Item" AccessibleName="Rotate right" ID="AdaptiveImageSection_Menu_Image_tools_ContextImageRotateRight" />
            </Button>
          </Container>
          <Button Content="{Binding ImageFitLabel}" Action="ContextImageCycleFit" Type="Menu Item" AccessibleName="Image fit" Height="32" Padding="7 0" ID="AdaptiveImageSection_ContextImageCycleFit" />
        </Container>
        <Container ID="AdaptiveDrawingSection" Type="Horizontal Stack" CellGap="2" VerticalAlignment="Center" Active="{Binding DrawingMode}">
          <Container Type="Menu" ID="AdaptiveDrawingSection_Menu">
            <Button Type="Menu Item" Content="{Binding InkLabel}" Height="32" Padding="7 0" AccessibleName="Drawing tool" ID="AdaptiveDrawingSection_Menu_Drawing_tool">
              <Button Content="Pen" Action="InkPen" Type="Menu Item" AccessibleName="Pen drawing tool" IconSource="icon:pen" IconSize="18" ID="AdaptiveDrawingSection_Menu_Drawing_tool_InkPen" />
              <Button Content="Highlighter" Action="InkHighlighter" Type="Menu Item" AccessibleName="Highlighter drawing tool" IconSource="icon:highlighter" IconSize="18" ID="AdaptiveDrawingSection_Menu_Drawing_tool_InkHighlighter" />
              <Button Content="Eraser" Action="InkEraser" Type="Menu Item" AccessibleName="Eraser drawing tool" IconSource="icon:eraser" IconSize="18" ID="AdaptiveDrawingSection_Menu_Drawing_tool_InkEraser" />
              <Button Content="Select" Action="InkSelect" Type="Menu Item" AccessibleName="Select drawing tool" IconSource="icon:select" IconSize="18" ID="AdaptiveDrawingSection_Menu_Drawing_tool_InkSelect" />
            </Button>
          </Container>
          <Container Type="Menu" ID="AdaptiveDrawingSection_Menu_2">
            <Button Type="Menu Item" Content="{Binding InkWidthLabel}" Height="32" Padding="7 0" AccessibleName="Stroke width" ID="AdaptiveDrawingSection_Menu_2_Stroke_width">
              <Button Content="2 px" Action="InkWidth2" Type="Menu Item" AccessibleName="Stroke width 2" ID="AdaptiveDrawingSection_Menu_2_Stroke_width_InkWidth2" />
              <Button Content="4 px" Action="InkWidth4" Type="Menu Item" AccessibleName="Stroke width 4" ID="AdaptiveDrawingSection_Menu_2_Stroke_width_InkWidth4" />
              <Button Content="8 px" Action="InkWidth8" Type="Menu Item" AccessibleName="Stroke width 8" ID="AdaptiveDrawingSection_Menu_2_Stroke_width_InkWidth8" />
              <Button Content="12 px" Action="InkWidth12" Type="Menu Item" AccessibleName="Stroke width 12" ID="AdaptiveDrawingSection_Menu_2_Stroke_width_InkWidth12" />
            </Button>
          </Container>
          <Container Type="Menu" ID="AdaptiveDrawingSection_Menu_3">
            <Button Type="Menu Item" Content="Ink colour ▾" Height="32" Padding="7 0" AccessibleName="Ink colour" ID="AdaptiveDrawingSection_Menu_3_Ink_colour">
              <Button Content="Black" Action="InkColor#FF111111" Type="Menu Item" AccessibleName="Black ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FF111111" />
              <Button Content="Dark grey" Action="InkColor#FF5F6368" Type="Menu Item" AccessibleName="Dark grey ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FF5F6368" />
              <Button Content="Grey" Action="InkColor#FF9AA0A6" Type="Menu Item" AccessibleName="Grey ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FF9AA0A6" />
              <Button Content="Red" Action="InkColor#FFD32F2F" Type="Menu Item" AccessibleName="Red ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FFD32F2F" />
              <Button Content="Orange" Action="InkColor#FFE8710A" Type="Menu Item" AccessibleName="Orange ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FFE8710A" />
              <Button Content="Green" Action="InkColor#FF1E8E3E" Type="Menu Item" AccessibleName="Green ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FF1E8E3E" />
              <Button Content="Blue" Action="InkColor#FF1A73E8" Type="Menu Item" AccessibleName="Blue ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FF1A73E8" />
              <Button Content="Purple" Action="InkColor#FF9334E6" Type="Menu Item" AccessibleName="Purple ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FF9334E6" />
              <Button Content="White" Action="InkColor#FFFFFFFF" Type="Menu Item" AccessibleName="White ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FFFFFFFF" />
              <Button Content="Yellow" Action="InkColor#FFF9AB00" Type="Menu Item" AccessibleName="Yellow ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FFF9AB00" />
              <Button Content="Navy" Action="InkColor#FF1B4F72" Type="Menu Item" AccessibleName="Navy ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FF1B4F72" />
              <Button Content="Brown" Action="InkColor#FF795548" Type="Menu Item" AccessibleName="Brown ink" ID="AdaptiveDrawingSection_Menu_3_Ink_colour_InkColor_FF795548" />
            </Button>
          </Container>
          <Container Type="Menu" ID="AdaptiveDrawingSection_Menu_4">
            <Button Type="Menu Item" Content="View ▾" Height="32" Padding="7 0" AccessibleName="Drawing view" ID="AdaptiveDrawingSection_Menu_4_Drawing_view">
              <Button Content="Zoom in" Action="InkZoomIn" Type="Menu Item" AccessibleName="Zoom drawing in" ID="AdaptiveDrawingSection_Menu_4_Drawing_view_InkZoomIn" />
              <Button Content="Zoom out" Action="InkZoomOut" Type="Menu Item" AccessibleName="Zoom drawing out" ID="AdaptiveDrawingSection_Menu_4_Drawing_view_InkZoomOut" />
              <Button Content="Reset view" Action="InkResetView" Type="Menu Item" AccessibleName="Reset drawing view" ID="AdaptiveDrawingSection_Menu_4_Drawing_view_InkResetView" />
              <Button Content="Undo drawing" Action="Undo" Type="Menu Item" AccessibleName="Undo drawing" Interactive="{Binding CanUndo}" ID="AdaptiveDrawingSection_Menu_4_Drawing_view_Undo" />
              <Button Content="Redo drawing" Action="Redo" Type="Menu Item" AccessibleName="Redo drawing" Interactive="{Binding CanRedo}" ID="AdaptiveDrawingSection_Menu_4_Drawing_view_Redo" />
            </Button>
          </Container>
          <Container Type="Overlay" Width="16" Height="4" Background="{Binding InkColor}" VerticalAlignment="Center" ID="AdaptiveDrawingSection_Overlay" />
        </Container>
        <Container ID="AdaptiveObjectSection" Type="Horizontal Stack" CellGap="2" VerticalAlignment="Center" Active="{Binding OtherMode}">
          <Text Text="{Binding ObjectLabel}" VerticalAlignment="Center" Margin="8 0" ID="AdaptiveObjectSection_Binding_ObjectLabel" />
        </Container>
        <Container Type="Menu" ID="AdaptivePill_Menu">
          <Button Type="Menu Item" Content="" Height="32" Padding="0" AccessibleName="Properties" ID="AdaptiveProperties" IconSource="icon:settings" IconOnly="True" IconSize="18" Width="32" Tooltip="Properties">
            <Button Content="More properties" Action="Properties" Type="Menu Item" AccessibleName="More properties" Interactive="{Binding CanUseProperties}" ID="AdaptiveProperties_Properties" />
            <Button Content="Subscript" Action="ToggleSub" Type="Menu Item" AccessibleName="Subscript" ID="AdaptiveProperties_ToggleSub" />
            <Button Content="Superscript" Action="ToggleSup" Type="Menu Item" AccessibleName="Superscript" ID="AdaptiveProperties_ToggleSup" />
            <Button Content="Clear formatting" Action="ClearFormat" Type="Menu Item" AccessibleName="Clear formatting" ID="AdaptiveProperties_ClearFormat" />
            <Button Content="Manage styles…" Action="ManageStyles" Type="Menu Item" AccessibleName="Manage styles…" ID="AdaptiveProperties_ManageStyles" />
          </Button>
        </Container>
        <Container Type="Menu" OverflowHost="True" ID="AdaptivePill_Menu_2">
          <Button Type="Menu Item" Content="…" Height="32" Padding="0" AccessibleName="More formatting tools" ID="OverflowAdaptiveOverflow" Width="32">
            <Button Type="Menu Item" Content="Font and style" ID="OverflowAdaptiveOverflow_Font_and_style">
              <Container Type="Vertical Stack" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack" Tooltip="{Binding TypographyGroupHint}">
                <Input ID="OverflowAdaptiveStyle" Type="Select" Width="124" Height="32" ItemsSource="{Binding StyleNames}" SelectedIndex="{Binding StyleIndex, mode=TwoWay}" AccessibleName="Paragraph style" MinHeight="32" VerticalAlignment="Center" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding StyleControlHint}" />
                <Input ID="OverflowAdaptiveFont" Type="Text" Width="98" Height="32" Value="{Binding FontDraft, mode=TwoWay}" SubmitAction="ApplyFont" AccessibleName="Font family" Tooltip="{Binding FontControlHint}" Padding="6 0" MinHeight="32" MaxHeight="32" VerticalContentAlignment="Center" VerticalAlignment="Center" FontSize="13" IsEnabled="{Binding CanUseTypography}" />
                <Container Type="Menu" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu" Tooltip="{Binding FontControlHint}">
                  <Button Type="Menu Item" Content="⌄" Height="32" Padding="0" AccessibleName="Choose font family" Width="24" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_Choose_font_family" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}">
                    <Button Content="Default" Action="FontDefault" Type="Menu Item" AccessibleName="Default" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_Choose_font_family_FontDefault" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
                    <Button Content="Inter" Action="FontInter" Type="Menu Item" AccessibleName="Inter" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_Choose_font_family_FontInter" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
                    <Button Content="Georgia" Action="FontGeorgia" Type="Menu Item" AccessibleName="Georgia" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_Choose_font_family_FontGeorgia" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
                    <Button Content="Cascadia Mono" Action="FontMono" Type="Menu Item" AccessibleName="Cascadia Mono" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_Choose_font_family_FontMono" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
                    <Button Content="Segoe UI" Action="FontSegoe" Type="Menu Item" AccessibleName="Segoe UI" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_Choose_font_family_FontSegoe" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
                    <Button Content="Times New Roman" Action="FontTimes" Type="Menu Item" AccessibleName="Times New Roman" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_Choose_font_family_FontTimes" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding FontControlHint}" />
                  </Button>
                </Container>
                <Button Content="−" Action="FontSmaller" AccessibleName="Decrease font size" Width="26" Height="32" Padding="0" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_FontSmaller" MinWidth="26" MinHeight="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderWidth="0" FontSize="17" Tooltip="{Binding FontControlHint}" IsEnabled="{Binding CanUseTypography}" />
                <Input ID="OverflowAdaptiveSize" Type="Text" Width="43" Height="32" Value="{Binding SizeDraft, mode=TwoWay}" SubmitAction="ApplySize" AccessibleName="Font size" Tooltip="{Binding SizeControlHint}" Padding="6 0" MinHeight="32" MaxHeight="32" VerticalContentAlignment="Center" VerticalAlignment="Center" FontSize="13" IsEnabled="{Binding CanUseTypography}" />
                <Text Text="px" VerticalAlignment="Center" FontSize="11" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_px" />
                <Button Content="+" Action="FontBigger" AccessibleName="Increase font size" Width="26" Height="32" Padding="0" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_FontBigger" MinWidth="26" MinHeight="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderWidth="0" FontSize="17" Tooltip="{Binding FontControlHint}" IsEnabled="{Binding CanUseTypography}" />
                <Container Type="Menu" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_2">
                  <Button Type="Menu Item" Content="Aa ▾" Height="32" Padding="7 0" AccessibleName="Text case" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_2_Text_case" Tooltip="Change text case">
                    <Button Content="UPPERCASE" Action="CaseUpper" Type="Menu Item" AccessibleName="UPPERCASE" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_2_Text_case_CaseUpper" Tooltip="Change text case" />
                    <Button Content="lowercase" Action="CaseLower" Type="Menu Item" AccessibleName="lowercase" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Menu_2_Text_case_CaseLower" Tooltip="Change text case" />
                  </Button>
                </Container>
                <Container Type="Separator" Width="1" Height="22" Margin="5 0" Background="{Resource CuiLineBrush}" ID="OverflowAdaptiveOverflow_Font_and_style_Vertical_Stack_Separator" />
              </Container>
            </Button>
            <Button Type="Menu Item" Content="Text" ID="OverflowAdaptiveOverflow_Text">
              <Button Content="Bold" Action="ToggleBold" Type="Menu Item" AccessibleName="Bold" ID="OverflowRangeBold" />
              <Button Content="Italic" Action="ToggleItalic" Type="Menu Item" AccessibleName="Italic" ID="OverflowRangeItalic" />
              <Button Content="Underline" Action="ToggleUnderline" Type="Menu Item" AccessibleName="Underline" ID="OverflowRangeUnderline" />
              <Button Content="Strikethrough" Action="ToggleStrike" Type="Menu Item" AccessibleName="Strikethrough" ID="OverflowRangeStrike" />
              <Button Content="Text properties" Action="Properties" Type="Menu Item" AccessibleName="Text properties" Interactive="{Binding CanUseProperties}" ID="OverflowAdaptiveOverflow_Text_Properties" />
              <Button Content="Align left" Action="AlignLeft" Type="Menu Item" AccessibleName="Align left" ID="OverflowAdaptiveOverflow_Text_AlignLeft" IsEnabled="{Binding CanUseParagraphAlignment}" Tooltip="{Binding AlignmentControlHint}" />
              <Button Content="Align center" Action="AlignCenter" Type="Menu Item" AccessibleName="Align center" ID="OverflowAdaptiveOverflow_Text_AlignCenter" IsEnabled="{Binding CanUseParagraphAlignment}" Tooltip="{Binding AlignmentControlHint}" />
              <Button Content="Align right" Action="AlignRight" Type="Menu Item" AccessibleName="Align right" ID="OverflowAdaptiveOverflow_Text_AlignRight" IsEnabled="{Binding CanUseParagraphAlignment}" Tooltip="{Binding AlignmentControlHint}" />
              <Button Content="Align justify" Action="AlignJustify" Type="Menu Item" AccessibleName="Align justify" ID="OverflowAdaptiveOverflow_Text_AlignJustify" IsEnabled="{Binding CanUseParagraphAlignment}" Tooltip="{Binding AlignmentControlHint}" />
              <Button Content="Bulleted list" Action="ListBullets" Type="Menu Item" AccessibleName="Bulleted list" ID="OverflowAdaptiveOverflow_Text_ListBullets" IsEnabled="{Binding CanChangeListKind}" Tooltip="{Binding ListControlHint}" />
              <Button Content="Numbered list" Action="ListNumbered" Type="Menu Item" AccessibleName="Numbered list" ID="OverflowAdaptiveOverflow_Text_ListNumbered" IsEnabled="{Binding CanChangeListKind}" Tooltip="{Binding ListControlHint}" />
              <Button Content="Checklist" Action="ListChecklist" Type="Menu Item" AccessibleName="Checklist" ID="OverflowAdaptiveOverflow_Text_ListChecklist" IsEnabled="{Binding CanChangeListKind}" Tooltip="{Binding ListControlHint}" />
              <Button Content="Increase indent" Action="IndentInc" Type="Menu Item" AccessibleName="Increase indent" ID="OverflowAdaptiveOverflow_Text_IndentInc" />
              <Button Content="Decrease indent" Action="IndentDec" Type="Menu Item" AccessibleName="Decrease indent" ID="OverflowAdaptiveOverflow_Text_IndentDec" />
              <Button Content="Line spacing 1.5" Action="Spacing1.5" Type="Menu Item" AccessibleName="Line spacing 1.5" ID="OverflowAdaptiveOverflow_Text_Spacing1_5" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding SpacingControlHint}" />
              <Button Content="Subscript" Action="ToggleSub" Type="Menu Item" AccessibleName="Subscript" ID="OverflowAdaptiveOverflow_Text_ToggleSub" />
              <Button Content="Superscript" Action="ToggleSup" Type="Menu Item" AccessibleName="Superscript" ID="OverflowAdaptiveOverflow_Text_ToggleSup" />
              <Button Content="Clear formatting" Action="ClearFormat" Type="Menu Item" AccessibleName="Clear formatting" ID="OverflowAdaptiveOverflow_Text_ClearFormat" />
              <Button Content="Manage styles…" Action="ManageStyles" Type="Menu Item" AccessibleName="Manage styles…" ID="OverflowAdaptiveOverflow_Text_ManageStyles" />
              <Button Content="Line spacing 1" Action="Spacing1" Type="Menu Item" AccessibleName="Line spacing 1" ID="OverflowAdaptiveOverflow_Text_Spacing1" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding SpacingControlHint}" />
              <Button Content="Line spacing 1.25" Action="Spacing1.25" Type="Menu Item" AccessibleName="Line spacing 1.25" ID="OverflowAdaptiveOverflow_Text_Spacing1_25" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding SpacingControlHint}" />
              <Button Content="Line spacing 2" Action="Spacing2" Type="Menu Item" AccessibleName="Line spacing 2" ID="OverflowAdaptiveOverflow_Text_Spacing2" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding SpacingControlHint}" />
            </Button>
            <Button Type="Menu Item" Content="Colours" ID="OverflowAdaptiveOverflow_Colours">
              <Button Content="Black" Action="TextColor#FF111111" Type="Menu Item" AccessibleName="Black" ID="OverflowAdaptiveOverflow_Colours_TextColor_FF111111" />
              <Button Content="Dark grey" Action="TextColor#FF5F6368" Type="Menu Item" AccessibleName="Dark grey" ID="OverflowAdaptiveOverflow_Colours_TextColor_FF5F6368" />
              <Button Content="Grey" Action="TextColor#FF9AA0A6" Type="Menu Item" AccessibleName="Grey" ID="OverflowAdaptiveOverflow_Colours_TextColor_FF9AA0A6" />
              <Button Content="Red" Action="TextColor#FFD32F2F" Type="Menu Item" AccessibleName="Red" ID="OverflowAdaptiveOverflow_Colours_TextColor_FFD32F2F" />
              <Button Content="Orange" Action="TextColor#FFE8710A" Type="Menu Item" AccessibleName="Orange" ID="OverflowAdaptiveOverflow_Colours_TextColor_FFE8710A" />
              <Button Content="Green" Action="TextColor#FF1E8E3E" Type="Menu Item" AccessibleName="Green" ID="OverflowAdaptiveOverflow_Colours_TextColor_FF1E8E3E" />
              <Button Content="Blue" Action="TextColor#FF1A73E8" Type="Menu Item" AccessibleName="Blue" ID="OverflowAdaptiveOverflow_Colours_TextColor_FF1A73E8" />
              <Button Content="Purple" Action="TextColor#FF9334E6" Type="Menu Item" AccessibleName="Purple" ID="OverflowAdaptiveOverflow_Colours_TextColor_FF9334E6" />
              <Button Content="White" Action="TextColor#FFFFFFFF" Type="Menu Item" AccessibleName="White" ID="OverflowAdaptiveOverflow_Colours_TextColor_FFFFFFFF" />
              <Button Content="Yellow" Action="TextColor#FFF9AB00" Type="Menu Item" AccessibleName="Yellow" ID="OverflowAdaptiveOverflow_Colours_TextColor_FFF9AB00" />
              <Button Content="Navy" Action="TextColor#FF1B4F72" Type="Menu Item" AccessibleName="Navy" ID="OverflowAdaptiveOverflow_Colours_TextColor_FF1B4F72" />
              <Button Content="Brown" Action="TextColor#FF795548" Type="Menu Item" AccessibleName="Brown" ID="OverflowAdaptiveOverflow_Colours_TextColor_FF795548" />
              <Button Content="Highlight None" Action="HighlightNone" Type="Menu Item" AccessibleName="Highlight None" ID="OverflowAdaptiveOverflow_Colours_HighlightNone" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Highlight Yellow" Action="Highlight#FFFFFF00" Type="Menu Item" AccessibleName="Highlight Yellow" ID="OverflowAdaptiveOverflow_Colours_Highlight_FFFFFF00" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Highlight Green" Action="Highlight#FFCCFF90" Type="Menu Item" AccessibleName="Highlight Green" ID="OverflowAdaptiveOverflow_Colours_Highlight_FFCCFF90" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Highlight Blue" Action="Highlight#FFB3E5FC" Type="Menu Item" AccessibleName="Highlight Blue" ID="OverflowAdaptiveOverflow_Colours_Highlight_FFB3E5FC" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Highlight Pink" Action="Highlight#FFF8BBD0" Type="Menu Item" AccessibleName="Highlight Pink" ID="OverflowAdaptiveOverflow_Colours_Highlight_FFF8BBD0" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Highlight Orange" Action="Highlight#FFFFE0B2" Type="Menu Item" AccessibleName="Highlight Orange" ID="OverflowAdaptiveOverflow_Colours_Highlight_FFFFE0B2" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Highlight Grey" Action="Highlight#FFE0E0E0" Type="Menu Item" AccessibleName="Highlight Grey" ID="OverflowAdaptiveOverflow_Colours_Highlight_FFE0E0E0" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
              <Button Content="Highlight Peach" Action="Highlight#FFFFF3C4" Type="Menu Item" AccessibleName="Highlight Peach" ID="OverflowAdaptiveOverflow_Colours_Highlight_FFFFF3C4" IsEnabled="{Binding CanUseTypography}" Tooltip="{Binding HighlightControlHint}" />
            </Button>
            <Button Type="Menu Item" Content="Table" Active="{Binding TableMode}" ID="OverflowAdaptiveOverflow_Table">
              <Container Type="Menu" ID="OverflowAdaptiveOverflow_Table_Menu">
                <Button Type="Menu Item" Content="Table ▾" Height="32" Padding="7 0" AccessibleName="Table structure" ID="OverflowAdaptiveOverflow_Table_Menu_Table_structure">
                  <Button Content="+ Row" Action="ContextAddRow" Type="Menu Item" AccessibleName="+ Row" Interactive="{Binding ContextCanAddTableRow}" ID="OverflowAdaptiveOverflow_Table_Menu_Table_structure_ContextAddRow" />
                  <Button Content="− Row" Action="ContextDeleteRow" Type="Menu Item" AccessibleName="− Row" Interactive="{Binding ContextCanDeleteTableRow}" ID="OverflowAdaptiveOverflow_Table_Menu_Table_structure_ContextDeleteRow" />
                  <Button Content="+ Column" Action="ContextAddColumn" Type="Menu Item" AccessibleName="+ Column" Interactive="{Binding ContextCanAddTableColumn}" ID="OverflowAdaptiveOverflow_Table_Menu_Table_structure_ContextAddColumn" />
                  <Button Content="− Column" Action="ContextDeleteColumn" Type="Menu Item" AccessibleName="− Column" Interactive="{Binding ContextCanDeleteTableColumn}" ID="OverflowAdaptiveOverflow_Table_Menu_Table_structure_ContextDeleteColumn" />
                </Button>
              </Container>
              <Container Type="Menu" ID="OverflowAdaptiveOverflow_Table_Menu_2">
                <Button Type="Menu Item" Content="Cell ▾" Height="32" Padding="7 0" AccessibleName="Selected cell" ID="OverflowAdaptiveOverflow_Table_Menu_2_Selected_cell">
                  <Button Content="Merge right" Action="ContextMergeCellRight" Type="Menu Item" AccessibleName="Merge right" Interactive="{Binding ContextCanMergeCellRight}" ID="OverflowAdaptiveOverflow_Table_Menu_2_Selected_cell_ContextMergeCellRight" />
                  <Button Content="Merge down" Action="ContextMergeCellDown" Type="Menu Item" AccessibleName="Merge down" Interactive="{Binding ContextCanMergeCellDown}" ID="OverflowAdaptiveOverflow_Table_Menu_2_Selected_cell_ContextMergeCellDown" />
                  <Button Content="Split" Action="ContextSplitCell" Type="Menu Item" AccessibleName="Split" Interactive="{Binding ContextCanSplitCell}" ID="OverflowAdaptiveOverflow_Table_Menu_2_Selected_cell_ContextSplitCell" />
                </Button>
              </Container>
              <Text Text="{Binding ContextColumnWidthLabel}" VerticalAlignment="Center" Margin="5 0" ID="OverflowAdaptiveOverflow_Table_Binding_ContextColumnWidthLabel" />
              <Text Text="{Binding ContextRowHeightLabel}" VerticalAlignment="Center" Margin="5 0" ID="OverflowAdaptiveOverflow_Table_Binding_ContextRowHeightLabel" />
            </Button>
            <Button Type="Menu Item" Content="Image" Active="{Binding ImageMode}" ID="OverflowAdaptiveOverflow_Image">
              <Container Type="Menu" ID="OverflowAdaptiveOverflow_Image_Menu">
                <Button Type="Menu Item" Content="Image ▾" Height="32" Padding="7 0" AccessibleName="Image tools" ID="OverflowAdaptiveOverflow_Image_Menu_Image_tools">
                  <Button Content="Replace image…" Action="ContextReplaceImage" Type="Menu Item" AccessibleName="Replace image…" ID="OverflowAdaptiveOverflow_Image_Menu_Image_tools_ContextReplaceImage" />
                  <Button Content="Natural size" Action="ContextImageNatural" Type="Menu Item" AccessibleName="Natural size" ID="OverflowAdaptiveOverflow_Image_Menu_Image_tools_ContextImageNatural" />
                  <Button Content="Rotate left" Action="ContextImageRotateLeft" Type="Menu Item" AccessibleName="Rotate left" ID="OverflowAdaptiveOverflow_Image_Menu_Image_tools_ContextImageRotateLeft" />
                  <Button Content="Rotate right" Action="ContextImageRotateRight" Type="Menu Item" AccessibleName="Rotate right" ID="OverflowAdaptiveOverflow_Image_Menu_Image_tools_ContextImageRotateRight" />
                </Button>
              </Container>
              <Button Content="{Binding ImageFitLabel}" Action="ContextImageCycleFit" Type="Menu Item" AccessibleName="Image fit" Height="32" Padding="7 0" ID="OverflowAdaptiveOverflow_Image_ContextImageCycleFit" />
            </Button>
            <Button Type="Menu Item" Content="Drawing" Active="{Binding DrawingMode}" ID="OverflowAdaptiveOverflow_Drawing">
              <Container Type="Menu" ID="OverflowAdaptiveOverflow_Drawing_Menu">
                <Button Type="Menu Item" Content="{Binding InkLabel}" Height="32" Padding="7 0" AccessibleName="Drawing tool" ID="OverflowAdaptiveOverflow_Drawing_Menu_Drawing_tool">
                  <Button Content="Pen" Action="InkPen" Type="Menu Item" AccessibleName="Pen drawing tool" IconSource="icon:pen" IconSize="18" ID="OverflowAdaptiveOverflow_Drawing_Menu_Drawing_tool_InkPen" />
                  <Button Content="Highlighter" Action="InkHighlighter" Type="Menu Item" AccessibleName="Highlighter drawing tool" IconSource="icon:highlighter" IconSize="18" ID="OverflowAdaptiveOverflow_Drawing_Menu_Drawing_tool_InkHighlighter" />
                  <Button Content="Eraser" Action="InkEraser" Type="Menu Item" AccessibleName="Eraser drawing tool" IconSource="icon:eraser" IconSize="18" ID="OverflowAdaptiveOverflow_Drawing_Menu_Drawing_tool_InkEraser" />
                  <Button Content="Select" Action="InkSelect" Type="Menu Item" AccessibleName="Select drawing tool" IconSource="icon:select" IconSize="18" ID="OverflowAdaptiveOverflow_Drawing_Menu_Drawing_tool_InkSelect" />
                </Button>
              </Container>
              <Container Type="Menu" ID="OverflowAdaptiveOverflow_Drawing_Menu_2">
                <Button Type="Menu Item" Content="{Binding InkWidthLabel}" Height="32" Padding="7 0" AccessibleName="Stroke width" ID="OverflowAdaptiveOverflow_Drawing_Menu_2_Stroke_width">
                  <Button Content="2 px" Action="InkWidth2" Type="Menu Item" AccessibleName="Stroke width 2" ID="OverflowAdaptiveOverflow_Drawing_Menu_2_Stroke_width_InkWidth2" />
                  <Button Content="4 px" Action="InkWidth4" Type="Menu Item" AccessibleName="Stroke width 4" ID="OverflowAdaptiveOverflow_Drawing_Menu_2_Stroke_width_InkWidth4" />
                  <Button Content="8 px" Action="InkWidth8" Type="Menu Item" AccessibleName="Stroke width 8" ID="OverflowAdaptiveOverflow_Drawing_Menu_2_Stroke_width_InkWidth8" />
                  <Button Content="12 px" Action="InkWidth12" Type="Menu Item" AccessibleName="Stroke width 12" ID="OverflowAdaptiveOverflow_Drawing_Menu_2_Stroke_width_InkWidth12" />
                </Button>
              </Container>
              <Container Type="Menu" ID="OverflowAdaptiveOverflow_Drawing_Menu_3">
                <Button Type="Menu Item" Content="Ink colour ▾" Height="32" Padding="7 0" AccessibleName="Ink colour" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour">
                  <Button Content="Black" Action="InkColor#FF111111" Type="Menu Item" AccessibleName="Black ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF111111" />
                  <Button Content="Dark grey" Action="InkColor#FF5F6368" Type="Menu Item" AccessibleName="Dark grey ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF5F6368" />
                  <Button Content="Grey" Action="InkColor#FF9AA0A6" Type="Menu Item" AccessibleName="Grey ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF9AA0A6" />
                  <Button Content="Red" Action="InkColor#FFD32F2F" Type="Menu Item" AccessibleName="Red ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FFD32F2F" />
                  <Button Content="Orange" Action="InkColor#FFE8710A" Type="Menu Item" AccessibleName="Orange ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FFE8710A" />
                  <Button Content="Green" Action="InkColor#FF1E8E3E" Type="Menu Item" AccessibleName="Green ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF1E8E3E" />
                  <Button Content="Blue" Action="InkColor#FF1A73E8" Type="Menu Item" AccessibleName="Blue ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF1A73E8" />
                  <Button Content="Purple" Action="InkColor#FF9334E6" Type="Menu Item" AccessibleName="Purple ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF9334E6" />
                  <Button Content="White" Action="InkColor#FFFFFFFF" Type="Menu Item" AccessibleName="White ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FFFFFFFF" />
                  <Button Content="Yellow" Action="InkColor#FFF9AB00" Type="Menu Item" AccessibleName="Yellow ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FFF9AB00" />
                  <Button Content="Navy" Action="InkColor#FF1B4F72" Type="Menu Item" AccessibleName="Navy ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF1B4F72" />
                  <Button Content="Brown" Action="InkColor#FF795548" Type="Menu Item" AccessibleName="Brown ink" ID="OverflowAdaptiveOverflow_Drawing_Menu_3_Ink_colour_InkColor_FF795548" />
                </Button>
              </Container>
              <Container Type="Menu" ID="OverflowAdaptiveOverflow_Drawing_Menu_4">
                <Button Type="Menu Item" Content="View ▾" Height="32" Padding="7 0" AccessibleName="Drawing view" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view">
                  <Button Content="Zoom in" Action="InkZoomIn" Type="Menu Item" AccessibleName="Zoom drawing in" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view_InkZoomIn" />
                  <Button Content="Zoom out" Action="InkZoomOut" Type="Menu Item" AccessibleName="Zoom drawing out" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view_InkZoomOut" />
                  <Button Content="Reset view" Action="InkResetView" Type="Menu Item" AccessibleName="Reset drawing view" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view_InkResetView" />
                  <Button Content="Undo drawing" Action="Undo" Type="Menu Item" AccessibleName="Undo drawing" Interactive="{Binding CanUndo}" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view_Undo" />
                  <Button Content="Redo drawing" Action="Redo" Type="Menu Item" AccessibleName="Redo drawing" Interactive="{Binding CanRedo}" ID="OverflowAdaptiveOverflow_Drawing_Menu_4_Drawing_view_Redo" />
                </Button>
              </Container>
              <Container Type="Overlay" Width="16" Height="4" Background="{Binding InkColor}" VerticalAlignment="Center" ID="OverflowAdaptiveOverflow_Drawing_Overlay" />
            </Button>
          </Button>
        </Container>
      </Container>
      <Container ID="AdaptiveFixedActions" Type="Horizontal Stack" Column="1" CellGap="4" VerticalAlignment="Center" Background="{Resource CuiFloatingSurfaceMaterial}" Padding="4" CornerRadius="15">
        <Button ID="AdaptiveAdd" Content="+ Add" AccessibleName="Insert" Tooltip="Insert a block" Height="36" Padding="10 0" CornerRadius="12" Interactive="{Binding CanEditToolbar}" />
        <Button ID="AdaptiveDrawing" Action="ToggleDrawing" Selected="{Binding DrawingMode}" AccessibleName="Drawing" Height="36" Padding="10 0" CornerRadius="12" Interactive="{Binding CanEditToolbar}">
          <Container Type="Horizontal Stack" CellGap="5" VerticalAlignment="Center" ID="AdaptiveDrawing_Horizontal_Stack">
            <Image Source="icon:pen" Width="18" Height="18" ID="AdaptiveDrawing_Horizontal_Stack_Image" />
            <Text Text="Drawing" VerticalAlignment="Center" ID="AdaptiveDrawing_Horizontal_Stack_Drawing" />
          </Container>
        </Button>
        <Button ID="AdaptiveAI" AccessibleName="AI unavailable" Tooltip="AI is not connected to this Boards editor" Interactive="False" Height="36" Padding="10 0" CornerRadius="12">
          <Container ID="AdaptiveAIContent" Type="Horizontal Stack" CellGap="4" VerticalAlignment="Center">
            <Image ID="AdaptiveAIIcon" Source="icon:sparkles" Width="16" Height="16" />
            <Text ID="AdaptiveAILabel" Text="AI" VerticalAlignment="Center" />
          </Container>
        </Button>
      </Container>
    </Container>
  </Page>
</Cui>
