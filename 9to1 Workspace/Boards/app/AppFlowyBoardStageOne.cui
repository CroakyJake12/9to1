<Cui id="boards-appflowy-board-stage-one" product="9-1" version="1">
  <!-- STAGE ONE of the owner's pinned route (31 October 2026): "the intended boards surface is appflowy re-ui
       first, then transition that re-ui into the 9to1 boards". This document re-renders AppFlowy's DESKTOP BOARD
       screen in CUI with its structure unchanged. It is not the 9to1 Boards surface yet and claims no specification
       conformance; stage two adapts this shape, so no AppFlowy capability has to be re-added later.

       Structure and geometry read from the pinned donor (AppFlowy 0.14.11 @ 5cf3a365dec0, preserved byte-faithfully
       at https://github.com/CroakyJake12/donor-appflowy):
       · board/presentation/board_page.dart:67  BoardSettingBar in the database tab bar
       · board/presentation/toolbar/board_setting_bar.dart  SizedBox height 20, Row aligned to the END, holding
           FilterButton, then ViewDatabaseButton only when the view is a reference, then SettingButton. The card
           size / card layout / show-icon / show-cover controls are NOT in this bar: they live in the layout-setting
           panel the SettingButton opens. (My first draft put them in the bar and that was wrong; corrected here.)
       · board/presentation/widgets/board_column_header.dart  header Container height 50, content chosen by the
           group's field type: EditableColumnHeader (select fields, non-default group), CheckboxColumnHeader, or the
           default header; GroupOptionsButton popover constrained to 168 x 300, margin 8, opening bottom-left, with
           GroupOption rename / hide / delete items at height 26 (GridSize.popoverItemHeight).
       · board/presentation/widgets/board_hidden_groups.dart  HiddenGroupsColumn driven by the layout setting
           collapseHiddenGroups: collapsed = height 50 showing only the expand icon; expanded = width 274 with a
           50-high row ("Hidden groups" medium text in hint colour + collapse/expand icon) and then the group list.
       · widgets/card/card.dart  RowCard → _CardContent = Column[ CardCover (only when the row has a cover),
           Padding(styleConfiguration.cardPadding) → Column of cells where index 0 is the title cell ]; hover builds
           the card accessories (edit and more-options, each inset 3).
       · board/presentation/board_page.dart:441 BoardColumnFooter (create-card affordance at the foot of a column)
           and :788 BoardTrailing (the trailing column that starts a new group).
       · grid/presentation/layout/sizes.dart  scrollBarSize 8, popoverItemHeight 26, typeOptionSeparatorHeight 4.
       Card width/height and the hidden-groups collapsed flag are bound, not hard-coded, because in the donor they
       come from the runtime board layout setting (BoardLayoutSettingPB). No donor control name is emitted. -->
  <Actions>
    <Action name="OpenDonorGroup" command="DonorOpenGroup" parameter="{Binding group.Id}" />
    <Action name="OpenDonorCard" command="DonorOpenCard" parameter="{Binding card.Id}" />
    <Action name="CreateCardInGroup" command="DonorCreateCard" parameter="{Binding group.Id}" />
    <Action name="BeginCreateCard" command="DonorBeginCreateCard" parameter="{Binding group.Id}" />
    <Action name="CommitNewPage" command="DonorCommitCreateCard" parameter="{Binding Event}" />
    <Action name="StartRenameSection" command="DonorRenameGroupStart" parameter="{Binding group.Id}" />
    <Action name="CommitSectionTitle" command="DonorCommitGroupTitle" parameter="{Binding Event}" />
    <Action name="CreateCardAtTop" command="DonorCreateCardAtTop" parameter="{Binding group.Id}" />
    <Action name="RenameGroupStart" command="DonorRenameGroup" parameter="{Binding group.Id}" />
    <Action name="HideGroup" command="DonorHideGroup" parameter="{Binding group.Id}" />
    <Action name="DeleteGroupConfirm" command="DonorDeleteGroup" parameter="{Binding group.Id}" />
    <Action name="OpenHiddenGroup" command="DonorOpenHiddenGroup" parameter="{Binding hidden.Id}" />
    <Action name="ExpandHiddenGroups" command="DonorExpandHiddenGroups" />
    <Action name="CollapseHiddenGroups" command="DonorCollapseHiddenGroups" />
    <Action name="OpenLayoutSettings" command="DonorOpenLayoutSettings" />
    <Action name="OpenFilterEditor" command="DonorOpenFilterEditor" />
    <Action name="SwitchToDatabaseView" command="DonorSwitchToGrid" />
    <Action name="CreateGroup" command="DonorCreateGroup" />
    <Action name="OpenTab" command="DonorOpenTab" parameter="{Binding tab.Id}" />
    <Action name="ToggleSection" command="DonorToggleSection" parameter="{Binding section.Id}" />
    <Action name="OpenSidebarPage" command="DonorOpenSidebarPage" parameter="{Binding page.Id}" />
    <Action name="CreateRootPage" command="DonorCreateRootPage" />
    <Action name="CreateSectionPage" command="DonorCreateSectionPage" parameter="{Binding section.Id}" />
    <Action name="SearchPages" command="DonorSearchPages" />
    <Action name="CloseSearch" command="DonorCloseSearch" />
    <Action name="FilterPages" command="DonorFilterPages" />
    <Action name="CloseTab" command="DonorCloseTab" parameter="{Binding tab.Id}" />
    <Action name="ExitStageOne" command="DonorExitStageOneSurface" />
  </Actions>
  <Page>
    <!-- Donor: the desktop app shell around the board. lib/workspace/presentation/home/home_sizes.dart measures
         minimumSidebarWidth 268, workspaceSectionHeight 32, searchSectionHeight 30, newPageSectionHeight 30,
         tabBarHeight 40, tabBarWidth 200, HomeSpaceViewSizes.leftPadding 16 / viewHeight 30.
         home/menu/sidebar/sidebar.dart:332-420 builds the sidebar as a Column: SidebarTopMenu (32, inset 8 with
         right 6), VSpace 6, the search button (30), VSpace 6, the New Page button, VSpace 12, a divider at padding
         12, the page tree, a divider, the footer, VSpace 14. widgets/tab_bar_item.dart is a Row of the page's emoji,
         its title and a close button. 9to1 wording is applied to everything 9to1 names; the donor labels that
         already say "Search" and "+ New page" stay. -->
    <Container Type="Grid" ColumnSizes="268 1fr" CellGap="0" ID="DonorAppShell"
               Background="{Resource CuiWorkspaceMaterial}">
      <Container Type="Vertical Stack" Column="0" ID="DonorSidebar" Width="268" Padding="8 8" CellGap="0"
                 Background="{Resource CuiPanelBrush}" AccessibleName="Pages sidebar">
        <Container Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="4" Height="32" Padding="0 0 6 0"
                   ID="DonorSidebarWorkspace" VerticalAlignment="Center">
          <Text Column="0" Text="{Binding DonorWorkspaceEmoji}" FontSize="15" VerticalAlignment="Center"
                ID="DonorWorkspaceEmoji" AccessibleName="Workspace icon" />
          <Text Column="1" Text="{Binding DonorWorkspaceName}" FontSize="13" FontWeight="Bold"
                VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ID="DonorWorkspaceName"
                AccessibleName="Workspace name" />
          <!-- The donor's workspace menu and the account cluster are Haven's shared header services; this
               standalone Boards host has no space or account session, so those two controls are NOT rendered here
               rather than rendered and doing nothing. Recorded in open-decisions as the chrome seam to close. -->
          <Button Column="2" ID="DonorSidebarNewPageButton" Content="+" Action="CreateRootPage" Width="22"
                  Height="22" Padding="0" AccessibleName="New page" ToolTip="New page" />
        </Container>
        <If Condition="{Binding DonorSearchIdle}">
          <Button ID="DonorSearchButton" Content="Search" Action="SearchPages" Height="30" Padding="6 0"
                  Margin="0 6 0 0" HorizontalAlignment="Stretch" AccessibleName="Search pages" />
        </If>
        <If Condition="{Binding DonorSearchActive}">
          <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="4" Margin="0 6 0 0" Height="30"
                     ID="DonorSearchRow">
            <Input Column="0" ID="DonorSearchField" Type="Text" Value="{Binding DonorSidebarQuery, mode=TwoWay}"
                   Action="FilterPages" PlaceholderText="Search" Height="30" AccessibleName="Search pages" />
            <Button Column="1" ID="DonorCloseSearch" Content="✕" Action="CloseSearch" Width="22" Height="22"
                    Padding="0" AccessibleName="Close search" />
          </Container>
        </If>
        <Button ID="DonorNewPageButton" Content="+ New page" Action="CreateRootPage" Height="30" Padding="6 0"
                Margin="0 6 0 0" HorizontalAlignment="Stretch" AccessibleName="New page" />
        <Container Type="Overlay" ID="DonorSidebarTree" VerticalScrolling="True" HorizontalScrolling="False"
                   ScrollBarThickness="8" Margin="0 12 0 0" VerticalAlignment="Stretch">
          <Container Type="Vertical Stack" CellGap="0">
            <If Condition="!{Binding DonorHasSidebarMatches}">
              <Text Text="No pages yet" FontSize="12" Margin="16 6 0 0" ID="DonorSidebarEmpty"
                    Foreground="{Resource CuiTextSoftBrush}" AccessibleName="No pages in this board" />
            </If>
            <Repeat Source="{Binding DonorSidebarSections}" As="section" Key="{Binding section.Id}">
              <Container Type="Vertical Stack" CellGap="2">
                <Container Type="Grid" ColumnSizes="Auto Auto 1fr Auto" CellGap="4" Height="24" Padding="8 0"
                           ID="DonorSidebarSectionRow" VerticalAlignment="Center">
                  <Button Column="0" ID="DonorSectionChevron" Content="⌄" Action="ToggleSection" Width="16"
                          Height="16" Padding="0" AccessibleName="Collapse this section" />
                  <Button Column="1" ID="DonorToggleSection" Content="{Binding section.Name}" Action="ToggleSection"
                          Height="24" Padding="0" HorizontalAlignment="Stretch" AccessibleName="Section name" />
                  <Button Column="3" ID="DonorSectionNewPage" Content="+" Action="CreateSectionPage" Width="20"
                          Height="20" Padding="0" AccessibleName="New page in this section" />
                </Container>
                <If Condition="{Binding section.Expanded}">
                  <Repeat Source="{Binding section.Pages}" As="page" Key="{Binding page.Id}">
                  <!-- The row is one Button carrying the icon and the title as its content, the shape a
                       shipping surface uses for its list items (Mail/UI/MailWorkspace.cui:10-13 uses
                       <Button action= action-argument=><Text/><Text/></Button>). My first draft here invented
                       IconContent=/Command=/GridColumn=/Opacity= attributes and Space/Border elements, none of
                       which exist in this vocabulary; corrected against the registry and against shipping CUI.
                       Donor geometry kept: viewHeight 30, leftPadding 16. -->
                  <Button Column="0" ID="DonorSidebarPage" Height="30" Padding="16 0"
                          HorizontalAlignment="Stretch" Action="OpenSidebarPage" AccessibleName="Open page">
                    <Text Text="{Binding page.Emoji}" FontSize="14" />
                    <Text Text="{Binding page.Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                  </Button>
                  </Repeat>
                </If>
              </Container>
            </Repeat>
          </Container>
        </Container>
        <Container Type="Grid" ColumnSizes="1fr" CellGap="6" Height="28" Margin="0 6 0 0"
                   ID="DonorSidebarFooter" VerticalAlignment="Center">
          <Text Column="0" Text="{Binding DonorAccountName}" FontSize="11.5" ID="DonorSidebarAccount"
                VerticalAlignment="Center" AccessibleName="Account" />
        </Container>
      </Container>

      <!-- Donor: the content pane's tab row (HomeSizes.tabBarHeight 40, tabBarWidth 200). -->
      <Container Type="Grid" RowSizes="40 1fr" ColumnSizes="1fr" Column="1" CellGap="0" ID="DonorContentPane">
        <Container Type="Grid" ColumnSizes="1fr Auto" Row="0" CellGap="0" Height="40" ID="DonorViewTabBar"
                   Background="{Resource CuiPanelBrush}">
          <Container Type="Overlay" Column="0" HorizontalScrolling="True" VerticalScrolling="False"
                     ScrollBarThickness="8">
            <Container Type="Horizontal Stack" CellGap="0">
              <Repeat Source="{Binding DonorOpenTabs}" As="tab" Key="{Binding tab.Id}">
                <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="6" Width="200" Height="40" Padding="10 0"
                           ID="DonorViewTab" VerticalAlignment="Center">
                  <Button Column="0" ID="DonorOpenTab" Height="40" Padding="0" HorizontalAlignment="Stretch"
                          Action="OpenTab" AccessibleName="Open page tab">
                    <Text Text="{Binding tab.Emoji}" FontSize="14" />
                    <Text Text="{Binding tab.Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <Button Column="1" ID="DonorCloseTab" Content="✕" Action="CloseTab" Width="20" Height="20"
                          Padding="0" AccessibleName="Close tab" />
                </Container>
              </Repeat>
            </Container>
          </Container>
          <Button Column="1" ID="DonorNewTabButton" Content="+" Action="CreateRootPage" Width="34" Height="34"
                  FontSize="16" AccessibleName="New page tab" ToolTip="New page" />
        </Container>
        <Container Type="Grid" RowSizes="Auto 1fr" Row="1" CellGap="6" Background="{Resource CuiWorkspaceMaterial}">
      <!-- Donor: the database tab bar row. The settings cluster is right-aligned, 20 high. -->
      <Container Type="Grid" ColumnSizes="1fr Auto" RowSizes="Auto" Row="0" CellGap="8" ID="DonorBoardTabBar">
        <Container Type="Horizontal Stack" Column="0" CellGap="8" VerticalAlignment="Center">
          <Text ID="DonorBoardTitle" Text="{Binding DonorBoardTitle}" FontSize="18" FontWeight="Bold"
                VerticalAlignment="Center" AccessibleName="Board title" />
          <!-- Stage-one only seam: leaves this surface and returns to the 9to1 Boards presentation, so the owner
               can compare the two. It is not a donor control and is labelled as the seam that it is. -->
          <Button ID="DonorExitStageOne" Content="Leave AppFlowy re-UI" Action="ExitStageOne"
                  AccessibleName="Leave the AppFlowy re-UI surface" ToolTip="Return to the 9to1 Boards surface" />
          <Text ID="DonorStageOneNotice" Text="{Binding DonorStageOneNotice}" FontSize="12"
                Foreground="{Resource CuiMutedBrush}" VerticalAlignment="Center"
                AccessibleName="What this surface still is not" />
        </Container>
        <Container Type="Horizontal Stack" Column="1" CellGap="2" Height="20" VerticalAlignment="Center"
                   ID="DonorBoardSettingBar" AccessibleName="Board settings row">
          <Button ID="DonorFilterButton" Content="Filter" Action="OpenFilterEditor" Height="20" Padding="6 0"
                  Background="Transparent" BorderWidth="0" Interactive="{Binding DonorCanFilter}"
                  AccessibleName="Filter this board" />
          <If Condition="{Binding DonorIsViewReference}">
            <Button ID="DonorViewDatabaseButton" Content="View database" Action="SwitchToDatabaseView" Height="20"
                    Padding="6 0" Background="Transparent" BorderWidth="0" AccessibleName="Open the underlying database view" />
          </If>
          <Button ID="DonorSettingButton" Content="Settings" Action="OpenLayoutSettings" Height="20" Padding="6 0"
                  Background="Transparent" BorderWidth="0" AccessibleName="Board layout settings" />
        </Container>
      </Container>

      <!-- Donor: the board itself slides horizontally; the hidden-groups column comes first. -->
      <!-- Measured donor constraint, board_page.dart:352 - groupConstraints BoxConstraints.tightFor(width:
           compactMode ? 196 : 256). My previous version bound the widths to context values and nothing honoured
           them, so every column collapsed to its content and the whole board sat in the top-left corner of a
           2080x1400 window (owner: "very broken rn"). The donor uses tight constraints, so the geometry is
           authored as literals here and the column body is a 1fr row so it fills the height. -->
      <!-- Pattern taken from a shipping first-party surface rather than guessed: Files/NativeUI/UI/
           FilesBrowser.cui:17-18 wraps a horizontally scrolling strip in Container Type="Overlay" with
           HorizontalScrolling, and the Repeat itself carries Panel="Horizontal Stack". My Horizontal Stack
           container produced a column layout that broke twice in a row (side-by-side columns lost, card panels
           vanished - /tmp/opencode/g2.png b24fa8d2795a and g3.png f5e4c1f977d3). -->
      <!-- Canonical Repeat mode: the generated columns ARE children of this Horizontal Stack, so its CellGap is
           the donor's inter-column space (groupMargin horizontal 8 each side = 16). -->
      <Container Type="Horizontal Stack" ID="DonorBoardColumns" Row="1" CellGap="16" VerticalAlignment="Stretch"
                 HorizontalScrolling="True" VerticalScrolling="False" ScrollBarThickness="8">
        <If Condition="{Binding DonorHasHiddenGroups}">
          <!-- CUI021 measured on compile: an <Else> must be a sibling that follows a complete <If>, not a child
               of it. The donor's collapsed and expanded presentations are therefore expressed as two sibling
               branches, with the inverse flag supplied by the surface's own context. -->
          <If Condition="{Binding DonorHiddenGroupsCollapsed}">
            <!-- Donor collapsed state: a 50-high strip carrying only the expand control. -->
            <Container Type="Horizontal Stack" ID="DonorHiddenGroupsCollapsedStrip" Height="50" CellGap="4"
                       VerticalAlignment="Center">
              <Button ID="DonorHiddenGroupsExpand" Content="Hidden sections" Action="ExpandHiddenGroups" Height="26"
                      AccessibleName="Expand hidden sections" />
            </Container>
          </If>
          <If Condition="{Binding DonorHiddenGroupsExpanded}">
              <Container Type="Vertical Stack" ID="DonorHiddenGroupsColumn" Width="274" CellGap="4">
                <Container Type="Grid" ColumnSizes="1fr Auto" Height="50" VerticalAlignment="Center">
                  <Text Column="0" Text="Hidden sections" FontSize="14" FontWeight="Medium"
                        Foreground="{Resource CuiTextSoftBrush}" VerticalAlignment="Center" />
                  <Button Column="1" ID="DonorHiddenGroupsCollapse" Content="Collapse" Action="CollapseHiddenGroups"
                          Height="26" AccessibleName="Collapse hidden sections" />
                </Container>
                <Repeat Source="{Binding DonorHiddenGroups}" As="hidden" Key="{Binding hidden.Id}">
                  <Container Type="Horizontal Stack" CellGap="6" Padding="8 6" CornerRadius="6"
                             Background="{Resource CuiPanelBrush}">
                    <Button Action="OpenHiddenGroup" Content="{Binding hidden.Title}"
                            AccessibleName="Add this hidden section back to the board" />
                    <Text Text="{Binding hidden.CountLabel}" Foreground="{Resource CuiTextSoftBrush}" />
                  </Container>
                </Repeat>
              </Container>
          </If>
        </If>

        <Repeat Source="{Binding DonorGroupColumns}" As="group" Key="{Binding group.Id}" Panel="Horizontal Stack">
          <!-- group.dart builds the column as a vertical Flex with MainAxisSize.min and a LOOSE flexible body, so
               the column is only as tall as its cards and the footer follows them. An "Auto 1fr Auto" grid pinned the
               footer to the window foot instead. -->
          <Container Type="Grid" ID="DonorGroupColumn" Width="256" RowSizes="Auto Auto Auto" CellGap="4"
                     VerticalAlignment="Top">
            <!-- Donor header: height 50, content varies with the group's field type. -->
            <Container Type="Grid" Column="0" Row="0" ColumnSizes="Auto 1fr Auto Auto Auto" Height="50" Padding="16 0"
                       ID="DonorGroupHeader" CellGap="4" VerticalAlignment="Center">
              <Image Column="0" Source="icon:folder" Width="16" Height="16" VerticalAlignment="Center"
                     AccessibleName="Section" />
              <!-- Measured defect (g8-crop.png): the section icon overlapped the title glyph. Hypothesis, now
                   tested: grid placement attributes are not applied to the children of a conditional branch, so
                   both branch bodies fell back to cell 0 on top of the icon. The two branches are therefore wrapped
                   in one Container that carries Column="1". -->
              <Container Column="1" Type="Horizontal Stack" CellGap="4" ID="DonorGroupTitleCell"
                         VerticalAlignment="Center">
                <If Condition="{Binding group.Editing}">
                  <Input ID="DonorGroupTitleEdit" Type="Text" Value="{Binding group.DraftTitle}"
                         SubmitAction="CommitSectionTitle" FontSize="14" AccessibleName="Section title" />
                </If>
                <If Condition="{Binding group.NotEditing}">
                  <Text Text="{Binding group.Title}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"
                        AccessibleName="Section title" />
                </If>
              </Container>
              <Text Column="2" Text="{Binding group.CountLabel}" FontSize="12"
                    Foreground="{Resource CuiTextSoftBrush}" VerticalAlignment="Center"
                    AccessibleName="Number of pages in this section" />
              <!-- Menu items belong INSIDE the trigger, which is how the working FileMenu and board-name menu are
                   authored in Boards.cui. My first version self-closed the trigger and left the items as siblings,
                   so they rendered inline beside the header instead of opening as a popover - measured on screen in
                   /tmp/opencode/e3-crop.png. The donor's own popover is limited to 168 x 300; that limit stays
                   unexpressed here and is recorded as a fidelity gap rather than forced through an unsupported
                   attribute. -->
              <Button Column="3" ID="DonorGroupNewCardAtTop" Width="20" Height="20" Padding="0"
                      Action="CreateCardAtTop" Background="Transparent" BorderWidth="0" FontSize="16"
                      ToolTip="Add page to the top of the section" AccessibleName="Add page to the top of the section">+
              </Button>
              <Container Column="4" Type="Menu" ID="DonorGroupOptions">
                <Button Type="Menu Item" ID="DonorGroupOptionsButton" IconSource="icon:more" IconOnly="True"
                        Width="20" Height="20" Padding="0" Background="Transparent" BorderWidth="0"
                        AccessibleName="Section options">
                <Button Type="Menu Item" ID="DonorGroupRename" Content="Rename section" Action="StartRenameSection" Height="26"
                        IsEnabled="{Binding group.CanRename}" Interactive="{Binding group.CanRename}"
                        AccessibleName="Rename this section" />
                <Button Type="Menu Item" ID="DonorGroupHide" Content="Hide section" Action="HideGroup" Height="26"
                        IsEnabled="{Binding group.CanHide}" Interactive="{Binding group.CanHide}"
                        AccessibleName="Hide this section" />
                <Button Type="Menu Item" ID="DonorGroupDelete" Content="Delete section" Action="DeleteGroupConfirm"
                        Height="26" IsEnabled="{Binding group.CanDelete}" Interactive="{Binding group.CanDelete}"
                        AccessibleName="Delete this section" />
                </Button>
              </Container>
            </Container>

            <!-- Donor body: the column's cards. RowCard = cover (when present) then the cell column whose
                 first cell is the title, with the hover accessories overlay carrying edit and more-options. -->
            <!-- Donor: the column body is padded 8 on top (board_page.dart:341) and scrolls its cards. -->
            <Container Type="Vertical Stack" ID="DonorCardList" Column="0" Row="1" Margin="0 8 0 0" Padding="12 0" CellGap="8"
                       VerticalScrolling="True" HorizontalScrolling="False" ScrollBarThickness="8">
              <Repeat Source="{Binding group.Cards}" As="card" Key="{Binding card.Id}">
                <!-- Donor RowCard fills the column width; its content padding is EdgeInsets.all(4)
                     (card.dart RowCardStyleConfiguration). The previous bound Width collapsed to the title text. -->
                <!-- Card surface has to read against the board: the donor paints white cards on a grey group.
                     CuiPanelBrush measured almost identical to the workspace material in the light theme, which is
                     why the panels vanished in g3 and later frames. -->
                <Container Type="Overlay" ID="DonorCard" Width="226" MinHeight="56" Margin="3 4"
                           HorizontalAlignment="Stretch" Background="{Resource CuiFloatingSurfaceMaterial}" CornerRadius="6"
                           BorderWidth="1" BorderBrush="{Resource CuiLineBrush}">
                  <!-- Donor: the whole card is the open gesture (card.dart tap to open the row document). This is a
                       hit area over the card, deliberately without its own label, so the title is not drawn twice. -->
                  <Button ID="DonorCardOpenSurface" Action="OpenDonorCard" Width="226" MinHeight="56"
                          Background="Transparent" BorderWidth="0" Padding="0"
                          AccessibleName="{Binding card.AccessibleName}" />
                  <Container Type="Vertical Stack" CellGap="0">
                    <If Condition="{Binding card.HasCover}">
                      <Image ID="DonorCardCover" Source="{Binding card.CoverSource}" Height="{Binding card.CoverHeight}"
                             Width="248" AccessibleName="Page cover" />
                    </If>
                    <!-- Donor _CardContent: the cell column's first cell is the row title (card.dart:231-268), so the
                         9to1 page title is that cell and each non-empty block becomes a following cell. -->
                    <Container Type="Vertical Stack" Padding="4" CellGap="4">
                      <Text ID="DonorCardTitle" Text="{Binding card.Title}" FontSize="14" FontWeight="Bold"
                            Foreground="{Resource CuiTextBrush}" AccessibleName="Page title" />
                      <Repeat Source="{Binding card.Previews}" As="preview" Key="{Binding preview}">
                        <Text ID="DonorCardCell" Text="{Binding preview}" FontSize="13"
                              Foreground="{Resource CuiTextSoftBrush}" AccessibleName="Page detail" />
                      </Repeat>
                    </Container>
                  </Container>
                  <Container Type="Horizontal Stack" ID="DonorCardAccessories" CellGap="2" Padding="3"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Active="{Binding card.Hovered}">
                    <Button ID="DonorCardEdit" Width="20" Height="20" Padding="3" Background="Transparent"
                            BorderWidth="0" Action="OpenDonorCard" AccessibleName="Open this page">
                      <Image Source="icon:more" Width="14" Height="14" AccessibleName="Open this page" />
                    </Button>
                    <Button ID="DonorCardMoreOptions" Width="20" Height="20" Padding="3" Background="Transparent"
                            BorderWidth="0" AccessibleName="More page options">
                      <Image Source="icon:more" Width="14" Height="14" AccessibleName="More page options" />
                    </Button>
                  </Container>
                </Container>
              </Repeat>
            </Container>

            <!-- Donor: BoardColumnFooter. -->
            <!-- Donor footer padding is horizontal 12 (board.dart:32); the footer follows the last card rather
                 than sitting at the window foot, so the column's 1fr body row is scrollable and the footer keeps
                 its own Auto row. -->
            <Container Type="Horizontal Stack" ID="DonorGroupFooter" Column="0" Row="2" Height="36" Padding="12 0"
                       CellGap="4" VerticalAlignment="Center">
              <If Condition="{Binding group.NotCreating}">
                <Button ID="DonorGroupNewCard" Content="New page" Action="BeginCreateCard" Height="26"
                        Interactive="{Binding group.CanCreateCard}" AccessibleName="Add a page to this section" />
              </If>
              <If Condition="{Binding group.Creating}">
                <Input ID="DonorGroupNewCardField" Type="Text" Width="200" PlaceholderText="Page title"
                       Value="{Binding group.NewPageDraft}" SubmitAction="CommitNewPage"
                       AccessibleName="New page title" />
              </If>
            </Container>
          </Container>
        </Repeat>

        <!-- Donor: BoardTrailing, the trailing column that creates a new group. -->
        <!-- Donor board_page.dart:365 - the trailing column exists only when the grouping field can create a
             new group; otherwise the donor spends that space on a 40-wide spacer, which is reproduced here. -->
        <Container Type="Vertical Stack" ID="DonorBoardTrailing" Width="256" CellGap="8"
                   Active="{Binding DonorCanCreateGroup}">
          <Button ID="DonorCreateGroup" Content="New section" Action="CreateGroup" Height="26"
                  HorizontalAlignment="Left" AccessibleName="Create a new section" />
        </Container>
        <Container Type="Horizontal Stack" ID="DonorBoardTrailingSpacer" Width="40"
                   Active="{Binding DonorShowsTrailingSpacer}" />
      </Container>
    </Container>
      </Container>
    </Container>
  </Page>
</Cui>
