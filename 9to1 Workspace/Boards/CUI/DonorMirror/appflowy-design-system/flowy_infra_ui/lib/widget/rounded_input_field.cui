<Cui id="widget-rounded-input-field" product="9-1" version="1">
  <Actions>
    <Action name="(value)-{-input-text-=-value;-if-(widget.on-changed-!=-null)-{-widget.on-changed!(value);-}-set-state(()-{});-}" command="(value) {
            inputText = value;
            if (widget.onChanged != null) {
              widget.onChanged!(value);
            }
            setState(() {});
          }" />
  </Actions>
  <Page id="widget-rounded-input-field-root">
    <Container id="container" Type="Vertical Stack">
      <Input id="text-form-field" Type="Text" />
    </Container>
    <Container id="align" Type="Vertical Stack">
      <Container id="padding" Type="Vertical Stack" padding="4">
        <Text id="text" />
      </Container>
    </Container>
    <Container id="column" Type="Vertical Stack" />
  </Page>
</Cui>
