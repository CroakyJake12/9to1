  <Actions>
    <Action name="()-=&gt;-context-.read&lt;filter-editor-bloc&gt;()-.add" command="() =&gt; context
          .read&lt;FilterEditorBloc&gt;()
          .add" />
    <Action name="()-{-if-(context.read&lt;filter-editor-bloc&gt;().state.fields.is-empty)-{-fluttertoast.show-toast(-msg:-locale-keys.grid-filter-cannot-find-creatable-field.tr(),-gravity:-toast-gravity.bottom,-);-}-else-{-context.read&lt;mobile-filter-editor-cubit&gt;().start-creating-filter();-}-}" command="() {
          if (context.read&lt;FilterEditorBloc&gt;().state.fields.isEmpty) {
            Fluttertoast.showToast(
              msg: LocaleKeys.grid_filter_cannotFindCreatableField.tr(),
              gravity: ToastGravity.BOTTOM,
            );
          } else {
            context.read&lt;MobileFilterEditorCubit&gt;().startCreatingFilter();
          }
        }" />
