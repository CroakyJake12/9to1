<Cui id="view-database-sort-bottom-sheet" product="9-1" version="1">
  <Actions>
    <Action name="()-=&gt;-context-.read&lt;mobile-sort-editor-cubit&gt;()-.start-editing-sort" command="() =&gt; context
                .read&lt;MobileSortEditorCubit&gt;()
                .startEditingSort" />
    <Action name="()-=&gt;-context-.read&lt;sort-editor-bloc&gt;()-.add" command="() =&gt; context
                  .read&lt;SortEditorBloc&gt;()
                  .add" />
    <Action name="()-{-final-first-field-=-context-.read&lt;sort-editor-bloc&gt;()-.state-.creatable-fields-.first-or-null;-if-(first-field-==-null)-{-fluttertoast.show-toast(-msg:-locale-keys.grid-sort-cannot-find-creatable-field.tr(),-gravity:-toast-gravity.bottom,-);-}-else-{-context.read&lt;mobile-sort-editor-cubit&gt;().start-creating-sort();-}-}" command="() {
                  final firstField = context
                      .read&lt;SortEditorBloc&gt;()
                      .state
                      .creatableFields
                      .firstOrNull;
                  if (firstField == null) {
                    Fluttertoast.showToast(
                      msg: LocaleKeys.grid_sort_cannotFindCreatableField.tr(),
                      gravity: ToastGravity.BOTTOM,
                    );
                  } else {
                    context.read&lt;MobileSortEditorCubit&gt;().startCreatingSort();
                  }
                }" />
    <Action name="(index)-{-final-new-condition-=-index-==-0-?-sort-condition-pb.ascending-:-sort-condition-pb.descending;-change-condition(context,-new-condition);-}" command="(index) {
                  final newCondition = index == 0
                      ? SortConditionPB.Ascending
                      : SortConditionPB.Descending;
                  _changeCondition(context, newCondition);
                }" />
  </Actions>
