            <Container id="vspace" Type="Vertical Stack" />
            <Container id="vspace-2" Type="Vertical Stack" />
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="padding" Type="Vertical Stack" padding="4.0">
      <Container id="sized-box" Type="Vertical Stack" height="44.0">
        <Container id="stack" Type="Absolute">
          <Container id="align" Type="Vertical Stack" />
          <Container id="align-2" Type="Vertical Stack" />
          <Container id="align-3" Type="Vertical Stack" />
          <Container id="align-4" Type="Vertical Stack" />
        </Container>
      </Container>
    </Container>
    <Container id="bloc-builder-2" Type="Vertical Stack" />
    <Button id="flowy-icon-button" Type="Action" action="()-{-show-mobile-bottom-sheet(-context,-show-drag-handle:-true,-background-color:-aftheme-extension.of(context).background,-builder:-(-)-{-return-bloc-provider&lt;view-bloc&gt;(-create:-(-)-=&gt;-view-bloc(view:-view)..add(const-view-event.initial()),-child:-mobile-database-view-quick-actions(-view:-view,-database-controller:-database-controller,-),-);-},-);-}">
      <Image id="flowy-svg" />
      <Container id="bloc-provider" Type="Vertical Stack" />
