<Cui id="view-database-view-list" product="9-1" version="1">
  <Actions>
    <Action name="()-{-show-mobile-bottom-sheet(-context,-show-drag-handle:-true,-background-color:-aftheme-extension.of(context).background,-builder:-(-)-{-return-bloc-provider&lt;view-bloc&gt;(-create:-(-)-=&gt;-view-bloc(view:-view)..add(const-view-event.initial()),-child:-mobile-database-view-quick-actions(-view:-view,-database-controller:-database-controller,-),-);-},-);-}" command="() {
        showMobileBottomSheet(
          context,
          showDragHandle: true,
          backgroundColor: AFThemeExtension.of(context).background,
          builder: (_) {
            return BlocProvider&lt;ViewBloc&gt;(
              create: (_) =&gt;
                  ViewBloc(view: view)..add(const ViewEvent.initial()),
              child: MobileDatabaseViewQuickActions(
                view: view,
                databaseController: databaseController,
              ),
            );
          },
        );
      }" />
  </Actions>
  <Page id="view-database-view-list-root">
    <Container id="bloc-builder" Type="Vertical Stack">
      <Container id="column" Type="Vertical Stack">
        <Container id="expanded" Type="Vertical Stack">
