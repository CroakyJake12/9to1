<Cui id="section-folder-mobile-home-section-folder-header" product="9-1" version="1">
  <Actions>
    <Action name="()-{-set-state(()-{-turns-=-widget.is-expanded-?-0.25-:-0;-});-widget.on-pressed();-}" command="() {
              setState(() {
                _turns = widget.isExpanded ? -0.25 : 0;
              });
              widget.onPressed();
            }" />
    <Action name="widget.on-added" command="widget.onAdded" />
  </Actions>
  <Page id="section-folder-mobile-home-section-folder-header-root">
    <Container id="row" Type="Horizontal Stack">
      <Container id="hspace" Type="Horizontal Stack" />
