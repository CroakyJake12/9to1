<Cui id="recent-folder-mobile-home-recent-views" product="9-1" version="1">
  <Actions>
    <Action name="()-{-show-mobile-bottom-sheet(-context,-show-divider:-false,-show-drag-handle:-true,-background-color:-aftheme-extension.of(context).background,-builder:-(-)-{-return-column(-children:-[-flowy-option-tile.text(-text:-locale-keys.button-clear.tr(),-left-icon:-flowy-svg(-flowy-svgs.m-delete-s,-color:-theme.of(context).color-scheme.error,-),-text-color:-theme.of(context).color-scheme.error,-on-tap:-()-{-context.read&lt;recent-views-bloc&gt;().add(-recent-views-event.remove-recent-views(-recent-views.map((e)-=&gt;-e.id).to-list(),-),-);-context.pop();-},-),-],-);-},-);-}" command="() {
              showMobileBottomSheet(
                context,
                showDivider: false,
                showDragHandle: true,
                backgroundColor: AFThemeExtension.of(context).background,
                builder: (_) {
                  return Column(
                    children: [
                      FlowyOptionTile.text(
                        text: LocaleKeys.button_clear.tr(),
                        leftIcon: FlowySvg(
                          FlowySvgs.m_delete_s,
                          color: Theme.of(context).colorScheme.error,
                        ),
                        textColor: Theme.of(context).colorScheme.error,
                        onTap: () {
                          context.read&lt;RecentViewsBloc&gt;().add(
                                RecentViewsEvent.removeRecentViews(
                                  recentViews.map((e) =&gt; e.id).toList(),
                                ),
                              );
                          context.pop();
                        },
                      ),
                    ],
                  );
                },
              );
            }" />
  </Actions>
  <Page id="recent-folder-mobile-home-recent-views-root">
    <Container id="bloc-provider" Type="Vertical Stack">
      <Container id="bloc-builder" Type="Vertical Stack">
        <Container id="shrink" Type="Vertical Stack" />
        <Container id="column" Type="Vertical Stack">
          <Container id="vspace" Type="Vertical Stack" />
        </Container>
      </Container>
    </Container>
    <Container id="column-2" Type="Vertical Stack">
      <Container id="padding" Type="Vertical Stack" padding="24">
        <Container id="gesture-detector" Type="Vertical Stack">
          <Container id="column-3" Type="Vertical Stack">
            <Image id="flowy-svg" />
          </Container>
        </Container>
      </Container>
      <Container id="sized-box" Type="Vertical Stack" height="148">
        <Container id="hspace" Type="Horizontal Stack" />
      </Container>
    </Container>
  </Page>
</Cui>
