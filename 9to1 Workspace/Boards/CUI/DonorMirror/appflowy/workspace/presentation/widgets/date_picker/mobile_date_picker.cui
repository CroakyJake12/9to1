<Cui id="date-picker-mobile-date-picker" product="9-1" version="1">
  <Actions>
    <Action name="()-async-{-final-result-=-await-show-date-time-picker(-context,-is-start-day-?-date-time-:-end-date-time,-use24h-format:-time-format-==-time-format-pb.twenty-four-hour,-mode:-cupertino-date-picker-mode.date,-);-handle-date-time-picker-result(result,-is-start-day,-true);-}" command="() async {
              final result = await _showDateTimePicker(
                context,
                isStartDay ? dateTime : endDateTime,
                use24hFormat: timeFormat == TimeFormatPB.TwentyFourHour,
                mode: CupertinoDatePickerMode.date,
              );
              handleDateTimePickerResult(result, isStartDay, true);
            }" />
    <Action name="()-async-{-final-result-=-await-show-date-time-picker(-context,-is-start-day-?-date-time-:-end-date-time,-use24h-format:-time-format-==-time-format-pb.twenty-four-hour,-mode:-cupertino-date-picker-mode.time,-);-handle-date-time-picker-result(result,-is-start-day,-false);-}" command="() async {
              final result = await _showDateTimePicker(
                context,
                isStartDay ? dateTime : endDateTime,
                use24hFormat: timeFormat == TimeFormatPB.TwentyFourHour,
                mode: CupertinoDatePickerMode.time,
              );
              handleDateTimePickerResult(result, isStartDay, false);
            }" />
  </Actions>
