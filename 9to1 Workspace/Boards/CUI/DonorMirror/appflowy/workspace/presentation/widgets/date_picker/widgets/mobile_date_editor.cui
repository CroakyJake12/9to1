<Cui id="widgets-mobile-date-editor" product="9-1" version="1">
  <Actions>
    <Action name="()-{-page-controller?.next-page(-duration:-const-duration(milliseconds:-300),-curve:-curves.ease-out,-);-}" command="() {
              pageController?.nextPage(
                duration: const Duration(milliseconds: 300),
                curve: Curves.easeOut,
              );
            }" />
    <Action name="()-{-page-controller?.previous-page(-duration:-const-duration(milliseconds:-300),-curve:-curves.ease-out,-);-}" command="() {
              pageController?.previousPage(
                duration: const Duration(milliseconds: 300),
                curve: Curves.easeOut,
              );
            }" />
  </Actions>
  <Page id="widgets-mobile-date-editor-root">
    <Container id="column" Type="Vertical Stack">
      <Container id="vspace" Type="Vertical Stack" />
      <Container id="vspace-2" Type="Vertical Stack" />
      <Container id="vspace-3" Type="Vertical Stack" />
    </Container>
    <Container id="padding" Type="Vertical Stack" padding="16 8">
      <Container id="row" Type="Horizontal Stack">
        <Container id="expanded" Type="Vertical Stack">
          <Text id="flowy-text" />
        </Container>
        <Button id="flowy-button" Type="Action" action="()-{-page-controller?.previous-page(-duration:-const-duration(milliseconds:-300),-curve:-curves.ease-out,-);-}">
          <Image id="flowy-svg" />
        </Button>
        <Container id="hspace" Type="Horizontal Stack" />
        <Button id="flowy-button-2" Type="Action" action="()-{-page-controller?.next-page(-duration:-const-duration(milliseconds:-300),-curve:-curves.ease-out,-);-}">
          <Image id="flowy-svg-2" />
        </Button>
      </Container>
    </Container>
  </Page>
</Cui>
