<Cui id="about-app-version" product="9-1" version="1">
  <Actions>
    <Action name="()-{-af-launch-url-string('https://www.appflowy.io/what-is-new');-}" command="() {
              afLaunchUrlString('https://www.appflowy.io/what-is-new');
            }" />
  </Actions>
  <Page id="about-app-version-root">
    <Container id="column" Type="Vertical Stack">
      <Text id="text" />
      <Container id="vspace" Type="Vertical Stack" />
      <Text id="text-2" />
    </Container>
    <Container id="row" Type="Horizontal Stack">
      <Container id="expanded" Type="Vertical Stack" />
    </Container>
    <Container id="column-2" Type="Vertical Stack">
      <Container id="row-2" Type="Horizontal Stack">
        <Container id="hspace" Type="Horizontal Stack" />
        <Container id="flexible" Type="Vertical Stack" />
      </Container>
      <Container id="vspace-2" Type="Vertical Stack" />
    </Container>
    <Container id="row-3" Type="Horizontal Stack">
      <Container id="flexible-2" Type="Vertical Stack" />
      <Container id="hspace-2" Type="Horizontal Stack" />
      <Container id="mouse-region" Type="Vertical Stack">
        <Container id="gesture-detector" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="container" Type="Vertical Stack" width="8" height="8" background="#FFFB006D" />
  </Page>
</Cui>
