<Cui id="pages-settings-workspace-view" product="9-1" version="1">
  <Actions>
    <Action name="()-=&gt;-context-.read&lt;appearance-settings-cubit&gt;()-.set-font-family" command="() =&gt; context
                  .read&lt;AppearanceSettingsCubit&gt;()
                  .setFontFamily" />
    <Action name="()-=&gt;-context.read&lt;appearance-settings-cubit&gt;" command="() =&gt;
                  context.read&lt;AppearanceSettingsCubit&gt;" />
    <Action name="()-{-context.read&lt;dynamic-plugin-bloc&gt;().add(-dynamic-plugin-event.remove-plugin(-name:-t.theme-name,-),-);-if-(appearance.app-theme.theme-name-==-t.theme-name)-{-context-.read&lt;appearance-settings-cubit&gt;()-.set-theme(app-theme.builtins.first.theme-name);-}-}" command="() {
                        context.read&lt;DynamicPluginBloc&gt;().add(
                              DynamicPluginEvent.removePlugin(
                                name: t.themeName,
                              ),
                            );

                        if (appearance.appTheme.themeName == t.themeName) {
                          context
                              .read&lt;AppearanceSettingsCubit&gt;()
                              .setTheme(AppTheme.builtins.first.themeName);
                        }
                      }" />
    <Action name="(value)-{-set-state(()-=&gt;-width-=-value);-widget.on-padding-changed(value);-}" command="(value) {
              setState(() =&gt; width = value);

              widget.onPaddingChanged(value);
            }" />
  </Actions>
  <Page id="pages-settings-workspace-view-root">
    <Container id="bloc-provider" Type="Vertical Stack">
      <Container id="vspace" Type="Vertical Stack" />
      <Container id="vspace-2" Type="Vertical Stack" />
    </Container>
    <Container id="padding" Type="Vertical Stack" padding="2.5" />
    <Container id="flexible" Type="Vertical Stack" />
    <Container id="bloc-builder" Type="Vertical Stack" />
    <Container id="sized-box" Type="Vertical Stack" width="64" height="64">
      <Input id="circular-progress-indicator" Type="Progress" />
    </Container>
    <Container id="bloc-builder-2" Type="Vertical Stack">
      <Image id="flowy-svg" />
      <Image id="flowy-svg-2" />
      <Image id="flowy-svg-3" />
    </Container>
    <Container id="row" Type="Horizontal Stack">
      <Container id="expanded" Type="Vertical Stack" />
      <Container id="hspace" Type="Horizontal Stack" />
    </Container>
    <Container id="bloc-builder-3" Type="Vertical Stack">
      <Image id="flowy-svg-4" />
      <Image id="flowy-svg-5" />
    </Container>
    <Container id="bloc-builder-4" Type="Vertical Stack">
      <Container id="padding-2" Type="Vertical Stack" padding="8.0">
        <Container id="column" Type="Vertical Stack">
          <Container id="vspace-3" Type="Vertical Stack" />
        </Container>
      </Container>
    </Container>
    <Container id="bloc-builder-5" Type="Vertical Stack" />
    <Container id="row-2" Type="Horizontal Stack">
      <Container id="expanded-2" Type="Vertical Stack" />
