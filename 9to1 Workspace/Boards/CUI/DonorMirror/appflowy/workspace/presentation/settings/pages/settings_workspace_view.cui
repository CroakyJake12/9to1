          </Input>
        </Container>
        <Container id="hspace-3" Type="Horizontal Stack" />
        <Container id="gesture-detector-2" Type="Vertical Stack">
          <Container id="sized-box-2" Type="Vertical Stack" height="26">
            <Container id="padding-4" Type="Vertical Stack" padding="4 2">
              <Container id="row-5" Type="Horizontal Stack">
                <Image id="flowy-svg-10" />
                <Container id="hspace-4" Type="Horizontal Stack" />
              </Container>
            </Container>
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="column-3" Type="Vertical Stack">
      <Container id="padding-5" Type="Vertical Stack" padding="12 4" />
      <Container id="flexible-2" Type="Vertical Stack">
        <Container id="vspace-5" Type="Vertical Stack" />
        <Container id="sized-box-3" Type="Vertical Stack" height="29">
          <Container id="align" Type="Vertical Stack">
            <Text id="text" />
