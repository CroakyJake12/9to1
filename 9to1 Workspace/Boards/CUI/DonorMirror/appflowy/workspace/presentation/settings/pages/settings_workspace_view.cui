    </Container>
    <Container id="bloc-provider-2" Type="Vertical Stack">
      <Container id="bloc-builder-6" Type="Vertical Stack">
        <Image id="flowy-svg-6" />
        <Image id="flowy-svg-7" />
        <Button id="flowy-icon-button" Type="Action" action="()-{-context.read&lt;dynamic-plugin-bloc&gt;().add(-dynamic-plugin-event.remove-plugin(-name:-t.theme-name,-),-);-if-(appearance.app-theme.theme-name-==-t.theme-name)-{-context-.read&lt;appearance-settings-cubit&gt;()-.set-theme(app-theme.builtins.first.theme-name);-}-}">
          <Image id="flowy-svg-8" />
        </Button>
      </Container>
    </Container>
    <Container id="container" Type="Vertical Stack" width="16" height="16" />
    <Container id="row-3" Type="Horizontal Stack">
      <Container id="padding-3" Type="Vertical Stack" padding="16">
        <Container id="gesture-detector" Type="Vertical Stack">
          <Container id="column-2" Type="Vertical Stack">
            <Container id="container-2" Type="Vertical Stack" width="88" height="72" />
            <Container id="vspace-4" Type="Vertical Stack" />
          </Container>
