      </Button>
    </Container>
    <Text id="flowy-text-2" max-lines="3" />
    <Container id="sized-box" Type="Vertical Stack" height="36">
      <Input id="flowy-text-field" Type="Text" />
    </Container>
    <Container id="row-2" Type="Horizontal Stack">
      <Container id="hspace-3" Type="Horizontal Stack" />
    </Container>
    <Container id="shrink" Type="Vertical Stack" />
    <Container id="padding" Type="Vertical Stack" padding="4.0 2.0">
      <Text id="flowy-text-3" />
    </Container>
    <Container id="value-listenable-builder" Type="Vertical Stack">
      <Container id="padding-2" Type="Vertical Stack" padding="4.0 2.0">
        <Text id="flowy-text-4" />
      </Container>
    </Container>
  </Page>
</Cui>
