<Cui id="domain-domain-settings-dialog" product="9-1" version="1">
  <Actions>
    <Action name="navigator.of" command="Navigator.of" />
  </Actions>
  <Page id="domain-domain-settings-dialog-root">
    <Container id="container" Type="Vertical Stack" padding="20">
      <Container id="column" Type="Vertical Stack">
        <Container id="vspace" Type="Vertical Stack" />
        <Container id="vspace-2" Type="Vertical Stack" />
        <Container id="vspace-3" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="row" Type="Horizontal Stack">
      <Text id="flowy-text" />
      <Container id="hspace" Type="Horizontal Stack" />
      <Container id="flowy-tooltip" Type="Floating">
        <Image id="flowy-svg" />
      </Container>
      <Container id="hspace-2" Type="Horizontal Stack" />
      <Button id="flowy-button" Type="Action" action="navigator.of" padding="3">
