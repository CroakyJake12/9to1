<Cui id="widgets-web-url-hint-widget" product="9-1" version="1">
  <Actions>
    <Action name="()-{-af-launch-url-string(-'https://appflowy.com/docs/self-host-appflowy-run-appflowy-web',-);-}" command="() {
            afLaunchUrlString(
              'https://appflowy.com/docs/self-host-appflowy-run-appflowy-web',
            );
          }" />
  </Actions>
  <Page id="widgets-web-url-hint-widget-root">
    <Container id="padding" Type="Vertical Stack" padding="2">
      <Container id="flowy-tooltip" Type="Floating">
        <Button id="flowy-icon-button" Type="Action" action="()-{-af-launch-url-string(-'https://appflowy.com/docs/self-host-appflowy-run-appflowy-web',-);-}" width="24" height="24">
          <Image id="flowy-svg" />
        </Button>
      </Container>
    </Container>
  </Page>
</Cui>
