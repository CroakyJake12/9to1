<Cui id="pages-settings-shortcuts-view" product="9-1" version="1">
  <Actions>
    <Action name="()-{-if-(widget.can-start-editing())-{-set-state(()-{-widget.on-start-editing();-is-editing-=-true;-});-}-}" command="() {
