<Cui id="sidebar-sidebar" product="9-1" version="1">
  <Actions>
    <Action name="()-{-editor-notification.exit-editing().post();-final-workspace-bloc-=-context.read&lt;user-workspace-bloc?&gt;();-final-space-bloc-=-context.read&lt;space-bloc?&gt;();-command-palette.of(context).toggle(-workspace-bloc:-workspace-bloc,-space-bloc:-space-bloc,-);-}" command="() {
          
          EditorNotification.exitEditing().post();
          final workspaceBloc = context.read&lt;UserWorkspaceBloc?&gt;();
          final spaceBloc = context.read&lt;SpaceBloc?&gt;();
          CommandPalette.of(context).toggle(
            workspaceBloc: workspaceBloc,
            spaceBloc: spaceBloc,
          );
        }" />
