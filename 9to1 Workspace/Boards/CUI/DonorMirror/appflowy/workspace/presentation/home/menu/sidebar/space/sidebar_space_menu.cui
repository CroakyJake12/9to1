<Cui id="space-sidebar-space-menu" product="9-1" version="1">
  <Actions>
    <Action name="()-{-context.read&lt;space-bloc&gt;().add(space-event.open(space:-space));-popover-container.of(context).close();-}" command="() {
        context.read&lt;SpaceBloc&gt;().add(SpaceEvent.open(space: space));
        PopoverContainer.of(context).close();
      }" />
    <Action name="()-{-popover-container.of(context).close();-show-create-space-dialog(context);-}" command="() {
        PopoverContainer.of(context).close();
        _showCreateSpaceDialog(context);
      }" />
  </Actions>
  <Page id="space-sidebar-space-menu-root">
    <Container id="bloc-builder" Type="Vertical Stack">
      <Container id="column" Type="Vertical Stack">
        <Container id="vspace" Type="Vertical Stack" />
        <Container id="sized-box" Type="Vertical Stack" />
        <Container id="padding" Type="Vertical Stack" padding="8.0" />
        <Container id="sized-box-2" Type="Vertical Stack" />
      </Container>
    </Container>
    <Button id="flowy-button" Type="Action" action="()-{-context.read&lt;space-bloc&gt;().add(space-event.open(space:-space));-popover-container.of(context).close();-}">
      <Container id="row" Type="Horizontal Stack">
        <Container id="flexible" Type="Vertical Stack" />
        <Container id="hspace" Type="Horizontal Stack" />
        <Container id="flowy-tooltip" Type="Floating">
          <Image id="flowy-svg" />
        </Container>
      </Container>
      <Image id="flowy-svg-2" />
    </Button>
    <Button id="flowy-button-2" Type="Action" action="()-{-popover-container.of(context).close();-show-create-space-dialog(context);-}">
      <Image id="flowy-svg-3" />
    </Button>
    <Container id="dialog" Type="Floating" />
  </Page>
</Cui>
