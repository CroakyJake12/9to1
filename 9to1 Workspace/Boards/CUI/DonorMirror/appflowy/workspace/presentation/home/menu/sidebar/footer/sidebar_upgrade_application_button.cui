<Cui id="footer-sidebar-upgrade-application-button" product="9-1" version="1">
  <Actions>
    <Action name="on-close-button-tap" command="onCloseButtonTap" />
    <Action name="on-update-button-tap" command="onUpdateButtonTap" />
  </Actions>
  <Page id="footer-sidebar-upgrade-application-button-root">
    <Container id="container" Type="Vertical Stack" padding="12" CornerRadius="16">
      <Container id="column" Type="Vertical Stack">
        <Container id="vspace" Type="Vertical Stack" />
        <Container id="vspace-2" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="row" Type="Horizontal Stack">
      <Image id="flowy-svg" />
