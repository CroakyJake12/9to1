<Cui id="workspace-sidebar-workspace-actions" product="9-1" version="1">
  <Actions>
    <Action name="()-{-if-(!is-popover-open)-{-controller.show();-is-popover-open-=-true;-}-}" command="() {
              if (!isPopoverOpen) {
                controller.show();
                isPopoverOpen = true;
              }
            }" />
  </Actions>
  <Page id="workspace-sidebar-workspace-actions-root">
    <Container id="shrink" Type="Vertical Stack" />
    <Button id="flowy-button" Type="Action" action="()-{-if-(!is-popover-open)-{-controller.show();-is-popover-open-=-true;-}-}" padding="4.0">
      <Image id="flowy-svg" />
    </Button>
    <Container id="divider" Type="Separator" />
    <Image id="flowy-svg-2" />
    <Image id="flowy-svg-3" />
    <Image id="flowy-svg-4" />
    <Container id="shrink-2" Type="Vertical Stack" />
  </Page>
</Cui>
