<Cui id="workspace-sidebar-workspace" product="9-1" version="1">
  <Actions>
    <Action name="()-{-context.read&lt;user-workspace-bloc&gt;().add(-user-workspace-event.fetch-workspaces(),-);-popover-controller.show();-}" command="() {
          context.read&lt;UserWorkspaceBloc&gt;().add(
                UserWorkspaceEvent.fetchWorkspaces(),
              );
          popoverController.show();
        }" />
  </Actions>
  <Page id="workspace-sidebar-workspace-root">
    <Container id="shrink" Type="Vertical Stack" />
    <Container id="mouse-region" Type="Vertical Stack">
      <Container id="value-listenable-builder" Type="Vertical Stack">
        <Container id="container" Type="Vertical Stack" padding="8.0" CornerRadius="8.0" background="#00000000">
          <Container id="row" Type="Horizontal Stack">
            <Container id="expanded" Type="Vertical Stack" />
            <Container id="hspace" Type="Horizontal Stack" />
            <Container id="hspace-2" Type="Horizontal Stack" />
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="app-flowy-popover" Type="Context Menu">
      <Container id="bloc-builder" Type="Vertical Stack">
        <Container id="shrink-2" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="mouse-region-2" Type="Vertical Stack">
      <Container id="gesture-detector" Type="Vertical Stack">
        <Container id="sized-box" Type="Vertical Stack" height="30">
          <Container id="row-2" Type="Horizontal Stack">
            <Container id="hspace-3" Type="Horizontal Stack" />
            <Container id="hspace-4" Type="Horizontal Stack" />
            <Container id="flexible" Type="Vertical Stack" />
            <Container id="hspace-5" Type="Horizontal Stack" />
            <Image id="flowy-svg" />
          </Container>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
