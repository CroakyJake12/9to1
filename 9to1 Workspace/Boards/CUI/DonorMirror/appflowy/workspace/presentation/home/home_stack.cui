<Cui id="home-home-stack" product="9-1" version="1">
  <Actions>
    <Action name="()-=&gt;-widget.page-manager-.show-secondary-plugin-notifier.value-=-true" command="() =&gt; widget.pageManager
                              .showSecondaryPluginNotifier.value = true" />
    <Action name="()-{-get-it&lt;tabs-bloc&gt;().add(const-tabs-event.close-secondary-plugin());-}" command="() {
                getIt&lt;TabsBloc&gt;().add(const TabsEvent.closeSecondaryPlugin());
              }" />
    <Action name="()-{-get-it&lt;tabs-bloc&gt;().add(const-tabs-event.expand-secondary-plugin());-}" command="() {
                getIt&lt;TabsBloc&gt;().add(const TabsEvent.expandSecondaryPlugin());
              }" />
    <Action name="(-)-{-show-hover-timer-=-timer(const-duration(milliseconds:-500),-()-{-set-state(()-=&gt;-is-hover-=-true);-});-}" command="(_) {
                showHoverTimer = Timer(const Duration(milliseconds: 500), () {
                  setState(() =&gt; isHover = true);
                });
              }" />
    <Action name="(-)-{-show-hover-timer?.cancel();-set-state(()-=&gt;-is-hover-=-false);-}" command="(_) {
                showHoverTimer?.cancel();
                setState(() =&gt; isHover = false);
              }" />
  </Actions>
