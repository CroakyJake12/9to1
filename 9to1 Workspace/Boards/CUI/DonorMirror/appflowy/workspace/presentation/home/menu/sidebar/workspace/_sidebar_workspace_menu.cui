    <Container id="sized-box-2" Type="Vertical Stack" height="40">
      <Button id="flowy-button-2" Type="Action" action="()-{-show-create-workspace-dialog(context);-popover-container.of(context).close-all();-}" padding="4.0">
        <Container id="row-4" Type="Horizontal Stack">
