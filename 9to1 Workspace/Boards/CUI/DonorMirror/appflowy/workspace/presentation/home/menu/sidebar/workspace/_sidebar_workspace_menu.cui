<Cui id="workspace-sidebar-workspace-menu" product="9-1" version="1">
  <Actions>
    <Action name="()-async-{-await-get-it&lt;auth-service&gt;().sign-out();-await-run-app-flowy();-}" command="() async {
          await getIt&lt;AuthService&gt;().signOut();
          await runAppFlowy();
        }" />
    <Action name="()-{-af-launch-url-string(-'https://docs.appflowy.io/docs/guides/import-from-notion',-);-}" command="() {
              afLaunchUrlString(
                'https://docs.appflowy.io/docs/guides/import-from-notion',
              );
            }" />
    <Action name="()-{-show-create-workspace-dialog(context);-popover-container.of(context).close-all();-}" command="() {
          _showCreateWorkspaceDialog(context);
          PopoverContainer.of(context).closeAll();
        }" />
    <Action name="()-{-show-import-notino-dialog(context);-}" command="() {
          _showImportNotinoDialog(context);
        }" />
    <Action name="open-workspace" command="_openWorkspace" />
  </Actions>
  <Page id="workspace-sidebar-workspace-menu-root">
    <Container id="column" Type="Vertical Stack">
      <Container id="padding" Type="Vertical Stack" padding="10.0 6.0 10.0">
