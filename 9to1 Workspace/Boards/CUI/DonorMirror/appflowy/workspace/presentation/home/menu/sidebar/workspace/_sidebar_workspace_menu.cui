    <Button id="flowy-button" Type="Action" action="open-workspace">
      <Container id="hspace-5" Type="Horizontal Stack" />
      <Container id="row-3" Type="Horizontal Stack">
        <Container id="flexible-2" Type="Vertical Stack">
