<Cui id="space-space-icon-popup" product="9-1" version="1">
  <Actions>
    <Action name="()-{-set-state(()-=&gt;-selected-color-=-color);-widget.on-color-selected(color);-}" command="() {
            setState(() =&gt; selectedColor = color);

            widget.onColorSelected(color);
          }" />
    <Action name="()-{-set-state(()-=&gt;-selected-icon-=-icon);-widget.on-icon-selected(icon);-}" command="() {
            setState(() =&gt; selectedIcon = icon);

            widget.onIconSelected(icon);
          }" />
    <Action name="set-state" command="setState" />
  </Actions>
  <Page id="space-space-icon-popup-root">
    <Container id="app-flowy-popover" Type="Context Menu" padding="0" />
    <Container id="mouse-region" Type="Vertical Stack">
      <Container id="value-listenable-builder" Type="Vertical Stack">
        <Container id="value-listenable-builder-2" Type="Vertical Stack">
          <Container id="container" Type="Vertical Stack">
            <Container id="align" Type="Vertical Stack">
              <Image id="flowy-svg" />
            </Container>
          </Container>
          <Container id="shrink" Type="Vertical Stack" />
          <Container id="container-2" Type="Vertical Stack">
            <Container id="align-2" Type="Vertical Stack" />
          </Container>
          <Container id="stack" Type="Absolute">
            <Container id="center" Type="Vertical Stack">
              <Image id="flowy-svg-2" />
            </Container>
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="column" Type="Vertical Stack">
      <Container id="vspace" Type="Vertical Stack" />
      <Container id="vspace-2" Type="Vertical Stack" />
      <Container id="vspace-3" Type="Vertical Stack" />
      <Container id="value-listenable-builder-3" Type="Vertical Stack" />
    </Container>
    <Container id="gesture-detector" Type="Vertical Stack">
      <Container id="container-3" Type="Vertical Stack" padding="2.0" CornerRadius="20" background="#FF00BCF0">
        <Container id="decorated-box" Type="Vertical Stack" CornerRadius="20.0" />
      </Container>
    </Container>
    <Container id="gesture-detector-2" Type="Vertical Stack">
      <Image id="flowy-svg-3" />
    </Container>
  </Page>
</Cui>
