  <Page id="emoji-emoji-handler-root">
    <Container id="container" Type="Vertical Stack" padding="16" CornerRadius="6.0" background="#FF000000" />
    <Container id="sized-box" Type="Vertical Stack" width="400" height="40">
      <Container id="center" Type="Vertical Stack">
        <Input id="circular-progress-indicator" Type="Progress" />
