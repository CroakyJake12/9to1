<Cui id="presentation-database-document-title" product="9-1" version="1">
  <Actions>
    <Action name="(text)-{-widget.on-update-name(text);-popover-container.of(context).close();-}" command="(text) {
              widget.onUpdateName(text);
              PopoverContainer.of(context).close();
            }" />
  </Actions>
  <Page id="presentation-database-document-title-root">
    <Container id="bloc-provider" Type="Vertical Stack">
      <Container id="bloc-builder" Type="Vertical Stack">
        <Container id="shrink" Type="Vertical Stack" />
        <Container id="single-child-scroll-view" Type="Vertical Stack">
          <Container id="sized-box" Type="Vertical Stack" height="24">
            <Container id="row" Type="Horizontal Stack" />
          </Container>
        </Container>
      </Container>
    </Container>
    <Image id="flowy-svg" />
    <Image id="flowy-svg-2" />
    <Image id="flowy-svg-3" />
    <Image id="flowy-svg-4" />
    <Container id="flowy-tooltip" Type="Floating" />
    <Container id="bloc-builder-2" Type="Vertical Stack">
      <Container id="shrink-2" Type="Vertical Stack" />
    </Container>
    <Container id="bloc-builder-3" Type="Vertical Stack">
      <Container id="flowy-tooltip-2" Type="Floating">
        <Container id="app-flowy-popover" Type="Context Menu">
          <Button id="flowy-button" Type="Action" padding="6">
            <Container id="row-2" Type="Horizontal Stack">
              <Container id="hspace" Type="Horizontal Stack" />
            </Container>
          </Button>
        </Container>
      </Container>
    </Container>
    <Container id="row-3" Type="Horizontal Stack">
      <Image id="flowy-svg-5" />
      <Container id="hspace-2" Type="Horizontal Stack" />
      <Container id="sized-box-2" Type="Vertical Stack" width="220" height="36.0">
        <Input id="flowy-text-field" Type="Text" />
      </Container>
    </Container>
  </Page>
</Cui>
