    <Button id="flowy-button" Type="Action" action="()-=&gt;-widget.on-icon-or-cover-changed(-cover:-universal-platform.is-desktop-or-web-?-(cover-type.asset,-'1')-:-(cover-type.color,-'0xffe8e0ff'),-)">
