<Cui id="header-custom-cover-picker" product="9-1" version="1">
  <Actions>
    <Action name="()-{-ctx-.read&lt;cover-image-picker-bloc&gt;()-.add(const-cover-image-picker-event.delete-image());-}" command="() {
          ctx
              .read&lt;CoverImagePickerBloc&gt;()
              .add(const CoverImagePickerEvent.deleteImage());
        }" />
    <Action name="()-{-ctx-.read&lt;cover-image-picker-bloc&gt;()-.add(const-cover-image-picker-event.pick-file-image());-}" command="() {
              ctx
                  .read&lt;CoverImagePickerBloc&gt;()
                  .add(const CoverImagePickerEvent.pickFileImage());
            }" />
  </Actions>
  <Page id="header-custom-cover-picker-root">
    <Container id="bloc-provider" Type="Vertical Stack">
      <Container id="bloc-builder" Type="Vertical Stack">
        <Container id="column" Type="Vertical Stack">
          <Container id="sized-box" Type="Vertical Stack" height="180">
            <Container id="center" Type="Vertical Stack">
              <Input id="circular-progress-indicator" Type="Progress" />
            </Container>
          </Container>
          <Container id="vspace" Type="Vertical Stack" />
          <Container id="vspace-2" Type="Vertical Stack" />
        </Container>
      </Container>
    </Container>
    <Container id="row" Type="Horizontal Stack">
      <Container id="expanded" Type="Vertical Stack">
        <Input id="flowy-text-field" Type="Text" />
      </Container>
      <Container id="sized-box-2" Type="Vertical Stack" width="5" />
      <Container id="expanded-2" Type="Vertical Stack" />
    </Container>
    <Container id="row-2" Type="Horizontal Stack" />
    <Container id="decorated-box" Type="Vertical Stack">
      <Container id="column-2" Type="Vertical Stack">
        <Container id="row-3" Type="Horizontal Stack">
          <Image id="flowy-svg" />
          <Container id="sized-box-3" Type="Vertical Stack" width="3" />
          <Text id="flowy-text" />
        </Container>
        <Container id="vspace-3" Type="Vertical Stack" />
        <Text id="flowy-text-2" />
        <Container id="vspace-4" Type="Vertical Stack" />
        <Button id="flowy-button" Type="Action" action="()-{-ctx-.read&lt;cover-image-picker-bloc&gt;()-.add(const-cover-image-picker-event.pick-file-image());-}">
          <Image id="flowy-svg-2" />
          <Text id="flowy-text-3" />
        </Button>
      </Container>
    </Container>
    <Container id="positioned" Type="Vertical Stack">
      <Container id="ink-well" Type="Vertical Stack">
        <Container id="decorated-box-2" Type="Vertical Stack">
          <Image id="flowy-svg-3" />
        </Container>
      </Container>
    </Container>
    <Container id="stack" Type="Absolute">
      <Container id="container" Type="Vertical Stack" height="180" />
      <Container id="shrink" Type="Vertical Stack" />
      <Container id="shrink-2" Type="Vertical Stack" />
    </Container>
  </Page>
</Cui>
