<Cui id="link-link-hover-menu" product="9-1" version="1">
  <Actions>
    <Action name="()-async-{-await-show-edit-link-bottom-sheet(context,-selection,-editor-state);-}" command="() async {
          await showEditLinkBottomSheet(context, selection, editorState);
        }" />
    <Action name="(v)-{-is-hover-trigger-hovering-=-false;-try-to-dismiss-link-hover-menu();-}" command="(v) {
        isHoverTriggerHovering = false;
        tryToDismissLinkHoverMenu();
      }" />
    <Action name="(v)-{-is-hover-trigger-hovering-=-true;-future.delayed(widget.delay-to-show,-()-{-if-(is-hover-trigger-hovering-&amp;&amp;-!is-hover-menu-showing)-{-show-link-hover-menu();-}-});-}" command="(v) {
        isHoverTriggerHovering = true;
        Future.delayed(widget.delayToShow, () {
          if (isHoverTriggerHovering &amp;&amp; !isHoverMenuShowing) {
            showLinkHoverMenu();
          }
        });
      }" />
    <Action name="get-tap-callback" command="getTapCallback" />
    <Action name="get-tap-callback(()-{-set-state(()-{-is-convert-button-selected-=-true;-});-show-convert-menu();-})" command="getTapCallback(() {
        setState(() {
          isConvertButtonSelected = true;
        });
        showConvertMenu();
      })" />
    <Action name="open-link" command="openLink" />
    <Action name="widget.on-copy-link" command="widget.onCopyLink" />
    <Action name="widget.on-enter" command="widget.onEnter" />
    <Action name="widget.on-exit" command="widget.onExit" />
    <Action name="widget.on-open-link" command="widget.onOpenLink" />
  </Actions>
  <Page id="link-link-hover-menu-root">
    <Container id="container" Type="Vertical Stack" background="#FF000000" />
    <Container id="gesture-detector" Type="Vertical Stack" />
    <Container id="mouse-region" Type="Vertical Stack" />
    <Container id="app-flowy-popover" Type="Context Menu" />
    <Container id="app-flowy-popover-2" Type="Context Menu" />
    <Container id="column" Type="Vertical Stack">
      <Container id="mouse-region-2" Type="Vertical Stack">
        <Container id="sized-box" Type="Vertical Stack" height="48">
          <Container id="align" Type="Vertical Stack">
            <Container id="container-2" Type="Vertical Stack" width="320" height="48" padding="12 8 8 8">
              <Container id="row" Type="Horizontal Stack">
                <Container id="expanded" Type="Vertical Stack" />
                <Container id="container-3" Type="Vertical Stack" width="1" height="20" padding="6" background="#FFE8ECF3" />
                <Button id="flowy-icon-button" Type="Action" action="widget.on-copy-link" width="36" height="32">
                  <Image id="flowy-svg" />
                </Button>
                <Button id="flowy-icon-button-2" Type="Action" action="get-tap-callback" width="36" height="32">
                  <Image id="flowy-svg-2" />
                </Button>
                <Button id="flowy-icon-button-3" Type="Action" action="get-tap-callback" width="36" height="32">
                  <Image id="flowy-svg-3" />
                </Button>
              </Container>
            </Container>
          </Container>
        </Container>
      </Container>
      <Container id="mouse-region-3" Type="Vertical Stack">
        <Container id="gesture-detector-2" Type="Vertical Stack">
          <Container id="container-4" Type="Vertical Stack" background="#FF000000" />
        </Container>
      </Container>
    </Container>
    <Input id="circular-progress-indicator" Type="Progress" />
    <Container id="flowy-tooltip" Type="Floating" />
    <Button id="flowy-icon-button-4" Type="Action" action="get-tap-callback(()-{-set-state(()-{-is-convert-button-selected-=-true;-});-show-convert-menu();-})" width="36" height="32">
      <Image id="flowy-svg-4" />
    </Button>
    <Container id="app-flowy-popover-3" Type="Context Menu" />
    <Container id="mouse-region-4" Type="Vertical Stack">
      <Container id="padding" Type="Vertical Stack" padding="8.0">
        <Container id="vspace" Type="Vertical Stack" />
      </Container>
    </Container>
  </Page>
</Cui>
