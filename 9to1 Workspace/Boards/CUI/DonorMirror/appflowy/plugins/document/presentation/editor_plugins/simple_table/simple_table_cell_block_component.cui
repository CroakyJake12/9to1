<Cui id="simple-table-simple-table-cell-block-component" product="9-1" version="1">
  <Actions>
    <Action name="()-{-final-transaction-=-editor-state.transaction;-final-length-=-node.children.length;-final-path-=-node.path.child(length);-transaction-..insert-node(-path,-paragraph-node(),-)-..after-selection-=-selection.collapsed(position(path:-path));-editor-state.apply(transaction);-}" command="() {
        final transaction = editorState.transaction;
        final length = node.children.length;
        final path = node.path.child(length);
        transaction
          ..insertNode(
            path,
            paragraphNode(),
          )
          ..afterSelection = Selection.collapsed(Position(path: path));
        editorState.apply(transaction);
      }" />
  </Actions>
