<Cui id="font-customize-font-toolbar-item" product="9-1" version="1">
  <Actions>
    <Action name="()-{-if-(widget.on-font-family-changed-!=-null)-{-widget.on-font-family-changed!(button-font-family);-}-else-{-if-(widget.current-font-family.parse-font-family-name()-!=-button-font-family)-{-context-.read&lt;appearance-settings-cubit&gt;()-.set-font-family(button-font-family);-context-.read&lt;document-appearance-cubit&gt;()-.sync-font-family(button-font-family);-}-}-popover-container.of(context).close();-}" command="() {
            if (widget.onFontFamilyChanged != null) {
              widget.onFontFamilyChanged!(buttonFontFamily);
            } else {
              if (widget.currentFontFamily.parseFontFamilyName() !=
                  buttonFontFamily) {
                context
                    .read&lt;AppearanceSettingsCubit&gt;()
                    .setFontFamily(buttonFontFamily);
                context
                    .read&lt;DocumentAppearanceCubit&gt;()
                    .syncFontFamily(buttonFontFamily);
              }
            }
            PopoverContainer.of(context).close();
          }" />
    <Action name="(value)-{-set-state(()-{-query.value-=-value;-});-}" command="(value) {
                  setState(() {
                    query.value = value;
                  });
                }" />
  </Actions>
  <Page id="font-customize-font-toolbar-item-root">
    <Container id="column" Type="Vertical Stack">
      <Container id="padding" Type="Vertical Stack" padding="8.0">
        <Input id="flowy-text-field" Type="Text" />
      </Container>
      <Container id="container" Type="Vertical Stack" height="1" />
      <Container id="value-listenable-builder" Type="Vertical Stack">
        <Container id="flexible" Type="Vertical Stack" />
        <Container id="padding-2" Type="Vertical Stack" padding="8.0">
          <Container id="column-2" Type="Vertical Stack" />
        </Container>
      </Container>
    </Container>
    <Container id="tooltip" Type="Floating">
      <Container id="sized-box" Type="Vertical Stack" height="36">
        <Button id="flowy-button" Type="Action" action="()-{-if-(widget.on-font-family-changed-!=-null)-{-widget.on-font-family-changed!(button-font-family);-}-else-{-if-(widget.current-font-family.parse-font-family-name()-!=-button-font-family)-{-context-.read&lt;appearance-settings-cubit&gt;()-.set-font-family(button-font-family);-context-.read&lt;document-appearance-cubit&gt;()-.sync-font-family(button-font-family);-}-}-popover-container.of(context).close();-}">
          <Text id="flowy-text" />
          <Image id="flowy-svg" />
        </Button>
      </Container>
    </Container>
  </Page>
</Cui>
