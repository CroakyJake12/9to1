      <Button id="flowy-button" Type="Action" action="on-tap-??-()-{-command.on-execute(editor-state,-context);-hide-other-popovers(command);-if-(command-!=-more-option-command.font)-{-popover-controller.close();-}-}">
        <Image id="flowy-svg-2" />
