<Cui id="toolbar-item-more-option-toolbar-item" product="9-1" version="1">
  <Actions>
    <Action name="()-{-set-state(()-{-is-selected-=-true;-});-show-popover();-}" command="() {
        setState(() {
          isSelected = true;
        });
        showPopover();
      }" />
    <Action name="on-tap-??-()-{-command.on-execute(editor-state,-context);-hide-other-popovers(command);-if-(command-!=-more-option-command.font)-{-popover-controller.close();-}-}" command="onTap ??
            () {
              command.onExecute(editorState, context);
              hideOtherPopovers(command);
              if (command != MoreOptionCommand.font) {
                popoverController.close();
              }
            }" />
  </Actions>
  <Page id="toolbar-item-more-option-toolbar-item-root">
