<Cui id="file-file-block-component" product="9-1" version="1">
  <Actions>
    <Action name="(-)-{-set-state(()-=&gt;-is-hovering-=-false);-if-(!always-show-menu)-{-show-actions-notifier.value-=-false;-}-}" command="(_) {
        setState(() =&gt; isHovering = false);
        if (!alwaysShowMenu) {
          showActionsNotifier.value = false;
        }
      }" />
    <Action name="(-)-{-set-state(()-=&gt;-is-hovering-=-true);-show-actions-notifier.value-=-true;-}" command="(_) {
        setState(() =&gt; isHovering = true);
        showActionsNotifier.value = true;
      }" />
    <Action name="menu-controller.show" command="menuController.show" />
    <Action name="url-!=-null-&amp;&amp;-url.is-not-empty-?-()-async-=&gt;-open-file(context,-url-type,-url)-:-open-menu" command="url != null &amp;&amp; url.isNotEmpty
            ? () async =&gt; _openFile(context, urlType, url)
            : _openMenu" />
  </Actions>
  <Page id="file-file-block-component-root">
