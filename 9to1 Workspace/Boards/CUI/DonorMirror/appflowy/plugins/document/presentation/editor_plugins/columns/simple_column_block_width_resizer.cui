<Cui id="columns-simple-column-block-width-resizer" product="9-1" version="1">
  <Actions>
    <Action name="(-)-{-future.delayed(const-duration(milliseconds:-100),-()-{-if-(!is-dragging)-{-is-hovering.value-=-false;-}-});-}" command="(_) {
        
        Future.delayed(const Duration(milliseconds: 100), () {
          if (!isDragging) {
            isHovering.value = false;
          }
        });
      }" />
  </Actions>
  <Page id="columns-simple-column-block-width-resizer-root">
    <Container id="mouse-region" Type="Vertical Stack">
      <Container id="gesture-detector" Type="Vertical Stack">
        <Container id="value-listenable-builder" Type="Vertical Stack">
          <Container id="shrink" Type="Vertical Stack" />
          <Container id="mouse-region-2" Type="Vertical Stack">
            <Container id="container" Type="Vertical Stack" width="2" padding="2" background="#00000000" />
          </Container>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
