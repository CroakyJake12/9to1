<Cui id="widgets-board-hidden-groups" product="9-1" version="1">
  <Actions>
    <Action name="()-=&gt;-context-.read&lt;board-bloc&gt;()-.add" command="() =&gt; context
            .read&lt;BoardBloc&gt;()
            .add" />
    <Action name="()-=&gt;-context.read&lt;board-bloc&gt;().add(-board-event.set-group-visibility(-group,-true,-),-)" command="() =&gt;
                                      context.read&lt;BoardBloc&gt;().add(
                                            BoardEvent.setGroupVisibility(
                                              group,
                                              true,
                                            ),
                                          )" />
    <Action name="on-pressed" command="onPressed" />
    <Action name="popover-controller.show" command="popoverController.show" />
  </Actions>
  <Page id="widgets-board-hidden-groups-root">
    <Container id="shrink" Type="Vertical Stack" />
    <Container id="sized-box" Type="Vertical Stack" height="50">
      <Container id="padding" Type="Vertical Stack" padding="80 8">
        <Container id="center" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="container" Type="Vertical Stack" padding="4">
      <Container id="column" Type="Vertical Stack">
        <Container id="sized-box-2" Type="Vertical Stack" height="50">
          <Container id="row" Type="Horizontal Stack">
            <Container id="expanded" Type="Vertical Stack" />
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="expanded-2" Type="Vertical Stack" />
    <Container id="flowy-tooltip" Type="Floating">
      <Button id="flowy-icon-button" Type="Action" action="()-=&gt;-context-.read&lt;board-bloc&gt;()-.add" width="20" height="20">
        <Image id="flowy-svg" />
      </Button>
    </Container>
    <Container id="bloc-builder" Type="Vertical Stack">
      <Container id="shrink-2" Type="Vertical Stack" />
      <Container id="stack" Type="Absolute">
        <Container id="mouse-region" Type="Vertical Stack" />
      </Container>
      <Container id="padding-2" Type="Vertical Stack" padding="4" />
    </Container>
    <Container id="app-flowy-popover" Type="Context Menu" />
    <Container id="padding-3" Type="Vertical Stack" padding="8.0">
      <Container id="gesture-detector" Type="Vertical Stack">
        <Container id="bloc-builder-2" Type="Vertical Stack">
          <Container id="shrink-3" Type="Vertical Stack" />
          <Container id="shrink-4" Type="Vertical Stack" />
          <Container id="sized-box-3" Type="Vertical Stack" height="32">
            <Container id="padding-4" Type="Vertical Stack" padding="4 3">
              <Container id="row-2" Type="Horizontal Stack">
                <Container id="hspace" Type="Horizontal Stack" />
                <Container id="expanded-3" Type="Vertical Stack">
                  <Container id="row-3" Type="Horizontal Stack">
                    <Container id="flexible" Type="Vertical Stack">
                      <Text id="flowy-text" />
                    </Container>
                    <Container id="hspace-2" Type="Horizontal Stack" />
                    <Text id="flowy-text-2" />
                  </Container>
                </Container>
                <Container id="hspace-3" Type="Horizontal Stack" />
                <Button id="flowy-icon-button-2" Type="Action" action="()-=&gt;-context.read&lt;board-bloc&gt;().add(-board-event.set-group-visibility(-group,-true,-),-)" width="20">
                  <Image id="flowy-svg-2" />
                </Button>
              </Container>
            </Container>
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="mouse-region-2" Type="Vertical Stack">
      <Container id="sized-box-4" Type="Vertical Stack" width="14" height="14">
        <Image id="flowy-svg-3" />
        <Container id="shrink-5" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="bloc-builder-3" Type="Vertical Stack">
      <Container id="shrink-6" Type="Vertical Stack" />
      <Container id="shrink-7" Type="Vertical Stack" />
      <Container id="padding-5" Type="Vertical Stack" padding="6 4">
        <Text id="flowy-text-3" />
      </Container>
      <Container id="vspace" Type="Vertical Stack" />
    </Container>
    <Container id="sized-box-5" Type="Vertical Stack" height="26">
      <Button id="flowy-button" Type="Action" action="on-pressed" padding="8.0 4.0" />
    </Container>
  </Page>
</Cui>
