<Cui id="choicechip-text" product="9-1" version="1">
  <Actions>
    <Action name="(text)-{-final-new-filter-=-filter.copy-with(content:-text);-context-.read&lt;filter-editor-bloc&gt;()-.add(filter-editor-event.update-filter(new-filter));-}" command="(text) {
        final newFilter = filter.copyWith(content: text);
        context
            .read&lt;FilterEditorBloc&gt;()
            .add(FilterEditorEvent.updateFilter(newFilter));
      }" />
  </Actions>
  <Page id="choicechip-text-root">
    <Container id="app-flowy-popover" Type="Context Menu" />
    <Container id="vspace" Type="Vertical Stack" />
    <Container id="padding" Type="Vertical Stack" padding="4 1">
      <Container id="intrinsic-height" Type="Vertical Stack">
        <Container id="column" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="sized-box" Type="Vertical Stack" height="20">
      <Container id="row" Type="Horizontal Stack">
        <Container id="expanded" Type="Vertical Stack">
          <Text id="flowy-text" />
        </Container>
        <Container id="hspace" Type="Horizontal Stack" />
        <Container id="expanded-2" Type="Vertical Stack" />
        <Container id="hspace-2" Type="Horizontal Stack" />
      </Container>
    </Container>
    <Input id="flowy-text-field" Type="Text" />
    <Image id="flowy-svg" />
  </Page>
</Cui>
