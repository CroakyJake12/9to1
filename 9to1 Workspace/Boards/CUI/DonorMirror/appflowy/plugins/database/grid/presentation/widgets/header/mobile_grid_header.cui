<Cui id="header-mobile-grid-header" product="9-1" version="1">
  <Actions>
    <Action name="mobile-create-field-workflow" command="mobileCreateFieldWorkflow" />
  </Actions>
  <Page id="header-mobile-grid-header-root">
    <Container id="bloc-provider" Type="Vertical Stack">
      <Container id="stack" Type="Absolute">
        <Container id="bloc-builder" Type="Vertical Stack">
          <Container id="single-child-scroll-view" Type="Vertical Stack">
            <Container id="stack-2" Type="Absolute">
              <Container id="positioned" Type="Vertical Stack" />
              <Container id="positioned-2" Type="Vertical Stack" />
              <Container id="sized-box" Type="Vertical Stack" />
            </Container>
          </Container>
        </Container>
        <Container id="sized-box-2" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="divider" Type="Separator" height="1" />
    <Container id="bloc-builder-2" Type="Vertical Stack" />
    <Container id="container" Type="Vertical Stack">
      <Button id="flowy-button" Type="Action" action="mobile-create-field-workflow" padding="14 12">
        <Text id="flowy-text" />
        <Image id="flowy-svg" />
      </Button>
    </Container>
  </Page>
</Cui>
