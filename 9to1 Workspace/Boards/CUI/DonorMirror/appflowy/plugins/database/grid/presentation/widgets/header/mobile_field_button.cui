    <Action name="()-=&gt;-show-quick-edit-field" command="() =&gt;
            showQuickEditField" />
  </Actions>
  <Page id="header-mobile-field-button-root">
    <Container id="container" Type="Vertical Stack" width="200">
      <Button id="flowy-button" Type="Action" action="()-=&gt;-show-quick-edit-field">
        <Text id="flowy-text" />
