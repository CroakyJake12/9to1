<Cui id="presentation-calendar-day" product="9-1" version="1">
  <Actions>
    <Action name="notify-enter" command="notifyEnter" />
    <Action name="on-create" command="onCreate" />
    <Action name="universal-platform.is-mobile-?-()-=&gt;-mobile-on-tap(context)-:-null" command="UniversalPlatform.isMobile
                      ? () =&gt; _mobileOnTap(context)
                      : null" />
  </Actions>
  <Page id="presentation-calendar-day-root">
    <Container id="column" Type="Vertical Stack">
      <Container id="vspace" Type="Vertical Stack" />
    </Container>
    <Container id="stack" Type="Absolute">
      <Container id="gesture-detector" Type="Vertical Stack">
        <Container id="container" Type="Vertical Stack" background="#00000000" />
      </Container>
      <Container id="stack-2" Type="Absolute">
        <Container id="container-2" Type="Vertical Stack" padding="5.0" />
      </Container>
      <Container id="mouse-region" Type="Vertical Stack" />
    </Container>
    <Container id="row" Type="Horizontal Stack">
      <Container id="container-3" Type="Vertical Stack" width="7" height="7" />
    </Container>
    <Container id="padding" Type="Vertical Stack" padding="6.0" />
    <Container id="consumer" Type="Vertical Stack">
      <Container id="shrink" Type="Vertical Stack" />
      <Container id="padding-2" Type="Vertical Stack" padding="4.0">
        <Button id="flowy-icon-button" Type="Action" action="on-create" width="22" background="#FFD0D3D6">
          <Image id="flowy-svg" />
        </Button>
      </Container>
    </Container>
    <Container id="sized-box" Type="Vertical Stack">
      <Container id="row-2" Type="Horizontal Stack">
        <Container id="container-4" Type="Vertical Stack" CornerRadius="10">
          <Container id="center" Type="Vertical Stack">
            <Text id="flowy-text" />
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="flexible" Type="Vertical Stack">
      <Container id="vspace-2" Type="Vertical Stack" />
    </Container>
  </Page>
</Cui>
