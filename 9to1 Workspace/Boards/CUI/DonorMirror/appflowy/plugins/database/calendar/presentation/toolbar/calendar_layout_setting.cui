      <Container id="sized-box-6" Type="Vertical Stack">
        <Button id="flowy-button-3" Type="Action" padding="2.0 10.0">
          <Text id="flowy-text-3" />
        </Button>
      </Container>
    </Container>
    <Container id="sized-box-7" Type="Vertical Stack">
      <Container id="padding" Type="Vertical Stack" padding="2.0 10.0">
        <Container id="row" Type="Horizontal Stack">
          <Text id="flowy-text-4" />
        </Container>
      </Container>
    </Container>
    <Container id="sized-box-8" Type="Vertical Stack">
      <Button id="flowy-button-4" Type="Action" action="on-tap">
