    </Container>
    <Container id="app-flowy-popover" Type="Context Menu">
      <Container id="bloc-provider-2" Type="Vertical Stack">
        <Container id="bloc-builder-2" Type="Vertical Stack">
          <Container id="sized-box-2" Type="Vertical Stack">
            <Button id="flowy-button" Type="Action" action="()-{-on-updated(field-info.id);-popover-mutex.close();-}">
              <Text id="flowy-text" />
              <Image id="flowy-svg" />
              <Image id="flowy-svg-2" />
