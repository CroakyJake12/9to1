<Cui id="toolbar-calendar-layout-setting" product="9-1" version="1">
  <Actions>
    <Action name="()-{-on-updated(field-info.id);-popover-mutex.close();-}" command="() {
                        onUpdated(fieldInfo.id);
                        popoverMutex.close();
                      }" />
    <Action name="on-tap" command="onTap" />
  </Actions>
  <Page id="toolbar-calendar-layout-setting-root">
    <Container id="bloc-provider" Type="Vertical Stack">
      <Container id="bloc-builder" Type="Vertical Stack">
