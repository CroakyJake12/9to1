<Cui id="desktop-tab-bar-header" product="9-1" version="1">
  <Actions>
    <Action name="()-{-if-(widget.is-selected)-menu-controller.show();-widget.on-tap.call();-}" command="() {
              if (widget.isSelected) menuController.show();
              widget.onTap.call();
            }" />
    <Action name="()-{-menu-controller.show();-}" command="() {
              menuController.show();
            }" />
  </Actions>
  <Page id="desktop-tab-bar-header-root">
    <Container id="sized-box" Type="Vertical Stack" height="35">
      <Container id="stack" Type="Absolute">
        <Container id="positioned" Type="Vertical Stack">
          <Container id="divider" Type="Vertical Stack" height="1" />
        </Container>
        <Container id="row" Type="Horizontal Stack">
          <Container id="expanded" Type="Vertical Stack" />
          <Container id="flexible" Type="Vertical Stack">
            <Container id="bloc-builder" Type="Vertical Stack">
              <Container id="padding" Type="Vertical Stack" padding="6.0" />
            </Container>
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="shrink" Type="Vertical Stack" />
    <Container id="bloc-builder-2" Type="Vertical Stack">
      <Container id="vertical-divider" Type="Vertical Stack" width="1.0" />
    </Container>
    <Container id="stack-2" Type="Absolute">
      <Container id="padding-2" Type="Vertical Stack" padding="2">
        <Container id="sized-box-2" Type="Vertical Stack" height="26" />
      </Container>
      <Container id="positioned-2" Type="Vertical Stack">
        <Container id="divider-2" Type="Vertical Stack" height="2" />
      </Container>
    </Container>
    <Container id="app-flowy-popover" Type="Context Menu">
      <Container id="intrinsic-height" Type="Vertical Stack">
        <Container id="column" Type="Vertical Stack">
          <Container id="app-flowy-popover-2" Type="Context Menu" padding="0" />
        </Container>
      </Container>
      <Container id="flowy-tooltip" Type="Floating">
        <Button id="flowy-button" Type="Action" action="()-{-menu-controller.show();-}" padding="12 5">
          <Text id="flowy-text" text-alignment="Center" />
        </Button>
      </Container>
    </Container>
    <Container id="stack-3" Type="Absolute">
      <Container id="positioned-3" Type="Vertical Stack">
        <Image id="flowy-svg" />
      </Container>
    </Container>
    <Image id="flowy-svg-2" />
    <Image id="flowy-svg-3" />
    <Image id="flowy-svg-4" />
  </Page>
</Cui>
