<Cui id="mobile-row-detail-mobile-row-detail-url-cell" product="9-1" version="1">
  <Actions>
    <Action name="()-=&gt;-show-mobile-bottom-sheet(-context,-show-drag-handle:-true,-background-color:-aftheme-extension.of(context).background,-builder:-(-)-{-return-bloc-provider.value(-value:-bloc,-child:-mobile-urleditor(-text-editing-controller:-text-editing-controller,-),-);-},-)" command="() =&gt; showMobileBottomSheet(
            context,
            showDragHandle: true,
            backgroundColor: AFThemeExtension.of(context).background,
            builder: (_) {
              return BlocProvider.value(
                value: bloc,
                child: MobileURLEditor(
                  textEditingController: textEditingController,
                ),
