<Cui id="mobile-row-detail-mobile-row-detail-select-cell-option" product="9-1" version="1">
  <Actions>
    <Action name="()-=&gt;-show-mobile-bottom-sheet(-context,-builder:-(context)-{-return-mobile-select-option-editor(-cell-controller:-bloc.cell-controller,-);-},-)" command="() =&gt; showMobileBottomSheet(
            context,
            builder: (context) {
              return MobileSelectOptionEditor(
                cellController: bloc.cellController,
              );
            },
          )" />
  </Actions>
  <Page id="mobile-row-detail-mobile-row-detail-select-cell-option-root">
    <Container id="bloc-builder" Type="Vertical Stack">
      <Container id="ink-well" Type="Vertical Stack">
        <Container id="container" Type="Vertical Stack" padding="12 13 10">
          <Container id="row" Type="Horizontal Stack">
            <Container id="expanded" Type="Vertical Stack" />
            <Container id="hspace" Type="Horizontal Stack" />
            <Image id="icon" source="chevron_left" />
            <Container id="hspace-2" Type="Horizontal Stack" />
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="container-2" Type="Vertical Stack" padding="1">
      <Text id="flowy-text" />
    </Container>
    <Container id="padding" Type="Vertical Stack" padding="0 0 4" />
    <Container id="align" Type="Vertical Stack">
      <Container id="wrap" Type="Wrap" />
    </Container>
  </Page>
</Cui>
