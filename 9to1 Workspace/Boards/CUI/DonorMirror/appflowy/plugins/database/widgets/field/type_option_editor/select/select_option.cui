<Cui id="select-select-option" product="9-1" version="1">
  <Actions>
    <Action name="()-{-context-.read&lt;select-option-type-option-bloc&gt;()-.add(const-select-option-type-option-event.adding-option());-}" command="() {
            context
                .read&lt;SelectOptionTypeOptionBloc&gt;()
                .add(const SelectOptionTypeOptionEvent.addingOption());
          }" />
    <Action name="(option-name)-{-context-.read&lt;select-option-type-option-bloc&gt;()-.add(select-option-type-option-event.create-option(option-name));-}" command="(optionName) {
              context
                  .read&lt;SelectOptionTypeOptionBloc&gt;()
                  .add(SelectOptionTypeOptionEvent.createOption(optionName));
            }" />
    <Action name="popover-controller.show" command="_popoverController.show" />
  </Actions>
  <Page id="select-select-option-root">
    <Container id="bloc-provider" Type="Vertical Stack">
      <Container id="bloc-builder" Type="Vertical Stack">
        <Container id="vspace" Type="Vertical Stack" />
        <Container id="vspace-2" Type="Vertical Stack" />
        <Container id="vspace-3" Type="Vertical Stack" />
        <Container id="flexible" Type="Vertical Stack" />
        <Container id="column" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="bloc-builder-2" Type="Vertical Stack">
      <Container id="padding" Type="Vertical Stack" padding="16">
        <Container id="align" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="sized-box" Type="Vertical Stack" height="28">
      <Button id="flowy-icon-button" Type="Action" action="popover-controller.show">
        <Image id="flowy-svg" />
      </Button>
    </Container>
    <Container id="app-flowy-popover" Type="Context Menu">
      <Container id="padding-2" Type="Vertical Stack" padding="8.0" />
    </Container>
    <Container id="padding-3" Type="Vertical Stack" padding="8.0">
      <Container id="sized-box-2" Type="Vertical Stack">
        <Button id="flowy-button" Type="Action" action="()-{-context-.read&lt;select-option-type-option-bloc&gt;()-.add(const-select-option-type-option-event.adding-option());-}">
          <Text id="flowy-text" />
          <Image id="flowy-svg-2" />
        </Button>
      </Container>
    </Container>
    <Container id="bloc-builder-3" Type="Vertical Stack">
      <Container id="padding-4" Type="Vertical Stack" padding="14.0">
        <Input id="flowy-text-field" Type="Text" />
      </Container>
    </Container>
    <Container id="bloc-builder-4" Type="Vertical Stack">
      <Container id="stack" Type="Absolute">
        <Container id="mouse-region" Type="Vertical Stack" />
      </Container>
    </Container>
  </Page>
</Cui>
