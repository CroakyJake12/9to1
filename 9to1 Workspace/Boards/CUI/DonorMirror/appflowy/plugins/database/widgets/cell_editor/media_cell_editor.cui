<Cui id="cell-editor-media-cell-editor" product="9-1" version="1">
  <Actions>
    <Action name="()-=&gt;-open-interactive-viewer-from-files(-context,-files,-on-delete-image:-(index)-{-final-delete-file-=-files[index];-context.read&lt;media-cell-bloc&gt;().delete-file(delete-file.id);-},-user-profile:-context.read&lt;media-cell-bloc&gt;().state.user-profile,-initial-index:-index,-)" command="() =&gt; openInteractiveViewerFromFiles(
          context,
          files,
          onDeleteImage: (index) {
            final deleteFile = files[index];
            context.read&lt;MediaCellBloc&gt;().deleteFile(deleteFile.id);
          },
          userProfile: context.read&lt;MediaCellBloc&gt;().state.userProfile,
          initialIndex: index,
        )" />
