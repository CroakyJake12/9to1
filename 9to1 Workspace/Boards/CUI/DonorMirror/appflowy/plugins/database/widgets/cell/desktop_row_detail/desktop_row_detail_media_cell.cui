<Cui id="desktop-row-detail-desktop-row-detail-media-cell" product="9-1" version="1">
  <Actions>
    <Action name="()-{-if-(position-!=-null)-{-widget.controller.show-at(-position!-const-offset(-menu-width-/-2,-0),-);-}-}" command="() {
            if (position != null) {
              widget.controller.showAt(
                position! - const Offset(_menuWidth / 2, 0),
              );
            }
          }" />
    <Action name="()-{-set-state(()-=&gt;-is-selected-=-true);-controller.show();-}" command="() {
                          setState(() =&gt; isSelected = true);
                          controller.show();
                        }" />
    <Action name="set-state" command="setState" />
    <Action name="toggle-show-all-files" command="_toggleShowAllFiles" />
    <Action name="widget.foreground-text-!=-null-?-null-:-()-{-if-(file.upload-type-==-file-upload-type-pb.local-file)-{-af-launch-url-string(file.url);-return;-}-if-(file.file-type-!=-media-file-type-pb.image)-{-af-launch-url-string(widget.file.url);-return;-}-open-interactive-viewer-from-files(-context,-widget.images,-user-profile:-context.read&lt;media-cell-bloc&gt;().state.user-profile,-initial-index:-this-index,-on-delete-image:-(index)-{-final-delete-file-=-widget.images[index];-context.read&lt;media-cell-bloc&gt;().delete-file(delete-file.id);-},-);-}" command="widget.foregroundText != null
                ? null
                : () {
                    if (file.uploadType == FileUploadTypePB.LocalFile) {
                      afLaunchUrlString(file.url);
                      return;
                    }

                    if (file.fileType != MediaFileTypePB.Image) {
                      afLaunchUrlString(widget.file.url);
                      return;
                    }

                    openInteractiveViewerFromFiles(
                      context,
                      widget.images,
                      userProfile:
                          context.read&lt;MediaCellBloc&gt;().state.userProfile,
                      initialIndex: thisIndex,
                      onDeleteImage: (index) {
                        final deleteFile = widget.images[index];
                        context.read&lt;MediaCellBloc&gt;().deleteFile(deleteFile.id);
                      },
                    );
                  }" />
  </Actions>
  <Page id="desktop-row-detail-desktop-row-detail-media-cell-root">
    <Container id="bloc-builder" Type="Vertical Stack">
      <Container id="padding" Type="Vertical Stack" padding="8 6">
        <Text id="flowy-text" />
      </Container>
      <Container id="column" Type="Vertical Stack">
        <Container id="padding-2" Type="Vertical Stack" padding="8.0">
          <Container id="gesture-detector" Type="Vertical Stack" />
        </Container>
        <Container id="padding-3" Type="Vertical Stack" padding="4">
          <Container id="row" Type="Horizontal Stack">
            <Image id="flowy-svg" />
            <Container id="hspace" Type="Horizontal Stack" />
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="decorated-box" Type="Vertical Stack" CornerRadius="6" background="#FF00BCF0">
      <Container id="decorated-box-2" Type="Vertical Stack" background="#FF1F2329" />
    </Container>
    <Container id="app-flowy-popover" Type="Context Menu">
      <Container id="mouse-region" Type="Vertical Stack">
        <Container id="gesture-detector-2" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="decorated-box-3" Type="Vertical Stack">
      <Container id="center" Type="Vertical Stack">
        <Container id="padding-4" Type="Vertical Stack" padding="8">
          <Image id="flowy-svg-2" background="#FF666D76" />
        </Container>
      </Container>
    </Container>
    <Container id="stack" Type="Absolute">
      <Container id="decorated-box-4" Type="Vertical Stack" background="#FF000000" />
      <Container id="center-2" Type="Vertical Stack" />
    </Container>
    <Container id="mouse-region-2" Type="Vertical Stack">
      <Container id="flowy-tooltip" Type="Floating">
        <Container id="app-flowy-popover-2" Type="Context Menu">
          <Container id="gesture-detector-3" Type="Vertical Stack">
            <Container id="container" Type="Vertical Stack">
              <Container id="stack-2" Type="Absolute">
                <Container id="column-2" Type="Vertical Stack">
                  <Container id="sized-box" Type="Vertical Stack" height="68" />
                  <Container id="row-2" Type="Horizontal Stack">
                    <Container id="expanded" Type="Vertical Stack">
                      <Container id="padding-5" Type="Vertical Stack" padding="4">
                        <Text id="flowy-text-2" />
                      </Container>
                    </Container>
                  </Container>
                </Container>
                <Container id="positioned" Type="Vertical Stack">
                  <Button id="flowy-icon-button" Type="Action" action="()-{-set-state(()-=&gt;-is-selected-=-true);-controller.show();-}" width="18">
                    <Image id="flowy-svg-3" background="#FFFFFFFF" />
                  </Button>
                </Container>
              </Container>
            </Container>
          </Container>
        </Container>
      </Container>
    </Container>
    <Container id="vspace" Type="Vertical Stack" />
  </Page>
</Cui>
