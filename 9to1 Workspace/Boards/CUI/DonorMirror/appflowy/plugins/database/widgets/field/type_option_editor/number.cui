<Cui id="type-option-editor-number" product="9-1" version="1">
  <Actions>
    <Action name="(text)-=&gt;-context-.read&lt;number-format-bloc&gt;()-.add" command="(text) =&gt; context
            .read&lt;NumberFormatBloc&gt;()
            .add" />
    <Action name="on-selected" command="onSelected" />
  </Actions>
  <Page id="type-option-editor-number-root">
    <Container id="sized-box" Type="Vertical Stack">
      <Button id="flowy-button" Type="Action">
        <Image id="flowy-svg" />
        <Text id="flowy-text" />
      </Button>
    </Container>
    <Container id="container" Type="Vertical Stack" padding="6" />
    <Container id="padding" Type="Vertical Stack" padding="8">
      <Container id="column" Type="Vertical Stack">
        <Container id="app-flowy-popover" Type="Context Menu" />
      </Container>
    </Container>
    <Container id="bloc-provider" Type="Vertical Stack">
      <Container id="sized-box-2" Type="Vertical Stack" width="180">
        <Container id="column-2" Type="Vertical Stack">
          <Container id="bloc-builder" Type="Vertical Stack">
            <Container id="vspace" Type="Vertical Stack" />
            <Container id="flexible" Type="Vertical Stack" />
          </Container>
        </Container>
      </Container>
    </Container>
    <Image id="flowy-svg-2" />
    <Container id="sized-box-3" Type="Vertical Stack">
      <Button id="flowy-button-2" Type="Action" action="on-selected">
        <Text id="flowy-text-2" />
      </Button>
    </Container>
    <Container id="padding-2" Type="Vertical Stack" padding="6.0">
      <Input id="flowy-text-field" Type="Text" />
    </Container>
  </Page>
</Cui>
