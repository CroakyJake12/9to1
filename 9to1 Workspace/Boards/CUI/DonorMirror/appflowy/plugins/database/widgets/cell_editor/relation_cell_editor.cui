              <Button id="flowy-button" Type="Action" action="()-=&gt;-context.read&lt;relation-cell-bloc&gt;().add(-relation-cell-event.select-database-id(-database-meta.database-id,-),-)">
                <Text id="flowy-text-3" />
              </Button>
            </Container>
          </Container>
        </Container>
