    <Container id="container" Type="Vertical Stack" height="28" padding="6.0 2.0">
      <Container id="gesture-detector-2" Type="Vertical Stack">
        <Container id="mouse-region-2" Type="Vertical Stack">
          <Container id="padding-7" Type="Vertical Stack" padding="6.0 4.0">
