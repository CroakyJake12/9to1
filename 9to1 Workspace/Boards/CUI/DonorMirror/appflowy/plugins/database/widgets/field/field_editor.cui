<Cui id="field-field-editor" product="9-1" version="1">
  <Actions>
    <Action name="(new-name)-{-context-.read&lt;field-editor-bloc&gt;()-.add(field-editor-event.rename-field(new-name));-}" command="(newName) {
        context
            .read&lt;FieldEditorBloc&gt;()
            .add(FieldEditorEvent.renameField(newName));
      }" />
    <Action name="on-tap" command="onTap" />
    <Action name="popover-container.of" command="PopoverContainer.of" />
    <Action name="popover-controller.show" command="_popoverController.show" />
    <Action name="popover-controller.show" command="popoverController.show" />
  </Actions>
  <Page id="field-field-editor-root">
    <Container id="bloc-provider" Type="Vertical Stack" />
    <Container id="sized-box" Type="Vertical Stack" width="240">
      <Container id="column" Type="Vertical Stack">
        <Container id="vspace" Type="Vertical Stack" />
        <Container id="vspace-2" Type="Vertical Stack" />
        <Container id="vspace-3" Type="Vertical Stack" />
        <Container id="vspace-4" Type="Vertical Stack" />
        <Container id="vspace-5" Type="Vertical Stack" />
        <Container id="vspace-6" Type="Vertical Stack" />
        <Container id="vspace-7" Type="Vertical Stack" />
        <Container id="vspace-8" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="bloc-builder" Type="Vertical Stack">
      <Container id="padding" Type="Vertical Stack" padding="8.0" />
    </Container>
    <Container id="sized-box-2" Type="Vertical Stack" width="260" />
    <Container id="container" Type="Vertical Stack">
      <Button id="flowy-button" Type="Action" action="on-tap">
        <Image id="flowy-svg" />
        <Text id="flowy-text" />
      </Button>
    </Container>
    <Text id="flowy-text-2" />
    <Image id="flowy-svg-2" />
    <Container id="vspace-9" Type="Vertical Stack" />
    <Container id="flexible" Type="Vertical Stack" />
    <Container id="padding-2" Type="Vertical Stack" padding="8.0">
      <Container id="column-2" Type="Vertical Stack" />
    </Container>
    <Container id="bloc-builder-2" Type="Vertical Stack">
      <Container id="padding-3" Type="Vertical Stack" padding="8.0" />
    </Container>
    <Container id="bloc-builder-3" Type="Vertical Stack">
      <Container id="padding-4" Type="Vertical Stack" padding="8.0 4.0 8.0 0" />
    </Container>
    <Container id="bloc-builder-4" Type="Vertical Stack">
      <Container id="padding-5" Type="Vertical Stack" padding="8.0 4.0 8.0 0" />
    </Container>
    <Container id="bloc-builder-5" Type="Vertical Stack">
      <Container id="shrink" Type="Vertical Stack" />
      <Container id="shrink-2" Type="Vertical Stack" />
      <Container id="column-3" Type="Vertical Stack">
        <Container id="flexible-2" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="padding-6" Type="Vertical Stack">
      <Container id="row" Type="Horizontal Stack">
        <Container id="hspace" Type="Horizontal Stack" />
        <Container id="expanded" Type="Vertical Stack" />
      </Container>
    </Container>
    <Container id="app-flowy-popover" Type="Context Menu">
      <Button id="flowy-icon-button" Type="Action" action="popover-controller.show" width="32">
        <Container id="bloc-builder-6" Type="Vertical Stack" />
      </Button>
    </Container>
    <Input id="flowy-text-field" Type="Text" />
    <Container id="bloc-builder-7" Type="Vertical Stack">
      <Container id="sized-box-3" Type="Vertical Stack">
        <Container id="padding-7" Type="Vertical Stack" padding="8.0">
          <Container id="flowy-tooltip" Type="Floating">
            <Button id="flowy-button-2" Type="Action">
              <Text id="flowy-text-3" />
              <Image id="flowy-svg-3" />
              <Image id="flowy-svg-4" />
            </Button>
          </Container>
        </Container>
      </Container>
      <Container id="sized-box-4" Type="Vertical Stack">
        <Container id="app-flowy-popover-2" Type="Context Menu" padding="8">
          <Container id="padding-8" Type="Vertical Stack" padding="8.0">
            <Button id="flowy-button-3" Type="Action" action="popover-controller.show">
              <Text id="flowy-text-4" />
              <Image id="flowy-svg-5" />
              <Image id="flowy-svg-6" />
            </Button>
          </Container>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
