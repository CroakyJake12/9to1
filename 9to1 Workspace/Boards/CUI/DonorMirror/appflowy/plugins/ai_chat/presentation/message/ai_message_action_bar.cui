<Cui id="message-ai-message-action-bar" product="9-1" version="1">
  <Actions>
    <Action name="()-async-{-final-document-id-=-get-opened-document-id();-if-(document-id-!=-null)-{-await-on-add-to-existing-page(context,-document-id);-await-force-reload(document-id);-await-future.delayed(const-duration(milliseconds:-500));-await-update-selection(document-id);-}-else-{-widget.on-override-visibility?.call(true);-if-(space-view-!=-null)-{-unawaited(-context-.read&lt;view-selector-cubit&gt;()-.refresh-sources([space-view],-space-view),-);-}-popover-controller.show();-}-}" command="() async {
          final documentId = getOpenedDocumentId();
          if (documentId != null) {
            await onAddToExistingPage(context, documentId);
            await forceReload(documentId);
            await Future.delayed(const Duration(milliseconds: 500));
            await updateSelection(documentId);
          } else {
            widget.onOverrideVisibility?.call(true);
            if (spaceView != null) {
              unawaited(
                context
                    .read&lt;ViewSelectorCubit&gt;()
                    .refreshSources([spaceView], spaceView),
              );
            }
            popoverController.show();
          }
        }" />
    <Action name="()-async-{-final-message-text-=-text-message.text.trim();-final-document-=-custom-markdown-to-document(-message-text,-table-width:-250.0,-);-await-get-it&lt;clipboard-service&gt;().set-data(-clipboard-service-data(-plain-text:-strip-markdown-if-necessary(message-text),-in-app-json:-json-encode(document.to-json()),-),-);-if-(context.mounted)-{-show-toast-notification(-message:-locale-keys.message-copy-success.tr(),-);-}-}" command="() async {
          final messageText = textMessage.text.trim();
          final document = customMarkdownToDocument(
            messageText,
            tableWidth: 250.0,
          );
          await getIt&lt;ClipboardService&gt;().setData(
            ClipboardServiceData(
              plainText: _stripMarkdownIfNecessary(messageText),
              inAppJson: jsonEncode(document.toJson()),
            ),
          );
          if (context.mounted) {
            showToastNotification(
              message: LocaleKeys.message_copy_success.tr(),
            );
          }
        }" />
    <Action name="()-{-if-(predefined-format-!=-null)-{-widget.on-regenerate?.call(predefined-format!);-}-}" command="() {
                  if (predefinedFormat != null) {
                    widget.onRegenerate?.call(predefinedFormat!);
                  }
                }" />
    <Action name="()-{-widget.on-override-visibility?.call(true);-popover-controller.show();-}" command="() {
          widget.onOverrideVisibility?.call(true);
          popoverController.show();
        }" />
    <Action name="on-tap" command="onTap" />
  </Actions>
  <Page id="message-ai-message-action-bar-root">
