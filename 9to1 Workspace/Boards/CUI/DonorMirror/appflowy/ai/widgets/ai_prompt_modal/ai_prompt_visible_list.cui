<Cui id="ai-prompt-modal-ai-prompt-visible-list" product="9-1" version="1">
  <Actions>
    <Action name="()-=&gt;-context-.read&lt;ai-prompt-selector-cubit&gt;()-.filter-text-controller-.clear" command="() =&gt; context
                        .read&lt;AiPromptSelectorCubit&gt;()
                        .filterTextController
                        .clear" />
    <Action name="()-{-cubit.select-prompt(widget.prompt.id);-}" command="() {
              cubit.selectPrompt(widget.prompt.id);
            }" />
    <Action name="(-)-{-set-state(()-{-is-hovering-=-false;-timer?.cancel();-});-}" command="(_) {
            setState(() {
              isHovering = false;
              timer?.cancel();
            });
          }" />
    <Action name="(-)-{-set-state(()-{-is-hovering-=-true;-timer-=-timer(const-duration(milliseconds:-300),-()-{-if-(mounted)-{-cubit.select-prompt(widget.prompt.id);-}-});-});-}" command="(_) {
            setState(() {
              isHovering = true;
              timer = Timer(const Duration(milliseconds: 300), () {
                if (mounted) {
                  cubit.selectPrompt(widget.prompt.id);
                }
              });
            });
          }" />
  </Actions>
  <Page id="ai-prompt-modal-ai-prompt-visible-list-root">
    <Container id="column" Type="Vertical Stack">
      <Container id="shrink" Type="Vertical Stack" />
