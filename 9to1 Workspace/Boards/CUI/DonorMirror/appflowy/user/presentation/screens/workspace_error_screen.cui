<Cui id="screens-workspace-error-screen" product="9-1" version="1">
  <Actions>
    <Action name="()-async-{-context.read&lt;workspace-error-bloc&gt;().add(-const-workspace-error-event.logout(),-);-}" command="() async {
          context.read&lt;WorkspaceErrorBloc&gt;().add(
                const WorkspaceErrorEvent.logout(),
              );
        }" />
  </Actions>
  <Page id="screens-workspace-error-screen-root">
    <Page id="scaffold">
      <Container id="bloc-provider" Type="Vertical Stack">
        <Container id="bloc-builder" Type="Vertical Stack">
          <Container id="vspace" Type="Vertical Stack" />
          <Container id="vspace-2" Type="Vertical Stack" />
          <Container id="center" Type="Vertical Stack">
            <Container id="sized-box" Type="Vertical Stack" width="500">
              <Container id="intrinsic-height" Type="Vertical Stack">
                <Container id="column" Type="Vertical Stack" />
              </Container>
            </Container>
          </Container>
        </Container>
      </Container>
    </Page>
    <Container id="bloc-builder-2" Type="Vertical Stack">
      <Container id="column-2" Type="Vertical Stack" />
    </Container>
    <Container id="sized-box-2" Type="Vertical Stack" width="200" height="40">
      <Button id="flowy-button" Type="Action" action="()-async-{-context.read&lt;workspace-error-bloc&gt;().add(-const-workspace-error-event.logout(),-);-}" />
    </Container>
  </Page>
</Cui>
