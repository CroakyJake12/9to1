<Cui id="screens-skip-log-in-screen" product="9-1" version="1">
  <Actions>
    <Action name="()-{-if-(current-locale-!=-locale)-{-context.read&lt;appearance-settings-cubit&gt;().set-locale(context,-locale);-}-popover-container.of(context).close();-}" command="() {
          if (currentLocale != locale) {
            context.read&lt;AppearanceSettingsCubit&gt;().setLocale(context, locale);
          }
          PopoverContainer.of(context).close();
        }" />
    <Action name="()-{-if-(state.anon-users.is-not-empty)-{-final-bloc-=-context.read&lt;anon-user-bloc&gt;();-final-historical-user-=-state.anon-users.first;-bloc.add(-anon-user-event.open-anon-user(historical-user),-);-}-else-{-on-pressed();-}-}" command="() {
                  if (state.anonUsers.isNotEmpty) {
                    final bloc = context.read&lt;AnonUserBloc&gt;();
                    final historicalUser = state.anonUsers.first;
                    bloc.add(
                      AnonUserEvent.openAnonUser(historicalUser),
                    );
                  } else {
                    onPressed();
                  }
                }" />
  </Actions>
  <Page id="screens-skip-log-in-screen-root">
    <Page id="scaffold">
      <Container id="center" Type="Vertical Stack" />
    </Page>
    <Container id="column" Type="Vertical Stack">
