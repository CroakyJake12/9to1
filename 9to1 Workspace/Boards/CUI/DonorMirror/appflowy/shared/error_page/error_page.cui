<Cui id="error-page-error-page" product="9-1" version="1">
  <Actions>
    <Action name="()-=&gt;-get-it&lt;clipboard-service&gt;().set-data(-clipboard-service-data(plain-text:-stack-trace),-)" command="() =&gt; getIt&lt;ClipboardService&gt;().setData(
                    ClipboardServiceData(plainText: stackTrace),
                  )" />
    <Action name="()-async-{-await-af-launch-uri(-git-hub-new-bug-uri);-}" command="() async {
        await afLaunchUri(_gitHubNewBugUri);
      }" />
  </Actions>
  <Page id="error-page-error-page-root">
    <Container id="padding" Type="Vertical Stack" padding="8.0">
      <Container id="column" Type="Vertical Stack">
        <Container id="sized-box" Type="Vertical Stack" />
        <Container id="snack-bar" Type="Floating">
          <Text id="flowy-text" text="Message copied to clipboard" />
        </Container>
        <Container id="flowy-tooltip" Type="Floating">
          <Container id="padding-2" Type="Vertical Stack" padding="4" />
        </Container>
        <Container id="sized-box-2" Type="Vertical Stack" />
        <Container id="sized-box-3" Type="Vertical Stack" />
        <Container id="sized-box-4" Type="Vertical Stack" />
        <Container id="row" Type="Horizontal Stack" />
      </Container>
    </Container>
    <Container id="card" Type="Vertical Stack">
      <Container id="padding-3" Type="Vertical Stack" padding="8.0">
        <Container id="column-2" Type="Vertical Stack">
          <Container id="align" Type="Vertical Stack" />
          <Container id="container" Type="Vertical Stack" height="120" padding="8">
            <Container id="single-child-scroll-view" Type="Vertical Stack">
              <Text id="text" />
            </Container>
          </Container>
          <Container id="align-2" Type="Vertical Stack">
            <Button id="flowy-button" Type="Action" action="()-=&gt;-get-it&lt;clipboard-service&gt;().set-data(-clipboard-service-data(plain-text:-stack-trace),-)">
              <Text id="flowy-text-2" text="Copy" />
            </Button>
          </Container>
        </Container>
      </Container>
    </Container>
    <Button id="flowy-button-2" Type="Action" action="()-async-{-await-af-launch-uri(-git-hub-new-bug-uri);-}">
      <Text id="flowy-text-3" />
      <Container id="padding-4" Type="Vertical Stack" padding="4.0">
        <Image id="flowy-svg" />
      </Container>
    </Button>
  </Page>
</Cui>
