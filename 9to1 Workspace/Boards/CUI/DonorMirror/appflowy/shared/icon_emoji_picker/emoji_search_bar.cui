<Cui id="icon-emoji-picker-emoji-search-bar" product="9-1" version="1">
  <Actions>
    <Action name="()-{-final-random-=-emoji-data.random;-final-emoji-id-=-random.$1;-final-emoji-=-emoji-data.get-emoji-by-id(-emoji-id,-skin-tone:-skin-tone,-);-on-random-emoji-selected(-emoji-id,-emoji,-);-}" command="() {
            final random = emojiData.random;
            final emojiId = random.$1;
            final emoji = emojiData.getEmojiById(
              emojiId,
              skinTone: skinTone,
            );
            onRandomEmojiSelected(
              emojiId,
              emoji,
            );
          }" />
    <Action name="()-{-if-(controller.text.is-not-empty)-{-controller.clear();-widget.on-keyword-changed('');-}-else-{-focus-node.unfocus();-}-}" command="() {
              if (controller.text.isNotEmpty) {
                controller.clear();
                widget.onKeywordChanged('');
              } else {
                focusNode.unfocus();
              }
            }" />
    <Action name="widget.on-keyword-changed" command="widget.onKeywordChanged" />
  </Actions>
  <Page id="icon-emoji-picker-emoji-search-bar-root">
    <Container id="padding" Type="Vertical Stack" padding="12.0 0.0 8.0">
      <Container id="row" Type="Horizontal Stack">
        <Container id="expanded" Type="Vertical Stack" />
        <Container id="hspace" Type="Horizontal Stack" />
        <Container id="hspace-2" Type="Horizontal Stack" />
      </Container>
    </Container>
    <Container id="container" Type="Vertical Stack" width="36" height="36" CornerRadius="8">
      <Container id="flowy-tooltip" Type="Floating">
        <Button id="flowy-button" Type="Action" action="()-{-final-random-=-emoji-data.random;-final-emoji-id-=-random.$1;-final-emoji-=-emoji-data.get-emoji-by-id(-emoji-id,-skin-tone:-skin-tone,-);-on-random-emoji-selected(-emoji-id,-emoji,-);-}">
          <Image id="flowy-svg" />
        </Button>
      </Container>
    </Container>
    <Container id="sized-box" Type="Vertical Stack" height="36.0">
      <Input id="flowy-text-field" Type="Text">
        <Container id="padding-2" Type="Vertical Stack" padding="14.0 8.0">
          <Image id="flowy-svg-2" />
        </Container>
        <Container id="padding-3" Type="Vertical Stack" padding="4.0">
          <Button id="flowy-button-2" Type="Action" action="()-{-if-(controller.text.is-not-empty)-{-controller.clear();-widget.on-keyword-changed('');-}-else-{-focus-node.unfocus();-}-}">
            <Image id="flowy-svg-3" />
          </Button>
        </Container>
      </Input>
    </Container>
  </Page>
</Cui>
