<Cui id="icon-emoji-picker-icon-search-bar" product="9-1" version="1">
  <Actions>
    <Action name="()-{-if-(controller.text.is-not-empty)-{-controller.clear();-widget.on-keyword-changed('');-}-else-{-focus-node.unfocus();-}-}" command="() {
              if (controller.text.isNotEmpty) {
                controller.clear();
                widget.onKeywordChanged('');
              } else {
                focusNode.unfocus();
              }
            }" />
    <Action name="on-random-tap" command="onRandomTap" />
    <Action name="widget.on-keyword-changed" command="widget.onKeywordChanged" />
