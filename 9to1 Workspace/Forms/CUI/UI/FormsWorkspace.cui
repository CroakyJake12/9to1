<Cui id="9to1.Forms.Workspace" version="1">
  <Grid rows="Auto,*,Auto" accessible-name="Forms builder">
    <StackPanel orientation="Horizontal" spacing="8">
      <TextBox text="{Binding Title, Mode=TwoWay}" is-enabled="{Binding CanCreate}" accessible-name="New form title" />
      <Button action="9to1.Forms.Create" is-enabled="{Binding CanCreate}" content="Create form" />
      <Button action="9to1.Forms.Open" is-enabled="{Binding CanOpen}" content="Open selected form" />
      <Button action="9to1.Forms.Preview" is-enabled="{Binding CanPreview}" content="{Binding PreviewLabel}" />
      <Button action="9to1.Forms.Publish" is-enabled="{Binding CanPublish}" content="Publish version" />
      <Button action="9to1.Forms.Close" is-enabled="{Binding CanClose}" content="Close responses" />
    </StackPanel>
    <Grid grid-row="1" columns="Auto,*,*" margin="16">
      <StackPanel spacing="8" accessible-name="Field palette">
        <Button action="9to1.Forms.AddText" is-enabled="{Binding CanAdd}" content="Add text question" />
        <Button action="9to1.Forms.AddNumber" is-enabled="{Binding CanAdd}" content="Add number question" />
        <Button action="9to1.Forms.AddPage" is-enabled="{Binding CanAdd}" content="Add page" />
      </StackPanel>
      <StackPanel grid-column="1" spacing="8" accessible-name="Page structure">
        <TextBlock text="{Binding Page}" />
        <TextBlock text="{Binding Contents}" />
        <ComboBox ItemsSource="{Binding PageNames}" SelectedIndex="{Binding SelectedPageIndex, mode=TwoWay, type=int}" is-enabled="{Binding CanSelectPage}" accessible-name="Select page" />
        <ComboBox ItemsSource="{Binding FieldNames}" SelectedIndex="{Binding SelectedFieldIndex, mode=TwoWay, type=int}" is-enabled="{Binding CanSelectField}" accessible-name="Select field" />
        <Button action="9to1.Forms.MoveToPage" is-enabled="{Binding CanEdit}" content="Move selected field to this page" />
      </StackPanel>
      <StackPanel grid-column="2" spacing="8" accessible-name="Field inspector">
        <TextBlock text="{Binding Field}" />
        <TextBlock text="{Binding FieldType}" />
        <TextBox text="{Binding Label, Mode=TwoWay}" is-enabled="{Binding CanEdit}" accessible-name="Question label" />
        <TextBox text="{Binding Help, Mode=TwoWay}" is-enabled="{Binding CanEdit}" accessible-name="Question help" />
        <Button action="9to1.Forms.SaveField" is-enabled="{Binding CanEdit}" content="Save question" />
        <TextBlock text="{Binding Required}" />
        <Button action="9to1.Forms.ToggleRequired" is-enabled="{Binding CanEdit}" content="Toggle required answer" />
      </StackPanel>
    </Grid>
    <TextBlock grid-row="2" text="{Binding Status}" accessible-name="Forms operation status" />
  </Grid>
</Cui>
