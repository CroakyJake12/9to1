<Cui id="9to1.Forms.Workspace" version="1">
  <Page>
    <Container accessible-name="Forms builder" Type="Grid" RowSizes="Auto 1fr Auto">
      <Container Type="Horizontal Stack" CellGap="8">
        <Input accessible-name="New form title" Type="Text" Value="{Binding Title, Mode=TwoWay}" Interactive="{Binding CanCreate}" />
        <Button action="9to1.Forms.Create" content="Create form" Interactive="{Binding CanCreate}" />
        <Button action="9to1.Forms.Open" content="Open selected form" Interactive="{Binding CanOpen}" />
        <Button action="9to1.Forms.Preview" content="{Binding PreviewLabel}" Interactive="{Binding CanPreview}" />
        <Button action="9to1.Forms.NewResponse" content="Start another response" Interactive="{Binding CanNewResponse}" />
        <Button action="9to1.Forms.Respond" content="Open my response" Interactive="{Binding CanRespond}" />
        <Button action="9to1.Forms.Publish" content="Publish version" Interactive="{Binding CanPublish}" />
        <Button action="9to1.Forms.Close" content="Close responses" Interactive="{Binding CanClose}" />
      </Container>
      <Container margin="16" Type="Grid" Row="1" ColumnSizes="Auto 1fr 1fr">
        <Container accessible-name="Field palette" Type="Vertical Stack" CellGap="8">
          <Input ItemsSource="{Binding PaletteNames}" SelectedIndex="{Binding SelectedPaletteIndex, mode=TwoWay, type=int}" accessible-name="Field type" Type="Select" Interactive="{Binding CanAddField}" />
          <Button action="9to1.Forms.AddField" content="Add field" Interactive="{Binding CanAddField}" />
          <Button action="9to1.Forms.AddPage" content="Add page" Interactive="{Binding CanAdd}" />
        </Container>
        <Container accessible-name="Page structure" Type="Vertical Stack" Column="1" CellGap="8">
          <Text text="{Binding Page}" />
          <Text text="{Binding Contents}" />
          <Input ItemsSource="{Binding PageNames}" SelectedIndex="{Binding SelectedPageIndex, mode=TwoWay, type=int}" accessible-name="Select page" Type="Select" Interactive="{Binding CanSelectPage}" />
          <Input ItemsSource="{Binding FieldNames}" SelectedIndex="{Binding SelectedFieldIndex, mode=TwoWay, type=int}" accessible-name="Select field" Type="Select" Interactive="{Binding CanSelectField}" />
          <Button action="9to1.Forms.MoveEarlier" content="Move field earlier" Interactive="{Binding CanMoveEarlier}" />
          <Button action="9to1.Forms.MoveLater" content="Move field later" Interactive="{Binding CanMoveLater}" />
          <Button action="9to1.Forms.MoveToPage" content="Move selected field to this page" Interactive="{Binding CanEdit}" />
        </Container>
        <Container accessible-name="Field inspector" Type="Overlay" Column="2" VerticalScrolling="True" HorizontalScrolling="False">
          <Container Type="Vertical Stack" CellGap="8">
            <Text text="{Binding Field}" />
            <Text text="{Binding FieldType}" />
            <Input accessible-name="Question label" Type="Text" Value="{Binding Label, Mode=TwoWay}" Interactive="{Binding CanEdit}" />
            <Input accessible-name="Question help" Type="Text" Value="{Binding Help, Mode=TwoWay}" Interactive="{Binding CanEdit}" />
            <Button action="9to1.Forms.SaveField" content="Save question" Interactive="{Binding CanEdit}" />
            <Input ItemsSource="{Binding OptionNames}" SelectedIndex="{Binding SelectedOptionIndex, mode=TwoWay, type=int}" accessible-name="Choice option" Type="Select" Interactive="{Binding CanEditChoice}" />
            <Input accessible-name="Choice label" Type="Text" Value="{Binding OptionLabel, Mode=TwoWay}" Interactive="{Binding CanEditChoice}" />
            <Button action="9to1.Forms.UpdateChoice" content="Save choice label" Interactive="{Binding CanEditChoice}" />
            <Button action="9to1.Forms.AddChoice" content="Add choice" Interactive="{Binding CanAddChoice}" />
            <Input ItemsSource="{Binding ColumnNames}" SelectedIndex="{Binding SelectedColumnIndex, mode=TwoWay, type=int}" accessible-name="Table column" Type="Select" Interactive="{Binding CanEditColumn}" />
            <Text text="{Binding ColumnType}" />
            <Input accessible-name="Column label" Type="Text" Value="{Binding ColumnLabel, Mode=TwoWay}" Interactive="{Binding CanEditColumn}" />
            <Button action="9to1.Forms.SaveColumn" content="Save column label" Interactive="{Binding CanEditColumn}" />
            <Text text="{Binding ColumnRequired}" />
            <Button action="9to1.Forms.ToggleColumnRequired" content="Toggle required cell" Interactive="{Binding CanEditColumn}" />
            <Button action="9to1.Forms.RemoveColumn" content="Remove column" Interactive="{Binding CanRemoveColumn}" />
            <Input ItemsSource="{Binding ColumnTypeNames}" SelectedIndex="{Binding SelectedColumnTypeIndex, mode=TwoWay, type=int}" accessible-name="New column type" Type="Select" Interactive="{Binding CanAddColumn}" />
            <Button action="9to1.Forms.AddColumn" content="Add column" Interactive="{Binding CanAddColumn}" />
            <Input accessible-name="Minimum table rows" Type="Text" Value="{Binding MinimumRows, Mode=TwoWay}" Interactive="{Binding CanEditTableBounds}" />
            <Input accessible-name="Maximum table rows" Type="Text" Value="{Binding MaximumRows, Mode=TwoWay}" Interactive="{Binding CanEditTableBounds}" />
            <Button action="9to1.Forms.SaveTableBounds" content="Save row limits" Interactive="{Binding CanEditTableBounds}" />
            <Input ItemsSource="{Binding FixedRowNames}" SelectedIndex="{Binding SelectedFixedRowIndex, mode=TwoWay, type=int}" accessible-name="Fixed table row" Type="Select" Interactive="{Binding CanRemoveFixedRow}" />
            <Button action="9to1.Forms.AddFixedRow" content="Add fixed row" Interactive="{Binding CanAddFixedRow}" />
            <Button action="9to1.Forms.RemoveFixedRow" content="Remove selected fixed row" Interactive="{Binding CanRemoveFixedRow}" />
            <Text text="{Binding AddedRows}" />
            <Button action="9to1.Forms.ToggleAddedRows" content="Toggle respondent-added rows" Interactive="{Binding CanToggleAddedRows}" />
            <Button action="9to1.Forms.DiscardInspector" content="Discard unsaved inspector edits" Interactive="{Binding CanDiscard}" />
            <Container accessible-name="Regex tester" Type="Vertical Stack" CellGap="6">
              <Text text="Test a pattern without changing the question" />
              <Input accessible-name="Regex test pattern" Type="Text" Value="{Binding RegexPattern, Mode=TwoWay}" Interactive="{Binding CanTestRegex}" />
              <Input accessible-name="Regex example input" Type="Text" Value="{Binding RegexExample, Mode=TwoWay}" Interactive="{Binding CanTestRegex}" />
              <Input ItemsSource="{Binding RegexMatchModes}" SelectedIndex="{Binding RegexMatchMode, mode=TwoWay, type=int}" accessible-name="Full or partial regex match" Type="Select" Interactive="{Binding CanTestRegex}" />
              <Input ItemsSource="{Binding RegexCaseModes}" SelectedIndex="{Binding RegexCaseMode, mode=TwoWay, type=int}" accessible-name="Regex case matching" Type="Select" Interactive="{Binding CanTestRegex}" />
              <Text text="{Binding RegexResult}" accessible-name="Regex test result" />
            </Container>
            <Text text="{Binding Required}" />
            <Button action="9to1.Forms.ToggleRequired" content="Toggle required answer" Interactive="{Binding CanEdit}" />
          </Container>
        </Container>
      </Container>
      <Text text="{Binding Status}" accessible-name="Forms operation status" Row="2" />
    </Container>
  </Page>
</Cui>
