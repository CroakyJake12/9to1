<Cui id="ui-tocindexpage" product="9-1" version="1">
  <Page id="ui-tocindexpage-root">
    <Container id="filemenu" Type="Menu" focusable="false">
      <Button id="open" Type="Menu Item" content="Open" text="Open" focusable="false" />
      <Button id="new" Type="Menu Item" content="New..." text="New..." focusable="false" />
      <Button id="edit" Type="Menu Item" content="Edit..." text="Edit..." focusable="false" />
    </Container>
    <Container id="toc-index-page" Type="Grid" focusable="false" role="Grow">
      <Container id="container" Type="Grid" cell-gap="12" vertical-alignment="Top" focusable="false" role="Grow" column="0" row="0">
        <Container id="formatframe" Type="Vertical Stack" focusable="false" role="Grow" column="0" row="0">
          <Container id="grid6" Type="Grid" cell-gap="6" focusable="false" role="Grow">
            <Input id="usetitle" Type="Checkbox" text="Title:" checked="true" column="0" row="0" />
            <Input id="title" Type="Text" role="Grow" column="1" row="0" />
            <Text id="typeft" text="Type:" focusable="false" column="0" row="1" />
            <Input id="type" Type="Select" horizontal-alignment="Left" focusable="false" column="1" row="1" />
            <Input id="readonly" Type="Checkbox" text="Protected against manual changes" checked="true" column="0" row="2" column-span="2" />
          </Container>
          <Text id="label3" text="Type and Title" focusable="false" />
        </Container>
        <Container id="areaframe" Type="Vertical Stack" focusable="false" role="Grow" column="0" row="1">
          <Container id="grid3" Type="Grid" cell-gap="12" focusable="false">
            <Text id="mainstyleft2" text="For:" focusable="false" column="0" row="0" />
            <Input id="scope" Type="Select" focusable="false" column="1" row="0" />
          </Container>
          <Text id="label1" text="Scope" focusable="false" />
        </Container>
        <Container id="createframe" Type="Vertical Stack" focusable="false" role="Grow" column="0" row="2">
          <Container id="grid2" Type="Grid" cell-gap="6" focusable="false" role="Grow">
            <Container id="grid10" Type="Grid" cell-gap="6" focusable="false" column="0" row="0">
              <Input id="fromheadings" Type="Checkbox" text="Headings" tooltip="Creates the index from all paragraphs that have an outline level equal to or greater than “1”." checked="true" column="0" row="0" />
              <Container id="box1" Type="Vertical Stack" cell-gap="12" vertical-alignment="Center" focusable="false" column="0" row="1">
                <Container id="box2" Type="Vertical Stack" vertical-alignment="Center" focusable="false">
                  <Input id="addstylescb" Type="Checkbox" text="Additional styles" tooltip="Include selected paragraph styles in the index. Click the “Assign Styles” button." />
                  <Input id="stylescb" Type="Checkbox" text="Styles" />
                </Container>
                <Button id="styles" content="Assign styles..." text="Assign styles..." horizontal-alignment="Left" vertical-alignment="Center" />
              </Container>
              <Input id="fromtables" Type="Checkbox" text="Tables" column="1" row="1" />
              <Input id="fromframes" Type="Checkbox" text="Text frames" column="2" row="1" />
              <Input id="indexmarks" Type="Checkbox" text="Index entries" tooltip="Choose this option to include any index entries inserted in the document for the selected index “Type”." checked="true" column="0" row="2" />
              <Input id="fromgraphics" Type="Checkbox" text="Graphics" column="1" row="2" />
              <Input id="fromoles" Type="Checkbox" text="OLE objects" column="2" row="2" />
              <Input id="uselevel" Type="Checkbox" text="Use outline level" tooltip="Assign index level according to the outline level of the heading immediately prior to the object." column="1" row="3" column-span="2" />
            </Container>
            <Container id="grid13" Type="Grid" cell-gap="6" focusable="false" role="Grow" column="0" row="1">
              <Input id="captions" Type="Radio" text="Captions" column="0" row="0" />
              <Input id="objnames" Type="Radio" text="Object names" checked="true" column="1" row="0" />
              <Container id="grid12" Type="Grid" cell-gap="6" focusable="false" column="0" row="1" column-span="2">
                <Text id="categoryft" text="Category:" focusable="false" column="0" row="0" />
                <Input id="category" Type="Select" focusable="false" column="1" row="0" />
                <Text id="displayft" text="Display:" focusable="false" column="0" row="1" />
                <Input id="display" Type="Select" focusable="false" column="1" row="1" />
              </Container>
            </Container>
            <Container id="objectbox" Type="Vertical Stack" focusable="false" role="Grow" column="0" row="2">
              <Container id="objectwin" Type="Vertical Stack" role="Grow">
                <Container id="objects" Type="Vertical Stack" role="Grow" />
              </Container>
            </Container>
            <Container id="grid4" Type="Grid" cell-gap="12" focusable="false" column="0" row="3">
              <Text id="levelft" text="Include up to level:" focusable="false" column="0" row="0" />
              <Input id="level" Type="Number" tooltip="Enter the number of outline levels to include in the index." column="1" row="0" />
            </Container>
          </Container>
          <Text id="createfrom" text="Create %s From" focusable="false" />
        </Container>
        <Container id="grid14" Type="Grid" cell-gap="6" focusable="false" role="Grow" column="0" row="4">
          <Input id="useparastyle" Type="Checkbox" text="Create from additional paragraph style" checked="true" column="0" row="0" />
          <Input id="parastyle" Type="Select" focusable="false" role="Grow" column="1" row="0" />
        </Container>
        <Container id="authframe" Type="Vertical Stack" focusable="false" role="Grow" column="0" row="5">
          <Container id="grid11" Type="Grid" cell-gap="6" focusable="false" role="Grow">
            <Text id="mainstyleft9" text="Brackets:" focusable="false" column="0" row="1" />
            <Input id="numberentries" Type="Checkbox" text="Number entries" column="0" row="0" column-span="2" />
            <Input id="brackets" Type="Select" horizontal-alignment="Left" focusable="false" column="1" row="1" />
          </Container>
          <Text id="label7" text="Formatting of the Entries" focusable="false" />
        </Container>
        <Container id="alphapane" Type="Vertical Stack" cell-gap="12" focusable="false" column="0" row="6">
          <Container id="optionsframe" Type="Vertical Stack" focusable="false" role="Grow">
            <Container id="grid9" Type="Grid" cell-gap="6" focusable="false" role="Grow">
              <Input id="combinesame" Type="Checkbox" text="Combine identical entries" column="0" row="0" />
              <Input id="useff" Type="Checkbox" text="Combine identical entries with f. or ff." column="0" row="1" />
              <Input id="usedash" Type="Checkbox" text="Combine with -" column="0" row="2" />
              <Input id="casesens" Type="Checkbox" text="Case sensitive" column="0" row="3" />
              <Input id="initcaps" Type="Checkbox" text="AutoCapitalize entries" column="1" row="0" />
              <Input id="keyasentry" Type="Checkbox" text="Keys as separate entries" column="1" row="1" />
              <Input id="fromfile" Type="Checkbox" text="Concordance file" column="1" row="2" />
              <Button id="file" content="File" text="File" horizontal-alignment="Left" column="1" row="3" />
            </Container>
            <Text id="label5" text="Options" focusable="false" />
          </Container>
          <Container id="sortframe" Type="Vertical Stack" focusable="false" role="Grow">
            <Container id="grid5" Type="Grid" cell-gap="18" focusable="false" role="Grow">
              <Container id="grid7" Type="Grid" cell-gap="12" focusable="false" column="0" row="0">
                <Text id="mainstyleft3" text="Language:" focusable="false" column="0" row="0" />
                <Input id="lang" Type="Select" focusable="false" column="1" row="0" />
              </Container>
              <Container id="grid8" Type="Grid" cell-gap="12" focusable="false" column="1" row="0">
                <Text id="mainstyleft5" text="Key type:" focusable="false" column="0" row="0" />
                <Input id="keytype" Type="Select" focusable="false" column="1" row="0" />
              </Container>
            </Container>
            <Text id="label4" text="Sort" focusable="false" />
          </Container>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
