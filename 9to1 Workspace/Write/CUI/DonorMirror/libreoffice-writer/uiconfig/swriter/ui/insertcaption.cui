<Cui id="ui-insertcaption" product="9-1" version="1">
  <Container id="insert-caption-dialog" Type="Vertical Stack" modal="True" focusable="false">
    <Text id="insert-caption-dialog-label" text="Insert Caption" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12" focusable="false">
      <Container id="dialog-action-area1" Type="Horizontal Stack" focusable="false">
        <Button id="auto" content="Auto..." text="Auto..." />
        <Button id="options" content="Options..." text="Options..." />
        <Button id="ok" content="OK" text="OK" />
        <Button id="cancel" content="Cancel" text="Cancel" />
        <Button id="help" content="Help" text="Help" />
      </Container>
      <Container id="box1" Type="Vertical Stack" cell-gap="12" focusable="false" role="Grow">
        <Container id="frame1" Type="Vertical Stack" focusable="false" role="Grow">
          <Input id="caption-edit" Type="Text" role="Grow" />
          <Text id="label1" text="Caption" focusable="false" />
        </Container>
        <Container id="frame2" Type="Vertical Stack" focusable="false" role="Grow">
          <Container id="grid1" Type="Grid" cell-gap="6" focusable="false" role="Grow">
            <Text id="numbering-label" text="Numbering:" horizontal-alignment="Left" focusable="false" column="0" row="1" />
            <Text id="separator-label" text="Before caption:" horizontal-alignment="Left" focusable="false" column="0" row="3" />
            <Text id="position-label" text="Position:" horizontal-alignment="Left" focusable="false" column="0" row="4" />
            <Input id="numbering" Type="Select" focusable="false" role="Grow" column="1" row="1" />
            <Input id="separator-edit" Type="Text" text=":" tooltip="Enter optional text characters to appear after the caption category and number and before the caption text." role="Grow" column="1" row="3" />
            <Text id="num-separator" text="After number:" horizontal-alignment="Left" focusable="false" column="0" row="2" />
            <Input id="num-separator-edit" Type="Text" text="." tooltip="When “Caption order” (in Options) is “Numbering first”, enter optional text to appear after caption number." role="Grow" column="1" row="2" />
            <Input id="position" Type="Select" focusable="false" role="Grow" column="1" row="4" />
            <Text id="label4" text="Category:" horizontal-alignment="Left" focusable="false" column="0" row="0" />
            <Input id="category" Type="Select" focusable="false" column="1" row="0">
              <Input id="comboboxtext-entry" Type="Text" />
            </Input>
          </Container>
          <Text id="label2" text="Properties" focusable="false" />
        </Container>
        <Container id="frame3" Type="Vertical Stack" focusable="false" role="Grow">
          <Container id="container" Type="Vertical Stack">
            <Container id="container-2" Type="Vertical Stack" focusable="false">
              <Container id="preview" Type="Overlay" focusable="false" />
            </Container>
          </Container>
          <Text id="label3" text="Preview" focusable="false" />
        </Container>
      </Container>
    </Container>
  </Container>
</Cui>
