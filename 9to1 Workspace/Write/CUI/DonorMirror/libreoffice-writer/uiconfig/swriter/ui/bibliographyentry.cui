<Cui id="ui-bibliographyentry" product="9-1" version="1">
  <Container id="bibliography-entry-dialog" Type="Vertical Stack" focusable="false">
    <Text id="bibliography-entry-dialog-label" text="Insert Citation" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12" focusable="false">
      <Container id="dialog-action-area1" Type="Horizontal Stack" focusable="false">
        <Button id="help" content="Help" text="Help" />
        <Button id="new" content="New" text="New" />
        <Button id="edit" content="Edit" text="Edit" />
        <Button id="close" content="Close" text="Close" />
        <Button id="insert" content="Insert" text="Insert" />
        <Button id="modify" content="Apply" text="Apply" />
      </Container>
      <Container id="frame1" Type="Vertical Stack" focusable="false">
        <Container id="grid1" Type="Grid" cell-gap="6" focusable="false">
          <Input id="frombibliography" Type="Radio" text="Bibliography Database" checked="true" column="0" row="0" />
          <Input id="fromdocument" Type="Radio" text="Document Content" column="0" row="1" />
        </Container>
        <Text id="label1" text="Bibliography Source" focusable="false" />
      </Container>
      <Container id="frame2" Type="Vertical Stack" focusable="false">
        <Container id="grid2" Type="Grid" cell-gap="6" focusable="false">
          <Text id="label2" text="Author" focusable="false" column="0" row="2" />
          <Text id="label3" text="Title" focusable="false" column="0" row="3" />
          <Text id="author" focusable="false" column="1" row="2" />
          <Text id="title" focusable="false" column="1" row="3" />
          <Input id="entrylb" Type="Select" focusable="false" column="1" row="0" />
          <Input id="entryed" Type="Text" column="1" row="1" />
          <Text id="label5" text="Short name" focusable="false" column="0" row="0" />
        </Container>
        <Text id="label4" text="Citation" focusable="false" />
      </Container>
    </Container>
  </Container>
</Cui>
