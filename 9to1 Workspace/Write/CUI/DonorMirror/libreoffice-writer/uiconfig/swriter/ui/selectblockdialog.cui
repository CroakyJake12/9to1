<Cui id="ui-selectblockdialog" product="9-1" version="1">
  <Container id="select-block-dialog" Type="Vertical Stack" modal="True">
    <Text id="select-block-dialog-label" text="Select Address Block" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12">
      <Container id="dialog-action-area1" Type="Horizontal Stack">
        <Button id="ok" content="OK" text="OK" />
        <Button id="cancel" content="Cancel" text="Cancel" />
        <Button id="help" content="Help" text="Help" />
      </Container>
      <Container id="grid1" Type="Grid" role="Grow">
        <Container id="buttonbox2" Type="Horizontal Stack" cell-gap="6" row-span="2">
          <Button id="new" content="New..." text="New..." />
          <Button id="edit" content="Edit..." text="Edit..." />
          <Button id="delete" content="Delete" text="Delete" />
        </Container>
        <Text id="label1" text="Select your preferred address block" column-span="2" />
        <Container id="frame1" Type="Vertical Stack">
          <Container id="grid2" Type="Grid">
            <Input id="never" Type="Radio" text="Never include the country/region" checked="true" />
            <Input id="always" Type="Radio" text="Always include the country/region" />
            <Input id="dependent" Type="Radio" text="Only include the country/region if it is not:" />
            <Input id="country" Type="Text" role="Grow" />
          </Container>
          <Text id="label2" text="Address Block Settings" />
        </Container>
        <Container id="previewwin" Type="Vertical Stack" role="Grow">
          <Container id="container" Type="Vertical Stack">
            <Container id="preview" Type="Overlay" role="Grow" />
          </Container>
        </Container>
      </Container>
    </Container>
  </Container>
</Cui>
