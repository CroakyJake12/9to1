<Cui id="ui-mergetabledialog" product="9-1" version="1">
  <Container id="merge-table-dialog" Type="Vertical Stack" modal="True">
    <Text id="merge-table-dialog-label" text="Merge Tables" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12">
      <Container id="dialog-action-area1" Type="Horizontal Stack">
        <Button id="ok" content="OK" text="OK" />
        <Button id="cancel" content="Cancel" text="Cancel" />
        <Button id="help" content="Help" text="Help" />
      </Container>
      <Container id="frame1" Type="Vertical Stack" role="Grow">
        <Container id="grid1" Type="Grid">
          <Input id="prev" Type="Radio" text="Join with previous table" checked="true" />
          <Input id="next" Type="Radio" text="Join with next table" />
