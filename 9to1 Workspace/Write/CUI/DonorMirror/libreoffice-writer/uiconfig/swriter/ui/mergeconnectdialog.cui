          <Input id="new" Type="Radio" text="Create new connection" column="0" row="1" />
          <Text id="label2" text="Fields are used to personalize form letters. The fields are placeholders for data from a data source, such as a database. The fields in the form letter must be connected to the data source." text-wrapping="Wrap" focusable="false" column="0" row="2" />
        </Container>
        <Text id="label1" text="Connect" focusable="false" />
      </Container>
