<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PlatformTarget">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">WinExe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">../shared/src/Haven.Desktop/Assets/haven.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">../shared/src/Haven.Desktop/app.manifest</ApplicationManifest>
    <RootNamespace>HavenOS.Apps.Write</RootNamespace>
    <AssemblyName>HavenOS.Write</AssemblyName>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <DefaultItemExcludes>$(DefaultItemExcludes);Source/**;write-libreoffice-poc/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../shared/src/Haven.Application/Haven.Application.csproj" />
    <ProjectReference Include="../shared/src/Haven.Desktop/Haven.Desktop.csproj"
                      SetTargetFramework="TargetFramework=$(TargetFramework)"
                      AdditionalProperties="ProductInitialApp=write;ProductDisplayName=Write;ProductWindowsAppId=9to1.Write" />
    <ProjectReference Include="../shared/src/Haven.Infrastructure/Haven.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <!-- This descriptor is already compiled into the referenced Haven assembly. -->
    <Compile Remove="WriteAppSurface.cs;Tests/**/*.cs" />
  </ItemGroup>
</Project>
