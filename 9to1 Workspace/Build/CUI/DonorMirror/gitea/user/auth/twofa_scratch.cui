<Cui id="auth-twofa-scratch" product="9-1" version="1">
  <Page id="auth-twofa-scratch-root">
    <Container id="div" Type="Vertical Stack" role="main">
      <Container id="div-2" Type="Vertical Stack">
        <Container id="div-3" Type="Vertical Stack">
          <Container id="form" Type="Vertical Stack">
            <Text id="h3" text="{Binding Unresolved}" />
            <Container id="div-4" Type="Vertical Stack">
              <Container id="div-5" Type="Vertical Stack">
                <Text id="label" text="{Binding Unresolved}" />
                <Input id="input" Type="Text" />
              </Container>
              <Container id="div-6" Type="Vertical Stack">
                <Button id="button" />
              </Container>
            </Container>
          </Container>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
