<Cui id="auth-signin-openid" product="9-1" version="1">
  <Page id="auth-signin-openid-root">
    <Container id="div" Type="Vertical Stack" role="main" accessible-name="{Binding Unresolved}">
      <Container id="div-2" Type="Vertical Stack">
        <Container id="div-3" Type="Vertical Stack">
          <Button id="a">
            <Image id="img" />
          </Button>
          <Container id="div-4" Type="Vertical Stack">
            <Text id="h4" text="[value]
					OpenID" />
            <Container id="div-5" Type="Vertical Stack">
              <Container id="form" Type="Vertical Stack">
                <Container id="div-6" Type="Vertical Stack" />
                <Container id="div-7" Type="Vertical Stack">
                  <Text id="label" text="[value]
							OpenID URI" />
                  <Input id="input" Type="Text" />
                </Container>
                <Container id="div-8" Type="Vertical Stack">
                  <Container id="div-9" Type="Vertical Stack">
                    <Text id="label-2" text="{Binding Unresolved}" />
                    <Input id="input-2" Type="Text" />
                  </Container>
                </Container>
                <Container id="div-10" Type="Vertical Stack">
                  <Button id="button" />
                </Container>
              </Container>
            </Container>
          </Container>
          <Container id="div-11" Type="Vertical Stack">
            <Container id="div-12" Type="Vertical Stack">
              <Button id="a-2" />
            </Container>
          </Container>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
