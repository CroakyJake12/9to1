<Cui id="templates-home" product="9-1" version="1">
  <Page id="templates-home-root">
    <Container id="div" Type="Vertical Stack" role="main" accessible-name="[value][value]">
      <Container id="div-2" Type="Vertical Stack">
        <Container id="div-3" Type="Vertical Stack">
          <Image id="img" />
          <Container id="div-4" Type="Vertical Stack">
            <Text id="h1" text="{Binding Unresolved}" />
            <Text id="h2" text="{Binding Unresolved}" />
          </Container>
        </Container>
      </Container>
      <Container id="div-5" Type="Vertical Stack">
        <Container id="div-6" Type="Vertical Stack">
          <Text id="h1-2" text="[value] [value]" />
          <Text id="p" text="{Binding Unresolved}" />
        </Container>
        <Container id="div-7" Type="Vertical Stack">
          <Text id="h1-3" text="[value] [value]" />
          <Text id="p-2" text="{Binding Unresolved}" />
        </Container>
      </Container>
      <Container id="div-8" Type="Vertical Stack">
        <Container id="div-9" Type="Vertical Stack">
          <Text id="h1-4" text="[value] [value]" />
          <Text id="p-3" text="{Binding Unresolved}" />
        </Container>
        <Container id="div-10" Type="Vertical Stack">
          <Text id="h1-5" text="[value] [value]" />
          <Text id="p-4" text="{Binding Unresolved}" />
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
