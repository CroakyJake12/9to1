<Cui id="spaces.details" version="1">
  <Theme Name="user_preference">
    <Page id="space-details-editor" role="main" accessible-name="Space details">
      <Container Type="Vertical Stack" Padding="24" CellGap="12" VerticalScrolling="True" HorizontalScrolling="False">
        <Text text="Space details" font-size="24" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
        <Text text="Give your Space a name, an icon and instructions." foreground="{Resource CuiTextSoftBrush}" />
        <Container Type="Vertical Stack" CellGap="8" Interactive="{Binding details.canEdit}">
          <Text text="Name" foreground="{Resource CuiTextBrush}" />
          <Input id="space-details-name" Type="Text" Value="{Binding details.name, mode=TwoWay}" accessible-name="Space name" />
          <Text text="Description" foreground="{Resource CuiTextBrush}" />
          <Input id="space-details-description" Type="Text" AcceptsReturn="True" Value="{Binding details.description, mode=TwoWay}" accessible-name="Space description" />
          <Text text="Icon" foreground="{Resource CuiTextBrush}" />
          <Input id="space-details-icon" Type="Text" Value="{Binding details.icon, mode=TwoWay}" placeholdertext="For example, book" accessible-name="Space icon" />
          <Text text="Custom instructions" foreground="{Resource CuiTextBrush}" />
          <Input id="space-details-instructions" Type="Text" AcceptsReturn="True" MinHeight="120" Value="{Binding details.instructions, mode=TwoWay}" accessible-name="Space custom instructions" />
        </Container>
        <Container Type="Wrap" CellGap="8">
          <Button id="space-details-save" content="Save" action="space-details.save" Interactive="{Binding details.canSave}" accessible-name="Save Space details" />
          <Button id="space-details-discard" content="Discard changes" action="space-details.discard" Interactive="{Binding details.canDiscard}" accessible-name="Discard unsaved details and reload" />
          <Button id="space-details-reload" content="Reload" action="space-details.reload" Interactive="{Binding details.canReload}" accessible-name="Reload saved Space details" />
        </Container>
        <Text id="space-details-status" text="{Binding details.status}" role="status" accessible-name="Space details status" foreground="{Resource CuiTextSoftBrush}" />
      </Container>
    </Page>
  </Theme>
</Cui>
