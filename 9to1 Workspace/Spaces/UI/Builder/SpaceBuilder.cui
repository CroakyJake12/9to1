<Cui id="spaces.builder" version="1">
  <Actions>
    <Action name="AttachBoardsSource" command="space-builder.source.attach" parameter="{Binding source.input}" />
    <Action name="RemoveContextSource" command="space-builder.source.remove" parameter="{Binding context.id}" />
    <Action name="RemoveLegacyFile" command="space-builder.legacy-file.remove" parameter="{Binding legacy.path}" />
    <Action name="RemoveCapability" command="space-builder.capability.remove" parameter="{Binding cap.key}" />
    <Action name="AttachSkill" command="space-builder.skill.attach" parameter="{Binding skill.id}" />
    <Action name="AttachPlugin" command="space-builder.plugin.attach" parameter="{Binding plugin.id}" />
  </Actions>
  <Theme Name="user_preference">
    <Page id="space-builder-editor" role="main" accessible-name="Space Builder">
      <Container Type="Vertical Stack" Padding="24" CellGap="12" VerticalScrolling="True" HorizontalScrolling="False">
        <Text text="Space Builder" font-size="24" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
        <Text text="Basic, Advanced and Expert editing for one Space and revision. Advanced and Expert are not yet implemented." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
        <Container Type="Vertical Stack" CellGap="8" Interactive="{Binding builder.canEdit}">
          <Text text="Name" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-name" Type="Text" Value="{Binding builder.name, mode=TwoWay}" accessible-name="Space name" />
          <Text text="Description" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-description" Type="Text" AcceptsReturn="True" Value="{Binding builder.description, mode=TwoWay}" accessible-name="Space description" />
          <Text text="Icon" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-icon" Type="Text" Value="{Binding builder.icon, mode=TwoWay}" placeholdertext="For example, book" accessible-name="Space icon" />
          <Text text="Custom instructions" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-instructions" Type="Text" AcceptsReturn="True" MinHeight="120" Value="{Binding builder.instructions, mode=TwoWay}" accessible-name="Space custom instructions" />
        </Container>
        <Container Type="Vertical Stack" CellGap="8" Interactive="{Binding builder.canEdit}">
          <Text text="Sources and privacy" font-size="18" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
          <Text text="Policies are checked before request dispatch; unavailable original owners block the request. Saving does not grant permission, retrieve source bodies or enable outside web access." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
          <Text text="Outside web access" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-web-access" Type="Select" ItemsSource="{Binding builder.context.webAccessOptions}" SelectedIndex="{Binding builder.context.webAccess, mode=TwoWay}" accessible-name="Outside web access policy" />
          <Container Type="Horizontal Stack" CellGap="8">
            <Input id="space-builder-source-only" Type="Switch" Checked="{Binding builder.context.sourceOnly, mode=TwoWay}" accessible-name="Use attached sources only" />
            <Text text="Use attached sources only" foreground="{Resource CuiTextBrush}" />
          </Container>
          <Container Type="Horizontal Stack" CellGap="8">
            <Input id="space-builder-include-selection" Type="Switch" Checked="{Binding builder.context.includeSelection, mode=TwoWay}" accessible-name="Include current selection as context" />
            <Text text="Include current selection as context" foreground="{Resource CuiTextBrush}" />
          </Container>
          <Text text="Inherit from parent Space" font-size="18" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
          <Text text="When this Space is nested, choose the parent settings and references to inherit. Explicit parent restrictions still apply. Canonical sources, packages and Agents keep their original owners." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
          <Container Type="Horizontal Stack" CellGap="8">
            <Input id="space-builder-inherit-sources" Type="Switch" Checked="{Binding builder.inherit.sources, mode=TwoWay}" accessible-name="Inherit sources and context policy" />
            <Text text="Sources and context policy" foreground="{Resource CuiTextBrush}" />
          </Container>
          <Container Type="Horizontal Stack" CellGap="8">
            <Input id="space-builder-inherit-apps" Type="Switch" Checked="{Binding builder.inherit.apps, mode=TwoWay}" accessible-name="Inherit connected apps" />
            <Text text="Connected apps" foreground="{Resource CuiTextBrush}" />
          </Container>
          <Container Type="Horizontal Stack" CellGap="8">
            <Input id="space-builder-inherit-models" Type="Switch" Checked="{Binding builder.inherit.models, mode=TwoWay}" accessible-name="Inherit model policy" />
            <Text text="Model policy" foreground="{Resource CuiTextBrush}" />
          </Container>
          <Container Type="Horizontal Stack" CellGap="8">
            <Input id="space-builder-inherit-memory" Type="Switch" Checked="{Binding builder.inherit.memory, mode=TwoWay}" accessible-name="Inherit memory policy" />
            <Text text="Memory policy" foreground="{Resource CuiTextBrush}" />
          </Container>
          <Container Type="Horizontal Stack" CellGap="8">
            <Input id="space-builder-inherit-plugins" Type="Switch" Checked="{Binding builder.inherit.plugins, mode=TwoWay}" accessible-name="Inherit plugins" />
            <Text text="Plugins" foreground="{Resource CuiTextBrush}" />
          </Container>
          <Container Type="Horizontal Stack" CellGap="8">
            <Input id="space-builder-inherit-skills" Type="Switch" Checked="{Binding builder.inherit.skills, mode=TwoWay}" accessible-name="Inherit skills" />
            <Text text="Skills" foreground="{Resource CuiTextBrush}" />
          </Container>
          <Container Type="Horizontal Stack" CellGap="8">
            <Input id="space-builder-inherit-agents" Type="Switch" Checked="{Binding builder.inherit.agents, mode=TwoWay}" accessible-name="Inherit agents" />
            <Text text="Agents" foreground="{Resource CuiTextBrush}" />
          </Container>
        </Container>
        <Container Type="Vertical Stack" CellGap="4">
          <Text text="Capability categories" font-size="18" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
          <Text text="Inherited / Enabled / Disabled. Disabled restricts; Enabled never grants permission beyond policy." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
        </Container>
        <Container Type="Vertical Stack" CellGap="6">
          <Text text="Skills" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-category-skills" Type="Select" ItemsSource="{Binding builder.category.options}" SelectedIndex="{Binding builder.category.skills, mode=TwoWay}" Interactive="{Binding builder.canEdit}" accessible-name="Skills category state" />
          <Text text="Plugins" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-category-plugins" Type="Select" ItemsSource="{Binding builder.category.options}" SelectedIndex="{Binding builder.category.plugins, mode=TwoWay}" Interactive="{Binding builder.canEdit}" accessible-name="Plugins category state" />
          <Text text="Apps" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-category-apps" Type="Select" ItemsSource="{Binding builder.category.options}" SelectedIndex="{Binding builder.category.apps, mode=TwoWay}" Interactive="{Binding builder.canEdit}" accessible-name="Apps category state" />
          <Text text="Models" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-category-models" Type="Select" ItemsSource="{Binding builder.category.options}" SelectedIndex="{Binding builder.category.models, mode=TwoWay}" Interactive="{Binding builder.canEdit}" accessible-name="Models category state" />
          <Text text="Memory" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-category-memory" Type="Select" ItemsSource="{Binding builder.category.options}" SelectedIndex="{Binding builder.category.memory, mode=TwoWay}" Interactive="{Binding builder.canEdit}" accessible-name="Memory category state" />
        </Container>
        <Container Type="Vertical Stack" CellGap="8">
          <Text text="Canonical context sources" font-size="18" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
          <Text text="Choose a real Boards notebook through Home. Adding a read reference does not grant body access; using it requires a new original Home review and local inference. Current selection is not captured on this route. Up to 128 current notebooks are shown, newest first." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
          <Button id="space-builder-browse-boards" content="Choose or refresh Boards sources" action="space-builder.source.browse" Interactive="{Binding builder.canBrowseSources}" accessible-name="Choose canonical Boards sources" />
          <Repeat id="space-builder-boards-options" Source="{Binding builder.boardOptions}" As="source" Key="{Binding source.id}">
            <Container Type="Horizontal Stack" CellGap="8">
              <Text text="{Binding source.label}" foreground="{Resource CuiTextBrush}" />
              <Text text="{Binding source.revision}" foreground="{Resource CuiTextSoftBrush}" />
              <Button id="space-builder-attach-boards-source" content="Add source" action="AttachBoardsSource" Interactive="{Binding builder.canBrowseSources}" accessible-name="Add this canonical Boards source" />
            </Container>
          </Repeat>
          <Repeat id="space-builder-context-references" Source="{Binding builder.contextReferences}" As="context" Key="{Binding context.id}">
            <Container Type="Horizontal Stack" CellGap="8">
              <Text text="{Binding context.label}" foreground="{Resource CuiTextBrush}" />
              <Text text="{Binding context.revision}" foreground="{Resource CuiTextSoftBrush}" />
              <Text text="{Binding context.policy}" foreground="{Resource CuiTextSoftBrush}" />
              <Button id="space-builder-remove-context-source" content="Remove reference" action="RemoveContextSource" Interactive="{Binding builder.canEdit}" accessible-name="Remove this source reference without deleting its notebook" />
            </Container>
          </Repeat>
          <Text text="Maximum retrieved items (empty for no policy limit; 0 includes no source bodies)" foreground="{Resource CuiTextBrush}" />
          <Input id="space-builder-context-limit" Type="Text" Value="{Binding builder.context.maximumRetrievedItems, mode=TwoWay}" Interactive="{Binding builder.canEdit}" accessible-name="Maximum retrieved context items" />
          <Text text="The original source currently supports up to 32 selected items, subject to text bounds. Strict policies exclude unqualified page attachments and tool retrieval." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
          <Container Type="Vertical Stack" Visible="{Binding builder.hasLegacyFiles}" CellGap="4">
            <Text text="Legacy file references" font-size="16" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
            <Text text="These paths remain saved but cannot be used as reviewed source bodies under strict policies. Remove the reference to migrate this Space; the original file is not deleted." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            <Repeat id="space-builder-legacy-files" Source="{Binding builder.legacyFiles}" As="legacy" Key="{Binding legacy.path}">
              <Container Type="Horizontal Stack" CellGap="8">
                <Text text="{Binding legacy.label}" foreground="{Resource CuiTextBrush}" />
                <Button id="space-builder-remove-legacy-file" content="Remove reference" action="RemoveLegacyFile" Interactive="{Binding builder.canEdit}" accessible-name="Remove this legacy reference without deleting the file" />
              </Container>
            </Repeat>
          </Container>
        </Container>
        <Container Type="Vertical Stack" CellGap="4">
          <Text text="Installed Skills" font-size="18" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
          <Repeat id="space-builder-installed-skills" Source="{Binding builder.installedSkills}" As="skill" Key="{Binding skill.id}">
            <Container id="space-builder-installed-skill-row" Type="Horizontal Stack" CellGap="8">
              <Text id="space-builder-skill-name" text="{Binding skill.name}" foreground="{Resource CuiTextBrush}" />
              <Text id="space-builder-skill-status" text="{Binding skill.status}" foreground="{Resource CuiTextSoftBrush}" />
              <Button id="space-builder-attach-skill" content="Attach" action="AttachSkill" Interactive="{Binding builder.canEdit}" accessible-name="Attach skill" />
            </Container>
          </Repeat>
        </Container>
        <Container Type="Vertical Stack" CellGap="4">
          <Text text="Installed Plugins" font-size="18" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
          <Repeat id="space-builder-installed-plugins" Source="{Binding builder.installedPlugins}" As="plugin" Key="{Binding plugin.id}">
            <Container id="space-builder-installed-plugin-row" Type="Horizontal Stack" CellGap="8">
              <Text id="space-builder-plugin-name" text="{Binding plugin.name}" foreground="{Resource CuiTextBrush}" />
              <Text id="space-builder-plugin-state" text="{Binding plugin.state}" foreground="{Resource CuiTextSoftBrush}" />
              <Button id="space-builder-attach-plugin" content="Attach" action="AttachPlugin" Interactive="{Binding builder.canEdit}" accessible-name="Attach plugin" />
            </Container>
          </Repeat>
        </Container>
        <Container Type="Vertical Stack" CellGap="4">
          <Text text="Attached capabilities" font-size="18" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
          <Text text="Canonical IDs and pinned versions. Attached references do not install or grant permissions." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
          <Repeat id="space-builder-capabilities" Source="{Binding builder.capabilities}" As="cap" Key="{Binding cap.key}">
            <Container id="space-builder-capability-row" Type="Horizontal Stack" CellGap="8">
              <Text id="space-builder-capability-kind" text="{Binding cap.kind}" foreground="{Resource CuiTextBrush}" />
              <Text id="space-builder-capability-id" text="{Binding cap.id}" foreground="{Resource CuiTextBrush}" />
              <Text id="space-builder-capability-version" text="{Binding cap.version}" foreground="{Resource CuiTextSoftBrush}" />
              <Button id="space-builder-capability-remove" action="RemoveCapability" content="Remove" Interactive="{Binding builder.canEdit}" accessible-name="Remove attached capability" />
            </Container>
          </Repeat>
          <If Condition="{Binding builder.hasNoCapabilities}">
            <Text id="space-builder-no-capabilities" text="No capabilities attached." foreground="{Resource CuiTextSoftBrush}" />
          </If>
        </Container>
        <Container Type="Wrap" CellGap="8">
          <If Condition="{Binding builder.canGoBack}">
            <Button id="space-builder-back" content="Back to Spaces" action="space-builder.back" Interactive="{Binding builder.canGoBack}" accessible-name="Back to Spaces" />
          </If>
          <Button id="space-builder-save" content="Save" action="space-builder.save" Interactive="{Binding builder.canSave}" accessible-name="Save Space Builder configuration" />
          <Button id="space-builder-discard" content="Discard changes" action="space-builder.discard" Interactive="{Binding builder.canDiscard}" accessible-name="Discard unsaved changes and reload" />
          <Button id="space-builder-reload" content="Reload" action="space-builder.reload" Interactive="{Binding builder.canReload}" accessible-name="Reload saved Space Builder configuration" />
        </Container>
        <Text id="space-builder-status" text="{Binding builder.status}" role="status" accessible-name="Space Builder status" foreground="{Resource CuiTextSoftBrush}" />
      </Container>
    </Page>
  </Theme>
</Cui>
