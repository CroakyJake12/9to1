<Cui id="spaces.tasks.dashboard" version="1">
  <Actions>
    <Action name="OpenExistingTask" command="tasks.open" parameter="{Binding task.observation}" />
    <Action name="ReviewTaskPermission" command="tasks.review-permission" parameter="{Binding task.observation}" />
    <Action name="SubmitNewTask" command="tasks.submit" parameter="{Binding Event}" />
    <Action name="ToggleTaskDetails"><Toggle Target="DetailsOpen" /></Action>
  </Actions>
  <Variable Type="bool" ID="DetailsOpen">False</Variable>
  <Theme Name="user_preference">
    <Page id="space-tasks-dashboard" accessible-name="Tasks and recorded progress">
      <Container id="tasks-overlay" Type="Overlay Float">
      <Container id="tasks-dashboard-scroll" Type="Vertical Stack" Padding="24" CellGap="14" VerticalScrolling="True" HorizontalScrolling="False">
        <Container Type="Horizontal Stack" CellGap="12">
          <Text id="tasks-heading" text="Tasks" font-size="26" font-weight="Bold" />
          <If Condition="{Binding CanChangeScope}">
            <Container Type="Menu" Background="{Resource CuiTransparentBrush}">
              <Button id="tasks-overflow" Type="Menu Item" content="…" accessible-name="Task list options" Tooltip="Task list options">
                <Button Type="Menu Item" content="Shown Tasks" accessible-name="Shown Tasks">
                  <Button id="tasks-overflow-only" Type="Menu Item" content="Task Space Only" action="tasks.scope-only" ToggleType="Radio" Checked="{Binding IsTaskSpaceOnly}" />
                  <Button id="tasks-overflow-all" Type="Menu Item" content="All Tasks" action="tasks.scope-all" ToggleType="Radio" Checked="{Binding IsAllTasks}" Interactive="{Binding CanReadAllTasks}" />
                </Button>
              </Button>
            </Container>
          </If>
        </Container>
        <Text id="tasks-scope" text="{Binding ScopeLabel}" foreground="{Resource CuiTextSoftBrush}" accessible-name="Shown task scope" />
        <Text id="tasks-new-work-heading" text="Delegate a new task" font-size="18" font-weight="SemiBold" />
        <Input id="tasks-new-instruction" Type="Text" AcceptsReturn="True" SubmitAction="SubmitNewTask" Value="{Binding Instruction}" placeholdertext="Describe a new, one-off task…" MinHeight="76" Interactive="{Binding CanEditInstruction}" accessible-name="New task instruction" />
        <Container id="tasks-new-work-actions" Type="Wrap" CellGap="8">
          <Button id="tasks-delegate" action="tasks.delegate" content="Delegate task" Interactive="{Binding CanDelegate}" accessible-name="Start this explicit new task" />
          <Button id="tasks-new-blank" action="tasks.blank" content="New blank task" Interactive="{Binding CanOpenBlank}" accessible-name="Open a new blank task" />
          <Button id="tasks-refresh" action="tasks.refresh" content="Refresh tasks" Interactive="{Binding CanRefresh}" accessible-name="Refresh this task list" />
        </Container>
        <Text id="tasks-one-off-note" text="Reusable and scheduled work belongs in Automations." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
        <Text id="tasks-existing-heading" text="Existing work" font-size="18" font-weight="SemiBold" />
        <Button id="tasks-details-toggle" action="ToggleTaskDetails" content="Show/hide task details" accessible-name="Show or hide diagnostic details for the displayed tasks" />
        <If Condition="!{Binding HasRows}">
          <Text id="tasks-empty" text="{Binding EmptyLabel}" TextWrapping="Wrap" />
        </If>
        <Container id="tasks-recent-rows" Type="Vertical Stack" CellGap="10" MinHeight="40" Background="{Resource CuiTransparentBrush}" accessible-name="Existing canonical task tiles">
          <Container Type="Context Menu">
            <Button id="tasks-context-scope" Type="Menu Item" content="Shown Tasks" Interactive="{Binding CanChangeScope}">
              <Button id="tasks-context-only" Type="Menu Item" content="Task Space Only" action="tasks.scope-only" ToggleType="Radio" Checked="{Binding IsTaskSpaceOnly}" />
              <Button id="tasks-context-all" Type="Menu Item" content="All Tasks" action="tasks.scope-all" ToggleType="Radio" Checked="{Binding IsAllTasks}" Interactive="{Binding CanReadAllTasks}" />
            </Button>
          </Container>
          <Repeat id="tasks-tile-repeat" Source="{Binding Rows}" As="task" Key="{Binding task.id}">
            <Container id="tasks-tile" Type="Vertical Stack" Padding="16" CellGap="8" Background="{Resource CuiPanelBrush}" BorderBrush="{Resource CuiLineBrush}" BorderThickness="1" CornerRadius="14" accessible-name="{Binding task.accessibleName}">
              <Button id="tasks-tile-open" action="OpenExistingTask" content="{Binding task.title}" HorizontalAlignment="Stretch" MinHeight="40" accessible-name="{Binding task.openLabel}" Tooltip="{Binding task.title}" />
              <If Condition="{Binding task.completed}">
                <Text id="tasks-tile-completed" text="{Binding task.status}" foreground="{Resource CuiSuccessBrush}" font-weight="SemiBold" accessible-name="{Binding task.status}" />
              </If>
              <If Condition="!{Binding task.completed}">
                <If Condition="{Binding task.permissionPrimary}">
                  <Text id="tasks-tile-permission-status" text="{Binding task.status}" foreground="{Resource CuiInformationBrush}" font-weight="SemiBold" TextWrapping="Wrap" accessible-name="{Binding task.status}" />
                </If>
                <If Condition="!{Binding task.permissionPrimary}">
                  <Text id="tasks-tile-status" text="{Binding task.status}" font-weight="SemiBold" TextWrapping="Wrap" accessible-name="{Binding task.status}" />
                </If>
              </If>
              <If Condition="{Binding task.hasPermissionReview}">
                <Button id="tasks-tile-review-permission" action="ReviewTaskPermission" content="Review permission" accessible-name="Review the actual pending permission for this task" />
              </If>
              <Text id="tasks-tile-origin" text="{Binding task.origin}" foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
              <Text id="tasks-tile-summary" text="{Binding task.summary}" TextWrapping="Wrap" />
              <Text id="tasks-tile-progress" text="{Binding task.progress}" foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
              <If Condition="{Binding DetailsOpen}">
                <Container id="tasks-tile-details" Type="Vertical Stack" CellGap="6" accessible-name="Task diagnostics">
                  <Text id="tasks-tile-observation" text="{Binding task.observationText}" foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                  <Text id="tasks-tile-checkpoint" text="{Binding task.checkpoint}" foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                  <Text id="tasks-tile-identity" text="{Binding task.identity}" foreground="{Resource CuiTextSoftBrush}" font-size="11" TextWrapping="Wrap" accessible-name="Canonical task and run identities" />
                </Container>
              </If>
            </Container>
          </Repeat>
        </Container>
        <If Condition="{Binding IsAllTasks}">
          <Container Type="Horizontal Stack" CellGap="8" accessible-name="Canonical task pages">
            <Button id="tasks-previous-page" content="Previous page" action="tasks.previous" Interactive="{Binding CanPreviousPage}" />
            <Button id="tasks-next-page" content="Next page" action="tasks.next" Interactive="{Binding CanNextPage}" />
          </Container>
        </If>
        <Text id="tasks-page-status" text="{Binding Status}" foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" accessible-name="Task dashboard result" />
      </Container>
      <If Condition="{Binding ReviewOpen}">
        <Container id="tasks-permission-popout" Type="Floating" Target="tasks-scope" Placement="Under" action="tasks.close-permission">
          <Container Type="Vertical Stack" Width="440" MaxWidth="480" MaxHeight="500" VerticalScrolling="True" Padding="18" CellGap="10" Background="{Resource CuiPanelBrush}" BorderBrush="{Resource CuiLineBrush}" BorderThickness="1" CornerRadius="14" accessible-name="Review task permission">
            <Text text="{Binding ReviewTitle}" font-size="18" font-weight="SemiBold" TextWrapping="Wrap" />
            <Text id="tasks-permission-question" text="{Binding ReviewQuestion}" font-weight="SemiBold" TextWrapping="Wrap" />
            <Text text="{Binding ReviewRequester}" foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            <Text text="{Binding ReviewProvider}" TextWrapping="Wrap" />
            <Text id="tasks-permission-explanation" text="{Binding ReviewExplanation}" TextWrapping="Wrap" />
            <Text id="tasks-permission-status" text="{Binding ReviewStatus}" foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            <Container Type="Wrap" CellGap="8">
              <Button id="tasks-permission-allow" content="Allow this request" action="tasks.allow-permission" Interactive="{Binding CanRespondReview}" accessible-name="Allow only this reviewed task permission request" />
              <Button id="tasks-permission-deny" content="Deny" action="tasks.deny-permission" Interactive="{Binding CanRespondReview}" accessible-name="Deny this reviewed task permission request" />
              <Button id="tasks-permission-close" content="Close" action="tasks.close-permission" Interactive="{Binding CanCloseReview}" accessible-name="Close permission review and return to tasks" />
            </Container>
          </Container>
        </Container>
      </If>
      </Container>
    </Page>
  </Theme>
</Cui>
