<Cui id="spaces.home" version="1">
  <!--
    Canonical CUI Spaces home surface.

    Every element is a CUI visual primitive (Page, Container, Text, Button, Input) and every
    attribute is a canonical CUI property. This document is compiled by
    CuiCanonicalApplicationCompilationTests.Actual_spaces_and_chat_source_compiles_against_canonical_cui,
    so it cannot drift back into an invented dialect unnoticed.

    Collections are expressed with <Repeat>, not with items/item-template/empty-template on a
    Container. Those three attributes belong to a list vocabulary CUI does not have; the parser
    accepted them only to reject them at compile time. Each Repeat carries a stable Key bound to
    the canonical Space identity, so re-sorting the sidebar keeps each row's control instead of
    rebuilding it.

    Empty states use <If Condition="..." Negate="true"> rather than an empty-template attribute.

    Attributes deliberately absent, with the reason:
      * touch-target - CUI has no touch-target property. Touch sizing must come from the shared
        control templates; until then this is an accessibility gap, not a preference.
      * variant on create-space - not a CUI Button property.
      * scalable-text / high-contrast / reduced-motion - inherited accessibility settings owned by
        the theme layer, not per-document declarations.
      * font-family="Montserrat" - the CUI default interface family resolved by the host
        (CuiNativeHost maps it to the bundled assets), not a per-document override.
  -->
  <Actions>
    <Action name="SearchConversationTitles" command="spaces.search-conversations" parameter="{Binding spaces.conversationSearchIntent}" />
    <Action name="ClearConversationSearch" command="spaces.clear-conversation-search" parameter="{Binding spaces.conversationSearchIntent}" />
    <Action name="SelectRow" command="spaces.select" parameter="{Binding space.id}" />
    <Action name="RenameRow" command="spaces.rename" parameter="{Binding space.id}" />
    <Action name="MoveRow" command="spaces.move" parameter="{Binding space.id}" />
    <Action name="ForkRow" command="spaces.fork" parameter="{Binding space.id}" />
    <Action name="ArchiveRow" command="spaces.archive" parameter="{Binding space.id}" />
    <Action name="ConfirmRename" command="spaces.confirm-rename" parameter="{Binding spaces.pendingRenameSpaceId}" />
    <Action name="RenameSelected" command="spaces.rename" parameter="{Binding selection.id}" />
    <Action name="ForkSelected" command="spaces.fork" parameter="{Binding selection.id}" />
    <Action name="OpenSelected" command="spaces.open" parameter="{Binding selection.id}" />
    <Action name="ArchiveSelected" command="spaces.archive" parameter="{Binding selection.id}" />
    <Action name="EditExtensions" command="spaces.edit-extensions" parameter="{Binding selection.id}" />
    <Action name="EditGraph" command="spaces.edit-graph" parameter="{Binding selection.id}" />
    <Action name="EditDetails" command="spaces.edit-details" parameter="{Binding selection.id}" />
    <Action name="ManageSelected" command="spaces.edit-details" parameter="{Binding selection.id}" />
    <Action name="NewChat" command="spaces.new-chat" parameter="{Binding selection.id}" />
    <Action name="OpenConversation" command="spaces.open-conversation" parameter="{Binding conversation.openIntent}" />
    <Action name="OpenSidebarItem" command="spaces.open-sidebar-item" parameter="{Binding item.sidebarItemId}" />
    <Action name="ToggleSidebar" command="spaces.toggle-sidebar" />
    <Action name="ToggleSwitcher" command="spaces.toggle-space-switcher" />
    <Action name="ToggleOverflow" command="spaces.toggle-space-overflow" />
    <Action name="MoveSelected" command="spaces.move" parameter="{Binding selection.id}" />
    <Action name="AddContext" command="spaces.add-context" parameter="{Binding selection.id}" />
    <Action name="OpenSidebarTask" command="spaces.tasks.open" parameter="{Binding task.openIntent}" />
    <Action name="ReviewSidebarTask" command="spaces.tasks.review" parameter="{Binding task.openIntent}" />
  </Actions>
  <Theme Name="user_preference">
    <Page id="spaces-page" role="main" accessible-name="Spaces">
      <Container id="spaces-body" Type="Grid" RowSizes="1fr" ColumnSizes="1fr" Interactive="{Binding spaces.canMutate}" Background="{Resource CuiBackgroundBrush}">
        <Container id="spaces-layout" Type="Grid" RowSizes="72 1fr" ColumnSizes="{Binding spaces.layoutColumns}" CellGap="0" Background="{Resource CuiBackgroundBrush}">
          <Container id="space-app-header" Type="Horizontal Stack" Column="1" ColumnSpan="2" Padding="24 14" CellGap="14" Background="{Resource CuiPanelBrush}" AccessibleName="Current Space">
            <Image Source="{Binding selection.iconSource}" Width="32" Height="32" VerticalAlignment="Center" />
            <Text Text="{Binding selection.name}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
          </Container>
          <Container id="spaces-sidebar" RowSpan="2" role="navigation" accessible-name="Spaces navigation" width="70" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" Padding="8" CellGap="8" Background="{Resource CuiPanelBrush}" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 1 0">
            <!--
              The top rail control is a deliberate viewing/managing action: it opens the SAME
              canonical management presentation (the authored space-details region). It never
              creates a Space directly; explicit creation lives inside that management surface.
            -->
            <Button id="manage-spaces" action="spaces.manage" accessible-name="Manage Spaces" Tooltip="Manage Spaces" Width="48" Height="48" Padding="12" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Image id="manage-spaces-icon" Source="icon:manage-spaces" Width="24" Height="24" />
            </Button>
            <Repeat id="first-party-spaces" Source="{Binding spaces.builtIns}" As="space" Key="{Binding space.id}">
              <Container id="first-party-space" Type="Vertical Stack">
                <Button id="first-party-space-open" action="SelectRow" accessible-name="{Binding space.openLabel}" Tooltip="{Binding space.tooltip}" Selected="{Binding space.isSelected}" Width="48" Height="48" Padding="12" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
                  <Image id="first-party-space-icon" Source="{Binding space.iconSource}" Width="24" Height="24" />
                </Button>
              </Container>
            </Repeat>
            <Container id="spaces-rail-divider" Type="Vertical Stack" Height="1" Background="{Resource CuiLineBrush}" />
            <Repeat id="custom-spaces" Source="{Binding spaces.customSpaces}" As="space" Key="{Binding space.id}">
              <Container id="custom-space-row" role="listitem" accessible-name="{Binding space.customLabel}" Type="Vertical Stack">
                <Button id="open-custom-space" action="SelectRow" accessible-name="{Binding space.openLabel}" Tooltip="{Binding space.tooltip}" Selected="{Binding space.isSelected}" Width="48" Height="48" Padding="12" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
                  <Image id="custom-space-icon" Source="{Binding space.iconSource}" Width="24" Height="24" />
                </Button>
              </Container>
            </Repeat>
            <!--
              Space management stays a deliberate operation. While a Space workspace is mounted the
              summary and its manage buttons are hidden, so the rail keeps one explicit settings
              entry for the selected user-created Space instead of a second navigation surface.
            -->
            <If Condition="{Binding selection.canEditDetails}">
              <Button id="manage-selected-space" action="ManageSelected" accessible-name="Manage selected Space" Tooltip="Manage this Space" Width="48" Height="48" Padding="12" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
                <Image id="manage-selected-space-icon" Source="icon:settings" Width="24" Height="24" />
              </Button>
            </If>
            <!-- Collapsing the contextual sidebar keeps one explicit control to bring it back. -->
            <If Condition="{Binding spaces.sidebarCollapsed}">
              <Button id="space-sidebar-expand" action="ToggleSidebar" accessible-name="Expand this Space's sidebar" Tooltip="Expand this Space's sidebar" Width="48" Height="48" Padding="12" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
                <Image id="space-sidebar-expand-icon" Source="icon:chevron-right" Width="24" Height="24" />
              </Button>
            </If>
          </Container>
          <!--
            The main sidebar is contextual to the selected Space: New chat plus that Space's own
            recent conversations. It stays visible while a Space conversation is mounted, and it
            never becomes a cross-Space history list because the rows are scoped to the selection.
          -->
          <Container id="space-context-sidebar" Row="1" role="navigation" accessible-name="Selected Space sidebar" Column="1" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" Padding="12" CellGap="8" Background="{Resource CuiPanel3Brush}" IsVisible="{Binding spaces.sidebarExpanded}">
            <!--
              The header control displays the currently selected Space and switches Spaces when
              activated; the adjacent overflow control holds that Space's quick actions. Both popovers
              are deterministic (only one open at a time) and the whole sidebar collapses.
            -->
            <Container id="space-context-header" Type="Grid" ColumnSizes="1fr Auto Auto" CellGap="4">
              <Button Column="0" id="space-switcher" HorizontalContentAlignment="Left" action="ToggleSwitcher" content="{Binding selection.name}" accessible-name="Switch Space" Tooltip="Switch to another Space" Padding="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="6" />
              <Button Column="1" id="space-overflow" action="ToggleOverflow" accessible-name="Quick actions for this Space" Tooltip="Quick actions for this Space" Width="32" Height="32" Padding="6" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="6">
                <Image id="space-overflow-icon" Source="icon:more" Width="18" Height="18" />
              </Button>
              <Button Column="2" id="space-sidebar-collapse" action="ToggleSidebar" accessible-name="Collapse this sidebar" Tooltip="Collapse this sidebar" Width="32" Height="32" Padding="6" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="6">
                <Image id="space-sidebar-collapse-icon" Source="icon:chevron-left" Width="18" Height="18" />
              </Button>
            </Container>
            <If Condition="{Binding spaces.spaceSwitcherOpen}">
              <Container id="space-switcher-list" role="list" accessible-name="Spaces switcher" Type="Vertical Stack" CellGap="4">
                <Repeat id="space-switcher-builtin" Source="{Binding spaces.builtIns}" As="space" Key="{Binding space.id}">
                  <Button id="space-switcher-builtin-row" HorizontalContentAlignment="Left" action="SelectRow" content="{Binding space.name}" accessible-name="{Binding space.openLabel}" Selected="{Binding space.isSelected}" Padding="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="6" />
                </Repeat>
                <Repeat id="space-switcher-custom" Source="{Binding spaces.customSpaces}" As="space" Key="{Binding space.id}">
                  <Button id="space-switcher-custom-row" HorizontalContentAlignment="Left" action="SelectRow" content="{Binding space.name}" accessible-name="{Binding space.openLabel}" Selected="{Binding space.isSelected}" Padding="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="6" />
                </Repeat>
              </Container>
            </If>
            <If Condition="{Binding spaces.spaceOverflowOpen}">
              <Container id="space-overflow-actions" role="menu" accessible-name="Space quick actions" Type="Vertical Stack" CellGap="4">
                <Button id="space-overflow-manage" action="ManageSelected" content="Manage Space" accessible-name="Manage selected Space" Interactive="{Binding selection.canEditDetails}" Padding="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="6" />
                <Button id="space-overflow-rename" action="RenameSelected" content="Rename Space" accessible-name="Rename selected Space" Interactive="{Binding selection.canEdit}" Padding="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="6" />
                <Button id="space-overflow-archive" action="ArchiveSelected" content="Archive Space" accessible-name="Archive selected Space" Interactive="{Binding selection.canEdit}" Padding="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="6" />
              </Container>
            </If>
            <Button id="space-new-chat" HorizontalContentAlignment="Stretch" action="NewChat" accessible-name="{Binding spaces.newConversationAccessibleLabel}" Padding="14" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="8">
                <Image id="space-new-chat-icon" Source="icon:plus" Width="18" Height="18" VerticalAlignment="Center" />
                <Text id="space-new-chat-label" text="{Binding spaces.newConversationLabel}" font-size="16" font-weight="SemiBold" />
              </Container>
            </Button>
            <!--
              Plugin/extension-declared sidebar elements for this Space sit directly beneath New chat,
              as an ordinary navigation row (icon left, readable label beside it). Each row is keyed by
              the extension's stable SidebarItemId, and an element whose target this Space cannot yet
              resolve stays visible but explicitly not actionable.
            -->
            <Repeat id="space-sidebar-items" Source="{Binding spaces.sidebarItems}" As="item" Key="{Binding item.sidebarItemId}">
              <Button id="open-space-sidebar-item" HorizontalContentAlignment="Stretch" action="OpenSidebarItem" accessible-name="{Binding item.openLabel}" Interactive="{Binding item.isActionable}" Padding="14" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
                <Container id="space-sidebar-item-row" role="listitem" accessible-name="{Binding item.label}" Type="Horizontal Stack" CellGap="8">
                  <Image id="space-sidebar-item-icon" Source="{Binding item.iconSource}" Width="20" Height="20" VerticalAlignment="Center" accessible-name="{Binding item.label}" />
                  <Text id="space-sidebar-item-label" text="{Binding item.label}" font-size="16" />
                </Container>
              </Button>
            </Repeat>
            <If Condition="{Binding spaces.isTasksSpace}">
              <Container id="space-task-sidebar" Type="Vertical Stack" CellGap="10" MinHeight="48" Background="{Resource CuiTransparentBrush}" accessible-name="Tasks sidebar">
                <Container Type="Context Menu">
                  <Button id="space-task-context-scope" Type="Menu Item" content="Shown Tasks" Interactive="{Binding spaces.canReadTasks}">
                    <Button id="space-task-context-only" Type="Menu Item" content="Task Space Only" action="spaces.tasks.scope-only" ToggleType="Radio" Checked="{Binding spaces.taskSpaceOnly}" />
                    <Button id="space-task-context-all" Type="Menu Item" content="All Tasks" action="spaces.tasks.scope-all" ToggleType="Radio" Checked="{Binding spaces.taskAll}" />
                  </Button>
                </Container>
                <Container Type="Horizontal Stack" CellGap="6">
                  <Text id="space-task-scope" text="{Binding spaces.taskScope}" font-weight="SemiBold" VerticalAlignment="Center" />
                  <Container Type="Menu" Background="{Resource CuiTransparentBrush}">
                    <Button id="space-task-options" Type="Menu Item" content="…" accessible-name="Task sidebar options" Tooltip="Task sidebar options">
                      <Button Type="Menu Item" content="Shown Tasks" Interactive="{Binding spaces.canReadTasks}">
                        <Button id="space-task-overflow-only" Type="Menu Item" content="Task Space Only" action="spaces.tasks.scope-only" ToggleType="Radio" Checked="{Binding spaces.taskSpaceOnly}" />
                        <Button id="space-task-overflow-all" Type="Menu Item" content="All Tasks" action="spaces.tasks.scope-all" ToggleType="Radio" Checked="{Binding spaces.taskAll}" />
                      </Button>
                    </Button>
                  </Container>
                </Container>
                <Button id="space-task-refresh" content="Refresh tasks" action="spaces.tasks.refresh" Interactive="{Binding spaces.canReadTasks}" />
                <Repeat id="space-task-tiles" Source="{Binding spaces.taskRows}" As="task" Key="{Binding task.id}">
                  <Container id="space-task-tile" Type="Vertical Stack" Padding="12" CellGap="6" Background="{Resource CuiPanelBrush}" BorderBrush="{Resource CuiLineBrush}" BorderThickness="1" CornerRadius="12" accessible-name="{Binding task.title}">
                    <Button id="space-task-open" action="OpenSidebarTask" content="{Binding task.title}" Selected="{Binding task.isCurrent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="40" accessible-name="{Binding task.openLabel}" Tooltip="{Binding task.title}" />
                    <If Condition="{Binding task.completed}">
                      <Button action="OpenSidebarTask" content="{Binding task.status}" foreground="{Resource CuiSuccessBrush}" font-weight="SemiBold" Tooltip="{Binding task.detail}" accessible-name="{Binding task.status}" Background="{Resource CuiTransparentBrush}" BorderWidth="0" />
                    </If>
                    <If Condition="!{Binding task.completed}">
                      <If Condition="{Binding task.permission}">
                        <Container Type="Vertical Stack" CellGap="4">
                          <Button action="OpenSidebarTask" content="{Binding task.status}" foreground="{Resource CuiInformationBrush}" font-weight="SemiBold" Tooltip="{Binding task.detail}" accessible-name="{Binding task.status}" Background="{Resource CuiTransparentBrush}" BorderWidth="0" />
                          <Button id="space-task-review" action="ReviewSidebarTask" content="Review permission" accessible-name="Review this task’s actual permission request" />
                        </Container>
                      </If>
                      <If Condition="!{Binding task.permission}">
                        <Button action="OpenSidebarTask" content="{Binding task.status}" font-weight="SemiBold" Tooltip="{Binding task.detail}" accessible-name="{Binding task.status}" Background="{Resource CuiTransparentBrush}" BorderWidth="0" />
                      </If>
                    </If>
                    <Text text="{Binding task.origin}" foreground="{Resource CuiTextSoftBrush}" font-size="12" TextWrapping="Wrap" />
                    <Text text="{Binding task.summary}" TextWrapping="Wrap" />
                    <Text text="{Binding task.progress}" foreground="{Resource CuiTextSoftBrush}" font-size="12" TextWrapping="Wrap" />
                  </Container>
                </Repeat>
                <If Condition="!{Binding spaces.hasTaskRows}">
                  <Text id="space-task-empty" text="No authorized tasks on this page." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                </If>
                <Container Type="Horizontal Stack" CellGap="6">
                  <Button id="space-task-previous" content="Previous" action="spaces.tasks.previous" Interactive="{Binding spaces.taskCanPrevious}" />
                  <Button id="space-task-next" content="Next" action="spaces.tasks.next" Interactive="{Binding spaces.taskCanNext}" />
                </Container>
                <Text id="space-task-notice" text="{Binding spaces.taskNotice}" foreground="{Resource CuiTextSoftBrush}" font-size="12" TextWrapping="Wrap" role="status" />
                <If Condition="{Binding spaces.taskReviewOpen}">
                  <Container id="space-task-permission-popout" Type="Floating" Target="space-task-scope" Placement="Under" action="spaces.tasks.close-review">
                    <Container Type="Vertical Stack" Width="400" MaxWidth="480" MaxHeight="500" VerticalScrolling="True" Padding="16" CellGap="8" Background="{Resource CuiPanelBrush}" BorderBrush="{Resource CuiLineBrush}" BorderThickness="1" CornerRadius="12" accessible-name="Review task permission">
                      <Text text="{Binding spaces.taskReviewTitle}" font-weight="SemiBold" TextWrapping="Wrap" />
                      <Text id="space-task-review-question" text="{Binding spaces.taskReviewQuestion}" font-weight="SemiBold" TextWrapping="Wrap" />
                      <Text text="{Binding spaces.taskReviewRequester}" TextWrapping="Wrap" />
                      <Text text="{Binding spaces.taskReviewProvider}" TextWrapping="Wrap" />
                      <Text id="space-task-review-explanation" text="{Binding spaces.taskReviewExplanation}" TextWrapping="Wrap" />
                      <Text id="space-task-review-status" text="{Binding spaces.taskReviewStatus}" TextWrapping="Wrap" role="status" />
                      <Container Type="Wrap" CellGap="8">
                        <Button id="space-task-review-allow" content="Allow this request" action="spaces.tasks.allow" Interactive="{Binding spaces.taskCanRespond}" />
                        <Button id="space-task-review-deny" content="Deny" action="spaces.tasks.deny" Interactive="{Binding spaces.taskCanRespond}" />
                        <Button id="space-task-review-close" content="Close" action="spaces.tasks.close-review" />
                      </Container>
                    </Container>
                  </Container>
                </If>
              </Container>
            </If>
            <If Condition="!{Binding spaces.isTasksSpace}">
              <Container Type="Vertical Stack" CellGap="4">
                <Container id="space-recent-chats-heading-row" Type="Vertical Stack" Padding="8">
                  <Text id="space-recent-chats-heading" text="{Binding spaces.conversationHistoryHeading}" font-size="14" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />
                  <If Condition="{Binding spaces.canSearchConversations}">
                    <Container id="space-history-search" Type="Vertical Stack" CellGap="6" accessible-name="Find saved chats in this Space">
                      <Input id="space-history-query" Type="Text" Value="{Binding spaces.conversationQuery, mode=TwoWay}" placeholdertext="Find chat titles in this Space" accessible-name="Find saved chat titles in this Space" />
                      <Container Type="Horizontal Stack" CellGap="6">
                        <Button id="space-history-search-button" action="SearchConversationTitles" content="Search" accessible-name="Search saved chat titles in this Space" />
                        <Button id="space-history-clear-button" action="ClearConversationSearch" content="Clear" accessible-name="Clear chat search and show recent chats" />
                      </Container>
                    </Container>
                  </If>
                  <Text id="space-history-notice" text="{Binding spaces.conversationHistoryNotice}" font-size="12" foreground="{Resource CuiTextSoftBrush}" accessible-name="Chat history search status" />
                </Container>
                <Container id="space-recent-chats-divider" Type="Vertical Stack" Height="1" Background="{Resource CuiLineBrush}" />
                <Repeat id="space-conversations" Source="{Binding spaces.conversations}" As="conversation" Key="{Binding conversation.id}">
                  <Container id="space-conversation-row" role="listitem" accessible-name="{Binding conversation.title}" Type="Vertical Stack" CellGap="2">
                    <Button id="open-space-conversation" HorizontalContentAlignment="Stretch" action="OpenConversation" accessible-name="{Binding conversation.openLabel}" Selected="{Binding conversation.isCurrent}" Padding="12" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
                      <Container Type="Vertical Stack" CellGap="2">
                        <Text id="space-conversation-title" text="{Binding conversation.title}" font-size="15" />
                        <Text id="space-conversation-updated" text="{Binding conversation.updatedLabel}" foreground="{Resource CuiTextSoftBrush}" font-size="12" />
                      </Container>
                    </Button>
                  </Container>
                </Repeat>
                <If Condition="!{Binding spaces.hasConversations}">
                  <Container id="space-empty-history-row" Type="Vertical Stack" Padding="8" CellGap="8">
                    <Text id="space-conversations-empty" text="{Binding spaces.conversationHistoryEmpty}" font-size="12" foreground="{Resource CuiTextSoftBrush}" />
                  </Container>
                </If>
              </Container>
            </If>
          </Container>

          <!--
            The selected Space's own workspace (a chat, a builder or a details page) is mounted
            into the authored `space-app-content` control by the native Spaces owner. While a
            workspace is mounted the Space summary is deliberately hidden so the icon-only rail
            and the workspace, including its chat/history sidebar, stay on screen together. The
            summary returns when the workspace retires; nothing here invents a second navigation.
          -->
          <Container id="space-app-content" Row="1" accessible-name="Space workspace" Type="Overlay" Column="2" IsVisible="{Binding spaces.showWorkspace}" Background="{Resource CuiWorkspaceBrush}" CornerRadius="12" />
          <Container id="space-details" Row="1" accessible-name="Selected Space" Column="2" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" CellGap="10" IsVisible="{Binding spaces.showSummary}">
            <Text id="spaces-heading" text="Spaces" font-size="24" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
            <!-- While the manager is open over a mounted Space workspace, an explicit Return restores
                 the SAME mounted workspace/chat instance; it never detaches or changes the chat. -->
            <If Condition="{Binding spaces.isManaging}">
              <Button id="manage-return" action="spaces.manage" content="Return to Space" accessible-name="Return to the open Space" HorizontalAlignment="Left" Padding="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="6" />
            </If>
            <Container id="spaces-search-controls" Type="Grid" RowSizes="Auto" ColumnSizes="24 1fr" CellGap="8">
              <Image id="spaces-search-icon" Source="icon:search" Width="20" Height="20" VerticalAlignment="Center" />
              <Input Column="1" id="spaces-search" Type="Text" accessible-name="Search Spaces" placeholdertext="Find a Space" Value="{Binding spaces.query}" action="spaces.clear-search" />
            </Container>
            <If Condition="!{Binding spaces.hasCustomSpaces}">
              <Text id="custom-spaces-empty-text" text="Create a Space to keep related conversations and work together" foreground="{Resource CuiTextSoftBrush}" />
            </If>
            <Text id="spaces-status" text="{Binding status.message}" role="status" accessible-name="Spaces status" />
            <If Condition="{Binding selection.isRenaming}">
              <Container id="rename-controls" Type="Vertical Stack" CellGap="8">
                <Input id="rename-input" Type="Text" Value="{Binding spaces.renameDraft, mode=TwoWay}" accessible-name="Rename Space" />
                <Container id="rename-actions" Type="Wrap" CellGap="8">
                  <Button id="confirm-rename" action="ConfirmRename" content="Save" accessible-name="Confirm Space rename" />
                  <Button id="cancel-rename" action="spaces.cancel-rename" content="Cancel" accessible-name="Cancel Space rename" />
                </Container>
              </Container>
            </If>
            <If Condition="!{Binding selection.isRenaming}">
              <Container id="selected-space-header" Type="Vertical Stack" CellGap="4">
                <Text id="selected-space-name" text="{Binding selection.name}" font-size="24" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
                <Container id="space-header-actions" Type="Wrap" CellGap="8">
                  <!-- Explicit creation lives INSIDE the canonical management surface and still uses the
                       real existing spaces.create action (never an immediate rail creation). -->
                  <Button id="create-space-in-manager" action="spaces.create" content="Create a Space" accessible-name="Create a custom Space" />
                  <Button id="start-rename" action="RenameSelected" content="Rename" Interactive="{Binding selection.canEdit}" accessible-name="Rename selected Space" />
                  <Button id="fork-space" action="ForkSelected" content="Copy" accessible-name="Make a copy of selected Space" />
                  <Button id="open-selected-space" action="OpenSelected" content="Open" accessible-name="Open selected Space" />
                  <If Condition="{Binding selection.canEditDetails}">
                    <Button id="edit-space-details" action="EditDetails" content="Edit details" Interactive="{Binding selection.canEditDetails}" accessible-name="Edit Space details" />
                  </If>
                  <Button id="archive-space" action="ArchiveSelected" content="Archive" Interactive="{Binding selection.canEdit}" accessible-name="Archive selected Space" />
                  <If Condition="{Binding selection.isBuiltIn}">
                    <Button id="edit-extensions" action="EditExtensions" content="Edit extensions" Interactive="{Binding selection.canEditExtensions}" accessible-name="Edit Space extensions" />
                  </If>
                  <If Condition="!{Binding selection.isBuiltIn}">
                    <Button id="edit-graph" action="EditGraph" content="Edit Space graph" Interactive="{Binding selection.canEditGraph}" accessible-name="Edit Space graph" />
                  </If>
                </Container>
              </Container>
            </If>
            <Text id="selected-space-description" text="{Binding selection.description}" />
            <Container id="space-move" accessible-name="Move selected Space" Type="Vertical Stack" CellGap="8" Interactive="{Binding selection.canEdit}">
              <Text id="space-move-heading" text="Parent Space" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />
              <Input id="space-parent-select" Type="Select" ItemsSource="{Binding spaces.moveParentOptions}" SelectedIndex="{Binding spaces.selectedMoveParentIndex, mode=TwoWay, type=int}" accessible-name="Choose parent Space" />
              <Button id="move-space" action="MoveSelected" content="Set parent" accessible-name="Set parent Space" />
            </Container>
            <Container id="space-context" accessible-name="Space context and policy" background="{Resource CuiPanelBrush}" corner-radius="12" padding="16" Type="Vertical Stack" CellGap="8">
              <Text id="space-context-heading" text="Context" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />

              <Repeat id="space-context-items" Source="{Binding selection.contextReferences}" As="reference" Key="{Binding reference.id}">
                <Container id="space-context-item" role="listitem" accessible-name="{Binding reference.label}" Type="Vertical Stack">
                  <Text id="space-context-item-label" text="{Binding reference.label}" />
                  <Text id="space-context-item-permission" text="{Binding reference.permissionLabel}" foreground="{Resource CuiTextSoftBrush}" />
                  <Text id="space-context-item-index-state" text="{Binding reference.indexStateLabel}" foreground="{Resource CuiTextSoftBrush}" />
                </Container>
              </Repeat>
              <If Condition="!{Binding selection.hasContextReferences}">
                <Text id="space-context-empty-text" text="No sources added" foreground="{Resource CuiTextSoftBrush}" />
              </If>

              <Button id="add-context" action="AddContext" content="Add source" Interactive="{Binding selection.canEdit}" accessible-name="Add a source to this Space" />
              <Text id="space-access-heading" text="Model and access" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />
              <Text id="space-effective-model" text="{Binding selection.effectiveModelLabel}" accessible-name="Effective model" />
              <Text id="space-web-access" text="{Binding selection.webAccessLabel}" accessible-name="Web access policy" />
              <Text id="space-memory-scope" text="{Binding selection.memoryScopeLabel}" accessible-name="Memory scope" />

              <Text id="space-capabilities-heading" text="Capabilities" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />
              <Repeat id="space-capabilities" Source="{Binding selection.capabilities}" As="capability" Key="{Binding capability.id}">
                <Container id="space-capability" Type="Vertical Stack">
                  <Text id="space-capability-label" text="{Binding capability.label}" />
                </Container>
              </Repeat>
              <If Condition="!{Binding selection.hasCapabilities}">
                <Text id="space-capabilities-empty-text" text="No extra capabilities enabled" foreground="{Resource CuiTextSoftBrush}" />
              </If>
            </Container>
          </Container>
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
