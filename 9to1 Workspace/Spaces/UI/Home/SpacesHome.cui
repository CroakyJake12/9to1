<Cui id="spaces.home" version="1">
  <!--
    Canonical CUI Spaces home surface.

    Every element is a CUI visual primitive (Page, Container, Text, Button, Input) and every
    attribute is a canonical CUI property. This document is compiled by
    CuiCanonicalApplicationCompilationTests.Actual_spaces_and_chat_source_compiles_against_canonical_cui,
    so it cannot drift back into an invented dialect unnoticed.

    Collections are expressed with <Repeat>, not with items/item-template/empty-template on a
    Container. Those three attributes belong to a list vocabulary CUI does not have; the parser
    accepted them only to reject them at compile time. Each Repeat carries a stable Key bound to
    the canonical Space identity, so re-sorting the sidebar keeps each row's control instead of
    rebuilding it.

    Empty states use <If Condition="..." Negate="true"> rather than an empty-template attribute.

    Attributes deliberately absent, with the reason:
      * touch-target - CUI has no touch-target property. Touch sizing must come from the shared
        control templates; until then this is an accessibility gap, not a preference.
      * variant on create-space - not a CUI Button property.
      * scalable-text / high-contrast / reduced-motion - inherited accessibility settings owned by
        the theme layer, not per-document declarations.
      * font-family="Montserrat" - the CUI default interface family resolved by the host
        (CuiNativeHost maps it to the bundled assets), not a per-document override.
  -->
  <Actions>
    <Action name="SelectRow" command="spaces.select" parameter="{Binding space.id}" />
    <Action name="RenameRow" command="spaces.rename" parameter="{Binding space.id}" />
    <Action name="MoveRow" command="spaces.move" parameter="{Binding space.id}" />
    <Action name="ForkRow" command="spaces.fork" parameter="{Binding space.id}" />
    <Action name="ArchiveRow" command="spaces.archive" parameter="{Binding space.id}" />
    <Action name="ConfirmRename" command="spaces.confirm-rename" parameter="{Binding spaces.pendingRenameSpaceId}" />
    <Action name="RenameSelected" command="spaces.rename" parameter="{Binding selection.id}" />
    <Action name="ForkSelected" command="spaces.fork" parameter="{Binding selection.id}" />
    <Action name="OpenSelected" command="spaces.open" parameter="{Binding selection.id}" />
    <Action name="ArchiveSelected" command="spaces.archive" parameter="{Binding selection.id}" />
    <Action name="EditExtensions" command="spaces.edit-extensions" parameter="{Binding selection.id}" />
    <Action name="EditGraph" command="spaces.edit-graph" parameter="{Binding selection.id}" />
    <Action name="MoveSelected" command="spaces.move" parameter="{Binding selection.id}" />
    <Action name="AddContext" command="spaces.add-context" parameter="{Binding selection.id}" />
  </Actions>
  <Theme Name="user_preference">
    <Page id="spaces-page" role="main" accessible-name="Spaces">
      <Container id="spaces-body" Type="Vertical Stack" CellGap="16">
        <Container id="spaces-layout" Type="Horizontal Stack" CellGap="16">
          <Container id="spaces-sidebar" role="navigation" accessible-name="Spaces navigation" width="280" Type="Vertical Stack" CellGap="10">
            <Text id="spaces-heading" text="Spaces" font-size="24" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
            <Input id="spaces-search" Type="Text" accessible-name="Search Spaces" placeholdertext="Find a Space" Value="{Binding spaces.query}" action="spaces.clear-search" />
            <Button id="create-space" action="spaces.create" content="New Space" accessible-name="Create a custom Space" />
            <Text id="first-party-heading" text="First-party" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />

            <Repeat id="first-party-spaces" Source="{Binding spaces.builtIns}" As="space" Key="{Binding space.id}">
              <Container id="first-party-space" Type="Vertical Stack">
                <Button id="first-party-space-open" action="SelectRow" accessible-name="{Binding space.openLabel}">
                  <Container id="first-party-space-content" Type="Vertical Stack">
                    <Text id="first-party-space-name" text="{Binding space.name}" />
                    <Text id="first-party-space-summary" text="{Binding space.summary}" foreground="{Resource CuiTextSoftBrush}" />
                  </Container>
                </Button>
              </Container>
            </Repeat>

            <Text id="custom-spaces-heading" text="Your Spaces" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />

            <Repeat id="custom-spaces" Source="{Binding spaces.customSpaces}" As="space" Key="{Binding space.id}">
              <Container id="custom-space-row" role="listitem" accessible-name="{Binding space.customLabel}" Type="Vertical Stack">
                <Button id="open-custom-space" action="SelectRow" accessible-name="{Binding space.openLabel}">
                  <Container id="custom-space-content" Type="Vertical Stack">
                    <Text id="custom-space-name" text="{Binding space.name}" />
                    <Text id="custom-space-summary" text="{Binding space.summary}" foreground="{Resource CuiTextSoftBrush}" />
                  </Container>
                </Button>
                <Container id="custom-space-actions" accessible-name="{Binding space.actionsLabel}" Type="Wrap">
                  <Button id="rename-custom-space" action="RenameRow" content="Rename" accessible-name="{Binding space.renameLabel}" />
                  <Button id="move-custom-space" action="MoveRow" content="Move" accessible-name="{Binding space.moveLabel}" />
                  <Button id="fork-custom-space" action="ForkRow" content="Copy" accessible-name="{Binding space.forkLabel}" />
                  <Button id="archive-custom-space" action="ArchiveRow" content="Archive" accessible-name="{Binding space.archiveLabel}" />
                </Container>
              </Container>
            </Repeat>
            <If Condition="!{Binding spaces.customSpaces.Count}">
              <Text id="custom-spaces-empty-text" text="Create a Space to keep related conversations and work together" foreground="{Resource CuiTextSoftBrush}" />
            </If>
            <Text id="spaces-status" text="{Binding status.message}" role="status" accessible-name="Spaces status" />
          </Container>

          <Container id="space-details" accessible-name="Selected Space" Type="Vertical Stack" CellGap="10">
            <If Condition="{Binding selection.isRenaming}">
              <Container id="rename-controls" Type="Vertical Stack" CellGap="8">
                <Input id="rename-input" Type="Text" Value="{Binding spaces.renameDraft, mode=TwoWay}" accessible-name="Rename Space" />
                <Container id="rename-actions" Type="Wrap" CellGap="8">
                  <Button id="confirm-rename" action="ConfirmRename" content="Save" accessible-name="Confirm Space rename" />
                  <Button id="cancel-rename" action="spaces.cancel-rename" content="Cancel" accessible-name="Cancel Space rename" />
                </Container>
              </Container>
            </If>
            <If Condition="!{Binding selection.isRenaming}">
              <Container id="selected-space-header" Type="Vertical Stack" CellGap="4">
                <Text id="selected-space-name" text="{Binding selection.name}" font-size="24" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
                <Container id="space-header-actions" Type="Wrap" CellGap="8">
                  <Button id="start-rename" action="RenameSelected" content="Rename" Interactive="{Binding selection.canEdit}" accessible-name="Rename selected Space" />
                  <Button id="fork-space" action="ForkSelected" content="Copy" accessible-name="Make a copy of selected Space" />
                  <Button id="open-selected-space" action="OpenSelected" content="Open" accessible-name="Open selected Space" />
                  <Button id="archive-space" action="ArchiveSelected" content="Archive" Interactive="{Binding selection.canEdit}" accessible-name="Archive selected Space" />
                  <If Condition="{Binding selection.isBuiltIn}">
                    <Button id="edit-extensions" action="EditExtensions" content="Edit extensions" Interactive="{Binding selection.canEditExtensions}" accessible-name="Edit Space extensions" />
                  </If>
                  <If Condition="!{Binding selection.isBuiltIn}">
                    <Button id="edit-graph" action="EditGraph" content="Edit Space graph" Interactive="{Binding selection.canEditGraph}" accessible-name="Edit Space graph" />
                  </If>
                </Container>
              </Container>
            </If>
            <Text id="selected-space-description" text="{Binding selection.description}" />
            <Container id="space-move" accessible-name="Move selected Space" Type="Vertical Stack" CellGap="8" Interactive="{Binding selection.canEdit}">
              <Text id="space-move-heading" text="Parent Space" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />
              <Input id="space-parent-select" Type="Select" ItemsSource="{Binding spaces.moveParentOptions}" SelectedIndex="{Binding spaces.selectedMoveParentIndex, mode=TwoWay, type=int}" accessible-name="Choose parent Space" />
              <Button id="move-space" action="MoveSelected" content="Set parent" accessible-name="Set parent Space" />
            </Container>
            <Container id="space-context" accessible-name="Space context and policy" background="{Resource CuiPanelBrush}" corner-radius="12" padding="16" Type="Vertical Stack" CellGap="8">
              <Text id="space-context-heading" text="Context" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />

              <Repeat id="space-context-items" Source="{Binding selection.contextReferences}" As="reference" Key="{Binding reference.id}">
                <Container id="space-context-item" role="listitem" accessible-name="{Binding reference.label}" Type="Vertical Stack">
                  <Text id="space-context-item-label" text="{Binding reference.label}" />
                  <Text id="space-context-item-permission" text="{Binding reference.permissionLabel}" foreground="{Resource CuiTextSoftBrush}" />
                  <Text id="space-context-item-index-state" text="{Binding reference.indexStateLabel}" foreground="{Resource CuiTextSoftBrush}" />
                </Container>
              </Repeat>
              <If Condition="!{Binding selection.contextReferences.Count}">
                <Text id="space-context-empty-text" text="No sources added" foreground="{Resource CuiTextSoftBrush}" />
              </If>

              <Button id="add-context" action="AddContext" content="Add source" Interactive="{Binding selection.canEdit}" accessible-name="Add a source to this Space" />
              <Text id="space-access-heading" text="Model and access" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />
              <Text id="space-effective-model" text="{Binding selection.effectiveModelLabel}" accessible-name="Effective model" />
              <Text id="space-web-access" text="{Binding selection.webAccessLabel}" accessible-name="Web access policy" />
              <Text id="space-memory-scope" text="{Binding selection.memoryScopeLabel}" accessible-name="Memory scope" />

              <Text id="space-capabilities-heading" text="Capabilities" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />
              <Repeat id="space-capabilities" Source="{Binding selection.capabilities}" As="capability" Key="{Binding capability.id}">
                <Container id="space-capability" Type="Vertical Stack">
                  <Text id="space-capability-label" text="{Binding capability.label}" />
                </Container>
              </Repeat>
              <If Condition="!{Binding selection.capabilities.Count}">
                <Text id="space-capabilities-empty-text" text="No extra capabilities enabled" foreground="{Resource CuiTextSoftBrush}" />
              </If>
            </Container>
          </Container>
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>