<Cui id="spaces.chat.composer" version="1">
  <Actions>
    <Action name="composer.invoke-chip.Id" command="composer.invoke-chip" parameter="{Binding chip.Id}" />
    <Action name="composer.remove-chip.Id" command="composer.remove-chip" parameter="{Binding chip.Id}" />
    <Action name="composer.format.Bold" command="composer.format" parameter="Bold" />
    <Action name="composer.format.Italic" command="composer.format" parameter="Italic" />
    <Action name="composer.format.Code" command="composer.format" parameter="Code" />
    <Action name="composer.format.Link" command="composer.format" parameter="Link" />
    <Action name="composer.format.Quote" command="composer.format" parameter="Quote" />
    <Action name="composer.format.Bullet" command="composer.format" parameter="Bullet" />
    <Action name="composer.emoji-insert.Text" command="composer.emoji-insert" parameter="{Binding emoji.Text}" />
    <Action name="composer.set-action-mode.AllowAllActions" command="composer.set-action-mode" parameter="AllowAllActions" />
    <Action name="composer.set-action-mode.AllowBasicActions" command="composer.set-action-mode" parameter="AllowBasicActions" />
    <Action name="composer.set-action-mode.JustChat" command="composer.set-action-mode" parameter="JustChat" />
    <Action name="composer.set-response-mode.Auto" command="composer.set-response-mode" parameter="Auto" />
    <Action name="composer.set-response-mode.AlwaysVisual" command="composer.set-response-mode" parameter="AlwaysVisual" />
    <Action name="composer.set-response-mode.PreferVisual" command="composer.set-response-mode" parameter="PreferVisual" />
    <Action name="composer.set-response-mode.PreferText" command="composer.set-response-mode" parameter="PreferText" />
    <Action name="composer.set-response-mode.AlwaysText" command="composer.set-response-mode" parameter="AlwaysText" />
    <Action name="composer.toggle-formatting"><Toggle Target="FormattingOpen" /></Action>
    <Action name="composer.emoji-prev" command="query.previous" />
    <Action name="composer.emoji-next" command="query.next" />
  </Actions>
  <Variable Type="bool" ID="FormattingOpen">False</Variable>
  <Variable Type="string" ID="EmojiIcon" Source="{Binding Composer.EmojiIconCandidates}" Selection="RandomOnce" />
  <Container id="composer-surface" Type="Overlay Float" padding="12"
        background="{Resource CuiPanelBrush}" CornerRadius="28" accessible-name="Message composer"
        compound-focus="true" owns-backdrop="true">
    <Container id="composer-body" Type="Vertical Stack" CellGap="8">
    <Container id="chips-row" Type="Wrap" CellGap="6" IsVisible="{Binding Composer.HasChips}">
      <Repeat Source="{Binding Composer.Chips}" As="chip" Key="{Binding chip.Id}">
        <Container Type="Horizontal Stack" CellGap="4" padding="4" background="{Resource CuiPanelBrush}" CornerRadius="12">
          <Button action="composer.invoke-chip.Id" content="{Binding chip.Label}" font-size="11" Interactive="{Binding chip.Invokable}" accessible-name="{Binding chip.Label}" />
          <Button action="composer.remove-chip.Id" content="✕" font-size="11" accessible-name="Remove chip" />
        </Container>
      </Repeat>
    </Container>

    <Container id="input-column" Type="Vertical Stack" CellGap="4" MaxHeight="170">
      <Input id="composer-input" Type="Text" AcceptsReturn="True" Value="{Binding Composer.Draft}"
             placeholdertext="{Binding Composer.Placeholder}" embedded-input="true" BorderWidth="0"
             background="Transparent" padding="4" text-wrapping="Wrap" MinHeight="44" accessible-name="Message" />
    </Container>



    <Container id="controls-row" Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="8">
      <Container id="left-controls" Column="0" Type="Horizontal Stack" CellGap="6">
        <Button id="add-button" action="composer.add" Width="44" Height="44" Padding="6" CornerRadius="22"
                background="Transparent" Chromeless="true"
                accessible-name="Add files or actions" tooltip="Add files or actions">
          <Image Source="avares://Haven/Assets/plus.svg" Width="28" Height="28" />
        </Button>
        <Button id="format-button" action="composer.toggle-formatting" content="Aa" Width="44" Height="44" Padding="6"
                CornerRadius="22" font-size="22" background="Transparent" Chromeless="true"
                Selected="{Binding FormattingOpen}" IsVisible="{Binding Composer.ShowFormatting}"
                accessible-name="Open formatting toolbar" tooltip="Formatting" />
        <Button id="emoji-button" action="composer.emoji" IsVisible="{Binding Composer.ShowFormatting}"
                content="{Binding EmojiIcon}" font-size="24" background="Transparent" Width="44" Height="44" Padding="6"
                CornerRadius="22" Selected="{Binding Composer.ShowEmoji}" Chromeless="true"
                accessible-name="Insert emoji" tooltip="Insert emoji" />
      </Container>
      <Container id="right-controls" Column="2" Type="Horizontal Stack" CellGap="6">
        <Button id="settings-button" action="composer.settings" Width="44" Height="44" Padding="6" CornerRadius="22"
                background="Transparent" Chromeless="true" Selected="{Binding Composer.ShowSettings}"
                accessible-name="Thread settings" tooltip="Choose allowed actions and response style">
          <Image Source="avares://Haven/Assets/composer-settings.svg" Width="24" Height="24" />
        </Button>
        <Button id="cancel-edit-button" action="composer.cancel-edit" content="Cancel" MinHeight="44" IsVisible="{Binding Composer.IsEditing}" accessible-name="Cancel editing" />
        <Button id="send-button" action="composer.send" Width="44" Height="44" Padding="6" CornerRadius="22"
                background="{Resource CuiAccentPrimaryBrush}" Interactive="{Binding Composer.CanSend}"
                accessible-name="{Binding Composer.SendAccessibleName}" tooltip="{Binding Composer.SendTooltip}">
          <Image Source="avares://Haven/Assets/send.svg" Width="24" Height="24" />
        </Button>
      </Container>
    </Container>

    <Container id="emoji-panel" Type="Vertical Stack" CellGap="8" padding="8"
          background="{Resource CuiPanelBrush}" CornerRadius="16" IsVisible="{Binding Composer.ShowEmoji}" accessible-name="Emoji panel">
      <!-- The QueryViewport is the canonical CUI runtime state/query scope: it owns the search query
           string and opaque cursor; the authored Repeat/input/pager bind to its bounded window and
           metadata. All catalogue filtering/pagination stays behind the typed data port; no app C#
           query/page/cursor state exists. -->
      <Container id="emoji-query" Type="QueryViewport" CellGap="8" Source="{Binding Composer.EmojiCatalogueSource}">
        <Input id="emoji-search" Type="Text" Value="{Binding Query}" placeholdertext="Search emoji…" MinHeight="36" accessible-name="Search emoji" />
        <!-- Bounded vertical scroll viewport over the wrapping grid: finite width (inherited from
             the vertical panel) so the Wrap lays out multiple columns/rows, vertical scrolling only,
             and a MaxHeight cap. The generic Repeat emits each generated cell directly into this Wrap
             container's layout, so the grid is real rather than a hidden vertical column. -->
        <Container id="emoji-grid-viewport" Type="Wrap" CellGap="6" MaxWidth="320" MaxHeight="150"
              VerticalScrolling="True" HorizontalScrolling="False">
          <Repeat Source="{Binding Items}" As="emoji" Key="{Binding emoji.Text}">
            <Button action="composer.emoji-insert.Text" content="{Binding emoji.Text}" font-size="18" accessible-name="Insert {Binding emoji.Name}" />
          </Repeat>
        </Container>
        <!-- Real complete-catalogue paging: one bounded window is rendered; Prev/Next drive the typed
             cursor so every one of the full catalogue entries (including flags and trigger-excluded
             sequences) stays reachable. Full totals/result metadata stay truthful. -->
        <Container id="emoji-pager" Type="Horizontal Stack" CellGap="8" padding="4">
          <Button id="emoji-prev" action="composer.emoji-prev" content="‹" MinWidth="32" MinHeight="32"
                  IsVisible="{Binding HasPrevious}" accessible-name="Previous emoji page" />
          <Text id="emoji-page-start" text="{Binding PageStart}" font-size="12" VerticalAlignment="Center" />
          <Text id="emoji-page-sep" text="–" font-size="12" VerticalAlignment="Center" />
          <Text id="emoji-page-end" text="{Binding PageEnd}" font-size="12" VerticalAlignment="Center" />
          <Text id="emoji-page-of" text="/" font-size="12" VerticalAlignment="Center" />
          <Text id="emoji-total" text="{Binding TotalCount}" font-size="12" VerticalAlignment="Center" />
          <Button id="emoji-next" action="composer.emoji-next" content="›" MinWidth="32" MinHeight="32"
                  IsVisible="{Binding HasNext}" accessible-name="Next emoji page" />
        </Container>
      </Container>
    </Container>

    <Container id="settings-panel" Type="Wrap" CellGap="8" padding="8"
          background="{Resource CuiPanelBrush}" CornerRadius="16" IsVisible="{Binding Composer.ShowSettings}" accessible-name="Thread settings panel">
      <Text text="Actions:" font-size="12" font-weight="SemiBold" />
      <Button action="composer.set-action-mode.AllowAllActions" content="All" font-size="12" />
      <Button action="composer.set-action-mode.AllowBasicActions" content="Basic" font-size="12" />
      <Button action="composer.set-action-mode.JustChat" content="Just chat" font-size="12" />
      <Text text="Responses:" font-size="12" font-weight="SemiBold" />
      <Button action="composer.set-response-mode.Auto" content="Auto" font-size="12" />
      <Button action="composer.set-response-mode.AlwaysVisual" content="Always visual" font-size="12" />
      <Button action="composer.set-response-mode.PreferVisual" content="Prefer visual" font-size="12" />
      <Button action="composer.set-response-mode.PreferText" content="Prefer text" font-size="12" />
      <Button action="composer.set-response-mode.AlwaysText" content="Always text" font-size="12" />
    </Container>
    </Container>

    <Container id="composer-floating-layer" Type="Floating" Target="composer-body" Placement="Above">
    <Container id="format-toolbar" Type="Wrap" CellGap="6" padding="8"
          background="{Resource CuiPanelBrush}" CornerRadius="16" IsVisible="{Binding FormattingOpen}"
          accessible-name="Formatting toolbar">
      <Button action="composer.format.Bold" content="B" font-weight="Bold" MinWidth="36" MinHeight="36" accessible-name="Bold" tooltip="Bold" />
      <Button action="composer.format.Italic" content="I" font-style="Italic" MinWidth="36" MinHeight="36" accessible-name="Italic" tooltip="Italic" />
      <Button action="composer.format.Code" content="{ }" MinWidth="36" MinHeight="36" accessible-name="Inline code" tooltip="Inline code" />
      <Button action="composer.format.Link" content="🔗" MinWidth="36" MinHeight="36" accessible-name="Link" tooltip="Link" />
      <Button action="composer.format.Quote" content="❝" MinWidth="36" MinHeight="36" accessible-name="Quote" tooltip="Quote" />
      <Button action="composer.format.Bullet" content="•" MinWidth="36" MinHeight="36" accessible-name="Bullet list" tooltip="Bullet list" />
    </Container>
    </Container>
  </Container>
</Cui>
