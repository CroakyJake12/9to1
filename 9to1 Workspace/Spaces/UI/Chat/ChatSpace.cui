<Cui id="spaces.chat" version="1">
  <Page id="chat-space" accessible-name="Chat Space">
    <Container id="chat-layout" Type="Horizontal Stack" CellGap="16">
      <Container id="recent-chats" Type="Vertical Stack" CellGap="8" accessible-name="Recent chats">
        <Text id="recent-chats-title" text="Recent chats" font-size="18" />
        <Button id="new-chat" action="chat.new" content="New chat" accessible-name="Start a new chat" />
        <Input id="recent-search" Type="Text" Value="{Binding RecentSearchQuery}" placeholdertext="Search chats" accessible-name="Search recent chats" />
        <Repeat Source="{Binding RecentChats}" As="recent" Key="{Binding recent.Id}">
          <Button id="recent-row" action="chat.open" action-argument="{Binding recent.Id}" content="{Binding recent.Title}" accessible-name="Open this conversation" Interactive="{Binding recent.IsCurrent}" />
          <Text text="{Binding recent.UpdatedLabel}" text-wrapping="Wrap" accessible-name="Conversation last updated" />
        </Repeat>
      </Container>

      <Container id="conversation" Type="Vertical Stack" CellGap="12" accessible-name="Conversation">
        <Container id="conversation-toolbar" Type="Wrap" CellGap="8" accessible-name="Conversation controls">
          <Text id="conversation-title" text="{Binding Conversation.Title}" font-size="24" text-wrapping="Wrap" />
          <Input id="model-choice" Type="Select" Items="{Binding Models}" Value="{Binding Composer.SelectedModelName}" action="chat.select-model" accessible-name="Choose model" />
          <Input id="branch-choice" Type="Select" Items="{Binding Conversation.Branches}" Value="{Binding Conversation.CurrentBranchId}" action="chat.switch-branch" accessible-name="Choose conversation branch" />
        </Container>

        <Container id="transcript" Type="Vertical Stack" CellGap="12" accessible-name="Conversation messages">
          <Repeat Source="{Binding Conversation.Messages}" As="message" Key="{Binding message.Id}">
            <Container id="message" Type="Vertical Stack" CellGap="6" accessible-name="One conversation message">
              <Text text="{Binding message.SpeakerLabel}" font-weight="SemiBold" />
              <Text text="{Binding message.Content}" text-wrapping="Wrap" accessible-name="Message content" />
              <Repeat Source="{Binding message.Attachments}" As="attachment" Key="{Binding attachment.Id}">
                <Text text="{Binding attachment.Name}" accessible-name="Attached file" />
              </Repeat>
              <Repeat Source="{Binding message.Citations}" As="citation" Key="{Binding citation.Number}">
                <Text text="{Binding citation.Title}" text-wrapping="Wrap" accessible-name="Citation source" />
              </Repeat>
              <Repeat Source="{Binding message.ToolActivities}" As="activity" Key="{Binding activity.Id}">
                <Text text="{Binding activity.Name}" accessible-name="Tool activity" />
              </Repeat>
              <Container id="message-actions" Type="Wrap" CellGap="8" accessible-name="Message actions">
                <Button action="chat.branch" action-argument="{Binding message.Id}" content="Branch" accessible-name="Branch from this message" />
                <Button action="chat.regenerate" action-argument="{Binding message.Id}" content="Regenerate" accessible-name="Regenerate this response" Interactive="{Binding message.CanRegenerate}" />
              </Container>
            </Container>
          </Repeat>
        </Container>

        <Container id="composer" Type="Vertical Stack" CellGap="8" accessible-name="Message composer">
          <Repeat Source="{Binding Composer.Attachments}" As="attachment" Key="{Binding attachment.Id}">
            <Button action="chat.remove-attachment" action-argument="{Binding attachment.Id}" content="{Binding attachment.Name}" accessible-name="Remove this attachment" />
          </Repeat>
          <Input id="composer-input" Type="Text" Multiline="true" Value="{Binding Composer.Draft}" placeholdertext="Message" accessible-name="Message" />
          <Container id="composer-actions" Type="Wrap" CellGap="8">
            <Button id="attach" action="chat.attach" content="Attach" accessible-name="Attach a file" />
            <Button id="send" action="chat.send" content="Send" accessible-name="Send message" Interactive="{Binding Composer.CanSend}" />
          </Container>
        </Container>

        <Text id="chat-status" text="{Binding Status.Message}" accessible-name="Chat status" />
      </Container>
    </Container>
  </Page>
</Cui>