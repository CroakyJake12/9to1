<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HavenOS.Spaces</AssemblyName>
    <RootNamespace>HavenOS.Apps.Spaces</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <Import Project="../../framework/CUI/Compiler/buildTransitive/CakeOS.Cui.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="HavenOS.Spaces.Tests" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Presentation.Tests\**\*.cs" />
    <ProjectReference Include="..\..\framework\CUI\Core\CakeOS.Cui.Core.csproj" />
    <!--
      CUI Runtime supplies the binding interfaces the Chat Space projection implements
      (ICuiBindingContext, ICuiActionDispatcher, ICuiRepeatItemBindingContext, CuiViewModel).
      Core alone only carries the document model, so this reference is required for the authored
      ChatSpace.cui to be usable at all.
    -->
    <ProjectReference Include="..\..\framework\CUI\Runtime\CakeOS.Cui.Runtime.csproj" />
    <ProjectReference Include="..\shared\src\Haven.Application\Haven.Application.csproj" />
    <ProjectReference Include="..\shared\src\Haven.Core\Haven.Core.csproj" />
    <ProjectReference Include="..\shared\src\Haven.UI\Haven.UI.csproj" />
    <!-- Single maintained vector adapter, shared with the canonical web host. -->
    <Compile Include="..\..\apps\Web\BrowserCanonicalIcons.cs" Link="UI\Home\BrowserCanonicalIcons.cs" />
    <ProjectReference Include="..\Dev\HavenOS.Dev.csproj" />
    <EmbeddedResource Include="UI\Tasks\SpaceTaskWidget.cui" LogicalName="HavenOS.Apps.Spaces.UI.Tasks.SpaceTaskWidget.cui" />
    <EmbeddedResource Include="UI\Chat\ChatSpace.cui" LogicalName="HavenOS.Apps.Spaces.UI.Chat.ChatSpace.cui" />
    <EmbeddedResource Include="UI\Home\SpacesHome.cui" LogicalName="HavenOS.Apps.Spaces.UI.Home.SpacesHome.cui" />
    <EmbeddedResource Include="UI\Builder\SpaceDetails.cui" LogicalName="HavenOS.Apps.Spaces.UI.Builder.SpaceDetails.cui" />
    <EmbeddedResource Include="UI\Builder\SpaceBuilder.cui" LogicalName="HavenOS.Apps.Spaces.UI.Builder.SpaceBuilder.cui" />
    <!-- The Voice &amp; Vision pill and full session documents are stateless, so the canonical CUI
         build emits them into the genuine V1 compiled bundle (CUI.Compilation.v1) under their
         project-relative source names. The raw .cui is also snapshotted for stateless identity. -->
    <EmbeddedResource Include="UI\VoiceVision\VoiceVisionPill.cui" LogicalName="HavenOS.Apps.Spaces.UI.VoiceVision.VoiceVisionPill.cui" />
    <EmbeddedResource Include="UI\VoiceVision\VoiceVisionSession.cui" LogicalName="HavenOS.Apps.Spaces.UI.VoiceVision.VoiceVisionSession.cui" />
    <None Update="UI\Chat\ChatSpace.cui" CopyToOutputDirectory="PreserveNewest" />
    <None Update="UI\Home\SpacesHome.cui" CopyToOutputDirectory="PreserveNewest" />
    <None Update="UI\VoiceVision\VoiceVisionPill.cui" CopyToOutputDirectory="PreserveNewest" />
    <None Update="UI\VoiceVision\VoiceVisionSession.cui" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../framework/CUI/Compiler/buildTransitive/CakeOS.Cui.targets" />
</Project>
