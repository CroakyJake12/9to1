<Cui id="ui-customanimationtimingtab" product="9-1" version="1">
  <Container id="timing-tab" Type="Vertical Stack" cell-gap="12" role="Grow">
    <Container id="container" Type="Vertical Stack">
      <Container id="grid2" Type="Grid" role="Grow">
        <Text id="start-label" text="Start:" />
        <Text id="delay-label" text="Delay:" />
        <Text id="duration-label" text="Duration:" />
        <Text id="repeat-label" text="Repeat:" />
        <Input id="start-list" Type="Select" vertical-alignment="Center" role="Grow" />
        <Input id="delay-value" Type="Number" vertical-alignment="Center" role="Grow" />
        <Input id="anim-duration" Type="Number" vertical-alignment="Center" role="Grow" />
        <Input id="repeat-list" Type="Select" vertical-alignment="Center" role="Grow" />
        <Input id="rewind" Type="Checkbox" text="Rewind when done playing" column-span="2" />
      </Container>
      <Text id="label1" text="Timing" />
    </Container>
    <Container id="frame3" Type="Vertical Stack">
      <Container id="box6" Type="Vertical Stack" cell-gap="6">
        <Input id="rb-click-sequence" Type="Radio" text="Animate as part of click sequence" checked="true" />
        <Container id="container-2" Type="Vertical Stack" cell-gap="12">
          <Input id="rb-interactive" Type="Radio" text="Start effect on click of:" />
          <Input id="trigger-list" Type="Select" vertical-alignment="Center" role="Grow" />
        </Container>
      </Container>
      <Text id="label11" text="Trigger" />
    </Container>
  </Container>
</Cui>
