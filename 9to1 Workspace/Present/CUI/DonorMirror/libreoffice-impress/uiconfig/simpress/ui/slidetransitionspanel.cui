<Cui id="ui-slidetransitionspanel" product="9-1" version="1">
  <Page id="ui-slidetransitionspanel-root">
    <Image id="image1" focusable="false" source="sd/res/playblue16.png" />
    <Container id="slide-transitions-panel" Type="Vertical Stack" focusable="false" role="Grow">
      <Container id="box1" Type="Vertical Stack" cell-gap="12" focusable="false" role="Grow">
        <Container id="transitions-icons-scrolled-window" Type="Vertical Stack" role="Grow">
          <Container id="transitions-icons" Type="Wrap" role="Grow" />
        </Container>
        <Container id="frame1" Type="Vertical Stack" focusable="false">
          <Container id="grid2" Type="Grid" cell-gap="6" focusable="false">
            <Text id="duration-label" text="Duration:" horizontal-alignment="Right" focusable="false" column="0" row="1" />
            <Input id="transition-duration" Type="Number" tooltip="Select the speed of Slide Transition." role="Grow" column="1" row="1" />
            <Text id="sound-label" text="Sound:" horizontal-alignment="Right" focusable="false" column="0" row="2" />
            <Input id="sound-list" Type="Select" focusable="false" role="Grow" column="1" row="2" />
            <Input id="loop-sound" Type="Checkbox" text="Loop until next sound" column="1" row="3" />
            <Text id="variant-label" text="Variant:" horizontal-alignment="Right" focusable="false" column="0" row="0" />
            <Input id="variant-list" Type="Select" focusable="false" column="1" row="0" />
          </Container>
          <Text id="label1" text="Modify Transition" focusable="false" />
        </Container>
        <Container id="frame2" Type="Vertical Stack" focusable="false">
          <Container id="grid1" Type="Grid" cell-gap="6" focusable="false">
            <Input id="rb-mouse-click" Type="Radio" text="On mouse click" checked="true" column="0" row="0" column-span="2" />
            <Input id="rb-auto-after" Type="Radio" text="After:" column="0" row="1" />
            <Input id="auto-after-value" Type="Number" role="Grow" column="1" row="1" />
          </Container>
          <Text id="label2" text="Advance Slide" focusable="false" />
        </Container>
        <Container id="box2" Type="Vertical Stack" cell-gap="6" focusable="false">
          <Container id="buttonbox1" Type="Horizontal Stack" focusable="false">
            <Button id="apply-to-all" content="Apply Transition to All Slides" text="Apply Transition to All Slides" horizontal-alignment="Center" />
          </Container>
          <Container id="separator1" Type="Horizontal Stack" focusable="false" />
          <Container id="box3" Type="Vertical Stack" cell-gap="18" focusable="false">
            <Input id="auto-preview" Type="Checkbox" text="Automatic Preview" />
            <Button id="play" content="Play" text="Play" tooltip="Preview Effect" />
          </Container>
        </Container>
        <Container id="repeat-after-frame" Type="Vertical Stack" focusable="false">
          <Container id="grid3" Type="Grid" cell-gap="6" focusable="false">
            <Input id="rb-disabled" Type="Radio" text="Disabled" checked="true" column="0" row="0" column-span="2" />
            <Input id="rb-auto-repeat" Type="Radio" text="After :" column="0" row="1" />
            <Input id="rb-auto-repeat-value" Type="Number" role="Grow" column="1" row="1" />
          </Container>
          <Text id="label3" text="Repeat Slideshow" focusable="false" />
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
