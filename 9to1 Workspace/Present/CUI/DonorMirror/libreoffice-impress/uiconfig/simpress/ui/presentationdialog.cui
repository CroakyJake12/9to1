            <Container id="grid" Type="Grid" cell-gap="12" focusable="false" column="0" row="2">
              <Input id="customslideshow" Type="Radio" text="Custom slide show:" column="0" row="0" />
              <Input id="customslideshow-cb" Type="Select" focusable="false" role="Grow" column="1" row="0" />
            </Container>
          </Container>
          <Text id="label1" text="Range" focusable="false" />
        </Container>
        <Container id="grid2" Type="Grid" cell-gap="12" focusable="false" column="0" row="1">
          <Container id="frame2" Type="Vertical Stack" focusable="false" role="Grow" column="0" row="0">
            <Container id="grid3" Type="Grid" cell-gap="6" focusable="false" role="Grow">
