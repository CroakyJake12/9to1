            <Input id="enableremoteinsecure" Type="Checkbox" text="Enable insecure WiFi connections" tooltip="In addition to Bluetooth connections, enable insecure and unencrypted connections via IP on all network interfaces. Not recommended in public settings." column="0" row="1" />
