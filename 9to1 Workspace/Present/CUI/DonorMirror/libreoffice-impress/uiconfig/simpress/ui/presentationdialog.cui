              <Input id="window" Type="Radio" text="In a window" column="0" row="1" />
              <Input id="auto" Type="Checkbox" text="Loop and repeat after:" column="0" row="2" />
              <Input id="pauseduration" Type="Number" tooltip="Duration of pause" is-enabled="false" column="0" row="3" />
              <Input id="showlogo" Type="Checkbox" text="Show logo during pause" column="0" row="4" />
            </Container>
            <Text id="label2" text="Presentation Mode" focusable="false" />
          </Container>
          <Container id="frame4" Type="Vertical Stack" focusable="false" role="Grow" column="1" row="0">
            <Container id="grid4" Type="Grid" cell-gap="6" focusable="false" role="Grow">
              <Input id="manualslides" Type="Checkbox" text="Disable automatic change of slides" column="0" row="0" />
              <Input id="changeslidesbyclick" Type="Checkbox" text="Change slides by clicking on background" column="0" row="1" />
              <Input id="pointervisible" Type="Checkbox" text="Mouse pointer visible" column="0" row="2" />
              <Input id="pointeraspen" Type="Checkbox" text="Mouse pointer as pen" column="0" row="3" />
              <Input id="animationsallowed" Type="Checkbox" text="Enable animated images" column="0" row="4" />
              <Input id="alwaysontop" Type="Checkbox" text="Keep Presentation always on top" column="0" row="5" />
              <Input id="enableinteractivemode" Type="Checkbox" text="Live-mode slideshow editing" column="0" row="6" />
            </Container>
            <Text id="label4" text="Presentation Options" focusable="false" />
          </Container>
        </Container>
        <Container id="frame3" Type="Vertical Stack" focusable="false" role="Grow" column="0" row="2">
          <Container id="grid7" Type="Grid" focusable="false" role="Grow">
