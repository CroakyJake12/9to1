<Cui id="ui-presentationdialog" product="9-1" version="1">
  <Container id="presentation-dialog" Type="Vertical Stack" modal="True" focusable="false">
    <Text id="presentation-dialog-label" text="Slide Show Settings" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12" focusable="false">
      <Container id="dialog-action-area1" Type="Horizontal Stack" focusable="false">
        <Button id="ok" content="OK" text="OK" />
        <Button id="cancel" content="Cancel" text="Cancel" />
        <Button id="help" content="Help" text="Help" />
      </Container>
      <Container id="grid1" Type="Grid" cell-gap="12" focusable="false" role="Grow">
        <Container id="frame1" Type="Vertical Stack" focusable="false" role="Grow" column="0" row="0">
          <Container id="grid5" Type="Grid" cell-gap="6" focusable="false">
            <Input id="allslides" Type="Radio" text="All slides" checked="true" column="0" row="0" />
            <Container id="grid6" Type="Grid" cell-gap="12" focusable="false" column="0" row="1">
              <Input id="from" Type="Radio" text="From:" column="0" row="0" />
