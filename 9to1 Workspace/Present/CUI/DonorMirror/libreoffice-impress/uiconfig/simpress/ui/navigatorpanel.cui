<Cui id="ui-navigatorpanel" product="9-1" version="1">
  <Page id="ui-navigatorpanel-root">
    <Container id="dragmodemenu" Type="Menu" focusable="false">
      <Button id="1" content="Insert as Hyperlink" text="Insert as Hyperlink" focusable="false" />
      <Button id="2" content="Insert as Link" text="Insert as Link" focusable="false" />
      <Button id="3" content="Insert as Copy" text="Insert as Copy" focusable="false" />
    </Container>
    <Container id="navigator-panel" Type="Grid" focusable="false" role="Grow">
      <Container id="container" Type="Grid" cell-gap="3" focusable="false" role="Grow" column="0" row="0">
        <Input id="documents" Type="Select" tooltip="Open Documents" focusable="false" column="0" row="2" />
        <Container id="container-2" Type="Vertical Stack" role="Grow" column="0" row="1">
          <Container id="tree" Type="Vertical Stack" width="-1" role="Grow" />
        </Container>
        <Container id="toolbox" Type="Toolbar" role="Grow" column="0" row="0">
          <Button id="first" icon-source="sd/res/nv03.png" />
          <Button id="previous" icon-source="sd/res/nv04.png" />
          <Button id="next" icon-source="sd/res/nv05.png" />
          <Button id="last" icon-source="sd/res/nv06.png" />
          <Container id="separator" Type="Separator" horizontal-alignment="Right" focusable="false" role="Grow" />
          <Button id="dragmode" icon-source="sd/res/nv09.png" tooltip="Drag Mode" />
          <Button id="shapes" icon-source="sd/res/graphic.png" tooltip="Show Shapes" />
        </Container>
      </Container>
    </Container>
    <Container id="shapemenu" Type="Menu" focusable="false">
      <Button id="named" content="Named shapes" text="Named shapes" focusable="false" />
      <Button id="all" content="All shapes" text="All shapes" focusable="false" />
      <Button id="button" Type="Menu Item" focusable="false" />
      <Button id="fronttoback" content="Front to back" text="Front to back" focusable="false" />
      <Button id="backtofront" content="Back to front" text="Back to front" focusable="false" />
    </Container>
  </Page>
</Cui>
