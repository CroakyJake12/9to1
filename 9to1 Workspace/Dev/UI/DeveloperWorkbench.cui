<Cui id="dev.project-workbench" version="1">
  <Actions>
    <Action name="dev.open-project-entry" command="dev.open-project-entry" parameter="{Binding item.SelectionKey}" />
    <Action name="dev.select-source-tab" command="dev.select-source-tab" parameter="{Binding item.SelectionKey}" />
    <Action name="dev.close-source-tab" command="dev.close-source-tab" parameter="{Binding item.SelectionKey}" />
    <Action name="dev.open-search-result" command="dev.open-search-result" parameter="{Binding searchHit.SelectionKey}" />
    <Action name="dev.inspect-recovered-draft" command="dev.inspect-recovered-draft" parameter="{Binding recovered.SelectionKey}" />
  </Actions>
  <Page>
    <Container id="dev-workbench" margin="16" accessible-name="Development project workspace" Type="Vertical Stack" CellGap="12">
      <Text id="dev-project-title" text="{Binding ProjectTitle}" font-size="24" text-wrapping="Wrap" />
      <Text text="{Binding ProjectSummary}" text-wrapping="Wrap" accessible-name="Existing project and task" />
      <Container Type="Wrap">
        <Button id="dev-refresh" action="dev.refresh" content="Refresh project" />
        <Button id="dev-tree" action="dev.tree" content="Project files" />
        <Button id="dev-git-status" action="dev.git-status" content="Git status" />
        <Button id="dev-git-diff" action="dev.git-diff" content="Working-tree diff" />
        <Button id="dev-git-branches" action="dev.git-branches" content="Branches" />
      </Container>
      <Text text="{Binding Files}" text-wrapping="Wrap" accessible-name="Observed project file tree" IsVisible="{Binding ShowLegacyFiles}" />
      <Container Type="Vertical Stack" CellGap="6" IsVisible="{Binding ShowProjectExplorer}" accessible-name="Project explorer">
        <Container Type="Wrap" CellGap="6">
          <Text text="{Binding ProjectFolder}" font-size="18" />
          <Button id="dev-project-folder-up" action="dev.project-folder-up" content="Parent folder" Interactive="{Binding CanProjectFolderUp}" />
        </Container>
        <Repeat id="dev-project-entries" Source="{Binding ProjectEntries}" As="item" Key="{Binding item.SelectionKey}">
          <Container Type="Horizontal Stack" CellGap="8">
            <Button id="dev-open-project-entry" action="dev.open-project-entry" content="{Binding item.Name}" accessible-name="{Binding item.AccessibleName}" Interactive="{Binding item.CanOpen}" />
            <Text text="{Binding item.Details}" foreground="{Resource CuiTextSoftBrush}" />
          </Container>
        </Repeat>
        <Container Type="Wrap" CellGap="6">
          <Button id="dev-project-entries-previous" action="dev.project-entries-previous" content="Previous files" Interactive="{Binding CanProjectEntriesPrevious}" />
          <Button id="dev-project-entries-next" action="dev.project-entries-next" content="Next files" Interactive="{Binding CanProjectEntriesNext}" />
        </Container>
        <Text text="{Binding ProjectExplorerStatus}" text-wrapping="Wrap" foreground="{Resource CuiTextSoftBrush}" />
      </Container>
      <Input id="dev-source-path" placeholdertext="Select an existing project file" accessible-name="Project-relative source file" Type="Text" Value="{Binding SourcePath}" />
      <Button id="dev-open-source" action="dev.open-source" content="Open source" Interactive="{Binding CanOpenSource}" />
      <Input id="dev-search-query" placeholdertext="Search project text" accessible-name="Project search query" Type="Text" Value="{Binding SearchQuery}" />
      <Container Type="Wrap" CellGap="8">
        <Input id="dev-search-match-case" Type="Checkbox" content="Match case" Checked="{Binding SearchMatchCase, mode=TwoWay}" Interactive="{Binding CanStructuredSearch}" />
        <Input id="dev-search-regex" Type="Checkbox" content="Regular expression" Checked="{Binding SearchUseRegex, mode=TwoWay}" Interactive="{Binding CanStructuredSearch}" accessible-name="Search saved source with a per-line regular expression" />
        <Button id="dev-search" action="dev.search" content="Search files" />
      </Container>
      <Text text="{Binding SearchResults}" text-wrapping="Wrap" accessible-name="Actual file search results" />
      <Container Type="Vertical Stack" CellGap="4" max-height="240" VerticalScrolling="True" accessible-name="Matching saved source files">
        <Repeat id="dev-search-matches" Source="{Binding ProjectSearchMatches}" As="searchHit" Key="{Binding searchHit.SelectionKey}">
          <Button id="dev-open-search-result" action="dev.open-search-result" accessible-name="{Binding searchHit.AccessibleName}" Interactive="{Binding searchHit.CanOpen}" horizontal-content-alignment="Left">
            <Text text="{Binding searchHit.Label}" text-wrapping="Wrap" />
          </Button>
        </Repeat>
      </Container>
      <Container Type="Wrap" CellGap="6" accessible-name="Open source documents">
        <Repeat id="dev-source-tabs" Source="{Binding SourceTabs}" As="item" Key="{Binding item.SelectionKey}">
          <Container Type="Horizontal Stack" CellGap="2">
            <Button id="dev-select-source-tab" action="dev.select-source-tab" content="{Binding item.Label}" accessible-name="{Binding item.AccessibleName}" Interactive="{Binding item.CanSelect}" />
            <Button id="dev-close-source-tab" action="dev.close-source-tab" content="×" accessible-name="{Binding item.CloseAccessibleName}" Interactive="{Binding item.CanClose}" />
          </Container>
        </Repeat>
        <Button id="dev-pin-source-tab" action="dev.toggle-source-tab-pin" content="{Binding SourceTabPinLabel}" accessible-name="Pin or unpin the selected source tab" Interactive="{Binding CanPinSourceTab}" />
      </Container>
      <Text text="{Binding SourceTabsStatus}" foreground="{Resource CuiTextSoftBrush}" text-wrapping="Wrap" accessible-name="Open source document status" />
      <Text text="{Binding EditorTitle}" text-wrapping="Wrap" accessible-name="Selected source and draft revision" />
      <Container Type="Vertical Stack" CellGap="8" IsVisible="{Binding HasRecoveredConflicts}" accessible-name="Protected drafts requiring explicit reconciliation">
        <Text text="Your saved drafts are safe. Source changed while they were closed." font-size="18" text-wrapping="Wrap" />
        <Repeat id="dev-recovered-drafts" Source="{Binding RecoveredDraftCandidates}" As="recovered" Key="{Binding recovered.SelectionKey}">
          <Button id="dev-inspect-recovered-draft" action="dev.inspect-recovered-draft" content="{Binding recovered.Label}" accessible-name="{Binding recovered.AccessibleName}" Interactive="{Binding recovered.CanInspect}" />
        </Repeat>
        <Text text="{Binding RecoveredDraftSummary}" text-wrapping="Wrap" accessible-name="Current source and retained draft revision identities" />
        <Text text="Current source" />
        <Object type="ReadOnlyText" id="dev-recovery-current" text="{Binding RecoveredCurrentSource}" font-family="monospace" min-height="100" accessible-name="Freshly authorised current source for recovery comparison" />
        <Text text="Your retained draft" />
        <Object type="ReadOnlyText" id="dev-recovery-retained" text="{Binding RecoveredRetainedDraft}" font-family="monospace" min-height="100" accessible-name="Protected unsaved draft for recovery comparison" />
        <Text text="Merge your changes" />
        <Input id="dev-recovery-merged" Type="Text" Value="{Binding RecoveredMergedDraft}" Multiline="true" font-family="monospace" min-height="160" accessible-name="Editable merged recovery draft; current source and original retained draft stay unchanged" Interactive="{Binding CanEditRecoveryMerge}" />
        <Button id="dev-use-merged-recovered-draft" action="dev.use-merged-recovered-draft" content="Use merged draft" accessible-name="Use this merged draft against freshly read current source; review is required before saving" Interactive="{Binding CanUseMergedRecoveredDraft}" />
        <Button id="dev-reconcile-recovered-draft" action="dev.reconcile-recovered-draft" content="Use recovered draft against current source" accessible-name="Explicitly reconcile this retained draft against freshly read current source; review is still required before writing" Interactive="{Binding CanReconcileRecoveredDraft}" />
      </Container>
      <Container Type="Horizontal Stack" CellGap="8">
        <Input id="dev-source-location" Type="Text" Value="{Binding SourceLocation}" placeholdertext="Line or line:column" accessible-name="Source line and optional column" />
        <Button id="dev-go-to-source-location" action="dev.go-to-source-location" content="Go to" accessible-name="Go to line and column in the current source draft" Interactive="{Binding CanGoToSourceLocation}" />
      </Container>
      <Text text="Find and replace literal text" />
      <Container Type="Wrap" CellGap="8">
        <Input id="dev-source-find" Type="Text" Value="{Binding SourceFindQuery}" placeholdertext="Find in this draft" accessible-name="Literal text to find in the current source draft" />
        <Input id="dev-source-find-case" Type="Checkbox" Checked="{Binding SourceFindMatchCase}" Content="Match case" accessible-name="Match literal text case" />
        <Button id="dev-find-previous-source" action="dev.find-previous-source" content="Find previous" Interactive="{Binding CanFindSourceText}" />
        <Button id="dev-find-next-source" action="dev.find-next-source" content="Find next" Interactive="{Binding CanFindSourceText}" />
      </Container>
      <Container Type="Wrap" CellGap="8">
        <Input id="dev-source-replacement" Type="Text" Value="{Binding SourceReplaceText}" placeholdertext="Replacement text" accessible-name="Literal replacement text; an empty value removes the found text" />
        <Button id="dev-replace-source-match" action="dev.replace-source-match" content="Replace found match" Interactive="{Binding CanReplaceSourceMatch}" />
        <Button id="dev-replace-all-source" action="dev.replace-all-source" content="Replace all in draft" Interactive="{Binding CanFindSourceText}" />
      </Container>
      <Text text="{Binding SourceFindStatus}" text-wrapping="Wrap" accessible-name="Current draft find and replace result" />
      <Input id="dev-code-editor" font-family="monospace" min-height="280" accessible-name="Complete source editor" Type="Text" Value="{Binding DraftText}" TextSelection="{Binding EditorTextSelection}" Multiline="true" Interactive="{Binding CanEditSource}" />
      <Container Type="Wrap">
        <Button id="dev-preview-edit" action="dev.preview-edit" content="Review this edit" Interactive="{Binding CanPreview}" />
        <Button id="dev-apply-edit" action="dev.apply-edit" content="Apply reviewed edit" Interactive="{Binding CanApply}" />
        <Button id="dev-save-reviewed" action="dev.save-reviewed" content="Save reviewed" accessible-name="Save all current reviewed drafts through individual Home write approvals" Interactive="{Binding CanSaveReviewed}" />
        <Button id="dev-revert-pass" action="dev.revert-pass" content="Prepare last pass revert" Interactive="{Binding CanRevert}" />
      </Container>
      <Text text="{Binding SaveReviewedStatus}" text-wrapping="Wrap" accessible-name="Actual per-file save outcomes" />
      <Text text="{Binding ReviewSummary}" text-wrapping="Wrap" accessible-name="This edit pass only" />
      <Text text="Before this pass" font-size="18" />
      <Object type="ReadOnlyText" id="dev-pass-before" text="{Binding BeforeText}" font-family="monospace" min-height="100" accessible-name="Exact source before this pass" />
      <Text text="After this pass" font-size="18" />
      <Object type="ReadOnlyText" id="dev-pass-after" text="{Binding AfterText}" font-family="monospace" min-height="100" accessible-name="Exact proposed source after this pass" />
      <Input id="dev-terminal-command" placeholdertext="Explicit command in this project" accessible-name="Terminal command" Type="Text" Value="{Binding Command}" />
      <Button id="dev-terminal-run" action="dev.run-command" content="Run command" />
      <Input id="dev-test-command" placeholdertext="Explicit test command" accessible-name="Test command" Type="Text" Value="{Binding TestCommand}" />
      <Button id="dev-test-run" action="dev.run-tests" content="Run tests" />
      <Text text="Saved build stages" font-size="18" />
      <Text text="{Binding SavedBuildStagesStatus}" text-wrapping="Wrap" accessible-name="Saved build stage availability" />
      <Repeat id="dev-saved-build-stages" Source="{Binding SavedBuildStages}" As="stage" Key="{Binding stage.SelectionKey}">
        <Container Type="Vertical Stack" CellGap="4">
          <Button id="dev-select-build-stage" action="dev.select-build-stage" content="{Binding stage.Label}" accessible-name="{Binding stage.AccessibleName}" Interactive="{Binding stage.CanSelect}" />
          <Text text="{Binding stage.Details}" text-wrapping="Wrap" />
        </Container>
      </Repeat>
      <Text text="{Binding SelectedBuildStageSummary}" text-wrapping="Wrap" accessible-name="Selected saved stage command environment revision and dependencies" />
      <Input id="dev-stage-task" placeholdertext="Saved build task ID" accessible-name="Saved build task ID" Type="Text" Value="{Binding StageTaskId}" />
      <Input id="dev-stage-id" placeholdertext="Saved build stage ID" accessible-name="Saved build stage ID" Type="Text" Value="{Binding StageId}" />
      <Button id="dev-build-stage" action="dev.run-stage" content="Run selected saved stage" Interactive="{Binding CanRunSavedStage}" />
      <Input id="dev-branch-name" placeholdertext="Literal branch name" accessible-name="Git branch name" Type="Text" Value="{Binding BranchName}" />
      <Container Type="Wrap">
        <Button id="dev-create-branch" action="dev.create-branch" content="Create branch" />
        <Button id="dev-switch-branch" action="dev.switch-branch" content="Switch branch" />
      </Container>
      <Text text="{Binding ProcessStatus}" text-wrapping="Wrap" accessible-name="Observed command exit and timeout" />
      <Object type="ReadOnlyText" id="dev-terminal-output" text="{Binding ProcessOutput}" font-family="monospace" min-height="180" accessible-name="Actual standard output and error" />
      <Text text="{Binding Status}" text-wrapping="Wrap" accessible-name="Development operation status" />
    </Container>
  </Page>
</Cui>
