<Cui id="9to1.Stacks.Workspace" version="1">
  <Actions>
    <Action name="OpenProject" command="9to1.Stacks.OpenProject" parameter="{Binding project.Target}" />
    <Action name="OpenTab" command="9to1.Stacks.OpenProject" parameter="{Binding tab.Target}" />
    <Action name="SelectDomain" command="9to1.Stacks.SelectDomain" parameter="{Binding domain.Target}" />
    <Action name="SelectFile" command="9to1.Stacks.SelectFile" parameter="{Binding file.Target}" />
    <Action name="SelectConflictProposal" command="9to1.Stacks.SelectConflictProposal" parameter="{Binding proposal.Target}" />
    <Action name="RejectConflictProposal" command="9to1.Stacks.RejectConflictProposal" parameter="{Binding ReviewTarget}" />
    <Action name="AcceptConflictProposalWithoutMerge" command="9to1.Stacks.AcceptConflictProposalWithoutMerge" parameter="{Binding ReviewTarget}" />
    <Action name="AcceptConflictProposalAndMerge" command="9to1.Stacks.AcceptConflictProposalAndMerge" parameter="{Binding ReviewTarget}" />
  </Actions>
  <Page>
    <Container margin="12" Type="Grid" RowSizes="Auto Auto 1fr Auto">
      <Container Type="Overlay" HorizontalScrolling="True" VerticalScrolling="False">
        <Container Type="Horizontal Stack" CellGap="8">
          <Button name="StacksHome" action="9to1.Stacks.Home" content="Home" accessible-name="Stacks Home" />
          <Repeat source="{Binding Tabs}" as="tab" key="{Binding tab.Key}">
            <Button action="OpenTab" content="{Binding tab.Label}" accessible-name="{Binding tab.Label}" />
          </Repeat>
        </Container>
      </Container>
      <Container margin="0,8" Type="Horizontal Stack" Row="1" CellGap="8">
        <Button name="StacksBack" action="9to1.Stacks.Back" content="Back" />
        <Button name="StacksForward" action="9to1.Stacks.Forward" content="Forward" />
        <Button name="StacksRefresh" action="9to1.Stacks.Refresh" content="Refresh" />
        <Text text="{Binding ProjectLabel}" />
      </Container>
      <Container Type="Overlay" Row="2" VerticalScrolling="True" HorizontalScrolling="False">
        <Container Type="Vertical Stack" CellGap="10">
          <Container Type="Vertical Stack" Active="{Binding IsHome}" CellGap="8">
            <Container Type="Horizontal Stack" CellGap="8">
              <Button action="9to1.Stacks.Home" content="Projects" />
              <Button action="9to1.Stacks.About" content="About" />
            </Container>
            <Text text="{Binding HomePage}" font-size="20" />
            <Text text="Stacks connects a project's shared source with its Main, Branch, Twig and Leaf development domains. Open a project to inspect inherited source, save your own working changes and commit them." text-wrapping="Wrap" Active="{Binding IsAboutPage}" />
            <Text text="No authorised projects are connected. Open Stacks from Home to connect your projects." text-wrapping="Wrap" Active="{Binding NoProjects}" />
            <Container Type="Vertical Stack" Active="{Binding IsProjectsPage}" CellGap="6">
              <Text text="Open an authorised project to work with its source and domains." text-wrapping="Wrap" />
              <Repeat source="{Binding Projects}" as="project" key="{Binding project.Key}">
                <Button action="OpenProject" content="{Binding project.Label}" accessible-name="{Binding project.Label}" />
              </Repeat>
            </Container>
          </Container>
          <Container Type="Vertical Stack" Active="{Binding IsProject}" CellGap="8">
            <Text text="{Binding DomainLabel}" font-size="18" />
            <Text name="StacksActiveDomain" text="{Binding ActiveDomainLabel}" text-wrapping="Wrap" />
            <Button name="StacksSetActive" action="9to1.Stacks.SetActive" content="Set selected domain active" />
            <Text text="{Binding Counts}" text-wrapping="Wrap" />
            <Text text="{Binding Conflicts}" />
            <Text text="Conflict proposal review" font-size="16" />
            <Container max-height="120" Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
              <Container Type="Vertical Stack" CellGap="4">
                <Repeat source="{Binding ConflictProposals}" as="proposal" key="{Binding proposal.Key}">
                  <Button name="StacksSelectConflictProposal" action="SelectConflictProposal" content="{Binding proposal.Label}" accessible-name="{Binding proposal.Label}" />
                </Repeat>
              </Container>
            </Container>
            <Text text="{Binding ProposalPageLabel}" />
            <Container Type="Horizontal Stack" CellGap="6">
              <Button action="9to1.Stacks.PreviousConflictProposals" content="Previous proposals" />
              <Button action="9to1.Stacks.NextConflictProposals" content="Next proposals" />
            </Container>
            <Text name="StacksReviewIdentity" text="{Binding ReviewIdentity}" text-wrapping="Wrap" />
            <Text text="{Binding ReviewSummary}" text-wrapping="Wrap" />
            <Text text="{Binding ReviewDiffDescription}" text-wrapping="Wrap" />
            <Text text="{Binding ReviewDiffPageLabel}" />
            <Container Type="Grid" ColumnSizes="40 1fr 40 1fr">
              <Text text="Current local source" Column="1" />
              <Text text="Proposed resolution" Column="3" />
            </Container>
            <Repeat source="{Binding ReviewDiffLines}" as="reviewLine" key="{Binding reviewLine.Key}">
              <Container margin="0,2" Type="Grid" ColumnSizes="40 1fr 40 1fr">
                <Text text="{Binding reviewLine.BeforeNumber}" />
                <Text text="{Binding reviewLine.BeforeText}" text-wrapping="Wrap" Column="1" />
                <Text text="{Binding reviewLine.AfterNumber}" Column="2" />
                <Container Type="Horizontal Stack" Column="3" CellGap="4">
                  <Text text="{Binding reviewLine.Change}" />
                  <Text text="{Binding reviewLine.AfterText}" text-wrapping="Wrap" />
                </Container>
              </Container>
            </Repeat>
            <Container Type="Horizontal Stack" CellGap="6">
              <Button action="9to1.Stacks.PreviousReviewDiff" content="Previous proposal diff" />
              <Button action="9to1.Stacks.NextReviewDiff" content="Next proposal diff" />
            </Container>
            <Container Type="Horizontal Stack" CellGap="6">
              <Button name="StacksRejectConflictProposal" action="RejectConflictProposal" content="Reject proposal" />
              <Button name="StacksAcceptConflictProposalWithoutMerge" action="AcceptConflictProposalWithoutMerge" content="Accept without merging" />
              <Button name="StacksAcceptConflictProposalAndMerge" action="AcceptConflictProposalAndMerge" content="Accept and merge" />
            </Container>
            <Text text="{Binding DomainPageLabel}" />
            <Container max-height="140" Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
              <Container Type="Vertical Stack" CellGap="4">
                <Repeat source="{Binding Domains}" as="domain" key="{Binding domain.Key}">
                  <Button action="SelectDomain" content="{Binding domain.Label}" accessible-name="{Binding domain.Label}" />
                </Repeat>
              </Container>
            </Container>
            <Container Type="Horizontal Stack" CellGap="6">
              <Button action="9to1.Stacks.PreviousDomains" content="Previous domains" />
              <Button action="9to1.Stacks.NextDomains" content="Next domains" />
            </Container>
            <Input name="StacksDomainName" accessible-name="Domain name" Type="Text" Value="{Binding DomainName, mode=TwoWay}" />
            <Container Type="Horizontal Stack" CellGap="6">
              <Button name="StacksCreateDomain" action="9to1.Stacks.CreateDomain" content="Create child domain" />
              <Button name="StacksRenameDomain" action="9to1.Stacks.RenameDomain" content="Rename selected domain" />
            </Container>
            <Input name="StacksFileFilter" accessible-name="Filter source paths" Type="Text" Value="{Binding FileFilter, mode=TwoWay}" />
            <Text text="{Binding FilePageLabel}" />
            <Container max-height="180" Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
              <Container Type="Vertical Stack" CellGap="4">
                <Repeat source="{Binding Files}" as="file" key="{Binding file.Key}">
                  <Button action="SelectFile" content="{Binding file.Label}" accessible-name="{Binding file.Label}" />
                </Repeat>
              </Container>
            </Container>
            <Container Type="Horizontal Stack" CellGap="6">
              <Button action="9to1.Stacks.PreviousFiles" content="Previous files" />
              <Button action="9to1.Stacks.NextFiles" content="Next files" />
              <Button name="StacksNewTextFile" action="9to1.Stacks.NewTextFile" content="New text file" />
            </Container>
            <Input name="StacksSourcePath" accessible-name="Source path" Type="Text" Value="{Binding SourcePath, mode=TwoWay}" />
            <Text text="{Binding SourceDescription}" text-wrapping="Wrap" />
            <Input name="StacksSourceEditor" min-height="160" accessible-name="Effective source text" Type="Text" Value="{Binding SourceText, mode=TwoWay}" Multiline="True" Interactive="{Binding CanEditText}" />
            <Container Type="Horizontal Stack" CellGap="6">
              <Button name="StacksApplyText" action="9to1.Stacks.ApplyText" content="Save working change" />
              <Button name="StacksDiscardDraft" action="9to1.Stacks.DiscardDraft" content="Discard pending text" />
            </Container>
            <Text text="{Binding DiffPageLabel}" />
            <Container Type="Grid" ColumnSizes="40 1fr 40 1fr">
              <Text text="Inherited base" Column="1" />
              <Text text="Effective source" Column="3" />
            </Container>
            <Repeat source="{Binding DiffLines}" as="line" key="{Binding line.Key}">
              <Container margin="0,2" Type="Grid" ColumnSizes="40 1fr 40 1fr">
                <Text text="{Binding line.BeforeNumber}" />
                <Text text="{Binding line.BeforeText}" text-wrapping="Wrap" Column="1" />
                <Text text="{Binding line.AfterNumber}" Column="2" />
                <Container Type="Horizontal Stack" Column="3" CellGap="4">
                  <Text text="{Binding line.Change}" />
                  <Text text="{Binding line.AfterText}" text-wrapping="Wrap" />
                </Container>
              </Container>
            </Repeat>
            <Container Type="Horizontal Stack" CellGap="6">
              <Button action="9to1.Stacks.PreviousDiff" content="Previous diff" />
              <Button action="9to1.Stacks.NextDiff" content="Next diff" />
            </Container>
            <Input name="StacksCommitMessage" accessible-name="Commit message" Type="Text" Value="{Binding CommitMessage, mode=TwoWay}" />
            <Button name="StacksCommit" action="9to1.Stacks.Commit" content="Commit working changes" />
          </Container>
        </Container>
      </Container>
      <Text text="{Binding Status}" text-wrapping="Wrap" margin="0,8,0,0" Row="3" />
    </Container>
  </Page>
</Cui>
