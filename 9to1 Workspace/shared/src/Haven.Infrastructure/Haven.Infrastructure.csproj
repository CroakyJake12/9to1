<!--
  FILE DOCUMENTATION
  Where: src/Haven.Infrastructure/Haven.Infrastructure.csproj in the Infrastructure layer, where persistence, providers, Windows integration, and external I/O are implemented.
  What: This MSBuild/XML file declares project inputs, dependencies, and build behavior.
  Why: Central declarative configuration keeps builds reproducible across developer machines and CI.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Haven's production infrastructure uses Windows-native speech and VAD binaries. -->
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Haven.Core\Haven.Core.csproj" />
    <ProjectReference Include="..\Haven.Application\Haven.Application.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="NAudio" VersionOverride="2.3.0" />
    <PackageReference Include="Whisper.net" VersionOverride="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" VersionOverride="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" VersionOverride="1.9.1" />
    <PackageReference Include="WebRtcVadSharp" VersionOverride="1.3.2" />
    <PackageReference Include="System.Speech" VersionOverride="10.0.0" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../../Home/HavenOS.Home.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../../../9to1 Models/Dulche Alpha/Dulche.Agents.csproj" /></ItemGroup>
  <PropertyGroup>
    <TerminalNativeHost Condition="$([MSBuild]::IsOSPlatform('Linux')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'linux-x64')">linux</TerminalNativeHost>
    <TerminalNativeHost Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64')">osx</TerminalNativeHost>
    <TerminalNativeExtension Condition="'$(TerminalNativeHost)' == 'linux'">so</TerminalNativeExtension>
    <TerminalNativeExtension Condition="'$(TerminalNativeHost)' == 'osx'">dylib</TerminalNativeExtension>
    <TerminalNativeOutput>$(MSBuildProjectDirectory)/obj/terminal-native/$(Configuration)/$(TerminalNativeHost)/libhaven_terminal_pty.$(TerminalNativeExtension)</TerminalNativeOutput>
  </PropertyGroup>
  <ItemGroup Condition="'$(TerminalNativeHost)' != ''">
    <None Include="$(TerminalNativeOutput)" Link="libhaven_terminal_pty.$(TerminalNativeExtension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildTerminalPtyShim" BeforeTargets="PrepareForBuild" Condition="'$(TerminalNativeHost)' != ''" Inputs="$(MSBuildProjectDirectory)/Terminal/Native/terminal_pty.c" Outputs="$(TerminalNativeOutput)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(TerminalNativeOutput)'))" />
    <Exec Condition="'$(TerminalNativeHost)' == 'linux'" Command="cc -O2 -fPIC -shared -Wall -Wextra -Werror &quot;$(MSBuildProjectDirectory)/Terminal/Native/terminal_pty.c&quot; -o &quot;$(TerminalNativeOutput)&quot; -lutil" />
    <Exec Condition="'$(TerminalNativeHost)' == 'osx'" Command="cc -O2 -fPIC -dynamiclib -Wall -Wextra -Werror &quot;$(MSBuildProjectDirectory)/Terminal/Native/terminal_pty.c&quot; -o &quot;$(TerminalNativeOutput)&quot;" />
  </Target>
</Project>
