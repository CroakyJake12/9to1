<Container Name="AddOverlay" Layout="Vertical" Width="286px" Background="SurfaceRaised" BorderColor="Border" BorderWidth="1px" Radius="16px" Shadow="Card" Gap="4px" Padding="7px" Visibility="Collapsed">
  <Container Name="MenuHeader" Layout="Horizontal" Width="100%" Height="28px" Gap="6px" Padding="4px 8px" VerticalAlignment="Center">
    <Text Name="MenuTitle" Content="Add" FontSize="11" FontWeight="700" Foreground="TextSecondary" VerticalAlignment="Center" />
    <Button Name="Dismiss" Variant="Text" Content="×" Width="24px" Height="24px" MinHeight="24px" Padding="0px" Radius="6px" FontSize="15" />
  </Container>
  <Container Name="AttachCategories" Layout="Vertical" Width="100%" MaxHeight="400px" Overflow="Scroll" Gap="0px" Visibility="Collapsed">
    <Container Name="AttachFilesSection" Layout="Vertical" Width="100%" Gap="0px">
      <Container Name="AttachFilesHeader" Layout="Grid" Columns="1fr 24px" Width="100%">
        <Icon Name="AttachFilesDisclosure" Key="chevron-right" Column="1" Width="14px" Height="14px" Margin="0px 0px 7px 0px" VerticalAlignment="Center" Foreground="TextSecondary" PointerEvents="None" />
      </Container>
    </Container>
    <Container Name="AttachSkillsSection" Layout="Vertical" Width="100%" Gap="0px">
      <Container Name="AttachSkillsHeader" Layout="Grid" Columns="1fr 24px" Width="100%">
        <Icon Name="AttachSkillsDisclosure" Key="chevron-right" Column="1" Width="14px" Height="14px" Margin="0px 0px 7px 0px" VerticalAlignment="Center" Foreground="TextSecondary" PointerEvents="None" />
      </Container>
    </Container>
    <Container Name="AttachAppsSection" Layout="Vertical" Width="100%" Gap="0px">
      <Container Name="AttachAppsHeader" Layout="Grid" Columns="1fr 24px" Width="100%">
        <Icon Name="AttachAppsDisclosure" Key="chevron-right" Column="1" Width="14px" Height="14px" Margin="0px 0px 7px 0px" VerticalAlignment="Center" Foreground="TextSecondary" PointerEvents="None" />
      </Container>
    </Container>
    <Container Name="AttachSpecialistsSection" Layout="Vertical" Width="100%" Gap="0px">
      <Container Name="AttachSpecialistsHeader" Layout="Grid" Columns="1fr 24px" Width="100%">
        <Icon Name="AttachSpecialistsDisclosure" Key="chevron-right" Column="1" Width="14px" Height="14px" Margin="0px 0px 7px 0px" VerticalAlignment="Center" Foreground="TextSecondary" PointerEvents="None" />
      </Container>
    </Container>
    <Container Name="AttachAssistantsSection" Layout="Vertical" Width="100%" Gap="0px">
      <Container Name="AttachAssistantsHeader" Layout="Grid" Columns="1fr 24px" Width="100%">
        <Icon Name="AttachAssistantsDisclosure" Key="chevron-right" Column="1" Width="14px" Height="14px" Margin="0px 0px 7px 0px" VerticalAlignment="Center" Foreground="TextSecondary" PointerEvents="None" />
      </Container>
    </Container>
  </Container>
  <Container Name="MainMenu" Layout="Vertical" Width="100%" Gap="2px">
    <Button Name="AttachFiles" Variant="Ghost" IconKey="file" Content="Files" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Container Name="ToolsHeading" Layout="Horizontal" Width="100%" Height="20px" Padding="5px 9px 0px 9px">
      <Text Name="ToolsHeadingLabel" Content="Tools" FontSize="10" FontWeight="600" Foreground="TextSecondary" />
    </Container>
    <Button Name="Agents" Variant="Ghost" IconKey="agents" Content="Specialists" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Button Name="Assistants" Variant="Ghost" IconKey="chat" Content="Assistants" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Button Name="Instructions" Variant="Ghost" IconKey="skills" Content="Skills" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Button Name="Capabilities" Variant="Ghost" IconKey="plugin" Content="Plugin" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Button Name="Apps" Variant="Ghost" IconKey="apps" Content="Apps" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
  <Container Name="OptionsPanel" Layout="Vertical" Width="100%" Gap="2px">
    <Text Name="OptionsHeading" Content="Options" FontSize="10" FontWeight="600" Foreground="TextSecondary" Padding="9px 7px 0px 7px" />
    <Text Name="CurrentResponseState" Content="Default agent · Basic actions · Auto" FontSize="10" Foreground="TextSecondary" Padding="7px 9px 2px 9px" />
    <Button Name="AllowActions" Variant="Ghost" IconKey="bolt" Content="Allow Actions" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Button Name="VisualResponses" Variant="Ghost" IconKey="browse" Content="Visual responses" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
  </Container>
  </Container>
  <Container Name="CatalogPanel" Layout="Vertical" Width="100%" Gap="4px" Visibility="Collapsed">
    <Button Name="CatalogBack" Variant="Text" IconKey="chevron-left" Content="Add" Width="100%" MinHeight="32px" Padding="5px 8px" Radius="7px" FontSize="11" HorizontalAlignment="Stretch" />
    <Input Name="CatalogSearch" Height="36px" Placeholder="Search" />
    <Container Name="CatalogResults" Layout="Vertical" MaxHeight="280px" Gap="2px" Overflow="Scroll" />
  </Container>
</Container>
