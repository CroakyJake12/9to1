<Container Name="AddOverlay" Layout="Vertical" Width="286px" Background="SurfaceRaised" BorderColor="Border" BorderWidth="1px" Radius="16px" Shadow="Card" Gap="4px" Padding="7px" Visibility="Collapsed">
  <Container Name="MenuHeader" Layout="Horizontal" Width="100%" Height="28px" Gap="6px" Padding="4px 8px" VerticalAlignment="Center">
    <Text Name="MenuTitle" Content="Add" FontSize="11" FontWeight="700" Foreground="TextSecondary" VerticalAlignment="Center" />
    <Button Name="Dismiss" Variant="Text" Content="×" Width="24px" Height="24px" MinHeight="24px" Padding="0px" Radius="6px" FontSize="15" />
  </Container>
  <Container Name="MainMenu" Layout="Vertical" Width="100%" Gap="2px">
    <Button Name="AttachFiles" Variant="Ghost" IconKey="file" Content="Files" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Container Name="ToolsHeading" Layout="Horizontal" Width="100%" Height="20px" Padding="5px 9px 0px 9px">
      <Text Name="ToolsHeadingLabel" Content="Tools" FontSize="10" FontWeight="600" Foreground="TextSecondary" />
    </Container>
    <Button Name="Agents" Variant="Ghost" IconKey="agents" Content="Agents" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Button Name="Instructions" Variant="Ghost" IconKey="prompt" Content="Skills" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Button Name="Capabilities" Variant="Ghost" IconKey="bolt" Content="Capabilities / Plugins" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Button Name="Apps" Variant="Ghost" IconKey="rocket" Content="Apps" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
  <Container Name="OptionsPanel" Layout="Vertical" Width="100%" Gap="2px">
    <Text Name="OptionsHeading" Content="Options" FontSize="10" FontWeight="600" Foreground="TextSecondary" Padding="9px 7px 0px 7px" />
    <Text Name="CurrentResponseState" Content="Default agent · Basic actions · Auto" FontSize="10" Foreground="TextSecondary" Padding="7px 9px 2px 9px" />
    <Button Name="AllowActions" Variant="Ghost" IconKey="bolt" Content="Allow Actions" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
    <Button Name="VisualResponses" Variant="Ghost" IconKey="browse" Content="Visual responses" Width="100%" MinHeight="36px" Padding="7px 9px" Radius="8px" FontSize="12" HorizontalAlignment="Stretch" />
  </Container>
  </Container>
  <Container Name="CatalogPanel" Layout="Vertical" Width="100%" Gap="4px" Visibility="Collapsed">
    <Button Name="CatalogBack" Variant="Text" IconKey="chevron-left" Content="Add" Width="100%" MinHeight="32px" Padding="5px 8px" Radius="7px" FontSize="11" HorizontalAlignment="Stretch" />
    <Input Name="CatalogSearch" Height="36px" Placeholder="Search" />
    <Container Name="CatalogResults" Layout="Vertical" MaxHeight="280px" Gap="2px" Overflow="Scroll" />
  </Container>
</Container>
