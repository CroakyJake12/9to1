<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Haven.Desktop.csproj in the Desktop composition layer, which starts and wires the Avalonia application.
  What: This MSBuild/XML file declares project inputs, dependencies, and build behavior.
  Why: Central declarative configuration keeps builds reproducible across developer machines and CI.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PlatformTarget">
  <PropertyGroup>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFrameworks>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget Condition="'$(TargetFramework)' != 'net10.0'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net10.0'">AnyCPU</PlatformTarget>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Haven</AssemblyName>
    <ProductDisplayName Condition="'$(ProductDisplayName)' == ''">Haven</ProductDisplayName>
    <ProductWindowsAppId Condition="'$(ProductWindowsAppId)' == ''">$(AssemblyName)</ProductWindowsAppId>
    <AssemblyTitle>$(ProductDisplayName)</AssemblyTitle>
    <RootNamespace>Haven.Desktop</RootNamespace>
    <ApplicationIcon Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">Assets\haven.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">app.manifest</ApplicationManifest>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Exe</OutputType>
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">$(DefineConstants);HAVEN_WINDOWS_DESKTOP</DefineConstants>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <!-- DI-created pages deliberately have no parameterless runtime-loader constructor. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="9to1.WindowsAppId" Value="$(ProductWindowsAppId)" />
    <AssemblyMetadata Include="9to1.InitialApp" Value="$(ProductInitialApp)" Condition="'$(ProductInitialApp)' != ''" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="..\Haven.Core\Haven.Core.csproj" />
    <ProjectReference Include="..\Haven.Application\Haven.Application.csproj" />
    <ProjectReference Include="../../../Spaces/HavenOS.Spaces.csproj" />
    <ProjectReference Include="../../../../framework/CUI/Runtime/CakeOS.Cui.Runtime.csproj" />
    <ProjectReference Include="..\Haven.Infrastructure\Haven.Infrastructure.csproj" />
    <ProjectReference Include="..\Haven.SharedHeader\Haven.SharedHeader.csproj" />
    <ProjectReference Include="../../../Accounts/Remote/NineToOne.Accounts.Remote.csproj" />
    <ProjectReference Include="../../../Home/NativeUI/HavenOS.Home.NativeUI.csproj" />
    <ProjectReference Include="../../../Assistants/HavenOS.Assistants.Core.csproj" />
    <ProjectReference Include="../../../Assistants/Migration/HavenOS.Assistants.Migration.csproj" />
    <ProjectReference Include="../../../Assistants/Memory/HavenOS.Assistants.Memory.csproj" />
    <ProjectReference Include="../../../Assistants/MiniComputer/HavenOS.Assistants.MiniComputer.csproj" />
    <ProjectReference Include="../../../Assistants/Attachments/HavenOS.Assistants.Attachments.csproj" />
    <ProjectReference Include="../../../Assistants/NativeUI/HavenOS.Assistants.NativeUI.csproj" />
    <ProjectReference Include="../../../Files/NativeUI/HavenOS.Files.NativeUI.csproj" />
    <ProjectReference Include="../../../Canvas/NativeUI/HavenOS.Canvas.NativeUI.csproj" />
    <ProjectReference Include="..\Haven.Browser\Haven.Browser.csproj" />
    <ProjectReference Include="../../../Browse/NativeUI/HavenOS.Apps.Browse.NativeUI.csproj" />
    <!-- The genuine installed-Chromium engine is the Linux Browse backend. NativeLinux
         is Linux-only, so it is never wired into the Windows graph. -->
    <ProjectReference Include="../../../Browse/NativeLinux/HavenOS.Apps.Browse.NativeLinux.csproj"
                      Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <ProjectReference Include="../../../Browse/NativeWindows/HavenOS.Apps.Browse.NativeWindows.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />
    <!-- During Phase 2 this desktop project is the Avalonia backend/host for platform-neutral Haven.UI. -->
    <ProjectReference Include="..\Haven.UI\Haven.UI.csproj" />
    <!-- The original Sites authority adapter consumes the existing typed Files/Home ownership modules. -->
    <ProjectReference Include="../../../Sites/HavenOS.Sites.csproj" />
    <ProjectReference Include="../../../Sites/NativeUI/HavenOS.Sites.NativeUI.csproj" />
    <ProjectReference Include="../../../Files/NativeHost/HavenOS.Files.NativeHost.csproj" />
    <Using Include="HavenOS.Files.NativeHost" />
    <!-- Legacy Haven.Automations project retired; scheduled Tasks live in Haven.Application. -->
    <!-- Select the approved source fork (framework/CUI/vendor/Avalonia) consistently across the
         compile/runtime/build/publish graph instead of the NuGet Avalonia core/Desktop package
         binaries. This mirrors framework/CUI/Runtime, which already builds against the source fork. -->
    <ProjectReference Include="../../../../framework/CUI/vendor/Avalonia/src/Avalonia.Desktop/Avalonia.Desktop.csproj" />
    <ProjectReference Include="../../../../framework/CUI/vendor/Avalonia/src/Avalonia.Base/Avalonia.Base.csproj" />
    <ProjectReference Include="../../../../framework/CUI/vendor/Avalonia/src/Avalonia.Controls/Avalonia.Controls.csproj" />
    <ProjectReference Include="../../../../framework/CUI/vendor/Avalonia/src/Skia/Avalonia.Skia/Avalonia.Skia.csproj" />
    <!-- Keep the approved fork's existing AXAML name/InitializeComponent generation as a
         build-only analyzer dependency; it supplies no runtime presentation or theme. -->
    <ProjectReference Include="../../../../framework/CUI/vendor/Avalonia/src/tools/Avalonia.Generators/Avalonia.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- Satisfy Avalonia.Controls.WebView's Avalonia>=12.0.0 package dependency without importing the
         NuGet core binaries (no compile/runtime/build assets). The fork ProjectReferences above supply
         the real Avalonia.Base/Controls/Desktop assemblies, so no second core implementation is restored. -->
    <PackageReference Include="Avalonia" ExcludeAssets="all" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <!-- Wraps Avalonia's existing CoreWebView2 COM handle without importing WebView2's WPF/WinForms assemblies. -->
    <PackageReference Include="Microsoft.Web.WebView2" GeneratePathProperty="true" ExcludeAssets="all" Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />
    <Reference Include="Microsoft.Web.WebView2.Core" Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="KokoroSharp.CPU" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Prefabs\**\*.hui" />
    <EmbeddedResource Include="DynamicUI\**\*.hui" />
    <EmbeddedResource Include="Views/Pages/Automations/UI/OriginalAutomationLibrary.cui" LogicalName="Haven.Desktop.OriginalAutomationLibrary.cui" />
    <EmbeddedResource Include="Views/Pages/Home/Dashboard.cui" LogicalName="Haven.Desktop.Home.Dashboard.cui" />
    <EmbeddedResource Include="Views/Pages/Home/Discover.cui" LogicalName="Haven.Desktop.Home.Discover.cui" />
    <EmbeddedResource Include="Views/Pages/Home/UnifiedHome.cui" LogicalName="Haven.Desktop.Home.Unified.cui" />
    <EmbeddedResource Include="Views/Pages/Home/PreferenceRecovery.cui" LogicalName="Haven.Desktop.PreferenceRecovery.cui" />
    <EmbeddedResource Include="Views/Pages/Home/UnifiedHomeApps.cui" LogicalName="Haven.Desktop.Home.UnifiedApps.cui" />
    <!-- The shared-header shell and notifications documents are owned and compiled by the
         Haven.SharedHeader component (genuine V1 artifact resource "CUI.Compilation.v1"). They are
         NOT raw-embedded here; this host consumes the emitted compiled bundle through the component. -->
    <EmbeddedResource Include="Views/Pages/Home/HavenAppHeader.cui" LogicalName="Haven.Desktop.Home.HavenAppHeader.cui" />
    <EmbeddedResource Include="Views/Pages/Files/FilesWorkspaceSetup.cui" LogicalName="Haven.Desktop.Files.WorkspaceSetup.cui" />
    <EmbeddedResource Include="Views/Pages/Data/UI/DataQueryResults.cui" LogicalName="Haven.Desktop.Data.QueryResults.cui" />
    <EmbeddedResource Include="Views/Pages/Data/UI/DataSharedInk.cui" LogicalName="Haven.Desktop.Data.SharedInk.cui" />
    <EmbeddedResource Include="Views/Pages/Present/UI/PresentFreehandTools.cui" LogicalName="Haven.Desktop.Present.PresentFreehandTools.cui" />
    <EmbeddedResource Include="Views/Pages/Present/UI/PresentFreehandInput.cui" LogicalName="Haven.Desktop.Present.PresentFreehandInput.cui" />
    <EmbeddedResource Include="Views/Pages/Spaces/SpaceDetailsDecision.cui" LogicalName="Haven.Desktop.Spaces.SpaceDetailsDecision.cui" />
    <EmbeddedResource Include="Views/Pages/Chat/ChatRecovery.cui" LogicalName="Haven.Desktop.Chat.Recovery.cui" />
    <EmbeddedResource Include="Resources/emoji-test-17.0.txt" LogicalName="Haven.Desktop.Resources.emoji-test-17.0.txt" />
    <Compile Update="Prefabs\**\*.hui.cs"><DependentUpon>%(Filename)</DependentUpon></Compile>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../Write/WriteAppSurface.cs" Link="9to1OS Apps/Write/WriteAppSurface.cs" />
    <!-- Native and web Boards compile the SAME owning core/presentation and retain the
         original shared Write renderer. No web executable or parallel app is referenced. -->
    <Compile Include="../../../../apps/Web/Productivity/Boards/BoardsBrowserCore.cs" Link="Boards/Shared/BoardsBrowserCore.cs" />
    <Compile Include="../../../../apps/Web/Productivity/Boards/BoardsBrowserCore.Find.cs" Link="Boards/Shared/BoardsBrowserCore.Find.cs" />
    <Compile Include="../../../../apps/Web/Productivity/Boards/BoardsBrowserCore.RichText.cs" Link="Boards/Shared/BoardsBrowserCore.RichText.cs" />
    <Compile Include="../../../../apps/Web/Productivity/Boards/BoardsBrowserCore.Workspace.cs" Link="Boards/Shared/BoardsBrowserCore.Workspace.cs" />
    <Compile Include="../../../../apps/Web/Productivity/Boards/BoardsCuiWorkspacePresentation.cs" Link="Boards/Shared/BoardsCuiWorkspacePresentation.cs" />
    <Compile Include="../../../../apps/Web/Write/Scene/WriteRetainedSceneControl.cs" Link="Boards/Shared/WriteRetainedSceneControl.cs" />
    <EmbeddedResource Include="../../../../apps/Web/Productivity/Boards/Boards.cui" LogicalName="Haven.Desktop.Boards.cui" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Views\Pages\Go\GoPage.axaml.cs">
      <DependentUpon>GoPage.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Pages\Home\NewDashboardPage.axaml.cs">
      <DependentUpon>NewDashboardPage.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- SAME canonical platform-neutral account binding and CUI; no parallel native account page. -->
    <Compile Include="../../../../apps/Web/Accounts/AccountBrowserBindings.cs" Link="Accounts/Shared/AccountBrowserBindings.cs" />
    <Compile Include="../../../../apps/Web/Services/IAccountBrowserTransport.cs" Link="Accounts/Shared/IAccountBrowserTransport.cs" />
    <EmbeddedResource Include="../../../../apps/Web/Accounts/Accounts.cui" LogicalName="Haven.Desktop.NativeCake.Accounts.cui" />
    <!-- SAME bounded canonical icon resolver the browser and Spaces CUI surfaces register; the
         desktop does not grow a second, wider image-source path. -->
    <Compile Include="../../../../apps/Web/BrowserCanonicalIcons.cs" Link="Controls\BrowserCanonicalIcons.cs" />
  </ItemGroup>
  <!-- Approved source-build resource pipeline (GenerateAvaloniaResourcesTask) for the AvaloniaResource
       assets above, replacing the build targets that previously came from the NuGet Avalonia package.
       BuildTargets.targets assigns AvaloniaUseCompiledBindingsByDefault=true unconditionally; restore
       Desktop's existing explicit false immediately after the import. Keep this import before the
       explicit App.axaml item removals so its default item includes cannot re-add App.axaml. -->
  <Import Project="../../../../framework/CUI/vendor/Avalonia/build/BuildTargets.targets" />
  <Import Project="../../../../framework/CUI/vendor/Avalonia/src/tools/Avalonia.Generators/Avalonia.Generators.props" />
  <!-- The WebView compatibility package graph can still contribute the NuGet generator
       analyzer despite the core PackageReference exclusion. Keep only the approved fork's
       source-built generator; the resolved metadata distinguishes it from this package item. -->
  <Target Name="RemoveNuGetAvaloniaNameGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Analyzer.NuGetPackageId)' == 'Avalonia' and '%(Analyzer.Filename)' == 'Avalonia.Generators'" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Remove="App.axaml" />
    <AvaloniaXaml Remove="App.axaml" />
  </ItemGroup>
</Project>
