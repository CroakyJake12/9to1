<Cui id="spaces.details.close" version="1">
  <Theme Name="user_preference">
    <Page id="space-details-close-decision" role="dialog" accessible-name="Unsaved Space details">
      <Container Type="Vertical Stack" Padding="24" CellGap="12">
        <Text text="Save your Space details?" font-size="24" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
        <Text text="Save these changes, discard them and use the saved details, or cancel to keep editing." foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
        <Text text="{Binding decision.status}" role="status" foreground="{Resource CuiTextBrush}" />
        <Container Type="Wrap" CellGap="8">
          <Button id="space-details-close-save" content="Save" action="space-details.close.save" Interactive="{Binding decision.canSave}" accessible-name="Save Space details and prepare to close" />
          <Button id="space-details-close-discard" content="Discard" action="space-details.close.discard" Interactive="{Binding decision.canDiscard}" accessible-name="Discard unsaved Space details and prepare to close" />
          <Button id="space-details-close-cancel" content="Cancel" action="space-details.close.cancel" Interactive="{Binding decision.canCancel}" accessible-name="Cancel closing and keep editing Space details" />
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
