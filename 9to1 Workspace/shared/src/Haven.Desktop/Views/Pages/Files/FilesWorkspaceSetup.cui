<Cui id="files.workspace.setup" version="1">
  <Theme Name="user_preference">
    <Page AccessibleName="Set up Files">
      <Container Type="Vertical Stack" Padding="24" CellGap="12" Background="{Resource CuiBackgroundBrush}">
        <Text Text="Set up Files" FontSize="24" FontWeight="Bold" Foreground="{Resource CuiTextBrush}" />
        <Text Text="Choose an empty folder for your Files workspace. Files will create its storage and app folders there. Existing folders and files are never imported or replaced by this setup." TextWrapping="Wrap" Foreground="{Resource CuiTextBrush}" />
        <Button id="files-choose-folder" Content="Choose an empty folder" action="files.setup.choose" AccessibleName="Choose an empty Files workspace folder" />
        <Text id="files-setup-status" AccessibleName="Files setup status" Foreground="{Resource CuiTextSoftBrush}" />
      </Container>
    </Page>
  </Theme>
</Cui>
