<Cui id="home.settings" version="1">
  <Theme Name="user_preference">
    <Page AccessibleName="Home Settings">
      <Container Type="Grid" ColumnSizes="{Binding SettingsColumns}" RowSizes="{Binding SettingsRows}" CellGap="12">
        <Container id="home-settings-nav" Type="Vertical Stack" Role="navigation" AccessibleName="Settings categories"
                   MaxHeight="{Binding SettingsNavHeight}" VerticalScrolling="True" HorizontalScrolling="False"
                   Background="{Resource CuiChromeMaterial}" CornerRadius="14" Padding="12" CellGap="5">
          <Button id="home-settings-back" Action="SettingsBack" Content="‹  Back to Home" AccessibleName="Back to Home"
                  Background="{Resource CuiTransparentBrush}" BorderWidth="0" Padding="8" HorizontalContentAlignment="Left" FontWeight="700" />
          <Text Text="Settings" FontSize="20" FontWeight="800" Margin="8 6 0 2" />
          <Button id="home-settings-global" Action="SettingsGlobal" Content="{Binding SettingsGlobalLabel}" AccessibleName="Global Settings"
                  Background="{Resource CuiTransparentBrush}" BorderWidth="0" Padding="8" HorizontalContentAlignment="Left" FontWeight="750" />
          <Container Type="Vertical Stack" IsVisible="{Binding SettingsGlobalExpanded}" CellGap="3">
            <Button id="home-settings-appearance" Action="SettingsAppearance" Content="Appearance" Selected="{Binding SettingsAppearanceSelected}"
                    Background="{Resource CuiTransparentBrush}" BorderWidth="0" Padding="8" HorizontalContentAlignment="Left" FontWeight="700" />
            <Container Type="Vertical Stack" CellGap="3" Margin="14 0 0 0" Padding="6 0 0 0" BorderColor="{Resource CuiLineBrush}" BorderThickness="1 0 0 0">
              <Button id="home-settings-theme" Action="SettingsTheme" Content="Theme" Selected="{Binding SettingsThemeSelected}"
                      Background="{Resource CuiTransparentBrush}" BorderWidth="0" Padding="8" HorizontalContentAlignment="Left" FontWeight="700" />
              <Button id="home-settings-layout" Action="SettingsLayout" Content="Layout" Selected="{Binding SettingsLayoutSelected}"
                      Background="{Resource CuiTransparentBrush}" BorderWidth="0" Padding="8" HorizontalContentAlignment="Left" FontWeight="700" />
              <Button id="home-settings-accessibility" Action="SettingsAccessibility" Content="Accessibility" Selected="{Binding SettingsAccessibilitySelected}"
                      Background="{Resource CuiTransparentBrush}" BorderWidth="0" Padding="8" HorizontalContentAlignment="Left" FontWeight="700" />
            </Container>
          </Container>
        </Container>
        <Container Type="Overlay" Row="{Binding SettingsContentRow}" Column="{Binding SettingsContentColumn}">
          <Container id="home-settings-appearance-host" Type="Overlay" IsVisible="{Binding SettingsShowsAppearance}" />
          <Container id="home-settings-layout-page" Type="Vertical Stack" IsVisible="{Binding SettingsLayoutSelected}"
                     VerticalScrolling="True" HorizontalScrolling="False" MaxWidth="1000" Padding="12 12 12 24" CellGap="16">
            <Container Type="Vertical Stack" CellGap="3" Margin="0 0 0 8">
              <Text Text="Global Settings" FontSize="12" FontWeight="700" Foreground="{Resource CuiTextSoftBrush}" />
              <Text Text="Layout" FontSize="32" FontWeight="800" />
            </Container>
            <Container Type="Vertical Stack" CellGap="8" Padding="0 0 0 14" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
              <Text Text="Dashboard layout" FontSize="18" FontWeight="750" />
              <Text Text="Open Dashboard and choose Customise to arrange its widgets." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              <Button id="home-settings-open-dashboard" Action="SettingsOpenDashboard" Content="Open Dashboard" HorizontalAlignment="Left" />
            </Container>
            <Container Type="Vertical Stack" CellGap="8">
              <Text Text="Recover saved appearance" FontSize="18" FontWeight="750" />
              <Text Text="Reload the saved appearance preferences for this device. This replaces any unapplied display adjustments." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              <Button id="home-settings-reload-appearance" Action="RefreshHomeAppearance" Content="Reload saved appearance"
                      IsEnabled="{Binding HomeAppearanceCanRefresh, fallback=false}" HorizontalAlignment="Left" />
              <Text Text="{Binding HomeAppearanceStatus}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
          </Container>
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
