<Cui id="home.settings" version="1">
  <Actions>
    <Action name="SelectSettingsDirectoryItem" command="SettingsDirectory" parameter="{Binding entry.Key}" />
    <Action name="OpenSettingsDirectoryLink" command="SettingsDirectoryLink" parameter="{Binding link.Target}" />
  </Actions>
  <Theme Name="user_preference">
    <Page AccessibleName="Home Settings">
      <Container Type="Grid" ColumnSizes="{Binding SettingsColumns}" RowSizes="{Binding SettingsRows}" Background="{Resource CuiWorkspaceBrush}">
        <Container id="home-settings-nav" Type="Grid" RowSizes="Auto 1fr" Role="navigation" AccessibleName="Settings categories"
                   MaxHeight="{Binding SettingsNavHeight}" Padding="{Binding SettingsNavPadding, fallback=13 10}" CellGap="{Binding SettingsNavGap, fallback=10}">
          <Container id="home-settings-nav-header" Type="Grid" ColumnSizes="{Binding SettingsNavHeaderColumns, fallback=1fr}"
                     RowSizes="{Binding SettingsNavHeaderRows, fallback=Auto Auto}" CellGap="{Binding SettingsNavGap, fallback=10}">
            <Container id="home-settings-nav-heading" Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="10" Padding="8 0" VerticalAlignment="Center">
              <Container Type="Overlay" Width="30" Height="30" CornerRadius="8" Background="{Resource CuiAccentSoftBrush}" VerticalAlignment="Center">
                <Image Source="icon:settings" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Container>
              <Text id="home-settings-nav-title" Column="1" Text="Settings" FontSize="20" FontWeight="800" VerticalAlignment="Center"
                    IsVisible="{Binding SettingsNavShowTitle, fallback=true}" />
              <Button id="home-settings-back" Column="2" Action="SettingsBack" AccessibleName="Back to Home" Tooltip="Back to Home"
                      Width="36" Height="36" Background="{Resource CuiTransparentBrush}" BorderWidth="0" Padding="8">
                <Image Source="icon:chevron-left" Width="18" Height="18" />
              </Button>
            </Container>
            <Container id="home-settings-nav-search-row" Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="8" Padding="12 0" CornerRadius="10"
                       Background="{Resource CuiPanelBrush}" Row="{Binding SettingsNavSearchRow, fallback=1}"
                       Column="{Binding SettingsNavSearchColumn, fallback=0}" VerticalAlignment="Center">
              <Image Source="icon:search" Width="16" Height="16" VerticalAlignment="Center" />
              <Input id="home-settings-search" Column="1" Type="Text" AccessibleName="Search settings" PlaceholderText="Search settings"
                     Height="38" MinWidth="0" Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderWidth="0" />
              <Button id="home-settings-clear-search" Column="2" Action="SettingsClearSearch" AccessibleName="Clear settings search"
                      Tooltip="Clear settings search" IsVisible="{Binding SettingsHasQuery}" Background="Transparent" BorderWidth="0"
                      Width="28" Height="28" Padding="4" VerticalAlignment="Center">
                <Image Source="icon:close" Width="14" Height="14" />
              </Button>
            </Container>
          </Container>
          <Container id="home-settings-categories" Row="1" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" CellGap="2">
            <Repeat id="home-settings-directory" Source="{Binding SettingsDirectoryRows}" As="entry" Key="{Binding entry.Key}">
              <Container Type="Overlay" Margin="{Binding entry.Indent}" BorderColor="{Resource CuiLineBrush}" BorderThickness="{Binding entry.Connector}">
                <Button id="home-settings-directory-item" Action="SelectSettingsDirectoryItem"
                        AccessibleName="{Binding entry.AccessibleName}" Selected="{Binding entry.Selected}"
                        Background="Transparent" BorderWidth="0" MinHeight="{Binding entry.Height}" Padding="10 4"
                        HorizontalContentAlignment="Stretch" CornerRadius="8">
                  <Container Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="8">
                    <Image Source="{Binding entry.Icon}" IsVisible="{Binding entry.HasIcon}" Width="17" Height="17" VerticalAlignment="Center" />
                    <Container Column="1" Type="Vertical Stack" CellGap="2" VerticalAlignment="Center">
                      <Text Text="{Binding entry.Label}" FontWeight="{Binding entry.Weight}" TextWrapping="Wrap" />
                      <Text Text="{Binding entry.Subtitle}" IsVisible="{Binding entry.IsGroup}" FontSize="12"
                            Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                    </Container>
                    <Image Column="2" Source="{Binding entry.Chevron}" IsVisible="{Binding entry.IsGroup}" Width="14" Height="14" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
            </Repeat>
            <Text Text="No matching settings" IsVisible="{Binding SettingsNoMatches}" Margin="10 6" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
          </Container>
        </Container>
        <Container Type="Overlay" Row="{Binding SettingsContentRow}" Column="{Binding SettingsContentColumn}">
          <Container id="home-settings-catalog-page" Type="Vertical Stack" IsVisible="{Binding SettingsCatalogSelected}"
                     MaxWidth="1120" Padding="{Binding SettingsOptionsPadding}" VerticalScrolling="True" HorizontalScrolling="False" CellGap="24">
            <Container Type="Vertical Stack" CellGap="6" Margin="0 0 0 10">
              <Text id="home-settings-catalog-scope" Text="{Binding SettingsCatalogScope}" FontSize="13" FontWeight="600" Foreground="{Resource CuiTextSoftBrush}" />
              <Text id="home-settings-haven-page-title" Text="{Binding SettingsCatalogTitle}" FontSize="36" FontWeight="800" TextWrapping="Wrap" />
              <Text Text="{Binding SettingsCatalogDescription}" IsVisible="{Binding SettingsShowCatalogDescription}"
                    TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
            <Button id="home-settings-review-permissions" Action="SettingsReviewPermissions"
                    Content="Review pending requests" HorizontalAlignment="Left"
                    IsVisible="{Binding SettingsPermissionReviewAvailable, fallback=false}" />
            <Container id="home-settings-spaces-storage" Type="Vertical Stack" CellGap="10" Padding="18"
                       Background="{Resource CuiSurfaceMaterial}" CornerRadius="12"
                       IsVisible="{Binding SettingsSpacesStoreVisible, fallback=false}">
              <Text Text="Spaces storage" FontSize="20" FontWeight="700" TextWrapping="Wrap" />
              <Text id="home-settings-spaces-storage-status" Text="{Binding SettingsSpacesStoreStatus}" TextWrapping="Wrap" />
              <Text id="home-settings-spaces-storage-identity" Text="{Binding SettingsSpacesStoreIdentity}"
                    Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" FontSize="12" />
              <Container Type="Wrap" CellGap="8">
                <Button id="home-settings-spaces-storage-inspect" Action="SettingsSpacesStoreInspect" Content="Inspect Spaces storage"
                        IsEnabled="{Binding SettingsSpacesStoreCanInspect, fallback=false}" />
                <Button id="home-settings-spaces-storage-request" Action="SettingsSpacesStoreRequest" Content="Request ownership import"
                        IsVisible="{Binding SettingsSpacesStoreCanRequest, fallback=false}" />
                <Button id="home-settings-spaces-storage-review" Action="SettingsSpacesStoreReview" Content="Review in Home"
                        IsVisible="{Binding SettingsSpacesStoreCanReview, fallback=false}" />
                <Button id="home-settings-spaces-storage-complete" Action="SettingsSpacesStoreComplete" Content="Complete ownership import"
                        IsVisible="{Binding SettingsSpacesStoreCanComplete, fallback=false}" />
                <Button id="home-settings-spaces-storage-retry-audit" Action="SettingsSpacesStoreRetryAudit" Content="Finish import audit"
                        IsVisible="{Binding SettingsSpacesStoreCanRetryAudit, fallback=false}" />
              </Container>
            </Container>
            <Container id="home-settings-keyboard-host" Type="Overlay" IsVisible="{Binding SettingsCatalogHasKeyboard, fallback=false}" />
            <Container id="home-settings-dulche-provider-host" Type="Overlay" IsVisible="{Binding SettingsDulcheProviderVisible, fallback=false}" />
            <Container id="home-settings-legacy-owner-host" Type="Overlay" IsVisible="{Binding SettingsLegacyOwnerVisible, fallback=false}" />
                      <If Condition="{Binding SettingsDulcheLifecycleVisible, fallback=false}">
                        <Container id="home-settings-dulche-lifecycle" Type="Vertical Stack" Background="{Resource CuiSurfaceMaterial}" CornerRadius="18" Padding="20" CellGap="8">
                          <Text Text="Keep Models Loaded" FontSize="18" FontWeight="700" />
                          <Text Text="Choose what Dulche does when you close 9to1." Foreground="{Resource CuiTextSoftBrush}" />
                          <Container Type="Wrap" CellGap="8">
                            <Button id="home-settings-dulche-always" action="DulchePolicyAlways" Content="Always" Selected="{Binding DulchePolicy_always, fallback=false}" IsEnabled="{Binding HomeDulcheCanEdit, fallback=false}" />
                            <Button id="home-settings-dulche-resources" action="DulchePolicyResources" Content="While Resources are Free" Selected="{Binding DulchePolicy_resources, fallback=false}" IsEnabled="{Binding HomeDulcheCanEdit, fallback=false}" />
                            <Button id="home-settings-dulche-active" action="DulchePolicyActive" Content="While Active" Selected="{Binding DulchePolicy_active, fallback=false}" IsEnabled="{Binding HomeDulcheCanEdit, fallback=false}" />
                            <Button id="home-settings-dulche-never" action="DulchePolicyNever" Content="Never" Selected="{Binding DulchePolicy_never, fallback=false}" IsEnabled="{Binding HomeDulcheCanEdit, fallback=false}" />
                          </Container>
                          <Text Text="{Binding DulchePolicyStatus}" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                        </Container>
                      </If>
            <Container Type="Vertical Stack" CellGap="4">
              <Text id="home-settings-global-general-section" Text="Across 9to1" IsVisible="{Binding SettingsGlobalGeneralSelected}"
                    FontSize="18" FontWeight="750" Margin="12 16 0 12" />
              <Button id="home-settings-open-browse-general" Action="SettingsOpenBrowseGeneral" Content="Open Browse settings"
                      AccessibleName="Open Browse settings in a new tab" IsVisible="{Binding SettingsHavenGeneralSelected}" HorizontalAlignment="Left" />
              <Button id="home-settings-open-browse-bookmarks" Action="SettingsOpenBrowseBookmarks" Content="Open Bookmarks"
                      AccessibleName="Open Browse bookmarks in a new tab" IsVisible="{Binding SettingsHavenBookmarksSelected}" HorizontalAlignment="Left" />
              <Button id="home-settings-open-browse-history" Action="SettingsOpenBrowseHistory" Content="Open History"
                      AccessibleName="Open Browse history in a new tab" IsVisible="{Binding SettingsHavenHistorySelected}" HorizontalAlignment="Left" />
              <Repeat id="home-settings-catalog-links" Source="{Binding SettingsCatalogLinks}" As="link" Key="{Binding link.Key}">
                <Container Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                           MinHeight="{Binding SettingsCatalogRowHeight}" CellGap="8" Padding="0 12"
                           BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                  <Container Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                    <Text Text="{Binding link.Label}" FontSize="14" FontWeight="700" />
                    <Text Text="{Binding link.Description}" FontSize="13" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                  </Container>
                  <Button id="home-settings-catalog-link" Action="OpenSettingsDirectoryLink" Content="{Binding link.Action}"
                          AccessibleName="{Binding link.AccessibleName}" IsVisible="{Binding link.Available}"
                          Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" BorderWidth="0" Padding="12 8" />
                  <Text Text="Unavailable" IsVisible="{Binding link.Unavailable}" Row="{Binding SettingsOptionsControlRow}"
                        Column="{Binding SettingsOptionsControlColumn}" FontSize="13" VerticalAlignment="Center" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
              </Repeat>
              <Text id="home-settings-catalog-availability" Text="{Binding SettingsCatalogAvailability}" Margin="10 8"
                    IsVisible="{Binding SettingsHasCatalogAvailability}" FontSize="13" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              <Text Text="{Binding SettingsBrowseStatus}" IsVisible="{Binding SettingsHasBrowseStatus}" Margin="10 8"
                    TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
          </Container>
          <Container id="home-settings-appearance-overview" Type="Vertical Stack" IsVisible="{Binding SettingsAppearanceSelected}" VerticalScrolling="True" HorizontalScrolling="False"
                     MaxWidth="1000" Padding="14 28" CellGap="20">
            <Container Type="Vertical Stack" CellGap="4">
              <Text id="home-settings-overview-eyebrow" Text="GLOBAL SETTINGS" FontSize="12" FontWeight="700" Foreground="{Resource CuiTextSoftBrush}" />
              <Text id="home-settings-overview-title" Text="Appearance" FontSize="32" FontWeight="800" />
            </Container>
            <Container id="home-settings-overview-links" Type="Vertical Stack" Background="{Resource CuiSurfaceMaterial}" CornerRadius="18" Padding="18" CellGap="4">
              <Button id="home-settings-overview-theme" Action="SettingsTheme" Content="Theme and accent preferences" HorizontalContentAlignment="Left" />
              <Button id="home-settings-overview-theme-options" Action="SettingsThemeOptions" Content="Theme Options" HorizontalContentAlignment="Left" />
              <Button id="home-settings-overview-layout" Action="SettingsLayout" Content="Layout" HorizontalContentAlignment="Left" />
              <Button id="home-settings-overview-accessibility" Action="SettingsAccessibility" Content="Accessibility" HorizontalContentAlignment="Left" />
            </Container>
          </Container>
          <Container id="home-settings-theme-options-page" Type="Vertical Stack" IsVisible="{Binding SettingsThemeOptionsSelected}"
                     MaxWidth="1120" Padding="{Binding SettingsOptionsPadding}" VerticalScrolling="True" HorizontalScrolling="False" CellGap="24">
            <Container Type="Vertical Stack" CellGap="6" Margin="0 0 0 10">
              <Text Text="Global" FontSize="13" FontWeight="600" Foreground="{Resource CuiTextSoftBrush}" />
              <Text id="home-settings-theme-options-title" Text="Theme Options" FontSize="36" FontWeight="800" />
            </Container>
            <Container Type="Vertical Stack" CellGap="4">
              <Text Text="Theme options" FontSize="18" FontWeight="750" Margin="0 0 0 12" />
              <Container Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="64" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Text Text="Light / dark" FontSize="14" FontWeight="700" VerticalAlignment="Center" />
                <Container Type="Overlay" Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Role="group" AccessibleName="Appearance mode"
                           Background="{Resource CuiInputSurfaceBrush}" CornerRadius="22" Padding="4">
                  <Repeat id="home-theme-options-mode-choices" Source="{Binding HomeModeChoices}" As="option" Key="{Binding option.Key}" Panel="Wrap">
                    <Button id="home-theme-options-mode-choice" Action="ApplyHomeAppearanceOption" Content="{Binding option.Name}" AccessibleName="{Binding option.Name}"
                            Selected="{Binding option.IsSelected}" IsEnabled="{Binding HomeAppearanceAvailable, fallback=false}"
                            Background="Transparent" BorderWidth="0" MinHeight="34" Padding="12 6" CornerRadius="18" FontWeight="700" />
                  </Repeat>
                </Container>
              </Container>
              <Container Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="64" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text Text="Accent palette" FontSize="14" FontWeight="700" />
                  <Text Text="Choose how app accents are applied across 9to1." FontSize="13" FontWeight="600" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Button id="home-theme-options-palette" Action="SettingsOptionsAccent" AccessibleName="Open accent palette"
                        Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12 8" CornerRadius="20"
                        BorderWidth="0" Background="{Resource CuiAccentSoftBrush}">
                  <Container Type="Horizontal Stack" CellGap="8">
                    <Text Text="Open palette" FontSize="13" FontWeight="700" VerticalAlignment="Center" />
                    <Image id="home-theme-options-palette-chevron" Source="icon:chevron-right" Width="14" Height="14" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
              <Container Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="64" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text Text="Custom themes" FontSize="14" FontWeight="700" />
                  <Text Text="Create a theme from the active appearance." FontSize="13" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Button id="home-theme-options-create" Action="SettingsOptionsCreateTheme" Content="Create theme"
                        IsEnabled="{Binding HomeAppearanceAvailable, fallback=false}"
                        Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderWidth="0" Padding="12 8" />
              </Container>
              <Text Text="{Binding HomeAppearanceStatus}" IsVisible="{Binding SettingsHasAppearanceStatus, fallback=false}"
                    FontSize="13" FontWeight="600" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            </Container>
            <Container Type="Vertical Stack" CellGap="4">
              <Text Text="Related settings" FontSize="18" FontWeight="750" Margin="0 0 0 12" />
              <Container Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="64" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text Text="Accessibility" FontSize="14" FontWeight="700" />
                  <Text Text="Manage interface scale, high contrast and reduced motion." FontSize="13" FontWeight="600" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Button id="home-theme-options-accessibility" Action="SettingsOptionsAccessibility" AccessibleName="Open Accessibility settings"
                        Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderWidth="0" Padding="12 8">
                  <Container Type="Horizontal Stack" CellGap="8">
                    <Text Text="Open" FontSize="13" FontWeight="700" VerticalAlignment="Center" />
                    <Image id="home-theme-options-accessibility-chevron" Source="icon:chevron-right" Width="14" Height="14" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
            </Container>
          </Container>
          <Container id="home-settings-accessibility-page" Type="Vertical Stack" IsVisible="{Binding SettingsAccessibilitySelected}"
                     MaxWidth="1120" Padding="{Binding SettingsAccessibilityPadding}" VerticalScrolling="True" HorizontalScrolling="False" CellGap="26">
            <Container id="home-accessibility-heading" Type="Vertical Stack" CellGap="6" Margin="0 0 0 16">
              <Text id="home-accessibility-scope" Text="Global" FontSize="13" FontWeight="600" Foreground="{Resource CuiTextSoftBrush}" />
              <Text id="home-accessibility-title" Text="Accessibility" FontSize="36" FontWeight="800" TextWrapping="Wrap" />
            </Container>
            <Container id="home-accessibility-display" Type="Vertical Stack" CellGap="4">
              <Text id="home-accessibility-display-heading" Text="Display and reading" FontSize="18" FontWeight="750" Margin="0 0 0 8" />
              <Container id="home-accessibility-scale-row" Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="80" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container id="home-accessibility-scale-labels" Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text id="home-accessibility-scale-label" Text="Interface scale" FontSize="14" FontWeight="700" />
                  <Text id="home-accessibility-scale-description" Text="Change the interface size. Saved documents keep their own typography." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Input id="home-settings-interface-scale" Type="Select" AccessibleName="Interface scale" Width="{Binding SettingsInterfaceScaleWidth}" Height="42"
                       Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       IsEnabled="{Binding SettingsInterfaceScaleAvailable, fallback=false}" />
              </Container>
              <Container id="home-accessibility-preview" Type="Vertical Stack" CellGap="8" IsVisible="{Binding SettingsInterfaceScaleHasStatus, fallback=false}">
                <Text id="home-settings-interface-scale-status" Text="{Binding SettingsInterfaceScaleStatus}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                <Container id="home-accessibility-preview-actions" Type="Wrap" CellGap="8" HorizontalAlignment="Right">
                  <Button id="home-settings-interface-scale-revert" Action="SettingsInterfaceScaleRevert" Content="Revert"
                          AccessibleName="Revert interface scale" IsVisible="{Binding SettingsInterfaceScaleCanRevert, fallback=false}" />
                  <Button id="home-settings-interface-scale-apply" Action="SettingsInterfaceScaleApply" Content="Apply"
                          AccessibleName="Apply interface scale" IsVisible="{Binding SettingsInterfaceScaleCanApply, fallback=false}" />
                </Container>
              </Container>
              <Container id="home-accessibility-contrast-row" Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="80" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container id="home-accessibility-contrast-labels" Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text id="home-accessibility-contrast-label" Text="High contrast" FontSize="14" FontWeight="700" />
                  <Text id="home-accessibility-contrast-description" Text="Increase separation and preserve visible control states." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Input id="home-settings-high-contrast" Type="Switch" AccessibleName="High contrast"
                       IsVisible="{Binding SettingsAccessibilitySwitchesAvailable, fallback=false}"
                       Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <Text id="home-settings-high-contrast-unavailable" Text="Unavailable" AccessibleName="High contrast unavailable"
                      IsVisible="{Binding SettingsAccessibilitySwitchesUnavailable, fallback=true}" Foreground="{Resource CuiTextSoftBrush}"
                      Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Container>
              <Container id="home-accessibility-text-contrast-row" Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="80" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container id="home-accessibility-text-contrast-labels" Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text id="home-accessibility-text-contrast-label" Text="Text contrast" FontSize="14" FontWeight="700" />
                  <Text id="home-accessibility-text-contrast-description" Text="Uses the current theme’s accessible foreground treatment." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Text id="home-accessibility-text-contrast-state" Text="Automatic" Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="700" />
              </Container>
            </Container>
            <Container id="home-accessibility-motion" Type="Vertical Stack" CellGap="4">
              <Text id="home-accessibility-motion-heading" Text="Motion and focus" FontSize="18" FontWeight="750" Margin="0 0 0 8" />
              <Container id="home-accessibility-motion-row" Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="80" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container id="home-accessibility-motion-labels" Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text id="home-accessibility-motion-label" Text="Reduced motion" FontSize="14" FontWeight="700" />
                  <Text id="home-accessibility-motion-description" Text="Use minimal movement and stable transitions." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Input id="home-settings-reduced-motion" Type="Switch" AccessibleName="Reduced motion"
                       IsVisible="{Binding SettingsAccessibilitySwitchesAvailable, fallback=false}"
                       Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <Text id="home-settings-reduced-motion-unavailable" Text="Unavailable" AccessibleName="Reduced motion unavailable"
                      IsVisible="{Binding SettingsAccessibilitySwitchesUnavailable, fallback=true}" Foreground="{Resource CuiTextSoftBrush}"
                      Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Container>
            </Container>
            <Container id="home-accessibility-input" Type="Vertical Stack" CellGap="4">
              <Text id="home-accessibility-input-heading" Text="Input" FontSize="18" FontWeight="750" Margin="0 0 0 8" />
              <Container id="home-accessibility-pointer-row" Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="80" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container id="home-accessibility-pointer-labels" Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text id="home-accessibility-pointer-label" Text="Pointer size" FontSize="14" FontWeight="700" />
                  <Text id="home-accessibility-pointer-description" Text="Change the system pointer size in your device’s accessibility settings." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Text id="home-accessibility-pointer-state" Text="Device controlled" Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="700" />
              </Container>
              <Container id="home-accessibility-keyboard-row" Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}" MinHeight="80" CellGap="8" Padding="0 12">
                <Container id="home-accessibility-keyboard-labels" Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text id="home-accessibility-keyboard-label" Text="Keyboard navigation" FontSize="14" FontWeight="700" />
                  <Text id="home-accessibility-keyboard-description" Text="Tab order follows the semantic reading order." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Button id="home-settings-accessibility-shortcuts" Action="SettingsAccessibilityShortcuts" Content="View shortcuts"
                        Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Container>
            </Container>
            <Text id="home-accessibility-save-status" Text="{Binding HomeAppearanceStatus}" IsVisible="{Binding SettingsHasAppearanceStatus, fallback=false}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
          </Container>
          <Container id="home-settings-appearance-host" Type="Overlay" IsVisible="{Binding SettingsShowsAppearance}" />
          <Container id="home-settings-layout-page" Type="Vertical Stack" IsVisible="{Binding SettingsLayoutSelected}"
                     VerticalScrolling="True" HorizontalScrolling="False" MaxWidth="1120" Padding="{Binding SettingsLayoutPadding}" CellGap="26">
            <Container id="home-settings-layout-heading" Type="Vertical Stack" CellGap="6" Margin="0 0 0 8">
              <Text id="home-settings-layout-eyebrow" Text="Global" FontSize="13" FontWeight="600" Foreground="{Resource CuiTextSoftBrush}" />
              <Text id="home-settings-layout-title" Text="Layout" FontSize="36" FontWeight="800" />
            </Container>
            <Container id="home-settings-layout-workspace" Type="Vertical Stack" CellGap="12">
              <Text id="home-settings-layout-workspace-title" Text="Workspace" FontSize="18" FontWeight="750" />
              <Container id="home-settings-layout-dashboard-row" Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="72" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container id="home-settings-layout-dashboard-details" Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text id="home-settings-layout-dashboard-title" Text="Dashboard layout" FontSize="14" FontWeight="700" />
                  <Text id="home-settings-layout-dashboard-description" Text="Arrange Dashboard widgets in its Customise view."
                        TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Button id="home-settings-open-dashboard" Action="SettingsOpenDashboard" Content="Open Dashboard"
                        Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Chromeless="True" Padding="12 8" />
              </Container>
            </Container>
            <Container id="home-settings-layout-related" Type="Vertical Stack" CellGap="4">
              <Text id="home-settings-layout-related-title" Text="Related layouts" FontSize="18" FontWeight="750" Margin="0 0 0 8" />
              <Container id="home-settings-layout-newtab-row" Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="72" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container id="home-settings-layout-newtab-details" Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text id="home-settings-layout-newtab-title" Text="New Tab" FontSize="14" FontWeight="700" />
                  <Text id="home-settings-layout-newtab-description" Text="Manage widgets, shortcuts and the New Tab layout."
                        TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Button id="home-settings-layout-newtab" Action="SettingsLayoutOpenNewTab" AccessibleName="Customise New Tab"
                        IsEnabled="{Binding SettingsLayoutCustomiseAvailable, fallback=false}"
                        Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Chromeless="True" Padding="12 8">
                  <Container id="home-settings-layout-newtab-action" Type="Horizontal Stack" CellGap="8">
                    <Text id="home-settings-layout-newtab-action-label" Text="Customise" FontSize="13" FontWeight="700" VerticalAlignment="Center" />
                    <Image id="home-settings-layout-newtab-arrow" Source="icon:chevron-right" Width="14" Height="14" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
              <Container id="home-settings-layout-accessibility-row" Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="72" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container id="home-settings-layout-accessibility-details" Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text id="home-settings-layout-accessibility-title" Text="Interface scale" FontSize="14" FontWeight="700" />
                  <Text id="home-settings-layout-accessibility-description" Text="Display size and reading preferences."
                        TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Button id="home-settings-layout-accessibility" Action="SettingsLayoutAccessibility" AccessibleName="Open interface scale in Accessibility"
                        Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Chromeless="True" Padding="12 8">
                  <Container id="home-settings-layout-accessibility-action" Type="Horizontal Stack" CellGap="8">
                    <Text id="home-settings-layout-accessibility-action-label" Text="Open" FontSize="13" FontWeight="700" VerticalAlignment="Center" />
                    <Image id="home-settings-layout-accessibility-arrow" Source="icon:chevron-right" Width="14" Height="14" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
              <Text id="home-settings-layout-navigation-status" Text="{Binding SettingsBrowseStatus}" IsVisible="{Binding SettingsHasBrowseStatus}" Margin="0 8"
                    TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
            <Container id="home-settings-layout-recovery" Type="Vertical Stack" CellGap="12">
              <Text id="home-settings-layout-recovery-title" Text="Recover saved appearance" FontSize="18" FontWeight="750" />
              <Container id="home-settings-layout-recovery-row" Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="72" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Text id="home-settings-layout-recovery-description" Text="Reload the saved display preferences for this device. Unapplied adjustments are discarded." TextWrapping="Wrap"
                      Foreground="{Resource CuiTextSoftBrush}" VerticalAlignment="Center" />
                <Button id="home-settings-reload-appearance" Action="RefreshHomeAppearance" Content="Reload saved appearance"
                        IsEnabled="{Binding HomeAppearanceCanRefresh, fallback=false}"
                        Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Chromeless="True" Padding="12 8" />
              </Container>
              <Text id="home-settings-layout-appearance-status" Text="{Binding HomeAppearanceStatus}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
          </Container>
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
