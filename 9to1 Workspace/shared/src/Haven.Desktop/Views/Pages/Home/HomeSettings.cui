<Cui id="home.settings" version="1">
  <Theme Name="user_preference">
    <Page AccessibleName="Home Settings">
      <Container Type="Grid" ColumnSizes="{Binding SettingsColumns}" RowSizes="{Binding SettingsRows}" Background="{Resource CuiWorkspaceBrush}">
        <Container id="home-settings-nav" Type="Grid" RowSizes="Auto 1fr" Role="navigation" AccessibleName="Settings categories"
                   MaxHeight="{Binding SettingsNavHeight}" Padding="13 10" CellGap="10">
          <Container Type="Vertical Stack" CellGap="10">
            <Container Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="10" Padding="8 0">
              <Container Type="Overlay" Width="30" Height="30" CornerRadius="8" Background="{Resource CuiAccentSoftBrush}" VerticalAlignment="Center">
                <Image Source="icon:settings" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Container>
              <Text Column="1" Text="Settings" FontSize="20" FontWeight="800" VerticalAlignment="Center" />
              <Button id="home-settings-back" Column="2" Action="SettingsBack" AccessibleName="Back to Home" Tooltip="Back to Home"
                      Width="36" Height="36" Background="{Resource CuiTransparentBrush}" BorderWidth="0" Padding="8">
                <Image Source="icon:chevron-left" Width="18" Height="18" />
              </Button>
            </Container>
            <Container Type="Grid" ColumnSizes="Auto 1fr" CellGap="8" Padding="12 0" CornerRadius="10" Background="{Resource CuiPanelBrush}">
              <Image Source="icon:search" Width="16" Height="16" VerticalAlignment="Center" />
              <Input id="home-settings-search" Column="1" Type="Text" AccessibleName="Search settings" PlaceholderText="Search settings"
                     Height="38" MinWidth="0" Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderWidth="0" />
            </Container>
          </Container>
          <Container id="home-settings-categories" Row="1" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" CellGap="2">
            <Button id="home-settings-global" Action="SettingsGlobal" AccessibleName="Global Settings" IsVisible="{Binding SettingsMatchGlobal}"
                    Background="Transparent" BorderWidth="0" MinHeight="52" Padding="10 5" HorizontalContentAlignment="Stretch">
              <Container Type="Grid" ColumnSizes="1fr Auto">
                <Container Type="Vertical Stack" CellGap="2">
                  <Text Text="Global" FontWeight="750" />
                  <Text Text="{Binding HomeAppearanceScope}" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                </Container>
                <Text Column="1" Text="{Binding SettingsGlobalChevron}" VerticalAlignment="Center" Foreground="{Resource CuiTextSoftBrush}" />
              </Container>
            </Button>
            <Container Type="Vertical Stack" IsVisible="{Binding SettingsGlobalExpanded}" CellGap="2">
              <Button id="home-settings-appearance" Action="SettingsAppearance" AccessibleName="Appearance" Selected="{Binding SettingsAppearanceSelected}"
                      Background="Transparent" BorderWidth="0" MinHeight="40" Padding="10 5" HorizontalContentAlignment="Left">
                <Container Type="Horizontal Stack" CellGap="10">
                  <Image Source="icon:palette" Width="17" Height="17" VerticalAlignment="Center" />
                  <Text Text="Appearance" FontWeight="700" VerticalAlignment="Center" />
                </Container>
              </Button>
              <Container id="home-settings-subcategories" Type="Vertical Stack" IsVisible="{Binding SettingsMatchChildren}" CellGap="2" Margin="20 0 0 0" Padding="14 0 0 0" BorderColor="{Resource CuiLineBrush}" BorderThickness="1 0 0 0">
                <Button id="home-settings-theme" Action="SettingsTheme" Content="Theme" AccessibleName="Theme" Selected="{Binding SettingsThemeSelected}" IsVisible="{Binding SettingsMatchTheme}"
                        Background="Transparent" BorderWidth="0" MinHeight="35" Padding="10 5" CornerRadius="9" HorizontalContentAlignment="Left" FontWeight="700" />
                <Button id="home-settings-theme-options" Action="SettingsThemeOptions" Content="Theme Options" AccessibleName="Theme Options"
                        Selected="{Binding SettingsThemeOptionsSelected}" IsVisible="{Binding SettingsMatchThemeOptions}"
                        Background="Transparent" BorderWidth="0" MinHeight="35" Padding="10 5" CornerRadius="9" HorizontalContentAlignment="Left" FontWeight="700" />
                <Button id="home-settings-layout" Action="SettingsLayout" Content="Layout" Selected="{Binding SettingsLayoutSelected}" IsVisible="{Binding SettingsMatchLayout}"
                        Background="Transparent" BorderWidth="0" MinHeight="35" Padding="10 5" CornerRadius="9" HorizontalContentAlignment="Left" FontWeight="700" />
                <Button id="home-settings-accessibility" Action="SettingsAccessibility" Content="Accessibility" Selected="{Binding SettingsAccessibilitySelected}" IsVisible="{Binding SettingsMatchAccessibility}"
                        Background="Transparent" BorderWidth="0" MinHeight="35" Padding="10 5" CornerRadius="9" HorizontalContentAlignment="Left" FontWeight="700" />
              </Container>
            </Container>
            <Button id="home-settings-haven" Action="SettingsHaven" AccessibleName="9to1 Haven, tabs and browsing" IsVisible="{Binding SettingsMatchHaven}"
                    Background="Transparent" BorderWidth="0" MinHeight="52" Margin="0 10 0 0" Padding="10 5" HorizontalContentAlignment="Stretch">
              <Container Type="Grid" ColumnSizes="1fr Auto">
                <Container Type="Vertical Stack" CellGap="2">
                  <Text Text="9to1 Haven" FontWeight="750" />
                  <Text Text="Tabs and browsing" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                </Container>
                <Text Column="1" Text="{Binding SettingsHavenChevron}" VerticalAlignment="Center" Foreground="{Resource CuiTextSoftBrush}" />
              </Container>
            </Button>
            <Container Type="Vertical Stack" IsVisible="{Binding SettingsHavenExpanded}" CellGap="2">
              <Button id="home-settings-haven-general" Action="SettingsHavenGeneral" AccessibleName="General" Selected="{Binding SettingsHavenGeneralSelected}" IsVisible="{Binding SettingsMatchHavenGeneral}"
                      Background="Transparent" BorderWidth="0" MinHeight="40" Padding="10 5" HorizontalContentAlignment="Left">
                <Container Type="Horizontal Stack" CellGap="10">
                  <Image Source="icon:layout" Width="17" Height="17" VerticalAlignment="Center" />
                  <Text Text="General" FontWeight="700" VerticalAlignment="Center" />
                </Container>
              </Button>
              <Button id="home-settings-haven-bookmarks" Action="SettingsHavenBookmarks" AccessibleName="Bookmarks" Selected="{Binding SettingsHavenBookmarksSelected}" IsVisible="{Binding SettingsMatchHavenBookmarks}"
                      Background="Transparent" BorderWidth="0" MinHeight="40" Padding="10 5" HorizontalContentAlignment="Left">
                <Container Type="Horizontal Stack" CellGap="10">
                  <Image Source="icon:bookmark" Width="17" Height="17" VerticalAlignment="Center" />
                  <Text Text="Bookmarks" FontWeight="700" VerticalAlignment="Center" />
                </Container>
              </Button>
              <Button id="home-settings-haven-history" Action="SettingsHavenHistory" AccessibleName="History" Selected="{Binding SettingsHavenHistorySelected}" IsVisible="{Binding SettingsMatchHavenHistory}"
                      Background="Transparent" BorderWidth="0" MinHeight="40" Padding="10 5" HorizontalContentAlignment="Left">
                <Container Type="Horizontal Stack" CellGap="10">
                  <Image Source="icon:history" Width="17" Height="17" VerticalAlignment="Center" />
                  <Text Text="History" FontWeight="700" VerticalAlignment="Center" />
                </Container>
              </Button>
            </Container>
            <Text Text="No matching settings" IsVisible="{Binding SettingsNoMatches}" Margin="10 6" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
          </Container>
        </Container>
        <Container Type="Overlay" Row="{Binding SettingsContentRow}" Column="{Binding SettingsContentColumn}">
          <Container id="home-settings-haven-page" Type="Vertical Stack" IsVisible="{Binding SettingsHavenSelected}"
                     VerticalScrolling="True" HorizontalScrolling="False" MaxWidth="1000" Padding="14 28" CellGap="20">
            <Container Type="Vertical Stack" CellGap="4">
              <Text Text="9TO1 HAVEN" FontSize="12" FontWeight="700" Foreground="{Resource CuiTextSoftBrush}" />
              <Text id="home-settings-haven-page-title" Text="{Binding SettingsHavenTitle}" FontSize="32" FontWeight="800" />
            </Container>
            <Container Type="Vertical Stack" Padding="0 0 0 16" CellGap="12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
              <Text Text="{Binding SettingsHavenDescription}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              <Button id="home-settings-open-browse-general" Action="SettingsOpenBrowseGeneral" Content="Open Browse settings" AccessibleName="Open Browse settings in a new tab"
                      IsVisible="{Binding SettingsHavenGeneralSelected}" HorizontalAlignment="Left" />
              <Button id="home-settings-open-browse-bookmarks" Action="SettingsOpenBrowseBookmarks" Content="Open Bookmarks" AccessibleName="Open Browse bookmarks in a new tab"
                      IsVisible="{Binding SettingsHavenBookmarksSelected}" HorizontalAlignment="Left" />
              <Button id="home-settings-open-browse-history" Action="SettingsOpenBrowseHistory" Content="Open History" AccessibleName="Open Browse history in a new tab"
                      IsVisible="{Binding SettingsHavenHistorySelected}" HorizontalAlignment="Left" />
              <Text Text="{Binding SettingsBrowseStatus}" IsVisible="{Binding SettingsHasBrowseStatus}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
          </Container>
          <Container id="home-settings-appearance-overview" Type="Vertical Stack" IsVisible="{Binding SettingsAppearanceSelected}" VerticalScrolling="True" HorizontalScrolling="False"
                     MaxWidth="1000" Padding="14 28" CellGap="20">
            <Container Type="Vertical Stack" CellGap="4">
              <Text id="home-settings-overview-eyebrow" Text="GLOBAL SETTINGS" FontSize="12" FontWeight="700" Foreground="{Resource CuiTextSoftBrush}" />
              <Text id="home-settings-overview-title" Text="Appearance" FontSize="32" FontWeight="800" />
            </Container>
            <Container id="home-settings-overview-links" Type="Vertical Stack" Background="{Resource CuiSurfaceMaterial}" CornerRadius="18" Padding="18" CellGap="4">
              <Button id="home-settings-overview-theme" Action="SettingsTheme" Content="Theme and accent preferences" HorizontalContentAlignment="Left" />
              <Button id="home-settings-overview-theme-options" Action="SettingsThemeOptions" Content="Theme Options" HorizontalContentAlignment="Left" />
              <Button id="home-settings-overview-layout" Action="SettingsLayout" Content="Layout" HorizontalContentAlignment="Left" />
              <Button id="home-settings-overview-accessibility" Action="SettingsAccessibility" Content="Accessibility" HorizontalContentAlignment="Left" />
            </Container>
          </Container>
          <Container id="home-settings-theme-options-page" Type="Vertical Stack" IsVisible="{Binding SettingsThemeOptionsSelected}"
                     MaxWidth="1120" Padding="{Binding SettingsOptionsPadding}" VerticalScrolling="True" HorizontalScrolling="False" CellGap="24">
            <Container Type="Vertical Stack" CellGap="6" Margin="0 0 0 10">
              <Text Text="Global" FontSize="13" FontWeight="600" Foreground="{Resource CuiTextSoftBrush}" />
              <Text id="home-settings-theme-options-title" Text="Theme Options" FontSize="36" FontWeight="800" />
            </Container>
            <Container Type="Vertical Stack" CellGap="4">
              <Text Text="Theme options" FontSize="18" FontWeight="750" Margin="0 0 0 12" />
              <Container Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="64" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Text Text="Light / dark" FontSize="14" FontWeight="700" VerticalAlignment="Center" />
                <Container Type="Overlay" Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Role="group" AccessibleName="Appearance mode"
                           Background="{Resource CuiInputSurfaceBrush}" CornerRadius="22" Padding="4">
                  <Repeat id="home-theme-options-mode-choices" Source="{Binding HomeModeChoices}" As="option" Key="{Binding option.Key}" Panel="Wrap">
                    <Button id="home-theme-options-mode-choice" Action="ApplyHomeAppearanceOption" Content="{Binding option.Name}" AccessibleName="{Binding option.Name}"
                            Selected="{Binding option.IsSelected}" IsEnabled="{Binding HomeAppearanceAvailable, fallback=false}"
                            Background="Transparent" BorderWidth="0" MinHeight="34" Padding="12 6" CornerRadius="18" FontWeight="700" />
                  </Repeat>
                </Container>
              </Container>
              <Container Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="64" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text Text="Accent palette" FontSize="14" FontWeight="700" />
                  <Text Text="Choose how app accents are applied across 9to1." FontSize="13" FontWeight="600" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Button id="home-theme-options-palette" Action="SettingsOptionsAccent" AccessibleName="Open accent palette"
                        Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12 8" CornerRadius="20"
                        BorderWidth="0" Background="{Resource CuiAccentSoftBrush}">
                  <Container Type="Horizontal Stack" CellGap="8">
                    <Text Text="Open palette" FontSize="13" FontWeight="700" VerticalAlignment="Center" />
                    <Image id="home-theme-options-palette-chevron" Source="icon:chevron-right" Width="14" Height="14" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
              <Text Text="{Binding HomeAppearanceStatus}" IsVisible="{Binding SettingsHasAppearanceStatus, fallback=false}"
                    FontSize="13" FontWeight="600" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            </Container>
            <Container Type="Vertical Stack" CellGap="4">
              <Text Text="Related settings" FontSize="18" FontWeight="750" Margin="0 0 0 12" />
              <Container Type="Grid" ColumnSizes="{Binding SettingsOptionsColumns}" RowSizes="{Binding SettingsOptionsRows}"
                         MinHeight="64" CellGap="8" Padding="0 12" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
                <Container Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                  <Text Text="Accessibility" FontSize="14" FontWeight="700" />
                  <Text Text="Manage high contrast and reduced motion." FontSize="13" FontWeight="600" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
                <Button id="home-theme-options-accessibility" Action="SettingsOptionsAccessibility" AccessibleName="Open Accessibility settings"
                        Row="{Binding SettingsOptionsControlRow}" Column="{Binding SettingsOptionsControlColumn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderWidth="0" Padding="12 8">
                  <Container Type="Horizontal Stack" CellGap="8">
                    <Text Text="Open" FontSize="13" FontWeight="700" VerticalAlignment="Center" />
                    <Image id="home-theme-options-accessibility-chevron" Source="icon:chevron-right" Width="14" Height="14" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
            </Container>
          </Container>
          <Container id="home-settings-appearance-host" Type="Overlay" IsVisible="{Binding SettingsShowsAppearance}" />
          <Container id="home-settings-layout-page" Type="Vertical Stack" IsVisible="{Binding SettingsLayoutSelected}"
                     VerticalScrolling="True" HorizontalScrolling="False" MaxWidth="1000" Padding="12 12 12 24" CellGap="16">
            <Container Type="Vertical Stack" CellGap="3" Margin="0 0 0 8">
              <Text id="home-settings-layout-eyebrow" Text="GLOBAL SETTINGS" FontSize="12" FontWeight="700" Foreground="{Resource CuiTextSoftBrush}" />
              <Text Text="Layout" FontSize="32" FontWeight="800" />
            </Container>
            <Container Type="Vertical Stack" CellGap="8" Padding="0 0 0 14" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
              <Text Text="Dashboard layout" FontSize="18" FontWeight="750" />
              <Text Text="Open Dashboard and choose Customise to arrange its widgets." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              <Button id="home-settings-open-dashboard" Action="SettingsOpenDashboard" Content="Open Dashboard" HorizontalAlignment="Left" />
            </Container>
            <Container Type="Vertical Stack" CellGap="8">
              <Text Text="Recover saved appearance" FontSize="18" FontWeight="750" />
              <Text Text="Reload the saved appearance preferences for this device. This replaces any unapplied display adjustments." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              <Button id="home-settings-reload-appearance" Action="RefreshHomeAppearance" Content="Reload saved appearance"
                      IsEnabled="{Binding HomeAppearanceCanRefresh, fallback=false}" HorizontalAlignment="Left" />
              <Text Text="{Binding HomeAppearanceStatus}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
          </Container>
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
