<Cui id="home.apps" version="1">
  <Actions>
    <Action name="OpenApp" command="home.open-app" parameter="{Binding app.identity}" />
    <Action name="PinApp" command="home.app-pin" parameter="{Binding app.pinId}" />
    <Action name="MoveAppEarlier" command="home.app-move-earlier" parameter="{Binding app.pinId}" />
    <Action name="MoveAppLater" command="home.app-move-later" parameter="{Binding app.pinId}" />
    <Action name="FilterInstalled" command="home.app-filter" parameter="installed" />
    <Action name="FilterAll" command="home.app-filter" parameter="all" />
    <Action name="FilterPinned" command="home.app-filter" parameter="pinned" />
    <Action name="OpenBuild" command="home.open-app" parameter="dev" />
  </Actions>
  <Theme Name="user_preference">
    <Page id="home-apps-page" Role="main" AccessibleName="Apps" OwnsBackdrop="True" Background="{Resource CuiWorkspaceBrush}">
      <!-- One scrolling page; repeat keys are canonical app IDs, never visible labels. -->
      <Container id="home-apps-body" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False"
                 Padding="{Binding apps.pagePadding}" Background="{Resource CuiWorkspaceBrush}">
        <Container id="home-apps-heading" Type="Grid" ColumnSizes="{Binding apps.headingColumns}"
                   RowSizes="{Binding apps.headingRows}" CellGap="14" Margin="0 0 0 28">
          <Text Text="Apps" FontSize="{Binding apps.headingSize}" FontWeight="800" VerticalAlignment="Center" />
          <Container id="home-apps-controls" Type="Grid" Row="{Binding apps.controlsRow}" Column="{Binding apps.controlsColumn}"
                     ColumnSizes="{Binding apps.controlsColumns}" RowSizes="{Binding apps.controlsRows}" CellGap="12">
            <Container id="home-apps-search-row" Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="11"
                       ColumnSpan="{Binding apps.searchColumnSpan}" MinHeight="54" Padding="15 8 10 8"
                       Background="{Resource CuiPanelBrush}" CornerRadius="17">
              <Image Source="icon:search" Width="19" Height="19" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Input id="home-app-search" Column="1" Type="Text" Value="{Binding apps.query, mode=TwoWay}"
                     AccessibleName="Search apps" PlaceholderText="Search apps" MinWidth="0" FontSize="13" FontWeight="600"
                     Background="{Resource CuiTransparentBrush}" BorderWidth="0" Padding="0" VerticalContentAlignment="Center" />
              <Button id="home-apps-clear" Column="2" Action="home.clear-app-query" AccessibleName="Clear app search"
                      Tooltip="Clear app search" Width="28" Height="28" Padding="6" VerticalAlignment="Center"
                      Chromeless="True" IsVisible="{Binding apps.hasQuery}">
                <Image Source="icon:close" Width="16" Height="16" />
              </Button>
            </Container>
            <Button id="home-apps-filter" Row="{Binding apps.filterRow}" Column="{Binding apps.filterColumn}"
                    Action="home.app-filters" AccessibleName="{Binding apps.filterLabel}" Tooltip="Filter apps"
                    MinHeight="39" Padding="17 10" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Background="{Resource CuiPanelBrush}" BorderWidth="0" CornerRadius="{Binding apps.buttonRadius}">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image Source="home-nav:filter" Width="17" Height="17" />
                <Text Text="Filters" FontSize="13" FontWeight="650" />
              </Container>
              <Container id="home-apps-filter-menu" Type="Context Menu" AccessibleName="Filter apps">
                <Button Type="Menu Item" Content="Installed" Action="FilterInstalled" ToggleType="Radio" Checked="{Binding apps.filterInstalled}" />
                <Button Type="Menu Item" Content="All apps" Action="FilterAll" ToggleType="Radio" Checked="{Binding apps.filterAll}" />
                <Button Type="Menu Item" Content="Pinned" Action="FilterPinned" ToggleType="Radio" Checked="{Binding apps.filterPinned}" />
              </Container>
            </Button>
            <Button id="home-apps-manage" Row="{Binding apps.manageRow}" Column="{Binding apps.manageColumn}"
                    Action="home.manage-apps" AccessibleName="Manage apps" Tooltip="Manage installed apps"
                    MinHeight="39" Padding="17 10" VerticalAlignment="Center" HorizontalAlignment="Right" CornerRadius="{Binding apps.buttonRadius}" AccentRole="Primary">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image Source="home-nav:sliders" Width="17" Height="17" />
                <Text Text="Manage apps" FontSize="13" FontWeight="650" />
              </Container>
            </Button>
          </Container>
        </Container>
        <Container id="home-apps-hubs-entry" Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="14"
                   Padding="18 15" Background="{Resource CuiPanelBrush}" CornerRadius="{Binding apps.rowRadius}" Margin="0 0 0 24">
          <Image Source="home-nav:apps" Width="21" Height="21" VerticalAlignment="Center" />
          <Container Column="1" Type="Wrap" CellGap="16" VerticalAlignment="Center">
            <Container Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
              <Text Text="Your hubs" FontSize="13" FontWeight="750" />
              <Text Text="Seven app groups." FontSize="11" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
            <Button id="home-apps-explore-hubs" Action="home.explore-hubs" Content="Explore hubs"
                    AccessibleName="Explore hubs" MinHeight="39" Padding="17 10" CornerRadius="{Binding apps.buttonRadius}" AccentRole="Primary" />
          </Container>
          <Button id="home-apps-build-projects" Column="2" Action="OpenBuild" AccessibleName="Build projects"
                  IsEnabled="{Binding apps.canOpenBuild}" Tooltip="Open Build projects" Chromeless="True"
                  VerticalAlignment="Center" Padding="8" IsVisible="{Binding apps.showBuildLabel}">
            <Container Type="Horizontal Stack" CellGap="9">
              <Image Source="home-nav:folder" Width="16" Height="16" />
              <Text Text="Build projects" FontSize="12" FontWeight="700" />
            </Container>
          </Button>
        </Container>
        <Container id="home-apps-pinned-section" Type="Vertical Stack" CellGap="12" IsVisible="{Binding apps.hasPinned}">
          <Container Type="Grid" ColumnSizes="1fr 1fr" CellGap="16">
            <Text Text="PINNED" FontSize="11" FontWeight="650" Foreground="{Resource CuiTextSoftBrush}" />
            <Text Column="1" Text="Drag or use the arrow controls to reorder" FontSize="12" TextWrapping="Wrap"
                  TextAlignment="Right" Foreground="{Resource CuiTextSoftBrush}" />
          </Container>
          <Container id="home-apps-pinned-grid" Type="Grid" CellGap="13"
                     ColumnSizes="{Binding apps.pinnedColumns}" RowSizes="{Binding apps.pinnedRows}">
            <Repeat Source="{Binding apps.pinned}" As="app" Key="{Binding app.identity}"
                    ItemRow="{Binding app.row}" ItemColumn="{Binding app.column}">
              <Container id="home-app-pin-card" Type="Grid" RowSizes="1fr Auto" Background="{Resource CuiPanelBrush}"
                         CornerRadius="{Binding apps.cardRadius}" MinHeight="164" AutomationId="{Binding app.automationId}">
                <Button id="home-app-pin-open" Action="OpenApp" AccessibleName="{Binding app.openLabel}"
                        AccessibleDescription="{Binding app.detail}" Tooltip="{Binding app.detail}"
                        AutomationId="{Binding app.openAutomationId}" IsEnabled="{Binding app.canOpen}"
                        Padding="8 20 8 8" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="{Binding apps.cardRadius}">
                  <Container Type="Vertical Stack" CellGap="10">
                    <Image Source="{Binding app.iconSource}" Width="48" Height="48" HorizontalAlignment="Center" />
                    <Text Text="{Binding app.name}" FontSize="14" FontWeight="800" TextWrapping="Wrap" TextAlignment="Center" />
                    <Text Text="{Binding app.detail}" FontSize="12" FontWeight="600" TextWrapping="Wrap" TextAlignment="Center"
                          Foreground="{Resource CuiTextSoftBrush}" />
                  </Container>
                </Button>
                <Container Row="1" Type="Horizontal Stack" HorizontalAlignment="Center" CellGap="4" Margin="0 0 0 5">
                  <Button id="home-app-pin-earlier" Action="MoveAppEarlier" AccessibleName="{Binding app.moveEarlierLabel}"
                          Tooltip="{Binding app.moveEarlierLabel}" IsEnabled="{Binding app.canMoveEarlier}"
                          Width="28" Height="28" Padding="7" Chromeless="True">
                    <Image Source="icon:arrow-left" Width="13" Height="13" />
                  </Button>
                  <Button id="home-app-pin-later" Action="MoveAppLater" AccessibleName="{Binding app.moveLaterLabel}"
                          Tooltip="{Binding app.moveLaterLabel}" IsEnabled="{Binding app.canMoveLater}"
                          Width="28" Height="28" Padding="7" Chromeless="True">
                    <Image Source="icon:arrow-right" Width="13" Height="13" />
                  </Button>
                </Container>
              </Container>
            </Repeat>
          </Container>
        </Container>
        <Container id="home-apps-catalogue-section" Type="Vertical Stack" CellGap="20" Margin="0 28 0 0">
          <Container Type="Grid" ColumnSizes="1fr Auto">
            <Text Text="ALL APPS" FontSize="11" FontWeight="650" Foreground="{Resource CuiTextSoftBrush}" />
            <Text id="home-apps-count" Column="1" Text="{Binding apps.resultCount}" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" AccessibleName="App count" />
          </Container>
          <Repeat Source="{Binding apps.hubs}" As="hub" Key="{Binding hub.key}" Panel="Vertical Stack">
            <Container id="home-apps-hub" Type="Vertical Stack" CellGap="12" Margin="0 0 0 24">
              <Container Type="Horizontal Stack" CellGap="10">
                <Text Text="{Binding hub.name}" FontSize="17" FontWeight="750" VerticalAlignment="Center" />
                <Container Type="Overlay" Background="{Resource CuiPanel2Brush}" CornerRadius="8" MinWidth="23" Height="23" Padding="5 2">
                  <Text Text="{Binding hub.count}" FontSize="11" FontWeight="650" TextAlignment="Center" VerticalAlignment="Center"
                        Foreground="{Resource CuiTextSoftBrush}" />
                </Container>
              </Container>
              <Container Type="Grid" ColumnSizes="{Binding apps.catalogueColumns}" RowSizes="{Binding hub.rows}" CellGap="10">
                <Repeat Source="{Binding hub.apps}" As="app" Key="{Binding app.identity}" ItemRow="{Binding app.row}" ItemColumn="{Binding app.column}">
                  <Container id="home-app-row" Type="Grid" ColumnSizes="1fr Auto" MinHeight="70"
                             Background="{Resource CuiPanelBrush}" CornerRadius="{Binding apps.rowRadius}">
                    <Button id="home-app-tile" Action="OpenApp" AccessibleName="{Binding app.openLabel}" Tooltip="{Binding app.detail}"
                            IsEnabled="{Binding app.canOpen}" HorizontalContentAlignment="Stretch" Padding="17 14 8 14"
                            Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="{Binding apps.rowRadius}">
                      <Container Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="12">
                        <Image id="home-app-icon" Source="{Binding app.iconSource}" Width="36" Height="36" VerticalAlignment="Center" />
                        <Container Column="1" Type="Vertical Stack" CellGap="4" VerticalAlignment="Center">
                          <Text id="home-app-name" Text="{Binding app.name}" FontSize="14" FontWeight="750" TextWrapping="Wrap" />
                          <Text id="home-app-detail" Text="{Binding app.detail}" FontSize="12" FontWeight="600" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                        </Container>
                        <Image Column="2" Source="icon:arrow-up-right" Width="14" Height="14" VerticalAlignment="Center" />
                      </Container>
                    </Button>
                    <Button id="home-app-pin" Column="1" Action="PinApp" AccessibleName="{Binding app.pinLabel}"
                            Tooltip="{Binding app.pinLabel}" IsEnabled="{Binding app.canPin}" Selected="{Binding app.isPinned}"
                            Width="28" Height="28" Padding="7" Margin="0 0 8 0" VerticalAlignment="Center" Chromeless="True" CornerRadius="14">
                      <Image Source="icon:pin" Width="14" Height="14" />
                    </Button>
                  </Container>
                </Repeat>
              </Container>
            </Container>
          </Repeat>
          <Container id="home-apps-empty" Type="Vertical Stack" CellGap="8" Padding="20 44" IsVisible="{Binding apps.hasNoResults}"
                     Background="{Resource CuiPanelBrush}" CornerRadius="{Binding apps.cardRadius}" Role="status">
            <Image Source="icon:search" Width="28" Height="28" HorizontalAlignment="Center" />
            <Text id="home-apps-empty-title" Text="{Binding apps.resultEmptyTitle}" FontSize="18" FontWeight="750" TextAlignment="Center" />
            <Text id="home-apps-empty-detail" Text="{Binding apps.resultEmptyDetail}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Action="home.clear-app-query" Content="Clear search" IsVisible="{Binding apps.hasQuery}"
                    HorizontalAlignment="Center" MinHeight="36" Margin="0 10 0 0" />
          </Container>
        </Container>
        <Text id="home-apps-status" Text="{Binding apps.status}" AccessibleName="Apps status" FontSize="12"
              TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
      </Container>
    </Page>
  </Theme>
</Cui>
