<Cui id="home.discover" version="1">
  <Theme Name="user_preference">
    <Page AccessibleName="Home Discover models">
      <Container id="discover-root" Type="Grid" RowSizes="Auto Auto Auto 1fr Auto" Margin="24 74 24 24" CellGap="12">
        <Container Type="Vertical Stack" CellGap="4">
          <Text Text="Discover" FontSize="28" FontWeight="Bold" Foreground="{Resource CuiTextBrush}" />
          <Text Text="Explore the models reported by your configured providers. Unreported capabilities and measurements remain unknown." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
        </Container>
        <Container Row="1" Type="Wrap" CellGap="8">
          <Input id="discover-search" Type="Text" PlaceholderText="Search models or providers" AccessibleName="Search model catalogue" Width="220" />
          <Input id="discover-category" Type="Select" AccessibleName="Model capability category" Width="150" />
          <Input id="discover-locality" Type="Select" AccessibleName="Model location" Width="120" />
          <Button id="discover-refresh" Content="Search" AccessibleName="Search configured model providers" />
          <Button id="discover-manage" Content="Manage providers" AccessibleName="Open shared model and provider settings" />
        </Container>
        <Text id="discover-status" Row="2" Text="Open Discover to read configured providers." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
        <Input id="discover-models" Row="3" Type="List" AccessibleName="Models; select entries to compare their reported metadata" />
        <Container Row="4" Type="Vertical Stack" VerticalScrolling="True" MaxHeight="220" CellGap="8">
          <Button id="discover-compare" Content="Compare selected" AccessibleName="Refresh and compare selected models" IsEnabled="False" />
          <Text id="discover-details" Text="Select a model to inspect its provider, capability and location information." TextWrapping="Wrap" Foreground="{Resource CuiTextBrush}" />
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
