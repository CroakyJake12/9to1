<Cui id="home.discover" version="1">
  <Theme Name="user_preference">
    <Page AccessibleName="Home models">
      <Container id="discover-root" Type="Vertical Stack" Margin="16 12 16 20" CellGap="16" VerticalScrolling="True" HorizontalScrolling="False" MinWidth="0">
        <Container id="discover-dulche-mount" Type="Vertical Stack" IsVisible="{Binding HasDulche, fallback=false}" AccessibleName="Dulche local models and inference" />
        <Container Type="Wrap" CellGap="8" Padding="0 8 0 0">
          <Button id="discover-browse" Content="Find or install models" AccessibleName="Show or hide the model catalogue" />
          <Button id="discover-manage" Content="Manage providers" AccessibleName="Open shared model and provider settings" />
        </Container>
        <Container id="discover-catalogue" Type="Vertical Stack" CellGap="12" IsVisible="{Binding BrowseVisible, fallback=true}" AccessibleName="Find and install models">
          <Text Text="Find and install models" FontSize="20" FontWeight="Bold" Foreground="{Resource CuiTextBrush}" />
          <Container Type="Wrap" CellGap="8">
            <Input id="discover-search" Type="Text" PlaceholderText="Search models or providers" AccessibleName="Search model catalogue" Width="220" />
            <Input id="discover-category" Type="Select" AccessibleName="Model capability category" Width="150" />
            <Input id="discover-locality" Type="Select" AccessibleName="Model location" Width="120" />
            <Button id="discover-refresh" Content="Search" AccessibleName="Search registered model providers" />
          </Container>
          <Text id="discover-status" Text="Open the catalogue to read registered providers." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
          <Container id="discover-huggingface-mount" Type="Vertical Stack" AccessibleName="Hugging Face model search and verified installation" />
          <Text Text="Models from your providers" FontSize="18" FontWeight="Bold" Foreground="{Resource CuiTextBrush}" />
          <Input id="discover-models" Type="List" Height="180" AccessibleName="Models; select entries to compare their reported metadata" />
          <Button id="discover-compare" Content="Compare selected" AccessibleName="Refresh and compare selected models" IsEnabled="False" HorizontalAlignment="Left" />
          <Text id="discover-details" Text="Select a model to inspect its provider, capability and location information." TextWrapping="Wrap" Foreground="{Resource CuiTextBrush}" />
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
