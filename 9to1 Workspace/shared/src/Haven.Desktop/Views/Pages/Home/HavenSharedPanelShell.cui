<Cui id="haven-shared-panel-shell" product="9-1" version="1">
  <Theme Name="user_preference">
    <Page>
      <!-- The persistent shared-panel shell. The whole frame — the browser/scene content
           host and the overlay backdrop/panel — is authored here; the host only mounts the
           scene control into the named scene host element and the active panel control into
           the named panel host element, and flips the authored HasOpenPanel state. No
           structure/backdrop/visibility is authored in C#. -->
      <Container id="shared-frame-root" Type="Overlay">
        <Container id="shared-scene-host" Type="Grid" ColumnSizes="1fr" RowSizes="1fr" />
        <Container id="shared-shell-backdrop" Type="Overlay" IsVisible="{Binding HasOpenPanel}" Background="#667F7F7F">
          <Container id="shared-panel-host" Type="Vertical Stack" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" CellGap="12" Width="520" MaxHeight="600" Background="{Resource CuiBackgroundBrush}" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="12"/>
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
