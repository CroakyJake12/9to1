<Cui id="9to1.Haven.PreferenceRecovery" version="1">
  <Theme Name="user_preference">
    <Page AccessibleName="9to1 Haven preference recovery">
      <Container Type="Vertical Stack" CellGap="12" Padding="24">
        <Text Text="Preference recovery" FontSize="24" FontWeight="Bold" Foreground="{Resource CuiTextBrush}" />
        <Text Text="{Binding Message}" TextWrapping="Wrap" Foreground="{Resource CuiTextBrush}" />
        <Text Text="{Binding Guidance}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
      </Container>
    </Page>
  </Theme>
</Cui>