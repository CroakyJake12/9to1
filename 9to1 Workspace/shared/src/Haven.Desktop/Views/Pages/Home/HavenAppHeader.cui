<Cui id="9to1.Haven.AppHeader" version="1">
  <Actions>
    <Action name="SubmitSearch" command="9to1.Haven.Search" parameter="{Binding SearchText}" />
    <Action name="OpenModel" command="9to1.Haven.OpenModel" />
    <Action name="OpenNotifications" command="9to1.Haven.OpenNotifications" />
    <Action name="OpenProfile" command="9to1.Haven.OpenProfile" />
  </Actions>
  <Page id="HavenAppHeaderRoot" AccessibleName="Application header">
    <Container Type="Horizontal Stack" CellGap="8" Padding="8 4" Background="{Resource CuiPanelBrush}" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 0 1">
      <Container Type="Grid" ColumnSizes="1fr Auto" Width="280" Background="{Resource CuiInputSurfaceBrush}" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="16">
        <Input Type="Text" id="HeaderSearchBox" AccessibleName="Search" Value="{Binding SearchText, mode=TwoWay}" Height="32" MinHeight="32" MinWidth="160" Padding="12 4" FontSize="13" Background="Transparent" BorderWidth="0" CornerRadius="16" />
        <Button id="HeaderSearchButton" action="SubmitSearch" Column="1" AccessibleName="Submit search" Tooltip="Search" Height="32" MinHeight="32" Width="28" MinWidth="28" Padding="4" FontSize="15" Background="Transparent" Color="{Resource CuiTextBrush}" BorderWidth="0" CornerRadius="16">→</Button>
      </Container>
      <Container Type="Horizontal Stack" CellGap="4" IsVisible="{Binding ShowModel}">
        <Button id="HeaderModelButton" action="OpenModel" accessible-name="Choose AI model" Tooltip="Choose the active AI model" Height="36" MinHeight="36" Width="36" MinWidth="36" Padding="8" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">M</Button>
      </Container>
      <Container Type="Horizontal Stack" CellGap="4" IsVisible="{Binding ShowNotifications}">
        <Button id="HeaderNotificationsButton" action="OpenNotifications" accessible-name="Notifications" Tooltip="Open notifications" Height="36" MinHeight="36" Width="36" MinWidth="36" Padding="8" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">🔔</Button>
      </Container>
      <Container Type="Horizontal Stack" CellGap="4" IsVisible="{Binding ShowProfile}">
        <Button id="HeaderProfileButton" action="OpenProfile" accessible-name="Account and profile" Tooltip="Open account and profile" Height="36" MinHeight="36" Width="36" MinWidth="36" Padding="8" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">👤</Button>
      </Container>
    </Container>
  </Page>
</Cui>
