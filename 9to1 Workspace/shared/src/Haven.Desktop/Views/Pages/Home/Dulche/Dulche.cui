<Cui id="home.models.dulche" version="1">
  <Theme Name="user_preference">
    <Page AccessibleName="Dulche local inference">
      <Container Type="Vertical Stack" Background="{Resource CuiPanelBrush}" BorderColor="{Resource CuiLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16" CellGap="8" MinWidth="0">
        <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="12">
          <Text Text="Installed models" FontSize="18" FontWeight="700" />
          <Text id="dulche-status" Text="Connecting to local service…" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" Column="1" FontSize="12" VerticalAlignment="Center" MaxWidth="240" />
        </Container>
        <Input id="dulche-model" Type="Select" AccessibleName="Installed inference model" MinWidth="0" HorizontalAlignment="Stretch" MinHeight="40" />
        <Text Text="{Binding SelectedModelName}" FontSize="20" FontWeight="700" TextWrapping="Wrap" />
        <Text Text="{Binding SelectedModelSummary}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
        <Text Text="{Binding SelectedModelIssue}" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" IsVisible="{Binding HasSelectedModelIssue, fallback=false}" />
        <Container Type="Wrap" CellGap="8">
          <Button id="dulche-toggle" Content="Load" AccessibleName="Change selected model state" />
          <Button id="dulche-unload" Content="Unload" />
        </Container>
        <Text id="dulche-message" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" AccessibleName="Dulche run status" IsVisible="{Binding HasRunStatus, fallback=false}" />
        <Button id="dulche-swarm-return" Content="Back to model" AccessibleName="Return from Swarm to the selected model" IsVisible="{Binding SwarmVisible, fallback=false}" HorizontalAlignment="Left" />
        <Container id="dulche-swarm-mount" Type="Vertical Stack" IsVisible="{Binding SwarmVisible, fallback=false}" AccessibleName="Swarm configuration and monitoring" />
        <Container Type="Vertical Stack" CellGap="8" IsVisible="{Binding SingleVisible, fallback=true}">
          <Container Type="Wrap" CellGap="8" AccessibleName="Selected model sections">
            <Button id="dulche-view-chat" Content="Chat" AccessibleName="Chat for the selected model" />
            <Button id="dulche-view-performance" Content="Performance" AccessibleName="Performance for the selected model" />
            <Button id="dulche-view-adapters" Content="Adapters" AccessibleName="Adapters for the selected model" />
            <Button id="dulche-manage" Content="Advanced" AccessibleName="Advanced model settings" />
          </Container>
          <Container Type="Vertical Stack" id="dulche-chat-section" CellGap="10" IsVisible="{Binding ChatVisible, fallback=true}" AccessibleName="Chat with the selected model">
            <Input id="dulche-prompt" Type="Text" PlaceholderText="Message this model…" AccessibleName="Dulche prompt" MinHeight="56" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" />
            <Container Type="Wrap" CellGap="8">
              <Button id="dulche-generate" Content="Send" AccentRole="Primary" MinWidth="96" />
              <Button id="dulche-generation-cancel" Content="Cancel response" AccessibleName="Cancel this Dulche response" IsVisible="{Binding GenerationActive, fallback=false}" />
              <Button id="dulche-new" Content="New conversation" />
            </Container>
            <Text id="dulche-output" TextWrapping="Wrap" AccessibleName="Dulche response" />
          </Container>
          <Container Type="Vertical Stack" id="dulche-performance-section" CellGap="10" IsVisible="{Binding PerformanceVisible, fallback=false}" AccessibleName="Inference performance">
            <Text Text="Performance" FontSize="18" FontWeight="700" />
            <Text id="dulche-inference-support" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" AccessibleName="Inference management availability" />
            <Container Type="Wrap" CellGap="8">
              <Button id="dulche-optimise" Content="Optimise inference" AccessibleName="Optimise inference while preserving current context" />
              <Button id="dulche-optimise-restore" Content="Restore previous settings" AccessibleName="Restore settings before the selected optimisation" />
            </Container>
            <Text Text="Optimisation keeps the selected model's current context. Progress and measured results appear below." TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            <Text id="dulche-inference-operation" TextWrapping="Wrap" AccessibleName="Inference optimisation status" />
          </Container>
          <Container Type="Vertical Stack" id="dulche-adapters-section" CellGap="10" IsVisible="{Binding AdaptersVisible, fallback=false}" AccessibleName="Model and Specialist adapters">
            <Text Text="LoRA adapters" FontSize="18" FontWeight="700" />
            <Text id="dulche-adapter-status" TextWrapping="Wrap" AccessibleName="LoRA adapter runtime status" Foreground="{Resource CuiTextSoftBrush}" />
            <Input id="dulche-adapter-path" Type="Text" PlaceholderText="Absolute local adapter path" AccessibleName="LoRA adapter path" HorizontalAlignment="Stretch" />
            <Container Type="Wrap" CellGap="8">
              <Input id="dulche-adapter-scale" Type="Text" Width="90" PlaceholderText="Scale" AccessibleName="LoRA adapter scale" />
              <Input id="dulche-adapter-scope" Type="Select" Width="150" AccessibleName="LoRA adapter binding scope" />
            </Container>
            <Input id="dulche-adapter-specialist" Type="Select" AccessibleName="Choose a Specialist" IsVisible="{Binding SpecialistAdapterScope, fallback=false}" />
            <Text Text="{Binding SpecialistAdapterStatus}" TextWrapping="Wrap" IsVisible="{Binding SpecialistAdapterScope, fallback=false}" Foreground="{Resource CuiTextSoftBrush}" />
            <Container Type="Wrap" CellGap="8">
              <Button id="dulche-adapter-attach" Content="Attach adapter" />
              <Button id="dulche-adapter-refresh" Content="Refresh adapters" />
              <Input id="dulche-adapters" Type="Select" Width="270" AccessibleName="Attached LoRA adapters" />
              <Button id="dulche-adapter-detach" Content="Detach selected adapter" />
            </Container>
          </Container>
          <Container Type="Vertical Stack" id="dulche-management" CellGap="12" IsVisible="{Binding Manage, fallback=false}" AccessibleName="Advanced model controls">
            <Text Text="Advanced" FontSize="18" FontWeight="700" />
            <Text id="dulche-detail" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            <Text id="dulche-resources" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            <Button id="dulche-swarm" Content="Swarm Mode" />
            <Text Text="Find, import and transfer models" FontSize="18" FontWeight="700" />
            <Container Type="Wrap" CellGap="6">
              <Input id="dulche-search" Type="Text" PlaceholderText="Model name or repository" AccessibleName="Find local or downloadable models" Width="255" />
              <Button id="dulche-find" Content="Search catalogue" />
              <Button id="dulche-installed" Content="Installed files" />
            </Container>
            <Container Type="Wrap" CellGap="6">
              <Input id="dulche-filter-architecture" Type="Text" Width="165" PlaceholderText="Architecture or family" AccessibleName="Architecture filter" />
              <Input id="dulche-filter-size" Type="Text" Width="155" PlaceholderText="Max parameters (B)" AccessibleName="Maximum billions of parameters" />
              <Input id="dulche-filter-capability" Type="Text" Width="175" PlaceholderText="Capability" AccessibleName="Capability filter" />
              <Input id="dulche-filter-quant" Type="Text" Width="150" PlaceholderText="Quantisation" AccessibleName="Quantisation filter" />
            </Container>
            <Input id="dulche-results" Type="Select" AccessibleName="Catalogue results" />
            <Container Type="Wrap" CellGap="6">
              <Button id="dulche-inspect" Content="Details and files" />
              <Input id="dulche-files" Type="Select" Width="245" AccessibleName="Repository file" />
              <Button id="dulche-download" Content="Download selected file" />
              <Button id="dulche-remove" Content="Uninstall selected file" />
            </Container>
            <Text id="dulche-catalog-detail" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            <Container Type="Wrap" CellGap="6">
              <Input id="dulche-import-path" Type="Text" Width="250" PlaceholderText="Absolute file or model directory path" AccessibleName="Local model path" />
              <Input id="dulche-import-base" Type="Text" Width="190" PlaceholderText="Base model for an adapter" AccessibleName="Adapter base model" />
              <Button id="dulche-import" Content="Import local model" />
            </Container>
            <Container Type="Wrap" CellGap="6">
              <Input id="dulche-jobs" Type="Select" Width="250" AccessibleName="Model transfers" />
              <Button id="dulche-pause" Content="Pause transfer" />
              <Button id="dulche-resume" Content="Resume transfer" />
              <Button id="dulche-cancel" Content="Cancel transfer" />
            </Container>
            <Text Text="Inference profile" FontWeight="700" />
            <Container Type="Wrap" CellGap="6">
              <Input id="dulche-profiles" Type="Select" Width="220" AccessibleName="Inference profiles" />
              <Button id="dulche-profile-select" Content="Select profile" />
              <Input id="dulche-profile-name" Type="Text" Width="170" PlaceholderText="Profile name" AccessibleName="Profile name" />
              <Button id="dulche-profile-save" Content="Save new profile" />
              <Button id="dulche-profile-rename" Content="Rename profile" />
            </Container>
            <Container Type="Wrap" CellGap="6">
              <Input id="dulche-profile-device" Type="Text" Width="155" PlaceholderText="GPU or CPU" AccessibleName="Profile execution device" />
              <Input id="dulche-profile-context" Type="Text" Width="165" PlaceholderText="Context tokens" AccessibleName="Profile context length" />
              <Button id="dulche-benchmarks" Content="Benchmark results" />
              <Button id="dulche-benchmark-start" Content="Run local benchmark" />
              <Button id="dulche-candidates" Content="Compare candidates" />
              <Button id="dulche-training" Content="Training status" />
            </Container>
            <Input id="dulche-candidate" Type="Select" AccessibleName="Candidate checkpoints" IsVisible="{Binding CandidatesVisible, fallback=false}" />
            <Text id="dulche-benchmark-results" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            <Input id="dulche-profile-settings" Type="Text" PlaceholderText="Profile settings as JSON" AccessibleName="GPU, context and inference profile settings" />
            <Text Text="Agents" FontWeight="700" />
            <Container Type="Wrap" CellGap="6">
              <Input id="dulche-agents" Type="Select" Width="250" AccessibleName="Dulche agents and saved runs" />
              <Button id="dulche-recover" Content="Open saved run" />
              <Button id="dulche-stop" Content="Stop selected agent" />
              <Button id="dulche-stop-all" Content="Stop all agents" />
              <Button id="dulche-agent-resume" Content="Resume selected agent" />
              <Button id="dulche-allow" Content="Allow new agents" />
            </Container>
          </Container>
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
