<Cui id="home.unified" version="1">
  <Actions>
    <Action name="OpenCustomiseWidgetPicker" command="home.newtab-widget-picker" parameter="header" />
    <Action name="OpenNewTabShortcut" command="home.newtab-shortcut-open" parameter="{Binding shortcut.Id}" />
    <Action name="EditNewTabShortcut" command="home.newtab-shortcut-edit" parameter="{Binding shortcut.Id}" />
    <Action name="ChooseNewTabShortcutTarget" command="home.newtab-shortcut-choose" parameter="{Binding target.Id}" />
  </Actions>
  <!-- At desktop widths the Home rail shows labels beside its icons. Compact widths keep the
       same actions, names and keyboard tooltips. Settings stays below the scrolling destinations. -->
  <Theme Name="user_preference">
    <Page AccessibleName="9to1 Home">
      <Container id="unified-home-root" Type="Grid" ColumnSizes="Auto 1fr" RowSizes="1fr" Background="{Resource CuiWorkspaceBrush}">
        <Container id="home-sidebar" MinWidth="56" IsVisible="{Binding rail.homeVisible, fallback=true}" Role="navigation" AccessibleName="Home navigation"
                   Type="Grid" RowSizes="Auto 1fr Auto" Padding="{Binding rail.sidebarPadding}" CellGap="8"
                   Background="{Resource CuiChromeMaterial}" BorderColor="{Resource CuiLineBrush}" BorderThickness="0 0 1 0">
          <Button id="home-brand" Action="home.newtab" AccessibleName="Home" Tooltip="Home" Width="{Binding rail.brandWidth, fallback=44}"
                  Height="44" Padding="8" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                  Background="{Resource CuiPanelBrush}" BorderWidth="0" CornerRadius="12">
            <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
              <Image id="home-brand-mark" Source="avares://Haven/Assets/haven-32.png" Width="28" Height="28" />
              <Text Text="Home" FontSize="20" FontWeight="750" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
            </Container>
          </Button>
          <Container id="home-rail-nav" Row="1" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" CellGap="2">
            <Text id="home-rail-explore" Text="Explore" FontSize="13" FontWeight="650" Foreground="{Resource CuiTextSoftBrush}"
                  Margin="12 3 0 3" IsVisible="{Binding rail.showLabels, fallback=false}" />
            <Button id="home-dashboard" action="home.dashboard" accessible-name="Dashboard" Tooltip="Dashboard" Selected="{Binding rail.dashboardSelected}" Width="{Binding rail.itemWidth, fallback=44}" Height="44" Padding="8" HorizontalAlignment="Center" HorizontalContentAlignment="Left" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image id="home-dashboard-icon" Source="icon:dashboard" Width="26" Height="26" />
                <Text Text="Dashboard" FontWeight="700" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-newtab" action="home.newtab" accessible-name="New Tab" Tooltip="New Tab" Selected="{Binding rail.newtabSelected}" Width="{Binding rail.itemWidth, fallback=44}" Height="44" Padding="8" HorizontalAlignment="Center" HorizontalContentAlignment="Left" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image id="home-newtab-icon" Source="icon:plus" Width="26" Height="26" />
                <Text Text="New Tab" FontWeight="700" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Text id="home-rail-workspace" Text="Workspace" FontSize="13" FontWeight="650" Foreground="{Resource CuiTextSoftBrush}"
                  Margin="12 14 0 3" IsVisible="{Binding rail.showLabels, fallback=false}" />
            <Button id="home-library" IsEnabled="{Binding rail.libraryAvailable, fallback=false}" action="home.library" accessible-name="Files" Tooltip="Files" Selected="{Binding rail.librarySelected}" Width="{Binding rail.itemWidth, fallback=44}" Height="44" Padding="8" HorizontalAlignment="Center" HorizontalContentAlignment="Left" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image id="home-library-icon" Source="icon:folder" Width="26" Height="26" />
                <Text Text="Files" FontWeight="700" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-assistants" Action="home.assistants" AccessibleName="Assistants" Tooltip="Assistants" IsVisible="{Binding rail.assistantsAvailable, fallback=false}"
                    Width="{Binding rail.itemWidth, fallback=44}" Height="44" Padding="8" HorizontalAlignment="Center"
                    HorizontalContentAlignment="Left" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image id="home-assistants-icon" Source="icon:agents" Width="26" Height="26" />
                <Text Text="Assistants" FontWeight="700" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-events" action="home.events" accessible-name="Events" Tooltip="Events" Selected="{Binding rail.eventsSelected}" Width="{Binding rail.itemWidth, fallback=44}" Height="44" Padding="8" HorizontalAlignment="Center" HorizontalContentAlignment="Left" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image id="home-events-icon" Source="icon:calendar" Width="26" Height="26" />
                <Text Text="Events" FontWeight="700" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Text id="home-rail-discover" Text="Discover" FontSize="13" FontWeight="650" Foreground="{Resource CuiTextSoftBrush}"
                  Margin="12 14 0 3" IsVisible="{Binding rail.showLabels, fallback=false}" />
            <Button id="home-apps" action="home.apps" accessible-name="9to1 Apps" Tooltip="9to1 Apps" Selected="{Binding rail.appsSelected}" Width="{Binding rail.itemWidth, fallback=44}" Height="44" Padding="8" HorizontalAlignment="Center" HorizontalContentAlignment="Left" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image id="home-apps-icon" Source="icon:apps" Width="26" Height="26" />
                <Text Text="9to1 Apps" FontWeight="700" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-models" action="home.models" accessible-name="Models" Tooltip="Models" Selected="{Binding rail.modelsSelected}" Width="{Binding rail.itemWidth, fallback=44}" Height="44" Padding="8" HorizontalAlignment="Center" HorizontalContentAlignment="Left" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image id="home-models-icon" Source="icon:cpu" Width="26" Height="26" />
                <Text Text="Models" FontWeight="700" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-mesh" action="home.mesh" accessible-name="Mesh" Tooltip="Mesh" Width="{Binding rail.itemWidth, fallback=44}" Height="44" Padding="8" HorizontalAlignment="Center" HorizontalContentAlignment="Left" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image id="home-mesh-icon" Source="icon:mesh" Width="26" Height="26" />
                <Text Text="Mesh" FontWeight="700" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
          </Container>
          <Container id="home-rail-footer" Row="2" Type="Vertical Stack" CellGap="2" Padding="0">
            <Button id="home-account" Action="home.account" AccessibleName="Account" Tooltip="Account" IsEnabled="{Binding rail.settingsAvailable, fallback=false}"
                    Width="{Binding rail.itemWidth, fallback=44}" Height="44" Padding="8" HorizontalAlignment="Center"
                    HorizontalContentAlignment="Left" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image id="home-account-icon" Source="icon:agents" Width="26" Height="26" />
                <Text Text="Account" FontWeight="700" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-settings" IsEnabled="{Binding rail.settingsAvailable, fallback=false}" action="home.settings" accessible-name="Settings" Tooltip="Settings" Selected="{Binding rail.settingsSelected}" Width="{Binding rail.itemWidth, fallback=44}" Height="44" Padding="8" HorizontalAlignment="Center" HorizontalContentAlignment="Left" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
              <Container Type="Horizontal Stack" CellGap="10" VerticalAlignment="Center">
                <Image id="home-settings-icon" Source="icon:settings" Width="26" Height="26" />
                <Text Text="Settings" FontWeight="700" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
          </Container>
        </Container>
        <Container id="home-main" Column="1" Type="Grid" RowSizes="Auto Auto 1fr Auto" CellGap="{Binding rail.pageGap}" Padding="{Binding rail.pagePadding}">
          <Text id="home-heading" Text="Apps" FontSize="24" FontWeight="Bold" Foreground="{Resource CuiTextBrush}" />
          <Container id="home-search-row" Row="2" Type="Vertical Stack" CellGap="24" IsVisible="False"
                     VerticalAlignment="Top" MaxWidth="1120" Padding="{Binding newTab.contentPadding, fallback=12 16 12 16}"
                     VerticalScrolling="True" HorizontalScrolling="False">
            <Container Type="Grid" ColumnSizes="1fr Auto Auto" CellGap="8">
              <Text id="home-newtab-heading" Text="Home" FontSize="36" FontWeight="800" />
              <Button id="home-newtab-customise-open" Column="2" Action="home.newtab-customise-open" Content="Customise"
                      VerticalAlignment="Center" MinHeight="36" CornerRadius="18" />
              <Button id="home-newtab-customise-add-widget" Column="1" Action="OpenCustomiseWidgetPicker"
                      AccessibleName="Add widget" Tooltip="Add widget" Background="{Resource CuiAccentSoftBrush}"
                      IsVisible="False" VerticalAlignment="Center" MinHeight="36" MinWidth="36" CornerRadius="18">
                <Container Type="Horizontal Stack" CellGap="7" VerticalAlignment="Center">
                  <Image Source="icon:plus" Width="15" Height="15" VerticalAlignment="Center" />
                  <Text Text="Add widget" FontWeight="700" VerticalAlignment="Center"
                        IsVisible="{Binding newTab.showActionLabels, fallback=false}" />
                </Container>
              </Button>
              <Button id="home-newtab-customise-done" Column="2" Action="home.newtab-customise-done" Content="Done" AccentRole="Primary"
                      IsVisible="False" VerticalAlignment="Center" MinHeight="36" CornerRadius="18" />
            </Container>
            <Container id="home-newtab-customise-mount" Type="Overlay" IsVisible="False" />
            <Container id="home-newtab-hero" Type="Vertical Stack" MaxWidth="780" CellGap="14">
              <Container id="home-newtab-clock" Type="Vertical Stack" CellGap="6" Margin="0 0 0 8">
                <Text id="home-newtab-time" FontSize="46" FontWeight="800" TextAlignment="Center" TextWrapping="Wrap" Foreground="{Resource CuiTextBrush}" />
                <Text id="home-newtab-date" FontSize="14" FontWeight="600" TextAlignment="Center" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              </Container>
              <Container id="home-search-entry" Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="8" Padding="16 8 12 8"
                         Height="68" Background="{Resource CuiPanelBrush}" CornerRadius="22">
                <Image Source="icon:search" Width="18" Height="18" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Input id="home-search" Column="1" Type="Text" PlaceholderText="Search or enter an address" AccessibleName="New Tab search or prompt"
                       MinWidth="0" Height="48" CornerRadius="18" Background="{Resource CuiTransparentBrush}" VerticalContentAlignment="Center" />
                <Button id="home-submit" Column="2" Action="home.submit" Content="→" AccessibleName="Go" Tooltip="Submit New Tab search"
                        Width="44" Height="44" Padding="0" FontSize="20" VerticalAlignment="Center" CornerRadius="22" AccentRole="Primary" />
              </Container>
              <Container Type="Wrap" CellGap="8" HorizontalAlignment="Center">
                <Button id="home-newtab-ask-ai" Action="home.ask-ai" AccessibleName="Ask AI"
                        MinHeight="36" CornerRadius="18" AccentRole="Secondary">
                  <Container Type="Horizontal Stack" CellGap="8" VerticalAlignment="Center">
                    <Image Source="icon:sparkles" Width="16" Height="16" />
                    <Text Text="Ask AI" FontWeight="700" VerticalAlignment="Center" />
                  </Container>
                </Button>
                <Button id="home-newtab-all-apps" Action="home.apps" AccessibleName="All apps"
                        MinHeight="36" CornerRadius="18" Chromeless="True">
                  <Container Type="Horizontal Stack" CellGap="8" VerticalAlignment="Center">
                    <Image Source="icon:apps" Width="16" Height="16" />
                    <Text Text="All apps" FontWeight="700" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
              <Text id="home-newtab-ai-unavailable" Text="Ask AI requires an available Spaces destination." FontSize="12" FontWeight="600"
                    TextWrapping="Wrap" TextAlignment="Center" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
            <Container id="home-newtab-shortcuts-section" Type="Vertical Stack" CellGap="12">
              <Text id="home-newtab-shortcuts-heading" Text="Shortcuts" FontSize="18" FontWeight="750" />
              <Container id="home-newtab-shortcuts" Type="Grid" CellGap="12"
                         ColumnSizes="{Binding newTab.shortcut.Columns, fallback=1fr}"
                         RowSizes="{Binding newTab.shortcut.Rows, fallback=Auto}">
                <Repeat Source="{Binding newTab.shortcut.Tiles}" As="shortcut" Key="{Binding shortcut.Id}"
                        ItemRow="{Binding shortcut.Row}" ItemColumn="{Binding shortcut.Column}">
                  <Container id="home-newtab-shortcut-card" Type="Vertical Stack" CellGap="4">
                    <Button id="home-newtab-shortcut" Action="OpenNewTabShortcut" AccessibleName="{Binding shortcut.Label}"
                            AutomationId="{Binding shortcut.AutomationId}"
                            Height="{Binding newTab.shortcut.TileHeight, fallback=80}" IsEnabled="{Binding shortcut.CanOpen}"
                            HorizontalContentAlignment="Stretch" Padding="16 10" Background="{Resource CuiPanelBrush}"
                            BorderWidth="0" CornerRadius="14">
                      <Container Type="Grid" ColumnSizes="Auto 1fr" CellGap="10">
                        <Image Source="{Binding shortcut.Icon}" Width="26" Height="26" VerticalAlignment="Center" />
                        <Text Column="1" Text="{Binding shortcut.Label}" FontWeight="750" TextWrapping="Wrap"
                              VerticalAlignment="Center" />
                      </Container>
                    </Button>
                    <Button id="home-newtab-shortcut-edit" Action="EditNewTabShortcut" Content="Edit"
                            AccessibleName="{Binding shortcut.EditLabel}" AutomationId="{Binding shortcut.EditAutomationId}"
                            Chromeless="True" HorizontalAlignment="Left" IsVisible="{Binding newTab.shortcut.Editing}"
                            IsEnabled="{Binding newTab.shortcut.CanOpenEditor}" />
                  </Container>
                </Repeat>
                <Button id="home-newtab-shortcut-add" Action="home.newtab-shortcut-add"
                        Row="{Binding newTab.shortcut.AddRow, fallback=0}" Column="{Binding newTab.shortcut.AddColumn, fallback=0}"
                        Height="{Binding newTab.shortcut.TileHeight, fallback=80}" IsVisible="{Binding newTab.shortcut.CanAdd}"
                        IsEnabled="{Binding newTab.shortcut.CanOpenEditor}" AccessibleName="Add shortcut" CornerRadius="14"
                        Background="{Resource CuiAccentSoftBrush}">
                  <Container Type="Horizontal Stack" CellGap="7">
                    <Image Source="icon:plus" Width="16" Height="16" VerticalAlignment="Center" />
                    <Text Text="Add shortcut" FontWeight="700" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
              <Container id="home-newtab-shortcut-editor" Type="Vertical Stack" CellGap="12" Padding="16" CornerRadius="16"
                         Background="{Resource CuiPanelBrush}" IsVisible="{Binding newTab.shortcut.EditorOpen}">
                <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="8">
                  <Text Text="{Binding newTab.shortcut.EditorTitle}" FontWeight="800" FontSize="18" TextWrapping="Wrap" />
                  <Button id="home-newtab-shortcut-cancel" Column="1" Action="home.newtab-shortcut-cancel" Content="Cancel"
                          IsEnabled="{Binding newTab.shortcut.CanEdit}" Chromeless="True" />
                </Container>
                <Container Type="Vertical Stack" CellGap="4">
                  <Text Text="Name" FontWeight="700" />
                  <Input id="home-newtab-shortcut-name" Type="Text" AccessibleName="Shortcut name" />
                </Container>
                <Container Type="Vertical Stack" CellGap="4">
                  <Text Text="Destination" FontWeight="700" />
                  <Input id="home-newtab-shortcut-target" Type="Text" AccessibleName="Shortcut destination"
                         PlaceholderText="https://example.com" />
                </Container>
                <Repeat Source="{Binding newTab.shortcut.Targets}" As="target" Key="{Binding target.Id}" Panel="Wrap">
                  <Button id="home-newtab-shortcut-choose" Action="ChooseNewTabShortcutTarget" Content="{Binding target.Label}"
                          AccessibleName="{Binding target.ChoiceLabel}" IsEnabled="{Binding newTab.shortcut.CanEdit}" Margin="0 0 8 6" />
                </Repeat>
                <Container Type="Wrap" CellGap="8" IsVisible="{Binding newTab.shortcut.Existing}">
                  <Button id="home-newtab-shortcut-move-up" Action="home.newtab-shortcut-move-up" Content="Move earlier"
                          IsEnabled="{Binding newTab.shortcut.CanMoveUp}" />
                  <Button id="home-newtab-shortcut-move-down" Action="home.newtab-shortcut-move-down" Content="Move later"
                          IsEnabled="{Binding newTab.shortcut.CanMoveDown}" />
                  <Button id="home-newtab-shortcut-remove" Action="home.newtab-shortcut-remove" Content="Remove shortcut"
                          IsEnabled="{Binding newTab.shortcut.CanEdit}" />
                </Container>
                <Text id="home-newtab-shortcut-status" Text="{Binding newTab.shortcut.Status}" TextWrapping="Wrap"
                      IsVisible="{Binding newTab.shortcut.HasStatus}" Foreground="{Resource CuiTextSoftBrush}" />
                <Container Type="Wrap" CellGap="8" IsVisible="{Binding newTab.shortcut.CanRetry}">
                  <Button id="home-newtab-shortcut-retry" Action="home.newtab-shortcut-retry" Content="Retry" />
                  <Button id="home-newtab-shortcut-revert" Action="home.newtab-shortcut-revert" Content="Revert" />
                </Container>
                <Button id="home-newtab-shortcut-save" Action="home.newtab-shortcut-save" Content="Save shortcut"
                        IsEnabled="{Binding newTab.shortcut.CanEdit}" AccentRole="Primary" HorizontalAlignment="Left" />
              </Container>
            </Container>
            <Container id="home-newtab-widgets-mount" Type="Overlay" IsVisible="False" />
          </Container>
          <Container id="home-content" Row="2" Type="Overlay" />
          <Text id="home-status" Row="3" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
