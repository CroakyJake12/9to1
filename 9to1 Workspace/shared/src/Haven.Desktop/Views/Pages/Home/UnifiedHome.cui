<Cui id="home.unified" version="1">
  <Actions>
    <Action name="OpenCustomiseWidgetPicker" command="home.newtab-widget-picker" parameter="header" />
    <Action name="OpenNewTabShortcut" command="home.newtab-shortcut-open" parameter="{Binding shortcut.Id}" />
    <Action name="EditNewTabShortcut" command="home.newtab-shortcut-edit" parameter="{Binding shortcut.Id}" />
    <Action name="OpenNewTabShortcutOptions" command="home.newtab-shortcut-options" parameter="{Binding shortcut.Id}" />
    <Action name="ChooseNewTabShortcutTarget" command="home.newtab-shortcut-choose" parameter="{Binding target.Id}" />
    <Action name="ChooseNewTabShortcutIcon" command="home.newtab-shortcut-icon-select" parameter="{Binding icon.Key}" />
  </Actions>
  <!-- At desktop widths the Home rail shows labels beside its icons. Compact widths keep the
       same actions, names and keyboard tooltips. Settings stays below the scrolling destinations. -->
  <Theme Name="user_preference">
    <Page AccessibleName="9to1 Home" OwnsBackdrop="True">
      <Container id="unified-home-root" Type="Grid" ColumnSizes="Auto 1fr" RowSizes="1fr" Background="{Resource CuiWorkspaceBrush}">
        <Container id="home-sidebar" Width="{Binding rail.sidebarWidth, fallback=68}" IsVisible="{Binding rail.homeVisible, fallback=true}"
                   Role="navigation" AccessibleName="Home navigation" Type="Grid" RowSizes="Auto 1fr Auto"
                   Padding="{Binding rail.sidebarPadding}" CellGap="4" Background="{Resource CuiChromeMaterial}" BorderWidth="0">
          <Button id="home-brand" Action="home.newtab" AccessibleName="Home" Tooltip="Home"
                  Width="{Binding rail.brandWidth, fallback=52}" MinHeight="42" Padding="{Binding rail.brandPadding}"
                  HorizontalAlignment="Left" HorizontalContentAlignment="Left" Background="{Resource CuiPanelBrush}" BorderWidth="0" CornerRadius="14">
            <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
              <Image id="home-brand-mark" Source="avares://HavenOS.Apps.Browse.NativeUI/Assets/9to1-logo.png" Width="30" Height="30" />
              <Text Text="Home" FontSize="18" FontWeight="750" VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
            </Container>
          </Button>
          <Container id="home-rail-nav" Row="1" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" CellGap="0" Padding="0 3 0 0">
            <Button id="home-explore" Action="home.explore" AccessibleName="Explore" Tooltip="{Binding rail.exploreTooltip}" Selected="{Binding rail.exploreSelected}" IsEnabled="{Binding rail.exploreAvailable, fallback=false}"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-explore-icon" Source="home-nav:compass" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="Explore" FontSize="13" FontWeight="{Binding rail.exploreFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-dashboard" Action="home.dashboard" AccessibleName="Dashboard" Tooltip="Dashboard" Selected="{Binding rail.dashboardSelected}"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-dashboard-icon" Source="home-nav:layout-dashboard" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="Dashboard" FontSize="13" FontWeight="{Binding rail.dashboardFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-newtab" Action="home.newtab" AccessibleName="New Tab" Tooltip="New Tab" Selected="{Binding rail.newtabSelected}"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-newtab-icon" Source="home-nav:square-plus" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="New Tab" FontSize="13" FontWeight="{Binding rail.newtabFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Text id="home-rail-workspace" Text="Workspace" FontSize="12" FontWeight="650" Foreground="{Resource CuiTextSoftBrush}"
                  Margin="14 22 0 11" IsVisible="{Binding rail.showLabels, fallback=false}" />
            <Button id="home-library" Action="home.library" AccessibleName="Files" Tooltip="Files" Selected="{Binding rail.librarySelected}" IsEnabled="{Binding rail.libraryAvailable, fallback=false}"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-library-icon" Source="home-nav:library-shelves" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="Files" FontSize="13" FontWeight="{Binding rail.libraryFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-assistants" Action="home.assistants" AccessibleName="Assistants" Tooltip="Assistants" Selected="{Binding rail.assistantsSelected}" IsEnabled="{Binding rail.assistantsAvailable, fallback=false}"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-assistants-icon" Source="home-nav:assistant-bot" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="Assistants" FontSize="13" FontWeight="{Binding rail.assistantsFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-specialists" Action="home.specialists" AccessibleName="Specialists" Tooltip="{Binding rail.specialistsTooltip}" Selected="{Binding rail.specialistsSelected}" IsEnabled="{Binding rail.specialistsAvailable, fallback=false}"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-specialists-icon" Source="home-nav:user-check" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="Specialists" FontSize="13" FontWeight="{Binding rail.specialistsFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Text id="home-rail-discover" Text="Discover" FontSize="12" FontWeight="650" Foreground="{Resource CuiTextSoftBrush}"
                  Margin="14 22 0 11" IsVisible="{Binding rail.showLabels, fallback=false}" />
            <Button id="home-apps" Action="home.apps" AccessibleName="9to1 Apps" Tooltip="9to1 Apps" Selected="{Binding rail.appsSelected}"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-apps-icon" Source="home-nav:apps" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="9to1 Apps" FontSize="13" FontWeight="{Binding rail.appsFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-models" Action="home.models" AccessibleName="Models" Tooltip="Models" Selected="{Binding rail.modelsSelected}"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-models-icon" Source="home-nav:cpu" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="Models" FontSize="13" FontWeight="{Binding rail.modelsFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-mesh" Action="home.mesh" AccessibleName="Mesh" Tooltip="Mesh"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-mesh-icon" Source="home-nav:devices-network" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="Mesh" FontSize="13" FontWeight="{Binding rail.meshFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
          </Container>
          <Container id="home-rail-footer" Row="2" Type="Vertical Stack" CellGap="0" Padding="0 14 0 0">
            <Button id="home-account" Action="home.account" AccessibleName="Account" Tooltip="Account" IsEnabled="{Binding rail.settingsAvailable, fallback=false}"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-account-icon" Source="home-nav:account-user" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="Account" FontSize="13" FontWeight="{Binding rail.accountFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
            <Button id="home-settings" Action="home.settings" AccessibleName="Settings" Tooltip="Settings" Selected="{Binding rail.settingsSelected}" IsEnabled="{Binding rail.settingsAvailable, fallback=false}"
                    Width="{Binding rail.itemWidth, fallback=52}" MinHeight="40" Padding="{Binding rail.itemPadding}" Margin="0 3"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Left" AccentRole="Primary"
                    Background="{Resource CuiTransparentBrush}" Foreground="{Resource CuiTextSoftBrush}" BorderWidth="0" CornerRadius="13">
              <Container Type="Horizontal Stack" CellGap="12" VerticalAlignment="Center">
                <Image id="home-settings-icon" Source="home-nav:settings" Width="19" Height="19" VerticalAlignment="Center" />
                <Text Text="Settings" FontSize="13" FontWeight="{Binding rail.settingsFontWeight, fallback=550}"
                      VerticalAlignment="Center" IsVisible="{Binding rail.showLabels, fallback=false}" />
              </Container>
            </Button>
          </Container>
        </Container>
        <!-- This retained backdrop is also the owner of the user's independent New Tab background. -->
        <Container id="home-canvas" Column="1" Type="Overlay" IsHitTestVisible="False"
                   IsVisible="{Binding rail.customCanvas}" Background="{Resource CuiWorkspaceBrush}" />
        <Container id="home-main" Column="1" Type="Grid" RowSizes="Auto Auto 1fr Auto" CellGap="{Binding rail.pageGap}" Padding="{Binding rail.pagePadding}">
          <Text id="home-heading" Text="Apps" FontSize="24" FontWeight="Bold" Foreground="{Resource CuiTextBrush}" />
          <Container id="home-search-row" Row="2" Type="Vertical Stack" CellGap="24" IsVisible="False"
                     VerticalAlignment="Top" MaxWidth="1120" Padding="{Binding newTab.contentPadding, fallback=12 16 12 16}"
                     VerticalScrolling="True" HorizontalScrolling="False">
            <Container Type="Grid" ColumnSizes="1fr Auto Auto" CellGap="8">
              <Text id="home-newtab-heading" Text="Home" FontSize="36" FontWeight="800" />
              <Button id="home-newtab-customise-open" Column="2" Action="home.newtab-customise-open" Content="Customise"
                      VerticalAlignment="Center" MinHeight="36" CornerRadius="18" />
              <Button id="home-newtab-customise-add-widget" Column="1" Action="OpenCustomiseWidgetPicker"
                      AccessibleName="Add widget" Tooltip="Add widget" Background="{Resource CuiAccentSoftBrush}"
                      IsVisible="False" VerticalAlignment="Center" MinHeight="36" MinWidth="36" CornerRadius="18">
                <Container Type="Horizontal Stack" CellGap="7" VerticalAlignment="Center">
                  <Image Source="icon:plus" Width="15" Height="15" VerticalAlignment="Center" />
                  <Text Text="Add widget" FontWeight="700" VerticalAlignment="Center"
                        IsVisible="{Binding newTab.showActionLabels, fallback=false}" />
                </Container>
              </Button>
              <Button id="home-newtab-customise-done" Column="2" Action="home.newtab-customise-done" Content="Done" AccentRole="Primary"
                      IsVisible="False" VerticalAlignment="Center" MinHeight="36" CornerRadius="18" />
            </Container>
            <Container id="home-newtab-customise-mount" Type="Overlay" IsVisible="False" />
            <Container id="home-newtab-hero" Type="Vertical Stack" MaxWidth="780" CellGap="14">
              <Container id="home-newtab-clock" Type="Vertical Stack" CellGap="6" Margin="0 0 0 8">
                <Text id="home-newtab-time" FontSize="46" FontWeight="800" TextAlignment="Center" TextWrapping="Wrap" Foreground="{Resource CuiTextBrush}" />
                <Text id="home-newtab-date" FontSize="14" FontWeight="600" TextAlignment="Center" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
              </Container>
              <Container id="home-search-entry" Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="8" Padding="16 8 12 8"
                         Height="68" Background="{Resource CuiPanelBrush}" CornerRadius="22">
                <Image Source="icon:search" Width="18" Height="18" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Input id="home-search" Column="1" Type="Text" PlaceholderText="Search or enter an address" AccessibleName="New Tab search or prompt"
                       MinWidth="0" Height="48" CornerRadius="18" Background="{Resource CuiTransparentBrush}" VerticalContentAlignment="Center" />
                <Button id="home-submit" Column="2" Action="home.submit" Content="→" AccessibleName="Go" Tooltip="Submit New Tab search"
                        Width="44" Height="44" Padding="0" FontSize="20" VerticalAlignment="Center" CornerRadius="22" AccentRole="Primary" />
              </Container>
              <Container Type="Wrap" CellGap="8" HorizontalAlignment="Center">
                <Button id="home-newtab-ask-ai" Action="home.ask-ai" AccessibleName="Ask AI"
                        MinHeight="36" CornerRadius="18" AccentRole="Secondary">
                  <Container Type="Horizontal Stack" CellGap="8" VerticalAlignment="Center">
                    <Image Source="icon:sparkles" Width="16" Height="16" />
                    <Text Text="Ask AI" FontWeight="700" VerticalAlignment="Center" />
                  </Container>
                </Button>
                <Button id="home-newtab-all-apps" Action="home.apps" AccessibleName="All apps"
                        MinHeight="36" CornerRadius="18" Chromeless="True">
                  <Container Type="Horizontal Stack" CellGap="8" VerticalAlignment="Center">
                    <Image Source="icon:apps" Width="16" Height="16" />
                    <Text Text="All apps" FontWeight="700" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
              <Text id="home-newtab-ai-unavailable" Text="Ask AI requires an available Spaces destination." FontSize="12" FontWeight="600"
                    TextWrapping="Wrap" TextAlignment="Center" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
            <Container id="home-newtab-shortcuts-section" Type="Vertical Stack" CellGap="12">
              <Text id="home-newtab-shortcuts-heading" Text="Shortcuts" FontSize="18" FontWeight="750" />
              <Container id="home-newtab-shortcuts" Type="Grid" CellGap="12"
                         ColumnSizes="{Binding newTab.shortcut.Columns, fallback=1fr}"
                         RowSizes="{Binding newTab.shortcut.Rows, fallback=Auto}">
                <Repeat Source="{Binding newTab.shortcut.Tiles}" As="shortcut" Key="{Binding shortcut.Id}"
                        ItemRow="{Binding shortcut.Row}" ItemColumn="{Binding shortcut.Column}">
                  <Container id="home-newtab-shortcut-card" Type="Vertical Stack" CellGap="4">
                    <Button id="home-newtab-shortcut" Action="OpenNewTabShortcut" AccessibleName="{Binding shortcut.Label}"
                            AccessibleDescription="{Binding shortcut.HelpText}"
                            AutomationId="{Binding shortcut.AutomationId}"
                            Height="{Binding newTab.shortcut.TileHeight, fallback=80}" IsEnabled="{Binding shortcut.CanOpen}"
                            HorizontalContentAlignment="Stretch" Padding="16 10" Background="{Resource CuiPanelBrush}"
                            BorderWidth="0" CornerRadius="14">
                      <Container Type="Grid" ColumnSizes="Auto 1fr" CellGap="10">
                        <Image id="home-newtab-shortcut-tile-icon" Source="{Binding shortcut.Icon}" Width="26" Height="26" VerticalAlignment="Center" />
                        <Text Column="1" Text="{Binding shortcut.Label}" FontWeight="750" TextWrapping="Wrap"
                              VerticalAlignment="Center" />
                      </Container>
                    </Button>
                    <Button id="home-newtab-shortcut-options" Action="OpenNewTabShortcutOptions" Content="Options"
                            IsVisible="{Binding shortcut.Unavailable}" IsEnabled="{Binding newTab.shortcut.CanOpenEditor}"
                            AutomationId="{Binding shortcut.OptionsAutomationId}" AccessibleName="{Binding shortcut.OptionsLabel}"
                            HorizontalAlignment="Left" Chromeless="True" />
                    <Container Type="Horizontal Stack" CellGap="4" IsVisible="{Binding newTab.shortcut.Editing}">
                      <Button id="home-newtab-shortcut-drag" Action="EditNewTabShortcut"
                              AccessibleName="{Binding shortcut.DragLabel}" AutomationId="{Binding shortcut.DragAutomationId}"
                              ToolTip="Drag to reorder. Alt+arrow moves the shortcut. Enter opens edit and move options."
                              Width="34" MinHeight="32" Padding="0" CornerRadius="8" Background="{Resource CuiPanelBrush}"
                              BorderWidth="0" IsEnabled="{Binding newTab.shortcut.CanReorder}">
                        <Image Source="icon:grip" Width="16" Height="16" IsHitTestVisible="False" />
                      </Button>
                      <Button id="home-newtab-shortcut-edit" Action="EditNewTabShortcut" Content="Edit"
                              AccessibleName="{Binding shortcut.EditLabel}" AutomationId="{Binding shortcut.EditAutomationId}"
                              Chromeless="True" IsEnabled="{Binding newTab.shortcut.CanOpenEditor}" />
                    </Container>
                  </Container>
                </Repeat>
                <Button id="home-newtab-shortcut-add" Action="home.newtab-shortcut-add"
                        Row="{Binding newTab.shortcut.AddRow, fallback=0}" Column="{Binding newTab.shortcut.AddColumn, fallback=0}"
                        Height="{Binding newTab.shortcut.TileHeight, fallback=80}" IsVisible="{Binding newTab.shortcut.CanAdd}"
                        IsEnabled="{Binding newTab.shortcut.CanOpenEditor}" AccessibleName="Add shortcut" CornerRadius="14"
                        Background="{Resource CuiAccentSoftBrush}">
                  <Container Type="Horizontal Stack" CellGap="7">
                    <Image Source="icon:plus" Width="16" Height="16" VerticalAlignment="Center" />
                    <Text Text="Add shortcut" FontWeight="700" VerticalAlignment="Center" />
                  </Container>
                </Button>
              </Container>
              <Container id="home-newtab-shortcut-editor" Type="Vertical Stack" CellGap="12" Padding="16" CornerRadius="16"
                         Background="{Resource CuiPanelBrush}" IsVisible="{Binding newTab.shortcut.EditorOpen}">
                <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="8">
                  <Text Text="{Binding newTab.shortcut.EditorTitle}" FontWeight="800" FontSize="18" TextWrapping="Wrap" />
                  <Button id="home-newtab-shortcut-cancel" Column="1" Action="home.newtab-shortcut-cancel" Content="Cancel"
                          IsVisible="{Binding newTab.shortcut.ShowFields}" IsEnabled="{Binding newTab.shortcut.CanEdit}" Chromeless="True" />
                </Container>
                <Container id="home-newtab-shortcut-icon-section" Type="Vertical Stack" CellGap="10" IsVisible="{Binding newTab.shortcut.HasIcon}">
                  <Container Type="Grid" ColumnSizes="Auto 1fr Auto" CellGap="10">
                    <Image id="home-newtab-shortcut-icon-preview" Source="{Binding newTab.shortcut.IconPreview}" Width="30" Height="30"
                           VerticalAlignment="Center" AccessibleName="Shortcut icon preview" />
                    <Text Column="1" Text="Shortcut icon" FontWeight="750" VerticalAlignment="Center" />
                    <Button id="home-newtab-shortcut-icon-open" Column="2" Action="home.newtab-shortcut-icon-open" Content="Change icon"
                            IsVisible="{Binding newTab.shortcut.ShowFields}" IsEnabled="{Binding newTab.shortcut.CanEdit}" Chromeless="True" />
                  </Container>
                  <Container id="home-newtab-shortcut-icon-options" Type="Vertical Stack" CellGap="8"
                             IsVisible="{Binding newTab.shortcut.IconOptionsOpen}">
                    <Button id="home-newtab-shortcut-icon-default" Action="home.newtab-shortcut-icon-default" Content="Use destination icon"
                            IsEnabled="{Binding newTab.shortcut.CanChooseIcon}" Selected="{Binding newTab.shortcut.IconDefaultSelected}"
                            HorizontalAlignment="Left" />
                    <Repeat Source="{Binding newTab.shortcut.IconChoices}" As="icon" Key="{Binding icon.Key}" Panel="Wrap">
                      <Button id="home-newtab-shortcut-icon-choice" Action="ChooseNewTabShortcutIcon"
                              AutomationId="{Binding icon.AutomationId}"
                              AccessibleName="{Binding icon.Label}" IsEnabled="{Binding newTab.shortcut.CanChooseIcon}"
                              Selected="{Binding icon.Selected}" Margin="0 0 8 6">
                        <Container Type="Horizontal Stack" CellGap="7">
                          <Image Source="{Binding icon.Source}" Width="19" Height="19" VerticalAlignment="Center" />
                          <Text Text="{Binding icon.Label}" VerticalAlignment="Center" />
                        </Container>
                      </Button>
                    </Repeat>
                    <Container Type="Wrap" CellGap="8">
                      <Button id="home-newtab-shortcut-icon-apply" Action="home.newtab-shortcut-icon-apply" Content="Use icon"
                              IsEnabled="{Binding newTab.shortcut.CanApplyIcon}" AccentRole="Primary" />
                      <Button id="home-newtab-shortcut-icon-cancel" Action="home.newtab-shortcut-icon-cancel" Content="Cancel icon"
                              IsEnabled="{Binding newTab.shortcut.CanChooseIcon}" />
                    </Container>
                  </Container>
                </Container>
                <Container Type="Vertical Stack" CellGap="4" IsVisible="{Binding newTab.shortcut.ShowFields}">
                  <Text Text="Name" FontWeight="700" />
                  <Input id="home-newtab-shortcut-name" Type="Text" AccessibleName="Shortcut name" />
                </Container>
                <Container Type="Vertical Stack" CellGap="4" IsVisible="{Binding newTab.shortcut.ShowFields}">
                  <Text Text="Destination" FontWeight="700" />
                  <Input id="home-newtab-shortcut-target" Type="Text" AccessibleName="Shortcut destination"
                         PlaceholderText="https://example.com" />
                </Container>
                <Container id="home-newtab-shortcut-destinations" Type="Vertical Stack" IsVisible="{Binding newTab.shortcut.ShowFields}">
                  <Repeat Source="{Binding newTab.shortcut.Targets}" As="target" Key="{Binding target.Id}" Panel="Wrap">
                    <Button id="home-newtab-shortcut-choose" Action="ChooseNewTabShortcutTarget" Content="{Binding target.Label}"
                            AccessibleName="{Binding target.ChoiceLabel}" IsEnabled="{Binding newTab.shortcut.CanEdit}" Margin="0 0 8 6" />
                  </Repeat>
                </Container>
                <Container Type="Wrap" CellGap="8" IsVisible="{Binding newTab.shortcut.ShowPlacementActions}">
                  <Button id="home-newtab-shortcut-move-up" Action="home.newtab-shortcut-move-up" Content="Move earlier"
                          IsEnabled="{Binding newTab.shortcut.CanMoveUp}" />
                  <Button id="home-newtab-shortcut-move-down" Action="home.newtab-shortcut-move-down" Content="Move later"
                          IsEnabled="{Binding newTab.shortcut.CanMoveDown}" />
                  <Button id="home-newtab-shortcut-remove" Action="home.newtab-shortcut-remove" Content="Remove shortcut"
                          IsEnabled="{Binding newTab.shortcut.CanEdit}" />
                </Container>
                <Text id="home-newtab-shortcut-status" Text="{Binding newTab.shortcut.Status}" TextWrapping="Wrap"
                      IsVisible="{Binding newTab.shortcut.HasStatus}" Foreground="{Resource CuiTextSoftBrush}" />
                <Container Type="Wrap" CellGap="8" IsVisible="{Binding newTab.shortcut.CanRetry}">
                  <Button id="home-newtab-shortcut-retry" Action="home.newtab-shortcut-retry" Content="Retry" />
                  <Button id="home-newtab-shortcut-revert" Action="home.newtab-shortcut-revert" Content="Revert" />
                </Container>
                <Button id="home-newtab-shortcut-save" Action="home.newtab-shortcut-save" Content="Save shortcut"
                        IsVisible="{Binding newTab.shortcut.ShowFields}" IsEnabled="{Binding newTab.shortcut.CanEdit}"
                        AccentRole="Primary" HorizontalAlignment="Left" />
              </Container>
            </Container>
            <Container id="home-newtab-widgets-mount" Type="Overlay" IsVisible="False" />
          </Container>
          <Container id="home-content" Row="2" Type="Overlay" />
          <Text id="home-status" Row="3" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
