<Cui id="home.unified" version="1">
  <Theme Name="user_preference">
    <Page AccessibleName="9to1 Home">
      <Container id="unified-home-root" Type="Grid" ColumnSizes="208 1fr" RowSizes="1fr" Background="{Resource CuiBackgroundBrush}">
        <Container id="home-sidebar" Type="Wrap" Orientation="Vertical" VerticalScrolling="True" HorizontalScrolling="False" CellGap="8" Padding="16" Background="{Resource CuiPanelBrush}">
          <Text Text="9to1" FontSize="24" FontWeight="Bold" Foreground="{Resource CuiTextBrush}" />
          <Button id="home-apps" action="home.apps" Content="Apps" />
          <Button id="home-dashboard" action="home.dashboard" Content="Dashboard" />
          <Button id="home-models" action="home.models" Content="Models / Discover" />
          <Button id="home-newtab" action="home.newtab" Content="New Tab" />
          <Button action="home.library" Content="Library" />
          <Button action="home.events" Content="Events" />
          <Button action="home.mesh" Content="Mesh" />
          <Button action="home.settings" Content="Settings" />
          <Button action="home.account" Content="Account" />
          <Button action="home.notifications" Content="Notifications" />
        </Container>
        <Container id="home-main" Column="1" Type="Grid" RowSizes="Auto Auto 1fr Auto" CellGap="8" Padding="16">
          <Text id="home-heading" Text="Apps" FontSize="24" FontWeight="Bold" Foreground="{Resource CuiTextBrush}" />
          <Container id="home-search-row" Row="1" Type="Wrap" CellGap="8" IsVisible="False">
            <Input id="home-search" Type="Text" PlaceholderText="Search or enter an address" AccessibleName="New Tab search or prompt" MinWidth="180" />
            <Input id="home-search-mode" Type="Select" AccessibleName="Search or AI" Width="132" />
            <Button id="home-submit" action="home.submit" Content="Go" AccessibleName="Submit New Tab search or prompt" />
          </Container>
          <Container id="home-content" Row="2" Type="Overlay" />
          <Text id="home-status" Row="3" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
        </Container>
      </Container>
    </Page>
  </Theme>
</Cui>
