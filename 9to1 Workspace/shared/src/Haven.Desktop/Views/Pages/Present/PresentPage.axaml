<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Haven.Desktop.Views.Pages.Present.PresentPage">
  <!-- Present visible product UI is Haven.UI; Avalonia is only the rendering/platform host. -->
  <!-- Backend host injection only; the original scene and emitted object CUI own their content. -->
  <ContentControl x:Name="OriginalSceneHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
</UserControl>
