<DynamicUI Name="ChatToolActivity">
  <Container Name="ToolRow" Layout="Vertical" Width="100%" Gap="4px" Padding="10px 12px" Margin="0px 0px 10px 0px" Background="SurfaceRaised" BorderColor="Border" BorderWidth="1px" Radius="12px">
    <Container Name="ToolHeading" Layout="Wrap" Gap="8px">
      <Text Name="Status" Content="{{STATUS}}" FontSize="11" FontWeight="700" Foreground="TextSecondary" />
      <Text Name="Title" Content="{{TITLE}}" FontSize="12" FontWeight="700" Foreground="TextPrimary" />
      <Text Name="Meta" Content="{{META}}" FontSize="11" Foreground="TextSecondary" />
    </Container>
    <Text Name="Detail" Content="{{DETAIL}}" FontSize="12" Foreground="TextSecondary" />
  </Container>
</DynamicUI>
