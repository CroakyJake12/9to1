<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use the same approved source fork as the application; a transitive NuGet
         Avalonia package would replace the popup producer seam at runtime. -->
    <ProjectReference Include="../../../../framework/CUI/vendor/Avalonia/src/Avalonia.Base/Avalonia.Base.csproj" />
    <ProjectReference Include="../../../../framework/CUI/vendor/Avalonia/src/Avalonia.Controls/Avalonia.Controls.csproj" />
    <PackageReference Include="Avalonia" ExcludeAssets="all" />
    <ProjectReference Include="../Haven.Desktop.Tests/Haven.Desktop.Tests.csproj"
                      SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
</Project>
