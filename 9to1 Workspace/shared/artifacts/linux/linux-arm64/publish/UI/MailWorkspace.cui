<Cui id="mail.workspace" version="1">
  <Page id="mail-page" role="main" accessible-name="9to1 Mail">
      <Container Type="Horizontal Stack" CellGap="12">
        <Container id="mail-navigation" width="260" role="navigation" accessible-name="Mail navigation" Type="Vertical Stack" CellGap="8">
          <Text text="Mail" font-size="24" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
          <Button id="compose" action="mail.compose" accessible-name="Compose a message" content="Compose" />
          <Input id="mail-search" Type="Text" Value="{Binding searchText, mode=TwoWay}" action="mail.search" accessible-name="Search mail" PlaceholderText="Search mail" />
          <Repeat Source="{Binding views}" As="view" Key="{Binding view.key}" Type="Vertical Stack">
            <Container Type="Vertical Stack">
              <Button id="mail-view" action="mail.open-view" action-argument="{Binding view.key}" accessible-name="Open {Binding view.name}">
                <Text text="{Binding view.name}" />
                <Text text="{Binding view.unreadCount}" foreground="{Resource CuiTextSoftBrush}" />
              </Button>
            </Container>
          </Repeat>
          <If Condition="!{Binding views.Count}">
            <Text text="Connect an account to begin" foreground="{Resource CuiTextSoftBrush}" />
          </If>
          <Text text="Accounts" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextSoftBrush}" />
          <Repeat Source="{Binding accounts}" As="account" Key="{Binding account.accountId}" Type="Vertical Stack">
            <Container Type="Vertical Stack">
              <Button id="mail-account" action="mail.select-account" action-argument="{Binding account.accountId}" accessible-name="Open {Binding account.displayName}">
                <Text text="{Binding account.displayName}" />
                <Text text="{Binding account.syncSummary}" foreground="{Resource CuiTextSoftBrush}" />
              </Button>
            </Container>
          </Repeat>
          <If Condition="!{Binding accounts.Count}">
            <Text text="No accounts connected" foreground="{Resource CuiTextSoftBrush}" />
          </If>
          <Button id="manage-accounts" action="mail.accounts.manage" accessible-name="Manage mail accounts" content="Manage accounts" />
          <Button id="mail-settings" action="mail.settings.open" accessible-name="Mail settings" content="Settings" />
        </Container>
        <Container id="mail-main" accessible-name="Messages and reading pane" Type="Vertical Stack" CellGap="8">
          <Container id="mail-toolbar" accessible-name="Current mailbox controls" Type="Horizontal Stack" CellGap="8">
            <Text id="mail-view-title" text="{Binding viewTitle, fallback=Unified Inbox}" font-size="24" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
            <Button action="mail.sync-all" accessible-name="Sync all mail" content="Sync all" />
            <Input id="reading-pane-position" Type="Select" ItemsSource="{Binding paneOptions}" SelectedIndex="{Binding settings.readingPane, mode=TwoWay, type=int}" accessible-name="Reading pane position" />
            <Input id="mail-density" Type="Select" ItemsSource="{Binding densityOptions}" SelectedIndex="{Binding settings.density, mode=TwoWay, type=int}" accessible-name="Message density" />
          </Container>
          <Container Type="Horizontal Stack" CellGap="8">
            <Container id="message-list-panel" accessible-name="Message list" Type="Vertical Stack" CellGap="4">
              <Repeat Source="{Binding messages}" As="message" Key="{Binding message.messageId}" Type="Vertical Stack">
                <Container role="listitem" Type="Vertical Stack">
                  <Button id="message-summary" action="mail.open-message" action-argument="{Binding message.messageId}" accessible-name="Message">
                    <Text text="{Binding message.senderLabel}" font-weight="SemiBold" />
                    <Text text="{Binding message.subject}" font-weight="SemiBold" />
                    <Text text="{Binding message.preview}" foreground="{Resource CuiTextSoftBrush}" />
                    <Text text="{Binding message.receivedLabel}" foreground="{Resource CuiTextSoftBrush}" />
                    <Text text="{Binding message.indicators}" foreground="{Resource CuiTextSoftBrush}" />
                  </Button>
                  <Container Type="Horizontal Stack" CellGap="4">
                    <Button action="mail.star" action-argument="{Binding message.messageId}" accessible-name="{Binding message.starActionName}" content="{Binding message.starGlyph}" />
                    <Button action="mail.archive" action-argument="{Binding message.messageId}" accessible-name="Archive {Binding message.subject}" content="Archive" />
                    <Button action="mail.delete" action-argument="{Binding message.messageId}" accessible-name="Move {Binding message.subject} to Trash" content="Delete" />
                    <Button action="mail.snooze" action-argument="{Binding message.messageId}" accessible-name="Snooze {Binding message.subject}" content="Snooze" />
                  </Container>
                </Container>
              </Repeat>
              <If Condition="!{Binding messages.Count}">
                <Text text="No messages in this view" foreground="{Resource CuiTextSoftBrush}" />
              </If>
            </Container>
            <Container id="reading-pane" accessible-name="Message reading pane" Type="Vertical Stack" CellGap="4">
              <If Condition="{Binding hasSelection}">
                <Container id="message-detail" Type="Vertical Stack" CellGap="4">
                  <Text id="message-subject" text="{Binding selectedMessage.subject}" font-size="20" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
                  <Container Type="Horizontal Stack" CellGap="4">
                    <Text text="{Binding selectedMessage.senderLabel}" accessible-name="Actual sender address" />
                    <Text text="{Binding selectedMessage.recipientsLabel}" foreground="{Resource CuiTextSoftBrush}" />
                    <Text text="{Binding selectedMessage.receivedLabel}" foreground="{Resource CuiTextSoftBrush}" />
                    <Text text="{Binding selectedMessage.authenticationSummary}" foreground="{Resource CuiTextSoftBrush}" />
                  </Container>
                  <Container Type="Horizontal Stack" CellGap="4">
                    <Button action="mail.reply" action-argument="{Binding selectedMessage.messageId}" accessible-name="Reply" content="Reply" />
                    <Button action="mail.reply-all" action-argument="{Binding selectedMessage.messageId}" accessible-name="Reply all" content="Reply all" />
                    <Button action="mail.forward" action-argument="{Binding selectedMessage.messageId}" accessible-name="Forward" content="Forward" />
                    <Button action="mail.mark-read" action-argument="{Binding selectedMessage.messageId}" accessible-name="Mark read or unread" content="{Binding selectedMessage.readActionLabel}" />
                    <Button action="mail.view-source" action-argument="{Binding selectedMessage.messageId}" accessible-name="View message source and headers" content="Message details" />
                  </Container>
                  <Text id="remote-content-status" text="{Binding selectedMessage.remoteContentStatus}" role="status" foreground="{Resource CuiTextSoftBrush}" />
                  <If Condition="{Binding selectedMessage.remoteContentBlocked}">
                    <Button id="load-remote-content" action="mail.remote-content.allow-message" action-argument="{Binding selectedMessage.messageId}" accessible-name="Load remote images and content for this message" content="Load remote content" />
                  </If>
                  <Container VerticalScrolling="True" Type="Vertical Stack" CellGap="4">
                    <Text id="message-plain-body" text="{Binding selectedMessage.plainBody}" TextWrapping="Wrap" />
                  </Container>
                  <Repeat Source="{Binding selectedMessage.attachments}" As="attachment" Key="{Binding attachment.attachmentId}" Type="Vertical Stack">
                    <Container Type="Horizontal Stack" CellGap="4">
                      <Text id="compose-attachment-name" text="{Binding attachment.fileName}" />
                      <Text text="{Binding attachment.sizeLabel}" foreground="{Resource CuiTextSoftBrush}" />
                      <Text text="{Binding attachment.securitySummary}" role="status" foreground="{Resource CuiTextSoftBrush}" />
                      <Button action="mail.attachment.open" action-argument="{Binding attachment.attachmentId}" accessible-name="Open {Binding attachment.fileName}" content="Open" />
                      <Button action="mail.attachment.save" action-argument="{Binding attachment.attachmentId}" accessible-name="Save {Binding attachment.fileName} to Files" content="Save to Files" />
                      <Button action="mail.attachment.board" action-argument="{Binding attachment.attachmentId}" accessible-name="Add {Binding attachment.fileName} to Board" content="Add to Board" />
                    </Container>
                  </Repeat>
                  <If Condition="!{Binding selectedMessage.attachments.Count}">
                    <Text text="No attachments" foreground="{Resource CuiTextSoftBrush}" />
                  </If>
                </Container>
              </If>
              <If Condition="!{Binding hasSelection}">
                <Text id="mail-empty-selection" text="Select a message to read it here." role="status" foreground="{Resource CuiTextSoftBrush}" />
              </If>
            </Container>
          </Container>
          <If Condition="{Binding isComposing}">
            <Container id="mail-compose" accessible-name="Compose email" Type="Vertical Stack" CellGap="4">
              <Input id="from-identity" Type="Select" ItemsSource="{Binding compose.fromIdentities}" SelectedIndex="{Binding compose.fromIdentityId, mode=TwoWay, type=int}" accessible-name="From identity" />
              <Input id="to-recipients" Type="Text" Value="{Binding compose.toText, mode=TwoWay}" action="mail.compose.update-to" accessible-name="To" PlaceholderText="To" />
              <Button action="mail.compose.toggle-cc" accessible-name="Add Cc" content="Cc" />
              <Button action="mail.compose.toggle-bcc" accessible-name="Add Bcc" content="Bcc" />
              <If Condition="{Binding compose.showCc}">
                <Input id="cc-recipients" Type="Text" Value="{Binding compose.ccText, mode=TwoWay}" action="mail.compose.update-cc" accessible-name="Cc" />
              </If>
              <If Condition="{Binding compose.showBcc}">
                <Input id="bcc-recipients" Type="Text" Value="{Binding compose.bccText, mode=TwoWay}" action="mail.compose.update-bcc" accessible-name="Bcc" />
              </If>
              <Input id="mail-subject" Type="Text" Value="{Binding compose.subject, mode=TwoWay}" action="mail.compose.update-subject" accessible-name="Subject" />
              <Container id="compose-formatting" accessible-name="Message formatting" Type="Horizontal Stack" CellGap="4">
                <Button action="mail.compose.bold" accessible-name="Bold" content="Bold" />
                <Button action="mail.compose.italic" accessible-name="Italic" content="Italic" />
                <Button action="mail.compose.link" accessible-name="Insert link" content="Link" />
                <Input id="plain-text-mode" Type="Checkbox" IsChecked="{Binding compose.plainTextMode, mode=TwoWay}" action="mail.compose.plain-text" accessible-name="Plain text mode" />
                <Button action="mail.compose.attach-files" accessible-name="Attach from Files" content="Attach" />
              </Container>
              <Input id="mail-compose-body" Type="Text" Value="{Binding compose.plainBody, mode=TwoWay}" action="mail.compose.update-body" accessible-name="Email body" AcceptsReturn="true" />
              <Repeat Source="{Binding compose.attachments}" As="attachment" Key="{Binding attachment.id}" Type="Vertical Stack">
                <Container Type="Horizontal Stack" CellGap="4">
                  <Text id="compose-attachment-file" text="{Binding attachment.fileName}" />
                </Container>
              </Repeat>
              <Text id="draft-autosave-status" text="{Binding compose.saveStatus}" role="status" foreground="{Resource CuiTextSoftBrush}" />
              <Container id="compose-actions" Type="Horizontal Stack" CellGap="4">
                <Button action="mail.compose.close" accessible-name="Close composer" content="Close" />
                <Button action="mail.compose.discard" accessible-name="Move draft to Trash" content="Discard draft" />
                <Button id="send-mail" action="mail.send" IsEnabled="{Binding compose.canSend}" accessible-name="Send email" content="Send" />
              </Container>
            </Container>
          </If>
          <Text id="mail-status" text="{Binding status.message}" role="status" accessible-name="Mail status" foreground="{Resource CuiTextSoftBrush}" />
          <Container id="FloatingAiBar" role="complementary" accessible-name="Ask Dulche about Mail" Type="Vertical Stack" CellGap="4">
            <Container Type="Horizontal Stack" CellGap="4">
              <Text text="{Binding AccessModeLabel}" />
              <Button id="ReadOnlyMode" content="Read-only" action="SetReadOnly" accessible-name="Set AI access to read-only" />
              <Button id="WriteMode" content="Write" action="SetWriteMode" accessible-name="Set AI access to write mode" />
              <Button id="AiModel" content="{Binding ModelPickerLabel}" IsVisible="{Binding ModelPickerAvailable}" action="SelectNextModel" accessible-name="Choose AI model" />
              <Button id="ExpandAi" content="Ask Dulche" IsVisible="{Binding IsCollapsed}" action="Expand" accessible-name="Open AI assistant" />
            </Container>
            <If Condition="{Binding IsExpanded}">
              <Container Type="Vertical Stack" CellGap="4">
                <Text text="{Binding ContextLabel}" />
                <Input id="AiPrompt" Type="Text" Value="{Binding Prompt, mode=TwoWay}" action="Submit" accessible-name="Ask about the selected mail" />
                <Text text="{Binding RequestStateLabel}" />
                <Container Type="Horizontal Stack" CellGap="4">
                  <Button content="Send" action="Submit" />
                  <If Condition="{Binding IsStreaming}">
                    <Button content="Stop" action="Cancel" />
                  </If>
                  <Button content="Close" action="Collapse" />
                </Container>
                <Text text="{Binding Response}" />
                <If Condition="{Binding HasError}">
                  <Text text="{Binding Error}" foreground="{Resource CuiTextSoftBrush}" />
                </If>
              </Container>
            </If>
          </Container>
        </Container>
      </Container>
    </Page>
</Cui>
