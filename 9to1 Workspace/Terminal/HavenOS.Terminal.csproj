<!--
  FILE DOCUMENTATION
  Where: HavenOS Apps/Terminal/HavenOS.Terminal.csproj.
  What: Builds the standalone HavenOS Terminal app surface against the existing application-layer terminal contracts.
  Why: Keeps Terminal app ownership isolated while preserving the shared session engine and permission policy.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HavenOS.Terminal</AssemblyName>
    <RootNamespace>HavenOS.Apps.Terminal</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);Source\**\*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\shared\src\Haven.Application\Haven.Application.csproj" />
    <ProjectReference Include="..\..\framework\CUI\Core\CakeOS.Cui.Core.csproj" />
    <Compile Remove="Tests\**\*.cs" />
    <Content Include="Terminal.cui" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
