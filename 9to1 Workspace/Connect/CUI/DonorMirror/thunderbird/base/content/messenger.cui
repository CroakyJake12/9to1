              <Container id="tabmail-tabs" Type="Horizontal Stack" role="Grow" vertical-alignment="Bottom">
                <Image id="img" />
                <Container id="tabmail-arrowscrollbox" Type="Vertical Stack" role="Grow">
                  <Button id="tab" />
                </Container>
              </Container>
              <Button id="alltabs-button" tooltip="{Binding listAllTabs.label}">
                <Container id="alltabs-popup" Type="Menu" />
              </Button>
            </Container>
          </Container>
        </Container>
        <Container id="messengerBody" Type="Vertical Stack">
          <Container id="tabmail-container" Type="Horizontal Stack" role="Grow">
            <Container id="tabmail" Type="Vertical Stack" role="Grow">
              <Container id="tabmail-tabbox" Type="Vertical Stack" role="Grow">
                <Container id="tabpanelcontainer" Type="Vertical Stack" role="Grow" />
              </Container>
              <Container id="mail3PaneTabTemplate" Type="Vertical Stack">
                <Container id="stack" Type="Overlay" role="Grow">
                  <Container id="browser" Type="Overlay" role="Grow">
                    <Image id="browser-icon" source="about:3pane" />
                  </Container>
                </Container>
              </Container>
              <Container id="mailMessageTabTemplate" Type="Vertical Stack">
                <Container id="stack-2" Type="Overlay" role="Grow">
                  <Container id="browser-2" Type="Overlay" role="Grow">
                    <Image id="browser-icon-2" source="about:message" />
                  </Container>
                </Container>
              </Container>
              <Container id="hiddenPrintContent" Type="Overlay" />
            </Container>
            <Container id="contentTab" Type="Vertical Stack">
              <Container id="vbox" Type="Vertical Stack" role="Grow">
                <Container id="dummycontenttoolbox" Type="Vertical Stack">
                  <Container id="dummycontenttoolbar" Type="Horizontal Stack">
                    <Button id="toolbarbutton" tooltip="{Binding browseBackButton.tooltip}" />
                    <Button id="toolbarbutton-2" tooltip="{Binding browseForwardButton.tooltip}" />
                    <Container id="toolbaritem" Type="Vertical Stack" role="Grow">
                      <Image id="img-2" />
                      <Input id="input" Type="Text" />
                    </Container>
                  </Container>
                </Container>
                <Container id="stack-3" Type="Overlay" role="Grow" />
              </Container>
            </Container>
            <Container id="glodaTab" Type="Vertical Stack">
              <Container id="vbox-2" Type="Vertical Stack" role="Grow">
                <Container id="vbox-3" Type="Vertical Stack">
                  <Container id="hbox-3" Type="Horizontal Stack" role="Grow">
                    <Container id="spacer" Type="Vertical Stack" role="Grow" />
                    <Container id="spacer-2" Type="Vertical Stack" role="Grow" />
                    <Container id="hbox-4" Type="Horizontal Stack" role="Grow">
                      <Input id="input-2" />
                    </Container>
                  </Container>
                </Container>
                <Container id="iframe" Type="Overlay" role="Grow" />
              </Container>
            </Container>
            <Container id="preferencesTab" Type="Vertical Stack">
              <Container id="vbox-4" Type="Vertical Stack" role="Grow">
                <Container id="hbox-5" Type="Horizontal Stack" role="Grow">
                  <Container id="preferencesbrowser" Type="Overlay" role="Grow" />
                </Container>
              </Container>
            </Container>
          </Container>
          <Container id="customizeToolbarSheetPopup" Type="Overlay">
            <Container id="customizeToolbarSheetIFrame" Type="Overlay" />
          </Container>
          <Container id="messenger-notification-bottom" Type="Vertical Stack" />
          <Container id="statusbar-display" Type="Vertical Stack" />
          <Container id="status-bar" Type="Horizontal Stack">
            <Button id="spacesToolbarReveal" action="g-spaces-toolbar.toggle-toolbar">
              <Image id="img-3" source="chrome://messenger/skin/icons/new/compact/collapse.svg" />
            </Button>
            <Container id="hbox-6" Type="Horizontal Stack" role="Grow">
              <Container id="calendar-invitations-panel" Type="Horizontal Stack">
                <Text id="calendar-invitations-label" />
              </Container>
            </Container>
          </Container>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
