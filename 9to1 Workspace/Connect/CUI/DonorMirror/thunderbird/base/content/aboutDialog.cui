                </Container>
                <Container id="communityDesc" Type="Vertical Stack">
                  <Button id="a-3" />
                  <Button id="a-4" />
                </Container>
                <Container id="contributeDesc" Type="Vertical Stack">
                  <Button id="a-5" />
                  <Button id="a-6" />
                </Container>
              </Container>
            </Container>
          </Container>
          <Container id="bottomBox" Type="Vertical Stack">
            <Container id="hbox-3" Type="Horizontal Stack" horizontal-alignment="Center">
              <Button id="a-7" />
