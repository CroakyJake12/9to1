        <Container id="script-16" Type="Vertical Stack">
          <Image id="script-icon-16" source="chrome://global/content/macWindowMenu.js" />
        </Container>
        <Container id="script-17" Type="Vertical Stack">
          <Image id="script-icon-17" source="chrome://messenger/content/macMessengerMenu.js" />
        </Container>
        <Container id="script-18" Type="Vertical Stack">
          <Image id="script-icon-18" source="chrome://messenger/content/hiddenWindowMac.js" />
