        </Container>
        <Container id="script-13" Type="Vertical Stack">
          <Image id="script-icon-13" source="chrome://messenger/content/viewZoomOverlay.js" />
        </Container>
        <Container id="script-14" Type="Vertical Stack">
          <Image id="script-icon-14" source="chrome://communicator/content/utilityOverlay.js" />
        </Container>
        <Container id="script-15" Type="Vertical Stack">
          <Image id="script-icon-15" source="chrome://messenger/content/mailCore.js" />
