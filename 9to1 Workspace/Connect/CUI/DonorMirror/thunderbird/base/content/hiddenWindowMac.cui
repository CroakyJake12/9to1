        </Container>
        <Container id="script-7" Type="Vertical Stack">
          <Image id="script-icon-7" source="chrome://messenger/content/mailWindowOverlay.js" />
        </Container>
        <Container id="script-8" Type="Vertical Stack">
          <Image id="script-icon-8" source="chrome://messenger/content/mailTabs.js" />
        </Container>
        <Container id="script-9" Type="Vertical Stack">
          <Image id="script-icon-9" source="chrome://messenger-newsblog/content/newsblogOverlay.js" />
        </Container>
        <Container id="script-10" Type="Vertical Stack">
          <Image id="script-icon-10" source="chrome://messenger/content/accountUtils.js" />
        </Container>
        <Container id="script-11" Type="Vertical Stack">
          <Image id="script-icon-11" source="chrome://messenger/content/mail-offline.js" />
