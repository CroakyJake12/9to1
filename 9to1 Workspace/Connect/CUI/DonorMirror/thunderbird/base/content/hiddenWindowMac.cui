      <Container id="body" Type="Vertical Stack">
        <Container id="bundle_messenger" Type="Vertical Stack">
          <Image id="bundle_messenger-icon" source="chrome://messenger/locale/messenger.properties" />
        </Container>
        <Container id="bundle_brand" Type="Vertical Stack">
          <Image id="bundle_brand-icon" source="chrome://branding/locale/brand.properties" />
        </Container>
        <Container id="mailKeys" Type="Vertical Stack">
          <Container id="tasksKeys" Type="Vertical Stack">
            <Container id="key_newMessage" Type="Vertical Stack" />
            <Container id="key_newMessage2" Type="Vertical Stack" />
          </Container>
        </Container>
        <Container id="mailCommands" Type="Vertical Stack">
          <Container id="mailSearchMenuItems" Type="Vertical Stack" />
          <Container id="globalEditMenuItems" Type="Vertical Stack" />
          <Container id="selectEditMenuItems" Type="Vertical Stack" />
          <Container id="clipboardEditMenuItems" Type="Vertical Stack" />
          <Container id="tasksCommands" Type="Vertical Stack">
            <Container id="command" Type="Vertical Stack" />
            <Container id="command-2" Type="Vertical Stack" />
          </Container>
        </Container>
        <Container id="popupset" Type="Vertical Stack">
          <Container id="menu_mac_dockmenu" Type="Context Menu">
            <Button id="tasksWriteNewMessage" Type="Menu Item" content="{Binding writeNewMessageDock.label}" action="write-new-message-dock" />
            <Button id="tasksOpenAddressBook" Type="Menu Item" content="{Binding openAddressBookDock.label}" action="open-address-book-dock" />
            <Button id="tasksMenuDockOptions" Type="Menu Item" content="{Binding dockOptions.label}" action="open-dock-options" />
          </Container>
        </Container>
        <Container id="navigation-toolbox" Type="Vertical Stack">
          <Container id="titlebar" Type="Vertical Stack">
            <Container id="toolbar-menubar" Type="Toolbar" />
          </Container>
        </Container>
        <Container id="hiddenBrowser" Type="Overlay" />
      </Container>
    </Container>
