<Cui id="content-hidden-window-mac" product="9-1" version="1">
  <Actions>
    <Action name="cmd-new-message" command="cmd_newMessage" />
    <Action name="open-address-book-dock" command="openAddressBookDock();" />
    <Action name="open-dock-options" command="openDockOptions();" />
    <Action name="write-new-message-dock" command="writeNewMessageDock();" />
  </Actions>
  <Page id="content-hidden-window-mac-root">
    <Container id="hidden-window" Type="Vertical Stack">
      <Container id="head" Type="Vertical Stack">
        <Container id="title" Type="Vertical Stack" />
        <Container id="meta" Type="Vertical Stack" />
        <Container id="link" Type="Vertical Stack" />
        <Container id="link-2" Type="Vertical Stack" />
        <Container id="link-3" Type="Vertical Stack" />
        <Container id="link-4" Type="Vertical Stack" />
        <Container id="link-5" Type="Vertical Stack" />
        <Container id="link-6" Type="Vertical Stack" />
        <Container id="script" Type="Vertical Stack">
          <Image id="script-icon" source="chrome://messenger/content/globalOverlay.js" />
        </Container>
        <Container id="script-2" Type="Vertical Stack">
          <Image id="script-icon-2" source="chrome://messenger/content/mailWindow.js" />
        </Container>
        <Container id="script-3" Type="Vertical Stack">
