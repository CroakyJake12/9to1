<Cui id="content-mac-window-menu.inc" product="9-1" version="1">
  <Actions>
    <Action name="window.minimize" command="window.minimize();" />
    <Action name="zoom-window" command="zoomWindow();" />
  </Actions>
  <Page id="content-mac-window-menu.inc-root">
    <Button id="windowMenu" Type="Menu Item" content="{Binding windowMenu.label}">
      <Container id="windowPopup" Type="Context Menu">
        <Container id="menuseparator" Type="Separator" />
        <Button id="minimizeWindow" Type="Menu Item" content="{Binding minimizeWindow.label}" action="window.minimize" />
        <Button id="zoomWindow" Type="Menu Item" content="{Binding zoomWindow.label}" action="zoom-window" />
        <Container id="sep-window-list" Type="Separator" />
      </Container>
    </Button>
  </Page>
</Cui>
