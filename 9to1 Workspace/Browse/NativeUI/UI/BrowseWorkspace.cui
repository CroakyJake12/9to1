<Cui id="9to1.Browse.Workspace" version="1">
  <Actions>
    <Action name="SelectTab" command="9to1.Browse.SelectTab" parameter="{Binding tab.Target}" />
    <Action name="OpenBookmark" command="9to1.Browse.OpenBookmark" parameter="{Binding bookmark.Target}" />
    <Action name="OpenHistory" command="9to1.Browse.OpenHistory" parameter="{Binding visit.Target}" />
    <Action name="ShowDownloadInFiles" command="9to1.Browse.ShowDownloadInFiles" parameter="{Binding download.Target}" />
    <Action name="RegisterDownloadDestination" command="9to1.Browse.RegisterDownloadDestination" parameter="{Binding folder.Target}" />
  </Actions>
  <Page id="BrowseRoot" AccessibleName="9to1 Haven browser">
    <Container id="BrowseLayout" Type="Grid" Margin="6" RowSizes="Auto Auto 1fr Auto" ColumnSizes="1fr" CellGap="4">
      <Container id="BrowseTabStrip" Type="Grid" ColumnSizes="1fr Auto Auto" CellGap="4">
        <Container Type="Overlay" HorizontalScrolling="True" VerticalScrolling="False">
          <Repeat Source="{Binding Tabs}" As="tab" Key="{Binding tab.Key}" Panel="Horizontal Stack">
            <Button action="SelectTab" Text="{Binding tab.Label}" AccessibleName="{Binding tab.Label}" Selected="{Binding tab.Selected}" Interactive="{Binding Can.SelectTab}" MaxWidth="240" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14" />
          </Repeat>
        </Container>
        <Button id="BrowseNewTabButton" action="9to1.Browse.NewTab" Column="1" Interactive="{Binding Can.NewTab}" AccessibleName="New tab" Height="32" MinHeight="32" MinWidth="44" Padding="6 2" FontSize="14">+</Button>
        <Button id="BrowseCloseTabButton" action="9to1.Browse.CloseTab" Column="2" Interactive="{Binding Can.CloseTab}" AccessibleName="Close selected tab" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">×</Button>
      </Container>
      <Container id="BrowseNavigationBar" Type="Grid" Row="1" ColumnSizes="Auto Auto Auto Auto 1fr Auto Auto Auto" CellGap="2">
        <Button id="BrowseBackButton" action="9to1.Browse.Back" AccessibleName="Go back" Interactive="{Binding CanBack}" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">←</Button>
        <Button id="BrowseForwardButton" action="9to1.Browse.Forward" Column="1" AccessibleName="Go forward" Interactive="{Binding CanForward}" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">→</Button>
        <Button id="BrowseReloadButton" action="9to1.Browse.Reload" Column="2" AccessibleName="Reload page" Interactive="{Binding Can.Reload}" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">↻</Button>
        <Button id="BrowseStopButton" action="9to1.Browse.Stop" Column="3" AccessibleName="Stop loading" Interactive="{Binding Can.Stop}" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">×</Button>
        <Input Type="Text" id="BrowseAddressBox" Column="4" Interactive="{Binding CanEdit}" AccessibleName="Search or enter web address" Value="{Binding Address, mode=TwoWay}" Height="32" MinHeight="32" MinWidth="80" Padding="8 2" FontSize="14" />
        <Button id="BrowseNavigateButton" action="9to1.Browse.Navigate" Column="5" AccessibleName="Go to address" Interactive="{Binding Can.Navigate}" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">Go</Button>
        <Button id="BrowseBookmarkButton" action="9to1.Browse.Bookmark" Column="6" AccessibleName="Bookmark page" Interactive="{Binding Can.Bookmark}" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">☆</Button>
        <Button id="BrowseMoreButton" action="9to1.Browse.ToggleTools" Column="7" AccessibleName="Browser tools" Selected="{Binding ToolsOpen}" Interactive="{Binding Can.ToggleTools}" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">⋯</Button>
      </Container>
      <Container id="BrowseContentViewport" Type="Grid" Row="2" ColumnSizes="1fr Auto" RowSizes="1fr" MinHeight="180">
        <Object Type="browse.engine" id="BrowseEngineView" MinHeight="180" AccessibleName="Original native browser engine surface" />
        <Container id="BrowseNativePagePanel" Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False" IsVisible="{Binding IsNativePage}">
          <Container Type="Vertical Stack" CellGap="8" Margin="12">
            <Text Text="{Binding NativeTitle}" AccessibleName="Native Browse page title" />
            <Container id="BrowseBookmarksPage" Type="Vertical Stack" CellGap="6" IsVisible="{Binding IsBookmarks}">
              <Repeat Source="{Binding Bookmarks}" As="bookmark" Key="{Binding bookmark.Key}">
                <Container Type="Vertical Stack">
                  <Button id="BrowseBookmarkRowButton" action="OpenBookmark" Text="{Binding bookmark.Label}" AccessibleName="{Binding bookmark.Label}" Interactive="{Binding Can.OpenBookmark}" />
                  <Text Text="{Binding bookmark.Detail}" TextWrapping="Wrap" />
                </Container>
              </Repeat>
              <Text IsVisible="{Binding EmptyBookmarks}">No saved bookmarks.</Text>
            </Container>
            <Container id="BrowseHistoryPage" Type="Vertical Stack" CellGap="6" IsVisible="{Binding IsHistory}">
              <Repeat Source="{Binding History}" As="visit" Key="{Binding visit.Key}">
                <Container Type="Vertical Stack">
                  <Button id="BrowseHistoryRowButton" action="OpenHistory" Text="{Binding visit.Label}" AccessibleName="{Binding visit.Label}" Interactive="{Binding Can.OpenHistory}" />
                  <Text Text="{Binding visit.Detail}" TextWrapping="Wrap" />
                </Container>
              </Repeat>
              <Text IsVisible="{Binding EmptyHistory}">No recorded web visits.</Text>
              <Button id="BrowseClearHistoryButton" action="9to1.Browse.ClearHistory" Interactive="{Binding Can.ClearHistory}">Clear local history</Button>
            </Container>
            <Container id="BrowseDownloadsPage" Type="Vertical Stack" CellGap="6" IsVisible="{Binding IsDownloads}">
              <Button id="BrowseDownloadsButton" action="9to1.Browse.Downloads" Interactive="{Binding Can.Downloads}">Refresh downloads</Button>
              <Text Text="{Binding DownloadStatus}" TextWrapping="Wrap" />
              <Text Text="{Binding DownloadOpenStatus}" TextWrapping="Wrap" />
              <Repeat Source="{Binding Downloads}" As="download" Key="{Binding download.Key}">
                <Container Type="Vertical Stack">
                  <Text Text="{Binding download.Label}" />
                  <Text Text="{Binding download.Detail}" TextWrapping="Wrap" />
                  <Button id="BrowseDownloadFilesButton" action="ShowDownloadInFiles" Interactive="{Binding Can.ShowDownloadInFiles}">Show in Files</Button>
                </Container>
              </Repeat>
              <Text Text="{Binding DownloadDestinationPrompt}" TextWrapping="Wrap" />
              <Repeat Source="{Binding DownloadDestinations}" As="folder" Key="{Binding folder.Key}">
                <Button id="BrowseDownloadDestinationButton" action="RegisterDownloadDestination" Text="{Binding folder.Label}" Interactive="{Binding Can.RegisterDownloadDestination}" />
              </Repeat>
              <Button id="BrowseRetryDownloadRegistrationButton" action="9to1.Browse.RetryDownloadRegistration" Interactive="{Binding Can.RetryDownloadRegistration}">Continue Files approval</Button>
              <Text IsVisible="{Binding EmptyDownloads}">No completed approved downloads.</Text>
            </Container>
            <Container id="BrowseSettingsPage" Type="Vertical Stack" CellGap="6" IsVisible="{Binding IsSettings}">
              <Text>Default engine for new web tabs</Text>
              <Button id="BrowseDefaultFirefoxButton" action="9to1.Browse.DefaultFirefox" Interactive="{Binding Can.DefaultFirefox}">Default Firefox</Button>
              <Button id="BrowseDefaultChromiumButton" action="9to1.Browse.DefaultChromium" Interactive="{Binding Can.DefaultChromium}">Default Chromium</Button>
              <Text TextWrapping="Wrap">Site and explicit tab engine choices take precedence. Native Browse pages do not use a web renderer.</Text>
            </Container>
          </Container>
        </Container>

        <Container id="BrowseToolsPanel" Type="Vertical Stack" Column="1" IsVisible="{Binding ToolsOpen}" Width="320" VerticalScrolling="True" HorizontalScrolling="False" Background="{Resource CuiPanelBrush}" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" Padding="12" CellGap="8" AccessibleName="Browser tools">
          <Container Type="Grid" ColumnSizes="1fr Auto">
            <Text Text="Browser tools" FontWeight="Bold" VerticalAlignment="Center" />
            <Button id="BrowseCloseToolsButton" action="9to1.Browse.CloseTools" Column="1" AccessibleName="Close browser tools" Interactive="{Binding Can.CloseTools}" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">×</Button>
          </Container>
          <Container Type="Wrap" CellGap="4">
            <Button id="BrowsePrivateTabButton" action="9to1.Browse.NewPrivateTab" Interactive="{Binding Can.NewPrivateTab}">Private tab</Button>
            <Button id="BrowseReopenTabButton" action="9to1.Browse.ReopenClosedTab" Interactive="{Binding Can.ReopenClosedTab}" AccessibleName="Reopen closed tab">Reopen tab</Button>
            <Button id="BrowseDiscardAddressButton" action="9to1.Browse.DiscardAddress" Interactive="{Binding Can.DiscardAddress}" AccessibleName="Discard address draft">Discard draft</Button>
          </Container>
          <Container Type="Wrap" CellGap="4">
            <Button id="BrowseOpenHistoryButton" action="9to1.Browse.OpenHistoryPage" Interactive="{Binding Can.OpenHistoryPage}">History</Button>
            <Button id="BrowseOpenBookmarksButton" action="9to1.Browse.OpenBookmarksPage" Interactive="{Binding Can.OpenBookmarksPage}">Bookmarks</Button>
            <Button id="BrowseOpenDownloadsButton" action="9to1.Browse.OpenDownloadsPage" Interactive="{Binding Can.OpenDownloadsPage}">Downloads</Button>
            <Button id="BrowseOpenSettingsButton" action="9to1.Browse.OpenSettingsPage" Interactive="{Binding Can.OpenSettingsPage}">Settings</Button>
          </Container>
          <Text Text="Find on page" FontWeight="Bold" />
          <Input Type="Text" id="BrowseFindBox" Interactive="{Binding CanEdit}" AccessibleName="Find on current page" Value="{Binding FindQuery, mode=TwoWay}" />
          <Container Type="Horizontal Stack" CellGap="4">
            <Button id="BrowseFindPreviousButton" action="9to1.Browse.FindPrevious" Interactive="{Binding Can.FindPrevious}">Previous</Button>
            <Button id="BrowseFindNextButton" action="9to1.Browse.FindNext" Interactive="{Binding Can.FindNext}">Next</Button>
          </Container>
          <Container Type="Horizontal Stack" CellGap="6">
            <Text Text="{Binding Zoom}" VerticalAlignment="Center" AccessibleName="Page zoom" />
            <Button id="BrowseZoomOutButton" action="9to1.Browse.ZoomOut" Interactive="{Binding Can.ZoomOut}" AccessibleName="Zoom out" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">−</Button>
            <Button id="BrowseZoomInButton" action="9to1.Browse.ZoomIn" Interactive="{Binding Can.ZoomIn}" AccessibleName="Zoom in" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">+</Button>
            <Button id="BrowseZoomResetButton" action="9to1.Browse.ZoomReset" Interactive="{Binding Can.ZoomReset}" AccessibleName="Reset zoom" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">Reset</Button>
          </Container>
          <Text Text="Tab engine" FontWeight="Bold" />
          <Container Type="Wrap" CellGap="4">
            <Button id="BrowseFirefoxTabButton" action="9to1.Browse.FirefoxTab" Interactive="{Binding Can.FirefoxTab}" AccessibleName="Use Firefox for this tab">Firefox</Button>
            <Button id="BrowseChromiumTabButton" action="9to1.Browse.ChromiumTab" Interactive="{Binding Can.ChromiumTab}" AccessibleName="Use Chromium for this tab">Chromium</Button>
            <Button id="BrowseResetTabEngineButton" action="9to1.Browse.ResetTabEngine" Interactive="{Binding Can.ResetTabEngine}" AccessibleName="Use site or default engine">Automatic engine</Button>
            <Button id="BrowseRecoverButton" action="9to1.Browse.Recover" Interactive="{Binding Can.Recover}" AccessibleName="Recover this tab">Recover</Button>
          </Container>
          <Text Text="Site preferences" FontWeight="Bold" />
          <Container Type="Wrap" CellGap="4">
            <Button id="BrowseFirefoxSiteButton" action="9to1.Browse.FirefoxSite" Interactive="{Binding Can.FirefoxSite}" AccessibleName="Prefer Firefox for this site">Site: Firefox</Button>
            <Button id="BrowseChromiumSiteButton" action="9to1.Browse.ChromiumSite" Interactive="{Binding Can.ChromiumSite}" AccessibleName="Prefer Chromium for this site">Site: Chromium</Button>
            <Button id="BrowseAllowPopupsButton" action="9to1.Browse.AllowPopups" Interactive="{Binding Can.AllowPopups}">Allow site popups</Button>
            <Button id="BrowseDenyPopupsButton" action="9to1.Browse.DenyPopups" Interactive="{Binding Can.DenyPopups}">Block site popups</Button>
            <Button id="BrowseDevToolsButton" action="9to1.Browse.DevTools" Interactive="{Binding Can.DevTools}">Developer tools</Button>
            <Button id="BrowseResetSiteEngineButton" action="9to1.Browse.ResetSiteEngine" Interactive="{Binding Can.ResetSiteEngine}">Reset site engine preference</Button>
          </Container>
          <Text Text="{Binding Security}" TextWrapping="Wrap" />
          <Text Text="{Binding Profile}" TextWrapping="Wrap" />
          <Text Text="{Binding EngineStatus}" TextWrapping="Wrap" />
          <Text Text="{Binding PopupStatus}" TextWrapping="Wrap" />
        </Container>
      </Container>
      <Text Row="3" Text="{Binding Status}" FontSize="12" AccessibleName="Browse operation status" />
    </Container>
  </Page>
</Cui>
