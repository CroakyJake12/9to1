<Cui id="9to1.Browse.Workspace" version="1">
  <Actions>
    <Action name="SelectTab" command="9to1.Browse.SelectTab" parameter="{Binding tab.Target}" />
    <Action name="CloseTabRow" command="9to1.Browse.CloseTabRow" parameter="{Binding tab.Target}" />
    <Action name="ToggleTabPinned" command="9to1.Browse.ToggleTabPinned" parameter="{Binding SelectedTabTarget}" />
    <Action name="MoveTabLeft" command="9to1.Browse.MoveTabLeft" parameter="{Binding SelectedTabTarget}" />
    <Action name="MoveTabRight" command="9to1.Browse.MoveTabRight" parameter="{Binding SelectedTabTarget}" />
    <Action name="JoinTabGroup" command="9to1.Browse.JoinSelectedTabToGroup" parameter="{Binding group.Target}" />
    <Action name="RenameTabGroup" command="9to1.Browse.RenameTabGroup" parameter="{Binding group.Target}" />
    <Action name="ToggleTabGroupCollapsed" command="9to1.Browse.ToggleTabGroupCollapsed" parameter="{Binding group.Target}" />
    <Action name="DissolveTabGroup" command="9to1.Browse.DissolveTabGroup" parameter="{Binding group.Target}" />
    <Action name="OpenBookmark" command="9to1.Browse.OpenBookmark" parameter="{Binding bookmark.Target}" />
    <Action name="RemoveBookmark" command="9to1.Browse.RemoveBookmark" parameter="{Binding bookmark.Target}" />
    <Action name="OpenHistory" command="9to1.Browse.OpenHistory" parameter="{Binding visit.Target}" />
    <Action name="RemoveHistoryEntry" command="9to1.Browse.RemoveHistoryEntry" parameter="{Binding visit.Target}" />
    <Action name="ApprovePendingDownload" command="9to1.Browse.ApprovePendingDownload" parameter="{Binding pending.Target}" />
    <Action name="RejectPendingDownload" command="9to1.Browse.RejectPendingDownload" parameter="{Binding pending.Target}" />
    <Action name="ShowDownloadInFiles" command="9to1.Browse.ShowDownloadInFiles" parameter="{Binding download.Target}" />
    <Action name="RegisterDownloadDestination" command="9to1.Browse.RegisterDownloadDestination" parameter="{Binding folder.Target}" />
  </Actions>
  <Page id="BrowseRoot" AccessibleName="9to1 Haven browser">
    <Container id="BrowseLayout" Type="Grid" RowSizes="Auto Auto 1fr Auto" ColumnSizes="1fr" CellGap="0" Background="{Resource CuiBackgroundBrush}">
      <Container id="BrowseTabStrip" Type="Grid" Column="0" ColumnSizes="1fr Auto" Padding="8 4 8 2" Background="{Resource CuiPanelBrush}" AccessibleName="Open tabs" AccessibleDescription="Drag a tab to swap at either outer edge, split on either inner edge, or group in the center. Invalid privacy, profile, or pinned boundaries are refused. Keyboard move controls are also available in More tools.">
        <Container Type="Overlay" HorizontalScrolling="True" VerticalScrolling="False">
          <Repeat Source="{Binding Tabs}" As="tab" Key="{Binding tab.Key}" Panel="Horizontal Stack">
            <Container Type="Grid" ColumnSizes="1fr Auto" Width="200" MinWidth="100" MaxWidth="240" Margin="0 0 4 0" CornerRadius="8" Background="{Binding tab.Background}" Class="cui-hover-surface">
              <Button id="BrowseTabButton" HorizontalContentAlignment="Left" action="SelectTab" Text="{Binding tab.Label}" AccessibleName="{Binding tab.Label}" AccessibleDescription="{Binding tab.Description}" Tooltip="{Binding tab.Description}" Interactive="{Binding Can.SelectTab}" Height="32" MinHeight="32" Padding="12 4" FontSize="13" Chromeless="True" Background="Transparent" Color="{Binding tab.Foreground}" BorderWidth="0" CornerRadius="8" />
              <Button id="BrowseCloseTabRowButton" action="CloseTabRow" Column="1" IsVisible="{Binding tab.CanClose}" Interactive="{Binding Can.CloseTabRow}" AccessibleName="{Binding tab.CloseLabel}" Tooltip="Close tab" Height="32" MinHeight="32" Width="30" MinWidth="30" Padding="4 4 6 4" FontSize="16" Chromeless="True" Background="Transparent" Color="{Binding tab.CloseForeground}" BorderWidth="0" CornerRadius="8">×</Button>
              <Container Type="Overlay" ColumnSpan="2" IsHitTestVisible="False">
                <Container id="BrowseTabDropSwapIndicator" IsVisible="{Binding tab.DropSwap}" Background="{Binding tab.DropBrush}" CornerRadius="8" />
                <Container id="BrowseTabDropSplitBeforeIndicator" Type="Grid" ColumnSizes="1fr 1fr" IsVisible="{Binding tab.DropSplitBefore}">
                  <Container id="BrowseTabDropSplitBeforeHalf" Column="0" Background="{Binding tab.DropBrush}" CornerRadius="8 0 0 8" />
                </Container>
                <Container id="BrowseTabDropSplitAfterIndicator" Type="Grid" ColumnSizes="1fr 1fr" IsVisible="{Binding tab.DropSplitAfter}">
                  <Container id="BrowseTabDropSplitAfterHalf" Column="1" Background="{Binding tab.DropBrush}" CornerRadius="0 8 8 0" />
                </Container>
                <Container id="BrowseTabDropGroupIndicator" IsVisible="{Binding tab.DropGroup}" Background="{Binding tab.DropBrush}" CornerRadius="8" />
              </Container>
            </Container>
          </Repeat>
        </Container>
          <Button id="BrowseNewTabButton" Column="1" action="9to1.Browse.NewTab" Interactive="{Binding Can.NewTab}" AccessibleName="New tab" Tooltip="New tab (Ctrl+T)" Height="32" MinHeight="32" Width="32" MinWidth="32" Padding="4" FontSize="18" Background="Transparent" Color="{Resource CuiTextBrush}" BorderWidth="0" CornerRadius="8">+</Button>
      </Container>
      <Container id="BrowseNavigationBar" Type="Grid" Row="1" Column="0" ColumnSizes="Auto Auto Auto 1fr Auto Auto Auto" CellGap="2" Padding="4 4 4 6" Background="{Resource CuiPanelBrush}">
        <Button id="BrowseBackButton" action="9to1.Browse.Back" AccessibleName="Go back" Tooltip="Go back (Alt+Left)" Interactive="{Binding CanBack}" Height="32" MinHeight="32" Width="28" MinWidth="28" Padding="4" FontSize="17" Background="Transparent" Color="{Resource CuiTextBrush}" BorderWidth="0" CornerRadius="8">←</Button>
        <Button id="BrowseForwardButton" action="9to1.Browse.Forward" Column="1" AccessibleName="Go forward" Tooltip="Go forward (Alt+Right)" Interactive="{Binding CanForward}" Height="32" MinHeight="32" Width="28" MinWidth="28" Padding="4" FontSize="17" Background="Transparent" Color="{Resource CuiTextBrush}" BorderWidth="0" CornerRadius="8">→</Button>
        <Container Type="Overlay" Column="2">
          <Button id="BrowseReloadButton" action="9to1.Browse.Reload" IsVisible="{Binding IsNotLoading}" AccessibleName="Reload page" Tooltip="Reload page" Interactive="{Binding Can.Reload}" Height="32" MinHeight="32" Width="28" MinWidth="28" Padding="4" FontSize="17" Background="Transparent" Color="{Resource CuiTextBrush}" BorderWidth="0" CornerRadius="8">↻</Button>
          <Button id="BrowseStopButton" action="9to1.Browse.Stop" IsVisible="{Binding IsLoading}" AccessibleName="Stop loading" Tooltip="Stop loading" Interactive="{Binding Can.Stop}" Height="32" MinHeight="32" Width="28" MinWidth="28" Padding="4" FontSize="17" Background="Transparent" Color="{Resource CuiTextBrush}" BorderWidth="0" CornerRadius="8">×</Button>
        </Container>
        <Container Type="Grid" Column="3" ColumnSizes="1fr Auto" Background="{Resource CuiInputSurfaceBrush}" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="16">
          <Input Type="Text" id="BrowseAddressBox" Interactive="{Binding CanEdit}" AccessibleName="Search or enter web address" Value="{Binding Address, mode=TwoWay}" DisplayValue="{Binding AddressDisplay}" Height="32" MinHeight="32" MinWidth="64" Padding="12 4" FontSize="13" VerticalContentAlignment="Center" Background="Transparent" BorderWidth="0" CornerRadius="16" />
          <Button id="BrowseNavigateButton" action="9to1.Browse.Navigate" Column="1" AccessibleName="Go to address" Tooltip="Go to address" Interactive="{Binding Can.Navigate}" Height="32" MinHeight="32" Width="28" MinWidth="28" Padding="4" FontSize="16" Background="Transparent" Color="{Resource CuiTextBrush}" BorderWidth="0" CornerRadius="16">→</Button>
        </Container>
        <Container id="HavenSharedCluster" Type="Horizontal Stack" Column="4" CellGap="4" VerticalAlignment="Center" IsVisible="{Binding Haven.Embedded}" AccessibleName="Haven model and notifications">
          <Button id="HavenModelButton" action="9to1.Haven.OpenModel" accessible-name="{Binding Haven.ModelAccessibleName}" Tooltip="{Binding Haven.ModelTooltip}" Interactive="{Binding Haven.ModelAvailable}" Height="32" MinHeight="32" MinWidth="32" Padding="4 8" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
            <Container Type="Horizontal Stack" CellGap="4" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Image Source="avares://Haven/Assets/haven-model.svg" Width="18" Height="18" />
              <Text Text="{Binding Haven.EffortPercent}" FontSize="12" IsVisible="{Binding Haven.EffortKnown}" VerticalAlignment="Center" />
            </Container>
          </Button>
          <Button id="HavenNotificationsButton" action="9to1.Haven.OpenNotifications" accessible-name="Notifications" Tooltip="Open notifications" Interactive="{Binding Haven.NotificationsAvailable}" Height="32" MinHeight="32" Width="32" MinWidth="32" Padding="4" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
            <Image Source="avares://Haven/Assets/haven-notifications.svg" Width="18" Height="18" />
          </Button>
        </Container>
        <Button id="BrowseBookmarkButton" action="9to1.Browse.Bookmark" Column="5" AccessibleName="{Binding BookmarkLabel}" Tooltip="{Binding BookmarkLabel}" Text="{Binding BookmarkGlyph}" Selected="{Binding IsBookmarked}" Interactive="{Binding Can.Bookmark}" Height="32" MinHeight="32" Width="28" MinWidth="28" Padding="4" FontSize="18" Background="Transparent" Color="{Resource CuiTextBrush}" BorderWidth="0" CornerRadius="8" />
        <Button id="HavenProfileButton" action="9to1.Browse.ToggleProfileMenu" Column="6" AccessibleName="Account, profile and browser tools" Tooltip="Open the profile menu" Selected="{Binding ProfileMenuOpen}" Height="32" MinHeight="32" Width="32" MinWidth="32" Padding="4" HorizontalAlignment="Center" Background="{Resource CuiTransparentBrush}" BorderWidth="0" CornerRadius="8">
          <Image Source="avares://Haven/Assets/haven-profile.svg" Width="18" Height="18" />
        </Button>
      </Container>
      <Container id="BrowseContentViewport" Type="Grid" Row="2" Column="0" ColumnSizes="1fr" RowSizes="1fr" MinHeight="180">
        <Object Type="browse.engine" id="BrowseEngineView" MinHeight="180" AccessibleName="Original native browser engine surface" />
        <Container id="BrowseNativePagePanel" Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False" IsVisible="{Binding IsNativePage}">
          <Container Type="Vertical Stack" CellGap="8" Margin="12">
            <Text Text="{Binding NativeTitle}" AccessibleName="Native Browse page title" />
            <Container id="BrowseBookmarksPage" Type="Vertical Stack" CellGap="6" IsVisible="{Binding IsBookmarks}">
              <Repeat Source="{Binding Bookmarks}" As="bookmark" Key="{Binding bookmark.Key}">
                <Container Type="Vertical Stack">
                  <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="6">
                    <Button id="BrowseBookmarkRowButton" Column="0" HorizontalContentAlignment="Left" action="OpenBookmark" Text="{Binding bookmark.Label}" AccessibleName="{Binding bookmark.Label}" Interactive="{Binding Can.OpenBookmark}" />
                    <Button id="BrowseRemoveBookmarkButton" Column="1" action="RemoveBookmark" AccessibleName="{Binding bookmark.RemoveLabel}" Tooltip="{Binding bookmark.RemoveLabel}" Interactive="{Binding Can.RemoveBookmark}" MinHeight="32" Padding="8 4">Remove</Button>
                  </Container>
                  <Text Text="{Binding bookmark.Detail}" TextWrapping="Wrap" />
                </Container>
              </Repeat>
              <Text IsVisible="{Binding EmptyBookmarks}">No saved bookmarks.</Text>
            </Container>
            <Container id="BrowseHistoryPage" Type="Vertical Stack" CellGap="6" IsVisible="{Binding IsHistory}">
              <Text Text="Search history by title or address" FontWeight="Bold" />
              <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="6">
                <Input Type="Text" id="BrowseHistorySearchBox" Column="0" Value="{Binding HistoryQuery, Mode=TwoWay}" Interactive="{Binding CanEdit}" AccessibleName="Search browsing history by title or address" />
                <Button id="BrowseResetHistoryQueryButton" Column="1" action="9to1.Browse.ResetHistoryQuery" Interactive="{Binding Can.ResetHistoryQuery}">Clear search</Button>
              </Container>
              <Text id="BrowseHistoryResultSummary" Text="{Binding HistoryResultSummary}" FontSize="12" Color="{Resource CuiTextSoftBrush}" />
              <Repeat Source="{Binding History}" As="visit" Key="{Binding visit.Key}">
                <Container Type="Vertical Stack">
                  <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="6">
                    <Button id="BrowseHistoryRowButton" Column="0" HorizontalContentAlignment="Left" action="OpenHistory" Text="{Binding visit.Label}" AccessibleName="{Binding visit.Label}" Interactive="{Binding Can.OpenHistory}" />
                    <Button id="BrowseRemoveHistoryEntryButton" Column="1" action="RemoveHistoryEntry" AccessibleName="{Binding visit.RemoveLabel}" Tooltip="{Binding visit.RemoveLabel}" Interactive="{Binding Can.RemoveHistoryEntry}" MinHeight="32" Padding="8 4">Remove visit</Button>
                  </Container>
                  <Text Text="{Binding visit.Detail}" TextWrapping="Wrap" />
                </Container>
              </Repeat>
              <Text IsVisible="{Binding EmptyHistory}">No recorded web visits.</Text>
              <Text IsVisible="{Binding EmptyHistoryResults}">No visits match this search.</Text>
              <Text FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap">Removing a visit keeps other visits, bookmarks and open tabs. Clearing all history also removes visits outside this search.</Text>
              <Button id="BrowseClearHistoryButton" action="9to1.Browse.ClearHistory" Interactive="{Binding Can.ClearHistory}">Clear all local history</Button>
            </Container>
            <Container id="BrowseDownloadsPage" Type="Vertical Stack" CellGap="6" IsVisible="{Binding IsDownloads}">
              <Button id="BrowseDownloadsButton" action="9to1.Browse.Downloads" Interactive="{Binding Can.Downloads}">Refresh downloads</Button>
              <Text Text="{Binding DownloadStatus}" TextWrapping="Wrap" />
              <Text Text="{Binding DownloadReviewStatus}" TextWrapping="Wrap" />
              <Text FontWeight="Bold" Margin="0 8 0 0">Waiting for approval</Text>
              <Text Text="{Binding PendingDownloadSummary}" TextWrapping="Wrap" />
              <Repeat Source="{Binding PendingDownloads}" As="pending" Key="{Binding pending.Key}">
                <Container id="BrowsePendingDownloadCard" Type="Vertical Stack" CellGap="6" Padding="12" CornerRadius="16" Background="{Resource CuiInputSurfaceBrush}" BorderColor="{Resource CuiLineBrush}" BorderWidth="1">
                  <Text Text="{Binding pending.Label}" FontWeight="Bold" TextWrapping="Wrap" />
                  <Text Text="{Binding pending.Origin}" TextWrapping="Wrap" />
                  <Text Text="{Binding pending.Summary}" TextWrapping="Wrap" />
                  <Text Text="{Binding pending.Context}" FontSize="12" Color="{Resource CuiTextSoftBrush}" />
                  <Text Text="{Binding pending.Expiry}" FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                  <Container Type="Horizontal Stack" CellGap="8">
                    <Button id="BrowseApprovePendingDownloadButton" action="ApprovePendingDownload" Interactive="{Binding pending.CanApprove}" AccessibleName="{Binding pending.ApproveLabel}" MinHeight="36" Padding="12 6" CornerRadius="18">Approve download</Button>
                    <Button id="BrowseRejectPendingDownloadButton" action="RejectPendingDownload" Interactive="{Binding pending.CanReject}" AccessibleName="{Binding pending.RejectLabel}" MinHeight="36" Padding="12 6" CornerRadius="18">Reject</Button>
                  </Container>
                </Container>
              </Repeat>
              <Text FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap">Approval starts this download. Keeping the completed file in Files uses its separate permissions.</Text>
              <Text FontWeight="Bold" Margin="0 10 0 0">Completed downloads</Text>
              <Text Text="{Binding DownloadOpenStatus}" TextWrapping="Wrap" />
              <Repeat Source="{Binding Downloads}" As="download" Key="{Binding download.Key}">
                <Container Type="Vertical Stack">
                  <Text Text="{Binding download.Label}" />
                  <Text Text="{Binding download.Detail}" TextWrapping="Wrap" />
                  <Button id="BrowseDownloadFilesButton" action="ShowDownloadInFiles" Interactive="{Binding Can.ShowDownloadInFiles}">Show in Files</Button>
                </Container>
              </Repeat>
              <Text Text="{Binding DownloadDestinationPrompt}" TextWrapping="Wrap" />
              <Repeat Source="{Binding DownloadDestinations}" As="folder" Key="{Binding folder.Key}">
                <Button id="BrowseDownloadDestinationButton" HorizontalContentAlignment="Left" action="RegisterDownloadDestination" Text="{Binding folder.Label}" Interactive="{Binding Can.RegisterDownloadDestination}" />
              </Repeat>
              <Button id="BrowseRetryDownloadRegistrationButton" action="9to1.Browse.RetryDownloadRegistration" Interactive="{Binding Can.RetryDownloadRegistration}">Continue Files approval</Button>
              <Text IsVisible="{Binding EmptyDownloads}">No completed approved downloads.</Text>
            </Container>
            <Container id="BrowseSettingsPage" Type="Vertical Stack" CellGap="6" IsVisible="{Binding IsSettings}">
              <Text>Default engine for new web tabs</Text>
              <Button id="BrowseDefaultFirefoxButton" action="9to1.Browse.DefaultFirefox" Interactive="{Binding Can.DefaultFirefox}">Default Firefox</Button>
              <Button id="BrowseDefaultChromiumButton" action="9to1.Browse.DefaultChromium" Interactive="{Binding Can.DefaultChromium}">Default Chromium</Button>
              <Text TextWrapping="Wrap">Site and explicit tab engine choices take precedence. Native Browse pages do not use a web renderer.</Text>
              <Text FontWeight="Bold" Margin="0 10 0 0">Privacy</Text>
              <Container Type="Horizontal Stack" CellGap="8">
                <Text Text="Record browsing history" VerticalAlignment="Center" />
                <Input Type="Switch" id="BrowseRecordHistorySwitch" Checked="{Binding RecordHistory, Mode=TwoWay}" Interactive="{Binding Can.EnableHistory}" AccessibleName="Record browsing history" />
              </Container>
              <Text FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap">Turning this off keeps existing history. Private tabs never record browsing history.</Text>
              <Text FontWeight="Bold" Margin="0 10 0 0">Startup</Text>
              <Container Type="Horizontal Stack" CellGap="8">
                <Text Text="Restore tabs on startup" VerticalAlignment="Center" />
                <Input Type="Switch" id="BrowseRestoreTabsSwitch" Checked="{Binding RestoreTabs, Mode=TwoWay}" Interactive="{Binding Can.EnableTabRestore}" AccessibleName="Restore tabs on startup" />
              </Container>
              <Text FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap">Applies the next time Haven starts. Your current tabs stay open.</Text>
              <Text id="BrowseUnassignedLegacyProfileData" IsVisible="{Binding HasUnassignedLegacyProfileData}" Text="{Binding LegacyProfileDataStatus}" TextWrapping="Wrap" />
            </Container>
          </Container>
        </Container>
        <Container id="BrowseInlineChromiumFallbackPanel" Type="Overlay" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12 24 12 8" IsVisible="{Binding ShowChromiumFallback}">
          <Container id="BrowseInlineChromiumFallbackCard" Type="Vertical Stack" CellGap="6" Padding="12" Width="420" Background="{Resource CuiPanelBrush}" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="10" AccessibleName="Gecko unavailable, Chromium available">
            <Text Text="{Binding ChromiumFallbackStatus}" FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            <Text FontSize="13" Color="{Resource CuiTextBrush}">The Firefox/Gecko engine is not available for this tab on this device. You can open this same tab with the Chromium engine.</Text>
            <Button id="BrowseInlineChromiumTabButton" action="9to1.Browse.ChromiumTab" HorizontalContentAlignment="Center" Interactive="{Binding Can.ChromiumTab}">Use Chromium for this tab</Button>
          </Container>
        </Container>
      </Container>
      <Text Row="3" Column="0" Text="{Binding Status}" FontSize="11" AccessibleName="Browse operation status" />
    </Container>

    <Container id="BrowseProfileOverlay" Type="Overlay" IsVisible="{Binding ProfileMenuOpen}" AccessibleName="Profile menu" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 84 8 0">
      <Container id="BrowseProfileMenu" Type="Vertical Stack" Width="340" MaxHeight="560" CellGap="2" Padding="8" Background="{Resource CuiPanelBrush}" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="12" VerticalScrolling="True" HorizontalScrolling="False" AccessibleName="Account and profile">
        <Button id="BrowseProfileAccountButton" action="9to1.Haven.OpenProfile" Interactive="{Binding Haven.ProfileAvailable}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="8" CornerRadius="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0">
          <Container Type="Horizontal Stack" CellGap="10">
            <Image Source="avares://Haven/Assets/haven-profile.svg" Width="34" Height="34" />
            <Container Type="Vertical Stack" CellGap="2">
              <Text Text="{Binding ProfilePrincipalLabel}" FontWeight="Bold" FontSize="15" />
              <Text Text="{Binding ProfileAccountHint}" FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            </Container>
          </Container>
        </Button>
        <Container Type="Grid" Height="1" Margin="8 2 8 2" Background="{Resource CuiLineBrush}" />

        <Button id="BrowseSwitchUsersButton" action="9to1.Browse.OpenManageUsers" Interactive="{Binding Can.OpenManageUsers}" HorizontalContentAlignment="Left" Padding="10 8" CornerRadius="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0">Switch &amp; Manage Users</Button>

        <Container Type="Vertical Stack" CellGap="6" IsVisible="{Binding ShowStorage}" Padding="8 2 8 10">
          <Text Text="Storage" FontWeight="Bold" />
          <Text Text="{Binding StorageUnitsLabel}" FontSize="12" TextWrapping="Wrap" />
          <Input Type="Progress" AccessibleName="Storage usage" Minimum="0" Maximum="{Binding StorageQuotaBytes}" Value="{Binding StorageUsedBytes}" WriteBack="false" Height="12" MinWidth="240" />
        </Container>

        <Container Type="Vertical Stack" CellGap="6" IsVisible="{Binding ShowUsage}" Padding="8 2 8 10">
          <Text Text="Usage Limits" FontWeight="Bold" />
          <Repeat Source="{Binding UsageWindowRows}" As="used" Key="{Binding used.Key}">
            <Container Type="Vertical Stack" CellGap="4">
              <Text Text="{Binding used.Label}" FontSize="12" TextWrapping="Wrap" />
              <Input Type="Progress" AccessibleName="{Binding used.Label}" Minimum="0" Maximum="{Binding used.LimitUnits}" Value="{Binding used.UsedUnits}" WriteBack="false" Height="12" MinWidth="240" />
            </Container>
          </Repeat>
        </Container>

        <Button id="BrowseAutomationsButton" action="9to1.Browse.OpenWebAutomations" Interactive="{Binding Can.OpenWebAutomations}" HorizontalContentAlignment="Left" Padding="10 8" CornerRadius="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0">Web Automations</Button>
        <Container Type="Vertical Stack" Padding="10 0 10 6" IsVisible="{Binding ShowAutomationNote}">
          <Text Text="{Binding AutomationNote}" FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
        </Container>

        <Container Type="Grid" Height="1" Margin="8 2 8 2" Background="{Resource CuiLineBrush}" />
        <Button id="BrowseWebToolsHeader" action="9to1.Browse.ToggleTools" Selected="{Binding ToolsOpen}" HorizontalContentAlignment="Left" Padding="10 8" CornerRadius="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0" FontWeight="Bold">
          <Container Type="Horizontal Stack" CellGap="8">
            <Text Text="Web Tools" VerticalAlignment="Center" />
            <Text Text="{Binding WebToolsChevron}" VerticalAlignment="Center" FontSize="12" Color="{Resource CuiTextSoftBrush}" />
          </Container>
        </Button>
        <Container id="BrowseWebToolsGroup" Type="Vertical Stack" CellGap="6" IsVisible="{Binding ToolsOpen}" Padding="4 2 4 8">
          <Text Text="Arrange selected tab" FontWeight="Bold" />
          <Container Type="Wrap" CellGap="4">
            <Container Type="Horizontal Stack" CellGap="8">
              <Text Text="Pin selected tab" VerticalAlignment="Center" />
              <Input Type="Switch" id="BrowsePinTabSwitch" Checked="{Binding TabPinned, Mode=TwoWay}" Interactive="{Binding Can.ToggleTabPinned}" AccessibleName="Pin selected tab" />
            </Container>
            <Button id="BrowseMoveTabLeftButton" action="MoveTabLeft" AccessibleName="Move selected tab left within its section" Interactive="{Binding Can.MoveTabLeft}">Move left</Button>
            <Button id="BrowseMoveTabRightButton" action="MoveTabRight" AccessibleName="Move selected tab right within its section" Interactive="{Binding Can.MoveTabRight}">Move right</Button>
          </Container>
          <Text FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap">Pinned tabs stay before other tabs. Unpin to show the close button, or use Close selected tab.</Text>
          <Text Text="Tab groups" FontWeight="Bold" />
          <Input Type="Text" id="BrowseTabGroupNameInput" Value="{Binding GroupName, Mode=TwoWay}" Interactive="{Binding CanManageTabGroups}" AccessibleName="Tab group name" />
          <Container Type="Wrap" CellGap="4">
            <Button id="BrowseCreateTabGroupButton" action="9to1.Browse.CreateTabGroup" Interactive="{Binding Can.CreateTabGroup}" AccessibleName="Create a group for the selected standard tab">Create group</Button>
            <Button id="BrowseUngroupSelectedTabButton" action="9to1.Browse.UngroupSelectedTab" Interactive="{Binding Can.UngroupSelectedTab}">Ungroup selected tab</Button>
          </Container>
          <Repeat Source="{Binding TabGroups}" As="group" Key="{Binding group.Key}">
            <Container Type="Vertical Stack" CellGap="4" Padding="8 6" CornerRadius="8" Background="{Resource CuiInputSurfaceBrush}">
              <Text Text="{Binding group.Name}" FontWeight="Bold" />
              <Text Text="{Binding group.Summary}" FontSize="12" Color="{Resource CuiTextSoftBrush}" />
              <Container Type="Wrap" CellGap="4">
                <Button id="BrowseJoinTabGroupButton" action="JoinTabGroup" Interactive="{Binding group.CanJoinSelected}">Move selected here</Button>
                <Button id="BrowseRenameTabGroupButton" action="RenameTabGroup" Interactive="{Binding Can.RenameTabGroup}">Rename</Button>
                <Button id="BrowseToggleTabGroupCollapsedButton" action="ToggleTabGroupCollapsed" Text="{Binding group.CollapseLabel}" Interactive="{Binding Can.ToggleTabGroupCollapsed}" />
                <Button id="BrowseDissolveTabGroupButton" action="DissolveTabGroup" Interactive="{Binding Can.DissolveTabGroup}">Dissolve</Button>
              </Container>
            </Container>
          </Repeat>
          <Text Text="Collapsed groups keep their selected tab available; expanding a group restores its other tabs to the strip." FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
          <Text Text="Split view" FontWeight="Bold" />
          <Container Type="Wrap" CellGap="4">
            <Button id="BrowseToggleSplitViewButton" action="9to1.Browse.ToggleSplitView" Interactive="{Binding Can.ToggleSplitView}" AccessibleName="{Binding ToggleSplitLabel}">Split view</Button>
            <Button id="BrowseFocusSplitPrimaryButton" action="9to1.Browse.FocusSplitPrimary" Text="{Binding SplitPrimaryLabel}" Interactive="{Binding Can.FocusSplitPrimary}" AccessibleName="{Binding SplitPrimaryLabel}" />
            <Button id="BrowseFocusSplitSecondaryButton" action="9to1.Browse.FocusSplitSecondary" Text="{Binding SplitSecondaryLabel}" Interactive="{Binding Can.FocusSplitSecondary}" AccessibleName="{Binding SplitSecondaryLabel}" />
            <Button id="BrowseSwapSplitPanesButton" action="9to1.Browse.SwapSplitPanes" Interactive="{Binding Can.SwapSplitPanes}">Swap panes</Button>
            <Button id="BrowseToggleSplitOrientationButton" action="9to1.Browse.ToggleSplitOrientation" Text="{Binding SplitOrientationLabel}" Interactive="{Binding Can.ToggleSplitOrientation}" AccessibleName="Change split orientation" />
            <Button id="BrowseNarrowPrimaryPaneButton" action="9to1.Browse.NarrowPrimaryPane" Interactive="{Binding Can.NarrowPrimaryPane}" AccessibleName="Narrow primary split pane">Narrow primary</Button>
            <Text Text="{Binding SplitRatioLabel}" />
            <Button id="BrowseWidenPrimaryPaneButton" action="9to1.Browse.WidenPrimaryPane" Interactive="{Binding Can.WidenPrimaryPane}" AccessibleName="Widen primary split pane">Widen primary</Button>
            <Button id="BrowseCloseSplitViewButton" action="9to1.Browse.CloseSplitView" Interactive="{Binding Can.CloseSplitView}">Close split</Button>
          </Container>
          <Text FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap">Keyboard: Alt+Shift+Left or Right resizes side-by-side panes; Alt+Shift+Up or Down resizes stacked panes. The orientation button is keyboard accessible.</Text>
          <Button id="BrowseRetrySplitLayoutButton" action="9to1.Browse.SaveSplitViewLayout" IsVisible="{Binding HasUnsavedSplitViewLayout}" Interactive="{Binding Can.SaveSplitViewLayout}">Retry saving split layout</Button>
          <Button id="BrowseRetryTabPlacementButton" action="9to1.Browse.SaveTabPlacement" IsVisible="{Binding HasUnsavedTabPlacement}" Interactive="{Binding Can.SaveTabPlacement}">Retry saving tab layout</Button>
          <Container Type="Wrap" CellGap="4">
            <Button id="BrowsePrivateTabButton" action="9to1.Browse.NewPrivateTab" Interactive="{Binding Can.NewPrivateTab}">Private tab</Button>
            <Button id="BrowseCloseTabButton" action="9to1.Browse.CloseTab" Interactive="{Binding Can.CloseTab}" AccessibleName="Close selected tab">Close selected tab</Button>
            <Button id="BrowseReopenTabButton" action="9to1.Browse.ReopenClosedTab" Interactive="{Binding Can.ReopenClosedTab}" AccessibleName="Reopen closed tab">Reopen tab</Button>
            <Button id="BrowseDiscardAddressButton" action="9to1.Browse.DiscardAddress" Interactive="{Binding Can.DiscardAddress}" AccessibleName="Discard address draft">Discard draft</Button>
          </Container>
          <Container Type="Wrap" CellGap="4">
            <Button id="BrowseOpenHistoryButton" action="9to1.Browse.OpenHistoryPage" Interactive="{Binding Can.OpenHistoryPage}">History</Button>
            <Button id="BrowseOpenBookmarksButton" action="9to1.Browse.OpenBookmarksPage" Interactive="{Binding Can.OpenBookmarksPage}">Bookmarks</Button>
            <Button id="BrowseOpenDownloadsButton" action="9to1.Browse.OpenDownloadsPage" Interactive="{Binding Can.OpenDownloadsPage}">Downloads</Button>
          </Container>
          <Text Text="Find on page" FontWeight="Bold" />
          <Input Type="Text" id="BrowseFindBox" Interactive="{Binding CanEdit}" AccessibleName="Find on current page" Value="{Binding FindQuery, mode=TwoWay}" />
          <Container Type="Horizontal Stack" CellGap="4">
            <Button id="BrowseFindPreviousButton" action="9to1.Browse.FindPrevious" Interactive="{Binding Can.FindPrevious}">Previous</Button>
            <Button id="BrowseFindNextButton" action="9to1.Browse.FindNext" Interactive="{Binding Can.FindNext}">Next</Button>
          </Container>
          <Container Type="Horizontal Stack" CellGap="6">
            <Text Text="{Binding Zoom}" VerticalAlignment="Center" AccessibleName="Page zoom" />
            <Button id="BrowseZoomOutButton" action="9to1.Browse.ZoomOut" Interactive="{Binding Can.ZoomOut}" AccessibleName="Zoom out" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">−</Button>
            <Button id="BrowseZoomInButton" action="9to1.Browse.ZoomIn" Interactive="{Binding Can.ZoomIn}" AccessibleName="Zoom in" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">+</Button>
            <Button id="BrowseZoomResetButton" action="9to1.Browse.ZoomReset" Interactive="{Binding Can.ZoomReset}" AccessibleName="Reset zoom" Height="32" MinHeight="32" MinWidth="32" Padding="6 2" FontSize="14">Reset</Button>
          </Container>
          <Text Text="Tab engine" FontWeight="Bold" />
          <Container Type="Wrap" CellGap="4">
            <Button id="BrowseFirefoxTabButton" action="9to1.Browse.FirefoxTab" Interactive="{Binding Can.FirefoxTab}" AccessibleName="Use Firefox for this tab">Firefox</Button>
            <Button id="BrowseChromiumTabButton" action="9to1.Browse.ChromiumTab" Interactive="{Binding Can.ChromiumTab}" AccessibleName="Use Chromium for this tab">Chromium</Button>
            <Button id="BrowseResetTabEngineButton" action="9to1.Browse.ResetTabEngine" Interactive="{Binding Can.ResetTabEngine}" AccessibleName="Use site or default engine">Automatic engine</Button>
            <Button id="BrowseRecoverButton" action="9to1.Browse.Recover" Interactive="{Binding Can.Recover}" AccessibleName="Recover this tab">Recover</Button>
          </Container>
          <Text Text="Site preferences" FontWeight="Bold" />
          <Container Type="Wrap" CellGap="4">
            <Button id="BrowseFirefoxSiteButton" action="9to1.Browse.FirefoxSite" Interactive="{Binding Can.FirefoxSite}" AccessibleName="Prefer Firefox for this site">Site: Firefox</Button>
            <Button id="BrowseChromiumSiteButton" action="9to1.Browse.ChromiumSite" Interactive="{Binding Can.ChromiumSite}" AccessibleName="Prefer Chromium for this site">Site: Chromium</Button>
            <Container Type="Horizontal Stack" CellGap="8">
              <Text Text="Allow site pop-ups" VerticalAlignment="Center" />
              <Input Type="Switch" id="BrowseAllowPopupsSwitch" Checked="{Binding AllowPopups, Mode=TwoWay}" Interactive="{Binding Can.AllowPopups}" AccessibleName="Allow pop-ups for this site" />
            </Container>
            <Button id="BrowseDevToolsButton" action="9to1.Browse.DevTools" Interactive="{Binding Can.DevTools}">Developer tools</Button>
            <Button id="BrowseResetSiteEngineButton" action="9to1.Browse.ResetSiteEngine" Interactive="{Binding Can.ResetSiteEngine}">Reset site engine preference</Button>
          </Container>
          <Text Text="{Binding Security}" TextWrapping="Wrap" />
          <Text Text="{Binding Profile}" TextWrapping="Wrap" />
          <Text Text="{Binding EngineStatus}" TextWrapping="Wrap" />
          <Text Text="{Binding PopupStatus}" TextWrapping="Wrap" />
        </Container>

        <Button id="BrowseSettingsButton" action="9to1.Browse.OpenSettingsPage" Interactive="{Binding Can.OpenSettingsPage}" HorizontalContentAlignment="Left" Padding="10 8" CornerRadius="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0">Browse Settings</Button>

        <Button id="BrowseCloseProfileMenuButton" action="9to1.Browse.CloseProfileMenu" HorizontalContentAlignment="Left" Padding="10 8" CornerRadius="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0">Close menu</Button>
      </Container>
    </Container>

    <Container id="BrowseManageUsersOverlay" Type="Overlay" IsVisible="{Binding ManageUsersOpen}" AccessibleName="Switch and manage users" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 48 12 0">
      <Container Type="Vertical Stack" Width="300" CellGap="8" Padding="10" Background="{Resource CuiPanelBrush}" BorderColor="{Resource CuiLineBrush}" BorderWidth="1" CornerRadius="12" AccessibleName="Current user and account settings">
        <Text Text="Switch &amp; Manage Users" FontWeight="Bold" FontSize="15" />
        <Container Type="Horizontal Stack" CellGap="10">
          <Image Source="avares://Haven/Assets/haven-profile.svg" Width="34" Height="34" />
          <Container Type="Vertical Stack" CellGap="2">
            <Text Text="{Binding ProfilePrincipalLabel}" FontWeight="Bold" />
            <Text Text="{Binding ProfileAccountHint}" FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
          </Container>
        </Container>
        <Text Text="{Binding ManageUsersOtherProfilesStatus}" FontSize="12" Color="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" IsVisible="{Binding ShowManageUsersOtherProfilesStatus}" />
        <Button id="BrowseManageUsersAccountButton" action="9to1.Haven.OpenProfile" Interactive="{Binding Haven.ProfileAvailable}" HorizontalContentAlignment="Stretch" Padding="10 8" CornerRadius="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0">Open account settings</Button>
        <Button id="BrowseCloseManageUsersButton" action="9to1.Browse.CloseManageUsers" HorizontalContentAlignment="Stretch" Padding="10 8" CornerRadius="8" Background="{Resource CuiTransparentBrush}" BorderWidth="0">Close</Button>
      </Container>
    </Container>
  </Page>
</Cui>
