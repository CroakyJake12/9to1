<Cui id="9to1.Browse.Workspace" version="1">
  <Actions>
    <Action name="SelectTab" command="9to1.Browse.SelectTab" parameter="{Binding tab.Target}" />
    <Action name="OpenBookmark" command="9to1.Browse.OpenBookmark" parameter="{Binding bookmark.Target}" />
    <Action name="OpenHistory" command="9to1.Browse.OpenHistory" parameter="{Binding visit.Target}" />
    <Action name="ShowDownloadInFiles" command="9to1.Browse.ShowDownloadInFiles" parameter="{Binding download.Target}" />
    <Action name="RegisterDownloadDestination" command="9to1.Browse.RegisterDownloadDestination" parameter="{Binding folder.Target}" />
  </Actions>
  <Page id="BrowseRoot" AccessibleName="Browse browser">
    <Container Type="Grid" Margin="8" RowSizes="Auto Auto Auto 1fr Auto" ColumnSizes="1fr" CellGap="6">
      <Container Type="Vertical Stack" CellGap="4">
        <Container Type="Overlay" HorizontalScrolling="True" VerticalScrolling="False">
          <Container Type="Horizontal Stack" CellGap="4">
            <Repeat Source="{Binding Tabs}" As="tab" Key="{Binding tab.Key}">
              <Button action="SelectTab" Text="{Binding tab.Label}" AccessibleName="{Binding tab.Label}" />
            </Repeat>
          </Container>
        </Container>
        <Container Type="Grid" ColumnSizes="1fr 1fr 1fr">
          <Button id="BrowseNewTabButton" action="9to1.Browse.NewTab">New tab</Button>
          <Button id="BrowsePrivateTabButton" action="9to1.Browse.NewPrivateTab" Column="1">Private tab</Button>
          <Button id="BrowseCloseTabButton" action="9to1.Browse.CloseTab" Column="2">Close tab</Button>
        </Container>
      </Container>
      <Container Type="Vertical Stack" Row="1" CellGap="4">
        <Container Type="Grid" ColumnSizes="Auto Auto Auto Auto 1fr">
          <Button id="BrowseBackButton" action="9to1.Browse.Back" AccessibleName="Go back" Interactive="{Binding CanBack}">←</Button>
          <Button id="BrowseForwardButton" action="9to1.Browse.Forward" AccessibleName="Go forward" Interactive="{Binding CanForward}" Column="1">→</Button>
          <Button id="BrowseReloadButton" action="9to1.Browse.Reload" Column="2">Reload</Button>
          <Button id="BrowseStopButton" action="9to1.Browse.Stop" Column="3">Stop</Button>
          <Input Type="Text" id="BrowseAddressBox" AccessibleName="Search or enter web address" Column="4" Value="{Binding Address, mode=TwoWay}" />
        </Container>
        <Container Type="Grid" ColumnSizes="1fr 1fr 1fr">
          <Button id="BrowseNavigateButton" action="9to1.Browse.Navigate">Go</Button>
          <Button id="BrowseBookmarkButton" action="9to1.Browse.Bookmark" Column="1">Bookmark</Button>
          <Button id="BrowseDiscardAddressButton" action="9to1.Browse.DiscardAddress" Column="2">Discard address draft</Button>
        </Container>
      </Container>
      <Container Type="Vertical Stack" Row="2" CellGap="4">
        <Text Text="{Binding Security}" TextWrapping="Wrap" />
        <Text Text="{Binding Profile}" TextWrapping="Wrap" />
        <Container Type="Grid" ColumnSizes="1fr 1fr 1fr">
          <Button id="BrowseFirefoxTabButton" action="9to1.Browse.FirefoxTab">Use Firefox</Button>
          <Button id="BrowseChromiumTabButton" action="9to1.Browse.ChromiumTab" Column="1">Use Chromium</Button>
          <Button id="BrowseRecoverButton" action="9to1.Browse.Recover" Column="2">Recover tab</Button>
        </Container>
      </Container>
      <Object Type="browse.engine" id="BrowseEngineView" MinHeight="180" AccessibleName="Original native browser engine surface" Row="3" />
      <Container MaxHeight="220" Type="Overlay" Row="4" VerticalScrolling="True" HorizontalScrolling="False">
        <Container Type="Vertical Stack" CellGap="4">
          <Text Text="{Binding EngineStatus}" TextWrapping="Wrap" />
          <Text Text="{Binding Status}" TextWrapping="Wrap" AccessibleName="Browse operation status" />
          <Container Type="Grid" ColumnSizes="1fr 1fr 1fr">
            <Input Type="Text" id="BrowseFindBox" AccessibleName="Find on current page" Value="{Binding FindQuery, mode=TwoWay}" />
            <Button id="BrowseFindPreviousButton" action="9to1.Browse.FindPrevious" Column="1">Previous</Button>
            <Button id="BrowseFindNextButton" action="9to1.Browse.FindNext" Column="2">Next</Button>
          </Container>
          <Container Type="Grid" ColumnSizes="1fr 1fr 1fr 1fr">
            <Button id="BrowseZoomOutButton" action="9to1.Browse.ZoomOut">Zoom −</Button>
            <Text Text="{Binding Zoom}" Column="1" />
            <Button id="BrowseZoomInButton" action="9to1.Browse.ZoomIn" Column="2">Zoom +</Button>
            <Button id="BrowseZoomResetButton" action="9to1.Browse.ZoomReset" Column="3">Reset zoom</Button>
          </Container>
          <Container Type="Grid" ColumnSizes="1fr 1fr" RowSizes="Auto Auto Auto Auto Auto">
            <Button id="BrowseFirefoxSiteButton" action="9to1.Browse.FirefoxSite">Prefer Firefox for site</Button>
            <Button id="BrowseChromiumSiteButton" action="9to1.Browse.ChromiumSite" Column="1">Prefer Chromium for site</Button>
            <Button id="BrowseDefaultFirefoxButton" action="9to1.Browse.DefaultFirefox" Row="1">Default Firefox</Button>
            <Button id="BrowseDefaultChromiumButton" action="9to1.Browse.DefaultChromium" Row="1" Column="1">Default Chromium</Button>
            <Button id="BrowseAllowPopupsButton" action="9to1.Browse.AllowPopups" Row="2">Allow site popups</Button>
            <Button id="BrowseDenyPopupsButton" action="9to1.Browse.DenyPopups" Row="2" Column="1">Block site popups</Button>
            <Button id="BrowseDevToolsButton" action="9to1.Browse.DevTools" Row="3">Developer tools</Button>
            <Button id="BrowseDownloadsButton" action="9to1.Browse.Downloads" Row="3" Column="1">Refresh downloads</Button>
            <Button id="BrowseResetSiteEngineButton" action="9to1.Browse.ResetSiteEngine" Row="4" ColumnSpan="2">Reset site engine preference</Button>
          </Container>
          <Text Text="{Binding PopupStatus}" TextWrapping="Wrap" />
          <Text>Bookmarks</Text>
          <Repeat Source="{Binding Bookmarks}" As="bookmark" Key="{Binding bookmark.Key}">
            <Container Type="Vertical Stack">
              <Button id="BrowseBookmarkRowButton" action="OpenBookmark" Text="{Binding bookmark.Label}" AccessibleName="{Binding bookmark.Label}" />
              <Text Text="{Binding bookmark.Detail}" TextWrapping="Wrap" />
            </Container>
          </Repeat>
          <Text>History</Text>
          <Repeat Source="{Binding History}" As="visit" Key="{Binding visit.Key}">
            <Container Type="Vertical Stack">
              <Button id="BrowseHistoryRowButton" action="OpenHistory" Text="{Binding visit.Label}" AccessibleName="{Binding visit.Label}" />
              <Text Text="{Binding visit.Detail}" TextWrapping="Wrap" />
            </Container>
          </Repeat>
          <Button id="BrowseClearHistoryButton" action="9to1.Browse.ClearHistory">Clear local history</Button>
          <Text Text="{Binding DownloadStatus}" TextWrapping="Wrap" />
          <Text Text="{Binding DownloadOpenStatus}" TextWrapping="Wrap" />
          <Repeat Source="{Binding Downloads}" As="download" Key="{Binding download.Key}">
            <Container Type="Vertical Stack">
              <Text Text="{Binding download.Label}" />
              <Text Text="{Binding download.Detail}" TextWrapping="Wrap" />
              <Button id="BrowseDownloadFilesButton" action="ShowDownloadInFiles">Show in Files</Button>
            </Container>
          </Repeat>
          <Text Text="{Binding DownloadDestinationPrompt}" TextWrapping="Wrap" />
          <Repeat Source="{Binding DownloadDestinations}" As="folder" Key="{Binding folder.Key}">
            <Button id="BrowseDownloadDestinationButton" action="RegisterDownloadDestination" Text="{Binding folder.Label}" />
          </Repeat>
          <Button id="BrowseRetryDownloadRegistrationButton" action="9to1.Browse.RetryDownloadRegistration">Continue Files approval</Button>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
