<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HavenOS.Apps.Browse.NativeUI</AssemblyName>
    <RootNamespace>HavenOS.Apps.Browse</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <ProjectReference Include="..\Core\HavenOS.Apps.Browse.Core.csproj" />
    <ProjectReference Include="..\..\..\framework\CUI\Runtime\CakeOS.Cui.Runtime.csproj" />
    <EmbeddedResource Include="UI\*.cui" LogicalName="HavenOS.Apps.Browse.NativeUI.UI.%(Filename)%(Extension)" />
    <AvaloniaResource Include="Assets\*.svg" />
  </ItemGroup>
  <!-- Project references provide runtime types, not resource-build targets.
       Use the same pinned source-build asset pipeline as CUI and Desktop. -->
  <Import Project="../../../framework/CUI/vendor/Avalonia/build/BuildTargets.targets" />
</Project>
