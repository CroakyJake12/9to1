<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HavenOS.Apps.Browse</AssemblyName>
    <RootNamespace>HavenOS.Apps.Browse</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);Source\**\*</DefaultItemExcludes>
    <HavenUiProjectPath Condition="'$(HavenUiProjectPath)' == '' and Exists('$(MSBuildThisFileDirectory)../shared/src/Haven.UI/Haven.UI.csproj')">$(MSBuildThisFileDirectory)../shared/src/Haven.UI/Haven.UI.csproj</HavenUiProjectPath>
  </PropertyGroup>

  <Target Name="RequireHavenUi" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'$(HavenUiProjectPath)' == ''" Text="Haven.UI is required for the Browse CUI surface. Set /p:HavenUiProjectPath=&lt;path-to-Haven.UI.csproj&gt;." />
    <Error Condition="'$(HavenUiProjectPath)' != '' and !Exists('$(HavenUiProjectPath)')" Text="HavenUiProjectPath does not exist: $(HavenUiProjectPath)" />
  </Target>

  <ItemGroup>
    <Compile Include="BrowseAppRoute.cs" />
    <Compile Include="BrowseChrome.cs" />
    <Compile Include="BrowseCuiScene.cs" />
    <Compile Include="BrowseEngineSelectionPolicy.cs" />
    <Compile Include="BrowseEnginePreferencesStore.cs" />
    <ProjectReference Include="..\shared\src\Haven.Browser\Haven.Browser.csproj" />
    <ProjectReference Include="$(HavenUiProjectPath)" Condition="'$(HavenUiProjectPath)' != '' and Exists('$(HavenUiProjectPath)')" />
  </ItemGroup>
  <ItemGroup><Compile Include="BrowseWebMcpBinding.cs" /></ItemGroup>
<Target Name="RequireCanonicalHavenUiHavenUiProjectPath" BeforeTargets="ResolveProjectReferences">
    <PropertyGroup>
      <CanonicalExpectedHavenUi>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)','../shared/src/Haven.UI/Haven.UI.csproj'))</CanonicalExpectedHavenUi>
      <CanonicalSelectedHavenUi>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)','$(HavenUiProjectPath)'))</CanonicalSelectedHavenUi>
    </PropertyGroup>
    <Error Condition="'$(CanonicalSelectedHavenUi)' != '$(CanonicalExpectedHavenUi)'" Text="Active product graphs require the canonical shared Haven.UI project; alternate assembly inputs are unsupported." />
  </Target>
</Project>
