<Cui id="permissions-permissions" product="9-1" version="1">
  <Actions>
    <Action name="navigator.get-vrdisplays" command="navigator.getVRDisplays()" />
    <Action name="navigator.media-devices.get-user-media" command="navigator.mediaDevices.getUserMedia({video: true, fake: true})" />
    <Action name="notification.request-permission" command="Notification.requestPermission()" />
    <Action name="request-geo" command="requestGeo()" />
    <Action name="request-push" command="requestPush()" />
  </Actions>
  <Page id="permissions-permissions-root">
    <Container id="html" Type="Vertical Stack">
      <Container id="head" Type="Vertical Stack">
        <Container id="meta" Type="Vertical Stack" />
      </Container>
      <Container id="script" Type="Vertical Stack" />
      <Container id="body" Type="Vertical Stack">
        <Button id="geo" action="request-geo" />
        <Button id="xr" action="navigator.get-vrdisplays" />
        <Button id="desktop-notification" action="notification.request-permission" />
        <Button id="push" action="request-push" />
        <Button id="camera" action="navigator.media-devices.get-user-media" />
      </Container>
    </Container>
  </Page>
</Cui>
