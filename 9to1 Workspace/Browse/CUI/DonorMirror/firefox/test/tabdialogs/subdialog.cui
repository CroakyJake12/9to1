<Cui id="tabdialogs-subdialog" product="9-1" version="1">
  <Actions>
    <Action name="window.close" command="window.close();" />
  </Actions>
  <Page id="tabdialogs-subdialog-root">
    <Container id="window" Type="Vertical Stack">
      <Text id="window-label" text="Sample sub-dialog" />
      <Container id="subDialog" Type="Vertical Stack">
        <Container id="script" Type="Vertical Stack" />
        <Text id="desc" text="A sample sub-dialog for testing" />
        <Input id="textbox" Type="Text" Value="Default text" />
        <Input id="select" Type="Select">
          <Container id="option" Type="Vertical Stack" />
          <Container id="option-2" Type="Vertical Stack" />
        </Input>
        <Input id="custom-focus-el" Type="Text" Value="Custom Focus Test" />
        <Container id="separator" Type="Vertical Stack" />
        <Button id="button" action="window.close" content="Close" />
      </Container>
    </Container>
  </Page>
</Cui>
