<Cui id="assistants" version="1">
  <Page id="assistants-shell" AccessibleName="Assistants">
    <Container Type="Grid">
      <Object id="assistants-home" Type="AssistantsHome" Active="{Binding ShowHome}" />
      <Object id="assistants-configuration" Type="AssistantConfiguration" Active="{Binding ShowConfiguration}" />
      <Object id="assistants-legacy-migration" Type="AssistantLegacyMigration" Active="{Binding ShowLegacyMigration}" />
      <Object id="assistants-memory" Type="AssistantMemory" Active="{Binding ShowMemory}" />
      <Object id="assistants-mini-computer" Type="AssistantMiniComputer" Active="{Binding ShowMiniComputer}" />
      <Object id="assistants-work" Type="AssistantWork" Active="{Binding ShowWork}" />
    </Container>
  </Page>
</Cui>
