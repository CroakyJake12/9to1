<Cui id="assistants.conversation" version="1">
  <Actions>
    <Action name="StopOriginalReply" command="assistants.conversation.stop" parameter="{Binding OriginalChatStopInput}" />
    <Action name="ShowSearchMessage" command="assistants.conversation.find.show" parameter="{Binding match}" />
    <Action name="ContinueBranch" command="assistants.branch.create" parameter="{Binding message}" />
    <Action name="OpenBranch" command="assistants.branch.switch" parameter="{Binding branch}" />
    <Action name="DetachAttachment" command="assistants.attachment.detach" parameter="{Binding attachment}" />
    <Action name="ChooseOriginalProject" command="assistants.project.choose" parameter="{Binding project}" />
  </Actions>
  <Page id="assistant-conversation-page" AccessibleName="Conversation">
    <Container id="assistant-conversation-layout" Type="Grid" RowSizes="1fr Auto" CellGap="10">
      <Container id="assistant-transcript-scroll" Row="0" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" MinHeight="0" Padding="0,4,8,8" CellGap="12" AccessibleName="Assistant conversation transcript">
        <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="12">
          <Text Text="{Binding ConversationTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button id="conversation-find-open" Column="1" action="assistants.conversation.find.open" AccessibleName="Find in this branch" Interactive="{Binding CanFindConversation}" FontSize="13" FontWeight="SemiBold" Padding="10,7" Chromeless="True">Find</Button>
        </Container>
        <Text Text="{Binding ConversationAvailability}" FontSize="13" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" AccessibleName="Conversation availability" />
        <Container Type="Vertical Stack" AccessibleName="Find in this conversation branch" CellGap="8" Padding="12" Background="{Resource CuiPanelBrush}" CornerRadius="14" Active="{Binding ShowConversationSearch}">
          <Input id="conversation-search-query" Type="Text" AccessibleName="Find text in this branch" PlaceholderText="Find text in this branch" Value="{Binding ConversationSearchQuery, Mode=TwoWay}" Interactive="{Binding CanFindConversation}" FontSize="13" FontWeight="SemiBold" />
          <Container Orientation="Horizontal" Type="Wrap" CellGap="8">
            <Button id="conversation-find" action="assistants.conversation.find" Interactive="{Binding CanRunConversationSearch}" Padding="10,7" FontWeight="SemiBold">Find</Button>
            <Button id="conversation-find-clear" action="assistants.conversation.find.clear" Interactive="{Binding CanFindConversation}" Padding="10,7" FontWeight="SemiBold" Chromeless="True">Close search</Button>
          </Container>
          <Text Text="{Binding ConversationSearchStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" AccessibleName="Conversation search status" />
          <Container Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" MaxHeight="180" CellGap="8" Active="{Binding HasConversationSearchResults}">
            <Repeat Source="{Binding ConversationSearchResults}" As="match" Key="{Binding match.Id}">
              <Container Type="Vertical Stack" Padding="10" Margin="0,0,0,8" Background="{Resource CuiWorkspaceBrush}" CornerRadius="10" CellGap="6">
                <Text Text="{Binding match.Snippet}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Button action="ShowSearchMessage" Text="{Binding match.Label}" Interactive="{Binding CanFindConversation}" HorizontalAlignment="Left" Padding="8,5" Chromeless="True" FontSize="12" FontWeight="SemiBold" />
              </Container>
            </Repeat>
          </Container>
        </Container>
        <Container Type="Vertical Stack" CellGap="10" Active="{Binding ShowProjectSelection}" id="assistant-project-selection">
          <Text Text="{Binding ProjectSelectionTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Text Text="Choose a project to continue working on it or open it in Dev." TextWrapping="Wrap" />
          <Text Text="{Binding ProjectSelectionStatus}" TextWrapping="Wrap" AccessibleName="Canonical project selection status" />
          <Input id="project-title-search" Type="Text" PlaceholderText="Search saved project titles" AccessibleName="Search saved project titles" Value="{Binding ProjectSearchText, Mode=TwoWay}" Interactive="{Binding CanSearchProjects}" />
          <Button action="assistants.project.search" Interactive="{Binding CanSearchProjects}">Search saved projects</Button>
          <Repeat Source="{Binding ProjectChoices}" As="project" Key="{Binding project.Id}">
            <Button action="ChooseOriginalProject" Text="{Binding project.Title}" Margin="0,0,0,6" Interactive="{Binding CanChooseProject}" />
          </Repeat>
          <Text Text="{Binding ProjectSelectionMore}" TextWrapping="Wrap" />
          <Container Type="Vertical Stack" Active="{Binding HasPendingProjectCreation}" CellGap="6">
            <Text Text="{Binding PendingProjectCreationTitle}" FontWeight="SemiBold" />
            <Text Text="Your earlier project creation is saved. Try again to check its progress without creating another task." TextWrapping="Wrap" />
            <Button id="retry-original-project-task" action="assistants.project.retry" Interactive="{Binding CanRetryProjectCreation}">Retry original project Task</Button>
          </Container>
          <Button action="assistants.project.older" Interactive="{Binding CanReadOlderProjects}">Older saved projects</Button>
          <Button action="assistants.project.refresh" Interactive="{Binding CanRefreshProjects}">Refresh newest matching projects</Button>
          <Button action="assistants.project.cancel" Interactive="{Binding CanCloseProjectSelection}">Cancel project selection</Button>
        </Container>
        <Container id="assistant-draft-attachment-details" Type="Vertical Stack" AccessibleName="Attached file details" CellGap="8" Active="{Binding HasDraftAttachments}">
          <Text Text="Attached files" FontSize="13" FontWeight="Bold" />
          <Repeat Source="{Binding DraftAttachments}" As="attachment" Key="{Binding attachment.Id}">
            <Container Type="Vertical Stack" CellGap="4" Margin="0,0,0,12">
              <Text Text="{Binding attachment.Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Text Text="{Binding attachment.Details}" FontSize="12" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
              <Text Text="{Binding attachment.Preview}" FontSize="12" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
            </Container>
          </Repeat>
        </Container>
        <Container id="assistant-message-history" Type="Vertical Stack" CellGap="10" Active="{Binding HasConversationMessages}">
          <Repeat Source="{Binding Messages}" As="message" Key="{Binding message.Id}">
            <Container Type="Vertical Stack" Margin="0,0,0,20" CellGap="8">
              <Text Text="{Binding message.RoleLabel}" FontSize="12" FontWeight="Bold" Foreground="{Resource CuiTextSoftBrush}" />
              <Object Type="AssistantMessage" Text="{Binding message.Content}" AccessibleName="Message content" />
              <Text Text="{Binding message.Thinking}" FontSize="13" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" Active="{Binding message.HasThinking}" />
              <Text Text="{Binding message.Activity}" FontSize="12" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" Active="{Binding message.HasActivity}" />
              <Button action="ContinueBranch" AccessibleName="Continue conversation from this message" Interactive="{Binding message.CanContinue}" HorizontalAlignment="Left" Padding="8,5" Chromeless="True" FontSize="12" FontWeight="SemiBold">Continue from here</Button>
            </Container>
          </Repeat>
        </Container>
        <Text Text="No messages yet. Write a message below, or save a draft for later." FontSize="14" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" Active="{Binding ShowEmptyConversation}" />
        <Container Type="Vertical Stack" AccessibleName="Current Task progress" CellGap="8" Padding="16" Background="{Resource CuiPanelBrush}" CornerRadius="14" Active="{Binding HasTaskProgress}" id="assistant-task-progress">
          <Text Text="Current Task" FontSize="18" FontWeight="SemiBold" />
          <Text Text="{Binding TaskObjective}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Text Text="{Binding TaskExecutionStatus}" TextWrapping="Wrap" />
          <Text Text="{Binding TaskCurrentActivity}" TextWrapping="Wrap" />
          <Text Text="{Binding TaskFollowUpResult}" TextWrapping="Wrap" AccessibleName="Task instruction result" Active="{Binding HasTaskFollowUpResult}" />
          <Text Text="Checkpoints" FontWeight="SemiBold" />
          <Text Text="{Binding TaskCheckpointStatus}" TextWrapping="Wrap" />
          <Text Text="{Binding TaskAcceptanceStatus}" TextWrapping="Wrap" />
          <Text Text="{Binding TaskRecoveryStatus}" TextWrapping="Wrap" AccessibleName="Task recovery status" />
          <Container Type="Vertical Stack" AccessibleName="Saved Task recovery" CellGap="6" Active="{Binding HasColdTaskRecovery}">
            <Text Text="Continue saved work" FontWeight="SemiBold" />
            <Text Text="{Binding ColdTaskRecoveryReason}" TextWrapping="Wrap" />
            <Container Orientation="Horizontal" Type="Wrap">
              <Button id="assistant-cold-task-review" action="assistants.task.recovery.review" Margin="0,0,8,8" Interactive="{Binding CanReviewColdTaskRecovery}">Review recovery</Button>
              <Button id="assistant-cold-task-resume" action="assistants.task.recovery.resume" Margin="0,0,8,8" Interactive="{Binding CanResumeColdTaskRecovery}">Resume saved Task</Button>
            </Container>
          </Container>
          <Container Type="Vertical Stack" CellGap="6" Active="{Binding HasTaskPlan}">
            <Text Text="Plan" FontWeight="SemiBold" />
            <Repeat Source="{Binding TaskPlanRows}" As="step" Key="{Binding step.Id}">
              <Container Type="Vertical Stack" CellGap="3">
                <Text Text="{Binding step.Summary}" TextWrapping="Wrap" />
                <Text Text="{Binding step.Status}" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
              </Container>
            </Repeat>
          </Container>
          <Container Type="Vertical Stack" CellGap="6" Active="{Binding HasTaskSteers}">
            <Text Text="Steering" FontWeight="SemiBold" />
            <Repeat Source="{Binding TaskSteerRows}" As="steer" Key="{Binding steer.Id}">
              <Container Type="Vertical Stack" CellGap="3">
                <Text Text="{Binding steer.Summary}" TextWrapping="Wrap" />
                <Text Text="{Binding steer.Status}" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
              </Container>
            </Repeat>
          </Container>
          <Container Type="Vertical Stack" CellGap="6" Active="{Binding HasTaskQueue}">
            <Text Text="Queued next" FontWeight="SemiBold" />
            <Repeat Source="{Binding TaskQueueRows}" As="followup" Key="{Binding followup.Id}">
              <Container Type="Vertical Stack" CellGap="3">
                <Text Text="{Binding followup.Summary}" TextWrapping="Wrap" />
                <Text Text="{Binding followup.Status}" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
              </Container>
            </Repeat>
          </Container>
        </Container>
        <Container Type="Vertical Stack" AccessibleName="Conversation branches" CellGap="6" Active="{Binding HasConversationBranches}">
          <Text Text="Branches" FontSize="12" FontWeight="Bold" Foreground="{Resource CuiTextSoftBrush}" />
          <Container Orientation="Horizontal" Type="Wrap" CellGap="8">
            <Repeat Source="{Binding ConversationBranches}" As="branch" Key="{Binding branch.Id}">
              <Button action="OpenBranch" Text="{Binding branch.Label}" Interactive="{Binding branch.CanOpen}" Padding="10,7" CornerRadius="12" FontSize="12" FontWeight="SemiBold" />
            </Repeat>
          </Container>
          <Text Text="{Binding ConversationBranchHelp}" FontSize="12" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
        </Container>
        <Text Text="{Binding ComposerAvailability}" FontSize="12" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" AccessibleName="Message availability" />
        <Text Text="{Binding AttachmentStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" AccessibleName="Attachment status" />
        <Text Text="{Binding ConversationStatus}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" AccessibleName="Conversation work status" />
      </Container>
      <Container id="assistant-composer-footer" Row="1" Type="Vertical Stack" CellGap="6" AccessibleName="Assistant composer and model actions">
        <Container Type="Vertical Stack" AccessibleName="Conversation model" CellGap="4">
          <Text Text="{Binding SelectedModelLabel}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" AccessibleName="Selected model" TextTrimming="CharacterEllipsis" tooltip="{Binding SelectedModelLabel}" />
          <Text Text="{Binding ModelAvailabilityHelp}" FontSize="12" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" AccessibleName="Model availability help" Active="{Binding ShowModelAvailabilityHelp}" />
        </Container>
        <Container id="assistant-message-composer" Type="Vertical Stack" AccessibleName="Assistant message composer" CellGap="10" Padding="12" Background="{Resource CuiPanelBrush}" CornerRadius="24" CompoundFocus="True">
          <Container Type="Vertical Stack" AccessibleName="Draft attachments" VerticalScrolling="True" HorizontalScrolling="False" MaxHeight="56" CellGap="6" Active="{Binding HasDraftAttachments}">
            <Repeat Source="{Binding DraftAttachments}" As="attachment" Key="{Binding attachment.Id}">
              <Container Type="Vertical Stack" CellGap="4" Padding="6" Margin="0,0,0,4" Background="{Resource CuiWorkspaceBrush}" CornerRadius="12">
                <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="8">
                  <Text Text="{Binding attachment.Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AccessibleName="{Binding attachment.Name}" tooltip="{Binding attachment.Name}" />
                  <Button Column="1" action="DetachAttachment" Interactive="{Binding CanDetachAttachment}" AccessibleName="Remove from draft" Padding="8,5" Chromeless="True" FontSize="12" FontWeight="SemiBold">Remove</Button>
                </Container>
              </Container>
            </Repeat>
          </Container>
          <Input id="conversation-draft" Type="Text" MinHeight="72" MaxHeight="112" TextWrapping="Wrap" AccessibleName="Message to your Assistant" PlaceholderText="What would you like to do?" Value="{Binding Prompt, Mode=TwoWay}" Multiline="True" Interactive="{Binding CanEditPrompt}" EmbeddedInput="True" Background="Transparent" BorderWidth="0" Padding="8,6" FontSize="14" FontWeight="SemiBold" />
          <Container Type="Grid" ColumnSizes="1fr Auto" CellGap="8" AccessibleName="Assistant actions">
            <Button id="conversation-attach-file" action="assistants.attachment.pick" Interactive="{Binding CanPickAttachment}" AccessibleName="Attach a file from Files" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="10,8" Chromeless="True" FontSize="13" FontWeight="SemiBold">Attach</Button>
            <Container Column="1" Type="Wrap" CellGap="6" VerticalAlignment="Bottom">
              <Button id="assistant-send" action="assistants.send" Text="{Binding SendLabel}" Interactive="{Binding CanSend}" Active="{Binding ShowChatComposer}" Padding="14,9" CornerRadius="18" FontSize="13" FontWeight="SemiBold" AccentRole="Primary" />
              <Button id="assistant-stop-reply" action="StopOriginalReply" AccessibleName="Stop this reply" Interactive="{Binding CanStopReply}" Active="{Binding ShowStopReply}" Padding="12,9" CornerRadius="18" FontSize="13" FontWeight="SemiBold">Stop</Button>
            </Container>
          </Container>
          <Container Orientation="Horizontal" AccessibleName="Assistant actions" Type="Wrap" CellGap="8" Active="{Binding ShowTaskComposer}">
            <Button id="assistant-start-task" action="assistants.task.start" Interactive="{Binding CanStartTask}" Padding="12,8" FontWeight="SemiBold" AccentRole="Primary" AccessibleName="Start task" FontSize="12">Start task</Button>
            <Button id="assistant-steer" action="assistants.task.steer" Interactive="{Binding CanSteer}" Padding="10,8" FontWeight="SemiBold" AccessibleName="Steer current task" FontSize="12">Steer</Button>
            <Button id="assistant-queue" action="assistants.task.queue" Interactive="{Binding CanSteer}" Padding="10,8" FontWeight="SemiBold" AccessibleName="Queue follow-up" FontSize="12">Queue</Button>
            <Button id="assistant-stop" action="assistants.task.stop" Interactive="{Binding CanStop}" Padding="10,8" FontWeight="SemiBold" AccessibleName="Stop current task" FontSize="12">Stop task</Button>
          </Container>
        </Container>
        <Text Text="{Binding ReplyStopStatus}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" AccessibleName="Reply Stop status" Active="{Binding HasReplyStopStatus}" />
        <Container Orientation="Horizontal" AccessibleName="Assistant actions" Type="Wrap" CellGap="6">
          <Button id="assistant-save-draft" action="assistants.draft.save" Interactive="{Binding CanSaveDraft}" Padding="8,6" Chromeless="True" FontSize="12" FontWeight="SemiBold">Save draft</Button>
          <Button id="assistant-new-task" action="assistants.task.new" Interactive="{Binding CanNewConversation}" Padding="8,6" Chromeless="True" FontSize="12" FontWeight="SemiBold">New task</Button>
          <Button id="conversation-refresh-models" action="assistants.model.refresh" Interactive="{Binding CanRefreshConversationModels}" Padding="8,6" Chromeless="True" FontSize="12" FontWeight="SemiBold">Refresh available models</Button>
          <Button id="conversation-model-settings" action="assistants.configuration.open" Interactive="{Binding CanConfigure}" Padding="8,6" Chromeless="True" FontSize="12" FontWeight="SemiBold">Model preferences</Button>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
