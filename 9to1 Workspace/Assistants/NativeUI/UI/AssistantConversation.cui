<Cui id="assistants.conversation" version="1">
  <Actions>
    <Action name="StopOriginalReply" command="assistants.conversation.stop" parameter="{Binding OriginalChatStopInput}" />
    <Action name="ShowSearchMessage" command="assistants.conversation.find.show" parameter="{Binding match}" />
    <Action name="ContinueBranch" command="assistants.branch.create" parameter="{Binding message}" />
    <Action name="OpenBranch" command="assistants.branch.switch" parameter="{Binding branch}" />
    <Action name="ChooseModel" command="assistants.model.choose" parameter="{Binding model}" />
    <Action name="DetachAttachment" command="assistants.attachment.detach" parameter="{Binding attachment}" />
  </Actions>
  <Page id="assistant-conversation-page" AccessibleName="Conversation">
    <Container Type="Vertical Stack" CellGap="10">
      <Text Text="{Binding ConversationTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
      <Text Text="{Binding ConversationAvailability}" TextWrapping="Wrap" AccessibleName="Conversation availability" />
      <Container Type="Vertical Stack" AccessibleName="Find in this conversation branch" CellGap="6" Active="{Binding ShowConversationSearch}">
        <Input id="conversation-search-query" Type="Text" AccessibleName="Find text in this branch" PlaceholderText="Find text in this branch" Value="{Binding ConversationSearchQuery, Mode=TwoWay}" Interactive="{Binding CanFindConversation}" />
        <Container Orientation="Horizontal" Type="Wrap">
          <Button id="conversation-find" action="assistants.conversation.find" Margin="0,0,8,8" Interactive="{Binding CanRunConversationSearch}">Find</Button>
          <Button id="conversation-find-clear" action="assistants.conversation.find.clear" Margin="0,0,8,8" Interactive="{Binding CanFindConversation}">Close search</Button>
        </Container>
        <Text Text="{Binding ConversationSearchStatus}" TextWrapping="Wrap" AccessibleName="Conversation search status" />
        <Container Type="Vertical Stack" VerticalScrolling="True" MaxHeight="180" CellGap="8" Active="{Binding HasConversationSearchResults}">
          <Repeat Source="{Binding ConversationSearchResults}" As="match" Key="{Binding match.Id}">
            <Container Type="Vertical Stack" CellGap="4">
              <Text Text="{Binding match.Snippet}" TextWrapping="Wrap" />
              <Button action="ShowSearchMessage" Text="{Binding match.Label}" Interactive="{Binding CanFindConversation}" />
            </Container>
          </Repeat>
        </Container>
      </Container>
      <Container Type="Vertical Stack" AccessibleName="Conversation branches" CellGap="6" Active="{Binding HasConversationBranches}">
        <Text Text="Branches" FontWeight="SemiBold" />
        <Text Text="{Binding ConversationBranchHelp}" TextWrapping="Wrap" />
        <Container Orientation="Horizontal" Type="Wrap">
          <Repeat Source="{Binding ConversationBranches}" As="branch" Key="{Binding branch.Id}">
            <Button action="OpenBranch" Text="{Binding branch.Label}" Margin="0,0,8,8" Interactive="{Binding branch.CanOpen}" />
          </Repeat>
        </Container>
      </Container>
      <Container Type="Vertical Stack" VerticalScrolling="True" MinHeight="100" MaxHeight="440" CellGap="10" Active="{Binding HasConversationMessages}">
        <Repeat Source="{Binding Messages}" As="message" Key="{Binding message.Id}">
          <Container Type="Vertical Stack" Margin="0,0,0,14" CellGap="6">
            <Text Text="{Binding message.RoleLabel}" FontWeight="SemiBold" />
            <Object Type="AssistantMessage" Text="{Binding message.Content}" AccessibleName="Message content" />
            <Text Text="{Binding message.Thinking}" TextWrapping="Wrap" Active="{Binding message.HasThinking}" />
            <Text Text="{Binding message.Activity}" TextWrapping="Wrap" Active="{Binding message.HasActivity}" />
            <Button action="ContinueBranch" AccessibleName="Continue conversation from this message" Interactive="{Binding message.CanContinue}">Continue from here</Button>
          </Container>
        </Repeat>
      </Container>
      <Text Text="No messages yet. Write a message below, or save a draft for later." TextWrapping="Wrap" Active="{Binding ShowEmptyConversation}" />
      <Text Text="{Binding SelectedModelLabel}" TextWrapping="Wrap" AccessibleName="Selected model" />
      <Text Text="{Binding ModelAvailabilityHelp}" TextWrapping="Wrap" AccessibleName="Model availability help" Active="{Binding ShowModelAvailabilityHelp}" />
      <Container Orientation="Horizontal" AccessibleName="Assistant actions" Type="Wrap">
        <Button id="conversation-find-open" action="assistants.conversation.find.open" Margin="0,0,8,8" Interactive="{Binding CanFindConversation}">Find in this branch</Button>
        <Button id="conversation-refresh-models" action="assistants.model.refresh" Margin="0,0,8,8" Interactive="{Binding CanRefreshConversationModels}">Refresh available models</Button>
        <Button id="conversation-model-settings" action="assistants.configuration.open" Margin="0,0,8,8" Interactive="{Binding CanConfigure}">Model preferences</Button>
      </Container>
      <Container Type="Vertical Stack" VerticalScrolling="True" MaxHeight="160" CellGap="6" Active="{Binding HasModels}">
        <Repeat Source="{Binding Models}" As="model" Key="{Binding model.Id}">
          <Button action="ChooseModel" Text="{Binding model.Label}" Margin="0,0,0,4" Interactive="{Binding CanChooseModel}" />
        </Repeat>
      </Container>
      <Container Type="Vertical Stack" AccessibleName="Draft attachments" CellGap="6">
        <Button id="conversation-attach-file" action="assistants.attachment.pick" Interactive="{Binding CanPickAttachment}">Attach a file from Files</Button>
        <Text Text="{Binding AttachmentStatus}" TextWrapping="Wrap" AccessibleName="Attachment status" />
        <Container Type="Vertical Stack" VerticalScrolling="True" MaxHeight="220" CellGap="8" Active="{Binding HasDraftAttachments}">
          <Repeat Source="{Binding DraftAttachments}" As="attachment" Key="{Binding attachment.Id}">
            <Container Type="Vertical Stack" CellGap="4">
              <Text Text="{Binding attachment.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Text Text="{Binding attachment.Details}" TextWrapping="Wrap" />
              <Text Text="{Binding attachment.Preview}" TextWrapping="Wrap" />
              <Button action="DetachAttachment" Interactive="{Binding CanDetachAttachment}">Remove from draft</Button>
            </Container>
          </Repeat>
        </Container>
      </Container>
      <Input id="conversation-draft" Type="Text" MinHeight="72" TextWrapping="Wrap" AccessibleName="Message to your Assistant" PlaceholderText="What would you like to do?" Value="{Binding Prompt, Mode=TwoWay}" Multiline="True" Interactive="{Binding CanEditPrompt}" />
      <Container Orientation="Horizontal" AccessibleName="Assistant actions" Type="Wrap">
        <Button id="assistant-send" action="assistants.send" Text="{Binding SendLabel}" Margin="0,0,8,8" Interactive="{Binding CanSend}" Active="{Binding ShowChatComposer}" />
        <Button id="assistant-stop-reply" action="StopOriginalReply" AccessibleName="Stop this reply" Margin="0,0,8,8" Interactive="{Binding CanStopReply}" Active="{Binding ShowStopReply}">Stop reply</Button>
        <Button id="assistant-save-draft" action="assistants.draft.save" Margin="0,0,8,8" Interactive="{Binding CanSaveDraft}">Save draft</Button>
      </Container>
      <Text Text="{Binding ReplyStopStatus}" TextWrapping="Wrap" AccessibleName="Reply Stop status" Active="{Binding HasReplyStopStatus}" />
      <Text Text="{Binding ComposerAvailability}" TextWrapping="Wrap" AccessibleName="Message availability" />
      <Container Orientation="Horizontal" AccessibleName="Assistant actions" Type="Wrap">
        <Button id="assistant-new-task" action="assistants.task.new" Margin="0,0,8,8" Interactive="{Binding CanNewConversation}">New task</Button>
      </Container>
      <Container Orientation="Horizontal" AccessibleName="Assistant actions" Type="Wrap" Active="{Binding ShowTaskComposer}">
        <Button id="assistant-start-task" action="assistants.task.start" Margin="0,0,8,8" Interactive="{Binding CanStartTask}">Start task</Button>
        <Button id="assistant-steer" action="assistants.task.steer" Margin="0,0,8,8" Interactive="{Binding CanSteer}">Steer current task</Button>
        <Button id="assistant-queue" action="assistants.task.queue" Margin="0,0,8,8" Interactive="{Binding CanSteer}">Queue follow-up</Button>
        <Button id="assistant-stop" action="assistants.task.stop" Margin="0,0,8,8" Interactive="{Binding CanStop}">Stop current task</Button>
      </Container>
      <Text Text="{Binding ConversationStatus}" TextWrapping="Wrap" AccessibleName="Conversation work status" />
    </Container>
  </Page>
</Cui>
