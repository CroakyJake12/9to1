<Cui id="assistants.home" version="1">
  <Actions>
    <Action name="OpenAssistant" command="assistants.open" parameter="{Binding assistant}" />
    <Action name="OpenRecentConversation" command="assistants.conversation.open" parameter="{Binding conversation}" />
    <Action name="OpenRecentWork" command="assistants.work.open" parameter="{Binding work}" />
  </Actions>
  <Page id="assistants-home-page" AccessibleName="Your Assistants" Background="{Resource CuiWorkspaceBrush}">
    <Container id="assistants-home-scroll" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" Padding="16,24" CellGap="24">
      <Container id="assistants-home-content" Type="Vertical Stack" MaxWidth="1120" HorizontalAlignment="Stretch" CellGap="24">
        <Container Type="Vertical Stack" CellGap="10">
          <Text Text="Your collaborators" FontSize="12" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" />
          <Text Text="Pick up where you left off." FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
          <Text Text="Each Assistant keeps its Main conversation and the context you have shared." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
          <Container Type="Wrap" CellGap="8">
            <Button id="assistant-create" action="assistants.create.start" AccessibleName="Create an Assistant" Interactive="{Binding CanCreate}" AccentRole="Primary" Padding="14,10">Create Assistant</Button>
            <Button id="assistants-refresh" action="assistants.refresh" Interactive="{Binding CanRefresh}" Padding="14,10">Refresh</Button>
          </Container>
          <Text id="assistants-status" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" AccessibleName="Assistants status" Foreground="{Resource CuiTextSoftBrush}" />
          <Text id="assistants-error" Text="{Binding Error}" FontSize="13" TextWrapping="Wrap" AccessibleName="Assistants error" Active="{Binding HasError}" />
        </Container>
        <If Condition="{Binding HasAssistants}">
          <Container Type="Vertical Stack" CellGap="14">
            <Text FontSize="18" FontWeight="Bold">Your Assistants</Text>
            <Container Type="Wrap">
              <Repeat Source="{Binding Assistants}" As="assistant" Key="{Binding assistant.Id}">
                <Container id="assistant-home-card" Type="Grid" Width="288" MinHeight="224" RowSizes="Auto 1fr Auto" Padding="18" Margin="0,0,12,12" CellGap="16" Background="{Resource CuiPanelBrush}" CornerRadius="18">
                  <Container Type="Grid" ColumnSizes="44 1fr" CellGap="12">
                    <Object Type="AssistantAvatar" Text="{Binding assistant.AvatarKey}" Width="44" Height="44" HorizontalAlignment="Left" AccessibleName="{Binding assistant.AvatarLabel}" />
                    <Container Type="Vertical Stack" Column="1" CellGap="5" VerticalAlignment="Center">
                      <Text Text="{Binding assistant.Name}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                      <Text Text="{Binding assistant.ActivityLabel}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" AccessibleName="Assistant activity" Foreground="{Resource CuiTextSoftBrush}" />
                    </Container>
                  </Container>
                  <Text Row="1" Text="{Binding assistant.Description}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
                  <Container Row="2" Type="Grid" ColumnSizes="1fr Auto" CellGap="12" Padding="10" Background="{Resource CuiWorkspaceBrush}" CornerRadius="12">
                    <Container Type="Grid" ColumnSizes="22 1fr" CellGap="8" VerticalAlignment="Center">
                      <Object Type="AssistantAvatar" Text="{Binding assistant.AvatarKey}" Width="22" Height="22" AccessibleName="{Binding assistant.AvatarLabel}" />
                      <Text Column="1" Text="Main" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Container>
                    <Button Column="1" action="OpenAssistant" AccessibleName="Open this Assistant" Interactive="{Binding assistant.CanOpen}" Padding="10,7" AccentRole="Primary">Open</Button>
                  </Container>
                </Container>
              </Repeat>
            </Container>
          </Container>
        </If>
        <Else>
          <Container Type="Vertical Stack" CellGap="10" Padding="24" Background="{Resource CuiPanelBrush}" CornerRadius="18">
            <Text FontSize="22" FontWeight="Bold">Make an Assistant your own</Text>
            <Text Text="Give it a name and a purpose, then choose what it can access. Its conversations and work stay together." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
          </Container>
        </Else>
        <Container Type="Vertical Stack" CellGap="14" Active="{Binding HasRecentConversations}">
          <Text FontSize="18" FontWeight="Bold">Recent conversations</Text>
          <Repeat Source="{Binding RecentConversations}" As="conversation" Key="{Binding conversation.Id}">
            <Container Type="Grid" ColumnSizes="1fr Auto" Padding="14" Margin="0,0,0,8" CellGap="12" Background="{Resource CuiPanelBrush}" CornerRadius="14">
              <Container Type="Vertical Stack" CellGap="5">
                <Text Text="{Binding conversation.AssistantName}" FontSize="12" FontWeight="SemiBold" Foreground="{Resource CuiTextSoftBrush}" />
                <Button action="OpenRecentConversation" Text="{Binding conversation.Title}" Interactive="{Binding conversation.CanOpen}" HorizontalAlignment="Left" Padding="0" Chromeless="True" FontWeight="SemiBold" />
              </Container>
              <Text Column="1" Text="{Binding conversation.UpdatedLabel}" FontSize="12" Foreground="{Resource CuiTextSoftBrush}" VerticalAlignment="Center" />
            </Container>
          </Repeat>
        </Container>
        <Container Type="Vertical Stack" CellGap="14" Active="{Binding HasActiveWork}">
          <Text FontSize="18" FontWeight="Bold">Work in progress</Text>
          <Repeat Source="{Binding ActiveWork}" As="work" Key="{Binding work.Id}">
            <Container Type="Vertical Stack" Padding="16" Margin="0,0,0,8" CellGap="8" Background="{Resource CuiPanelBrush}" CornerRadius="14">
              <Button action="OpenRecentWork" Text="{Binding work.Title}" Interactive="{Binding work.CanOpen}" HorizontalAlignment="Left" Chromeless="True" Padding="0" FontWeight="SemiBold" />
              <Text Text="{Binding work.StatusLabel}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
          </Repeat>
        </Container>
        <Container Type="Vertical Stack" CellGap="10" Padding="18" Background="{Resource CuiPanelBrush}" CornerRadius="18">
          <Text FontSize="17" FontWeight="Bold">Bring your saved agents with you</Text>
          <Text Text="Review each saved definition, keep its history, and choose whether it should become an Assistant or a Specialist." FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
          <Button id="assistants-review-legacy" action="assistants.legacy.open" Interactive="{Binding CanReviewLegacy}" HorizontalAlignment="Left">Review saved agents</Button>
        </Container>
        <Container Type="Vertical Stack" AccessibleName="Assistant runtime availability" CellGap="10" Active="{Binding HasDependencyStatus}">
          <Text FontSize="17" FontWeight="Bold">Features on this device</Text>
          <Text Text="Open an Assistant to review its settings and access. Some features need setup or approval; others are not available yet." FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
          <Repeat Source="{Binding HomeCapabilityReadinessRows}" As="readiness" Key="{Binding readiness.Id}">
            <Container Margin="0,0,0,6" Type="Wrap" CellGap="10">
              <Text Text="{Binding readiness.Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Text Text="{Binding readiness.StatusLabel}" FontSize="13" TextWrapping="Wrap" Foreground="{Resource CuiTextSoftBrush}" />
            </Container>
          </Repeat>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
