<Cui id="assistants.configuration" version="1">
  <Actions>
    <Action name="ChooseAssistantAvatar" command="assistants.avatar.select" parameter="{Binding avatar}" />
    <Action name="ReviewResource" command="assistants.resource.review" parameter="{Binding resource}" />
    <Action name="ReviewConfiguredProject" command="assistants.configuration.project.review" parameter="{Binding project}" />
    <Action name="ChooseCapabilityPreference" command="assistants.configuration.capability.choose" parameter="{Binding capability}" />
    <Action name="ChooseSetting" command="assistants.setting.choose" parameter="{Binding setting}" />
    <Action name="ChoosePreferredModel" command="assistants.configuration.model.choose" parameter="{Binding model}" />
    <Action name="ChooseEffort" command="assistants.configuration.effort.choose" parameter="{Binding effort}" />
  </Actions>
  <Page id="assistant-configuration-page" AccessibleName="Configure Assistant">
    <Container Type="Vertical Stack" VerticalScrolling="True" Margin="24" CellGap="16">
      <Container Type="Vertical Stack" CellGap="12">
        <Button id="configuration-back" action="assistants.configuration.back" Interactive="{Binding CanLeaveConfiguration}">Back</Button>
        <Text Text="{Binding ConfigurationTitle}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
      </Container>
      <Text Text="{Binding ConfigurationIdentityLabel}" TextWrapping="Wrap" AccessibleName="Saved Assistant identity" />
      <Text Text="{Binding ConfigurationStatus}" TextWrapping="Wrap" AccessibleName="Configuration status" />
      <Text Text="{Binding ConfigurationError}" TextWrapping="Wrap" AccessibleName="Configuration error" Active="{Binding HasConfigurationError}" />
      <Container Type="Vertical Stack" CellGap="8">
        <Text FontSize="20" FontWeight="SemiBold">Identity and purpose</Text>
        <Text>Name</Text>
        <Input id="assistant-name" Type="Text" AccessibleName="Assistant name" PlaceholderText="For example, 9to1 Developer" Value="{Binding DraftName, Mode=TwoWay}" Interactive="{Binding CanEditConfiguration}" />
        <Text>Description</Text>
        <Input id="assistant-description" Type="Text" AccessibleName="Assistant description" PlaceholderText="What this Assistant helps you with" Value="{Binding DraftDescription, Mode=TwoWay}" Interactive="{Binding CanEditConfiguration}" />
        <Text>Purpose</Text>
        <Input id="assistant-purpose" Type="Text" AccessibleName="Assistant purpose" Value="{Binding DraftPurpose, Mode=TwoWay}" Interactive="{Binding CanEditConfiguration}" />
        <Text>Role</Text>
        <Input id="assistant-role" Type="Text" AccessibleName="Assistant role" PlaceholderText="For example, developer or research partner" Value="{Binding DraftRole, Mode=TwoWay}" Interactive="{Binding CanEditConfiguration}" />
        <Object Type="AssistantAvatar" Text="{Binding DraftAvatarKey}" Width="56" Height="56" AccessibleName="{Binding DraftAvatarLabel}" />
        <Button action="assistants.avatar.choose" Text="{Binding AvatarChoiceLabel}" AccessibleName="Choose Assistant avatar" Interactive="{Binding CanChooseAvatar}" />
        <Text Text="{Binding AvatarResourceStatus}" TextWrapping="Wrap" />
        <Container Type="Vertical Stack" CellGap="8" Active="{Binding ShowAvatarChooser}">
          <Text FontSize="18" FontWeight="SemiBold">Make it recognisable</Text>
          <Text Text="Choose an icon for this Assistant." TextWrapping="Wrap" />
          <Repeat Source="{Binding AvatarChoices}" As="avatar" Key="{Binding avatar.Id}">
            <Container Type="Horizontal Stack" Margin="0,0,0,8" CellGap="12">
              <Object Type="AssistantAvatar" Text="{Binding avatar.IconKey}" Width="44" Height="44" AccessibleName="{Binding avatar.Label}" />
              <Container Type="Vertical Stack" CellGap="4">
                <Button action="ChooseAssistantAvatar" Text="{Binding avatar.Label}" Interactive="{Binding CanSelectAvatar}" />
                <Text Text="{Binding avatar.Description}" TextWrapping="Wrap" />
              </Container>
            </Container>
          </Repeat>
          <Button action="assistants.avatar.cancel" Interactive="{Binding CanChooseAvatar}">Keep current icon</Button>
        </Container>
        <Text>Instructions</Text>
        <Input id="assistant-instructions" Type="Text" MinHeight="140" TextWrapping="Wrap" AccessibleName="Assistant instructions" PlaceholderText="Describe its role, preferences and how you would like it to work." Value="{Binding DraftInstructions, Mode=TwoWay}" Multiline="True" Interactive="{Binding CanEditConfiguration}" />
      </Container>
      <Container Type="Vertical Stack" CellGap="8">
        <Text FontSize="20" FontWeight="SemiBold">Models and capabilities</Text>
        <Text Text="{Binding ConfiguredModelLabel}" TextWrapping="Wrap" AccessibleName="Preferred model" />
        <Text Text="{Binding ConfigurationModelStatus}" TextWrapping="Wrap" />
        <Button id="configuration-refresh-models" action="assistants.configuration.models.read" Interactive="{Binding CanReadConfigurationModels}">Refresh available models</Button>
        <Repeat Source="{Binding ConfigurationModels}" As="model" Key="{Binding model.Id}">
          <Button action="ChoosePreferredModel" Text="{Binding model.Label}" Margin="0,0,0,4" Interactive="{Binding CanChooseConfiguredModel}" />
        </Repeat>
        <Text FontWeight="SemiBold">Reasoning</Text>
        <Repeat Source="{Binding EffortChoices}" As="effort" Key="{Binding effort.Id}">
          <Button action="ChooseEffort" Text="{Binding effort.Label}" Margin="0,0,0,4" Interactive="{Binding effort.CanChoose}" />
        </Repeat>
        <Input id="assistant-allow-cloud" Type="Checkbox" Content="Allow authorized cloud models" AccessibleName="Allow authorized cloud models" Checked="{Binding DraftAllowCloud, Mode=TwoWay}" Interactive="{Binding CanEditConfiguration}" />
        <Input id="assistant-allow-fallback" Type="Checkbox" Content="Allow configured fallback routing" AccessibleName="Allow configured fallback routing" Checked="{Binding DraftAllowFallback, Mode=TwoWay}" Interactive="{Binding CanEditConfiguration}" />
        <Text Text="Model and routing preferences do not grant access to a provider or override its existing policy." TextWrapping="Wrap" />
        <Text Text="{Binding EffectivePolicyLabel}" TextWrapping="Wrap" AccessibleName="Effective Assistant model and capability policy" />
        <Text FontWeight="SemiBold">Tools and connected Apps</Text>
        <Text Text="{Binding ConfigurationCapabilityStatus}" TextWrapping="Wrap" />
        <Button action="assistants.configuration.capabilities.read" Interactive="{Binding CanReadConfigurationCapabilities}">Review current Tools and Apps</Button>
        <Text Text="{Binding CapabilityInitializationStatus}" TextWrapping="Wrap" AccessibleName="Built-in Tools setup status" />
        <Button id="assistant-tools-setup-review" action="assistants.configuration.capabilities.setup.review" Interactive="{Binding CanReviewCapabilityInitialization}">Review built-in Tools setup</Button>
        <Button id="assistant-tools-setup-start" action="assistants.configuration.capabilities.setup.start" Interactive="{Binding CanStartCapabilityInitialization}">Request setup approval in Home</Button>
        <Text Text="Setup adds missing built-in Tools and preserves your existing choices. Home asks for separate approval; this does not grant permission to use a Tool." TextWrapping="Wrap" />
        <Container Type="Vertical Stack" Interactive="{Binding CanChooseConfigurationCapability}" CellGap="4">
          <Repeat Source="{Binding ConfigurationCapabilityRows}" As="capability" Key="{Binding capability.Id}">
            <Container Type="Vertical Stack" Margin="0,0,0,8" CellGap="4">
              <Text Text="{Binding capability.Name}" FontWeight="SemiBold" />
              <Text Text="{Binding capability.Description}" TextWrapping="Wrap" />
              <Text Text="{Binding capability.AvailabilityLabel}" TextWrapping="Wrap" />
              <Button action="ChooseCapabilityPreference" Interactive="{Binding capability.CanChoose}">Add this preference</Button>
            </Container>
          </Repeat>
        </Container>
        <Text Text="{Binding ConfiguredToolPreferences}" TextWrapping="Wrap" AccessibleName="Configured tool preferences" />
        <Text Text="{Binding ConfiguredAppPreferences}" TextWrapping="Wrap" AccessibleName="Configured connected App preferences" />
        <Text Text="Save configuration to keep these preferences. Each use still checks current model support, runtime availability and approval." TextWrapping="Wrap" />
        <Repeat Source="{Binding ConfigurationSettings}" As="setting" Key="{Binding setting.Id}">
          <Container Type="Vertical Stack" Margin="0,0,0,8" CellGap="4">
            <Text Text="{Binding setting.Category}" FontWeight="SemiBold" />
            <Button action="ChooseSetting" Text="{Binding setting.ChoiceLabel}" Interactive="{Binding setting.CanChoose}" />
            <Text Text="{Binding setting.AvailabilityLabel}" TextWrapping="Wrap" />
          </Container>
        </Repeat>
      </Container>
      <Container Type="Vertical Stack" CellGap="8">
        <Text FontSize="20" FontWeight="SemiBold">Memory</Text>
        <Input id="assistant-memory-enabled" Type="Checkbox" Content="Use this Assistant's own saved memories" AccessibleName="Enable Assistant memory" Checked="{Binding DraftMemoryEnabled, Mode=TwoWay}" Interactive="{Binding CanEditMemoryPreferences}" />
        <Input id="assistant-memory-project-context" Type="Checkbox" Content="Request project context for memory" AccessibleName="Request project memory context" Checked="{Binding DraftMemoryIncludeProjectContext, Mode=TwoWay}" Interactive="{Binding CanEditMemoryPreferences}" />
        <Text Text="{Binding MemoryPreferenceStatus}" TextWrapping="Wrap" AccessibleName="Memory preference status" />
        <Text Text="{Binding MemoryPreferenceAvailability}" TextWrapping="Wrap" AccessibleName="Memory availability" />
        <Text Text="Allow local UCML categories" FontWeight="SemiBold" />
        <Text Text="Enter exact category names, one per line or separated by commas. Categories absent from both lists are denied. To revoke one, remove it and save. A category can appear in only one list. Importing a file never adds categories." TextWrapping="Wrap" />
        <Input id="assistant-ucml-categories" Type="Text" Multiline="True" MinHeight="70" AccessibleName="Allowed local UCML categories" PlaceholderText="For example: communication, study" Value="{Binding DraftUcmlCategories, Mode=TwoWay}" Interactive="{Binding CanEditMemoryPreferences}" />
        <Text Text="Ask before each use" FontWeight="SemiBold" />
        <Input id="assistant-ucml-ask-categories" Type="Text" Multiline="True" MinHeight="70" AccessibleName="UCML categories requiring a Home decision" PlaceholderText="Exact categories to review in Home before disclosure" Value="{Binding DraftUcmlAskCategories, Mode=TwoWay}" Interactive="{Binding CanEditMemoryPreferences}" />
        <Input id="assistant-ucml-expiry" Type="Text" AccessibleName="UCML access expiry in UTC" PlaceholderText="Optional UTC expiry: 2027-01-01T00:00:00Z" Value="{Binding DraftUcmlExpiry, Mode=TwoWay}" Interactive="{Binding CanEditMemoryPreferences}" />
        <Text Text="{Binding UcmlPreferenceError}" TextWrapping="Wrap" Active="{Binding HasUcmlPreferenceError}" />
        <Text Text="{Binding UcmlPreferenceStatus}" TextWrapping="Wrap" />
        <Text Text="Save these preferences to apply them. Home still controls access; adding or changing memories needs a separate approval. Turning memory off keeps existing memories and conversation history." TextWrapping="Wrap" />
      </Container>
      <Container Type="Vertical Stack" CellGap="8">
        <Text FontSize="20" FontWeight="SemiBold">Resources and access</Text>
        <Text Text="Files, projects and services keep their existing permissions. Choose only the resources this Assistant needs." TextWrapping="Wrap" />
        <Repeat Source="{Binding Resources}" As="resource" Key="{Binding resource.Id}">
          <Container Type="Vertical Stack" Margin="0,0,0,8" CellGap="4">
            <Text Text="{Binding resource.Name}" FontWeight="SemiBold" />
            <Text Text="{Binding resource.AvailabilityLabel}" TextWrapping="Wrap" />
            <Button action="ReviewResource" Interactive="{Binding resource.CanReview}">Review access</Button>
          </Container>
        </Repeat>
        <Text Text="{Binding ConfigurationProjectStatus}" TextWrapping="Wrap" />
        <Repeat Source="{Binding ConfiguredDevelopmentProjects}" As="project" Key="{Binding project.Id}">
          <Container Type="Vertical Stack" Margin="0,0,0,8" CellGap="4">
            <Text Text="{Binding project.Name}" FontWeight="SemiBold" />
            <Text Text="{Binding project.AvailabilityLabel}" TextWrapping="Wrap" />
            <Button action="ReviewConfiguredProject" Interactive="{Binding CanReviewConfiguredProject}">Review current project access</Button>
          </Container>
        </Repeat>
        <Button action="assistants.resources.add" Interactive="{Binding CanAddResource}">Choose development project</Button>
      </Container>
      <Container Type="Vertical Stack" CellGap="8">
        <Text FontSize="20" FontWeight="SemiBold">Check-ins and scheduled work</Text>
        <Input id="assistant-proactivity-enabled" Type="Checkbox" Content="Opt in to proactive contact" AccessibleName="Opt in to proactive contact" Checked="{Binding DraftProactivityEnabled, Mode=TwoWay}" Interactive="{Binding CanEditProactivityPreferences}" />
        <Input id="assistant-proactivity-check-ins" Type="Checkbox" Content="Allow supported check-ins" AccessibleName="Allow supported check-ins" Checked="{Binding DraftAllowCheckIns, Mode=TwoWay}" Interactive="{Binding CanEditProactivityPreferences}" />
        <Input id="assistant-proactivity-contact" Type="Checkbox" Content="Allow supported triggers to start a conversation" AccessibleName="Allow proactive conversations" Checked="{Binding DraftAllowUnsolicitedContact, Mode=TwoWay}" Interactive="{Binding CanEditProactivityPreferences}" />
        <Input id="assistant-proactivity-notifications" Type="Checkbox" Content="Prefer notifications inside 9to1" AccessibleName="Prefer in-app notifications" Checked="{Binding DraftNotifyInApp, Mode=TwoWay}" Interactive="{Binding CanEditProactivityPreferences}" />
        <Text FontWeight="SemiBold">Requested events</Text>
        <Input id="assistant-proactivity-completed" Type="Checkbox" Content="When a Task finishes" AccessibleName="Request Task completion check-ins" Checked="{Binding DraftEventTaskCompleted, Mode=TwoWay}" Interactive="{Binding CanEditProactivityPreferences}" />
        <Input id="assistant-proactivity-attention" Type="Checkbox" Content="When a Task needs your attention" AccessibleName="Request Task attention check-ins" Checked="{Binding DraftEventTaskNeedsAttention, Mode=TwoWay}" Interactive="{Binding CanEditProactivityPreferences}" />
        <Text Text="{Binding ProactivityStatus}" TextWrapping="Wrap" AccessibleName="Proactivity availability" />
        <Text Text="{Binding ProactivityResourceStatus}" TextWrapping="Wrap" />
        <Button action="assistants.proactivity.configure" Interactive="{Binding CanConfigureProactivity}">Manage check-ins and schedules</Button>
        <Text Text="Contact preferences do not grant additional file, account or computer access." TextWrapping="Wrap" />
      </Container>
      <Container Type="Vertical Stack" CellGap="12">
        <Button id="assistant-save" action="assistants.configuration.save" Text="{Binding SaveConfigurationLabel}" Interactive="{Binding CanSaveConfiguration}" />
        <Button id="assistant-discard-draft" action="assistants.configuration.discard" Interactive="{Binding CanDiscardConfiguration}">Discard changes</Button>
      </Container>
    </Container>
  </Page>
</Cui>
