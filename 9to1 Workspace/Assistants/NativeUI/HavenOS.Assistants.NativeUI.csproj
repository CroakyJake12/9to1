    <AssemblyName>HavenOS.Assistants.NativeUI</AssemblyName>
    <RootNamespace>HavenOS.Apps.Assistants.NativeUI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HavenOS.Assistants.Core.csproj" />
