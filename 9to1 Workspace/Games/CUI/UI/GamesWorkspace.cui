<Cui id="9to1.Games.Workspace" version="1">
  <Grid rows="Auto,*,Auto" accessible-name="Games editor">
    <StackPanel orientation="Horizontal" spacing="8">
      <Button action="9to1.Games.Open" is-enabled="{Binding CanOpen}" content="Open selected project" accessible-name="Open Games project selected in Files" />
      <Button action="9to1.Games.Development" is-enabled="{Binding CanWorkspace}" content="Development" accessible-name="Switch to Development workspace" />
      <Button action="9to1.Games.CreationRendering" is-enabled="{Binding CanWorkspace}" content="Creation and rendering" accessible-name="Switch to Creation and rendering workspace" />
      <Button action="9to1.Games.Observe" is-enabled="{Binding CanObserve}" content="Inspect native scene" accessible-name="Observe canonical scene in Godot" />
    </StackPanel>
    <Grid grid-row="1" columns="*,*" margin="16">
      <StackPanel spacing="8" accessible-name="Scene graph">
        <TextBlock text="{Binding Workspace}" accessible-name="Current workspace" />
        <TextBlock text="{Binding Project}" accessible-name="Canonical project identity" />
        <TextBlock text="{Binding Scene}" accessible-name="Canonical scene identity" />
        <TextBlock text="{Binding Node}" accessible-name="Selected node name" />
        <TextBlock text="{Binding NodeIdentity}" accessible-name="Selected canonical node identity" />
        <Button action="9to1.Games.NextNode" is-enabled="{Binding CanSelect}" content="Next node" accessible-name="Select next scene node" />
      </StackPanel>
      <StackPanel grid-column="1" spacing="8" accessible-name="Node inspector">
        <TextBox text="{Binding PositionX, Mode=TwoWay}" is-enabled="{Binding CanEdit}" accessible-name="Position X" />
        <TextBox text="{Binding PositionY, Mode=TwoWay}" is-enabled="{Binding CanEdit}" accessible-name="Position Y" />
        <TextBox text="{Binding PositionZ, Mode=TwoWay}" is-enabled="{Binding CanEdit}" accessible-name="Position Z" />
        <Button action="9to1.Games.SetPosition" is-enabled="{Binding CanEdit}" content="Apply position" accessible-name="Save node position to canonical Games project" />
      </StackPanel>
    </Grid>
    <TextBlock grid-row="2" text="{Binding Status}" accessible-name="Games operation status" />
  </Grid>
</Cui>
