<Cui id="ui-insertsheet" product="9-1" version="1">
  <Container id="insert-sheet-dialog" Type="Vertical Stack" modal="True" focusable="false">
    <Text id="insert-sheet-dialog-label" text="Insert Sheet" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="2" focusable="false">
      <Container id="dialog-action-area1" Type="Horizontal Stack" focusable="false">
        <Button id="ok" content="OK" text="OK" />
        <Button id="cancel" content="Cancel" text="Cancel" />
        <Button id="help" content="Help" text="Help" />
      </Container>
      <Container id="box1" Type="Vertical Stack" cell-gap="12" focusable="false" role="Grow">
        <Container id="frame1" Type="Vertical Stack" focusable="false" role="Grow">
          <Container id="box2" Type="Vertical Stack" cell-gap="6" focusable="false">
            <Input id="before" Type="Radio" text="Before current sheet" checked="true" />
            <Input id="after" Type="Radio" text="After current sheet" />
          </Container>
          <Text id="label1" text="Position" focusable="false" />
        </Container>
        <Container id="frame2" Type="Vertical Stack" focusable="false" role="Grow">
          <Container id="box3" Type="Vertical Stack" cell-gap="6" focusable="false" role="Grow">
            <Container id="box4" Type="Vertical Stack" cell-gap="6" focusable="false" role="Grow">
              <Input id="new" Type="Radio" text="New sheet" checked="true" />
              <Container id="grid1" Type="Grid" cell-gap="6" focusable="false" role="Grow">
                <Text id="countft" text="No. of sheets:" focusable="false" column="0" row="0" />
                <Text id="nameft" text="Name:" focusable="false" column="0" row="1" />
                <Input id="countnf" Type="Number" horizontal-alignment="Left" column="1" row="0" />
                <Input id="nameed" Type="Text" text="Sheet..." role="Grow" column="1" row="1" />
              </Container>
            </Container>
            <Container id="box5" Type="Vertical Stack" cell-gap="6" focusable="false" role="Grow">
              <Input id="fromfile" Type="Radio" text="From file" />
              <Container id="grid2" Type="Grid" cell-gap="6" focusable="false" role="Grow">
                <Text id="path" focusable="false" column="0" row="1" column-span="2" />
                <Container id="container" Type="Vertical Stack" role="Grow" column="0" row="0">
                  <Container id="tables" Type="Vertical Stack" role="Grow" />
                </Container>
                <Container id="grid3" Type="Grid" cell-gap="12" focusable="false" column="1" row="0">
                  <Button id="browse" content="Browse..." text="Browse..." column="0" row="0" />
                  <Input id="link" Type="Checkbox" text="Link" vertical-alignment="Top" role="Grow" column="0" row="1" />
                </Container>
              </Container>
            </Container>
          </Container>
          <Text id="label2" text="Sheet" focusable="false" />
        </Container>
      </Container>
    </Container>
  </Container>
</Cui>
