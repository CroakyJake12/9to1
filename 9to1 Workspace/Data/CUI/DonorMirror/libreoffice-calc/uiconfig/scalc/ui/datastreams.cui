<Cui id="ui-datastreams" product="9-1" version="1">
  <Container id="data-stream-dialog" Type="Vertical Stack" modal="True">
    <Text id="data-stream-dialog-label" text="Live Data Streams" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12">
      <Container id="dialog-action-area1" Type="Horizontal Stack">
        <Button id="ok" content="OK" text="OK" />
        <Button id="cancel" content="Cancel" text="Cancel" />
        <Button id="help" content="Help" text="Help" />
      </Container>
      <Container id="dialog-vbox2" Type="Vertical Stack" cell-gap="6">
        <Container id="frame" Type="Vertical Stack">
          <Container id="box4" Type="Vertical Stack" cell-gap="6">
            <Container id="box12" Type="Vertical Stack" cell-gap="12" role="Grow">
              <Text id="label6" text="URL:" />
              <Input id="url" Type="Select" role="Grow">
                <Input id="urlbox-entry" Type="Text" />
              </Input>
              <Button id="browse" content="Browse..." text="Browse..." />
            </Container>
            <Container id="frame4" Type="Vertical Stack">
              <Container id="grid2" Type="Grid">
                <Input id="valuesinline" Type="Radio" text="value1,value2,...,valueN, and fill into range:" checked="true" />
                <Input id="addressvalue" Type="Radio" text="address,value" />
                <Input id="range" Type="Text" role="Grow" />
              </Container>
              <Text id="label4" text="Interpret stream data as" />
            </Container>
            <Input id="refresh-ui" Type="Checkbox" text="Empty lines trigger UI refresh" checked="true" />
          </Container>
          <Text id="label" text="Source Stream" />
        </Container>
        <Container id="box3" Type="Vertical Stack" cell-gap="6" role="Grow">
          <Container id="framemove" Type="Vertical Stack">
            <Container id="box1" Type="Vertical Stack" cell-gap="6">
              <Input id="datadown" Type="Radio" text="Move existing data down" />
              <Input id="rangedown" Type="Radio" text="Move the range down" checked="true" />
              <Input id="nomove" Type="Radio" text="Overwrite existing data" />
            </Container>
            <Text id="label2" text="When New Data Arrives" />
          </Container>
          <Container id="framelimit" Type="Vertical Stack">
            <Container id="grid3" Type="Grid" role="Grow">
              <Input id="maxlimit" Type="Radio" text="Limit to:" checked="true" />
              <Input id="limit" Type="Text" text="1000" role="Grow" />
              <Input id="unlimited" Type="Radio" text="Unlimited" vertical-alignment="Top" />
            </Container>
            <Text id="label3" text="Maximal Amount of Rows" />
          </Container>
        </Container>
      </Container>
    </Container>
  </Container>
</Cui>
