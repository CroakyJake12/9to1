<Cui id="ui-fourieranalysisdialog" product="9-1" version="1">
  <Container id="fourier-analysis-dialog" Type="Vertical Stack" focusable="false">
    <Text id="fourier-analysis-dialog-label" text="Fourier Analysis" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12" focusable="false">
      <Container id="dialog-action-area1" Type="Horizontal Stack" focusable="false">
        <Button id="ok" content="OK" text="OK" />
        <Button id="cancel" content="Cancel" text="Cancel" />
        <Button id="help" content="Help" text="Help" />
      </Container>
      <Container id="framedata" Type="Vertical Stack" focusable="false">
        <Container id="grid1" Type="Grid" cell-gap="6" focusable="false">
          <Text id="input-range-label" text="Input range:" focusable="false" column="0" row="0" />
          <Input id="input-range-edit" Type="Text" vertical-alignment="Center" role="Grow" column="1" row="0" />
          <Button id="input-range-button" column="2" row="0" />
          <Text id="output-range-label" text="Results to:" focusable="false" column="0" row="1" />
          <Input id="output-range-edit" Type="Text" vertical-alignment="Center" role="Grow" column="1" row="1" />
          <Button id="output-range-button" column="2" row="1" />
          <Input id="withlabels-check" Type="Checkbox" text="Input range has label" horizontal-alignment="Left" column="0" row="2" column-span="2" />
        </Container>
        <Text id="label1" text="Data" focusable="false" />
      </Container>
      <Container id="frame2" Type="Vertical Stack" focusable="false">
        <Container id="grid2" Type="Grid" cell-gap="6" focusable="false">
          <Input id="groupedby-columns-radio" Type="Radio" text="Columns" checked="true" column="0" row="0" />
          <Input id="groupedby-rows-radio" Type="Radio" text="Rows" column="1" row="0" />
        </Container>
        <Text id="label2" text="Grouped by" focusable="false" />
      </Container>
      <Container id="frame3" Type="Vertical Stack" focusable="false">
        <Container id="container" Type="Grid" focusable="false">
          <Input id="inverse-check" Type="Checkbox" text="Inverse" horizontal-alignment="Left" vertical-alignment="Center" column="0" row="0" />
          <Input id="polar-check" Type="Checkbox" text="Output in polar form" horizontal-alignment="Left" vertical-alignment="Center" column="0" row="1" />
          <Text id="label4" text="Minimum magnitude for polar form output (in dB)" text-wrapping="Wrap" vertical-alignment="Center" focusable="false" column="0" row="2" />
          <Input id="minmagnitude-spin" Type="Number" column="1" row="2" />
        </Container>
        <Text id="label3" text="Options" focusable="false" />
      </Container>
      <Text id="error-message" text-trimming="PathSegmentEllipsis" focusable="false" />
    </Container>
  </Container>
</Cui>
