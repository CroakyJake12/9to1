<Cui id="ui-pastespecial" product="9-1" version="1">
  <Page id="ui-pastespecial-root">
    <Image id="img-paste-formats" focusable="false" source="sc/res/pasteformatsonly.png" />
    <Image id="img-paste-transpose" focusable="false" source="sc/res/pastetranspose.png" />
    <Image id="img-paste-values-formats" focusable="false" source="sc/res/pastevaluesformats.png" />
    <Image id="img-paste-values-only" focusable="false" source="sc/res/pastevaluesonly.png" />
    <Container id="paste-special" Type="Vertical Stack" focusable="false">
      <Text id="paste-special-label" text="Paste Special" />
      <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12" focusable="false">
        <Container id="dialog-action-area1" Type="Horizontal Stack" focusable="false">
          <Button id="ok" content="OK" text="OK" />
          <Button id="cancel" content="Cancel" text="Cancel" />
          <Button id="help" content="Help" text="Help" />
        </Container>
        <Container id="grid1" Type="Grid" cell-gap="6" focusable="false">
          <Container id="frm-presets" Type="Vertical Stack" vertical-alignment="Top" focusable="false" role="Grow" column="0" row="0">
            <Container id="container" Type="Vertical Stack" cell-gap="6" focusable="false">
              <Container id="container-2" Type="Vertical Stack" cell-gap="6" focusable="false">
                <Button id="paste-values-only" content="Values Only" text="Values Only" tooltip="Values Only" />
                <Button id="paste-values-formats" content="Values &amp; Formats" text="Values &amp; Formats" tooltip="Values &amp; Formats" />
                <Button id="paste-formats" content="Formats Only" text="Formats Only" tooltip="Formats Only" />
                <Button id="paste-transpose" content="Transpose All" text="Transpose All" tooltip="Transpose All" />
              </Container>
              <Input id="cb-immediately" Type="Checkbox" text="Run immediately" checked="true" role="Grow" />
            </Container>
            <Text id="text" text="Presets" focusable="false" />
          </Container>
          <Container id="container-3" Type="Vertical Stack" vertical-alignment="Top" focusable="false" column="1" row="0">
            <Container id="frm-paste" Type="Vertical Stack" focusable="false" role="Grow">
              <Container id="container-4" Type="Grid" cell-gap="6" focusable="false">
                <Input id="paste-all" Type="Checkbox" text="All" column="0" row="0" />
                <Input id="numbers" Type="Checkbox" text="Numbers" column="0" row="1" />
                <Input id="text-2" Type="Checkbox" text="Text" column="0" row="2" />
                <Input id="datetime" Type="Checkbox" text="Date &amp; time" column="0" row="3" />
                <Input id="formats" Type="Checkbox" text="Formats" column="0" row="4" />
                <Input id="comments" Type="Checkbox" text="Comments" column="0" row="5" />
                <Input id="objects" Type="Checkbox" text="Objects" column="0" row="6" />
                <Input id="formulas" Type="Checkbox" text="Formulas" column="0" row="7" />
              </Container>
              <Text id="label1" text="Paste" focusable="false" />
            </Container>
            <Container id="frm-shift" Type="Vertical Stack" focusable="false" role="Grow">
              <Container id="box2" Type="Vertical Stack" cell-gap="3" focusable="false">
                <Input id="no-shift" Type="Radio" text="Don't shift" checked="true" />
                <Input id="move-down" Type="Radio" text="Down" />
                <Input id="move-right" Type="Radio" text="Right" />
              </Container>
              <Text id="label4" text="Shift Cells" focusable="false" />
            </Container>
          </Container>
          <Container id="container-5" Type="Vertical Stack" vertical-alignment="Top" focusable="false" column="2" row="0">
            <Container id="frm-options" Type="Vertical Stack" focusable="false" role="Grow">
              <Container id="container-6" Type="Grid" cell-gap="6" focusable="false">
                <Input id="link" Type="Checkbox" text="As Link" column="0" row="0" />
                <Input id="transpose" Type="Checkbox" text="Transpose" column="0" row="1" />
                <Input id="skip-empty" Type="Checkbox" text="Skip empty cells" tooltip="If enabled, blank cells in source will not override the target." column="0" row="2" />
              </Container>
              <Text id="text-3" text="Options" focusable="false" />
            </Container>
            <Container id="frm-operations" Type="Vertical Stack" focusable="false" role="Grow">
              <Container id="box4" Type="Vertical Stack" cell-gap="3" focusable="false">
                <Input id="none" Type="Radio" text="None" checked="true" />
                <Input id="add" Type="Radio" text="Add" />
                <Input id="subtract" Type="Radio" text="Subtract" />
                <Input id="multiply" Type="Radio" text="Multiply" />
                <Input id="divide" Type="Radio" text="Divide" />
              </Container>
              <Text id="label2" text="Operations" focusable="false" />
            </Container>
          </Container>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
