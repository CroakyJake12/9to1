<Cui id="ui-optdefaultpage" product="9-1" version="1">
  <Container id="opt-default-page" Type="Vertical Stack" focusable="false">
    <Container id="frame1" Type="Vertical Stack" focusable="false">
      <Container id="grid2" Type="Grid" cell-gap="6" focusable="false">
        <Image id="locksheetsnumber" horizontal-alignment="Center" vertical-alignment="Center" focusable="false" column="0" row="0" source="res/lock.png" />
        <Text id="textsheetsnumber" text="Number of worksheets in new document:" focusable="false" column="1" row="0" />
