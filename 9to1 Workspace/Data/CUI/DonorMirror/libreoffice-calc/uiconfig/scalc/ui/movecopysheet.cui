<Cui id="ui-movecopysheet" product="9-1" version="1">
  <Container id="move-copy-sheet-dialog" Type="Vertical Stack" modal="True">
    <Text id="move-copy-sheet-dialog-label" text="Move/Copy Sheet" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12">
      <Container id="dialog-action-area1" Type="Horizontal Stack">
        <Button id="help" content="Help" text="Help" />
        <Button id="ok" content="OK" text="OK" />
        <Button id="cancel" content="Cancel" text="Cancel" />
      </Container>
      <Container id="action" Type="Vertical Stack">
        <Container id="box1" Type="Vertical Stack">
          <Input id="move" Type="Radio" text="Move" checked="true" role="Grow" />
          <Input id="copy" Type="Radio" text="Copy" role="Grow" />
        </Container>
        <Text id="label1" text="Action" />
      </Container>
      <Container id="location" Type="Vertical Stack" role="Grow">
        <Container id="box2" Type="Vertical Stack" cell-gap="12" role="Grow">
          <Container id="box3" Type="Vertical Stack" cell-gap="6">
            <Text id="to-document-label" text="To document" />
            <Input id="to-document" Type="Select" />
          </Container>
          <Container id="box4" Type="Vertical Stack" cell-gap="6" role="Grow">
            <Text id="insert-before-label" text="Insert before" />
            <Container id="scrolledwindow1" Type="Vertical Stack" role="Grow">
              <Container id="insert-before" Type="Vertical Stack" role="Grow" />
            </Container>
          </Container>
        </Container>
        <Text id="label2" text="Location" />
      </Container>
      <Container id="new-name-frame" Type="Vertical Stack">
        <Container id="box5" Type="Vertical Stack">
          <Container id="box6" Type="Vertical Stack" cell-gap="6">
            <Input id="new-name" Type="Text" />
            <Text id="new-name-warn" vertical-alignment="Top" />
            <Text id="warnunused" text="This name is already used." vertical-alignment="Top" />
            <Text id="warnempty" text="Name is empty." vertical-alignment="Top" />
            <Text id="warninvalid" text="Name contains one or more invalid characters." vertical-alignment="Top" />
          </Container>
        </Container>
        <Text id="new-name-label" text="New name" />
      </Container>
    </Container>
  </Container>
</Cui>
