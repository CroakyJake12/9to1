<Cui id="ui-retypepassworddialog" product="9-1" version="1">
  <Container id="retype-password-dialog" Type="Vertical Stack" modal="True" focusable="false">
    <Text id="retype-password-dialog-label" text="Re-type Password" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12" focusable="false">
      <Container id="dialog-action-area1" Type="Horizontal Stack" focusable="false">
        <Button id="ok" content="OK" text="OK" />
        <Button id="cancel" content="Cancel" text="Cancel" />
        <Button id="help" content="Help" text="Help" />
      </Container>
      <Container id="box1" Type="Vertical Stack" cell-gap="6" focusable="false" role="Grow">
        <Input id="retypepassword" Type="Radio" text="Re-type password" checked="true" />
        <Container id="passwordgrid" Type="Grid" cell-gap="6" focusable="false" role="Grow">
          <Input id="newpass-entry" Type="Text" role="Grow" column="1" row="0" />
          <Input id="confirmpass-entry" Type="Text" role="Grow" column="1" row="1" />
          <Text id="label4" text="Password:" focusable="false" column="0" row="0" />
          <Text id="label5" text="Confirm:" focusable="false" column="0" row="1" />
          <Input id="mustmatch" Type="Checkbox" text="New password must match the original password" column="0" row="2" column-span="2" />
        </Container>
        <Input id="removepassword" Type="Radio" text="Remove password from this protected item" />
      </Container>
    </Container>
  </Container>
</Cui>
