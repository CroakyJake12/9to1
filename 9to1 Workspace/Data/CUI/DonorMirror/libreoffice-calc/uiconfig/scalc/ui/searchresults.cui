      <Container id="container" Type="Vertical Stack" role="Grow">
        <Container id="results" Type="Vertical Stack" role="Grow" />
      </Container>
      <Text id="lb-search-results" horizontal-alignment="Left" focusable="false" />
    </Container>
  </Container>
</Cui>
