          <Input id="field3" Type="Select" />
          <Input id="cond1" Type="Select" />
          <Input id="cond2" Type="Select" />
          <Input id="cond3" Type="Select" />
          <Input id="val1" Type="Select" role="Grow">
            <Input id="comboboxtext-entry2" Type="Text" />
          </Input>
          <Input id="val2" Type="Select" role="Grow">
            <Input id="comboboxtext-entry4" Type="Text" />
