<Cui id="ui-conflictsdialog" product="9-1" version="1">
  <Container id="conflicts-dialog" Type="Vertical Stack" focusable="false">
    <Text id="conflicts-dialog-label" text="Resolve Conflicts" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12" focusable="false">
      <Container id="dialog-action-area1" Type="Horizontal Stack" focusable="false">
        <Button id="keepallmine" content="Keep All Mine" text="Keep All Mine" />
        <Button id="keepallothers" content="Keep All Others" text="Keep All Others" />
        <Button id="cancel" content="Cancel" text="Cancel" />
        <Button id="help" content="Help" text="Help" />
      </Container>
      <Container id="box1" Type="Vertical Stack" cell-gap="6" focusable="false" role="Grow">
        <Text id="label1" text="There are conflicting changes in this shared spreadsheet. Conflicts must be resolved before saving the spreadsheet. Keep either own or other changes." text-wrapping="Wrap" horizontal-alignment="Left" focusable="false" />
        <Container id="container" Type="Vertical Stack" role="Grow">
          <Container id="container-2" Type="Vertical Stack" role="Grow" />
        </Container>
        <Container id="buttonbox1" Type="Horizontal Stack" cell-gap="6" focusable="false">
          <Button id="keepmine" content="Keep Mine" text="Keep Mine" />
          <Button id="keepother" content="Keep Other" text="Keep Other" />
        </Container>
      </Container>
    </Container>
  </Container>
</Cui>
