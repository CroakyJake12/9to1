        <Input id="cell-link-cb" Type="Checkbox" text="Insert hyperlink for the cell, not for the text in the cell." tooltip="By default, Excel allows only one hyperlink per cell. (Works only if Excel file format is used.)" column="1" row="0" column-span="2" />
        <Image id="lockcell-link-cb" horizontal-alignment="Center" vertical-alignment="Center" focusable="false" column="0" row="0" source="res/lock.png" />
