<Cui id="ui-optcompatibilitypage" product="9-1" version="1">
  <Container id="opt-compatibility-page" Type="Vertical Stack" cell-gap="12" focusable="false">
    <Container id="frame1" Type="Vertical Stack" focusable="false" role="Grow">
      <Container id="grid1" Type="Grid" cell-gap="6" focusable="false" role="Grow">
        <Text id="label2" text="Select desired key binding type. Changing the key binding type may overwrite some of the existing key bindings." text-wrapping="Wrap" focusable="false" role="Grow" column="1" row="0" />
        <Input id="keybindings" Type="Select" vertical-alignment="Top" focusable="false" column="2" row="0" />
        <Image id="lockkeybindings" horizontal-alignment="Center" vertical-alignment="Center" focusable="false" column="0" row="0" source="res/lock.png" />
