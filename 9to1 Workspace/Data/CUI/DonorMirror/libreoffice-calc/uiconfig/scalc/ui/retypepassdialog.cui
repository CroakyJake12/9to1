<Cui id="ui-retypepassdialog" product="9-1" version="1">
  <Container id="retype-pass" Type="Vertical Stack" modal="True" focusable="false" role="Grow">
    <Text id="retype-pass-label" text="Re-type Password" />
    <Container id="dialog-vbox1" Type="Vertical Stack" cell-gap="12" focusable="false" role="Grow">
      <Container id="dialog-action-area1" Type="Horizontal Stack" focusable="false">
        <Button id="ok" content="OK" text="OK" />
        <Button id="cancel" content="Cancel" text="Cancel" />
        <Button id="help" content="Help" text="Help" />
      </Container>
      <Container id="box1" Type="Vertical Stack" cell-gap="12" focusable="false" role="Grow">
        <Text id="desc-label" text="The document you are about to export has one or more protected items with password that cannot be exported. Please re-type your password to be able to export your document." text-wrapping="Wrap" horizontal-alignment="Left" focusable="false" />
        <Container id="frame1" Type="Vertical Stack" focusable="false">
          <Container id="box2" Type="Vertical Stack" cell-gap="6" focusable="false">
            <Text id="doc-status-label" text="Status unknown" focusable="false" />
            <Button id="retype-doc-button" content="Re-type" text="Re-type" />
          </Container>
          <Text id="label2" text="Document Protection" focusable="false" />
        </Container>
        <Container id="frame2" Type="Vertical Stack" focusable="false" role="Grow">
          <Container id="scrolledwindow" Type="Vertical Stack" focusable="false" role="Grow">
            <Container id="viewport1" Type="Vertical Stack" focusable="false">
              <Container id="sheets-box" Type="Vertical Stack" cell-gap="6" focusable="false" role="Grow" />
            </Container>
          </Container>
          <Text id="label3" text="Sheet Protection" focusable="false" />
        </Container>
      </Container>
    </Container>
  </Container>
</Cui>
