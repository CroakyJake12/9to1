<Cui id="ui-navigatorpanel" product="9-1" version="1">
  <Page id="ui-navigatorpanel-root">
    <Container id="dragmodemenu" Type="Menu" focusable="false">
      <Button id="hyperlink" content="Insert as Hyperlink" text="Insert as Hyperlink" focusable="false" checked="true" />
      <Button id="link" content="Insert as Link" text="Insert as Link" focusable="false" />
      <Button id="copy" content="Insert as Copy" text="Insert as Copy" focusable="false" />
    </Container>
    <Container id="navigator-panel" Type="Grid" focusable="false" role="Grow">
      <Container id="container" Type="Grid" cell-gap="6" focusable="false" role="Grow" column="0" row="0">
        <Container id="gridbuttons" Type="Grid" cell-gap="3" focusable="false" role="Grow" column="0" row="0">
          <Text id="label1" text="Column:" horizontal-alignment="Left" focusable="false" column="0" row="0" />
          <Text id="label2" text="Row:" horizontal-alignment="Left" focusable="false" column="0" row="1" />
          <Input id="column" Type="Number" tooltip="Column" role="Grow" column="1" row="0" />
          <Input id="row" Type="Number" tooltip="Row" role="Grow" column="1" row="1" />
          <Container id="toolbox1" Type="Horizontal Stack" column="2" row="0">
            <Button id="datarange" icon-source="sc/res/na03.png" tooltip="Data Range" />
            <Button id="start" icon-source="sc/res/na05.png" tooltip="Start" />
            <Button id="end" icon-source="sc/res/na06.png" tooltip="End" />
            <Button id="contents" icon-source="sc/res/na011.png" tooltip="Contents" />
          </Container>
          <Container id="toolbox2" Type="Horizontal Stack" column="2" row="1">
            <Button id="toggle" icon-source="sc/res/na010.png" tooltip="Toggle" />
            <Button id="scenarios" icon-source="sc/res/na07.png" tooltip="Scenarios" />
            <Button id="dragmode" icon-source="sc/res/na09.png" tooltip="Drag Mode" />
          </Container>
        </Container>
        <Input id="documents" Type="Select" tooltip="Open Documents" column="0" row="3" />
        <Container id="container-2" Type="Vertical Stack" role="Grow" column="0" row="1">
          <Container id="contentbox" Type="Vertical Stack" width="-1" role="Grow" />
        </Container>
        <Container id="scenariobox" Type="Vertical Stack" cell-gap="6" focusable="false" role="Grow" column="0" row="2">
          <Container id="container-3" Type="Vertical Stack" role="Grow">
            <Container id="scenariolist" Type="Vertical Stack" width="-1" role="Grow" />
          </Container>
          <Container id="container-4" Type="Vertical Stack">
            <Input id="scenariotext" Type="Text" />
          </Container>
        </Container>
      </Container>
    </Container>
  </Page>
</Cui>
