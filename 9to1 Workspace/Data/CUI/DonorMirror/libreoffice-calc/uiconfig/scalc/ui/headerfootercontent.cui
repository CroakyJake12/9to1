          <Button id="button-btn-table" tooltip="Sheet Name" />
          <Button id="button-btn-page" tooltip="Page" />
          <Button id="button-btn-pages" tooltip="Pages" />
          <Button id="button-btn-date" tooltip="Date" />
          <Button id="button-btn-time" tooltip="Time" />
        </Container>
        <Text id="label-ft-field" text="Field" focusable="false" column="0" row="1" />
      </Container>
      <Container id="areagrid" Type="Grid" cell-gap="12" focusable="false">
        <Text id="label-ft-left" text="Left area" focusable="false" column="0" row="0" />
        <Text id="label-ft-center" text="Center area" focusable="false" column="1" row="0" />
        <Text id="label-ft-right" text="Right area" focusable="false" column="2" row="0" />
        <Container id="scrolledwindow-left" Type="Vertical Stack" column="0" row="1">
          <Container id="container-3" Type="Vertical Stack" focusable="false">
            <Container id="textview-wnd-left" Type="Overlay" />
