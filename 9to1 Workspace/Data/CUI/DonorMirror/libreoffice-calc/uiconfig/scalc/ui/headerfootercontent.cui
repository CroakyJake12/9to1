<Cui id="ui-headerfootercontent" product="9-1" version="1">
  <Page id="ui-headerfootercontent-root">
    <Image id="image-btn-bold" focusable="false" source="cmd/lcbold.png" />
    <Image id="image-btn-date" focusable="false" source="sc/res/date.png" />
    <Image id="image-btn-file" focusable="false" source="sc/res/file.png" />
    <Image id="image-btn-italic" focusable="false" source="cmd/lcitalic.png" />
    <Image id="image-btn-page" focusable="false" source="sc/res/page.png" />
    <Image id="image-btn-pages" focusable="false" source="sc/res/pages.png" />
    <Image id="image-btn-table" focusable="false" source="sc/res/table.png" />
    <Image id="image-btn-text" focusable="false" source="sc/res/text.png" />
    <Image id="image-btn-time" focusable="false" source="sc/res/time.png" />
    <Image id="image-btn-underline" focusable="false" source="cmd/lcunderline.png" />
    <Container id="popup" Type="Menu" focusable="false">
