      <Button id="filename" Type="Menu Item" content="File Name" text="File Name" focusable="false" />
      <Button id="pathname" Type="Menu Item" content="Path/File Name" text="Path/File Name" focusable="false" />
    </Container>
    <Container id="header-footer-content" Type="Vertical Stack" cell-gap="6" focusable="false">
      <Container id="grid1" Type="Grid" cell-gap="12" focusable="false">
        <Input id="check-btn-enable-hf" Type="Checkbox" text="Enable" horizontal-alignment="Left" column="0" row="0" />
