<Cui id="home" product="9-1" version="1">
  <Actions>
    <Action name="ApplyHomeAppearanceOption" command="ApplyHomeAppearance" parameter="{Binding option.Target}" />
    <Action name="SelectHomeEvent" command="SelectEventObject" parameter="{Binding activity.EventId}" />
  </Actions>
  <Theme Name="user_preference">
    <Page>
      <Container id="home-root" background="{Resource CuiBackgroundBrush}" Type="Vertical Stack">
        <If Condition="{Binding IsNativeHomeShell, fallback=true}">
          <Container id="home-native-shell" Type="Vertical Stack">
          <Container id="top-bar" padding="24 16" background="{Resource CuiPanelBrush}" Type="Horizontal Stack">
            <Text id="brand" text="9-1" font-size="22" font-weight="Bold" foreground="{Resource CuiTextBrush}" margin="0 0 24 0" />
            <Input id="global-search" placeholder-text="Search 9-1" accessible-name="Search 9-1" width="360" margin="0 0 16 0" Type="Text" />
            <Button id="open-studio" action="OpenStudio" content="Open Studio" margin="0 0 8 0" />
            <Button id="install-all" action="InstallAllUpdates" content="Install updates" />
          </Container>
          <Container id="home-workspace-scroll" height="700" horizontal-scrolling="true" vertical-scrolling="true" Type="Overlay">
            <Container id="home-body" margin="24" Type="Horizontal Stack">
              <Container id="navigation-rail" background="{Resource CuiPanelBrush}" padding="14" width="176" margin="0 0 20 0" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1">
                <Container Type="Vertical Stack">
                  <Button id="nav-home" action="NavigateDashboard" content="Home" />
                  <Button id="nav-apps" action="NavigateApps" content="Apps" />
                  <Button id="nav-library" action="NavigateLibrary" content="Library" />
                  <Button id="nav-events" action="NavigateEvents" content="Events" />
                  <Button id="nav-discover" action="NavigateDiscover" content="Discover" />
                  <Button id="nav-mesh" action="NavigateMesh" content="Mesh" />
                  <Button id="nav-settings" action="NavigateSettings" content="Settings" />
                  <Button id="nav-permissions" action="NavigatePermissions" content="Permissions" />
                  <Button id="nav-notifications" action="NavigateNotifications" content="Notifications" />
                  <Button id="nav-spaces" action="NavigateSpaces" content="Spaces" />
                  <Button id="nav-automations" action="NavigateAutomations" content="Automations" />
                </Container>
              </Container>
              <Container id="home-content" Type="Vertical Stack">
                <If Condition="{Binding IsDashboard}">
                  <Container id="dashboard-page" Type="Vertical Stack">
                    <Text id="welcome-heading" text="Welcome to 9-1" font-size="32" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
                    <Container id="home-cake-account-entry" margin="0 8 0 12" Type="Vertical Stack">
                      <Button id="home-open-cake-account" action="OpenHomeCakeAccount" content="CAKE ID account" accessible-name="Open CAKE ID account" />
                      <Text text="{Binding CakeAccountStatus, fallback=Account connection requires the native Home client}" foreground="{Resource CuiTextSoftBrush}" />
                    </Container>
                    <Text id="welcome-copy" text="Your day across 9-1" font-size="15" foreground="{Resource CuiTextSoftBrush}" margin="0 6 0 18" />
                    <Container id="dashboard-brief" margin="0 0 0 18" Type="Vertical Stack">
                      <Text text="Your briefing" font-size="20" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" />
                      <Text id="dashboard-brief-status" text="{Binding BriefSummary, fallback=Your authorised activity will appear here}" foreground="{Resource CuiTextSoftBrush}" margin="0 6 0 12" />
                      <Input id="dashboard-tiles" height="140" margin="0 0 0 8" Type="List" />
                    </Container>
                    <Container id="home-hero" background="{Resource CuiPanel2Brush}" corner-radius="14" padding="24" margin="0 0 18 0" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1">
                      <Container Type="Horizontal Stack">
                        <Container width="420" Type="Vertical Stack">
                          <Text text="Pick up where you left off" font-size="20" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" />
                          <Text text="Open a Space, manage your apps, or review what needs attention." foreground="{Resource CuiTextSoftBrush}" margin="0 8 0 16" />
                          <Button id="open-spaces" action="NavigateSpaces" content="Open Spaces" width="132" />
                        </Container>
                        <Container id="observed-status" margin="24 0 0 0" Type="Vertical Stack">
                          <Text text="Apps" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" />
                          <Text id="catalog-status" text="{Binding CatalogSummary, fallback=App catalogue is not connected}" foreground="{Resource CuiTextSoftBrush}" margin="0 4 0 10" />
                          <Text text="Runtime" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" />
                          <Text id="runtime-status" text="{Binding RuntimeSummary, fallback=Runtime status is not connected}" foreground="{Resource CuiTextSoftBrush}" margin="0 4 0 0" />
                        </Container>
                      </Container>
                    </Container>
                    <Text id="operation-status" text="{Binding OperationSummary, fallback=Home services are not connected}" foreground="{Resource CuiTextSoftBrush}" margin="0 0 0 18" />
                    <Text id="navigation-status" text="{Binding NavigationStatus}" foreground="{Resource CuiTextSoftBrush}" margin="0 0 0 8" />
                    <Container id="app-shortcuts" Type="Vertical Stack">
                      <Container Type="Horizontal Stack">
                        <Text text="Quick access" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" />
                        <Button id="view-all-apps" action="NavigateApps" content="View all" margin="14 0 0 0" />
                      </Container>
                      <Container id="app-cards" margin="0 10 0 18" Type="Wrap">
                        <Button id="shortcut-write" action="OpenWrite" content="Write" width="148" height="58" margin="0 0 10 10" />
                        <Button id="shortcut-browse" action="OpenBrowse" content="Browse" width="148" height="58" margin="0 0 10 10" />
                        <Button id="shortcut-data" action="OpenData" content="Data" width="148" height="58" margin="0 0 10 10" />
                        <Button id="shortcut-boards" action="OpenBoards" content="Boards" width="148" height="58" margin="0 0 10 10" />
                      </Container>
                    </Container>
                    <Container id="upcoming-events" Type="Vertical Stack">
                      <Text text="Upcoming events" font-size="18" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" />
                      <Container id="events-card" background="{Resource CuiPanelBrush}" corner-radius="12" padding="14" margin="0 10 0 0" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1">
                        <Text id="events-status" text="{Binding EventsSummary, fallback=No upcoming events are available}" foreground="{Resource CuiTextSoftBrush}" />
                      </Container>
                    </Container>
                    <Container id="dashboard-layout-controls" background="{Resource CuiPanelBrush}" corner-radius="10" padding="14" margin="0 12 0 0" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1">
                      <Container Type="Vertical Stack">
                        <Text text="Dashboard controls" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" />
                        <Container margin="0 8 0 0" Type="Horizontal Stack">
                          <Button id="allow-ai-tiles" action="EnableAIGeneratedTiles" content="Allow AI tiles" margin="0 0 8 0" />
                          <Button id="disallow-ai-tiles" action="DisableAIGeneratedTiles" content="Keep AI tiles off" margin="0 0 8 0" />
                        </Container>
                        <Container Type="Horizontal Stack">
                          <Button id="allow-ai-reorder" action="EnableAIReorder" content="Allow AI rearrangement" margin="0 0 8 0" />
                          <Button id="disallow-ai-reorder" action="DisableAIReorder" content="Keep AI layout fixed" margin="0 0 8 0" />
                          <Button id="undo-ai-layout" action="UndoAiDashboardLayout" content="Undo AI layout" margin="0 0 8 0" />
                          <Button id="reset-dashboard-layout" action="ResetDashboardLayout" content="Reset layout" />
                        </Container>
                        <Text id="dashboard-tiles-summary" text="{Binding DashboardTilesSummary}" foreground="{Resource CuiTextSoftBrush}" margin="0 12 0 10" />
                        <Container Type="Horizontal Stack">
                          <Button id="add-dashboard-tile" action="AddDashboardTile" content="Add tile" margin="0 0 8 0" />
                          <Button id="remove-dashboard-tile" action="RemoveSelectedDashboardTile" content="Remove selected" margin="0 0 8 0" />
                          <Button id="move-dashboard-tile-up" action="MoveSelectedDashboardTileUp" content="Move up" margin="0 0 8 0" />
                          <Button id="move-dashboard-tile-down" action="MoveSelectedDashboardTileDown" content="Move down" margin="0 0 8 0" />
                          <Button id="pin-dashboard-tile" action="PinSelectedDashboardTile" content="Pin" margin="0 0 8 0" />
                          <Button id="unpin-dashboard-tile" action="UnpinSelectedDashboardTile" content="Unpin" margin="0 0 8 0" />
                          <Button id="lock-dashboard-tile" action="LockSelectedDashboardTile" content="Lock" margin="0 0 8 0" />
                          <Button id="unlock-dashboard-tile" action="UnlockSelectedDashboardTile" content="Unlock" margin="0 0 8 0" />
                          <Button id="hide-dashboard-tile" action="HideSelectedDashboardTile" content="Hide" margin="0 0 8 0" />
                          <Button id="show-dashboard-tile" action="ShowSelectedDashboardTile" content="Show" margin="0 0 8 0" />
                          <Button id="refresh-dashboard-tile" action="RefreshSelectedDashboardTile" content="Refresh selected" />
                        </Container>
                        <Container margin="0 8 0 0" Type="Horizontal Stack">
                          <Button id="resize-dashboard-tile-small" action="ResizeSelectedDashboardTileSmall" content="Small" margin="0 0 8 0" />
                          <Button id="resize-dashboard-tile-medium" action="ResizeSelectedDashboardTileMedium" content="Medium" margin="0 0 8 0" />
                          <Button id="resize-dashboard-tile-large" action="ResizeSelectedDashboardTileLarge" content="Large" margin="0 0 8 0" />
                          <Button id="resize-dashboard-tile-wide" action="ResizeSelectedDashboardTileWide" content="Wide" />
                        </Container>
                      </Container>
                    </Container>
                  </Container>
                </If>
                <If Condition="{Binding IsLibrary}">
                  <Container id="library-page" Type="Vertical Stack">
                    <Text text="Library" font-size="28" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
                    <Text text="Find authorised artifacts across your apps. Items stay in their owning app." foreground="{Resource CuiTextSoftBrush}" margin="0 6 0 14" />
                    <Container Type="Horizontal Stack">
                      <Input id="library-search" placeholder-text="Search artifacts" accessible-name="Search Library" width="360" Type="Text" />
                      <Button id="library-search-submit" action="SearchLibrary" content="Search" margin="12 0 0 0" />
                    </Container>
                    <Text id="library-status" text="{Binding LibrarySummary}" foreground="{Resource CuiTextSoftBrush}" margin="0 10 0 12" />
                    <Text id="library-results" text="{Binding LibraryItemsSummary}" foreground="{Resource CuiTextBrush}" />
                    <Container margin="0 12 0 0" Type="Horizontal Stack">
                      <Button id="library-open-selected" action="OpenLibraryItem" content="Open selected" margin="0 0 8 0" />
                      <Button id="library-pin-selected" action="PinSelectedLibraryItem" content="Pin selected" margin="0 0 8 0" />
                      <Button id="library-unpin-selected" action="UnpinSelectedLibraryItem" content="Unpin selected" />
                    </Container>
                  </Container>
                </If>
                <If Condition="{Binding IsEvents}">
                  <Container id="events-page" Type="Vertical Stack">
                    <Text text="Events" font-size="28" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
                    <Text text="Activity from your authorised apps and services." foreground="{Resource CuiTextSoftBrush}" margin="0 6 0 14" />
                    <Button id="events-refresh" action="RefreshEvents" content="Refresh activity" IsEnabled="{Binding CanRefreshEvents, fallback=false}" />
                    <Text id="events-page-status" text="{Binding EventsSummary}" foreground="{Resource CuiTextSoftBrush}" margin="0 10 0 12" />
                    <Container id="events-page-items" Type="Vertical Stack" MaxHeight="480" VerticalScrolling="True" HorizontalScrolling="False" CellGap="8" role="list" accessible-name="Activity items">
                      <Repeat id="home-events-rows" Source="{Binding EventItems}" As="activity" Key="{Binding activity.EventId}">
                        <Button id="home-event-row" action="SelectHomeEvent" Selected="{Binding activity.IsSelected}" IsEnabled="{Binding CanSelectEventObject, fallback=false}" accessible-name="{Binding activity.Summary}" HorizontalAlignment="Stretch" Padding="12" Margin="0 0 0 8">
                          <Container Type="Vertical Stack" CellGap="4" HorizontalAlignment="Stretch">
                            <Text Text="{Binding activity.Summary}" TextWrapping="Wrap" />
                            <Container Type="Wrap" CellGap="8">
                              <Text Text="{Binding activity.Timestamp}" Foreground="{Resource CuiTextSoftBrush}" />
                              <Text Text="{Binding activity.SourceApp}" Foreground="{Resource CuiTextSoftBrush}" />
                              <Text Text="{Binding activity.EventType}" Foreground="{Resource CuiTextSoftBrush}" />
                              <Text Text="{Binding activity.ActorDisplayName}" Foreground="{Resource CuiTextSoftBrush}" />
                              <Text Text="{Binding activity.Severity}" Foreground="{Resource CuiTextSoftBrush}" />
                              <Text Text="{Binding activity.Category}" Foreground="{Resource CuiTextSoftBrush}" />
                            </Container>
                          </Container>
                        </Button>
                      </Repeat>
                    </Container>
                    <Button id="events-open-selected" action="OpenEventObject" content="Open selected activity item" IsEnabled="{Binding CanOpenEventObject, fallback=false}" margin="0 12 0 0" />
                    <Text text="{Binding NavigationStatus}" foreground="{Resource CuiTextSoftBrush}" margin="0 12 0 0" />
                  </Container>
                </If>
                <If Condition="{Binding IsSettings}">
                  <Container id="home-settings-page" Type="Vertical Stack">
                    <Text text="Home settings" font-size="28" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
                    <Container id="home-appearance-settings" Type="Vertical Stack" VerticalScrolling="True" HorizontalScrolling="False" CellGap="10" Margin="0 12 0 20">
                      <Text Text="Appearance / CUI" FontSize="20" FontWeight="SemiBold" />
                      <Text Text="{Binding HomeAppearanceScope}" Foreground="{Resource CuiTextSoftBrush}" />
                      <Text Text="{Binding HomeAppearanceStatus}" Foreground="{Resource CuiTextSoftBrush}" TextWrapping="Wrap" />
                      <Text Text="Theme" FontWeight="SemiBold" />
                      <Repeat id="home-theme-options" Source="{Binding HomeThemeChoices}" As="option" Key="{Binding option.Key}" Panel="Wrap">
                        <Button id="home-theme-option" action="ApplyHomeAppearanceOption" Content="{Binding option.Name}" Selected="{Binding option.IsSelected}" IsEnabled="{Binding HomeAppearanceAvailable, fallback=false}" Padding="12 8" Margin="0 0 8 8" />
                      </Repeat>
                      <Text Text="Brightness" FontWeight="SemiBold" />
                      <Repeat id="home-appearance-options" Source="{Binding HomeAppearanceChoices}" As="option" Key="{Binding option.Key}" Panel="Wrap">
                        <Button id="home-appearance-option" action="ApplyHomeAppearanceOption" Content="{Binding option.Name}" Selected="{Binding option.IsSelected}" IsEnabled="{Binding HomeAppearanceAvailable, fallback=false}" Padding="12 8" Margin="0 0 8 8" />
                      </Repeat>
                      <Text Text="Accessibility" FontWeight="SemiBold" />
                      <Repeat id="home-accessibility-options" Source="{Binding HomeAccessibilityChoices}" As="option" Key="{Binding option.Key}" Panel="Wrap">
                        <Button id="home-accessibility-option" action="ApplyHomeAppearanceOption" Content="{Binding option.Name}" Selected="{Binding option.IsSelected}" IsEnabled="{Binding HomeAppearanceAvailable, fallback=false}" Padding="12 8" Margin="0 0 8 8" />
                      </Repeat>
                      <Button id="home-appearance-refresh" action="RefreshHomeAppearance" Content="Refresh appearance" IsEnabled="{Binding HomeAppearanceCanRefresh, fallback=false}" HorizontalAlignment="Left" />
                    </Container>
                    <Button id="settings-open-cake-account" action="OpenHomeCakeAccount" content="CAKE ID account" accessible-name="Open CAKE ID account settings" />
                    <Text id="home-profile-status" text="{Binding HomeProfileSummary}" foreground="{Resource CuiTextSoftBrush}" margin="0 12 0 12" />
                    <Text id="home-layout-status" text="{Binding HomeLayoutSummary}" foreground="{Resource CuiTextBrush}" margin="0 0 0 12" />
                    <Container Type="Horizontal Stack">
                      <Button id="settings-allow-ai-tiles" action="EnableAIGeneratedTiles" content="Allow AI tiles" margin="0 0 8 0" />
                      <Button action="DisableAIGeneratedTiles" content="Keep AI tiles off" margin="0 0 8 0" />
                      <Button action="EnableAIReorder" content="Allow AI rearrangement" margin="0 0 8 0" />
                      <Button action="DisableAIReorder" content="Keep layout fixed" />
                    </Container>
                    <Button action="RefreshHomeWorkspace" content="Reload saved preferences" margin="0 12 0 0" />
                    <Text id="settings-navigation-status" text="{Binding NavigationStatus}" foreground="{Resource CuiTextSoftBrush}" margin="0 12 0 0" />
                  </Container>
                </If>
                <If Condition="{Binding IsPermissions}">
                  <Container id="home-permissions-page" Type="Vertical Stack">
                    <Text text="Permissions" font-size="28" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
                    <Text text="{Binding HomePermissionSummary}" foreground="{Resource CuiTextSoftBrush}" margin="0 12 0 12" />
                    <Button action="RefreshHomePermissions" content="Refresh requests" margin="0 0 0 12" />
                    <Input id="home-permission-requests" height="200" Type="List" />
                    <Text text="{Binding SelectedHomePermission}" foreground="{Resource CuiTextBrush}" margin="0 12 0 12" />
                    <Container Type="Horizontal Stack">
                      <Button id="home-permission-accept" content="Allow once" margin="0 0 12 0" />
                      <Button id="home-permission-decline" content="Decline" />
                    </Container>
                    <Text id="permissions-navigation-status" text="{Binding NavigationStatus}" foreground="{Resource CuiTextSoftBrush}" margin="0 12 0 0" />
                  </Container>
                </If>
              </Container>
            </Container>
          </Container>
          </Container>
        </If>
        <If Condition="{Binding IsNativeCakeAccountWindow, fallback=false}">
          <Container id="home-cake-account-scroll" vertical-scrolling="true" horizontal-scrolling="false" Type="Overlay">
            <Container id="home-cake-account-page" margin="24" Type="Vertical Stack">
              <Text text="{Binding CakeAccountHeading}" font-size="28" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
              <Text text="{Binding CakeAccountStatus}" foreground="{Resource CuiTextSoftBrush}" margin="0 12 0 12" />
              <Container margin="0 0 0 12" Type="Wrap">
                <Button id="home-cake-sign-in" action="SignInCakeAccount" content="Sign in to CAKE ID" margin="0 0 8 8" />
                <Button id="home-cake-refresh" action="RefreshCakeAccount" content="Refresh account" margin="0 0 8 8" />
                <Button id="home-cake-sign-out" action="RequestCakeSignOut" content="Sign out" margin="0 0 8 8" />
                <Button id="home-cake-close" action="CloseCakeAccount" content="Close" margin="0 0 8 8" />
              </Container>
              <Text text="{Binding CakeAccountId}" foreground="{Resource CuiTextBrush}" />
              <Text text="{Binding CakeProfileSummary}" foreground="{Resource CuiTextBrush}" margin="0 12 0 12" />
              <Text text="Sessions" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" />
              <Text text="{Binding CakeSessionsSummary}" foreground="{Resource CuiTextSoftBrush}" margin="0 8 0 12" />
              <If Condition="{Binding CakeHasSignOutConfirmation}">
                <Container id="home-cake-confirmation" Type="Vertical Stack">
                  <Text text="Sign out of this CAKE ID session? Your local dashboard stays available." foreground="{Resource CuiTextBrush}" />
                  <Container margin="0 8 0 12" Type="Wrap">
                    <Button id="home-cake-confirm-sign-out" action="ConfirmCakeSignOut" content="Confirm sign-out" margin="0 0 8 0" />
                    <Button action="CancelCakeSignOut" content="Keep signed in" />
                  </Container>
                </Container>
              </If>
              <Text text="{Binding CakeUnsupportedServices}" foreground="{Resource CuiTextSoftBrush}" margin="0 12 0 0" />
            </Container>
          </Container>
        </If>
      </Container>
    </Page>
  </Theme>
</Cui>
