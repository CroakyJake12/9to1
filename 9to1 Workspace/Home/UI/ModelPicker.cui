<Cui id="home-model-picker" product="9-1" version="1">
  <Theme Name="user_preference">
    <Page>
      <Container id="model-picker-root" background="{Resource CuiBackgroundBrush}" padding="24" Type="Vertical Stack">
        <Container id="compact-model-picker" background="{Resource CuiPanelBrush}" padding="12" margin="0 0 0 16" Type="Horizontal Stack">
          <Text id="compact-model-picker-label" text="Model route" foreground="{Resource CuiTextSoftBrush}" margin="0 4 0 0" />
          <Text id="compact-model-picker-selection" text="{Binding State.SelectedRouteId, fallback=Choose a route}" foreground="{Resource CuiTextBrush}" />
          <Button id="compact-model-picker-edit" action="SelectRoute" action-route-id="{Binding State.SelectedRouteId}" content="Manage" margin="12 0 0 0" accessible-name="Manage the selected model route" />
        </Container>
        <Container id="model-picker-header" margin="0 0 0 18" Type="Horizontal Stack">
          <Container width="620" Type="Vertical Stack">
            <Text id="model-picker-title" text="AI models and routes" font-size="26" font-weight="Bold" foreground="{Resource CuiTextBrush}" />
            <Text id="model-picker-description" text="Choose a model route for each kind of work. Route order applies only after eligibility and policy checks." foreground="{Resource CuiTextSoftBrush}" margin="0 5 0 14" />
          </Container>
          <Button id="model-picker-refresh" action="Refresh" action-scope="{Binding Scope}" action-category="{Binding Category}" content="Refresh" accessible-name="Refresh model routes" />
        </Container>
        <Container id="model-picker-categories" margin="0 0 0 18" Type="Horizontal Stack">
          <Button id="category-chat" action="SelectCategory" action-category="chat" content="Chat" accessible-name="Show chat routes" />
          <Button id="category-image" action="SelectCategory" action-category="image" content="Image" margin="8 0 0 0" accessible-name="Show image routes" />
          <Button id="category-voice" action="SelectCategory" action-category="voice" content="Voice" margin="8 0 0 0" accessible-name="Show voice routes" />
          <Button id="category-audio" action="SelectCategory" action-category="audio" content="Advanced audio" margin="8 0 0 0" accessible-name="Show advanced audio routes" />
          <Button id="category-video" action="SelectCategory" action-category="video" content="Advanced video" margin="8 0 0 0" accessible-name="Show advanced video routes" />
        </Container>
        <Text id="model-picker-status" text="{Binding StatusMessage, fallback=Model routes have not been loaded}" foreground="{Resource CuiTextSoftBrush}" margin="0 10 0 14" />
        <Container id="model-route-list" Type="Vertical Stack">
          <If condition="{Binding HasSnapshot}">
            <If condition="{Binding HasRoutes}">
            <Repeat Source="{Binding Snapshot.Routes}" As="route" Key="{Binding route.RouteId}">
              <Container id="model-route-template" margin="0 0 0 14" Type="Vertical Stack">
                <Container id="model-route-card" background="{Resource CuiPanelBrush}" corner-radius="12" padding="18" margin="0 0 0 12" Type="Overlay" BorderColor="{Resource CuiLineBrush}" BorderWidth="1">
                  <Container Type="Vertical Stack">
                    <Container Type="Horizontal Stack">
                      <Text id="model-route-title" text="{Binding route.RouteId}" font-size="17" font-weight="SemiBold" foreground="{Resource CuiTextBrush}" />
                      <Text id="model-route-scope" text="{Binding route.Scope}" foreground="{Resource CuiTextSoftBrush}" margin="12 4 0 0" />
                      <Button id="model-route-select" action="SelectRoute" action-route-id="{Binding route.RouteId}" content="Edit route" margin="12 0 0 0" accessible-name="Edit this model route" />
                    </Container>
                    <Text id="model-route-category" text="{Binding route.Category}" foreground="{Resource CuiTextSoftBrush}" margin="0 4 0 8" />
                    <Container id="model-route-candidates" Type="Vertical Stack">
                      <If condition="{Binding route.HasCandidates}">
                        <Repeat Source="{Binding route.Candidates}" As="candidate" Key="{Binding candidate.Identity}">
                          <Container id="model-candidate-template" margin="0 8 0 0" Type="Horizontal Stack">
                            <Text id="candidate-order" text="{Binding candidate.Order}" width="28" foreground="{Resource CuiTextSoftBrush}" />
                            <Container width="360" Type="Vertical Stack">
                              <Text id="candidate-model-id" text="{Binding candidate.ModelId}" foreground="{Resource CuiTextBrush}" />
                              <Text id="candidate-provider" text="{Binding candidate.ProviderId}" foreground="{Resource CuiTextSoftBrush}" />
                            </Container>
                            <Text id="candidate-enabled" text="{Binding candidate.Enabled}" width="72" foreground="{Resource CuiTextSoftBrush}" />
                            <Button id="candidate-move-up" action="MoveCandidateUp" action-provider-id="{Binding candidate.ProviderId}" action-model-id="{Binding candidate.ModelId}" action-artifact-revision="{Binding candidate.ArtifactRevision}" content="Up" accessible-name="Move model earlier in route" />
                            <Button id="candidate-move-down" action="MoveCandidateDown" action-provider-id="{Binding candidate.ProviderId}" action-model-id="{Binding candidate.ModelId}" action-artifact-revision="{Binding candidate.ArtifactRevision}" content="Down" margin="6 0 0 0" accessible-name="Move model later in route" />
                            <If condition="{Binding candidate.Enabled}">
                              <Button action="SetCandidateEnabled" action-enabled="false" action-provider-id="{Binding candidate.ProviderId}" action-model-id="{Binding candidate.ModelId}" action-artifact-revision="{Binding candidate.ArtifactRevision}" content="Disable" margin="6 0 0 0" accessible-name="Disable this route candidate" />
                            </If>
                            <Else>
                              <Button action="SetCandidateEnabled" action-enabled="true" action-provider-id="{Binding candidate.ProviderId}" action-model-id="{Binding candidate.ModelId}" action-artifact-revision="{Binding candidate.ArtifactRevision}" content="Enable" margin="6 0 0 0" accessible-name="Enable this route candidate" />
                            </Else>
                          </Container>
                        </Repeat>
                      </If>
                      <Else>
                        <Container id="model-candidate-empty" padding="12" Type="Vertical Stack">
                          <Text text="This route has no candidates." foreground="{Resource CuiTextSoftBrush}" />
                        </Container>
                      </Else>
                    </Container>
                  </Container>
                </Container>
              </Container>
            </Repeat>
            </If>
            <Else>
              <Container id="model-route-empty" padding="20" Type="Vertical Stack">
                <Text text="No routes are configured for this category." foreground="{Resource CuiTextSoftBrush}" />
              </Container>
            </Else>
          </If>
        </Container>
        <Container id="model-route-actions" margin="0 12 0 8" Type="Horizontal Stack">
          <Button id="save-model-route" action="SaveRoute" content="Save route" accessible-name="Save model route changes" />
          <Button id="preview-text-route" action="PreviewResolution" action-capability="text" content="Preview text" margin="8 0 0 0" accessible-name="Preview text model routing" />
          <Button id="preview-image-route" action="PreviewResolution" action-capability="image-generation" content="Preview image" margin="8 0 0 0" accessible-name="Preview image model routing" />
          <Button id="preview-voice-route" action="PreviewResolution" action-capability="voice" content="Preview voice" margin="8 0 0 0" accessible-name="Preview voice model routing" />
          <Button id="preview-audio-route" action="PreviewResolution" action-capability="audio-understanding" content="Preview audio" margin="8 0 0 0" accessible-name="Preview audio model routing" />
          <Button id="preview-video-route" action="PreviewResolution" action-capability="video-generation" content="Preview video" margin="8 0 0 0" accessible-name="Preview video model routing" />
        </Container>
        <If condition="{Binding HasPreview}">
          <Container id="model-route-preview" margin="0 0 0 14" Type="Vertical Stack">
            <Text id="model-route-preview-state" text="{Binding Preview.ResolutionState}" foreground="{Resource CuiTextBrush}" />
            <Container id="model-route-preview-trace" Type="Vertical Stack">
              <If condition="{Binding HasTrace}">
                <Repeat Source="{Binding Preview.Trace}" As="trace" Key="{Binding trace.Identity}">
                  <Container id="model-route-trace-template" Type="Vertical Stack">
                    <Text id="model-route-trace-entry" text="{Binding trace.Text}" foreground="{Resource CuiTextSoftBrush}" margin="0 2 0 0" />
                  </Container>
                </Repeat>
              </If>
              <Else>
                <Container id="model-route-trace-empty" Type="Vertical Stack">
                  <Text text="No candidates were skipped." foreground="{Resource CuiTextSoftBrush}" />
                </Container>
              </Else>
            </Container>
          </Container>
        </If>
      </Container>
    </Page>
  </Theme>
</Cui>
