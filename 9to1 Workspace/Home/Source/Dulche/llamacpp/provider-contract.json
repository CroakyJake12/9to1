{
  "schemaVersion": 2,
  "providerId": "llamacpp",
  "displayName": "llama.cpp",
  "isLocal": true,
  "transport": {
    "type": "http-over-unix",
    "defaultSocket": "$XDG_RUNTIME_DIR/haven/inference.sock",
    "networkRequired": false
  },
  "modelKeys": {
    "format": "llamacpp:<model-id>",
    "legacyUnqualifiedProvider": "ollama",
    "rationale": "Preserve existing unqualified Ollama model names while adding llama.cpp as a first-class local provider."
  },
  "endpoints": [
    "GET /health",
    "GET /v1/provider",
    "GET /v1/models",
    "GET /v1/slots",
    "GET /v1/tools",
    "GET /v1/permissions/requests",
    "GET /v1/permissions/events",
    "POST /v1/models/{id}/load",
    "POST /v1/models/{id}/unload",
    "POST /v1/slots/{slot}/context",
    "POST /v1/slots/{slot}/tools/{tool_id}",
    "POST /v1/slots/{slot}/permissions",
    "POST /v1/permissions/{request_id}/resolve",
    "POST /v1/chat/completions",
    "POST /v1/requests/{request_id}/cancel"
  ],
  "modelLifecycle": {
    "brokerCanWriteModelStore": false,
    "downloadInBroker": false,
    "deletionInBroker": false,
    "manager": "haven-modelctl",
    "managerNetworkRequired": false,
    "mutationSynchronization": "exclusive store flock plus exclusive per-model flock",
    "loadedWorkerLease": "shared per-model flock held for worker lifetime",
    "managementBoundary": "Explicit user-action model manager owns verified local import, replace/update, and deletion."
  },
  "coexistence": {
    "ollamaProcessOwnership": "external",
    "ollamaProxying": false,
    "retirement": "deferred until compatibility and performance evidence supports migration"
  },
  "runtime": {
    "topology": "single-broker-owned-slot-workers",
    "perAppServers": false,
"singleInstanceArbitration": "process-lifetime-flock",
"defaultMaxModelSlots": 8,
"workerConcurrency": "one generation per loaded slot",

    "cancellation": {
      "primary": "upstream-resumable-stream-delete",
      "transportFallback": "before-worker-response-or-control-failure",
      "workerCompletionConfirmed": false,
      "evidence": "pinned-upstream-source-and-model-free-integration"
    }
  },
  "embeddingApi": {
    "start": "Dulche.Start(port)",
    "loadModel": "Dulche.LoadModel(model, slot, context)",
    "modelHandle": "Dulche.Model(modelId)",
    "setContext": "Dulche.Model(modelId).SetContext(context)",
    "blankSlot": "next available slot",
    "blankContext": "broker default context",
    "contextApplication": "after the current turn completes"
  },
  "tools": {
    "owner": "Dulche",
    "registered": [
      "dulche.run_command",
      "dulche.run_code"
    ],
    "modelRuntimeAccess": "permission requests only",
    "approvalEvents": "GET /v1/permissions/events",
    "approvalTimeoutSeconds": 10,
    "timeoutFallback": "ask_user"
  }
}
