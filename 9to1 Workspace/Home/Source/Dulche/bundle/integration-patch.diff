@@ -0,0 +1,254 @@
+using System.Text;
+
+namespace HavenOS.Home.Core;
+
+/// <summary>Fail-closed structural admission gate for a verified model blob. This is a DISTINCT
+/// axis from artifact hashing: a correctly-hashed blob can still be structurally malformed (GGUF
+/// misalignment/truncation, a declared tensor extent beyond the file, or a supported quantized
+/// block whose row is not divisible by the block size). A model becomes eligible only when it
+/// passes BOTH real size+hash verification AND this structural gate. Any gate absence or
+/// anomalous/defective result keeps the model non-eligible (BLOCKED). Cancellation propagates as
+/// OperationCanceledException and never produces a partial admission. Structural admission never
+/// equals installed/verified/running/generation-ready.</summary>
+public interface IHomeDulcheModelStructuralGate
+{
+    ValueTask<bool> IsStructurallyAdmittedAsync(string blobPath, long sizeBytes, CancellationToken cancellationToken);
+}
+
+/// <summary>Default managed structural gate. It performs a bounded, in-process GGUF scan (no
+/// external process, no network, no interpreter): it validates magic, version, alignment
+/// (declared UINT32, positive power-of-two, bounded), scalar type widths, tensor-table bounds,
+/// per-tensor offset alignment, and the supported quantized-block row divisibility. It fails
+/// closed only on PROVABLE structural defects. Blobs containing tensor types outside the supported
+/// subset are passed through (never claimed complete, never bricked) so this narrow checker cannot
+/// silently block all otherwise-supported bundled/local models through a universal eligibility gate.
+/// This verifier exposes no timeout and claims no deadline: it is a bounded in-process scan that
+/// honours caller cancellation by polling the token during the scan.</summary>
+public sealed class HomeDulchePackagedModelStructuralGate : IHomeDulcheModelStructuralGate
+{
+    public async ValueTask<bool> IsStructurallyAdmittedAsync(string blobPath, long sizeBytes, CancellationToken cancellationToken)
+    {
+        if (!File.Exists(blobPath) || sizeBytes <= 0) return false;
+        try
+        {
+            return await Task.Run(
+                () => HomeDulcheGGUFStructuralVerifier.Check(blobPath, cancellationToken),
+                cancellationToken).ConfigureAwait(false);
+        }
+        catch (OperationCanceledException)
+        {
+            throw;
+        }
+        catch
+        {
+            return false;
+        }
+    }
+}
+
+/// <summary>Bounded managed GGUF structural verifier for the supported subset, mirroring the bundle
+/// lane's <c>bundle/formats.py</c> checks (magic, version, alignment, scalar type widths, Q6_K
+/// block row divisibility). It runs entirely in-process. Only provable defects are rejected;
+/// tensor types outside the supported subset are not treated as defects (pass-through), which
+/// distinguishes supported-subset completeness from general engine compatibility. The caller's
+/// cancellation token is polled during metadata/tensor scans and before admission; cancellation
+/// is honoured as cancellation and never produces a partial/positive admission.</summary>
+internal static class HomeDulcheGGUFStructuralVerifier
+{
+    private const uint Magic = 0x46554747u; // "GGUF"
+    private const int MaxRank = 64;
+    private const uint MaxAlignment = 1u << 20;   // 1 MiB ceiling for a declared alignment
+    private const uint MinAlignment = 4u;         // below 4 is not a reasonable GGUF alignment
+
+    private const uint TypeUint32 = 4;
+    private const uint TypeString = 8;
+    private const uint TypeArray = 9;
+
+    private const uint GgmlQ6K = 14;
+    private const ulong Q6KBlockElements = 256;
+    private const ulong Q6KBlockBytes = 210;
+
+    // GGUF metadata scalar value widths (type tag -> bytes). Verified against the official GGUF
+    // spec: UINT8=0, INT8=1, UINT16=2, INT16=3, UINT32=4, INT32=5, FLOAT32=6, BOOL=7,
+    // UINT64=10, INT64=11, FLOAT64=12.
+    private static readonly Dictionary<uint, int> ScalarSize = new()
+    {
+        [0] = 1,
+        [1] = 1,
+        [2] = 2,
+        [3] = 2,
+        [4] = 4,
+        [5] = 4,
+        [6] = 4,
+        [7] = 1,
+        [10] = 8,
+        [11] = 8,
+        [12] = 8,
+    };
+
+    // Plain ggml tensor types -> bytes per element (verified against upstream ggml.h).
+    private static readonly Dictionary<uint, int> PlainTypeBytes = new()
+    {
+        [0] = 4,   // F32
+        [1] = 2,   // F16
+        [24] = 1,  // I8
+        [25] = 2,  // I16
+        [26] = 4,  // I32
+        [27] = 8,  // I64
+        [28] = 8,  // F64
+        [30] = 2,  // BF16
+    };
+
+    public static bool Check(string path, CancellationToken cancellationToken)
+    {
+        using var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read,
+            8192, FileOptions.SequentialScan);
+        using var reader = new BinaryReader(fs);
+
+        cancellationToken.ThrowIfCancellationRequested();
+        if (fs.Length < 24) return false;
+        if (reader.ReadUInt32() != Magic) return false;
+        uint version = reader.ReadUInt32();
+        if (version != 2 && version != 3) return false;
+
+        ulong tensorCount = reader.ReadUInt64();
+        ulong kvCount = reader.ReadUInt64();
+        if (kvCount > 10_000_000ul || tensorCount > 1_000_000ul) return false;
+
+        long alignment = 32;
+        for (ulong i = 0; i < kvCount; i++)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            string? key = ReadString(reader);
+            if (key is null) return false;
+            uint vtype = reader.ReadUInt32();
+
+            if (string.Equals(key, "general.alignment", StringComparison.Ordinal))
+            {
+                // Declared alignment must be a single UINT32 scalar with a positive, power-of-two
+                // value within reasonable bounds. A wrong scalar/string type or a non-power-of-two
+                // value (e.g. 3) is a provable defect, never silently ignored or accepted.
+                if (vtype != TypeUint32) return false;
+                uint candidate = reader.ReadUInt32();
+                if (!IsValidAlignment(candidate)) return false;
+                alignment = candidate;
+                continue;
+            }
+
+            if (vtype == TypeString)
+            {
+                if (ReadString(reader) is null) return false;
+            }
+            else if (vtype == TypeArray)
+            {
+                uint elemType = reader.ReadUInt32();
+                ulong count = reader.ReadUInt64();
+                if (count > 10_000_000ul) return false;
+                if (elemType == TypeString)
+                {
+                    for (ulong j = 0; j < count; j++)
+                    {
+                        cancellationToken.ThrowIfCancellationRequested();
+                        if (ReadString(reader) is null) return false;
+                    }
+                }
+                else
+                {
+                    if (!ScalarSize.TryGetValue(elemType, out int esz)) return false;
+                    if (count > (ulong)(fs.Length / esz)) return false;
+                    reader.BaseStream.Seek((long)(count * (ulong)esz), SeekOrigin.Current);
+                    if (reader.BaseStream.Position > fs.Length) return false;
+                }
+            }
+            else
+            {
+                if (!ScalarSize.TryGetValue(vtype, out int sz)) return false;
+                if (reader.BaseStream.Position + sz > fs.Length) return false;
+                reader.BaseStream.Seek(sz, SeekOrigin.Current);
+            }
+        }
+
+        int tensorsRead = 0;
+        var declaredExtents = new List<ulong>();
+        for (ulong t = 0; t < tensorCount; t++)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            if (reader.BaseStream.Position >= fs.Length) return false;
+            string? name = ReadString(reader);
+            if (name is null) return false;
+            uint nDims = reader.ReadUInt32();
+            if (nDims == 0 || nDims > MaxRank) return false;
+            ulong elementCount = 1;
+            ulong firstDim = 0;
+            for (uint d = 0; d < nDims; d++)
+            {
+                ulong dim = reader.ReadUInt64();
+                if (dim == 0) return false;   // impossible zero dimension
+                if (elementCount > ulong.MaxValue / dim) return false; // overflow guard
+                if (d == 0) firstDim = dim;
+                elementCount *= dim;
+            }
+            uint ggmlType = reader.ReadUInt32();
+            ulong tensorOffset = reader.ReadUInt64();
+            tensorsRead++;
+            if (tensorOffset % (ulong)alignment != 0) return false; // per-tensor offset misalignment
+
+            ulong? dataSize = null;
+            if (PlainTypeBytes.TryGetValue(ggmlType, out int perElement))
+            {
+                if (elementCount > (ulong)(fs.Length / perElement)) return false;
+                dataSize = elementCount * (ulong)perElement;
+            }
+            else if (ggmlType == GgmlQ6K)
+            {
+                // ggml quantized blocks run along the innermost (row) dimension ne[0].
+                if (firstDim == 0 || firstDim % Q6KBlockElements != 0) return false;
+                if (elementCount % Q6KBlockElements != 0) return false;
+                dataSize = (elementCount / Q6KBlockElements) * Q6KBlockBytes;
+            }
+            // Unknown/unsupported tensor type: pass-through (never bricked, never claimed complete).
+            // For a KNOWN type, verify the declared tensor extent actually fits in the file
+            // (fail closed on truncation / beyond-EOF extent). Declared end is relative to the
+            // aligned data section start.
+            if (dataSize is ulong knownSize)
+            {
+                if (knownSize > (ulong)fs.Length) return false;
+                if (tensorOffset > (ulong)fs.Length - knownSize) return false;
+                declaredExtents.Add(tensorOffset + knownSize); // ulong + ulong (no signed/unsigned mix)
+            }
+            else
+            {
+                if (tensorOffset > (ulong)fs.Length) return false;
+            }
+        }
+
+        if (tensorsRead == 0) return false; // no tensors => not a meaningful model container
+        cancellationToken.ThrowIfCancellationRequested();
+
+        // The data section begins AFTER all tensor-info records, aligned UP to `alignment`. A blob
+        // that ends exactly at the last tensor-info byte (no aligned payload) must be rejected: the
+        // aligned data start lies beyond EOF and the declared tensor extents cannot be satisfied.
+        long dataSectionStart = reader.BaseStream.Position;
+        long dataStart = ((dataSectionStart + alignment - 1) / alignment) * alignment;
+        if (dataStart > fs.Length) return false;
+        // Every declared extent must reach no further than the end of the file.
+        foreach (var end in declaredExtents)
+        {
+            if ((ulong)dataStart + end > (ulong)fs.Length) return false;
+        }
+        return true;
+    }
+
+    private static bool IsValidAlignment(uint value) =>
+        value >= MinAlignment && value <= MaxAlignment && (value & (value - 1)) == 0;
+
+    private static string? ReadString(BinaryReader reader)
+    {
+        ulong len = reader.ReadUInt64();
+        if (len > 1_000_000ul) return null;
+        if (reader.BaseStream.Position + (long)len > reader.BaseStream.Length) return null;
+        byte[] raw = reader.ReadBytes((int)len);
+        if (raw.Length != (int)len) return null;
+        return Encoding.UTF8.GetString(raw);
+    }
+}
