<Cui>
  <ScrollViewer>
    <StackPanel margin="24" max-width="900">
      <TextBlock text="Permissions" font-size="26" font-weight="SemiBold" />
      <TextBlock id="approval-status" text="{Binding Status}" text-wrapping="Wrap" accessible-name="Permission status" />
      <Button id="approval-refresh" action="Refresh" content="Refresh" min-height="44" />
      <TextBlock text="{Binding PendingCount}" margin="0,16,0,8" />
      <StackPanel is-visible="{Binding HasPending}">
        <TextBlock text="{Binding Caller}" font-weight="SemiBold" />
        <TextBlock id="approval-identity" text="{Binding Identity}" text-wrapping="Wrap" />
        <TextBlock id="approval-target" text="{Binding Target}" text-wrapping="Wrap" />
        <TextBlock id="approval-action" text="{Binding Action}" text-wrapping="Wrap" />
        <TextBlock id="approval-scope" text="{Binding Scope}" text-wrapping="Wrap" />
        <TextBlock id="approval-preview" text="{Binding Preview}" text-wrapping="Wrap" />
        <TextBlock text="{Binding Impact}" text-wrapping="Wrap" />
        <TextBlock text="{Binding Risk}" text-wrapping="Wrap" />
        <WrapPanel>
          <Button id="approval-previous" action="PreviousRequest" content="Previous" min-height="44" />
          <Button id="approval-next" action="NextRequest" content="Next" min-height="44" />
        </WrapPanel>
        <WrapPanel>
          <Button id="approval-decline" action="Decline" content="Decline" min-height="44" />
          <Button id="approval-block" action="DeclineBlock" content="Decline and block caller" min-height="44" />
          <Button id="approval-accept" action="Accept" content="Accept once" min-height="44" />
          <Button id="approval-trust" action="Trust" content="Accept and trust for 30 days" min-height="44" />
        </WrapPanel>
        <Button id="approval-warning" action="ShowTrustWarning" content="Review extended trust options" min-height="44" />
        <StackPanel is-visible="{Binding WarningVisible}" margin="0,12,0,0">
          <TextBlock id="approval-trust-warning" text="Always Trust can allow this caller to read, modify or destroy user data within the displayed action and scope without asking again. Review the caller and affected objects carefully. You can go back without granting trust, and revoke granted trust below." font-weight="SemiBold" text-wrapping="Wrap" />
          <Button id="approval-warning-back" action="BackFromTrustWarning" content="Go back" min-height="44" />
          <Button id="approval-always" action="ConfirmAlwaysTrust" content="I understand — accept and always trust" min-height="44" />
          <TextBlock text="Temporary trust: choose a duration or an action limit." text-wrapping="Wrap" />
          <TextBox id="approval-minutes" text="{Binding Minutes, Mode=TwoWay}" accessible-name="Temporary trust duration in minutes" placeholder-text="Minutes" />
          <Button id="approval-duration" action="TemporaryDuration" content="Accept with this duration" min-height="44" />
          <TextBox id="approval-action-count" text="{Binding Actions, Mode=TwoWay}" accessible-name="Temporary trust action limit" placeholder-text="Action count" />
          <Button id="approval-actions" action="TemporaryActions" content="Accept with this action limit" min-height="44" />
          <CheckBox id="approval-fallback" is-checked="{Binding RetainTrust, Mode=TwoWay}" content="After temporary access ends, retain 30-day trust instead of returning to manual approval" />
        </StackPanel>
      </StackPanel>
      <TextBlock text="{Binding GrantCount}" margin="0,20,0,8" font-weight="SemiBold" />
      <StackPanel is-visible="{Binding HasGrant}">
        <TextBlock text="{Binding GrantSummary}" text-wrapping="Wrap" />
        <WrapPanel>
          <Button action="PreviousGrant" content="Previous grant" min-height="44" />
          <Button action="NextGrant" content="Next grant" min-height="44" />
          <Button id="approval-revoke" action="RevokeGrant" content="Revoke access" min-height="44" />
        </WrapPanel>
      </StackPanel>
      <TextBlock text="{Binding BlockedCount}" margin="0,20,0,8" font-weight="SemiBold" />
      <StackPanel is-visible="{Binding HasBlocked}">
        <TextBlock text="{Binding BlockedSummary}" text-wrapping="Wrap" />
        <WrapPanel>
          <Button action="PreviousBlocked" content="Previous caller" min-height="44" />
          <Button action="NextBlocked" content="Next caller" min-height="44" />
          <Button id="approval-unblock" action="UnblockCaller" content="Unblock caller" min-height="44" />
        </WrapPanel>
      </StackPanel>
      <TextBlock text="{Binding AuditSummary}" margin="0,20,0,0" text-wrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Cui>
