<Cui>
  <Page>
    <Container Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
      <Container margin="24" max-width="900" Type="Vertical Stack">
        <Text text="Permissions" font-size="26" font-weight="SemiBold" />
        <Text id="approval-status" text="{Binding Status}" text-wrapping="Wrap" accessible-name="Permission status" />
        <Button id="approval-refresh" action="Refresh" content="Refresh" min-height="44" />
        <Text text="{Binding PendingCount}" margin="0,16,0,8" />
        <Container Type="Vertical Stack" Active="{Binding HasPending}">
          <Text text="{Binding Caller}" font-weight="SemiBold" />
          <Text id="approval-identity" text="{Binding Identity}" text-wrapping="Wrap" />
          <Text id="approval-target" text="{Binding Target}" text-wrapping="Wrap" />
          <Text id="approval-action" text="{Binding Action}" text-wrapping="Wrap" />
          <Text id="approval-scope" text="{Binding Scope}" text-wrapping="Wrap" />
          <Text id="approval-preview" text="{Binding Preview}" text-wrapping="Wrap" />
          <Text text="{Binding Impact}" text-wrapping="Wrap" />
          <Text text="{Binding Risk}" text-wrapping="Wrap" />
          <Container Type="Wrap">
            <Button id="approval-previous" action="PreviousRequest" content="Previous" min-height="44" />
            <Button id="approval-next" action="NextRequest" content="Next" min-height="44" />
          </Container>
          <Container Type="Wrap">
            <Button id="approval-decline" action="Decline" content="Decline" min-height="44" />
            <Button id="approval-block" action="DeclineBlock" content="Decline and block caller" min-height="44" />
            <Button id="approval-accept" action="Accept" content="Accept once" min-height="44" />
            <Button id="approval-trust" action="Trust" content="Accept and trust for 30 days" min-height="44" />
          </Container>
          <Button id="approval-warning" action="ShowTrustWarning" content="Review extended trust options" min-height="44" />
          <Container margin="0,12,0,0" Type="Vertical Stack" Active="{Binding WarningVisible}">
            <Text id="approval-trust-warning" text="Always Trust can allow this caller to read, modify or destroy user data within the displayed action and scope without asking again. Review the caller and affected objects carefully. You can go back without granting trust, and revoke granted trust below." font-weight="SemiBold" text-wrapping="Wrap" />
            <Button id="approval-warning-back" action="BackFromTrustWarning" content="Go back" min-height="44" />
            <Button id="approval-always" action="ConfirmAlwaysTrust" content="I understand — accept and always trust" min-height="44" />
            <Text text="Temporary trust: choose a duration or an action limit." text-wrapping="Wrap" />
            <Input id="approval-minutes" accessible-name="Temporary trust duration in minutes" placeholder-text="Minutes" Type="Text" Value="{Binding Minutes, Mode=TwoWay}" />
            <Button id="approval-duration" action="TemporaryDuration" content="Accept with this duration" min-height="44" />
            <Input id="approval-action-count" accessible-name="Temporary trust action limit" placeholder-text="Action count" Type="Text" Value="{Binding Actions, Mode=TwoWay}" />
            <Button id="approval-actions" action="TemporaryActions" content="Accept with this action limit" min-height="44" />
            <Input id="approval-fallback" content="After temporary access ends, retain 30-day trust instead of returning to manual approval" Type="Checkbox" Checked="{Binding RetainTrust, Mode=TwoWay}" />
          </Container>
        </Container>
        <Text text="{Binding GrantCount}" margin="0,20,0,8" font-weight="SemiBold" />
        <Container Type="Vertical Stack" Active="{Binding HasGrant}">
          <Text text="{Binding GrantSummary}" text-wrapping="Wrap" />
          <Container Type="Wrap">
            <Button action="PreviousGrant" content="Previous grant" min-height="44" />
            <Button action="NextGrant" content="Next grant" min-height="44" />
            <Button id="approval-revoke" action="RevokeGrant" content="Revoke access" min-height="44" />
          </Container>
        </Container>
        <Text text="{Binding BlockedCount}" margin="0,20,0,8" font-weight="SemiBold" />
        <Container Type="Vertical Stack" Active="{Binding HasBlocked}">
          <Text text="{Binding BlockedSummary}" text-wrapping="Wrap" />
          <Container Type="Wrap">
            <Button action="PreviousBlocked" content="Previous caller" min-height="44" />
            <Button action="NextBlocked" content="Next caller" min-height="44" />
            <Button id="approval-unblock" action="UnblockCaller" content="Unblock caller" min-height="44" />
          </Container>
        </Container>
        <Text text="{Binding AuditSummary}" margin="0,20,0,0" text-wrapping="Wrap" />
      </Container>
    </Container>
  </Page>
</Cui>
