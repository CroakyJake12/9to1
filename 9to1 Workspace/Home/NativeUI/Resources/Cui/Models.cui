<Cui id="home.models" version="1">
  <Actions>
    <Action name="ChooseRoute" command="SelectRoute" parameter="{Binding route}" />
    <Action name="CandidateEarlier" command="Earlier" parameter="{Binding candidate}" />
    <Action name="CandidateLater" command="Later" parameter="{Binding candidate}" />
    <Action name="CandidateToggle" command="Toggle" parameter="{Binding candidate}" />
    <Action name="CandidateRemove" command="Remove" parameter="{Binding candidate}" />
    <Action name="CatalogueAdd" command="Add" parameter="{Binding model}" />
  </Actions>
  <Page>
    <Container Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
      <Container margin="20" Type="Vertical Stack">
        <Text text="Personal AI model routes" font-size="26" />
        <Text text="{Binding Selection}" font-size="18" />
        <Text text="{Binding Status}" text-wrapping="Wrap" accessible-name="Model service status" margin="0,8" />
        <Container Type="Wrap" Interactive="{Binding CanBrowse}">
          <Button content="Refresh" action="Refresh" />
          <Button content="Active" action="Category.Active" />
          <Button content="Background" action="Category.Background" />
          <Button content="Chat" action="Category.Chat" />
          <Button content="Image" action="Category.Image" />
          <Button content="Voice" action="Category.Voice" />
          <Button content="Audio" action="Category.Audio" />
          <Button content="Video" action="Category.Video" />
        </Container>
        <Repeat Source="{Binding Routes}" As="route" Key="{Binding route.RouteId}">
          <Button content="{Binding route.Label}" action="ChooseRoute" margin="0,2" />
        </Repeat>
        <Text text="Ordered candidates" font-size="20" margin="0,12" />
        <Repeat Source="{Binding Candidates}" As="candidate" Key="{Binding candidate.Identity}">
          <Container margin="0,4" Type="Vertical Stack">
            <Text text="{Binding candidate.Label}" />
            <Container Type="Wrap">
              <Text text="{Binding candidate.Order}" margin="8,4" />
              <Text text="{Binding candidate.Enabled}" margin="8,4" />
              <Button content="Earlier" action="CandidateEarlier" />
              <Button content="Later" action="CandidateLater" />
              <Button content="Enable or disable" action="CandidateToggle" />
              <Button content="Remove" action="CandidateRemove" />
            </Container>
          </Container>
        </Repeat>
        <Container Type="Wrap">
          <Button content="Save route" action="Save" Interactive="{Binding CanSave}" />
          <Button content="Discard edits" action="Discard" Interactive="{Binding CanDiscard}" />
          <Button content="Home permissions" action="HomePermissions" Interactive="{Binding CanApprove}" />
        </Container>
        <Button content="Finish original audit" action="FinishAudit" Interactive="{Binding CanFinishAudit}" />
        <Text text="{Binding AuditStatus}" text-wrapping="Wrap" accessible-name="Original model route audit status" />
        <Text text="{Binding Approval}" text-wrapping="Wrap" accessible-name="Pending Home approval" />
        <Text text="Preview the saved route using a capability reported by the catalogue. This checks eligibility without running a model." text-wrapping="Wrap" margin="0,8" />
        <Input id="model-capability" accessible-name="Required model capability" Type="Text" Interactive="{Binding CanBrowse}" Value="{Binding Capability, Mode=TwoWay}" />
        <Button content="Preview eligible selection" action="Preview" Interactive="{Binding CanPreview}" />
        <Text text="{Binding Preview}" text-wrapping="Wrap" accessible-name="Eligibility and fallback preview" />
        <Text text="Shared model catalogue" font-size="20" margin="0,12" />
        <Input id="model-query" accessible-name="Model catalogue query" Type="Text" Interactive="{Binding CanBrowse}" Value="{Binding Query, Mode=TwoWay}" />
        <Button content="Search catalogue" action="SearchCatalogue" Interactive="{Binding CanBrowse}" />
        <Text text="{Binding CatalogueStatus}" text-wrapping="Wrap" />
        <Repeat Source="{Binding Catalogue}" As="model" Key="{Binding model.Identity}">
          <Container margin="0,8" Type="Vertical Stack">
            <Text text="{Binding model.DisplayName}" font-size="16" />
            <Text text="{Binding model.Details}" text-wrapping="Wrap" />
            <Text text="{Binding model.Label}" />
            <Button content="Add to route" action="CatalogueAdd" Interactive="{Binding CanEdit}" />
          </Container>
        </Repeat>
      </Container>
    </Container>
  </Page>
</Cui>
