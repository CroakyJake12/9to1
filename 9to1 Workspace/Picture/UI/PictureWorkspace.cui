<Cui id="9to1.Picture.Workspace" version="1">
  <Actions>
    <Action name="CloseVectorSubpath" command="9to1.Picture.CloseVectorSubpath" parameter="{Binding OriginalVectorSubpathTarget}" />
    <Action name="OpenVectorSubpath" command="9to1.Picture.OpenVectorSubpath" parameter="{Binding OriginalVectorSubpathTarget}" />
    <Action name="SelectAddedVectorAnchor" command="9to1.Picture.SelectAddedVectorAnchor" parameter="{Binding AddedVectorAnchorTarget}" />
    <Action name="TransferVectorLayer" command="9to1.Picture.TransferVectorLayer" parameter="{Binding OriginalVectorLayerTransferTarget}" />
    <Action name="SelectLayer" command="9to1.Picture.SelectLayer" parameter="{Binding layer.Target}" />
    <Action name="SelectVector" command="9to1.Picture.SelectVector" parameter="{Binding vector.Target}" />
    <Action name="SelectVectorPath" command="9to1.Picture.SelectVectorPath" parameter="{Binding path.Target}" />
    <Action name="SelectVectorNode" command="9to1.Picture.SelectVectorNode" parameter="{Binding node.Target}" />
    <Action name="SelectEdit" command="9to1.Picture.SelectEdit" parameter="{Binding edit.Target}" />
  </Actions>
  <Page id="PictureEditor" AccessibleName="Picture image editor">
    <Container Type="Vertical Stack" VerticalScrolling="True" Margin="18" CellGap="12">
      <Text FontSize="28" FontWeight="Bold">Picture</Text>
      <Text TextWrapping="Wrap">Create, edit and export. Your original stays intact.</Text>
      <Container Type="Grid" ColumnSizes="1fr 1fr" RowSizes="Auto Auto">
        <Button id="NewButton" action="9to1.Picture.New" Margin="0,0,6,6">New</Button>
        <Button id="OpenButton" action="9to1.Picture.Open" Margin="6,0,0,6" Column="1">Open…</Button>
        <Button id="SaveButton" action="9to1.Picture.Save" Margin="0,0,6,0" Row="1" Interactive="False">Save</Button>
        <Button id="SaveCopyButton" action="9to1.Picture.SaveCopy" Margin="6,0,0,0" Row="1" Column="1" Interactive="False">Save a Copy…</Button>
      </Container>
      <Container Type="Grid" ColumnSizes="1fr 1fr" RowSizes="Auto Auto Auto">
        <Button id="UndoButton" action="9to1.Picture.Undo" Margin="0,0,6,6" Interactive="False">Undo</Button>
        <Button id="RedoButton" action="9to1.Picture.Redo" Margin="6,0,0,6" Column="1" Interactive="False">Redo</Button>
        <Container id="ComparisonOptions" Type="Wrap" Row="1" ColumnSpan="2">
          <Input Type="Checkbox" id="CompareButton" Margin="0,0,8,0" Content="Show original" AccessibleName="Show original image" Interactive="False" />
          <Input Type="Checkbox" id="SideBySideButton" Content="Side by side" AccessibleName="Compare original and current side by side" Interactive="False" />
        </Container>
        <Button id="PreviousButton" action="9to1.Picture.Previous" Margin="0,6,6,0" Row="2" Interactive="False">Previous image</Button>
        <Button id="NextButton" action="9to1.Picture.Next" Margin="6,6,0,0" Row="2" Column="1" Interactive="False">Next image</Button>
      </Container>
      <Container Type="Grid" ColumnSizes="Auto 1fr Auto Auto" RowSizes="Auto">
        <Button id="ZoomOutButton" action="9to1.Picture.ZoomOut" AccessibleName="Zoom out" Interactive="False">−</Button>
        <Text id="ZoomText" TextAlignment="Center" VerticalAlignment="Center" Column="1">100%</Text>
        <Button id="ZoomInButton" action="9to1.Picture.ZoomIn" AccessibleName="Zoom in" Column="2" Interactive="False">+</Button>
        <Button id="FitButton" action="9to1.Picture.Fit" Margin="6,0,0,0" Column="3" Interactive="False">Fit</Button>
      </Container>
      <Container Type="Grid" id="PictureWorkspace" ColumnSizes="{Binding WorkspaceColumns}" RowSizes="{Binding WorkspaceRows}">
        <Container Type="Grid" id="CanvasPanel" VerticalAlignment="Top" Height="{Binding CanvasHeight}" Background="{Resource CuiPanelBrush}" CornerRadius="12" ColumnSizes="{Binding ComparisonColumns}" RowSizes="Auto 1fr">
          <Text id="ComparisonLeftLabel" Text="{Binding ComparisonLeftLabel}" Margin="12,8" Active="{Binding HasComparisonPreview}" />
          <Text id="ComparisonRightLabel" Text="{Binding ComparisonRightLabel}" Margin="12,8" Column="1" Active="{Binding HasSideBySideComparison}" />
          <Object Type="picture.originalViewport" id="OriginalComparisonImage" Margin="6" AccessibleName="Original image for side-by-side comparison. Use the zoom buttons or drag to pan." Row="1" Active="False" />
          <Object Type="picture.viewport" id="PreviewImage" Margin="6" AccessibleName="Image preview. The label identifies original or current. Use the zoom buttons or drag to pan." Column="{Binding CurrentPreviewColumn, type=int}" Row="1" Active="False" />
          <Container Type="Vertical Stack" id="EmptyState" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Row="1">
            <Text FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">Make room for your next image</Text>
            <Text TextWrapping="Wrap" TextAlignment="Center">Open a photo or editable Picture document, or start a new canvas.</Text>
          </Container>
        </Container>
        <Container Type="Vertical Stack" id="PictureInspector" VerticalAlignment="Top" Margin="{Binding InspectorMargin}" Column="{Binding InspectorColumn, type=int}" Row="{Binding InspectorRow, type=int}" CellGap="8">
          <Text FontSize="18" FontWeight="SemiBold">Transform</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr" RowSizes="Auto Auto">
            <Button id="RotateLeftButton" action="9to1.Picture.RotateLeft" Margin="0,0,4,6" Interactive="False">Rotate left</Button>
            <Button id="RotateRightButton" action="9to1.Picture.RotateRight" Margin="4,0,0,6" Column="1" Interactive="False">Rotate right</Button>
            <Button id="FlipHorizontalButton" action="9to1.Picture.FlipHorizontal" Margin="0,0,4,0" Row="1" Interactive="False">Flip horizontal</Button>
            <Button id="FlipVerticalButton" action="9to1.Picture.FlipVertical" Margin="4,0,0,0" Row="1" Column="1" Interactive="False">Flip vertical</Button>
          </Container>
          <Text>Straighten · clockwise angle</Text>
          <Input Type="Number" id="StraightenAngleBox" Value="0" AccessibleName="Clockwise straighten angle in degrees; negative rotates left" />
          <Input id="StraightenCanvasModeBox" AccessibleName="Rotated image canvas fit" Type="Select" />
          <Text TextWrapping="Wrap">Fit the entire rotated image, or keep the canvas and clip its edges. Added space is transparent; the original stays editable.</Text>
          <Button id="ApplyStraightenButton" action="9to1.Picture.Straighten" Interactive="False">Apply angle</Button>
          <Text>Crop · x, y, width, height</Text>
          <Input Type="Text" id="CropBoundsBox" PlaceholderText="0, 0, 1200, 900" AccessibleName="Crop bounds in current image pixels" />
          <Input id="CropRatioBox" AccessibleName="Crop aspect ratio" Type="Select" />
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Input Type="Number" id="CropRatioWidthBox" Value="1" AccessibleName="Custom crop ratio width; positive whole number" Margin="0,0,4,0" />
            <Input Type="Number" id="CropRatioHeightBox" Value="1" AccessibleName="Custom crop ratio height; positive whole number" Margin="4,0,0,0" Column="1" />
          </Container>
          <Text TextWrapping="Wrap">For a custom ratio, enter width and height above, such as 3 and 2.</Text>
          <Button id="FitCropRatioButton" action="9to1.Picture.FitCropRatio" Interactive="False">Fit ratio inside crop bounds</Button>
          <Text id="CropRatioNotice" TextWrapping="Wrap">Fit a ratio inside these bounds, or apply crop directly. Whole-pixel rounding may slightly change the ratio.</Text>
          <Button id="ApplyCropButton" action="9to1.Picture.Crop" Interactive="False">Apply crop</Button>
          <Text FontWeight="SemiBold">Pixelate these bounds</Text>
          <Text TextWrapping="Wrap">Use the x, y, width and height above. Pixelation stays editable; the original image is preserved.</Text>
          <Input Type="Number" id="PixelationBlockSizeBox" Value="8" AccessibleName="Pixelation block size in whole pixels, two to five hundred twelve" />
          <Button id="ApplyPixelationButton" action="9to1.Picture.Pixelate" Interactive="False">Pixelate rectangle</Button>
          <Text FontSize="18" FontWeight="SemiBold">Blur rectangle</Text>
          <Text TextWrapping="Wrap">Soften this area while keeping the original and the pixels outside it. Enter x, y, width, height in image pixels.</Text>
          <Input Type="Text" id="BlurBoundsBox" AccessibleName="Blur rectangle in pixels, x, y, width, height" Value="0, 0, 1, 1" />
          <Text>Blur radius · pixels</Text>
          <Input Type="Number" id="BlurRadiusBox" Value="2" AccessibleName="Blur radius in whole pixels, one to thirty-two" />
          <Text id="BlurDraftNotice" Text="{Binding BlurDraftNotice}" TextWrapping="Wrap" />
          <Button id="ApplyBlurButton" action="9to1.Picture.Blur" Interactive="False">Add blur to rectangle</Button>
          <Button id="ResetBlurDraftButton" action="9to1.Picture.ResetBlurDraft" Interactive="False">Use current image or selected blur values</Button>
          <Text TextWrapping="Wrap" Active="{Binding SelectedIsBlur}">Change these values, then apply values to the selected edit.</Text>
          <Text>Image size · width × height</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Input Type="Number" id="WidthBox" Value="1200" AccessibleName="Image width in pixels" Margin="0,0,4,0" />
            <Input Type="Number" id="HeightBox" Value="900" AccessibleName="Image height in pixels" Margin="4,0,0,0" Column="1" />
          </Container>
          <Container Type="Grid" ColumnSizes="Auto 1fr">
            <Input Type="Checkbox" id="AspectLockBox" AccessibleName="Keep aspect ratio" Checked="True" />
            <Text VerticalAlignment="Center" Column="1">Keep aspect ratio</Text>
          </Container>
          <Button id="ResizeButton" action="9to1.Picture.Resize" Interactive="False">Resize image</Button>
          <Text FontSize="18" FontWeight="SemiBold">Canvas size</Text>
          <Text TextWrapping="Wrap">Add transparent space or trim the canvas without resizing the image. The original remains editable.</Text>
          <Text>Canvas width × height</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Input Type="Number" id="CanvasWidthBox" Value="1200" AccessibleName="Canvas width in pixels" Margin="0,0,4,0" />
            <Input Type="Number" id="CanvasHeightBox" Value="900" AccessibleName="Canvas height in pixels" Margin="4,0,0,0" Column="1" />
          </Container>
          <Text>Image placement · x, y</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Input Type="Number" id="CanvasOffsetXBox" Value="0" AccessibleName="Image x placement on the new canvas in pixels" Margin="0,0,4,0" />
            <Input Type="Number" id="CanvasOffsetYBox" Value="0" AccessibleName="Image y placement on the new canvas in pixels" Margin="4,0,0,0" Column="1" />
          </Container>
          <Button id="CenterCanvasContentButton" action="9to1.Picture.CenterCanvasContent" Interactive="False">Center image in new canvas</Button>
          <Button id="ResizeCanvasButton" action="9to1.Picture.ResizeCanvas" Interactive="False">Apply canvas size</Button>
          <Text TextWrapping="Wrap" Active="{Binding SelectedIsCanvasResize}">Edit the canvas size and placement above, then apply values to the selected edit.</Text>
          <Button id="RevertButton" action="9to1.Picture.Revert" Interactive="False">Revert to original</Button>
          <Text FontSize="18" FontWeight="SemiBold">Light and colour</Text>
          <Text TextWrapping="Wrap">Choose a working colour space for these adjustments. sRGB creates a standard-range image.</Text>
          <Input id="ColorWorkingSpaceBox" AccessibleName="Working colour space for raster adjustments" Type="Select" />
          <Text>Exposure · EV</Text>
          <Input Type="Number" id="ColorExposureBox" Value="0" AccessibleName="Exposure in stops from minus ten to ten" />
          <Text>Brightness · −1 to 1</Text>
          <Input Type="Number" id="ColorBrightnessBox" Value="0" AccessibleName="Linear brightness adjustment from minus one to one" />
          <Text>Contrast · −1 to 1</Text>
          <Input Type="Number" id="ColorContrastBox" Value="0" AccessibleName="Contrast adjustment from minus one to one" />
          <Text>Saturation · −1 to 1</Text>
          <Input Type="Number" id="ColorSaturationBox" Value="0" AccessibleName="Saturation adjustment; minus one is greyscale, zero preserves colour, one doubles saturation" />
          <Text>Gamma · 0.1 to 10</Text>
          <Input Type="Number" id="ColorGammaBox" Value="1" AccessibleName="Display gamma adjustment from zero point one to ten" />
          <Button id="ApplyColorAdjustmentButton" action="9to1.Picture.ApplyColorAdjustment" Interactive="False">Apply light and colour</Button>
          <Button id="ResetColorDraftButton" action="9to1.Picture.ResetColorDraft" Interactive="False">Reset adjustment values</Button>
          <Text TextWrapping="Wrap" Active="{Binding SelectedIsColorAdjustment}">Edit these values, then apply values to the selected edit.</Text>
          <Text FontSize="18" FontWeight="SemiBold">Export</Text>
          <Text id="MetadataExportModeText" TextWrapping="Wrap" AccessibleName="Export metadata privacy">Preserve supported metadata</Text>
          <Button id="MetadataPreserveButton" action="9to1.Picture.MetadataPreserve">Preserve supported metadata</Button>
          <Button id="MetadataRemoveLocationButton" action="9to1.Picture.MetadataRemoveLocation">Remove location metadata</Button>
          <Button id="MetadataRemoveAllButton" action="9to1.Picture.MetadataRemoveAll">Remove all metadata</Button>
          <Button id="ExportCropButton" action="9to1.Picture.Export" Interactive="False">Export PNG…</Button>
          <Text TextWrapping="Wrap">Save keeps the editable document. Export creates a rendered copy.</Text>
          <Text FontSize="18" FontWeight="SemiBold">Layers and shapes</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr" RowSizes="Auto Auto Auto">
            <Button id="AddRectangleButton" action="9to1.Picture.AddRectangle" Margin="0,0,4,4" Interactive="{Binding CanInsertShape}">Rectangle</Button>
            <Button id="AddEllipseButton" action="9to1.Picture.AddEllipse" Margin="4,0,0,4" Interactive="{Binding CanInsertShape}" Column="1">Ellipse</Button>
            <Button id="AddPolygonButton" action="9to1.Picture.AddPolygon" Margin="0,0,4,4" Interactive="{Binding CanInsertShape}" Row="1">Polygon</Button>
            <Button id="AddStarButton" action="9to1.Picture.AddStar" Margin="4,0,0,4" Interactive="{Binding CanInsertShape}" Row="1" Column="1">Star</Button>
            <Button id="AddLineButton" action="9to1.Picture.AddLine" Margin="0,0,4,0" Interactive="{Binding CanInsertShape}" Row="2">Line</Button>
            <Button id="AddArrowButton" action="9to1.Picture.AddArrow" Margin="4,0,0,0" Interactive="{Binding CanInsertShape}" Row="2" Column="1">Arrow</Button>
          </Container>
          <Text>Polygon sides / star points</Text>
          <Input Type="Number" id="PrimitivePointCountBox" Value="5" AccessibleName="Polygon sides or star points, from three to sixty-four" />
          <Button id="AddSharedVectorButton" action="9to1.Picture.AddSharedVector" Interactive="{Binding CanInsertShape}">Add custom shape</Button>
          <Text id="CompositionStatusText" Text="{Binding CompositionStatus}" TextWrapping="Wrap" />
          <Repeat Source="{Binding LayerRows}" As="layer" Key="{Binding layer.Key}">
            <Button action="SelectLayer" Content="{Binding layer.Label}" Interactive="{Binding CanCompose}" />
          </Repeat>
          <Input Type="Text" id="LayerNameBox" AccessibleName="Layer name" Value="Objects" />
          <Button id="CreateLayerButton" action="9to1.Picture.CreateLayer" Interactive="{Binding CanCompose}">Create layer</Button>
          <Button id="RenameLayerButton" action="9to1.Picture.RenameLayer" Interactive="{Binding CanChangeLayer}">Rename selected layer</Button>
          <Button id="ToggleLayerVisibilityButton" action="9to1.Picture.ToggleLayerVisibility" Content="{Binding LayerVisibilityLabel}" Interactive="{Binding CanChangeLayer}" />
          <Button id="ToggleLayerLockButton" action="9to1.Picture.ToggleLayerLock" Content="{Binding LayerLockLabel}" Interactive="{Binding CanChangeLayer}" />
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Button id="MoveLayerEarlierButton" action="9to1.Picture.MoveLayerEarlier" Margin="0,0,4,0" Interactive="{Binding CanMoveLayerEarlier}">Move layer earlier</Button>
            <Button id="MoveLayerLaterButton" action="9to1.Picture.MoveLayerLater" Margin="4,0,0,0" Interactive="{Binding CanMoveLayerLater}" Column="1">Move layer later</Button>
          </Container>
          <Repeat Source="{Binding VectorRows}" As="vector" Key="{Binding vector.Key}">
            <Button action="SelectVector" Content="{Binding vector.Label}" Interactive="{Binding CanCompose}" />
          </Repeat>
          <Text Text="{Binding SelectedVectorLabel}" TextWrapping="Wrap" />
          <Container Type="Grid" ColumnSizes="1fr 1fr" RowSizes="Auto Auto">
            <Input Type="Number" id="VectorXBox" Value="0" AccessibleName="Shape x in original image pixels" Margin="0,0,4,4" />
            <Input Type="Number" id="VectorYBox" Value="0" AccessibleName="Shape y in original image pixels" Margin="4,0,0,4" Column="1" />
            <Input Type="Number" id="VectorWidthBox" Value="100" AccessibleName="Shape width in original image pixels" Margin="0,4,4,0" Row="1" />
            <Input Type="Number" id="VectorHeightBox" Value="100" AccessibleName="Shape height in original image pixels" Margin="4,4,0,0" Row="1" Column="1" />
          </Container>
          <Button id="ApplyVectorPlacementButton" action="9to1.Picture.ApplyVectorPlacement" Interactive="{Binding CanChangeVector}">Apply shape position and size</Button>
          <Text FontWeight="SemiBold">Shape rotation and mirroring</Text>
          <Input Type="Number" id="VectorRotationBox" Value="0" AccessibleName="Selected shape clockwise angle in degrees; negative rotates left" />
          <Text id="VectorTransformNotice" Text="{Binding VectorTransformNotice}" TextWrapping="Wrap" />
          <Button id="ApplyVectorRotationButton" action="9to1.Picture.RotateVector" Interactive="{Binding CanApplyVectorRotation}">Apply shape angle</Button>
          <Button id="ResetVectorRotationButton" action="9to1.Picture.ResetVectorRotation" Interactive="{Binding CanResetVectorRotation}">Reset angle to selected shape</Button>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Button id="MirrorVectorHorizontalButton" action="9to1.Picture.MirrorVectorHorizontal" Margin="0,0,4,0" Interactive="{Binding CanMirrorVectorHorizontal}">Mirror shape horizontally</Button>
            <Button id="MirrorVectorVerticalButton" action="9to1.Picture.MirrorVectorVertical" Margin="4,0,0,0" Interactive="{Binding CanMirrorVectorVertical}" Column="1">Mirror shape vertically</Button>
          </Container>
          <Repeat Source="{Binding VectorPathRows}" As="path" Key="{Binding path.Key}">
            <Button action="SelectVectorPath" Content="{Binding path.Label}" Interactive="{Binding CanChangeVector}" />
          </Repeat>
          <Text>Move selected shape to a layer</Text>
          <Input id="VectorDestinationLayerBox" AccessibleName="Destination layer for selected shape" Type="Select" Interactive="{Binding CanChooseVectorLayerDestination}" />
          <Text id="VectorLayerTransferNotice" Text="{Binding VectorLayerTransferNotice}" TextWrapping="Wrap" />
          <Button id="TransferVectorLayerButton" action="TransferVectorLayer" Interactive="{Binding CanTransferVectorLayer}">Move shape to chosen layer</Button>
          <Button id="ResetVectorLayerDestinationButton" action="9to1.Picture.ResetVectorLayerDestination" Interactive="{Binding CanResetVectorLayerDestination}">Choose a destination for current shape</Button>
          <Text FontWeight="SemiBold">Path fill</Text>
          <Input id="VectorFillKindBox" AccessibleName="Selected path fill, solid or none" Type="Select" Interactive="{Binding CanChangeVectorPath}" />
          <Input Type="Text" id="VectorFillBox" AccessibleName="Selected path fill colour, hexadecimal RRGGBB or AARRGGBB" Value="#006FB9" Interactive="{Binding CanChangeVectorPath}" />
          <Text>Opacity</Text>
          <Input Type="Number" id="VectorFillOpacityBox" Value="1" AccessibleName="Selected path fill opacity, zero to one" Interactive="{Binding CanChangeVectorPath}" />
          <Text>Overlapping contours</Text>
          <Input id="VectorFillRuleBox" AccessibleName="Selected path contour fill rule" Type="Select" Interactive="{Binding CanChangeVectorPath}" />
          <Text id="VectorFillNotice" Text="{Binding VectorFillNotice}" TextWrapping="Wrap" />
          <Button id="ApplyVectorFillButton" action="9to1.Picture.ApplyVectorFill" Interactive="{Binding CanApplyVectorFill}">Apply path fill</Button>
          <Button id="ResetVectorFillButton" action="9to1.Picture.ResetVectorFill" Interactive="{Binding CanResetVectorFill}">Reset fill to selected path</Button>
          <Text FontWeight="SemiBold">Selected path stroke</Text>
          <Input Type="Checkbox" id="VectorStrokeEnabledBox" Content="Show stroke" AccessibleName="Show selected shape path stroke" Interactive="{Binding CanChangeVectorPath}" />
          <Input Type="Text" id="VectorStrokeColorBox" AccessibleName="Stroke colour, hexadecimal RRGGBB or AARRGGBB" Value="#202020" Interactive="{Binding CanChangeVectorPath}" />
          <Text>Stroke width · opacity</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Input Type="Number" id="VectorStrokeWidthBox" Value="1" AccessibleName="Stroke width in shape view-box units" Margin="0,0,4,0" Interactive="{Binding CanChangeVectorPath}" />
            <Input Type="Number" id="VectorStrokeOpacityBox" Value="1" AccessibleName="Stroke opacity, zero to one" Margin="4,0,0,0" Interactive="{Binding CanChangeVectorPath}" Column="1" />
          </Container>
          <Text>Line ends · corner joins</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Input id="VectorStrokeCapBox" AccessibleName="Selected path stroke line cap" Margin="0,0,4,0" Type="Select" Interactive="{Binding CanChangeVectorPath}" />
            <Input id="VectorStrokeJoinBox" AccessibleName="Selected path stroke corner join" Margin="4,0,0,0" Type="Select" Interactive="{Binding CanChangeVectorPath}" Column="1" />
          </Container>
          <Text id="VectorStrokeNotice" Text="{Binding VectorStrokeNotice}" TextWrapping="Wrap" />
          <Button id="ApplyVectorStrokeButton" action="9to1.Picture.ApplyVectorStroke" Interactive="{Binding CanApplyVectorStroke}">Apply path stroke</Button>
          <Button id="ResetVectorStrokeButton" action="9to1.Picture.ResetVectorStroke" Interactive="{Binding CanResetVectorStroke}">Reset stroke to selected path</Button>
          <Text Text="{Binding SelectedVectorNodeLabel}" TextWrapping="Wrap" />
          <Text FontWeight="SemiBold">New anchor after this point</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Input Type="Number" id="NewVectorAnchorXBox" Value="0" AccessibleName="New anchor local X coordinate" Margin="0,0,4,0" Interactive="{Binding CanChangeVectorNode}" />
            <Input Type="Number" id="NewVectorAnchorYBox" Value="0" AccessibleName="New anchor local Y coordinate" Margin="4,0,0,0" Interactive="{Binding CanChangeVectorNode}" Column="1" />
          </Container>
          <Text id="VectorAnchorNotice" Text="{Binding VectorAnchorNotice}" TextWrapping="Wrap" />
          <Button id="AddVectorAnchorButton" action="9to1.Picture.AddVectorAnchor" Interactive="{Binding CanAddVectorAnchor}">Add anchor after selected point</Button>
          <Button id="ResetVectorAnchorButton" action="9to1.Picture.ResetVectorAnchor" Interactive="{Binding CanResetVectorAnchor}">Reset new point to current anchor</Button>
          <Button id="SelectAddedVectorAnchorButton" action="SelectAddedVectorAnchor" Interactive="{Binding CanSelectAddedVectorAnchor}">Select newly added anchor</Button>
          <Button id="DeleteVectorAnchorButton" action="9to1.Picture.DeleteVectorAnchor" Interactive="{Binding CanDeleteVectorAnchor}">Remove selected anchor</Button>
          <Text id="VectorSubpathLabel" Text="{Binding VectorSubpathLabel}" TextWrapping="Wrap" />
          <Button id="CloseVectorSubpathButton" action="CloseVectorSubpath" Interactive="{Binding CanCloseVectorSubpath}">Close selected subpath</Button>
          <Button id="OpenVectorSubpathButton" action="OpenVectorSubpath" Interactive="{Binding CanOpenVectorSubpath}">Open selected subpath</Button>
          <Text FontWeight="SemiBold">Incoming segment</Text>
          <Button id="VectorSegmentLineButton" action="9to1.Picture.VectorSegmentLine" Interactive="{Binding CanConvertVectorSegmentLine}">Make straight line</Button>
          <Button id="VectorSegmentQuadraticButton" action="9to1.Picture.VectorSegmentQuadratic" Interactive="{Binding CanConvertVectorSegmentQuadratic}">Make quadratic curve</Button>
          <Button id="VectorSegmentCubicButton" action="9to1.Picture.VectorSegmentCubic" Interactive="{Binding CanConvertVectorSegmentCubic}">Make cubic curve</Button>
          <Text TextWrapping="Wrap">New curve controls start along the existing segment. Retained controls stay available when switching segment type.</Text>
          <Repeat Source="{Binding VectorNodeRows}" As="node" Key="{Binding node.Key}">
            <Button action="SelectVectorNode" Content="{Binding node.Label}" Interactive="{Binding node.CanChoose}" />
          </Repeat>
          <Text Text="{Binding VectorNodePageLabel}" />
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Button id="PreviousVectorNodePageButton" action="9to1.Picture.PreviousVectorNodePage" Margin="0,0,4,0" Interactive="{Binding CanPreviousVectorNodePage}">Previous nodes</Button>
            <Button id="NextVectorNodePageButton" action="9to1.Picture.NextVectorNodePage" Margin="4,0,0,0" Interactive="{Binding CanNextVectorNodePage}" Column="1">Next nodes</Button>
          </Container>
          <Text>Node position · local x, y</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Input Type="Number" id="VectorNodeXBox" Value="0" AccessibleName="Selected vector node local x" Margin="0,0,4,0" />
            <Input Type="Number" id="VectorNodeYBox" Value="0" AccessibleName="Selected vector node local y" Margin="4,0,0,0" Column="1" />
          </Container>
          <Button id="ApplyVectorNodeButton" action="9to1.Picture.ApplyVectorNode" Interactive="{Binding CanChangeVectorNode}">Apply node position</Button>
          <Text>First curve control · local x, y</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Input Type="Number" id="VectorControl1XBox" Value="0" AccessibleName="First curve control local x" Margin="0,0,4,0" />
            <Input Type="Number" id="VectorControl1YBox" Value="0" AccessibleName="First curve control local y" Margin="4,0,0,0" Column="1" />
          </Container>
          <Button id="ApplyVectorControl1Button" action="9to1.Picture.ApplyVectorControl1" Interactive="{Binding CanChangeVectorControl1}">Apply first curve control</Button>
          <Text>Second curve control · local x, y</Text>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Input Type="Number" id="VectorControl2XBox" Value="0" AccessibleName="Second curve control local x" Margin="0,0,4,0" />
            <Input Type="Number" id="VectorControl2YBox" Value="0" AccessibleName="Second curve control local y" Margin="4,0,0,0" Column="1" />
          </Container>
          <Button id="ApplyVectorControl2Button" action="9to1.Picture.ApplyVectorControl2" Interactive="{Binding CanChangeVectorControl2}">Apply second curve control</Button>
          <Text Text="{Binding CompositionRetainedProperties}" TextWrapping="Wrap" />
          <Text FontSize="18" FontWeight="SemiBold">History</Text>
          <Text id="HistoryStateText" Text="{Binding HistoryState}" TextWrapping="Wrap" />
          <Text id="HistoryRetentionNoticeText" Text="{Binding HistoryRetentionNotice}" TextWrapping="Wrap" Active="{Binding HasHistoryRetentionNotice}" />
          <Text FontSize="18" FontWeight="SemiBold">Raster adjustments</Text>
          <Text id="HistoryText" TextWrapping="Wrap">No edits yet</Text>
          <Repeat Source="{Binding OperationRows}" As="edit" Key="{Binding edit.Key}">
            <Button action="SelectEdit" Content="{Binding edit.Label}" Interactive="{Binding CanChooseOperation}" />
          </Repeat>
          <Text id="SelectedEditLabel" Text="{Binding SelectedEditLabel}" TextWrapping="Wrap" AccessibleName="Selected raster edit" />
          <Text TextWrapping="Wrap" Active="{Binding SelectedUsesTransformFields}">Change the crop or image size above, then apply those values to this selected edit.</Text>
          <Text TextWrapping="Wrap" Active="{Binding SelectedIsPixelation}">Change the bounds and block size above, then apply values to the selected edit.</Text>
          <Text TextWrapping="Wrap" Active="{Binding SelectedIsStraighten}">Change the angle and canvas fit above, then apply values to this selected edit.</Text>
          <Text Active="{Binding SelectedIsRotation}">Clockwise quarter turns · 1, 2 or 3</Text>
          <Input Type="Number" id="SelectedRotationTurns" Value="1" AccessibleName="Selected rotation in clockwise quarter turns" Active="{Binding SelectedIsRotation}" />
          <Container Type="Grid" ColumnSizes="Auto 1fr" Active="{Binding SelectedIsFlip}">
            <Input Type="Checkbox" id="SelectedFlipHorizontal" AccessibleName="Selected flip is horizontal" />
            <Text VerticalAlignment="Center" Column="1">Horizontal flip; clear for vertical</Text>
          </Container>
          <Button id="ReplaceSelectedEditButton" action="9to1.Picture.ReplaceSelectedEdit" Interactive="{Binding CanChangeOperation}">Apply values to selected edit</Button>
          <Container Type="Grid" ColumnSizes="1fr 1fr">
            <Button id="MoveEditEarlierButton" action="9to1.Picture.MoveEditEarlier" Margin="0,0,4,0" Interactive="{Binding CanMoveOperationEarlier}">Move earlier</Button>
            <Button id="MoveEditLaterButton" action="9to1.Picture.MoveEditLater" Margin="4,0,0,0" Interactive="{Binding CanMoveOperationLater}" Column="1">Move later</Button>
          </Container>
          <Button id="RemoveSelectedEditButton" action="9to1.Picture.RemoveSelectedEdit" Interactive="{Binding CanChangeOperation}">Remove selected edit</Button>
        </Container>
      </Container>
      <Text id="StatusText" TextWrapping="Wrap" AccessibleName="Picture operation status">Open an image or create a canvas to begin.</Text>
      <Text id="FileNameText" FontWeight="SemiBold" TextWrapping="Wrap">Nothing selected</Text>
      <Text id="MetadataText" TextWrapping="Wrap">—</Text>
      <Button id="InfoButton" action="9to1.Picture.Info" AccessibleName="View image metadata" Interactive="False">Info</Button>
    </Container>
  </Page>
</Cui>
