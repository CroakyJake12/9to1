<Cui id="9to1.Wave.Workspace" version="1">
  <Page>
    <Container id="WaveScroll" Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
      <Container Type="Vertical Stack" Margin="16" CellGap="10">
        <Text Text="{Binding ProjectLabel}" FontSize="24" FontWeight="SemiBold" />
        <Text Text="{Binding AudioConfiguration}" />
        <Container Type="Grid" ColumnSizes="1fr 1fr 1fr" RowSizes="Auto Auto">
          <Button id="WaveSaveButton" action="9to1.Wave.Save" Margin="0,0,4,4" Interactive="{Binding CanSave}">Save</Button>
          <Button id="WaveUndoButton" action="9to1.Wave.Undo" Margin="4,0,4,4" Interactive="{Binding CanUndo}" Column="1">Undo</Button>
          <Button id="WaveRedoButton" action="9to1.Wave.Redo" Margin="4,0,0,4" Interactive="{Binding CanRedo}" Column="2">Redo</Button>
          <Button id="WaveImportButton" action="9to1.Wave.Import" Margin="0,4,4,0" Interactive="{Binding CanImport}" Row="1">Add audio from Files</Button>
          <Button id="WaveExportButton" action="9to1.Wave.Export" Margin="4,4,0,0" Interactive="{Binding CanExport}" Row="1" Column="1" ColumnSpan="2">Export rendered mix</Button>
        </Container>
        <Text Text="{Binding SourceStatus}" TextWrapping="Wrap" />
        <Container Type="Grid" ColumnSizes="{Binding WorkspaceColumns}" RowSizes="{Binding WorkspaceRows}">
          <Container Type="Vertical Stack" Margin="0,8,10,8" CellGap="6">
            <Text FontSize="18" FontWeight="SemiBold">Tracks and mixer</Text>
            <Input id="WaveTrackSelector" ItemsSource="{Binding TrackNames}" SelectedIndex="{Binding TrackIndex, mode=TwoWay, type=int}" AccessibleName="Audio track" Type="Select" Interactive="{Binding CanEdit}" />
            <Input Type="Text" id="WaveTrackNameBox" AccessibleName="New audio track name" Value="{Binding TrackName, mode=TwoWay}" />
            <Button id="WaveAddTrackButton" action="9to1.Wave.AddTrack" Interactive="{Binding CanEdit}">Add track</Button>
            <Text>Track gain</Text>
            <Input Type="Text" id="WaveTrackGainBox" AccessibleName="Track linear gain, zero to sixty-four" Value="{Binding TrackGain, mode=TwoWay}" />
            <Text>Pan</Text>
            <Input Type="Text" id="WaveTrackPanBox" AccessibleName="Track pan, minus one left to one right" Value="{Binding TrackPan, mode=TwoWay}" />
            <Input Type="Checkbox" id="WaveMuteCheck" Content="Mute track" AccessibleName="Mute selected track" Checked="{Binding TrackMute, mode=TwoWay, type=bool}" />
            <Input Type="Checkbox" id="WaveSoloCheck" Content="Solo track" AccessibleName="Solo selected track" Checked="{Binding TrackSolo, mode=TwoWay, type=bool}" />
            <Button id="WaveMixerButton" action="9to1.Wave.Mixer" Interactive="{Binding CanEdit}">Apply track mix</Button>
          </Container>
          <Container Type="Vertical Stack" Margin="0,8,10,8" Column="{Binding TimelineColumn, type=int}" Row="{Binding TimelineRow, type=int}" CellGap="6">
            <Text FontSize="18" FontWeight="SemiBold">Multitrack timeline</Text>
            <Text Text="{Binding PlayheadText}" AccessibleName="Timeline position" />
            <Input Type="Text" id="WavePlayheadBox" AccessibleName="Timeline playhead audio frame" Value="{Binding PlayheadFrame, mode=TwoWay}" />
            <Container Type="Grid" ColumnSizes="1fr 1fr" RowSizes="Auto Auto">
              <Button id="WaveStartButton" action="9to1.Wave.Start">Start</Button>
              <Button id="WaveEndButton" action="9to1.Wave.End" Column="1">End</Button>
              <Button id="WavePreviousMarkerButton" action="9to1.Wave.PreviousMarker" Row="1">Previous marker</Button>
              <Button id="WaveNextMarkerButton" action="9to1.Wave.NextMarker" Row="1" Column="1">Next marker</Button>
            </Container>
            <Object Type="wave.timeline" id="WaveTimeline" Height="{Binding TimelineHeight, type=double}" AccessibleName="Audio multitrack timeline. Select clips with the clip selector or pointer. Arrow keys move the playhead by one audio frame." />
            <Text FontWeight="SemiBold">Original audio preview</Text>
            <Text Text="{Binding SourcePreviewStatus}" TextWrapping="Wrap" />
            <Text Text="{Binding SourcePreviewPosition}" AccessibleName="Original audio preview position" />
            <Container Type="Grid" ColumnSizes="1fr 1fr 1fr" RowSizes="Auto Auto">
              <Button id="WaveSourcePlayButton" action="9to1.Wave.SourcePlay">Play source</Button>
              <Button id="WaveSourcePauseButton" action="9to1.Wave.SourcePause" Column="1">Pause</Button>
              <Button id="WaveSourceStopButton" action="9to1.Wave.SourceStop" Column="2">Stop</Button>
              <Button id="WaveSourceSeekButton" action="9to1.Wave.SourceSeek" Row="1" ColumnSpan="3">Seek source to playhead</Button>
            </Container>
            <Text>Marker at playhead</Text>
            <Input Type="Text" id="WaveMarkerNameBox" AccessibleName="Marker name" Value="{Binding MarkerName, mode=TwoWay}" />
            <Button id="WaveAddMarkerButton" action="9to1.Wave.AddMarker" Interactive="{Binding CanEdit}">Add marker</Button>
            <Input ItemsSource="{Binding MarkerNames}" AccessibleName="Current timeline markers" Type="Select" />
            <Text>Region name / start frame / duration</Text>
            <Input Type="Text" id="WaveRegionNameBox" AccessibleName="Region name" Value="{Binding RegionName, mode=TwoWay}" />
            <Input Type="Text" id="WaveRegionStartBox" AccessibleName="Region start audio frame" Value="{Binding RegionStart, mode=TwoWay}" />
            <Input Type="Text" id="WaveRegionDurationBox" AccessibleName="Region duration in audio frames" Value="{Binding RegionDuration, mode=TwoWay}" />
            <Button id="WaveAddRegionButton" action="9to1.Wave.AddRegion" Interactive="{Binding CanEdit}">Add region</Button>
            <Input ItemsSource="{Binding RegionNames}" AccessibleName="Current timeline regions" Type="Select" />
          </Container>
          <Container Type="Vertical Stack" Margin="0,8,0,8" Column="{Binding InspectorColumn, type=int}" Row="{Binding InspectorRow, type=int}" CellGap="6">
            <Text FontSize="18" FontWeight="SemiBold">Clip inspector</Text>
            <Input id="WaveClipSelector" ItemsSource="{Binding ClipNames}" SelectedIndex="{Binding ClipIndex, mode=TwoWay, type=int}" AccessibleName="Selected audio clip" Type="Select" Interactive="{Binding CanEdit}" />
            <Text Text="{Binding Selection}" TextWrapping="Wrap" />
            <Text>Timeline start frame</Text>
            <Input Type="Text" id="WaveClipStartBox" AccessibleName="Clip timeline start audio frame" Value="{Binding ClipStart, mode=TwoWay}" />
            <Container Type="Grid" ColumnSizes="1fr 1fr">
              <Button id="WaveMoveButton" action="9to1.Wave.Move" Interactive="{Binding CanEditClip}">Move</Button>
              <Button id="WaveDuplicateButton" action="9to1.Wave.Duplicate" Interactive="{Binding CanEditClip}" Column="1">Duplicate</Button>
            </Container>
            <Text>Frames to trim from start / end</Text>
            <Input Type="Text" id="WaveTrimStartBox" AccessibleName="Audio frames to trim from clip start" Value="{Binding TrimStart, mode=TwoWay}" />
            <Input Type="Text" id="WaveTrimEndBox" AccessibleName="Audio frames to trim from clip end" Value="{Binding TrimEnd, mode=TwoWay}" />
            <Button id="WaveTrimButton" action="9to1.Wave.Trim" Interactive="{Binding CanEditClip}">Trim clip</Button>
            <Container Type="Grid" ColumnSizes="1fr 1fr">
              <Button id="WaveSplitButton" action="9to1.Wave.Split" Interactive="{Binding CanEditClip}">Split at playhead</Button>
              <Button id="WaveJoinButton" action="9to1.Wave.Join" Interactive="{Binding CanEditClip}" Column="1">Join adjacent clip</Button>
            </Container>
            <Text>Clip gain / fade-in frames / fade-out frames</Text>
            <Input Type="Text" id="WaveClipGainBox" AccessibleName="Clip linear gain, zero to sixty-four" Value="{Binding ClipGain, mode=TwoWay}" />
            <Input Type="Text" id="WaveFadeInBox" AccessibleName="Fade in duration in audio frames" Value="{Binding FadeIn, mode=TwoWay}" />
            <Input Type="Text" id="WaveFadeOutBox" AccessibleName="Fade out duration in audio frames" Value="{Binding FadeOut, mode=TwoWay}" />
            <Button id="WaveProcessingButton" action="9to1.Wave.Processing" Interactive="{Binding CanEditClip}">Apply gain and fades</Button>
            <Container Type="Grid" ColumnSizes="1fr 1fr">
              <Button id="WaveLiftButton" action="9to1.Wave.Delete" Interactive="{Binding CanEditClip}">Lift clip</Button>
              <Button id="WaveRippleDeleteButton" action="9to1.Wave.RippleDelete" Interactive="{Binding CanEditClip}" Column="1">Ripple delete</Button>
            </Container>
          </Container>
        </Container>
        <Text Text="{Binding DraftStatus}" TextWrapping="Wrap" />
        <Button id="WaveDiscardDraftsButton" action="9to1.Wave.DiscardDrafts" Interactive="{Binding HasPendingDrafts}">Discard pending fields</Button>
        <Container Type="Vertical Stack" Background="{Resource CuiPanelBrush}" Margin="0,8" Active="{Binding CloseRequested}" CellGap="6">
          <Text TextWrapping="Wrap">Keep your native project edits before closing. Apply or discard pending inspector fields before saving.</Text>
          <Button id="WaveSaveCloseButton" action="9to1.Wave.SaveAndClose" Interactive="{Binding CanSave}">Save and close</Button>
          <Button id="WaveDiscardCloseButton" action="9to1.Wave.DiscardAndClose">Discard changes and close</Button>
          <Button id="WaveKeepEditingButton" action="9to1.Wave.KeepEditing">Keep editing</Button>
        </Container>
        <Text Text="{Binding Status}" TextWrapping="Wrap" AccessibleName="Wave operation status" />
      </Container>
    </Container>
  </Page>
</Cui>
