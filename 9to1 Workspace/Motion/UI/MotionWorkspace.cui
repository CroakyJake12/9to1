<Cui id="9to1.Motion.Workspace" version="1">
  <Actions>
    <Action name="SelectMarker" command="9to1.Motion.SelectMarker" parameter="{Binding marker.Target}" />
    <Action name="JumpMarker" command="9to1.Motion.JumpMarker" parameter="{Binding marker.Target}" />
    <Action name="UpdateMarker" command="9to1.Motion.UpdateMarker" parameter="{Binding SelectedMarker}" />
    <Action name="DeleteMarker" command="9to1.Motion.DeleteMarker" parameter="{Binding SelectedMarker}" />
  </Actions>
  <Page>
    <Container margin="12" Type="Grid" RowSizes="Auto 1fr Auto Auto">
      <Container Type="Vertical Stack" CellGap="8">
        <Text text="{Binding ProjectLabel}" font-size="22" />
        <Container Type="Wrap">
          <Input id="MotionSequenceSelector" max-width="250" margin="0,0,8,8" ItemsSource="{Binding SequenceNames}" SelectedIndex="{Binding SequenceIndex, mode=TwoWay, type=int}" accessible-name="Sequence" Type="Select" />
          <Button id="MotionUndoButton" margin="0,0,8,8" action="9to1.Motion.Undo" content="Undo" Interactive="{Binding CanUndo}" />
          <Button margin="0,0,8,8" action="9to1.Motion.Redo" content="Redo" Interactive="{Binding CanRedo}" />
          <Button margin="0,0,8,8" action="9to1.Motion.Reload" content="Reload saved project" />
          <Button margin="0,0,8,8" action="9to1.Motion.ImportAsset" content="Add media from Files" Interactive="{Binding CanImport}" />
          <Button margin="0,0,8,8" action="9to1.Motion.Render" content="Render video only" Interactive="{Binding CanRender}" />
          <Button margin="0,0,8,8" action="9to1.Motion.Cancel" content="Cancel operation" Interactive="{Binding CanCancel}" />
        </Container>
      </Container>
      <Container margin="0,12" Type="Grid" Row="1" ColumnSizes="1fr 1fr 1fr">
        <Container id="MotionMediaViewport" Type="Overlay" VerticalScrolling="True" HorizontalScrolling="False">
          <Container Type="Vertical Stack" CellGap="6">
            <Text text="Media and tracks" font-size="18" />
            <Input ItemsSource="{Binding AssetNames}" SelectedIndex="{Binding AssetIndex, mode=TwoWay, type=int}" accessible-name="Source asset" Type="Select" />
            <Button action="9to1.Motion.RelinkAsset" content="Relink selected asset in Files" />
            <Input ItemsSource="{Binding TrackNames}" SelectedIndex="{Binding TrackIndex, mode=TwoWay, type=int}" accessible-name="Video track" Type="Select" />
            <Button action="9to1.Motion.AddTrack" content="Add video track" />
            <Button action="9to1.Motion.ToggleLock" content="Lock / unlock track" />
            <Button action="9to1.Motion.ToggleVisibility" content="Show / hide track" />
            <Text text="{Binding SequenceLabel}" />
            <Text text="Sequence markers" font-size="18" />
            <Input id="MotionMarkerName" accessible-name="Marker name" Type="Text" Value="{Binding MarkerName, mode=TwoWay}" />
            <Button id="MotionAddMarker" action="9to1.Motion.AddMarker" content="Add marker at playhead" />
            <Text text="{Binding MarkerSelection}" text-wrapping="Wrap" />
            <Input id="MotionMarkerFrame" accessible-name="Marker frame" Type="Text" Value="{Binding MarkerFrame, mode=TwoWay}" />
            <Container Type="Wrap">
              <Button margin="0,0,8,8" id="MotionUpdateMarker" action="UpdateMarker" content="Save marker" />
              <Button margin="0,0,8,8" id="MotionDeleteMarker" action="DeleteMarker" content="Delete marker" />
            </Container>
            <Repeat Source="{Binding Markers}" As="marker" Key="{Binding marker.Key}">
              <Container Type="Wrap">
                <Button margin="0,0,8,8" id="MotionSelectMarkerRow" action="SelectMarker" content="{Binding marker.Label}" />
                <Button margin="0,0,8,8" id="MotionJumpMarkerRow" action="JumpMarker" content="Go to marker" />
              </Container>
            </Repeat>
            <Button action="9to1.Motion.PlaySource" content="Play selected source" Interactive="{Binding CanPlay}" />
            <Button action="9to1.Motion.Pause" content="Pause source" />
            <Text text="{Binding PreviewStatus}" text-wrapping="Wrap" />
            <Text text="{Binding ExportStatus}" text-wrapping="Wrap" />
          </Container>
        </Container>
        <Container id="MotionInspectorViewport" Type="Overlay" Column="1" VerticalScrolling="True" HorizontalScrolling="False">
          <Container margin="12,0" Type="Vertical Stack" CellGap="6">
            <Text text="Clip inspector · frames" font-size="18" />
            <Input id="MotionClipSelector" ItemsSource="{Binding ClipNames}" SelectedIndex="{Binding ClipIndex, mode=TwoWay, type=int}" accessible-name="Timeline clip" Type="Select" />
            <Text text="{Binding Selection}" text-wrapping="Wrap" />
            <Text text="Timeline start frame" />
            <Input accessible-name="Timeline start frame" Type="Text" Value="{Binding Start, mode=TwoWay}" />
            <Text text="Source in frame" />
            <Input accessible-name="Source in frame" Type="Text" Value="{Binding SourceIn, mode=TwoWay}" />
            <Text text="Source out frame (exclusive)" />
            <Input accessible-name="Source out frame" Type="Text" Value="{Binding SourceOut, mode=TwoWay}" />
            <Container Type="Wrap">
              <Button margin="0,0,8,8" action="9to1.Motion.Insert" content="Insert" />
              <Button margin="0,0,8,8" action="9to1.Motion.Overwrite" content="Overwrite" />
              <Button margin="0,0,8,8" action="9to1.Motion.Move" content="Move" />
            </Container>
            <Container Type="Wrap">
              <Button margin="0,0,8,8" action="9to1.Motion.Trim" content="Trim" />
              <Button margin="0,0,8,8" action="9to1.Motion.Slip" content="Slip" />
              <Button margin="0,0,8,8" action="9to1.Motion.Duplicate" content="Duplicate" />
            </Container>
            <Container Type="Wrap">
              <Button margin="0,0,8,8" action="9to1.Motion.RippleTrimStart" content="Ripple start" />
              <Button margin="0,0,8,8" action="9to1.Motion.RippleTrimEnd" content="Ripple end" />
            </Container>
            <Container Type="Wrap">
              <Button margin="0,0,8,8" action="9to1.Motion.Roll" content="Roll cut to playhead" />
              <Button margin="0,0,8,8" action="9to1.Motion.Slide" content="Slide clip" />
            </Container>
            <Text text="Destination track" />
            <Input id="MotionDestinationTrack" ItemsSource="{Binding TrackNames}" SelectedIndex="{Binding DestinationTrackIndex, mode=TwoWay, type=int}" accessible-name="Move destination track" Type="Select" />
            <Button id="MotionMoveToTrackButton" action="9to1.Motion.MoveToTrack" content="Move to track" />
            <Container Type="Wrap">
              <Button margin="0,0,8,8" action="9to1.Motion.Delete" content="Lift clip" />
              <Button margin="0,0,8,8" action="9to1.Motion.RippleDelete" content="Extract clip" />
            </Container>
            <Text text="Range / caption start frame" />
            <Input accessible-name="Range start frame" Type="Text" Value="{Binding RangeStart, mode=TwoWay}" />
            <Text text="Range / caption end frame (exclusive)" />
            <Input accessible-name="Range end frame" Type="Text" Value="{Binding RangeEnd, mode=TwoWay}" />
            <Container Type="Wrap">
              <Button margin="0,0,8,8" action="9to1.Motion.Lift" content="Lift range" />
              <Button margin="0,0,8,8" action="9to1.Motion.Extract" content="Extract range" />
            </Container>
          </Container>
        </Container>
        <Container id="MotionCaptionViewport" Type="Overlay" Column="2" VerticalScrolling="True" HorizontalScrolling="False">
          <Container Type="Vertical Stack" CellGap="6">
            <Text text="Captions" font-size="18" />
            <Input ItemsSource="{Binding CaptionTrackNames}" SelectedIndex="{Binding CaptionTrackIndex, mode=TwoWay, type=int}" accessible-name="Caption track and language" Type="Select" />
            <Input ItemsSource="{Binding CaptionNames}" SelectedIndex="{Binding CaptionIndex, mode=TwoWay, type=int}" accessible-name="Caption cue" Type="Select" />
            <Input accessible-name="Caption text" Type="Text" Value="{Binding CaptionText, mode=TwoWay}" Multiline="True" />
            <Text text="Cue timing uses the range start and end frames." text-wrapping="Wrap" />
            <Container Type="Wrap">
              <Button margin="0,0,8,8" action="9to1.Motion.AddCaption" content="Add cue" />
              <Button margin="0,0,8,8" action="9to1.Motion.SaveCaption" content="Save cue" />
            </Container>
            <Container Type="Wrap">
              <Button margin="0,0,8,8" action="9to1.Motion.SplitCaption" content="Split at playhead" />
              <Button margin="0,0,8,8" action="9to1.Motion.MergeCaption" content="Merge next cue" />
            </Container>
            <Input min-height="100" accessible-name="Subtitle import and export text" Type="Text" Value="{Binding SubtitleText, mode=TwoWay}" Multiline="True" />
            <Container Type="Wrap">
              <Button margin="0,0,8,8" action="9to1.Motion.ImportSrt" content="Import SRT" />
              <Button margin="0,0,8,8" action="9to1.Motion.ImportWebVtt" content="Import VTT" />
            </Container>
            <Container Type="Wrap">
              <Button margin="0,0,8,8" action="9to1.Motion.ExportSrt" content="Export SRT" />
              <Button margin="0,0,8,8" action="9to1.Motion.ExportWebVtt" content="Export VTT" />
            </Container>
          </Container>
        </Container>
      </Container>
      <Container Type="Vertical Stack" Row="2" CellGap="6">
        <Container Type="Wrap">
          <Button margin="0,0,8,8" action="9to1.Motion.PreviousFrame" content="Previous frame" />
          <Input margin="0,0,8,8" accessible-name="Playhead frame" Type="Text" Value="{Binding Playhead, mode=TwoWay}" />
          <Button margin="0,0,8,8" action="9to1.Motion.NextFrame" content="Next frame" />
          <Button margin="0,0,8,8" action="9to1.Motion.Split" content="Split clip at playhead" />
        </Container>
        <Container Type="Wrap">
          <Button margin="0,0,8,8" id="MotionPreviousMarker" action="9to1.Motion.PreviousMarker" content="Previous marker" />
          <Button margin="0,0,8,8" id="MotionNextMarker" action="9to1.Motion.NextMarker" content="Next marker" />
          <Button margin="0,0,8,8" id="MotionToggleSnapping" action="9to1.Motion.ToggleSnapping" content="{Binding SnappingLabel}" />
          <Button margin="0,0,8,8" id="MotionSnapPlayhead" action="9to1.Motion.SnapPlayhead" content="Snap playhead" />
          <Button margin="0,0,8,8" id="MotionMarkIn" action="9to1.Motion.MarkIn" content="Mark in at frame" />
          <Button margin="0,0,8,8" id="MotionMarkOut" action="9to1.Motion.MarkOut" content="Mark out after frame" />
        </Container>
        <Object Type="motion.timeline" height="180" accessible-name="Multitrack video timeline. Use the clip selector and frame controls for keyboard editing." />
      </Container>
      <Container Type="Vertical Stack" Row="3" CellGap="4">
        <Text text="{Binding DraftStatus}" text-wrapping="Wrap" />
        <Button action="9to1.Motion.DiscardDrafts" content="Discard pending fields" Interactive="{Binding CanDiscardDrafts}" />
        <Text text="{Binding Status}" text-wrapping="Wrap" accessible-name="Motion operation status" />
      </Container>
    </Container>
  </Page>
</Cui>
