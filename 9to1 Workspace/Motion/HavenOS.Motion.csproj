<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>HavenOS.Apps.Motion</RootNamespace>
    <AssemblyName>HavenOS.Motion</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);Source\**\*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../shared/src/Haven.Core/Haven.Core.csproj" />
    <ProjectReference Include="../shared/src/Haven.Infrastructure/Haven.Infrastructure.csproj" />
  </ItemGroup>
</Project>
